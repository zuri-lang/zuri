# The Computer Language Benchmarks Game
# https://salsa.debian.org/benchmarksgame-team/benchmarksgame/
#
#  Contributed by Ian Osgood

var last = 42, A = 3877, C = 29573, M = 139968

def rand(max) {
  last = (last * A + C) % M
  return max * last / M
}

var ALU = "GGCCGGGCGCGGTGGCTCACGCCTGTAATCCCAGCACTTTGG" +
  "GAGGCCGAGGCGGGCGGATCACCTGAGGTCAGGAGTTCGAGA" +
  "CCAGCCTGGCCAACATGGTGAAACCCCGTCTCTACTAAAAAT" +
  "ACAAAAATTAGCCGGGCGTGGTGGCGCGCGCCTGTAATCCCA" +
  "GCTACTCGGGAGGCTGAGGCAGGAGAATCGCTTGAACCCGGG" +
  "AGGCGGAGGTTGCAGTGAGCCGAGATCGCGCCACTGCACTCC" +
  "AGCCTGGGCGACAGAGCGAGACTCCGTCTCAAAAA"

var IUB = {
  a:0.27, c:0.12, g:0.12, t:0.27,
  B:0.02, D:0.02, H:0.02, K:0.02,
  M:0.02, N:0.02, R:0.02, S:0.02,
  V:0.02, W:0.02, Y:0.02
}

var HomoSap = {
  a: 0.3029549426680,
  c: 0.1979883004921,
  g: 0.1975473066391,
  t: 0.3015094502008
}

def makeCumulative(table) {
  var last = nil
  for c, _ in table {
    if last {
      table[c] += table[last]
    }

    last = c
  }
}

def fastaRepeat(n, seq) {
  var seqi = 0, lenOut = 60

  while n > 0 {
    if n < lenOut {
      lenOut = n
    }

    if seqi + lenOut < seq.length() {
      echo seq[seqi, seqi+lenOut]
      seqi += lenOut
    } else {
      var s = seq[seqi,]
      seqi = lenOut - s.length()
      echo s + seq[0, seqi]
    }

    n -= lenOut
  }
}

def fastaRandom(n, table) {

  var line = [nil] * 60

  makeCumulative(table)

  while n > 0 {
    if n < line.length() {
      line = [nil] * n
    }

    iter var i = 0; i < line.length(); i++ {
      var r = rand(1)

      for c, v in table {
        if r < v {
          line[i] = c
          break
        }
      }
    }

    echo ''.join(line)
    n -= line.length()
  }
}

var n = 25000000

var start = time()

echo ">ONE Homo sapiens alu"
fastaRepeat(2 * n, ALU)

echo ">TWO IUB ambiguity codes"
fastaRandom(3 * n, IUB)

echo ">THREE Homo sapiens frequency"
fastaRandom(5 * n, HomoSap)

echo 'Time taken = ${time() - start}s'
