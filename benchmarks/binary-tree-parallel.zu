/* The Computer Language Benchmarks Game
 * https://salsa.debian.org/benchmarksgame-team/benchmarksgame/
 *
 * binary-trees Zuri #1 program, worker-driven counterpart
 *
 * Each depth bucket in the main loop below builds and counts its own
 * `iterations` trees completely independently of every other bucket
 *; nothing is shared between them; so each bucket is handed to
 * its own worker instead of running through them one at a time.
 * Trees themselves never cross a worker boundary: each worker
 * builds, counts, and discards its own trees entirely inside its own
 * isolate, only the small integer sum comes back.
 *
 * contributed by Richard Ore
 * *reset*
*/

import worker

# `TreeNode`/`tree_with`/`churn_depth` reference nothing from
# `worker`; spawning `churn_depth` transfers it (and everything
# it transitively touches) fresh, and a value that references an
# imported module anywhere in it can't cross a worker boundary at
# all. `main()`, which DOES use `worker`, is never itself spawned.
class TreeNode {
  @new(left, right) {
    self.left = left
    self.right = right
  }

  count() {
    if self.left == nil
      return 1
    return 1 + self.left.count() + self.right.count()
  }
}

def tree_with(depth) {
  if depth > 0 {
    return TreeNode(tree_with(depth - 1), tree_with(depth - 1))
  }
  return TreeNode(nil, nil)
}

def churn_depth(job) {
  var depth = job[0], iterations = job[1]
  var sum = 0

  iter var i = 1; i <= iterations; i++ {
    sum += tree_with(depth).count()
  }

  return sum
}

def main(n) {
  var min_depth = 4
  var max_depth = n.max(min_depth + 2)
  var stretch_depth = max_depth + 1

  echo 'stretch tree of depth ${stretch_depth}\t check: ${tree_with(stretch_depth).count()}'

  var long_lived_tree = tree_with(max_depth)

  var jobs = []
  iter var depth = min_depth; depth <= max_depth; depth += 2 {
    var iterations = 1 << (max_depth - depth + min_depth)
    jobs.append([depth, iterations])
  }

  var sums = worker.map(churn_depth, jobs)

  iter var idx = 0; idx < jobs.length(); idx++ {
    echo '${jobs[idx][1]}\t trees of depth ${jobs[idx][0]}\t check: ${sums[idx]}'
  }

  echo 'long lived tree of depth ${max_depth}\t check: ${long_lived_tree.count()}'
}

var start = time()
main(21)
echo '\n\nTime taken: ${time() - start}'
