/**
 * The Computer Language Benchmarks Game
 * https://salsa.debian.org/benchmarksgame-team/benchmarksgame/
 * 
 * Richard Ore, based on
 * Greg Buchholz's simple C #2 program buffered, by Isaac Gouy.
 * 
 * @note The name `mandlebrot-fast` is purely historical and does 
 *    not indicate that this implementation of mandlebrot runs 
 *    faster than the one in `mandlebrot.zu`. In fact, under most 
 *    scenarios and architecture, the reverse is actually the 
 *    case.
 */

import os


var bit_num = 0, byte_acc = 0
const iterator = 50, limit = 2.0
var zr, zi, cr, ci, tr, ti

const h = os.args.get(2, '16000').to_number(), w = h
const bytes_per_row = w >> 3

var start = time()

print('P4\n${w} ${h}\n')

iter var y = 0; y < h; y++ {
  var row = bytes(bytes_per_row)
  var xbyte = 0;  

  iter var x = 0; x < w; x++ {
    zr = zi = tr = ti = 0
    cr = 2 * x / w - 1.5
    ci = 2 * y / h - 1
    iter var i = 0; i < iterator and (tr + ti <= limit * limit); i++ {
      zi = 2 * zr * zi + ci
      zr = tr - ti + cr
      tr = zr * zr
      ti = zi * zi
    }

    byte_acc <<= 1
    if (tr + ti <= limit * limit) {
      byte_acc |= 0x01
    }

    bit_num++

    if bit_num == 8 {
      row[xbyte++ - 1] = byte_acc
      byte_acc = 0
      bit_num = 0
    } else if x == w - 1 {
      byte_acc <<= 8 - w % 8      
      row[xbyte++ - 1] = byte_acc
      byte_acc = 0
      bit_num = 0
    }
  }

  print(row)
}

echo 'Time taken = ${time() - start}s'
