/**
 * The Computer Language Benchmarks Game
 * https://salsa.debian.org/benchmarksgame-team/benchmarksgame/
 * 
 * contributed by Thomas GODART (based on Greg Buchholz's C program) 
 * modified by anon
 * modified by Richard Ore
 */

import struct { pack_from }

def mandlebrot(h, w) {
  if !w w = h

  echo 'P4\n${w} ${h}'

  var bit_num = 128, bytes_acc = 0,
      yfac = 2/h, xfac = 2/w

  iter var y = 0; y < h; y++ {
    var result = []

    var ci = y * yfac - 1

    iter var x = 0; x < w; x++ {
      var zr = 0, zi = 0, tr = 0, ti = 0
      var cr = x * xfac - 1.5

      iter var i = 0; i < 50; i++ {
        zi = 2 * zr * zi + ci
        zr = tr - ti + cr
        tr = zr * zr
        if tr + (ti = zi * zi) > 4 {
          break
        }
      }
      bytes_acc += bit_num

      if bit_num == 1 {
        result.append(bytes_acc)
        bit_num = 128
        bytes_acc = 0
      } else {
        bit_num >>= 1
      }
    }

    if bit_num != 128 {
      result.append(bytes_acc)
      bit_num = 128
      bytes_acc = 0
    }

    print(pack_from('c*', result).to_string())
  }
}

var start = time()
mandlebrot(16000)

echo '\nTotal time taken: ${time() - start}s'
