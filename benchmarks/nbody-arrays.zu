/* The Computer Language Benchmarks Game
 * https://salsa.debian.org/benchmarksgame-team/benchmarksgame/
 *
 * n-body Zuri program, flat-array formulation
 *
 * based on work by Mark C. Lewis
 * contributed by Richard Ore
 *
 * The same simulation as nbody.zu, with the bodies held as seven
 * parallel arrays of coordinates rather than as objects. Several of the
 * official entries for this benchmark are written this way, and the two
 * shapes stress completely different parts of the runtime: nbody.zu
 * reaches its numbers through instance fields, this one reaches them
 * through indexed reads out of lists of floats.
 */

const PI = 3.141592653589793
const SOLAR_MASS = 4 * PI * PI
const DAYS_PER_YEAR = 365.24
const BODIES = 5

/* Sun, Jupiter, Saturn, Uranus, Neptune, in that order. */
def initial_state() {
  const x = [
    0.0,
    4.84143144246472090e+00,
    8.34336671824457987e+00,
    1.28943695621391310e+01,
    1.53796971148509165e+01,
  ]
  const y = [
    0.0,
    -1.16032004402742839e+00,
    4.12479856412430479e+00,
    -1.51111514016986312e+01,
    -2.59193146099879641e+01,
  ]
  const z = [
    0.0,
    -1.03622044471123109e-01,
    -4.03523417114321381e-01,
    -2.23307578892655734e-01,
    1.79258772950371181e-01,
  ]
  const vx = [
    0.0,
    1.66007664274403694e-03 * DAYS_PER_YEAR,
    -2.76742510726862411e-03 * DAYS_PER_YEAR,
    2.96460137564761618e-03 * DAYS_PER_YEAR,
    2.68067772490389322e-03 * DAYS_PER_YEAR,
  ]
  const vy = [
    0.0,
    7.69901118419740425e-03 * DAYS_PER_YEAR,
    4.99852801234917238e-03 * DAYS_PER_YEAR,
    2.37847173959480950e-03 * DAYS_PER_YEAR,
    1.62824170038242295e-03 * DAYS_PER_YEAR,
  ]
  const vz = [
    0.0,
    -6.90460016972063023e-05 * DAYS_PER_YEAR,
    2.30417297573763929e-05 * DAYS_PER_YEAR,
    -2.96589568540237556e-05 * DAYS_PER_YEAR,
    -9.51592254519715870e-05 * DAYS_PER_YEAR,
  ]
  const mass = [
    SOLAR_MASS,
    9.54791938424326609e-04 * SOLAR_MASS,
    2.85885980666130812e-04 * SOLAR_MASS,
    4.36624404335156298e-05 * SOLAR_MASS,
    5.15138902046611451e-05 * SOLAR_MASS,
  ]

  return { x, y, z, vx, vy, vz, mass }
}

/* Put the sun's velocity where it cancels the momentum of everything
 * else, so the system as a whole stays put. */
def offset_momentum(vx, vy, vz, mass) {
  var px = 0.0
  var py = 0.0
  var pz = 0.0

  iter var i = 0; i < BODIES; i++ {
    px += vx[i] * mass[i]
    py += vy[i] * mass[i]
    pz += vz[i] * mass[i]
  }

  vx[0] = -px / SOLAR_MASS
  vy[0] = -py / SOLAR_MASS
  vz[0] = -pz / SOLAR_MASS
}

def advance(x, y, z, vx, vy, vz, mass, dt) {
  iter var i = 0; i < BODIES; i++ {
    var massi = mass[i]

    var xi = x[i]
    var yi = y[i]
    var zi = z[i]
    var vxi = vx[i]
    var vyi = vy[i]
    var vzi = vz[i]

    iter var j = i + 1; j < BODIES; j++ {
      var dx = xi - x[j]
      var dy = yi - y[j]
      var dz = zi - z[j]

      var d2 = dx * dx + dy * dy + dz * dz
      var distance = d2.sqrt()
      var mag = dt / (d2 * distance)

      var massj = mass[j]

      vxi -= dx * massj * mag
      vyi -= dy * massj * mag
      vzi -= dz * massj * mag

      vx[j] += dx * massi * mag
      vy[j] += dy * massi * mag
      vz[j] += dz * massi * mag
    }

    vx[i] = vxi
    vy[i] = vyi
    vz[i] = vzi
  }

  iter var i = 0; i < BODIES; i++ {
    x[i] += dt * vx[i]
    y[i] += dt * vy[i]
    z[i] += dt * vz[i]
  }
}

def energy(x, y, z, vx, vy, vz, mass) {
  var e = 0.0

  iter var i = 0; i < BODIES; i++ {
    e += 0.5 * mass[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i])

    iter var j = i + 1; j < BODIES; j++ {
      var dx = x[i] - x[j]
      var dy = y[i] - y[j]
      var dz = z[i] - z[j]

      var distance = (dx * dx + dy * dy + dz * dz).sqrt()
      e -= (mass[i] * mass[j]) / distance
    }
  }

  return e
}

def main(n) {
  const s = initial_state()
  const x = s.x
  const y = s.y
  const z = s.z
  const vx = s.vx
  const vy = s.vy
  const vz = s.vz
  const mass = s.mass

  offset_momentum(vx, vy, vz, mass)
  echo energy(x, y, z, vx, vy, vz, mass)

  iter var i = 0; i < n; i++ {
    advance(x, y, z, vx, vy, vz, mass, 0.01)
  }

  echo energy(x, y, z, vx, vy, vz, mass)
}

var start = time()
main(50_000_000)

echo '\nTotal time taken: ${time() - start}s'
