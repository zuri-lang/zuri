/**
 * A transcendental-math kernel -- the one shape none of the other
 * benchmarks here exercise.
 *
 * Every other numeric benchmark in this directory stays inside +-*\/ and
 * (in nbody's case) sqrt, so none of them says anything about how the
 * VM dispatches `Number`'s trigonometric, exponential and logarithmic
 * methods. This does: the inner loop is dominated by `sin`/`cos`/`exp`/
 * `log`/`atan2`/`sqrt` rather than by the arithmetic around them.
 *
 * The kernel itself is a damped wave superposition integrated by the
 * midpoint rule -- chosen because it is a real numerical computation
 * whose answer is checkable, not a synthetic sequence of unrelated
 * calls, and because it mixes unary and binary math methods the way
 * real signal/graphics code does.
 *
 * contributed by Richard Ore
 */

const SAMPLES = 2_000_000
const MODES = 3

def wave(t: number, k: number) {
  const phase = t * (k + 1) + k.atan2(t + 1.0)
  const damping = (0.0 - t * 0.5).exp()
  return damping * (phase.sin() + phase.cos() * 0.5)
}

def integrate(samples: number) {
  var acc = 0.0
  const step = 8.0 / samples

  iter var i = 0; i < samples; i++ {
    const t = (i + 0.5) * step
    var s = 0.0

    iter var k = 0; k < MODES; k++ {
      s += wave(t, k)
    }

    acc += s * (1.0 + t).log() * (t + 1.0).sqrt()
  }

  return acc * step
}

var start = time()

echo integrate(SAMPLES)

echo '\nTotal time taken = ${time() - start}s'
