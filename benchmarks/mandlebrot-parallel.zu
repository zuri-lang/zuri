/**
 * Worker-driven counterpart to mandlebrot.zu; each row's pixels
 * depend only on that row's own y, never on any other row, so the
 * image is split into one contiguous row range per pool worker and
 * computed concurrently. Each worker returns its own rows as plain
 * byte lists (there's no shared flush buffer to write into across
 * isolates the way the sequential version has), and the main thread
 * prints them back out in row order once every chunk is in.
 *
 * Base On: https://benchmarksgame-team.pages.debian.net/benchmarksgame/program/mandelbrot-graalvmaot-1.html
 *
 * The Computer Language Benchmarks Game
 * https://salsa.debian.org/benchmarksgame-team/benchmarksgame/
 * contributed by Stefan Krause
 * slightly modified by Chad Whipkey
 * parallelized by Richard Ore
 */

import worker

# `Mandelbrot` only holds the pure per-row math, with no reference to
# `worker` anywhere in it; spawning `computeRows` as a bound
# method transfers the WHOLE class, methods included, and a class
# that references an imported module ANYWHERE in it can't cross a
# worker boundary at all. Orchestration (`compute()` below) stays
# entirely outside the class for exactly that reason.
class Mandelbrot {
  var size
  var fac
  var shift

  @new(size) {
    self.size = size
    self.fac = 2.0 / size
    self.shift = size % 8 == 0 ? 0 : (8 - size % 8)
  }

  computeRows(job)
  {
    var rows = []
    iter var y = job[0]; y < job[1]; y++ {
      rows.append(self.computeRow(y))
    }
    return rows
  }

  computeRow(y)
  {
    var bits = 0
    var row = []

    var Ci = (y*self.fac - 1.0)
    iter var x = 0; x<self.size;x++ {
      var Zr = 0.0
      var Zi = 0.0
      var Cr = (x*self.fac - 1.5)
      var i = 50
      var ZrN = 0
      var ZiN = 0
      do {
        Zi = 2.0 * Zr * Zi + Ci
        Zr = ZrN - ZiN + Cr
        ZiN = Zi * Zi
        ZrN = Zr * Zr
      } while (!(ZiN + ZrN > 4.0) and i-- > 0)

      bits = bits << 1
      if (i == 0) bits++

      if (x%8 == 7) {
        row.append(bits)
        bits = 0
      }
    }
    if (self.shift!=0) {
      bits = bits << self.shift
      row.append(bits)
    }
    return row
  }
}

def compute(size)
{
  echo "P4\n${size} ${size}\n"

  var m = Mandelbrot(size)
  var workers = worker.pool_size()
  var rowsPerJob = (size + workers - 1) // workers
  var jobs = []

  iter var y0 = 0; y0 < size; y0 += rowsPerJob {
    jobs.append([y0, (y0 + rowsPerJob).min(size)])
  }

  var chunks = worker.map(m.computeRows, jobs)
  for rows in chunks {
    for row in rows {
      print(row)
    }
  }
}

var start = time()
compute(16_000)

echo '\nTotal time taken = ${time() - start}s'
