/**
 * Isolate scalability stress test. Every other isolate benchmark
 * in this directory asks "does spreading real work across isolates
 * make it faster"; this one asks a different question: how does the
 * isolate machinery itself (spawn, queue, transfer, join) hold up
 * under a genuinely massive number of isolates, not just a handful
 * of big chunks. `ISOLATE_COUNT` isolates are spawned, each
 * running a non-trivial, non-trivially-fast function, and every one
 * of them is joined before this reports how long the whole thing took.
 *
 * Run under `/usr/bin/time -v` (or similar) to see peak RSS alongside
 * the in-script wall-clock timer below.
 */

import isolate

const ISOLATE_COUNT = 1_000_000

/**
 * A deliberately non-trivial per-isolate workload; a trial-
 * division primality check followed by a small run of floating point
 * work, so each isolate does real, measurable computation rather
 * than being a bare no-op that would only measure spawn overhead.
 */
def complex_work(n) {
  var is_prime = n >= 2
  iter var i = 2; i * i <= n; i++ {
    if n % i == 0 {
      is_prime = false
      break
    }
  }

  var acc = 0.0
  iter var j = 0; j < 50; j++ {
    acc += (n + j).sqrt()
  }

  return is_prime and acc > 0.0 ? 1 : 0
}

var jobs = []
iter var i = 0; i < ISOLATE_COUNT; i++ {
  jobs.append(1_000 + (i % 1_000))
}

var start = time()
var results = isolate.map(complex_work, jobs)

var primes = 0
for r in results {
  primes += r
}

echo '${ISOLATE_COUNT} isolates spawned, ${primes} returned prime'
echo '\nTotal time taken = ${time() - start}s'
