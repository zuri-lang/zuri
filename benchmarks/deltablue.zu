/* DeltaBlue, an incremental constraint solver.
 *
 * Transliterated from the Are-We-Fast-Yet JavaScript version, which is a
 * derivation of the SOM version, which came from Mario Wolczko's Smalltalk
 * version of DeltaBlue.
 *
 * The original license details are available here:
 * http://web.archive.org/web/20050825101121/http://www.sunlabs.com/people/mario/java_benchmarking/index.html
 *
 * Two notes on the port. The SOM `Vector` is reproduced here because the
 * planner leans on its O(1) `remove_first()`; a plain list would change what
 * the benchmark measures. The SOM `IdentityDictionary` behind the strength
 * tables is not: it only ever holds the eight strength symbols, whose hashes
 * are 0..7 and unique, so a plain list indexed by that hash is the same
 * lookup without the bucket machinery. `Vector.sort` is an insertion sort
 * rather than SOM's quicksort, which recurses through a broken call; the
 * vector it sorts holds a handful of elements at most.
 */

var INITIAL_SIZE = 10

class Vector {
  @new(size) {
    self.storage = (size == nil or size == 0) ? nil : [nil] * size
    self.first_idx = 0
    self.last_idx = 0
  }

  static def of(element) {
    var v = Vector(1)
    v.append(element)
    return v
  }

  at(index) {
    if self.storage == nil or index >= self.storage.length() {
      return nil
    }
    return self.storage[index]
  }

  append(element) {
    if self.storage == nil {
      self.storage = [nil] * INITIAL_SIZE
    } else if self.last_idx >= self.storage.length() {
      self.grow()
    }

    self.storage[self.last_idx] = element
    self.last_idx++
  }

  grow() {
    var bigger = [nil] * (self.storage.length() * 2)

    iter var i = 0; i < self.last_idx; i++ {
      bigger[i] = self.storage[i]
    }

    self.storage = bigger
  }

  size() {
    return self.last_idx - self.first_idx
  }

  is_empty() {
    return self.last_idx == self.first_idx
  }

  each(fn) {
    iter var i = self.first_idx; i < self.last_idx; i++ {
      fn(self.storage[i])
    }
  }

  remove_first() {
    if self.last_idx == self.first_idx {
      return nil
    }

    self.first_idx++
    return self.storage[self.first_idx - 1]
  }

  # Compacts the element out rather than shifting in place, which is what
  # keeps `first_idx` meaningful for the queue-like uses above.
  remove(element) {
    if self.storage == nil or self.last_idx == self.first_idx {
      return false
    }

    var kept = [nil] * self.storage.length()
    var last = 0
    var found = false

    iter var i = self.first_idx; i < self.last_idx; i++ {
      var it = self.storage[i]
      if it == element {
        found = true
      } else {
        kept[last] = it
        last++
      }
    }

    self.storage = kept
    self.first_idx = 0
    self.last_idx = last
    return found
  }

  # `comes_first(a, b)` answers whether a belongs ahead of b.
  sort(comes_first) {
    iter var i = self.first_idx + 1; i < self.last_idx; i++ {
      var element = self.storage[i]
      var j = i - 1

      while j >= self.first_idx and comes_first(element, self.storage[j]) {
        self.storage[j + 1] = self.storage[j]
        j--
      }

      self.storage[j + 1] = element
    }
  }
}

class Plan < Vector {
  @new() {
    parent(15)
  }

  execute() {
    self.each(@(c) {
      c.execute()
    })
  }
}

# The strength symbols. Only their identity matters to the solver; the hash
# doubles as the index into the two tables below.
class Sym {
  @new(hash) {
    self.hash = hash
  }
}

var ABSOLUTE_STRONGEST = Sym(0)
var REQUIRED = Sym(1)
var STRONG_PREFERRED = Sym(2)
var PREFERRED = Sym(3)
var STRONG_DEFAULT = Sym(4)
var DEFAULT = Sym(5)
var WEAK_DEFAULT = Sym(6)
var ABSOLUTE_WEAKEST = Sym(7)

var STRENGTH_TABLE = [-10_000, -800, -600, -400, -200, 0, 500, 10_000]

# Lower arithmetic value means stronger, so the comparisons below read
# backwards from what their names suggest.
class Strength {
  @new(symbolic_value) {
    self.arithmetic_value = STRENGTH_TABLE[symbolic_value.hash]
  }

  same_as(s) {
    return self.arithmetic_value == s.arithmetic_value
  }

  stronger(s) {
    return self.arithmetic_value < s.arithmetic_value
  }

  weaker(s) {
    return self.arithmetic_value > s.arithmetic_value
  }

  strongest(s) {
    return s.stronger(self) ? s : self
  }

  weakest(s) {
    return s.weaker(self) ? s : self
  }
}

var STRENGTH_CONSTANT = [
  Strength(ABSOLUTE_STRONGEST),
  Strength(REQUIRED),
  Strength(STRONG_PREFERRED),
  Strength(PREFERRED),
  Strength(STRONG_DEFAULT),
  Strength(DEFAULT),
  Strength(WEAK_DEFAULT),
  Strength(ABSOLUTE_WEAKEST),
]

def strength_of(symbolic_value) {
  return STRENGTH_CONSTANT[symbolic_value.hash]
}

var ABSOLUTE_WEAKEST_STRENGTH = strength_of(ABSOLUTE_WEAKEST)
var REQUIRED_STRENGTH = strength_of(REQUIRED)

class AbstractConstraint {
  @new(strength_sym) {
    self.strength = strength_of(strength_sym)
  }

  # Normal constraints are outputs of the planner; only an edit constraint
  # feeds a value in from outside.
  is_input() {
    return false
  }

  add_constraint(planner) {
    self.add_to_graph()
    planner.incremental_add(self)
  }

  destroy_constraint(planner) {
    if self.is_satisfied() {
      planner.incremental_remove(self)
    }

    self.remove_from_graph()
  }

  inputs_known(mark) {
    return !self.inputs_has_one(@(v) {
      return !(v.mark == mark or v.stay or v.determined_by == nil)
    })
  }

  # Tries to find a method for this constraint that respects `mark`, and
  # returns whichever constraint it displaced so the caller can re-satisfy it.
  satisfy(mark, planner) {
    var overridden
    self.choose_method(mark)

    if self.is_satisfied() {
      # Marking the inputs is what lets add_propagate see a cycle.
      self.inputs_do(@(i) {
        i.mark = mark
      })

      var out = self.get_output()
      overridden = out.determined_by

      if overridden != nil {
        overridden.mark_unsatisfied()
      }

      out.determined_by = self
      if !planner.add_propagate(self, mark) {
        raise Error('Cycle encountered')
      }

      out.mark = mark
    } else {
      overridden = nil
      if self.strength.same_as(REQUIRED_STRENGTH) {
        raise Error('Could not satisfy a required constraint')
      }
    }

    return overridden
  }
}

# Which way a binary constraint currently computes: v1 -> v2, or v2 -> v1.
var FORWARD = 1
var BACKWARD = 2

class BinaryConstraint < AbstractConstraint {
  @new(var1, var2, strength, planner) {
    parent(strength)

    self.v1 = var1
    self.v2 = var2
    self.direction = nil
  }

  is_satisfied() {
    return self.direction != nil
  }

  add_to_graph() {
    self.v1.add_constraint(self)
    self.v2.add_constraint(self)
    self.direction = nil
  }

  remove_from_graph() {
    if self.v1 != nil {
      self.v1.remove_constraint(self)
    }

    if self.v2 != nil {
      self.v2.remove_constraint(self)
    }

    self.direction = nil
  }

  # Decides which variable this constraint computes, given the walkabout
  # strengths of the two and which of them the current walk has already
  # reached.
  choose_method(mark) {
    if self.v1.mark == mark {
      if self.v2.mark != mark and self.strength.stronger(self.v2.walk_strength) {
        self.direction = FORWARD
      } else {
        self.direction = nil
      }
      return self.direction
    }

    if self.v2.mark == mark {
      if self.v1.mark != mark and self.strength.stronger(self.v1.walk_strength) {
        self.direction = BACKWARD
      } else {
        self.direction = nil
      }
      return self.direction
    }

    # Neither variable is marked, so we get to choose.
    if self.v1.walk_strength.weaker(self.v2.walk_strength) {
      if self.strength.stronger(self.v1.walk_strength) {
        self.direction = BACKWARD
      } else {
        self.direction = nil
      }
      return self.direction
    }

    if self.strength.stronger(self.v2.walk_strength) {
      self.direction = FORWARD
    } else {
      self.direction = nil
    }
    return self.direction
  }

  inputs_do(fn) {
    if self.direction == FORWARD {
      fn(self.v1)
    } else {
      fn(self.v2)
    }
  }

  inputs_has_one(fn) {
    if self.direction == FORWARD {
      return fn(self.v1)
    }
    return fn(self.v2)
  }

  mark_unsatisfied() {
    self.direction = nil
  }

  get_output() {
    return self.direction == FORWARD ? self.v2 : self.v1
  }

  recalculate() {
    var ihn
    var out

    if self.direction == FORWARD {
      ihn = self.v1
      out = self.v2
    } else {
      ihn = self.v2
      out = self.v1
    }

    out.walk_strength = self.strength.weakest(ihn.walk_strength)
    out.stay = ihn.stay

    if out.stay {
      self.execute()
    }
  }
}

class UnaryConstraint < AbstractConstraint {
  @new(v, strength, planner) {
    parent(strength)

    self.output = v
    self.satisfied = false

    self.add_constraint(planner)
  }

  is_satisfied() {
    return self.satisfied
  }

  add_to_graph() {
    self.output.add_constraint(self)
    self.satisfied = false
  }

  remove_from_graph() {
    if self.output != nil {
      self.output.remove_constraint(self)
    }

    self.satisfied = false
  }

  choose_method(mark) {
    self.satisfied = self.output.mark != mark and
      self.strength.stronger(self.output.walk_strength)
    return nil
  }

  inputs_do(fn) {
    # No input variables.
  }

  inputs_has_one(fn) {
    return false
  }

  mark_unsatisfied() {
    self.satisfied = false
  }

  get_output() {
    return self.output
  }

  recalculate() {
    self.output.walk_strength = self.strength
    self.output.stay = !self.is_input()

    if self.output.stay {
      self.execute() # stay optimization
    }
  }
}

# Holds a variable at whatever value the outside world last wrote to it.
class EditConstraint < UnaryConstraint {
  @new(v, strength, planner) {
    parent(v, strength, planner)
  }

  is_input() {
    return true
  }

  execute() {
  }
}

# Holds a variable at its current value.
class StayConstraint < UnaryConstraint {
  @new(v, strength, planner) {
    parent(v, strength, planner)
  }

  execute() {
  }
}

class EqualityConstraint < BinaryConstraint {
  @new(var1, var2, strength, planner) {
    parent(var1, var2, strength, planner)

    self.add_constraint(planner)
  }

  execute() {
    if self.direction == FORWARD {
      self.v2.value = self.v1.value
    } else {
      self.v1.value = self.v2.value
    }
  }
}

# dest = src * scale + offset, or the inverse when run backwards.
class ScaleConstraint < BinaryConstraint {
  @new(src, scale, offset, dest, strength, planner) {
    parent(src, dest, strength, planner)

    self.scale = scale
    self.offset = offset

    self.add_constraint(planner)
  }

  add_to_graph() {
    self.v1.add_constraint(self)
    self.v2.add_constraint(self)
    self.scale.add_constraint(self)
    self.offset.add_constraint(self)
    self.direction = nil
  }

  remove_from_graph() {
    if self.v1 != nil {
      self.v1.remove_constraint(self)
    }

    if self.v2 != nil {
      self.v2.remove_constraint(self)
    }

    if self.scale != nil {
      self.scale.remove_constraint(self)
    }

    if self.offset != nil {
      self.offset.remove_constraint(self)
    }

    self.direction = nil
  }

  execute() {
    if self.direction == FORWARD {
      self.v2.value = self.v1.value * self.scale.value + self.offset.value
    } else {
      self.v1.value = (self.v2.value - self.offset.value) / self.scale.value
    }
  }

  inputs_do(fn) {
    if self.direction == FORWARD {
      fn(self.v1)
    } else {
      fn(self.v2)
    }

    fn(self.scale)
    fn(self.offset)
  }

  recalculate() {
    var ihn
    var out

    if self.direction == FORWARD {
      ihn = self.v1
      out = self.v2
    } else {
      out = self.v1
      ihn = self.v2
    }

    out.walk_strength = self.strength.weakest(ihn.walk_strength)
    out.stay = ihn.stay and self.scale.stay and self.offset.stay

    if out.stay {
      self.execute() # stay optimization
    }
  }
}

class Variable {
  @new(value) {
    self.value = value == nil ? 0 : value
    self.constraints = Vector(2)
    self.determined_by = nil
    self.walk_strength = ABSOLUTE_WEAKEST_STRENGTH
    self.stay = true
    self.mark = 0
  }

  add_constraint(c) {
    self.constraints.append(c)
  }

  remove_constraint(c) {
    self.constraints.remove(c)

    if self.determined_by == c {
      self.determined_by = nil
    }
  }
}

class Planner {
  @new() {
    self.current_mark = 1
  }

  new_mark() {
    self.current_mark++
    return self.current_mark
  }

  # Adds a constraint, then keeps re-satisfying whatever it displaced until
  # the graph settles.
  incremental_add(c) {
    var mark = self.new_mark()
    var overridden = c.satisfy(mark, self)

    while overridden != nil {
      overridden = overridden.satisfy(mark, self)
    }
  }

  incremental_remove(c) {
    var out = c.get_output()
    c.mark_unsatisfied()
    c.remove_from_graph()

    var unsatisfied = self.remove_propagate_from(out)
    unsatisfied.each(@(u) {
      self.incremental_add(u)
    })
  }

  extract_plan_from_constraints(constraints) {
    var sources = Vector(nil)

    constraints.each(@(c) {
      if c.is_input() and c.is_satisfied() {
        sources.append(c)
      }
    })

    return self.make_plan(sources)
  }

  # Topological sort of the satisfied constraints reachable from `sources`.
  make_plan(sources) {
    var mark = self.new_mark()
    var plan = Plan()
    var todo = sources

    while !todo.is_empty() {
      var c = todo.remove_first()

      if c.get_output().mark != mark and c.inputs_known(mark) {
        # Not in the plan already and eligible for inclusion.
        plan.append(c)
        c.get_output().mark = mark
        self.add_constraints_consuming_to(c.get_output(), todo)
      }
    }

    return plan
  }

  propagate_from(v) {
    var todo = Vector(nil)
    self.add_constraints_consuming_to(v, todo)

    while !todo.is_empty() {
      var c = todo.remove_first()
      c.execute()
      self.add_constraints_consuming_to(c.get_output(), todo)
    }
  }

  add_constraints_consuming_to(v, coll) {
    var determining_c = v.determined_by

    v.constraints.each(@(c) {
      if c != determining_c and c.is_satisfied() {
        coll.append(c)
      }
    })
  }

  # Recomputes the walkabout strengths downstream of `c`. Returns false when
  # the walk runs back into a constraint it already marked, which means the
  # graph has a cycle.
  add_propagate(c, mark) {
    var todo = Vector.of(c)

    while !todo.is_empty() {
      var d = todo.remove_first()

      if d.get_output().mark == mark {
        self.incremental_remove(c)
        return false
      }

      d.recalculate()
      self.add_constraints_consuming_to(d.get_output(), todo)
    }

    return true
  }

  change(v, new_value) {
    var edit_c = EditConstraint(v, PREFERRED, self)
    var edit_v = Vector.of(edit_c)
    var plan = self.extract_plan_from_constraints(edit_v)

    iter var i = 0; i < 10; i++ {
      v.value = new_value
      plan.execute()
    }

    edit_c.destroy_constraint(self)
  }

  constraints_consuming(v, fn) {
    var determining_c = v.determined_by

    v.constraints.each(@(c) {
      if c != determining_c and c.is_satisfied() {
        fn(c)
      }
    })
  }

  remove_propagate_from(out) {
    var unsatisfied = Vector(nil)

    out.determined_by = nil
    out.walk_strength = ABSOLUTE_WEAKEST_STRENGTH
    out.stay = true

    var todo = Vector.of(out)

    while !todo.is_empty() {
      var v = todo.remove_first()

      v.constraints.each(@(c) {
        if !c.is_satisfied() {
          unsatisfied.append(c)
        }
      })

      self.constraints_consuming(v, @(c) {
        c.recalculate()
        todo.append(c.get_output())
      })
    }

    unsatisfied.sort(@(c1, c2) {
      return c1.strength.stronger(c2.strength)
    })

    return unsatisfied
  }
}

# A chain of n equality constraints, driven from one end and checked at the
# other. Every propagation has to walk the whole chain.
def chain_test(n) {
  var planner = Planner()
  var vars = [nil] * (n + 1)

  iter var i = 0; i < n + 1; i++ {
    vars[i] = Variable(0)
  }

  iter var i = 0; i < n; i++ {
    EqualityConstraint(vars[i], vars[i + 1], REQUIRED, planner)
  }

  StayConstraint(vars[n], STRONG_DEFAULT, planner)

  var edit_c = EditConstraint(vars[0], PREFERRED, planner)
  var edit_v = Vector.of(edit_c)
  var plan = planner.extract_plan_from_constraints(edit_v)

  iter var i = 0; i < 100; i++ {
    vars[0].value = i
    plan.execute()

    if vars[n].value != i {
      raise Error('Chain test failed!')
    }
  }

  edit_c.destroy_constraint(planner)
}

# n independent scale constraints sharing one scale and one offset variable,
# so changing either of those touches every one of them.
def projection_test(n) {
  var planner = Planner()
  var dests = Vector(nil)
  var scale = Variable(10)
  var offset = Variable(1_000)

  var src = nil
  var dst = nil

  iter var i = 1; i <= n; i++ {
    src = Variable(i)
    dst = Variable(i)
    dests.append(dst)

    StayConstraint(src, DEFAULT, planner)
    ScaleConstraint(src, scale, offset, dst, REQUIRED, planner)
  }

  planner.change(src, 17)
  if dst.value != 1_170 {
    raise Error('Projection test 1 failed!')
  }

  planner.change(dst, 1_050)
  if src.value != 5 {
    raise Error('Projection test 2 failed!')
  }

  planner.change(scale, 5)
  iter var i = 0; i < n - 1; i++ {
    if dests.at(i).value != (i + 1) * 5 + 1_000 {
      raise Error('Projection test 3 failed!')
    }
  }

  planner.change(offset, 2_000)
  iter var i = 0; i < n - 1; i++ {
    if dests.at(i).value != (i + 1) * 5 + 2_000 {
      raise Error('Projection test 4 failed!')
    }
  }
}

# 12000 is the input size the Are-We-Fast-Yet suite runs DeltaBlue at.
var INNER_ITERATIONS = 12_000
var OUTER_ITERATIONS = 10

def main() {
  iter var i = 0; i < OUTER_ITERATIONS; i++ {
    chain_test(INNER_ITERATIONS)
    projection_test(INNER_ITERATIONS)
  }

  echo '${OUTER_ITERATIONS} runs of chain_test(${INNER_ITERATIONS}) and ' +
    'projection_test(${INNER_ITERATIONS}) verified'
}

var start = time()
main()

echo '\nTotal time taken: ${time() - start}s'
