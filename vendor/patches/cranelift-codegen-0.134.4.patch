+/// Intel cores from Skylake to Cascade Lake, with the microcode that fixes
+/// their jump erratum, keep any 32-byte block of code holding a jump that
+/// crosses or ends on a 32-byte boundary out of the decoded-uop cache. A
+/// loop whose jumps land that way decodes from scratch on every turn, so
+/// its speed swings with wherever the code before it happens to end. When
+/// `set_place_jumps` has turned it on, each jump is placed clear of those
+/// boundaries, a conditional one together with the instruction before it,
+/// which it fuses with, padding with nops before them when they would
+/// straddle one.
+const JUMP_WINDOW: CodeOffset = 32;
+
+fn clear_of_boundary(start: CodeOffset, end: CodeOffset) -> bool {
+    start / JUMP_WINDOW == (end - 1) / JUMP_WINDOW && end % JUMP_WINDOW != 0
+}
+
+fn nop_bytes(mut len: CodeOffset) -> SmallVec<[u8; 32]> {
+    const NOPS: [&[u8]; 9] = [
+        &[0x90],
+        &[0x66, 0x90],
+        &[0x0f, 0x1f, 0x00],
+        &[0x0f, 0x1f, 0x40, 0x00],
+        &[0x0f, 0x1f, 0x44, 0x00, 0x00],
+        &[0x66, 0x0f, 0x1f, 0x44, 0x00, 0x00],
+        &[0x0f, 0x1f, 0x80, 0x00, 0x00, 0x00, 0x00],
+        &[0x0f, 0x1f, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00],
+        &[0x66, 0x0f, 0x1f, 0x84, 0x00, 0x00, 0x00, 0x00, 0x00],
+    ];
+    let mut out = SmallVec::new();
+    while len > 0 {
+        let n = len.min(9);
+        out.extend_from_slice(NOPS[n as usize - 1]);
+        len -= n;
+    }
+    out
+}
+
+/// Places the `len` bytes of jumps about to be emitted clear of a 32-byte
+/// boundary, along with the instruction just emitted when `fuses`.
+fn place_jumps(sink: &mut MachBuffer<Inst>, state: &EmitState, len: CodeOffset, fuses: bool) {
+    if !crate::isa::x64::place_jumps() {
+        return;
+    }
+    let cur = sink.cur_offset();
+    let end = cur + len;
+    if fuses && state.prev_end == cur && state.prev_start < cur {
+        let start = state.prev_start;
+        if clear_of_boundary(start, end) {
+            return;
+        }
+        if end - start < JUMP_WINDOW {
+            let pad = nop_bytes(JUMP_WINDOW - start % JUMP_WINDOW);
+            if sink.insert_padding(start, &pad) {
+                return;
+            }
+        }
+    }
+    if !clear_of_boundary(cur, end) && len < JUMP_WINDOW {
+        sink.put_data(&nop_bytes(JUMP_WINDOW - cur % JUMP_WINDOW));
+    }
+}
