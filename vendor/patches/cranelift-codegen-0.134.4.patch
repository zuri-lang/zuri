+static PLACE_JUMPS: core::sync::atomic::AtomicBool = core::sync::atomic::AtomicBool::new(false);
+
+/// Whether code emitted from now on places its jumps clear of 32-byte
+/// boundaries, for Intel cores with the jump conditional code erratum
+/// (Skylake through Cascade Lake, with the microcode that fixes it),
+/// which otherwise keep such code out of their decoded-uop cache. Off by
+/// default. It pays off only together with functions aligned to 32
+/// bytes (the shared `log2_min_function_alignment` setting at 5), since
+/// the placement is worked out from the start of the function.
+pub fn set_place_jumps(on: bool) {
+    PLACE_JUMPS.store(on, core::sync::atomic::Ordering::Relaxed);
+}
+
+pub(crate) fn place_jumps() -> bool {
+    PLACE_JUMPS.load(core::sync::atomic::Ordering::Relaxed)
+}
