+    /// Inserts `bytes` at offset `at`, moving the code after it along,
+    /// provided nothing refers to that code by offset except label fixups
+    /// and source locations, which move with it. Declines otherwise:
+    /// when a label is bound past `at`, a branch or any other record
+    /// (relocation, trap, call site, stack map, unwind entry, constant use)
+    /// lies at or past it. Returns whether the bytes went in.
+    pub fn insert_padding(&mut self, at: CodeOffset, bytes: &[u8]) -> bool {
+        let cur = self.cur_offset();
+        if at > cur {
+            return false;
+        }
+        let n = bytes.len() as CodeOffset;
+        if n == 0 {
+            return true;
+        }
+        if self.open_patchable
+            || self.latest_branches.iter().any(|b| b.end > at)
+            || self
+                .label_offsets
+                .iter()
+                .any(|&o| o != UNKNOWN_LABEL_OFFSET && o > at)
+            || self.relocs.iter().any(|r| r.offset >= at)
+            || self.traps.iter().any(|t| t.offset >= at)
+            || self.call_sites.iter().any(|c| c.ret_addr >= at)
+            || self.patchable_call_sites.iter().any(|c| c.ret_addr >= at)
+            || self.user_stack_maps.iter().any(|m| m.0 >= at)
+            || self.unwind_info.iter().any(|u| u.0 >= at)
+            || self.used_constants.iter().any(|u| u.1 >= at)
+            || self.debug_tags.iter().any(|t| t.offset >= at)
+            || self.fixup_records.iter().any(|f| f.offset >= at)
+        {
+            return false;
+        }
+        let at_usize = at as usize;
+        let tail: SmallVec<[u8; 32]> = self.data[at_usize..].iter().copied().collect();
+        self.data.truncate(at_usize);
+        self.data.extend_from_slice(bytes);
+        self.data.extend_from_slice(&tail);
+        for f in self.pending_fixup_records.iter_mut() {
+            if f.offset >= at {
+                f.offset += n;
+            }
+        }
+        for loc in self.srclocs.iter_mut() {
+            if loc.start >= at {
+                loc.start += n;
+            }
+            if loc.end > at {
+                loc.end += n;
+            }
+        }
+        if let Some((start, _)) = self.cur_srcloc.as_mut()
+            && *start >= at
+        {
+            *start += n;
+        }
+        if self.labels_at_tail_off > at {
+            self.labels_at_tail_off += n;
+        }
+        true
+    }
