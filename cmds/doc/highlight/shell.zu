/**
 * Shell scripts, and terminal sessions.
 *
 * A script is read the way a POSIX shell reads one, as far as colour
 * needs: comments, quoting, variables and substitutions, the word in
 * command position, flags, operators, and here-documents.
 *
 * A session is what a terminal showed: commands typed after a prompt,
 * and what they printed. A line opening with `$ `, `% `, `> ` or a
 * PowerShell `PS ...> ` prompt is a command, as are the lines a
 * trailing backslash continues it onto. Every other line is output. A
 * session with no prompt in it at all is a program's output on its own.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import .spans { escape, is_word, line_end, run_end, span, words }
import .zuri_lang { output_kind }

var _KEYWORDS = words(
  'if then else elif fi for while until do done case esac in function return export local readonly set unset source select time',
)

# Words after which the next word is a command again.
var _LEADS = words('then else do elif if while until')

# Characters that end a bare word.
var _BREAKS = ' \t\n;|&<>()`"\''

def _is_bare(c: string) {
  return !_BREAKS.contains(c)
}

# A `$` expansion starting at _start_: `$name`, `${...}`, `$(...)`,
# `$((...))` or a special parameter. Returns where it ends.
def _expansion_end(text: string, start: number) {
  var length = text.length()
  var i = start + 1

  if i >= length {
    return i
  }

  var c = text[i]

  if c == '{' or c == '(' {
    var close = c == '{' ? '}' : ')'
    var depth = 0

    while i < length {
      if text[i] == c {
        depth++
      } else if text[i] == close {
        depth--

        if depth == 0 {
          return i + 1
        }
      } else if text[i] == '\n' {
        return i
      }

      i++
    }

    return length
  }

  if is_word(c) {
    return run_end(text, i, @(x) => is_word(x))
  }

  if '@*#?$!-0123456789'.contains(c) {
    return i + 1
  }

  return start + 1
}

# A double-quoted string from its opening quote, with the expansions
# inside it marked. Returns where it ends.
def _double_quoted(out: list, text: string, start: number) {
  var length = text.length()
  var i = start + 1
  var at = start

  out.append('<span class="str">')

  while i < length {
    var c = text[i]

    if c == '\\' {
      i += 2
      continue
    }

    if c == '"' {
      i++
      break
    }

    if c == '$' {
      var end = _expansion_end(text, i)

      if end > i + 1 {
        out.append(escape(text[at, i]))
        out.append(span('var', text[i, end]))
        i = end
        at = i
        continue
      }
    }

    i++
  }

  i = i.min(length)
  out.append(escape(text[at, i]))
  out.append('</span>')

  return i
}

/**
 * A shell script as highlighted markup.
 *
 * @param string source
 * @returns string
 */
def highlight(source: string) {
  var out = []
  var length = source.length()
  var i = 0
  var command = true
  var heredocs = []

  while i < length {
    var c = source[i]

    if c == '\n' {
      out.append('\n')
      i++
      command = true

      # Here-documents begin on the line after the one that asked for
      # them, and run until their closing word stands on a line alone.
      while !heredocs.is_empty() and i < length {
        var marker = heredocs.shift()
        var body_start = i
        var found = false

        while i < length {
          var end = line_end(source, i)
          var line = source[i, end]

          if line.trim() == marker {
            out.append(span('str', source[body_start, i]))
            out.append(span('kw', line))
            i = end
            found = true
            break
          }

          i = end + 1
        }

        if !found {
          out.append(span('str', source[body_start, length]))
          i = length
        }
      }

      continue
    }

    if c == ' ' or c == '\t' {
      out.append(c)
      i++
      continue
    }

    if c == '#' and (i == 0 or source[i - 1].is_space()) {
      var end = line_end(source, i)

      out.append(span('com', source[i, end]))
      i = end
      continue
    }

    if c == '\\' and i + 1 < length {
      out.append(escape(source[i, i + 2]))
      i += 2
      continue
    }

    if c == "'" {
      var end = source.index_of("'", i + 1)

      end = end < 0 ? length : end + 1
      out.append(span('str', source[i, end]))
      i = end
      command = false
      continue
    }

    if c == '"' {
      i = _double_quoted(out, source, i)
      command = false
      continue
    }

    if c == '$' {
      var end = _expansion_end(source, i)

      out.append(span('var', source[i, end]))
      i = end
      command = false
      continue
    }

    if c == '<' and source[i, (i + 2).min(length)] == '<<' {
      var match = source[i,].match(
        '/^<<-?\s*([\'"]?)([A-Za-z_][A-Za-z0-9_]*)\1/',
      )

      if match != false {
        heredocs.append(match[2])
        out.append(span('op', match[0]))
        i += match[0].length()
        continue
      }
    }

    if '|&;<>()'.contains(c) {
      var end = run_end(source, i, @(x) => '|&;<>'.contains(x))

      if end == i {
        end = i + 1
      }

      out.append(span('op', source[i, end]))
      command = c != '>' and c != '<'
      i = end
      continue
    }

    var end = run_end(source, i, @(x) => _is_bare(x))

    if end == i {
      out.append(escape(c))
      i++
      continue
    }

    var word = source[i, end]
    var assignment = word.match('/^[A-Za-z_][A-Za-z0-9_]*=/')

    if command and assignment != false {
      out.append(span('var', assignment[0][0, assignment[0].length() - 1]))
      out.append(span('op', '='))
      out.append(escape(word[assignment[0].length(),]))
    } else if command and _KEYWORDS.contains(word) {
      out.append(span('kw', word))
      command = _LEADS.contains(word) or
          word == 'export' or
          word == 'local' or
          word == 'time'
      i = end
      continue
    } else if command {
      out.append(span('fn', word))
      command = false
    } else if word.starts_with('-') and word.length() > 1 {
      var equals = word.index_of('=')

      if equals > 0 {
        out.append(span('attr', word[0, equals]))
        out.append(escape(word[equals,]))
      } else {
        out.append(span('attr', word))
      }
    } else if word.match('/^[0-9]+$/') != false {
      out.append(span('num', word))
    } else {
      out.append(escape(word))
    }

    i = end
  }

  return ''.join(out)
}

# Where the prompt at the start of _line_ ends, or 0 for a line that has
# none.
def _prompt_end(line: string) {
  if line.starts_with('$ ') or line == '$' or line.starts_with('> ') {
    return line.length() == 1 ? 1 : 2
  }

  # zsh's prompt, but not the Zuri REPL's `%>`.
  if line.starts_with('% ') {
    return 2
  }

  var powershell = line.match('/^PS( [^>]*)?> /')

  if powershell != false {
    return powershell[0].length()
  }

  return 0
}

/**
 * Whether _source_ shows any command typed at a prompt, which is what
 * tells a terminal session from a program's output alone.
 *
 * @param string source
 * @returns bool
 */
def has_prompt(source: string) {
  for line in source.split('\n') {
    if _prompt_end(line) > 0 {
      return true
    }
  }

  return false
}

/**
 * A terminal session as highlighted markup.
 *
 * @param string source
 * @returns string
 */
def highlight_session(source: string) {
  var lines = source.split('\n')
  var session = has_prompt(source)
  var out = []
  var continued = false

  iter var n = 0; n < lines.length(); n++ {
    if n > 0 {
      out.append('\n')
    }

    var line = lines[n]

    if continued {
      out.append(highlight(line))
      continued = line.ends_with('\\')
      continue
    }

    var cut = _prompt_end(line)

    if cut > 0 {
      out.append(span('prompt', line[0, cut]))
      out.append(highlight(line[cut,]))
      continued = line.ends_with('\\')
      continue
    }

    if session and line.starts_with('# ') {
      out.append(span('com', line))
      continue
    }

    out.append(span(output_kind(line, session ? 'out' : nil), line))
  }

  return ''.join(out)
}
