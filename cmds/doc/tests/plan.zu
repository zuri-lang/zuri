# Tests for the planning layer: what the command line asks for, and
# where the book it is asked about is.

import os
import os.tempfile { create_temp_dir }
import test { * }

import ..plan {
  DEFAULT_HOST,
  DEFAULT_PORT,
  default_title,
  find_book,
  init_target,
  parser,
  settings,
}
import ..scaffold { files }

var DIR = nil

def put(path: string, text: string) {
  var full = os.join_paths(DIR, path)

  os.create_dir(os.dir_name(full), 0c755, true)
  file(full, 'w').write(text)
}

def chosen(words: list) {
  return settings(parser().parse(words), DIR)
}

def refusal(work: function) {
  var message = nil

  catch {
    work()
  } as error {
    message = error.message
  }

  expect(message).not.to_be_nil()

  return message
}

before_each(@{
  DIR = os.real_path(create_temp_dir('zuri-doc-plan-'))
})

after_each(@{
  os.remove_dir(DIR, true)
})

describe('settings', @{
  it('builds when no command is given', @{
    var given = chosen([])

    expect(given.command).to_be('build')
    expect(given.dir).to_be_nil()
    expect(given.port).to_be(DEFAULT_PORT)
    expect(given.host).to_be(DEFAULT_HOST)
  })

  it('takes the book after the command', @{
    var given = chosen(['serve', 'manual', '-p', '4000'])

    expect(given.command).to_be('serve')
    expect(given.dir).to_be('manual')
    expect(given.port).to_be(4000)
  })

  it('makes the output directory absolute', @{
    expect(chosen(['build', '-o', 'out']).out).to_be(os.join_paths(DIR, 'out'))
  })

  it('refuses an option that does not go with the command', @{
    expect(
      refusal(@{
        chosen(['build', '--port', '80'])
      }),
    ).to_contain('--port goes with serve')
    expect(
      refusal(@{
        chosen(['serve', '--strict'])
      }),
    ).to_contain('--strict goes with build')
  })

  it('refuses a port out of range', @{
    expect(
      refusal(@{
        chosen(['serve', '-p', '70000'])
      }),
    ).to_contain('--port')
  })
})

describe('find_book', @{
  it('takes the directory named, or the doc.toml in it', @{
    put('manual/doc.toml', '')

    var manual = os.join_paths(DIR, 'manual')

    expect(find_book('manual', DIR)).to_be(manual)
    expect(find_book('manual/doc.toml', DIR)).to_be(manual)
  })

  it('takes the current directory when it holds a book', @{
    put('doc.toml', '')
    expect(find_book(nil, DIR)).to_be(DIR)
  })

  it("takes the project's docs from anywhere in the project", @{
    put('project.toml', '[project]\nname = "weather"\n')
    put('docs/doc.toml', '')
    put('app/index.zu', '')

    expect(find_book(nil, os.join_paths(DIR, 'app')))
        .to_be(os.join_paths(DIR, 'docs'))
  })

  it('says how to start a book when there is none', @{
    expect(
      refusal(@{
        find_book(nil, DIR)
      }),
    ).to_contain('zuri doc init')
    expect(
      refusal(@{
        find_book('nowhere', DIR)
      }),
    ).to_contain('nowhere')
  })
})

describe('init', @{
  it("starts a book in the project's docs", @{
    put('project.toml', '[project]\nname = "weather"\n')

    var target = init_target(nil, DIR)

    expect(target).to_be(os.join_paths(DIR, 'docs'))
    expect(default_title(target)).to_be('weather')
  })

  it('starts a book where it is told to, named after the directory', @{
    var target = init_target('manual', DIR)

    expect(target).to_be(os.join_paths(DIR, 'manual'))
    expect(default_title(target)).to_be('manual')
  })

  it('writes a book that builds', @{
    var written = files('Weather "Now"')

    expect(written.keys()).to_contain('src/SUMMARY.md')
    expect(written['doc.toml']).to_contain('title = "Weather \\"Now\\""')
  })
})
