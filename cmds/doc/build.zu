/**
 * Builds documentation together with the documentation inside it.
 *
 * A directory beside the pages that holds a `doc.toml` of its own is
 * more documentation, such as the API reference `zuri doc generate`
 * writes to `docs/reference`. It is built into the directory of the site
 * with the same name, so one site holds them all, and the top of every
 * page links to each: the outer documentation as "Docs", a reference as
 * "API Reference", anything else by its title, unless its own `[site]
 * label` says otherwise. What a member leaves unset of the outer one's
 * logo, favicon, repository, link home, stylesheets, scripts and links
 * it takes from there, so the pages look like one site.
 *
 * A reference's pages are generated again before it is built, so it is
 * never older than the code.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import os

import .config
import .config { Config }
import .documentation
import .external as outside
import .reference
import .site { Site, is_absolute }

/**
 * One site built: its settings, and what building it reported.
 */
class Built {

  /** @type Config */
  var config

  /** How many pages it has. @type number */
  var pages = 0

  /** How long building it took, in seconds. @type number */
  var seconds = 0

  /** What generating its pages reported, for a reference. @type list[string] */
  var warnings = []

  /** Each link inside it that leads nowhere. @type list[string] */
  var links = []

  /**
   * Each link out of it whose address is broken, when those were
   * checked.
   *
   * @type list[string]
   */
  var external = []

  @new(config: Config) {
    self.config = config
    self.warnings = []
    self.links = []
    self.external = []
  }
}

/**
 * The name the links at the top of the pages give _settings_.
 *
 * @param Config settings
 * @param bool outer: whether it is the documentation the others are in.
 * @returns string
 */
def label_of(settings: Config, outer: bool) {
  if settings.label != nil {
    return settings.label
  }

  if outer {
    return 'Docs'
  }

  return settings.reference == nil ? settings.title : 'API Reference'
}

# _address_, written for the outer site's front page, as the front page
# of a member one directory down reaches it.
def _deeper(address: string) {
  return is_absolute(address) ? address : '../' + address
}

# The settings of the member in _directory_, written into the outer
# site and taking what it leaves unset from it.
def _member(outer: Config, directory: string) {
  var member = config.load(directory)
  var name = os.base_name(directory)

  if outer.sandbox != nil {
    config.confine(member, outer.sandbox)
  }

  member.output = os.join_paths(outer.output, name)

  if outer.url != nil {
    member.url = '${outer.url}${name}/'
  }

  if member.logo == nil {
    member.logo = outer.logo
  }

  if member.favicon == nil {
    member.favicon = outer.favicon
  }

  if member.repository == nil {
    member.repository = outer.repository
  }

  if member.home == nil and outer.home != nil {
    member.home = { url: _deeper(outer.home.url), label: outer.home.label }
  }

  if member.css.is_empty() {
    member.css = outer.css
  }

  if member.js.is_empty() {
    member.js = outer.js
  }

  if member.links.is_empty() {
    member.links = outer.links.map(
      @(link) => { url: _deeper(link.url), label: link.label },
    )
  }

  return member
}

# The path from the front page of the site at _from_ to the front page
# of the one at _to_, by their places among the sites built together,
# the outer one first.
def _path_between(from: number, to: number, names: list) {
  if from == to {
    return ''
  }

  if from == 0 {
    return '${names[to]}/'
  }

  return to == 0 ? '../' : '../${names[to]}/'
}

# Puts the links between the sites at the front of each one's own, and
# tells each where the others' pages are, so a link between them leads
# where it should.
def _link(sites: list) {
  var outer = sites[0]
  var names = sites.map(@(each) => os.base_name(each.root))

  iter var i = 0; i < sites.length(); i++ {
    var here = sites[i]
    var links = []

    iter var j = 0; j < sites.length(); j++ {
      var path = _path_between(i, j, names)

      links.append({
        url: '${path}index.html',
        label: label_of(sites[j], j == 0),
        current: i == j,
      })

      if i != j {
        here.siblings.append({
          source: sites[j].source,
          prefix: path,
          index: j,
        })
      }
    }

    here.links = links + here.links
  }
}

# Checks each link one site makes into another, now that all of them are
# built, and adds a warning for each that leads nowhere to the site the
# link is in.
def _check_across(sites: list, built: list) {
  iter var i = 0; i < sites.length(); i++ {
    for each in sites[i].across {
      var link = each.link
      var target = sites[link.site]
      var name = label_of(target.config, link.site == 0)

      if link.get('file') != nil {
        if !target.has_file(link.file) {
          built[i].links.append(
            '${each.where}: links to ${link.file} in ${name}, which is not there',
          )
        }

        continue
      }

      if !target.has_page(link.page) {
        built[i].links.append(
          "${each.where}: links to ${link.source} in ${name}, which its SUMMARY.md does not list",
        )
        continue
      }

      if !link.fragment.is_empty() and
          !target.has_id(link.page, link.fragment) {
        built[i].links.append(
          '${each.where}: ${link.source} in ${name} has no heading or id #${link.fragment}',
        )
      }
    }
  }
}

/**
 * Builds the documentation at _settings_ and every member of it, the
 * outer one first, since building it empties the site the members are
 * built into. A reference's pages are all generated before anything is
 * built, and the links between the sites are checked once every one of
 * them is.
 *
 * @param Config settings
 * @param ?bool live: whether the pages reload themselves when
 *    `zuri doc serve` rebuilds them.
 * @param ?bool external: whether every link leading out of them to an
 *    `http` or `https` address is asked for, to see that it answers.
 * @returns list[Built]: the outer documentation first.
 * @throws UsageError When any of them cannot be read or built
 */
def build(settings: Config, live: ?bool, external: ?bool) {
  var configs = [settings] +
      settings.members.map(@(directory) => _member(settings, directory))

  if configs.length() > 1 {
    _link(configs)
  }

  var built = configs.map(@(each) => Built(each))

  iter var i = 0; i < configs.length(); i++ {
    if configs[i].reference != nil {
      built[i].warnings = reference.generate(configs[i]).warnings
    }
  }

  var sites = []

  iter var i = 0; i < configs.length(); i++ {
    var site = Site(documentation.load(configs[i]), live)
    var report = site.build()

    built[i].pages = report.pages
    built[i].seconds = report.seconds
    built[i].links = report.warnings
    sites.append(site)
  }

  _check_across(sites, built)

  if external == true {
    var links = []

    iter var i = 0; i < sites.length(); i++ {
      for link in sites[i].externals() {
        link.set('site', i)
        links.append(link)
      }
    }

    for broken in outside.check(links) {
      var link = broken.link

      built[link.site].external.append(
        '${link.where}: ${link.url} ${broken.reason}',
      )
    }
  }

  return built
}
