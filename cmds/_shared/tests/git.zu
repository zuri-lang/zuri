# Git dependencies, against repositories on this machine: which
# addresses git may be pointed at, what a tag, a branch or a commit
# resolves to, and packing a commit the same way every time.

import os
import os.process { spawn }
import test { * }

import ..fsx
import ..git

var ROOT = os.create_temp_dir('zuri-git-')
var HOME = os.join_paths(ROOT, 'home')
var REPO = os.join_paths(ROOT, 'tools')

# Runs git in `dir` with an identity of its own, returning its output.
def git_in(dir: string, words: list) {
  var child = spawn('git', words, {
    cwd: dir,
    stdin: 'null',
    stdout: 'pipe',
    stderr: 'pipe',
    env: {
      GIT_AUTHOR_NAME: 'Test', GIT_AUTHOR_EMAIL: 'test@example.test',
      GIT_COMMITTER_NAME: 'Test', GIT_COMMITTER_EMAIL: 'test@example.test',
    },
  })

  var out = child.read_stdout().to_string()
  var err = child.read_stderr().to_string()

  if child.wait() != 0 {
    raise Error('git ${words[0]} failed: ${err}')
  }

  return out.trim().rtrim('\n').rtrim('\r')
}

# Writes the package at `version` and commits it.
def commit_version(version: string) {
  fsx.atomic_write(os.join_paths(REPO, 'project.toml'),
    '[project]\nname = "tools"\nversion = "${version}"\ndescription = "Tools"\n')
  fsx.atomic_write(os.join_paths(REPO, 'app', 'index.zu'), 'echo "${version}"\n')

  git_in(REPO, ['add', '-A'])
  git_in(REPO, ['commit', '-q', '-m', 'version ${version}'])

  return git_in(REPO, ['rev-parse', 'HEAD'])
}

var FIRST = nil
var SECOND = nil

before_all(@{
  fsx.ensure_dir(HOME)
  fsx.ensure_dir(os.join_paths(REPO, 'app'))
  os.set_env('ZURI_HOME', HOME, true)

  git_in(REPO, ['init', '-q', '-b', 'main'])

  FIRST = commit_version('1.0.0')
  git_in(REPO, ['tag', '-a', 'v1.0.0', '-m', 'the first release'])
  git_in(REPO, ['checkout', '-q', '-b', 'next'])
  SECOND = commit_version('1.1.0')
  git_in(REPO, ['checkout', '-q', 'main'])
})

after_all(@{
  fsx.remove(ROOT)
})

describe('addresses', @{
  it('accepts the transports that cannot run a command', @{
    for address in ['https://example.com/tools.git', 'ssh://git@example.com/tools.git',
      'git@example.com:acme/tools.git', 'file:///srv/tools.git', '../tools'] {
      expect(git.is_allowed(address)).to_be_true()
    }
  })

  it('refuses the ones that can, and anything git would read as a flag', @{
    for address in ['ext::sh -c touch% /tmp/owned', 'fd::17', '-uploadpack=touch',
      'transport::example', ''] {
      expect(git.is_allowed(address)).to_be_false()
    }

    expect(@{
      git.resolve('ext::sh -c id', nil)
    }).to_raise_instance_of(git.GitError)
  })
})

describe('resolving', @{
  it('follows the default branch', @{
    expect(git.resolve(REPO, nil)).to_equal(FIRST)
  })

  it('peels an annotated tag to its commit', @{
    expect(git.resolve(REPO, { kind: 'tag', value: 'v1.0.0' })).to_equal(FIRST)
  })

  it('follows a branch', @{
    expect(git.resolve(REPO, { kind: 'branch', value: 'next' })).to_equal(SECOND)
  })

  it('takes a full commit id as it stands', @{
    expect(git.resolve(REPO, { kind: 'rev', value: SECOND })).to_equal(SECOND)
  })

  it('says when a tag is not there', @{
    expect(@{
      git.resolve(REPO, { kind: 'tag', value: 'v9.9.9' })
    }).to_raise_instance_of(git.GitError)
  })
})

describe('fetching', @{
  it('packs a commit under the name the repository gives', @{
    var fetched = git.fetch(nil, REPO, FIRST, nil)

    expect(fetched.version).to_equal('1.0.0')
    expect(fetched.manifest.name()).to_equal('tools')
    expect(fetched.checksum).to_start_with('sha256:')
    expect(file(fetched.archive).exists()).to_be_true()
  })

  it('packs the same commit to the same checksum every time', @{
    var first = git.fetch('tools', REPO, SECOND, nil)
    var again = git.fetch('tools', REPO, SECOND, first.checksum)

    expect(again.checksum).to_equal(first.checksum)
    expect(again.version).to_equal('1.1.0')
  })

  it('refuses a repository that calls its package something else', @{
    expect(@{
      git.fetch('hammers', REPO, FIRST, nil)
    }).to_raise_instance_of(git.GitError)
  })

  it('refuses a commit that no longer packs to the recorded checksum', @{
    expect(@{
      git.fetch('tools', REPO, FIRST, 'sha256:' + '0' * 64)
    }).to_raise_instance_of(git.GitError)
  })

  it('refuses a commit with no project.toml', @{
    var bare = os.join_paths(ROOT, 'bare')

    fsx.ensure_dir(bare)
    git_in(bare, ['init', '-q', '-b', 'main'])
    fsx.atomic_write(os.join_paths(bare, 'README.md'), '# Nothing here\n')
    git_in(bare, ['add', '-A'])
    git_in(bare, ['commit', '-q', '-m', 'readme'])

    var commit = git_in(bare, ['rev-parse', 'HEAD'])

    expect(@{
      git.fetch(nil, bare, commit, nil)
    }).to_raise_instance_of(git.GitError)
  })
})
