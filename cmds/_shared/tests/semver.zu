# Versions, their ordering, and what a range admits.

import test { * }

import ..semver {
  Range,
  SemverError,
  compare,
  is_breaking,
  is_valid,
  is_valid_range,
  max_satisfying,
  parse,
  sorted,
}

describe('parse', @{
  it('reads the three numbers', @{
    var v = parse('1.22.333')

    expect([v.major, v.minor, v.patch]).to_equal([1, 22, 333])
    expect(v.is_prerelease()).to_be_false()
  })

  it('keeps pre-release and build identifiers apart', @{
    var v = parse('1.0.0-rc.1+build.5')

    expect(v.pre).to_equal(['rc', '1'])
    expect(v.build).to_equal(['build', '5'])
    expect(v.to_string()).to_equal('1.0.0-rc.1+build.5')
  })

  it('takes the v a tag is spelled with', @{
    expect(parse('v2.0.1').to_string()).to_equal('2.0.1')
  })

  it('refuses what is not a version', @{
    for text in ['1.2', '1.2.3.4', '01.2.3', '1.2.3-', '1.2.3-01', 'latest', ''] {
      expect(is_valid(text)).to_be_false()
    }
  })

  it('raises an error the command reports', @{
    expect(@{
      parse('nope')
    }).to_raise_instance_of(SemverError)
  })
})

describe('compare', @{
  it('follows the specification example ordering', @{
    var chain = [
      '1.0.0-alpha', '1.0.0-alpha.1', '1.0.0-alpha.beta', '1.0.0-beta',
      '1.0.0-beta.2', '1.0.0-beta.11', '1.0.0-rc.1', '1.0.0',
    ]

    iter var i = 0; i < chain.length() - 1; i++ {
      expect(compare(chain[i], chain[i + 1])).to_equal(-1)
      expect(compare(chain[i + 1], chain[i])).to_equal(1)
    }
  })

  it('compares numbers as numbers', @{
    expect(compare('1.10.0', '1.9.0')).to_equal(1)
    expect(compare('10.0.0', '9.99.99')).to_equal(1)
  })

  it('ignores build metadata', @{
    expect(compare('1.0.0+a', '1.0.0+b')).to_equal(0)
  })

  it('sorts a list without losing the text it was given', @{
    var shuffled = ['2.0.0', '1.0.0-rc.1', '1.10.0', '1.0.0', '1.2.0']

    expect(sorted(shuffled)).to_equal(['1.0.0-rc.1', '1.0.0', '1.2.0', '1.10.0', '2.0.0'])
  })
})

describe('Range', @{
  it('reads a bare version as a caret range', @{
    var r = Range('1.2.3')

    expect(r.satisfies('1.2.3')).to_be_true()
    expect(r.satisfies('1.9.0')).to_be_true()
    expect(r.satisfies('2.0.0')).to_be_false()
    expect(r.satisfies('1.2.2')).to_be_false()
  })

  it('narrows a caret below 1.0.0', @{
    expect(Range('^0.2.3').satisfies('0.2.9')).to_be_true()
    expect(Range('^0.2.3').satisfies('0.3.0')).to_be_false()
    expect(Range('^0.0.3').satisfies('0.0.3')).to_be_true()
    expect(Range('^0.0.3').satisfies('0.0.4')).to_be_false()
    expect(Range('^0.0').satisfies('0.0.9')).to_be_true()
    expect(Range('^0.0').satisfies('0.1.0')).to_be_false()
  })

  it('keeps a tilde to the minor version', @{
    expect(Range('~1.2.3').satisfies('1.2.9')).to_be_true()
    expect(Range('~1.2.3').satisfies('1.3.0')).to_be_false()
    expect(Range('~1').satisfies('1.9.9')).to_be_true()
  })

  it('pins with =', @{
    expect(Range('=1.2.3').satisfies('1.2.3')).to_be_true()
    expect(Range('=1.2.3').satisfies('1.2.4')).to_be_false()
    expect(Range('=1.2.3').is_exact()).to_be_true()
    expect(Range('^1.2.3').is_exact()).to_be_false()
  })

  it('reads wildcards as pinning what comes before them', @{
    for text in ['1.2.x', '1.2.*', '1.2.X', '=1.2'] {
      expect(Range(text).satisfies('1.2.7')).to_be_true()
      expect(Range(text).satisfies('1.3.0')).to_be_false()
    }

    expect(Range('1.x').satisfies('1.9.0')).to_be_true()
    expect(Range('1.x').satisfies('2.0.0')).to_be_false()
  })

  it('reads a partial version with no wildcard as a caret', @{
    expect(Range('1.2').satisfies('1.9.0')).to_be_true()
    expect(Range('1.2').satisfies('1.1.9')).to_be_false()
    expect(Range('1').satisfies('1.0.0')).to_be_true()

    expect(Range('*').satisfies('99.0.0')).to_be_true()
    expect(Range('').satisfies('0.0.1')).to_be_true()
  })

  it('reads comparators, spaced or joined, with commas or without', @{
    var r = Range('>= 1.2, < 1.5.0')

    expect(r.satisfies('1.2.0')).to_be_true()
    expect(r.satisfies('1.4.9')).to_be_true()
    expect(r.satisfies('1.5.0')).to_be_false()

    expect(Range('>1.2.3 <=2.1').satisfies('2.1.9')).to_be_true()
    expect(Range('>1.2.3 <=2.1').satisfies('1.2.3')).to_be_false()
    expect(Range('<2').satisfies('1.99.0')).to_be_true()
    expect(Range('<2').satisfies('2.0.0')).to_be_false()
  })

  it('matches when any alternative does', @{
    var r = Range('^1.2 || ^3.0')

    expect(r.satisfies('1.5.0')).to_be_true()
    expect(r.satisfies('2.0.0')).to_be_false()
    expect(r.satisfies('3.1.0')).to_be_true()
  })

  it('never hands a pre-release to somebody who asked for releases', @{
    expect(Range('^1.2.3').satisfies('1.3.0-beta.1')).to_be_false()
    expect(Range('*').satisfies('1.0.0-rc.1')).to_be_false()
    expect(Range('<2.0.0').satisfies('2.0.0-rc.1')).to_be_false()
  })

  it('admits pre-releases of the version a range names', @{
    var r = Range('^1.2.3-beta.1')

    expect(r.satisfies('1.2.3-beta.4')).to_be_true()
    expect(r.satisfies('1.2.3')).to_be_true()
    expect(r.satisfies('1.3.0-alpha.1')).to_be_false()
    expect(r.satisfies('1.2.3-alpha.9')).to_be_false()
  })

  it('refuses what is not a range', @{
    for text in ['^', '1.*.3', '>=banana', '~>1.2', '1.2-beta'] {
      expect(is_valid_range(text)).to_be_false()
    }
  })
})

describe('max_satisfying', @{
  it('picks the highest version in range', @{
    var versions = ['1.0.0', '1.4.2', '1.10.0', '2.0.0', '2.1.0-rc.1']

    expect(max_satisfying(versions, '^1.0')).to_equal('1.10.0')
    expect(max_satisfying(versions, '^2')).to_equal('2.0.0')
    expect(max_satisfying(versions, '^3')).to_be_nil()
  })
})

describe('is_breaking', @{
  it('calls a new major breaking, and a new minor below 1.0.0', @{
    expect(is_breaking('1.2.3', '1.9.0')).to_be_false()
    expect(is_breaking('1.2.3', '2.0.0')).to_be_true()
    expect(is_breaking('0.2.3', '0.3.0')).to_be_true()
    expect(is_breaking('0.2.3', '0.2.9')).to_be_false()
  })
})
