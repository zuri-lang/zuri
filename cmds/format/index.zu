/**
 * @command format
 * @description Lay out Zuri source in the project style.
 * 
 * The `format` command: lay out Zuri source in the project's own style.
 *
 *   zuri format <path>
 *
 * `path` is a single `.zu` file, formatted in place, or a directory,
 * whose `.zu` files are all formatted, its subdirectories included. Left
 * off, it formats the current directory. The `dry-run` flag reports what
 * would change without writing anything, which is what a commit hook or
 * CI wants.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import args
import os
import os.process { exit }

import .engine

# Every `.zu` file `path` points at: the one file, or every file under
# the directory, deepest included, in a stable order.
def _targets(path: string) {
  if os.is_dir(path) {
    var found = []

    for name in os.read_dir(path, true) {
      if name.ends_with('.zu') {
        found.append(os.join_paths(path, name))
      }
    }

    return found.sort()
  }

  return [path]
}

# Formats one file. Returns `'unchanged'`, `'changed'` (written, unless
# checking), or `'would-change'` when checking. Raises through on a
# `FormatError`, which the caller turns into a skip.
def _apply(path: string, dry_run: bool) {
  var handle = file(path, 'r')
  var source = handle.read()

  handle.close()

  var formatted = engine.format(source)

  if formatted == source {
    return 'unchanged'
  }

  if dry_run {
    return 'would-change'
  }

  var out = file(path, 'w')

  out.write(formatted)
  out.close()

  return 'changed'
}

def main() {
  var parser = args.Parser('format', false)

  parser.description = 'Lay out Zuri source in the project style.'
  parser.add_index(
    'path', 'A .zu file, or a directory to format, subdirectories included'
  )
  parser.add_option(
    'dry-run', 'Show what would change without writing anything',
    { short_name: 'n' },
  )

  var parsed = parser.parse()
  var path = parsed.indexes.is_empty() ? os.cwd() : parsed.indexes[0]
  var dry_run = parsed.options.get('dry-run', false)

  if !os.is_dir(path) and !file(path).exists() {
    echo 'format: no such file or directory: ${path}'

    exit(1)
  }

  var changed = 0
  var unchanged = 0
  var skipped = 0

  for target in _targets(path) {
    catch {
      var outcome = _apply(target, dry_run)

      if outcome == 'unchanged' {
        unchanged += 1
      } else {
        changed += 1

        echo dry_run ? 'would format ${target}' : 'formatted ${target}'
      }
    } as error {
      skipped += 1

      echo 'skipped ${target}: ${error.message}'
    }
  }

  var verb = dry_run ? 'would change' : 'changed'

  echo '${changed} ${verb}, ${unchanged} already formatted, ${skipped} skipped'

  # In dry_run mode a would-be change is a non-zero exit, so a hook fails.
  if dry_run and changed > 0 {
    exit(1)
  }
}

main()
