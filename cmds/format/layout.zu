/**
 * @module format.layout
 *
 * Turns the node tree into physical lines. The line breaks the author
 * wrote are the layout: a collection opened out one item to a line, an
 * expression continued across several, a call whose arguments were
 * spread out, all keep the shape they were given and are only
 * re-indented. A statement that owns a block is always laid out across
 * several lines, its body indented one level deeper, and a line too
 * long for the width that the author left whole is broken at its
 * loosest operator or across the brackets that carry its parts.
 *
 * The one rule that can never bend: the statements inside a block each
 * get their own line. Two statements on one line is not a style
 * preference, it is different source.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import .render { flat, LIMIT, INDENT, VALUE_ENDS }

# Whether a block sits anywhere inside these nodes, however deeply
# nested in brackets.
def _has_block(nodes: list) {
  for node in nodes {
    if node.node == 'group' {
      if node.kind == 'block' or _has_block(node.items) {
        return true
      }
    }
  }

  return false
}

# Whether a group holds nothing that gets printed.
def _is_empty(items: list) {
  for node in items {
    if node.node != 'newline' and node.node != 'blank' {
      return false
    }
  }

  return true
}

def _is_break(node) {
  return node.node == 'newline' or node.node == 'blank'
}

# Whether the author wrote this group across more than one line. Its own
# breaks are the layout, so a group that has any is opened out again
# exactly where it was opened out before.
def _source_broken(group) {
  for node in group.items {
    if _is_break(node) {
      return true
    }
  }

  return false
}

# Whether a group has to be opened out rather than kept on its line: it
# is a block with a body, it holds a comment, the author broke it, or
# any of that is true of a group inside it.
def _must_open(group) {
  if group.kind == 'block' {
    return !_is_empty(group.items) or _source_broken(group)
  }

  return _source_broken(group)
    or _has_comment(group.items)
    or _opens_inside(group.items)
}

# The same question asked of every group directly inside `items`.
def _opens_inside(items: list) {
  for node in items {
    if node.node == 'group' and _must_open(node) {
      return true
    }
  }

  return false
}

# Whether a line break the author wrote, or a comment, sits anywhere in
# this group outside the blocks it holds. Those lines are laid out where
# they were written; a block is laid out by the statement that owns it,
# and its insides are that statement's business rather than this one's.
def _opened_by_author(group) {
  if _source_broken(group) or _has_comment(group.items) {
    return true
  }

  for node in group.items {
    if node.node == 'group'
      and node.kind != 'block'
      and _opened_by_author(node) {
      return true
    }
  }

  return false
}

# The index of the first group the author opened out, or -1.
def _find_authored(items: list) {
  var index = 0

  while index < items.length() {
    var node = items[index]

    if node.node == 'group'
      and node.kind != 'block'
      and _opened_by_author(node) {
      return index
    }

    index += 1
  }

  return -1
}

# The index of the first group that has to be opened out, or -1.
def _find_break(items: list) {
  var index = 0

  while index < items.length() {
    var node = items[index]

    if node.node == 'group' and _must_open(node) {
      return index
    }

    index += 1
  }

  return -1
}

def _raw(kind: string, text: string) {
  return { node: 'raw', kind, text }
}

def _is_comment(node) {
  return node.node == 'tok'
    and (node.atom.kind == 'Comment' or node.atom.kind == 'DocBlock')
}

def _has_comment(items: list) {
  for node in items {
    if _is_comment(node) {
      return true
    }
  }

  return false
}

# Emits a run of nodes as one or more lines, ending a line at every
# comment. A `#` comment runs to the end of its line, so anything after
# it on the same line would be swallowed; a comment is always the last
# thing on its line. `suffix` (a block's ` {`, say) closes the final
# line.
def _emit_with_comments(
  items: list, depth: number, suffix: string, lines: list,
) {
  var indent = INDENT * depth
  var segment = []

  for node in items {
    if _is_break(node) {
      continue
    }

    segment.append(node)

    if _is_comment(node) {
      lines.append(indent + flat(segment))
      segment = []
    }
  }

  var text = flat(segment)

  if text == '' and suffix == '' {
    return
  }

  if text == '' {
    lines.append(indent + suffix.trim(' '))
  } else {
    lines.append(indent + text + suffix)
  }
}

def _last_real(items: list) {
  var index = items.length() - 1

  while index >= 0 {
    var node = items[index]

    if node.node == 'tok' {
      return node.atom
    }

    if node.node == 'group' {
      return node.close
    }

    if node.node == 'raw' {
      return node
    }

    index -= 1
  }

  return nil
}

# The last node of a sequence that gets printed, or nil.
def _last_node(items: list) {
  var index = items.length() - 1

  while index >= 0 {
    if !_is_break(items[index]) {
      return items[index]
    }

    index -= 1
  }

  return nil
}

def _next_real(nodes: list, from: number) {
  var index = from

  while index < nodes.length() {
    var node = nodes[index]

    if node.node == 'tok' {
      return node.atom
    }

    if node.node == 'group' {
      return node.open
    }

    index += 1
  }

  return nil
}

# The statement keywords that may own a body without bracing it.
var _HEADERS = [
  'If', 'Else', 'While', 'For', 'Iter', 'Do', 'Using', 'When', 'Default',
  'Catch',
]

# Whether the last thing on this line is a block's `}` rather than a
# dictionary's.
def _ends_block(items: list) {
  var index = items.length() - 1

  while index >= 0 {
    var node = items[index]

    if node.node == 'group' {
      return node.kind == 'block'
    }

    if node.node == 'tok' or node.node == 'raw' {
      return false
    }

    index -= 1
  }

  return false
}

# Where a statement started in the source, or -1 when it holds nothing
# that came from one.
def _column(items: list) {
  for node in items {
    if node.node == 'tok' {
      return node.atom.column
    }

    if node.node == 'group' {
      return node.open.column
    }
  }

  return -1
}

# Whether a statement is a header waiting for a body it never braced:
# `if x`, `else`, `for a in b`. A header that already carries its body,
# braced (`if x { ... }`) or not (`if x y = 1`), is not one of these.
#
# The braced case is the block group. The unbraced case is the author's
# indentation, which is the only thing in the stream that distinguishes
# `if x` from a complete `if x y = 1`: a body written on the next line
# is indented past its header, and an `else` or the statement after is
# not.
def _is_header(items: list) {
  var first = _next_real(items, 0)

  if first == nil or !_HEADERS.contains(first.kind) {
    return false
  }

  for node in items {
    if node.node == 'group' and node.kind == 'block' {
      return false
    }
  }

  return true
}

# Splits a block body or the top level into statements, honouring line
# continuations (a line ending on an operator or comma, or the next one
# starting on one, is the same statement). The break that joined two
# lines is kept in the statement, since where the author broke it is
# where it is laid out again. Each result is `{ items, blank_before }`.
def split_statements(
  nodes: list, continues_after: list, continues_before: list,
) {
  var statements = []
  var current = []
  var blank = false

  var index = 0

  while index < nodes.length() {
    var node = nodes[index]

    if node.node == 'blank' {
      if !current.is_empty() {
        statements.append({ items: current, blank_before: blank })
        current = []
        blank = false
      }

      blank = true
      index += 1

      continue
    }

    if node.node == 'newline' {
      if current.is_empty() {
        index += 1

        continue
      }

      var last = _last_real(current)
      var next = _next_real(nodes, index + 1)

      var joins = last != nil and continues_after.contains(last.kind)
      var keep = joins

      # A line ending on a comma the caller does not read as a
      # continuation is a complete one. Inside a bracket group that is
      # every comma, and what follows opens the next item however it
      # starts: `-1` after `0.0,` is an item, not a subtraction.
      var closed = !joins and last != nil and last.kind == 'Comma'

      if !joins
        and !closed
        and next != nil
        and continues_before.contains(next.kind) {
        # `else` pulls up onto the line that closed the block before it,
        # `} else {`. It may not pull up onto anything else: a header
        # that took its body unbraced ends its statement at the newline,
        # and `if c x else y` on one line is not a statement Zuri reads.
        joins = next.kind != 'Else' or _ends_block(current)

        # That pull-up is the one join that loses its break. Every other
        # one is the author's own line, and it is laid out again where
        # they put it.
        keep = joins and next.kind != 'Else'
      }

      if joins {
        if keep {
          current.append(node)
        }

        index += 1

        continue
      }

      statements.append({ items: current, blank_before: blank })
      current = []
      blank = false
      index += 1

      continue
    }

    current.append(node)
    index += 1
  }

  if !current.is_empty() {
    statements.append({ items: current, blank_before: blank })
  }

  return statements
}

# Splits nodes at the breaks the author put directly in them, keeping a
# blank line that separated two. Anything inside a bracket group stays
# there; only the breaks at this level count. Each result is
# `{ items, blank_before }`.
def _source_lines(items: list) {
  var segments = []
  var current = []
  var blank = false

  for node in items {
    if _is_break(node) {
      if !current.is_empty() {
        segments.append({ items: current, blank_before: blank })
        current = []
        blank = false
      }

      if node.node == 'blank' {
        blank = true
      }

      continue
    }

    current.append(node)
  }

  if !current.is_empty() {
    segments.append({ items: current, blank_before: blank })
  }

  return segments
}

/**
 * Emits a block body or the top level: every statement, in order, with
 * a blank line kept where the source had one.
 */
def emit_seq(nodes: list, depth: number, lines: list, ctx: dict) {
  var statements = split_statements(nodes, ctx.after, ctx.before)

  # How far past `depth` each statement sits. Everything is level with
  # its neighbours except the body of a header that never braced one,
  # which keeps the indent that is the only sign it is a body at all.
  var offsets = _body_offsets(statements)
  var index = 0

  for statement in statements {
    # A blank opening a block is kept too: the space under a `class` or
    # a `def` before its first member is the author's, not an accident
    # of where the brace fell.
    if statement.blank_before {
      lines.append('')
    }

    emit_statement(statement.items, depth + offsets[index], lines, ctx)
    index += 1
  }
}

# One offset per statement: `0`, or one deeper for each unbraced header
# stacked above it. A header only owns the statement that follows it,
# and only while that statement is indented past it, which is how
# `if x` followed by its body is told from `if x y = 1` followed by an
# `else`.
def _body_offsets(statements: list) {
  var offsets = []
  var open_headers = []
  var index = 0

  while index < statements.length() {
    var column = _column(statements[index].items)

    while !open_headers.is_empty() and column <= open_headers.last() {
      open_headers.pop()
    }

    offsets.append(open_headers.length())

    if _is_header(statements[index].items) {
      open_headers.append(column)
    }

    index += 1
  }

  return offsets
}

/**
 * Emits one statement, opening out any block it owns.
 *
 * `continued` says these nodes carry on a line above them rather than
 * starting one of their own, which is what holds every continuation of
 * one statement at a single level under its first line however many
 * breaks it takes to lay out.
 */
def emit_statement(
  items: list, depth: number, lines: list, ctx: dict, continued: ?bool,
) {
  var on = continued == true
  var at = _find_break(items)

  if at < 0 {
    _emit_line(items, depth, '', lines, ctx, on)

    return
  }

  var breaker = items[at]
  var head = items[0, at]
  var tail = items[at + 1, items.length()]

  if breaker.kind == 'block' {
    _emit_line(head, depth, _brace_suffix(head), lines, ctx, on)

    emit_seq(breaker.items, depth + 1, lines, ctx)

    emit_statement([_raw('Rbrace', '}')] + tail, depth, lines, ctx)

    return
  }

  # A closure handed to a call on one line, `each(items, @{ work() })`,
  # opens at the block and nowhere else. A group the author had already
  # opened out is laid out on its own lines instead, so the block on one
  # of them is opened by the statement that owns that line.
  if !_opened_by_author(breaker) and _has_block(breaker.items) {
    _emit_group_block(head, breaker, tail, depth, lines, ctx, on)

    return
  }

  _emit_group_broken(head, breaker, tail, depth, lines, ctx, on)
}

# Whether the author put a break directly after the opener, which is
# what says whether anything shares the opener's line.
def _breaks_after_open(items: list) {
  return !items.is_empty() and _is_break(items[0])
}

# The same for the closer.
def _breaks_before_close(items: list) {
  var last = items.length() - 1

  return last >= 0 and _is_break(items[last])
}

# A bracket group the author opened out, or one holding a comment. Every
# line they wrote inside it is emitted in turn, one level deeper, and
# the opener and closer keep the company they were given: content left
# on the opener's line stays on it, and a closer written against the
# last item stays against it.
def _emit_group_broken(
  head: list, group, tail: list, depth: number, lines: list, ctx: dict,
  continued: bool,
) {
  # A group broken only somewhere inside it keeps its own opener on the
  # head line. The break belongs to the bracket the author actually
  # opened, and every opener above it reads as part of reaching it.
  while !_source_broken(group) and !_has_comment(group.items) {
    var inner = _find_authored(group.items)

    if inner < 0 {
      break
    }

    var wrapper = _openers(group.kind)
    var child = group.items[inner]

    head = head + [_raw(group.open.kind, wrapper.open)] + group.items[0, inner]
    tail = group.items[inner + 1, group.items.length()]
      + [_raw(group.close.kind, wrapper.close)]
      + tail
    group = child
  }

  var opener = _openers(group.kind)
  var closer = [_raw(group.close.kind, opener.close)] + tail

  # Inside a bracket group a comma separates one item from the next
  # rather than continuing a line; every other continuation still holds,
  # so an item broken across lines stays one item.
  var joins = ctx.after.filter(@(kind) => kind != 'Comma')
  var segments = split_statements(group.items, joins, ctx.before)
  var line = head + [_raw(group.open.kind, opener.open)]
  var first = 0

  if !segments.is_empty() and !_breaks_after_open(group.items) {
    line = line + segments[0].items
    first = 1
  }

  var last = segments.length() - 1

  if first > last {
    emit_statement(line + closer, depth, lines, ctx, continued)

    return
  }

  emit_statement(line, depth, lines, ctx, continued)

  # The body indents under the line the opener actually landed on, which
  # is one deeper than the statement when the head was itself written
  # across lines. Measuring it from the statement instead would drift a
  # level every time the file went through again.
  var opened = _source_lines(head).length() > 1 ? depth + 1 : depth
  var joins_closer = !_breaks_before_close(group.items)
  var index = first

  for segment in segments[first,] {
    if segment.blank_before {
      lines.append('')
    }

    var body = index == last and joins_closer
      ? segment.items + closer
      : segment.items

    emit_statement(body, opened + 1, lines, ctx)
    index += 1
  }

  if !joins_closer {
    # The closer sits on a continuation line exactly when the opener
    # did, so a tail that breaks again stays level with it.
    emit_statement(closer, opened, lines, ctx, opened > depth or continued)
  }
}

# A bracket group with a block inside it, most often a closure handed to
# a call: the opener and everything before the block stay on the line,
# the body indents, and the closer rejoins whatever follows.
def _emit_group_block(
  head: list, group, tail: list, depth: number, lines: list, ctx: dict,
  continued: bool,
) {
  var inner_at = _find_break(group.items)

  # Descend to the group that actually holds the block. Each opener on
  # the way stays on the head line, so `outer(inner(@{ ... }))` opens at
  # the closure rather than giving up and flattening it.
  while inner_at >= 0 and group.items[inner_at].kind != 'block' {
    var wrapper = _openers(group.kind)
    var child = group.items[inner_at]

    head = head
      + [_raw(group.open.kind, wrapper.open)]
      + group.items[0, inner_at]
    tail = group.items[inner_at + 1, group.items.length()]
      + [_raw(group.close.kind, wrapper.close)]
      + tail
    group = child
    inner_at = _find_break(group.items)
  }

  if inner_at < 0 {
    lines.append(INDENT * depth + flat(head + [group] + tail))

    return
  }

  var opener = _openers(group.kind)
  var block = group.items[inner_at]
  var pre = group.items[0, inner_at]
  var post = group.items[inner_at + 1, group.items.length()]

  var prefix = head + [_raw(group.open.kind, opener.open)] + pre

  _emit_line(prefix, depth, _brace_suffix(prefix), lines, ctx, continued)

  emit_seq(block.items, depth + 1, lines, ctx)

  var closing = [_raw('Rbrace', '}')]
    + post
    + [_raw(group.close.kind, opener.close)]
    + tail

  emit_statement(closing, depth, lines, ctx, continued)
}

# The ` {` that opens a block on the end of its head line, tightened to
# `{` after a `@` so a no-argument closure stays `@{`, the way it is
# written everywhere else.
def _brace_suffix(head: list) {
  var last = _last_real(head)

  if last != nil and last.kind == 'At' {
    return '{'
  }

  return ' {'
}

def _openers(kind: string) {
  if kind == 'paren' {
    return { open: '(', close: ')' }
  }

  if kind == 'bracket' or kind == 'index' {
    return { open: '[', close: ']' }
  }

  return { open: '{', close: '}' }
}

# A line that continues the one above it opens on the operator joining
# the two. Marked as such, since a bare `+` or `-` at the head of a
# sequence would otherwise render as a sign on what follows it.
def _as_continuation(segment: list) {
  if segment.is_empty() {
    return segment
  }

  var first = segment[0]

  if first.node != 'tok'
    or (first.atom.kind != 'Plus' and first.atom.kind != 'Minus') {
    return segment
  }

  return [_raw('BinaryLead', first.atom.text)] + segment[1,]
}

# Emits one statement's worth of nodes as lines: the ones the author
# wrote, then a comment ending each, and only a line they left whole
# and too long for the width is broken by the formatter. `suffix` (a
# block's ` {`, say) closes the final line.
def _emit_line(
  items: list, depth: number, suffix: string, lines: list, ctx: dict,
  continued: ?bool,
) {
  var on = continued == true
  var segments = _source_lines(items)

  if segments.length() > 1 {
    var previous = nil
    var index = 0

    for segment in segments {
      var last = index == segments.length() - 1
      var body = _ends_value(previous)
        ? _as_continuation(segment.items)
        : segment.items

      _emit_line(
        body, index == 0 or on ? depth : depth + 1, last ? suffix : '', lines,
        ctx, index > 0 or on,
      )

      previous = _last_node(segment.items)
      index += 1
    }

    return
  }

  if _has_comment(items) {
    _emit_with_comments(items, depth, suffix, lines)

    return
  }

  var indent = INDENT * depth
  var text = flat(items)

  if (depth * 2 + text.length() + suffix.length()) <= LIMIT {
    lines.append(indent + (text == '' ? suffix.trim(' ') : text + suffix))

    return
  }

  _wrap(items, depth, suffix, lines, ctx, on)
}

# Whether the node before an operator carries a value, which is what
# tells a binary `-` or `+` from a sign.
def _ends_value(node) {
  if node == nil {
    return false
  }

  if node.node == 'group' {
    return node.kind != 'block'
  }

  if node.node == 'raw' {
    return VALUE_ENDS.contains(node.kind)
  }

  return node.node == 'tok' and VALUE_ENDS.contains(node.atom.kind)
}

# The index of the last node in `items` that gets printed, or -1.
def _last_index(items: list) {
  var index = items.length() - 1

  while index >= 0 and _is_break(items[index]) {
    index -= 1
  }

  return index
}

# Where in `items` a break at one of `kinds` would land: an operator of
# that kind at the top level, not inside a bracket group, with an
# operand on either side of it.
#
# Three kinds need more than their spelling to tell. A `+` or a `-` with
# nothing of value to its left is a sign on what follows it. A `?` opens
# a branch only when a value stands to its left, since `x: ?int` spells
# an optional type with the same character. And the `:` that closes a
# branch is told from the one that introduces a type by whether there is
# a branch open to close.
def _break_points(items: list, kinds: list) {
  var points = []
  var previous = nil
  var branches = 0
  var index = 0

  for node in items {
    if _is_break(node) {
      index += 1

      continue
    }

    var kind = node.node == 'tok' ? node.atom.kind : ''
    var breaks = previous != nil and kinds.contains(kind)

    if kind == 'Question' {
      var opens = _ends_value(previous)

      breaks = breaks and opens

      if opens {
        branches += 1
      }
    } else if kind == 'Colon' {
      breaks = breaks and branches > 0

      if branches > 0 {
        branches -= 1
      }
    } else if kind == 'Plus' or kind == 'Minus' {
      breaks = breaks and _ends_value(previous)
    }

    if breaks {
      points.append(index)
    }

    previous = node
    index += 1
  }

  # An operator whose operand is on the line below ends the line rather
  # than splitting it, and stays with what it follows.
  if !points.is_empty() and points.last() == _last_index(items) {
    points.pop()
  }

  return points
}

# Whether breaking `items` at any of `kinds` would actually split it. An
# operator that only leads the line is not a split point, so a segment
# that already starts with one is left whole rather than handed back to
# the same break forever.
def _splittable(items: list, kinds: list) {
  return !_break_points(items, kinds).is_empty()
}

# The assignment operators a statement may open with, which a chain on the
# right-hand side reads through.
var _ASSIGN = [
  'Equal', 'PlusEq', 'MinusEq', 'MultiplyEq', 'DivideEq', 'PowEq', 'FloorEq',
  'PercentEq', 'LshiftEq', 'RshiftEq', 'UrshiftEq', 'AmpEq', 'BarEq', 'XorEq',
  'TildeEq',
]

# Top-level tokens that mean the line is not a single chain but an
# expression built from one: a comparison, arithmetic, a ternary, a
# lambda arrow, a comma. Any of these and the dots belong to different
# operands, so breaking at them would be wrong.
var _CHAIN_STOP = [
  'Question', 'Colon', 'And', 'Or', 'EqualEq', 'BangEq', 'Less', 'LessEq',
  'Greater', 'GreaterEq', 'Plus', 'Minus', 'Multiply', 'Divide', 'Pow', 'Floor',
  'Percent', 'Amp', 'Bar', 'Xor', 'Lshift', 'Rshift', 'Urshift', 'Comma', 'In',
  'As', 'Arrow', 'Range',
]

# The operators a long line breaks at, loosest binding first, so the
# break lands where the expression holds together least and each line
# reads as one operand of the outermost operation.
var _BREAK_OPS = [
  ['Question', 'Colon'],
  ['Or'],
  ['And'],
  ['EqualEq', 'BangEq', 'Less', 'LessEq', 'Greater', 'GreaterEq'],
  ['Bar'],
  ['Xor'],
  ['Amp'],
  ['Lshift', 'Rshift', 'Urshift'],
  ['Plus', 'Minus'],
  ['Multiply', 'Divide', 'Percent', 'Floor'],
]

# Whether a statement is a single fluent chain, once a leading assignment is
# allowed for, rather than a larger expression that merely contains one. A
# ternary with a `.length()` in each branch is not a chain, and must not
# be broken as if it were.
def _is_chain(items: list) {
  var assigned = false

  for node in items {
    if node.node != 'tok' {
      continue
    }

    var kind = node.atom.kind

    if !assigned and _ASSIGN.contains(kind) {
      assigned = true

      continue
    }

    if _CHAIN_STOP.contains(kind) or _ASSIGN.contains(kind) {
      return false
    }
  }

  return true
}

# How many method-call links a fluent chain has at the top level: a `.`
# followed by a name and its call parentheses, as in `.filter(x)`. Two or
# more is what makes a chain worth breaking one call to a line rather than
# leaving it to run past the width.
def _method_links(items: list) {
  var reals = items.filter(@(n) => n.node == 'tok' or n.node == 'group')
  var count = 0
  var index = 0

  while index + 2 < reals.length() {
    var dot = reals[index]
    var name = reals[index + 1]
    var call = reals[index + 2]

    if dot.node == 'tok'
      and dot.atom.kind == 'Dot'
      and name.node == 'tok'
      and name.atom.kind == 'Identifier'
      and call.node == 'group'
      and call.kind == 'paren' {
      count += 1
    }

    index += 1
  }

  return count
}

# The first real node at or after `from`, and its index, as a pair
# `{ node, at }`, or `{ node: nil, at: -1 }` when there is none.
def _next_node(items: list, from: number) {
  var index = from

  while index < items.length() {
    var node = items[index]

    if !_is_break(node) {
      return { node, at: index }
    }

    index += 1
  }

  return { node: nil, at: -1 }
}

# Whether the `.` at `index` begins a call link, `.name(...)`, rather than
# a plain property access. A call link is where a fluent chain breaks; a
# property access stays with the call that follows it.
def _is_call_link(items: list, index: number) {
  var name = _next_node(items, index + 1)

  if name.node == nil
    or name.node.node != 'tok'
    or name.node.atom.kind != 'Identifier' {
    return false
  }

  var call = _next_node(items, name.at + 1)

  return call.node != nil
    and call.node.node == 'group'
    and call.node.kind == 'paren'
}

# Lays out a list of segments: the first at `depth`, the rest indented one
# level under it, the closing `suffix` on the last. Each segment is
# emitted through {_emit_line}, so one still too long breaks again.
def _emit_segments(
  segments: list, depth: number, suffix: string, lines: list, ctx: dict,
  continued: bool,
) {
  var index = 0

  for segment in segments {
    var last = index == segments.length() - 1
    var deeper = index == 0 or continued ? depth : depth + 1
    var body = index == 0 ? segment : _as_continuation(segment)

    _emit_line(
      body, deeper, last ? suffix : '', lines, ctx, index > 0 or continued,
    )

    index += 1
  }
}

# A long line split at the operators in `kinds`, each operand its own
# segment with the operator leading it, the way a multi-line condition
# reads.
def _operator_segments(items: list, kinds: list) {
  var points = _break_points(items, kinds)
  var segments = []
  var current = []
  var index = 0

  for node in items {
    if _is_break(node) {
      index += 1

      continue
    }

    if points.contains(index) {
      segments.append(current)
      current = []
    }

    current.append(node)
    index += 1
  }

  if !current.is_empty() {
    segments.append(current)
  }

  return segments
}

# Breaks a long fluent chain at each call link, `.name(...)`, one call to a
# line. A property access leading a link, as in `group.items.filter(...)`,
# stays on the head line with what it reads from.
def _emit_chain_break(
  items: list, depth: number, suffix: string, lines: list, ctx: dict,
  continued: bool,
) {
  var segments = []
  var current = []
  var index = 0

  while index < items.length() {
    var node = items[index]

    if _is_break(node) {
      index += 1

      continue
    }

    if node.node == 'tok'
      and node.atom.kind == 'Dot'
      and !current.is_empty()
      and _is_call_link(items, index) {
      segments.append(current)
      current = [node]
    } else {
      current.append(node)
    }

    index += 1
  }

  if !current.is_empty() {
    segments.append(current)
  }

  _emit_segments(segments, depth, suffix, lines, ctx, continued)
}

# Whether a top-level `;` splits this statement into clauses, as an
# `iter` header does. Those clauses are separate expressions, so none of
# the operator breaks below applies to the statement as a whole.
def _has_clauses(items: list) {
  for node in items {
    if node.node == 'tok' and node.atom.kind == 'Semicolon' {
      return true
    }
  }

  return false
}

# The operator breaks open to this statement. A class header spells its
# parent with `<` and its extension target with `>`, and neither is a
# comparison to break across lines.
def _break_ops(items: list) {
  if _has_clauses(items) {
    return []
  }

  var first = _next_real(items, 0)

  if first != nil and first.kind == 'Class' {
    return _BREAK_OPS.filter(@(kinds) => !kinds.contains('Less'))
  }

  return _BREAK_OPS
}

# The loosest operator this statement can be split at, or an empty list
# when it has none.
def _loosest_split(items: list) {
  for kinds in _break_ops(items) {
    if _splittable(items, kinds) {
      return kinds
    }
  }

  return []
}

# Whether a bracket fill has somewhere to go in `items`: a group with
# two or more comma-separated parts, reached through any wrapper that
# holds nothing else to spread out. It is the same descent {_wrap} makes
# and answers whether that descent would arrive anywhere.
def _fillable(items: list) {
  var at = _last_group(items)

  while at >= 0 {
    var group = items[at]

    if _split_commas(group.items).length() >= 2 {
      return true
    }

    items = group.items
    at = _last_group(items)
  }

  return false
}

# Whether every line an operator break would leave can be laid out at
# this width: each either fits, or carries a bracket group of its own to
# spread across further lines. A break that leaves a line still running
# past the width and nothing to do about it has not paid for itself, and
# the line is better left whole.
def _segments_resolve(
  segments: list, depth: number, suffix: string, continued: bool,
) {
  var index = 0

  for segment in segments {
    var last = index == segments.length() - 1
    var deeper = index == 0 or continued ? depth : depth + 1
    var width = deeper * 2
      + flat(segment).length()
      + (last ? suffix.length() : 0)

    if width > LIMIT and !_fillable(segment) {
      return false
    }

    index += 1
  }

  return true
}

# A long line, broken at its loosest operator if a break there resolves
# it, or else across the last bracket group it holds: the opener stays,
# its parts fill the lines below, and the closer lands back at this
# indent. A line with nowhere to break is left as it was written.
def _wrap(
  items: list, depth: number, suffix: string, lines: list, ctx: dict,
  continued: bool,
) {
  var indent = INDENT * depth
  var kinds = _loosest_split(items)

  if !kinds.is_empty() {
    var segments = _operator_segments(items, kinds)

    if _segments_resolve(segments, depth, suffix, continued) {
      _emit_segments(segments, depth, suffix, lines, ctx, continued)

      return
    }
  }

  # A fluent chain of two or more calls breaks a call to a line, each `.`
  # leading its own, rather than filling the last call's arguments and
  # leaving the head still too long.
  if _is_chain(items) and _method_links(items) >= 2 {
    _emit_chain_break(items, depth, suffix, lines, ctx, continued)

    return
  }

  var at = _last_group(items)

  if at < 0 {
    lines.append(indent + flat(items) + suffix)

    return
  }

  var group = items[at]
  var head = items[0, at]
  var tail = items[at + 1, items.length()]

  # Descend while this group has nothing of its own to fill: a call whose
  # one argument is another call, a wrapper around a lone list. Each
  # opener stays on the head line and each closer joins the tail, so the
  # break lands on the innermost bracket that has parts to spread out.
  while _split_commas(group.items).length() < 2 {
    var inner = _last_group(group.items)

    if inner < 0 {
      lines.append(indent + flat(items) + suffix)

      return
    }

    var wrapper = _openers(group.kind)
    var child = group.items[inner]

    head = head + [_raw(group.open.kind, wrapper.open)] + group.items[0, inner]
    tail = group.items[inner + 1, group.items.length()]
      + [_raw(group.close.kind, wrapper.close)]
      + tail
    group = child
  }

  var opener = _openers(group.kind)
  var parts = _split_commas(group.items)

  _emit_line(
    head + [_raw(group.open.kind, opener.open)], depth, '', lines, ctx,
    continued,
  )

  # Fill: pack as many parts onto a line as the width allows, wrapping to
  # the next when the next part would overflow. Every part, the last
  # included, ends in a comma, so a later edit can add or reorder a line
  # without touching its neighbours; Zuri accepts a trailing one anywhere.
  var inner = INDENT * (depth + 1)
  var line = ''

  for part in parts {
    var text = '${flat(part)},'

    # One part too wide for a line of its own is laid out in turn rather
    # than left to run past the width, which is the only thing filling
    # cannot fix by packing differently.
    if (inner.length() + text.length()) > LIMIT {
      if line != '' {
        lines.append(inner + line)
        line = ''
      }

      _emit_line(part, depth + 1, ',', lines, ctx)

      continue
    }

    if line == '' {
      line = text
    } else if (inner.length() + line.length() + 1 + text.length()) <= LIMIT {
      line += ' ${text}'
    } else {
      lines.append(inner + line)
      line = text
    }
  }

  if line != '' {
    lines.append(inner + line)
  }

  _emit_line(
    [_raw(group.close.kind, opener.close)] + tail, depth, suffix, lines, ctx,
    continued,
  )
}

def _last_group(items: list) {
  var index = items.length() - 1

  while index >= 0 {
    var node = items[index]

    # A subscript is never a place to break: filling its parts across
    # lines would put a comma after the last one, and in a subscript
    # that comma is the difference between an item and a slice.
    if node.node == 'group'
      and node.kind != 'block'
      and node.kind != 'index'
      and !node.items.is_empty() {
      return index
    }

    index -= 1
  }

  return -1
}

# The comma-separated parts of a group's contents, each a node list.
def _split_commas(items: list) {
  var parts = []
  var current = []

  for node in items {
    if _is_break(node) {
      continue
    }

    if node.node == 'tok' and node.atom.kind == 'Comma' {
      parts.append(current)
      current = []

      continue
    }

    current.append(node)
  }

  if !current.is_empty() {
    parts.append(current)
  }

  return parts
}
