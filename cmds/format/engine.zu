/**
 * @module format.engine
 *
 * The engine the `format` command runs. `format` takes a source string
 * and returns the same program laid out in the project's style: two
 * spaces to a level, one statement to a line, spacing the way a reader
 * expects it, and long lines broken across the brackets that carry them.
 *
 * It never changes what a program does. Before returning, it checks the
 * result twice: that it holds the same tokens as the input, and that
 * the parser still reads it. A `FormatError` is raised rather than
 * handing back a program that reads differently, so the command can
 * leave that file as it was.
 *
 * The two checks answer different questions. Tokens catch a character
 * gained or lost; parsing catches a line break moved somewhere a break
 * is what ends a statement, which no comparison of tokens can see.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import zuri

import .atoms
import .tree
import .render { CONTINUES_AFTER, CONTINUES_BEFORE }
import .layout

/**
 * Raised when formatting a source would have changed the tokens it
 * holds. It means a bug in the formatter, never a fault in the source,
 * and the source should be left as it was.
 */
class FormatError < Error {
}

# The closers a trailing comma can sit before.
var _CLOSERS = ['Rparen', 'Rbracket', 'Rbrace']

# The tokens that carry meaning, for the safety check: the atom stream
# without the whitespace markers, and without a comma right before a
# closer, since keeping or dropping a trailing comma is the formatter's
# own call and never changes the program.
#
# A subscript is the exception. `s[1]` and `s[1,]` are an item and a
# slice, so the comma before that `]` is part of the program and has to
# count. `_closings()` is what says which `]` is which.
def _signature(source: string) {
  var kept = []
  var closings = _closings(source, kept)

  var out = []
  var index = 0

  while index < kept.length() {
    var atom = kept[index]
    var next = index + 1 < kept.length() ? kept[index + 1] : nil
    var trailing = atom.kind == 'Comma'
      and next != nil
      and _CLOSERS.contains(next.kind)
      and !closings[index + 1]

    # `name: name` and its shorthand `name` are the same to the check:
    # collapse the pair so the rewrite reads as no change.
    var second = index + 2 < kept.length() ? kept[index + 2] : nil

    if atom.kind == 'Identifier'
      and next != nil
      and next.kind == 'Colon'
      and second != nil
      and second.kind == 'Identifier'
      and second.text == atom.text {
      out.append('Identifier ${atom.text}')
      index += 3

      continue
    }

    if !trailing {
      out.append('${atom.kind} ${atom.text}')
    }

    index += 1
  }

  return out
}

# Fills `kept` with the atoms that carry meaning and returns a list
# alongside it, true at every `]` that closes a subscript rather than a
# list literal.
#
# The decision is `tree.opens_subscript()`, the one the parser makes,
# reading the atom before the `[` on its own line. Both layers have to
# answer the same way or a source and its formatting would compare as
# different programs when they are not.
def _closings(source: string, kept: list) {
  var closings = []
  var opened = []
  var previous = nil

  for atom in atoms.stream(source) {
    if atom.kind == 'Newline' or atom.kind == 'Blank' {
      previous = nil

      continue
    }

    var closes_subscript = false

    if atom.kind == 'Lbracket' {
      opened.append(tree.opens_subscript(previous))
    } else if atom.kind == 'Rbracket' and !opened.is_empty() {
      closes_subscript = opened.pop()
    }

    kept.append(atom)
    closings.append(closes_subscript)
    previous = atom
  }

  return closings
}

def _same(left: list, right: list) {
  if left.length() != right.length() {
    return false
  }

  var index = 0

  while index < left.length() {
    if left[index] != right[index] {
      return false
    }

    index += 1
  }

  return true
}

/**
 * Formats `source`, returning the laid-out program with a single
 * trailing newline.
 *
 * @param string source
 * @returns string
 * @throws FormatError if the result would not hold the same tokens as
 *    the input, or would not parse.
 */
def format(source: string) {
  var stream = atoms.stream(source)
  var nodes = tree.parse(stream)
  var ctx = { after: CONTINUES_AFTER, before: CONTINUES_BEFORE }
  var lines = []

  layout.emit_seq(nodes, 0, lines, ctx)

  var result = '\n'.join(lines)

  if result != '' {
    result += '\n'
  }

  if !_same(_signature(source), _signature(result)) {
    raise FormatError('formatting would have changed the tokens of the source')
  }

  if !_parses(result) {
    raise FormatError('formatting would have produced source that does not parse')
  }

  return result
}

# Whether the parser reads `source` at all. A newline is what ends a
# statement in Zuri, so a layout that moves one can turn a program into
# something the parser refuses even with every token still in place, and
# the token check above is blind to exactly that.
def _parses(source: string) {
  catch {
    zuri.parse(source)
  } as error {
    return false
  }

  return true
}

/**
 * Reads `path`, formats it, and returns the result. Does not write
 * anything back.
 *
 * @param string path
 * @returns string
 */
def format_file(path: string) {
  var handle = file(path, 'r')
  var source = handle.read()

  handle.close()

  return format(source)
}
