/**
 * @command publish
 * @description Publishes a project to a package registry.
 *
 *   zuri publish [options]
 *
 * The project is packed the way every package is packed, so the same
 * files always make the same archive, and uploaded with the token
 * `zuri account login` saved for the registry. A published version
 * never changes. The dry-run option shows exactly what would be sent
 * and sends nothing.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import os

import .._shared.archive
import .._shared.cli
import .._shared.errors { run }
import .._shared.fsx
import .._shared.paths
import .._shared.registry { RegistryError }
import .._shared.ui

import .plan

def main() {
  var parsed = plan.parser().parse()
  var project = cli.require_project('publish')
  var dry_run = parsed.options.get('dry-run', false) == true
  var as_json = parsed.options.get('json', false) == true
  var quiet = parsed.options.get('quiet', false) == true

  var prepared = plan.prepare(project.root, {
    allow_dirty: parsed.options.get('allow-dirty', false) == true,
  })

  for warning in prepared.warnings {
    ui.complain(ui.warn('warning: ${warning}'))
  }

  var documented = plan.coverage(project.root, prepared)

  var staging = os.join_paths(paths.cache_dir(), 'publish')
  var packed_path = os.join_paths(staging, '${fsx.unique()}.tar.gz')

  fsx.ensure_dir(staging)

  catch {
    var packed = archive.pack(project.root, prepared.files, packed_path)

    if dry_run {
      _show(prepared, packed, project.root, as_json, documented)
      fsx.remove(packed_path)

      return
    }

    var registry = cli.registry_from(parsed)

    if !as_json and !quiet {
      _say_coverage(documented)
      echo 'Publishing ${ui.accent(prepared.name)} ${prepared.version} to ${registry.address}'
    }

    var published = nil
    var already = false

    catch {
      published = registry.publish(packed_path, {
        name: prepared.name,
        version: prepared.version,
        checksum: packed.checksum,
      })
    } as error {
      # An upload that timed out may still have arrived. The registry
      # holding exactly this archive under this version means it did.
      var same = instance_of(error, RegistryError) and
          error.code == 'version_exists' and
          error.details != nil and
          error.details.get('checksum', nil) == packed.checksum

      if !same {
        raise error
      }

      published = {
        name: prepared.name,
        version: prepared.version,
        checksum: packed.checksum,
      }
      already = true
    }

    fsx.remove(packed_path)

    if as_json {
      published.set('already_published', already)
      cli.print_json(published)
    } else if quiet {
      return
    } else if already {
      echo '${ui.accent(published.name)} ${published.version} is already published with exactly ' +
          'these files.'
    } else {
      echo 'Published ${ui.accent(published.name)} ${published.version} ' +
          ui.muted('(${ui.size(packed.size)}, ${packed.checksum})')
    }
  } as error {
    fsx.remove(packed_path)

    raise error
  }
}

# How much of the package has a doc block, as the registry counts it for
# the version's page, and the first few names that have none. Nothing is
# said for a package with no public names.
def _say_coverage(found) {
  if found == nil or found.names == 0 {
    return
  }

  var percent = found.documented * 100 // found.names

  echo 'Documented: ${found.documented} of ${ui.count(found.names, "public name")} (${percent}%)'

  if !found.missing.is_empty() {
    var shown = found.missing[0, found.missing.length().min(5)]
    var more = found.missing.length() - shown.length()

    echo ui.muted(
      '  without a doc block: ${", ".join(shown)}' +
          (more > 0 ? ', and ${more} more' : ''),
    )
  }
}

# The dry run: every file, its size, and what the archive came to.
def _show(
  prepared: dict,
  packed: dict,
  root: string,
  as_json: bool,
  documented,
) {
  var rows = []
  var listed = []

  for path in prepared.files {
    var size = file(os.join_paths(root, path)).stats().size

    rows.append([ui.muted(ui.size(size)), path])
    listed.append({ path, size })
  }

  if as_json {
    cli.print_json({
      name: prepared.name,
      version: prepared.version,
      files: listed,
      size: packed.size,
      unpacked_size: packed.unpacked_size,
      checksum: packed.checksum,
      documented,
    })

    return
  }

  echo '${ui.heading("Would publish")} ${ui.accent(prepared.name)} ${prepared.version}'
  echo ''
  ui.say(ui.table(rows))
  echo ''
  echo '${ui.count(prepared.files.length(), "file")}, ${ui.size(packed.unpacked_size)} ' +
      'unpacked, ${ui.size(packed.size)} packed'
  echo ui.muted(packed.checksum)
  _say_coverage(documented)
}

run('publish', main)
