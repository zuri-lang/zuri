# Checking a package before it is published: what counts as changed
# and not committed, for a project anywhere inside a git work tree.

import os
import os.process { spawn }
import test { * }

import ..plan

var ROOT = os.create_temp_dir('zuri-publish-')
var REPO = os.join_paths(ROOT, 'monorepo')
var PROJECT = os.join_paths(REPO, 'packages', 'kit')

# Runs git in `dir` with an identity of its own.
def git_in(dir: string, words: list) {
  var child = spawn('git', words, {
    cwd: dir,
    stdin: 'null',
    stdout: 'pipe',
    stderr: 'pipe',
    env: {
      GIT_AUTHOR_NAME: 'Test', GIT_AUTHOR_EMAIL: 'test@example.test',
      GIT_COMMITTER_NAME: 'Test', GIT_COMMITTER_EMAIL: 'test@example.test',
    },
  })

  var status = child.wait()

  if status != 0 {
    raise Error('git ${words[0]} failed: ${child.read_stderr().to_string()}')
  }
}

def put(path: string, text: string) {
  if !os.dir_exists(os.dir_name(path)) {
    os.create_dir(os.dir_name(path), 0c755, true)
  }

  file(path, 'w').write(text)
}

# Why `prepare()` refused the project, or `nil` when it did not.
def refusal(options: ?dict) {
  catch {
    plan.prepare(PROJECT, options)
  } as error {
    return error.message
  }

  return nil
}

before_all(@{
  put(os.join_paths(PROJECT, 'project.toml'),
    '[project]\nname = "kit"\nversion = "1.0.0"\ndescription = "Tools"\nlicense = "MIT"\n')
  put(os.join_paths(PROJECT, 'README.md'), '# kit\n')
  put(os.join_paths(PROJECT, 'index.zu'), 'echo "kit"\n')
  put(os.join_paths(PROJECT, 'lib', 'old name.zu'), 'var OLD = 1\n')
  put(os.join_paths(REPO, 'notes.txt'), 'elsewhere\n')

  git_in(REPO, ['init', '-q'])
  git_in(REPO, ['add', '-A'])
  git_in(REPO, ['commit', '-q', '-m', 'start'])
})

after_each(@{
  git_in(REPO, ['reset', '-q', '--hard'])
  git_in(REPO, ['clean', '-q', '-fd'])
})

after_all(@{
  os.remove_dir(ROOT, true)
})

describe('uncommitted changes', @{
  it('publishes a project git has nothing new for', @{
    expect(refusal()).to_be_nil()
  })

  it('names changed and new files from the project root', @{
    put(os.join_paths(PROJECT, 'index.zu'), 'echo "changed"\n')
    put(os.join_paths(PROJECT, 'lib', 'new.zu'), 'var NEW = 1\n')

    var said = refusal()

    expect(said).to_contain('index.zu')
    expect(said).to_contain('lib/new.zu')
    expect(said).not.to_contain('packages/kit')
  })

  it('names a renamed file by its new name, spaces and all', @{
    git_in(PROJECT, ['mv', 'lib/old name.zu', 'lib/new name.zu'])

    var said = refusal()

    expect(said).to_contain('lib/new name.zu')
    expect(said).not.to_contain('old name')
  })

  it('ignores changes outside the project', @{
    put(os.join_paths(REPO, 'notes.txt'), 'changed elsewhere\n')

    expect(refusal()).to_be_nil()
  })

  it('publishes anyway when told to', @{
    put(os.join_paths(PROJECT, 'index.zu'), 'echo "changed"\n')

    expect(refusal({ allow_dirty: true })).to_be_nil()
  })
})
