/**
 * Colouring Zuri code on a page.
 *
 * The code is split into tokens by Zuri's own lexer, so what is
 * coloured as a keyword is exactly what the language reads as one.
 * Everything is escaped as it is written, and a class names each kind
 * of token; the stylesheet decides the colours.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import html
import zuri

var _CLASSES = {
  Literal: 'str',
  Interpolation: 'str',
  Integer: 'num',
  Double: 'num',
  BigNumber: 'num',
  Comment: 'com',
  DocBlock: 'com',
  Identifier: 'id',
  Decorator: 'dec',
}

# The class for one token, or `nil` for punctuation.
def _class_of(token) {
  var known = _CLASSES.get(token.kind, nil)

  if known != nil {
    return known
  }

  if is_dict(token.text.match('/^[a-z_]+$/')) {
    return 'kw'
  }

  return nil
}

# `source` as `{ text, kind }` pieces, `kind` being the class a piece is
# coloured with or `nil`, or `nil` when it does not lex.
def _pieces(source: string) {
  var tokens

  catch {
    tokens = zuri.tokenize(source)
  } as error {
    return nil
  }

  var pieces = []
  var at = 0

  for token in tokens {
    if token.kind == 'Error' {
      return nil
    }

    if token.kind == 'Eof' {
      break
    }

    # Whatever the lexer skipped between tokens, spaces mostly.
    if token.start > at {
      pieces.append({ text: source[at, token.start], kind: nil })
    }

    pieces.append({
      text: source[token.start, token.end],
      kind: _class_of(token),
    })
    at = token.end
  }

  if at < source.length() {
    pieces.append({ text: source[at,], kind: nil })
  }

  return pieces
}

# One piece of text as markup, in a span when it is coloured.
def _markup(text: string, kind) {
  var escaped = html.escape_text(text)

  return kind == nil or text.is_empty()
      ? escaped
      : '<span class="${kind}">${escaped}</span>'
}

/**
 * `source` as highlighted markup, or `nil` when it does not lex, in
 * which case the caller shows it plain.
 *
 * @param string source
 * @returns ?string
 */
def zuri_code(source: string) {
  var pieces = _pieces(source)

  if pieces == nil {
    return nil
  }

  return ''.join(pieces.map(@(piece) => _markup(piece.text, piece.kind)))
}

/**
 * `source` as highlighted markup one line at a time, so each line can
 * be numbered, or `nil` when it does not lex. A token that runs over
 * several lines, such as a string or a comment, is coloured on each.
 *
 * @param string source
 * @returns ?list[string]
 */
def zuri_lines(source: string) {
  var pieces = _pieces(source)

  if pieces == nil {
    return nil
  }

  var lines = []
  var current = ''

  for piece in pieces {
    var parts = piece.text.split('\n')

    iter var i = 0; i < parts.length(); i++ {
      if i > 0 {
        lines.append(current)
        current = ''
      }

      current += _markup(parts[i], piece.kind)
    }
  }

  lines.append(current)

  return lines
}
