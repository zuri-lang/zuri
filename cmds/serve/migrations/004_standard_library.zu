    table.string('runtime', 96).exact()
    table.string('path', 255).exact()
    table.string('page', 255)
    table.string('anchor', 255)
    table.primary(['runtime', 'path'])
  })

  db.schema.create_table('std_symbols', @(table: Blueprint) {
    table.id()
