# Tests for turning a README into a page: the Markdown GitHub reads,
# Zuri coloured by its lexer, and nothing a README could use against
# the page it is shown on.

import test { * }

import ..markup { render }

describe('render', @{
  it('reads the Markdown GitHub reads', @{
    var page = render(
      '# Weather\n\nSome *rain* and ~~sun~~.\n\n| a | b |\n| --- | --- |\n| 1 | 2 |\n',
    )

    expect(page).to_contain('<h1>Weather</h1>')
    expect(page).to_contain('<em>rain</em>')
    expect(page).to_contain('<del>sun</del>')
    expect(page).to_contain('<td>1</td>')
  })

  it('colours Zuri, whatever follows the language in the fence', @{
    expect(
      render('```zuri\necho \'hi\'\n```\n'),
    ).to_contain('<span class="kw">echo</span> <span class="str">\'hi\'</span>')
    expect(render('```zuri,ignore\nvar x = 1\n```\n'))
        .to_contain('<span class="kw">var</span>')
  })

  it('writes any other language plain', @{
    expect(render('```sh\necho <hi>\n```\n')).to_contain('echo &lt;hi&gt;')
  })

  it('keeps a task list item as written', @{
    expect(render('- [x] done\n')).to_contain('<li>[x] done</li>')
  })

  it('makes addresses into links that lend the site nothing', @{
    expect(render('See https://example.com.')).to_contain(
      '<a href="https://example.com" rel="nofollow ugc noopener">https://example.com</a>',
    )
  })

  it('keeps a relative link as it is', @{
    expect(render('[the guide](docs/guide.md)'))
        .to_contain('<a href="docs/guide.md">the guide</a>')
  })

  it('removes scripts, frames and handlers from raw HTML', @{
    var page = render(
      '<script>alert(1)</script>\n\n<iframe src="https://example.com"></iframe>\n\n<p onclick="steal()">Hello</p>\n\n<img src="a.png" onerror="steal()">\n',
    )

    expect(page).not.to_contain('script')
    expect(page).not.to_contain('alert')
    expect(page).not.to_contain('iframe')
    expect(page).not.to_contain('steal')
    expect(page).to_contain('<p>Hello</p>')
    expect(page).to_contain('<img src="a.png">')
  })

  it('gives a script address nowhere to go', @{
    var page = render('[click](javascript:alert(1))')

    expect(page).to_contain('click')
    expect(page).not.to_contain('javascript')
  })
})
