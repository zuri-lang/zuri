# The API reference a repository writes for every version it is sent:
# generated when the version is published, from the doc blocks in its
# own archive, and shown on the package's page.

import http
import os
import test { * }

import ._harness { World, commit, write }
import ..db { Database }

var world = World('documentation')
var KIT = nil

# A package whose root lifts everything in `app`, and exposes `radar`
# as a namespace.
var APP = '/**
 * @module app
 *
 * Forecasts for anywhere.
 */

/**
 * The forecast for _place_, as a {Report}.
 *
 * @param string place: where to look.
 * @returns Report
 */
def forecast(place: string) {
  return Report(place)
}

/**
 * One forecast. {forecast()} makes them.
 */
class Report {

  /** Where it is for. @type string */
  var place

  @new(place: string) {
    self.place = place
  }

  /**
   * It, said aloud.
   *
   * @returns string
   */
  say() {
    return \'Rain in \' + self.place
  }
}

def undocumented() {}
'

var RADAR = '/**
 * @module radar
 *
 * What the radar sees.
 */

/** The latest sweep. */
def sweep() {}
'

def page(path: string) {
  return http.get(world.url + path).as_text()
}

before_all(@{
  world.start()
  world.account('ada', world.dir('signin'))

  KIT = world.project('weather-kit')

  write(
    KIT,
    'index.zu',
    '/**\n * Weather, as a package.\n */\n\nimport @.app { * }\nimport @.radar\n',
  )
  write(KIT, 'app/index.zu', APP)
  write(KIT, 'radar.zu', RADAR)
  write(KIT, 'notes/rain & sun.txt', 'Mostly sun.\n')
  commit(KIT)

  var published = world.zuri(['publish', '--registry', world.url], KIT)

  if published.status != 0 {
    raise Error('publishing failed: ${published.all}')
  }
})

after_all(@{
  world.finish()
})

# The repository's own database, for looking behind the site.
def database() {
  return Database('sqlite://' + os.join_paths(world.root, 'nyssa', 'nyssa.db'))
}

describe('the API tab', @{
  it('is written when the version is published', @{
    var db = database()
    var rows = db.connection.fetch_all('select * from version_docs', {})
    var pages = db.connection.fetch_value(
      'select count(*) from doc_pages',
      {},
      0,
    )

    db.close()

    expect(rows.length()).to_be(1)
    expect(pages).to_be(3)
  })

  it('lists every module of the version', @{
    var shown = page('/packages/weather-kit?tab=api')

    expect(shown).to_contain('aria-current="page">API</a>')
    expect(shown).to_contain('>weather_kit</a>')
    expect(shown).to_contain('>weather_kit.app</a>')
    expect(shown).to_contain('>weather_kit.radar</a>')
  })

  it("opens on the package's own page, listing its whole surface", @{
    var shown = page('/packages/weather-kit?tab=api')

    expect(shown).to_contain('Weather, as a package.')
    expect(shown).to_contain(
      'href="/packages/weather-kit?tab=api&amp;module=weather_kit-app#user-content-forecast"',
    )
  })

  it('shows the page of the module asked for', @{
    var shown = page('/packages/weather-kit?tab=api&module=weather_kit-app')

    expect(shown).to_contain('id="user-content-forecast"')
    expect(shown)
        .to_contain('weather_kit</span>.<span class="id">forecast</span>')
    expect(shown).to_contain('id="user-content-reportsay"')
  })

  it('links a name written in braces to where it is documented', @{
    var shown = page('/packages/weather-kit?tab=api&module=weather_kit-app')

    expect(shown)
        .to_contain('<a href="#user-content-report"><code>Report</code></a>')
    expect(
      shown,
    ).to_contain('<a href="#user-content-forecast"><code>forecast()</code></a>')
  })

  it('shows the first module for one it does not have', @{
    expect(page('/packages/weather-kit?tab=api&module=nothing'))
        .to_contain('Weather, as a package.')
  })

  it('is there for a version asked for by number', @{
    expect(page('/packages/weather-kit/0.1.0?tab=api&module=weather_kit-radar'))
        .to_contain('The latest sweep.')
  })

  it('is written again when an older generator wrote it', @{
    var db = database()

    db.connection.update('version_docs', { generator: 0 }, {})
    db.connection.delete('doc_pages', {})
    db.close()

    expect(page('/packages/weather-kit?tab=api&module=weather_kit-radar'))
        .to_contain('The latest sweep.')
  })
})

# The line of _text_ that holds _wanted_, counting from one.
def line_of(text: string, wanted: string) {
  var lines = text.split('\n')

  iter var i = 0; i < lines.length(); i++ {
    if lines[i].contains(wanted) {
      return i + 1
    }
  }

  return -1
}

describe('the Source tab', @{
  it('lists every file of the version', @{
    var shown = page('/packages/weather-kit?tab=source')

    expect(shown).to_contain('aria-current="page">Source</a>')
    expect(shown)
        .to_contain('?tab=source&amp;file=app%2Findex.zu">app/index.zu</a>')
    expect(shown).to_contain('>project.toml</a>')
    expect(shown).to_contain('>radar.zu</a>')
  })

  it('shows a file a line at a time, numbered, with Zuri coloured', @{
    var shown = page('/packages/weather-kit?tab=source&file=app/index.zu')
    var line = line_of(APP, 'def forecast(')

    expect(shown).to_contain('<tr id="L${line}">')
    expect(shown).to_contain('<a href="#L${line}">${line}</a>')
    expect(
      shown,
    ).to_contain('<span class="kw">def</span> <span class="id">forecast</span>')
  })

  it('shows any other text as it is', @{
    expect(page('/packages/weather-kit?tab=source&file=project.toml'))
        .to_contain('name = "weather-kit"')
  })

  it('reaches a file whose name would end a query value', @{
    var listed = page('/packages/weather-kit?tab=source')

    expect(listed).to_contain('?tab=source&amp;file=notes%2Frain+%26+sun.txt"')
    expect(
      page('/packages/weather-kit?tab=source&file=notes%2Frain+%26+sun.txt'),
    ).to_contain('Mostly sun.')
  })

  it('says so when the version has no such file', @{
    expect(page('/packages/weather-kit?tab=source&file=../../etc/passwd'))
        .to_contain('This version has no file called ../../etc/passwd.')
  })

  it("is where a name's Source link on its API page leads", @{
    var shown = page('/packages/weather-kit?tab=api&module=weather_kit-app')
    var line = line_of(APP, 'def forecast(')

    expect(shown).to_contain(
      'href="/packages/weather-kit/0.1.0?tab=source&amp;file=app%2Findex.zu#L${line}">Source</a>',
    )
  })
})
