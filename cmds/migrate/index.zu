/**
 * @command migrate
 * @description Applies, rolls back and reports database migrations.
 *
 *   zuri migrate [up | status | down | reset | new <name>...] [options]
 *
 * Migrations are Zuri files in the project's migrations directory,
 * each named with a version and what it does, applied in order and
 * recorded in the database. The database comes from --database, or
 * DATABASE_URL in the environment or in the project's .env.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import os
import sql
import sql.errors { SqlError }
import sql.migrate { Migrator, create }

import .._shared.errors { run }
import .._shared.ui

import .plan

# Prints a list of migration names under a heading.
def _list(heading, names) {
  echo heading

  for name in names {
    echo '  ${name}'
  }
}

# A directory as the person will recognise it.
def _shown(path) {
  var relative = os.relative_path(os.cwd(), path)
  return relative.starts_with('..') ? path : relative
}

def _status(migrator) {
  var entries = migrator.status()

  if entries.is_empty() {
    echo 'There are no migrations in ${_shown(migrator.directory)}.'
    return
  }

  var rows = []
  var changed = 0
  var missing = 0

  for entry in entries {
    var state = entry.state

    if state == 'changed' {
      changed++
      state = ui.warn(state)
    } else if state == 'missing' {
      missing++
      state = ui.warn(state)
    } else if state == 'pending' {
      state = ui.accent(state)
    } else {
      state = ui.muted(state)
    }

    var batch = entry.batch == nil ? '' : ui.muted('batch ${entry.batch}')

    rows.append([state, entry.name, batch])
  }

  ui.say(ui.table(rows, ""))

  if changed > 0 {
    echo ''
    echo ui.warn(
      '${ui.count(changed, "migration")} changed since ${changed == 1 ? "it" : "they"} ran; ' +
          'the database has what ran then, not what the file says now.',
    )
  }

  if missing > 0 {
    echo ''
    echo ui.warn(
      '${ui.count(missing, "migration")} ran that ${missing == 1 ? "has" : "have"} ' +
          'no file in ${_shown(migrator.directory)}.',
    )
  }
}

def main() {
  var settings = plan.settings(plan.parser().parse())

  if settings.command == 'new' {
    for name in settings.names {
      echo 'Created ${_shown(create(settings.directory, name))}'
    }

    return
  }

  var db = sql.open(settings.database)

  catch {
    var migrator = Migrator(db, {
      directory: settings.directory,
      table: settings.table,
    })
    var limits = {}

    if settings.steps != nil {
      limits.set('steps', settings.steps)
    }

    if settings.to != nil {
      limits.set('to', settings.to)
    }

    using settings.command {
      when 'status' _status(migrator)
      when 'up' {
        var applied = migrator.up(limits)

        if applied.is_empty() {
          echo 'Nothing to apply; the database is up to date.'
        } else {
          _list('Applied ${ui.count(applied.length(), "migration")}:', applied)
        }
      }
      when 'down', 'reset' {
        var undone = settings.command == 'down'
            ? migrator.down(limits)
            : migrator.reset()

        if undone.is_empty() {
          echo 'Nothing to roll back.'
        } else {
          _list(
            'Rolled back ${ui.count(undone.length(), "migration")}:',
            undone,
          )
        }
      }
    }
  } as error {
    db.close()
    raise error
  }

  db.close()
}

run('migrate', main, [SqlError])
