/**
 * @command test
 * @description Run the tests.
 *
 *   zuri test [target]
 *
 * `target` is either a directory of test files or a single test file,
 * written with or without its `.zu` ending. If no target is given, the
 * `tests` directory here is used. Every option the `test` module's
 * `conduct()` accepts is available as a flag: how many files to run at
 * once, how long to give each one, when to stop, and which names to
 * run or skip.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import os
import os.process { exit }

import test { conduct, TestSetupError }
import test.conduct { discover }
import test.source { short_path }

import .plan

def main() {
  var parsed = plan.parser().parse()
  var target = parsed.indexes.is_empty() ? nil : parsed.indexes[0]

  var where = plan.resolve(target, nil)
  var options = plan.options(parsed, where.file)

  # Nothing but the paths, so the list can be piped somewhere.
  if parsed.options.get('list', false) {
    for path in discover(where.directory, options) {
      echo short_path(os.join_paths(where.directory, path))
    }

    return
  }

  conduct(where.directory, options)
}

catch {
  main()
} as error {
  if instance_of(error, plan.UsageError) or instance_of(error, TestSetupError) {
    echo 'test: ${error.message}'

    exit(1)
  }

  raise error
}
