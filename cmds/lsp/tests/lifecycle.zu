# The protocol's lifecycle: what the server answers before it is
# initialized, after it is shut down, and how it exits.

import os
import rpc
import test { * }

import ._client { Client, capabilities }

var FIXTURE = os.join_paths(os.dir_name(__file__), '_fixture')

# The code an error answer carries, or `nil` when the call succeeded.
def code_of(call) {
  catch {
    call()
  } as error {
    return instance_of(error, rpc.RpcError) ? error.code : -1
  }

  return nil
}

describe('before initialize', @{
  it('refuses requests with ServerNotInitialized', @{
    var client = Client(FIXTURE, nil)

    expect(code_of(@() => client.request('textDocument/hover', {})))
        .to_equal(-32002)
    expect(code_of(@() => client.request('zuri/nothing', {}))).to_equal(-32002)

    client.notify('exit', nil)
    expect(client.child.wait(5000)).to_equal(1)
  })
})

describe('initialize', @{
  it('describes the server and what it can do', @{
    var client = Client(FIXTURE, nil)
    var result = client.initialize(nil)
    var offered = result.capabilities

    expect(result.serverInfo.name).to_equal('zuri lsp')
    expect(offered.positionEncoding).to_equal('utf-16')
    expect(offered.textDocumentSync.change).to_equal(2)
    expect(offered.hoverProvider).to_be_true()
    expect(offered.renameProvider.prepareProvider).to_be_true()
    expect(offered.semanticTokensProvider.full.delta).to_be_true()
    expect(offered.codeActionProvider.codeActionKinds)
        .to_contain('refactor.extract')
    expect(offered).not.to_have_key('diagnosticProvider')
    expect(client.stop()).to_equal(0)
  })

  it('counts positions in UTF-32 when the client offers it', @{
    var client = Client(FIXTURE, nil)
    var asked = capabilities()

    asked.general.positionEncodings = ['utf-16', 'utf-8', 'utf-32']

    expect(client.initialize(asked).capabilities.positionEncoding)
        .to_equal('utf-32')
    expect(client.stop()).to_equal(0)
  })

  it('pulls diagnostics for a client that pulls them', @{
    var client = Client(FIXTURE, nil)
    var asked = capabilities()

    asked.textDocument.diagnostic = { dynamicRegistration: false }

    var offered = client.initialize(asked).capabilities

    expect(offered.diagnosticProvider.interFileDependencies).to_be_true()
    expect(offered.diagnosticProvider.workspaceDiagnostics).to_be_true()
    expect(client.stop()).to_equal(0)
  })

  it('refuses a second initialize', @{
    var client = Client(FIXTURE, nil)

    client.initialize(nil)
    expect(code_of(@() => client.request('initialize', { capabilities: {} })))
        .to_equal(-32600)
    expect(client.stop()).to_equal(0)
  })

  it('tells the client it started', @{
    var client = Client(FIXTURE, nil)

    client.initialize(nil)
    var logged = @() => client.notifications.find(
      @(n) => n.method == 'window/logMessage',
    )

    client.wait_for(@() => logged() != nil, 'a log message')

    var message = logged()

    expect(message.params.type).to_equal(3)
    expect(message.params.message).to_contain('started for zuri lsp tests')
    expect(client.stop()).to_equal(0)
  })

  it('asks for the settings and watches the workspace', @{
    var client = Client(FIXTURE, nil)

    client.initialize(nil)
    client.wait_for(
      @() => client.requests.length() >= 3,
      'registrations and a settings request',
    )

    var methods = client.requests.map(@(r) => r.method)

    expect(methods).to_contain('workspace/configuration')
    expect(methods).to_contain('client/registerCapability')
    expect(client.stop()).to_equal(0)
  })
})

describe('after initialize', @{
  it(
    'answers an unknown request with MethodNotFound and ignores an unknown notification',
    @{
      var client = Client(FIXTURE, nil)

      client.initialize(nil)
      client.notify('zuri/unknown', { a: 1 })
      client.notify('$/unknown', nil)

      expect(code_of(@() => client.request('zuri/unknown', {})))
          .to_equal(-32601)
      expect(client.stop()).to_equal(0)
    },
  )

  it('refuses requests once shut down, and exits with 0', @{
    var client = Client(FIXTURE, nil)

    client.initialize(nil)
    expect(client.request('shutdown', nil)).to_be_nil()
    expect(code_of(@() => client.request('textDocument/hover', {})))
        .to_equal(-32600)

    client.notify('exit', nil)
    expect(client.child.wait(5000)).to_equal(0)
  })

  it('exits with 1 when told to exit without shutting down', @{
    var client = Client(FIXTURE, nil)

    client.initialize(nil)
    client.notify('exit', nil)
    expect(client.child.wait(5000)).to_equal(1)
  })

  it('exits with 1 when its input ends', @{
    var client = Client(FIXTURE, nil)

    client.initialize(nil)
    client.child.close_stdin()
    expect(client.child.wait(5000)).to_equal(1)
  })

  it('exits once the editor that started it has gone', @{
    var client = Client(FIXTURE, nil)
    var asked = capabilities()

    # A process id nothing has: the editor is already gone.
    client.request('initialize', {
      processId: 2147483646,
      rootUri: nil,
      capabilities: asked,
    })
    client.notify('initialized', {})

    expect(client.child.wait(15000)).to_equal(1)
  })
})
