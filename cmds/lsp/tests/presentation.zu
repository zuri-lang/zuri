# What the editor draws from the server: semantic tokens, inlay hints,
# code lenses, and the call and type hierarchies.

import os
import test { * }

import ._client { Client, position, uri }

var FIXTURE = os.join_paths(os.dir_name(__file__), '_fixture')
var MAIN = os.join_paths(FIXTURE, 'main.zu')
var SHAPES = os.join_paths(FIXTURE, 'shapes.zu')
var SCRATCH = os.join_paths(FIXTURE, 'scratch.zu')
var client = nil
var legend = nil

# Decodes semantic tokens into `{ text: 'type modifiers' }` for the
# names of `source`.
def decode(source: string, data: list) {
  var lines = source.split('\n')
  var found = {}
  var line = 0
  var character = 0
  var i = 0

  while i < data.length() {
    line += data[i]
    character = data[i] == 0 ? character + data[i + 1] : data[i + 1]

    var word = lines[line][character, character + data[i + 2]]
    var modifiers = []

    iter var bit = 0; bit < legend.tokenModifiers.length(); bit++ {
      if data[i + 4] & (1 << bit) != 0 {
        modifiers.append(legend.tokenModifiers[bit])
      }
    }

    found['${line}:${word}'] = ' '.join(
      [legend.tokenTypes[data[i + 3]]] + modifiers,
    )
    i += 5
  }

  return found
}

before_all(@{
  client = Client(FIXTURE, {
    diagnostics: { delay: 0 },
    inlayHints: { parameterNames: 'literals', variableTypes: true },
  })
  legend = client.initialize(nil).capabilities.semanticTokensProvider.legend
  client.wait_indexed()
})

after_all(@{
  client.stop()
})

describe('semantic tokens', @{
  it('colours each name by what it resolves to', @{
    var main = client.open(MAIN, nil)
    var source = client.texts[main]
    var asked = {
      textDocument: { uri: main },
    }
    var answer = client.request('textDocument/semanticTokens/full', asked)
    var tokens = decode(source, answer.data)

    expect(tokens['0:json']).to_equal('namespace declaration')
    expect(tokens['1:Point']).to_equal('class declaration')
    expect(tokens['1:origin']).to_equal('function declaration')
    expect(tokens['4:here']).to_equal('variable declaration')
    expect(tokens['4:Point']).to_equal('class')
    expect(tokens['7:distance']).to_equal('method')
    expect(tokens['10:encode']).to_equal('function defaultLibrary')
    client.notify('textDocument/didClose', {
      textDocument: { uri: main },
    })
  })

  it('marks what is deprecated, static or read-only', @{
    var source = 'import .shapes { centre, UNIT }\necho centre()\necho UNIT\n'
    var address = client.open(SCRATCH, source)
    var asked = {
      textDocument: { uri: address },
    }
    var answer = client.request('textDocument/semanticTokens/full', asked)
    var tokens = decode(source, answer.data)

    expect(tokens['1:centre']).to_equal('function deprecated')
    expect(tokens['2:UNIT']).to_equal('variable readonly')
    client.notify('textDocument/didClose', {
      textDocument: { uri: address },
    })
  })

  it('sends only what changed since the last tokens', @{
    var source = 'var a = 1\necho a\n'
    var address = client.open(SCRATCH, source)
    var asked = {
      textDocument: { uri: address },
    }
    var first = client.request('textDocument/semanticTokens/full', asked)

    client.change(address, 'var a = 1\necho a\necho a\n')

    var delta = client.request('textDocument/semanticTokens/full/delta', {
      textDocument: { uri: address },
      previousResultId: first.resultId,
    })

    expect(delta.edits.length()).to_equal(1)
    expect(delta.edits[0].start).to_equal(first.data.length())
    expect(delta.edits[0].deleteCount).to_equal(0)
    expect(delta.edits[0].data).to_equal([1, 5, 1, 5, 0])
    client.notify('textDocument/didClose', {
      textDocument: { uri: address },
    })
  })

  it('answers for a range', @{
    var source = 'var a = 1\nvar b = 2\nvar c = 3\n'
    var address = client.open(SCRATCH, source)
    var answer = client.request('textDocument/semanticTokens/range', {
      textDocument: { uri: address },
      range: {
        start: { line: 1, character: 0 },
        end: { line: 2, character: 0 },
      },
    })

    expect(answer.data).to_equal([1, 4, 1, 5, 1])
    client.notify('textDocument/didClose', {
      textDocument: { uri: address },
    })
  })
})

describe('inlay hints', @{
  it('names the parameters of literal arguments, and shows inferred types', @{
    var main = client.open(MAIN, nil)
    var hints = client.request('textDocument/inlayHint', {
      textDocument: { uri: main },
      range: {
        start: { line: 0, character: 0 },
        end: { line: 12, character: 0 },
      },
    })
    var shown = hints.map(
      @(h) => '${h.position.line}:${h.position.character} ${h.label}',
    )

    expect(shown).to_contain_all([
      '4:17 x:',
      '4:20 y:',
      '5:18 x:',
      '5:21 y:',
      '5:24 radius:',
    ])
    expect(shown).to_contain_all(['4:8 : Point', '5:8 : Circle'])
    client.notify('textDocument/didClose', {
      textDocument: { uri: main },
    })
  })

  it("adds the parameter's documentation when resolved", @{
    var main = client.open(MAIN, nil)
    var hints = client.request('textDocument/inlayHint', {
      textDocument: { uri: main },
      range: {
        start: { line: 4, character: 0 },
        end: { line: 5, character: 0 },
      },
    })
    var resolved = client.request(
      'inlayHint/resolve',
      hints.find(@(h) => h.label == 'x:'),
    )

    expect(resolved.tooltip.value).to_equal('`number` How far along.')
    client.notify('textDocument/didClose', {
      textDocument: { uri: main },
    })
  })
})

describe('code lenses', @{
  it('counts the uses of each declaration once resolved', @{
    var shapes = client.open(SHAPES, nil)
    var lenses = client.request('textDocument/codeLens', {
      textDocument: { uri: shapes },
    })
    var lines = client.texts[shapes].split('\n')
    var origin = lenses.find(
      @(l) => lines[l.range.start.line].contains('def origin'),
    )
    var resolved = client.request('codeLens/resolve', origin)

    expect(resolved.command.title).to_equal('3 references')
    expect(resolved.command.command).to_equal('zuri.showReferences')
    expect(resolved.command.arguments[2].length()).to_equal(3)
    client.notify('textDocument/didClose', {
      textDocument: { uri: shapes },
    })
  })
})

describe('hierarchies', @{
  it('shows who calls a function and what it calls', @{
    var shapes = client.open(SHAPES, nil)
    var text = client.texts[shapes]
    var items = client.request('textDocument/prepareCallHierarchy', {
      textDocument: { uri: shapes },
      position: position(text, 'def orig', 0),
    })
    var incoming = client.request('callHierarchy/incomingCalls', {
      item: items[0],
    })
    var callers = incoming.map(@(call) => call.from.name).sort()

    expect(callers).to_equal(['centre', 'main'])

    var outgoing = client.request('callHierarchy/outgoingCalls', {
      item: items[0],
    })

    expect(outgoing.map(@(call) => call.to.name)).to_equal(['Point'])
    client.notify('textDocument/didClose', {
      textDocument: { uri: shapes },
    })
  })

  it('shows the classes above and below a class', @{
    var shapes = client.open(SHAPES, nil)
    var text = client.texts[shapes]
    var circle = client.request('textDocument/prepareTypeHierarchy', {
      textDocument: { uri: shapes },
      position: position(text, 'class Circ', 0),
    })
    var above = client.request('typeHierarchy/supertypes', { item: circle[0] })

    expect(above.map(@(item) => item.name)).to_equal(['Point'])

    var below = client.request('typeHierarchy/subtypes', { item: above[0] })

    expect(below.map(@(item) => item.name)).to_equal(['Circle'])
    client.notify('textDocument/didClose', {
      textDocument: { uri: shapes },
    })
  })
})
