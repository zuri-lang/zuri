# The corpus check: the server's diagnostics held against the runtime
# over every Zuri file of this repository.
#
# The code the repository ships and runs, the standard library, the
# commands, the documentation tools and the rest, gets none of the
# diagnostics that say code will fail. A test fixture runs too, and
# whatever it fails at is in its expected output: each such diagnostic
# in a fixture must be one the runtime raised there, and every undefined
# name the runtime raised must be reported.

import os
import zuri
import test { * }

import ..text
import ..resolve { Resolver }
import ..state { Settings }
import ..indexer { IndexPool }
import ..analysis.builtins { Builtins }
import ..analysis.linker { Linker }
import ..features.diagnostics

# Directories of the repository that hold no code it ships: the
# fixtures, which are checked on their own terms, and what builds and
# scratch work leave behind.
const _NOT_SHIPPED = ['tests', 'target', 'tmp', 'vendor']

# The diagnostics that say code will fail when it runs.
const CHECKED = [
  'undefined-name',
  'unknown-member',
  'missing-member',
  'undeclared-field',
  'module-not-found',
  'argument-type',
  'missing-argument',
]

var ROOT = os.abs_path(os.join_paths(os.dir_name(__file__), '..', '..', '..'))

/**
 * What the diagnostics need of a server, over files on disk.
 */
class Corpus {

  @new(root: string) {
    self.resolver = Resolver(root)
    self.builtins = Builtins(self.resolver.stdlib)
    self.linker = Linker(self.resolver, self.builtins)
    self.settings = Settings()
    self._texts = {}
    self._indexes = {}
  }

  summary(key: string) {
    return self.linker.summary(key)
  }

  open_document(key: string) {
    return nil
  }

  text(key: string) {
    if !self._texts.contains(key) {
      self._texts[key] = file(key).read()
    }

    return self._texts[key]
  }

  range(key: string, start: int, end: int) {
    if !self._indexes.contains(key) {
      self._indexes[key] = text.LineIndex(self.text(key))
    }

    return self._indexes[key].range(start, end, text.UTF16)
  }

  test_diagnostics(key: string) {
    return []
  }

  /**
   * Summarizes `paths` on indexer isolates and holds the summaries.
   *
   * @param list paths
   */
  index(paths: list) {
    var pool = IndexPool(3, self.builtins.names)

    pool.submit(paths.map(@(path) => { path, hash: nil }))

    while pool.is_busy() {
      for item in pool.receive(pool.results.recv()) {
        if item.contains('summary') {
          self.linker.put(item.path, item.summary)
        }
      }
    }

    pool.stop()
  }

  /**
   * The checked diagnostics of the file at `path`, or `nil` for a file
   * with a syntax error, which is not checked.
   *
   * @param string path
   * @returns ?list
   */
  check(path: string) {
    var summary = self.linker.summary(path)

    if summary == nil or !summary.errors.is_empty() {
      return nil
    }

    return diagnostics
        .compute(self, path)
        .filter(@(d) => CHECKED.contains(d.code))
  }
}

# Every `.zu` file under `directory` that runs. A stub describes a
# native module and never runs, except the prelude's, which is the
# prelude itself.
def files_under(directory: string) {
  return os
      .read_dir(directory, true)
      .filter(@(name) => name.ends_with('.zu'))
      .filter(
        @(name) => !name.ends_with('.stub.zu') or
            name.ends_with('_prelude.stub.zu'),
      )
      .map(@(name) => os.join_paths(directory, name))
      .sort()
}

# The spans of the function literals in `source`.
def function_literals(source: string) {
  var found = []

  def visit(node) {
    if node.kind == 'Anonymous' {
      found.append([node.start, node.end])
    }

    for key, value in node.fields {
      if is_list(value) {
        for item in value {
          if is_instance(item) and hasprop(item, 'fields') {
            visit(item)
          }
        }
      } else if is_instance(value) and hasprop(value, 'fields') {
        visit(value)
      }
    }
  }

  for node in zuri.parse_partial(source).nodes {
    visit(node)
  }

  return found
}

# Whether a typed-argument diagnostic is one the fixture asserts the
# runtime raises: a call wrapped in a function literal, in a fixture
# that checks with `raises()` or `to_raise()`, passes only when the
# runtime rejects the argument.
def asserted_to_raise(
  diagnostic: dict,
  source: string,
  offsets,
  literals: list,
) {
  if !['argument-type', 'missing-argument'].contains(diagnostic.code) {
    return false
  }

  if !source.contains('raises(') and !source.contains('to_raise') {
    return false
  }

  var at = offsets.offset(diagnostic.range.start, text.UTF16)

  return literals.some(@(span) => span[0] <= at and at <= span[1])
}

# Whether a fixture's expected output is what it prints, rather than a
# marker for a fixture its own assertions check.
def records_output(expected: string) {
  return !expected.starts_with('(unused: this fixture is checked by exit code')
}

# The text the runtime raises for what a diagnostic reports.
def runtime_text(diagnostic: dict) {
  var name = diagnostic.get('data', {}).get('name', nil)

  using diagnostic.code {
    when 'undefined-name' {
      return "undefined global '${name}'"
    }
    when 'unknown-member',
        'undeclared-field',
        'missing-member' return "'${name}'"
    when 'module-not-found' return 'could not be found'
    default {
      return diagnostic.message
    }
  }
}

var corpus = Corpus(ROOT)
var shipped = []
var fixtures = []

for name in os.read_dir(ROOT) {
  var directory = os.join_paths(ROOT, name)

  if !name.starts_with('.') and
      !_NOT_SHIPPED.contains(name) and
      os.is_dir(directory) {
    shipped.extend(files_under(directory))
  }
}

# A fixture checked by its own assertions records nothing the runtime
# raised to hold its diagnostics against, so only fixtures whose output
# is recorded are checked.
for path in files_under(os.join_paths(ROOT, 'tests')) {
  var out = path[0, path.length() - 3] + '.out'

  if file(out).exists() and records_output(file(out).read()) {
    fixtures.append(path)
  }
}

before_all(@{
  var everything = shipped.clone()

  everything.extend(fixtures)
  corpus.index(everything)
})

describe('shipped code', @{
  it('gets no diagnostic that says it will fail', @{
    var found = []

    for path in shipped {
      var reported = corpus.check(path)

      if reported == nil {
        continue
      }

      for diagnostic in reported {
        var line = diagnostic.range.start.line + 1

        found.append(
          '${path[ROOT.length() + 1, path.length()]}:${line}: ${diagnostic.message}',
        )
      }
    }

    expect(found).to_equal([])
  })
})

describe('test fixtures', @{
  it(
    'report only what the runtime raised, and every undefined name it raised',
    @{
      var found = []

      for path in fixtures {
        var reported = corpus.check(path)

        if reported == nil {
          continue
        }

        var expected = file(path[0, path.length() - 3] + '.out').read()
        var short = path[ROOT.length() + 1, path.length()]
        var source = corpus.text(path)
        var offsets = text.LineIndex(source)
        var literals = function_literals(source)
        var names = []

        for diagnostic in reported {
          var raised = expected.contains(runtime_text(diagnostic))

          if !raised and
              !asserted_to_raise(diagnostic, source, offsets, literals) {
            found.append(
              '${short}:${diagnostic.range.start.line + 1}: ${diagnostic.message}',
            )
          }

          if diagnostic.code == 'undefined-name' {
            names.append(diagnostic.data.name)
          }
        }

        var raised = expected.matches(
          "/undefined global '([A-Za-z_][A-Za-z0-9_]*)'/",
        )

        for name in raised.get(1, []) {
          if !names.contains(name) {
            found.append(
              "${short}: the runtime raised undefined global '${name}', not reported",
            )
          }
        }
      }

      expect(found).to_equal([])
    },
  )
})
