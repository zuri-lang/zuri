# Diagnostics: each kind the server reports, pushed and pulled, and the
# settings that shape them.

import os
import test { * }

import ._client { Client, capabilities, uri }

var FIXTURE = os.join_paths(os.dir_name(__file__), '_fixture')
var SCRATCH = os.join_paths(FIXTURE, 'scratch.zu')

# The runtime's own message for an argument of the wrong type.
def expects(function_name: string, param: string, position: int, got: string) {
  return "${function_name}() expects parameter '${param}' (argument ${position}) " +
      'to be a number, got ${got}'
}

# What a field set outside `@new` is told.
var DECLARE = 'declare it with `var value` in the class or set it in @new'

# Every problem as `[line, code, message]`, in line order.
def summarise(found: list) {
  var rows = found.map(@(d) => [d.range.start.line, d.code, d.message])

  rows.sort(@(a, b) => a[0] != b[0] ? a[0] - b[0] : a[1].compare(b[1]))

  return rows
}

var PROBLEMS = '
import json
import .shapes { Point, Nowhere, centre }
import .missing
import nothing_here

var here = Point(1, 2)
echo here.lenght
echo undefined_name
echo json.encod
here.move("a", 1)
here.move(1)
echo Point()
echo centre()

def helper() {
  var unused = 1
  return 2
  echo "never"
}

class Box {
  set(v) {
    self.value = v
  }
}
'

describe('pushed', @{
  var client = nil

  before_all(@{
    client = Client(FIXTURE, {
      diagnostics: { delay: 0 },
    })
    client.initialize(nil)
    client.wait_indexed()
  })

  after_all(@{
    client.stop()
  })

  it('reports each kind of problem where it is', @{
    var address = client.open(SCRATCH, PROBLEMS)
    var rows = summarise(client.diagnostics_of(address))

    expect(rows)
        .to_equal([
          [2, 'missing-member', "module '.shapes' has no member 'Nowhere'"],
          [3, 'module-not-found', "cannot find module '.missing'"],
          [4, 'module-not-found', "cannot find module 'nothing_here'"],
          [7, 'unknown-member', "'lenght' is not a member of Point"],
          [8, 'undefined-name', "'undefined_name' is not defined"],
          [9, 'missing-member', "module 'json' has no member 'encod'"],
          [10, 'argument-type', expects('move', 'dx', 1, 'string')],
          [11, 'missing-argument', expects('move', 'dy', 2, 'nil')],
          [12, 'missing-argument', expects('@new', 'x', 1, 'nil')],
          [12, 'missing-argument', expects('@new', 'y', 2, 'nil')],
          [13, 'deprecated', "'centre' is deprecated: Use origin() instead."],
          [16, 'unused', "'unused' is never used"],
          [18, 'unreachable', 'this code is never reached'],
          [23, 'undeclared-field', "'value' is not a field of Box: " + DECLARE],
        ])
  })

  it('marks the unused and the deprecated for the editor to fade and strike', @{
    var found = client.diagnostics[uri(SCRATCH)].diagnostics

    for diagnostic in found {
      using diagnostic.code {
        when 'unused', 'unreachable' {
          expect(diagnostic.tags).to_equal([1])
        }
        when 'deprecated' {
          expect(diagnostic.tags).to_equal([2])
        }
        when 'unknown-member' {
          expect(diagnostic.severity).to_equal(2)
        }
        default {
          expect(diagnostic.severity).to_equal(1)
        }
      }
    }

    client.notify('textDocument/didClose', {
      textDocument: { uri: uri(SCRATCH) },
    })
  })

  it('reports syntax errors, and the compiler only for source that parses', @{
    var address = client.open(SCRATCH, 'var x = (\n')
    var rows = summarise(client.diagnostics_of(address))

    expect(rows.length()).to_equal(1)
    expect(rows[0][1]).to_equal('syntax')

    client.change(address, 'def f() {\n  break\n}\n')
    rows = summarise(client.diagnostics_of(address))
    # `f` is a public function another file may import, so it is
    # never unused.
    expect(rows.map(@(row) => row[1])).to_equal(['compile'])
    client.notify('textDocument/didClose', {
      textDocument: { uri: address },
    })
  })

  it('stays quiet about what cannot be told', @{
    var source = 'def f(anything) {\n  return anything.whatever + anything.more()\n}\n' +
        'echo f({ a: 1 }).b\necho { a: 1 }.zzz\n'
    var address = client.open(SCRATCH, source)

    expect(client.diagnostics_of(address)).to_equal([])
    client.notify('textDocument/didClose', {
      textDocument: { uri: address },
    })
  })

  it('checks a file again when a module it imports changes', @{
    var main = client.open(os.join_paths(FIXTURE, 'main.zu'), nil)

    expect(client.diagnostics_of(main)).to_equal([])

    var shapes_path = os.join_paths(FIXTURE, 'shapes.zu')
    var shapes = client.open(shapes_path, nil)
    var renamed = client.texts[shapes].replace(
      'def origin()',
      'def start()',
      false,
    )

    client.change(shapes, renamed)
    var rechecked = @() => client.diagnostics[main].diagnostics.length() > 0

    client.wait_for(rechecked, 'main.zu checked again')

    var message = client.diagnostics[main].diagnostics[0].message

    expect(message).to_equal("module '.shapes' has no member 'origin'")

    client.notify('textDocument/didClose', {
      textDocument: { uri: shapes },
    })
    client.notify('textDocument/didClose', {
      textDocument: { uri: main },
    })
  })
})

describe('pulled', @{
  var client = nil

  before_all(@{
    client = Client(FIXTURE, {
      diagnostics: { scope: 'workspace' },
    })

    var asked = capabilities()

    asked.textDocument.diagnostic = { dynamicRegistration: false }
    client.initialize(asked)
    client.wait_indexed()
  })

  after_all(@{
    client.stop()
  })

  it('answers a document pull, and says when nothing changed', @{
    var address = client.open(SCRATCH, 'echo gone\n')
    var first = client.request('textDocument/diagnostic', {
      textDocument: { uri: address },
    })

    expect(first.kind).to_equal('full')
    expect(first.items.length()).to_equal(1)

    var second = client.request('textDocument/diagnostic', {
      textDocument: { uri: address },
      previousResultId: first.resultId,
    })

    expect(second).to_equal({ kind: 'unchanged', resultId: first.resultId })
    client.notify('textDocument/didClose', {
      textDocument: { uri: address },
    })
  })

  it('answers a workspace pull with every file nobody has open', @{
    var answer = client.request('workspace/diagnostic', {
      previousResultIds: [],
    })
    var files = answer.items.map(@(item) => item.uri.split('/').last()).sort()

    expect(files)
        .to_equal(['area.zu', 'checks.zu', 'index.zu', 'main.zu', 'shapes.zu'])
    var clean = answer.items.every(
      @(item) => item.kind == 'full' and item.items.is_empty(),
    )

    expect(clean).to_be_true()
  })

  it('pushes nothing to a client that pulls', @{
    expect(client.diagnostics).to_equal({})
  })
})

describe('settings', @{
  it('reports nothing once diagnostics are turned off', @{
    var client = Client(FIXTURE, {
      diagnostics: { delay: 0 },
    })

    client.initialize(nil)

    var address = client.open(SCRATCH, 'echo gone\nimport json\n')

    expect(client.diagnostics_of(address).length()).to_equal(2)

    client.settings = {
      diagnostics: { delay: 0, enable: false },
    }
    client.notify('workspace/didChangeConfiguration', {
      settings: { zuri: client.settings },
    })
    var cleared = @() => client.diagnostics[address].diagnostics.is_empty()

    client.wait_for(cleared, 'diagnostics cleared')

    client.settings = {
      diagnostics: { delay: 0, enable: true, unusedHints: false },
    }
    client.notify('workspace/didChangeConfiguration', {
      settings: { zuri: client.settings },
    })

    var one = @() => client.diagnostics[address].diagnostics.length() == 1

    client.wait_for(one, 'one diagnostic')
    expect(client.diagnostics[address].diagnostics[0].code)
        .to_equal('undefined-name')
    client.stop()
  })
})
