import test { * }
import .shapes { Point }

describe('points', @{
  it('measure the distance between them', @{
    expect(Point(0, 0).distance(Point(3, 4))).to_equal(5)
  })

  it('know where they are', @{
    # NOTE: This is an intentionally failing test to demonstrate the output
    # of a failed expectation.
    expect(Point(1, 2).x).to_equal(2)
  })
})

it_each(
  [
    [1, 2],
    [2, 4],
  ],
  'doubles $0 to $1',
  @(a, b) {
    expect(a * 2).to_equal(b)
  },
)
