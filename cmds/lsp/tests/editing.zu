# Quick fixes, refactorings and formatting: each edit applied, and the
# text it gives checked.

import os
import test { * }

import ._client { Client, position, range_of, apply, uri }

var FIXTURE = os.join_paths(os.dir_name(__file__), '_fixture')
var SCRATCH = os.join_paths(FIXTURE, 'scratch.zu')
var client = nil

# The code actions for `source` over the first `marker` in it, with the
# document's own diagnostics as the context.
def actions_for(source: string, marker: string) {
  var address = client.open(SCRATCH, source)
  var diagnostics = client.diagnostics_of(address)
  var found = client.request('textDocument/codeAction', {
    textDocument: { uri: address },
    range: range_of(source, marker),
    context: { diagnostics },
  })

  client.notify('textDocument/didClose', {
    textDocument: { uri: address },
  })

  return found
}

# The text an action leaves the scratch document with.
def applied(source: string, action: dict) {
  var change = action.edit.documentChanges.find(
    @(c) => c.textDocument.uri == uri(SCRATCH),
  )

  return apply(source, change.edits)
}

# The action titled `title`, or `nil`.
def titled(found: list, title: string) {
  return found.find(@(action) => action.title == title)
}

before_all(@{
  client = Client(FIXTURE, {
    diagnostics: { delay: 0 },
  })
  client.initialize(nil)
  client.wait_indexed()
})

after_all(@{
  client.stop()
})

describe('quick fixes', @{
  it('imports a name another module exports', @{
    var source = 'echo origin()\n'
    var fix = titled(
      actions_for(source, 'origin'),
      "Import 'origin' from '.shapes'",
    )

    expect(fix.kind).to_equal('quickfix')
    expect(fix.isPreferred).to_be_true()
    expect(applied(source, fix))
        .to_equal('import .shapes { origin }\necho origin()\n')
  })

  it('imports a module named like the missing name', @{
    var source = '/**\n * @module scratch\n */\n\necho json.encode(1)\n'
    var fix = titled(actions_for(source, 'json'), "Import module 'json'")

    var expected = '/**\n * @module scratch\n */\nimport json\n\necho json.encode(1)\n'

    expect(applied(source, fix)).to_equal(expected)
  })

  it('corrects a misspelt name', @{
    var source = 'var total = 1\necho totl\n'
    var fix = titled(actions_for(source, 'totl'), "Change to 'total'")

    expect(applied(source, fix)).to_equal('var total = 1\necho total\n')
  })

  it('corrects a misspelt member', @{
    var source = 'import .shapes { Point }\necho Point(1, 2).distanse(Point(0, 0))\n'
    var fix = titled(actions_for(source, 'distanse'), "Change to 'distance'")

    expect(applied(source, fix)).to_contain('.distance(Point(0, 0))')
  })

  it('removes an unused import', @{
    var source = 'import json\necho 1\n'
    var fix = titled(
      actions_for(source, 'json'),
      "Remove the unused import of 'json'",
    )

    expect(applied(source, fix)).to_equal('echo 1\n')
  })

  it('removes an unused element and leaves the rest of its import', @{
    var source = 'import .shapes { Point, UNIT }\necho Point(1, 2)\n'
    var fix = titled(
      actions_for(source, 'UNIT'),
      "Remove 'UNIT' from the import",
    )

    expect(applied(source, fix))
        .to_equal('import .shapes { Point }\necho Point(1, 2)\n')
  })

  it('declares a field set outside @new', @{
    var source = 'class Box {\n  var size = 1\n\n  fill(v) {\n    self.value = v\n  }\n}\n'
    var fix = titled(
      actions_for(source, 'value'),
      "Declare 'value' as a field of Box",
    )

    expect(applied(source, fix)).to_equal(
      'class Box {\n  var value\n  var size = 1\n\n  fill(v) {\n    self.value = v\n  }\n}\n',
    )
  })
})

describe('extract variable', @{
  it('moves an expression into a variable before its statement', @{
    var source = 'def f(a) {\n  echo a * 2 + 1\n}\n'
    var found = actions_for(source, 'a * 2')
    var action = titled(found, "Extract 'a * 2' into a variable")

    expect(action.kind).to_equal('refactor.extract')
    var expected = 'def f(a) {\n  var value = a * 2\n  echo value + 1\n}\n'

    expect(applied(source, action)).to_equal(expected)
  })

  it('takes every copy in the block when nothing it reads changes between', @{
    var source = 'def f(a) {\n  echo a.length()\n  echo a.length() + 1\n}\n'
    var source_pure = 'def f(a) {\n  echo a * 2\n  echo a * 2 + 1\n}\n'
    var action = titled(
      actions_for(source_pure, 'a * 2'),
      'Extract all 2 copies into a variable',
    )

    expect(applied(source_pure, action)).to_equal(
      'def f(a) {\n  var value = a * 2\n  echo value\n  echo value + 1\n}\n',
    )

    # A call may do something each time, so its copies stay apart.
    var found = actions_for(source, 'a.length()')

    expect(found.some(@(a) => a.title.starts_with('Extract all'))).to_be_false()
  })

  it_each(
    [
      [
        'the condition of a loop',
        'def f(a) {\n  while a > 0 {\n    a--\n  }\n}\n',
        'a > 0',
      ],
      ['the right of and', 'def f(a, b) {\n  echo a and b.ok()\n}\n', 'b.ok()'],
      ['a branch of ?:', 'def f(a) {\n  echo a ? a.x() : 0\n}\n', 'a.x()'],
      [
        'after a side effect',
        'def f(a) {\n  echo a.push(1) + a.length()\n}\n',
        'a.length()',
      ],
    ],
    'is not offered from $0',
    @(where, source, marker) {
      var found = actions_for(source, marker)

      expect(found.some(@(a) => a.title.starts_with('Extract '))).to_be_false()
    },
  )
})

describe('extract function', @{
  it('passes the locals it uses and returns the one read after it', @{
    var source = 'def f(a) {\n  var b = a + 1\n  var c = b * 2\n  echo c\n}\n'
    var found = actions_for(source, 'var b = a + 1\n  var c = b * 2')
    var action = titled(found, "Extract into function 'extracted'")

    expect(applied(source, action)).to_equal(
      'def f(a) {\n  var c = extracted(a)\n  echo c\n}\n\n' +
          'def extracted(a) {\n  var b = a + 1\n  var c = b * 2\n\n  return c\n}\n',
    )
  })

  it('returns several values in a dictionary', @{
    var source = 'def f(a) {\n  var b = a + 1\n  var c = a * 2\n  echo b + c\n}\n'
    var found = actions_for(source, 'var b = a + 1\n  var c = a * 2')
    var result = applied(
      source,
      titled(found, "Extract into function 'extracted'"),
    )

    expect(result).to_contain('  var extracted_result = extracted(a)\n')
    expect(
      result,
    ).to_contain('  var b = extracted_result.b\n  var c = extracted_result.c\n')
    expect(result).to_contain('  return { b, c }\n')
  })

  it('makes a private method of statements that use self', @{
    var source = 'class A {\n  var n = 1\n\n  show() {\n' +
        '    var twice = self.n * 2\n    echo twice\n  }\n}\n'
    var found = actions_for(source, 'var twice = self.n * 2\n    echo twice')
    var result = applied(
      source,
      titled(found, "Extract into method '_extracted'"),
    )

    expect(result).to_contain('    self._extracted()\n')
    expect(result).to_contain(
      '  _extracted() {\n    var twice = self.n * 2\n    echo twice\n  }',
    )
  })

  it('is not offered for statements holding a return or leaving a loop', @{
    var returns = 'def f(a) {\n  echo a\n  return a\n}\n'
    var breaks = 'def f(a) {\n  while true {\n    echo a\n    break\n  }\n}\n'

    var extracts = @(found) => found.some(@(a) => a.title.contains('function'))

    expect(extracts(actions_for(returns, 'echo a\n  return a'))).to_be_false()
    expect(extracts(actions_for(breaks, 'echo a\n    break'))).to_be_false()
  })
})

describe('inline', @{
  it('puts a variable value where it is used', @{
    var source = 'def f(a) {\n  var total = a + 1\n  echo total * 2\n  echo total\n}\n'
    var action = titled(actions_for(source, 'total'), "Inline variable 'total'")

    expect(action.kind).to_equal('refactor.inline')
    expect(applied(source, action))
        .to_equal('def f(a) {\n  echo (a + 1) * 2\n  echo (a + 1)\n}\n')
  })

  it('moves a value with a side effect only to its single next use', @{
    var once = 'def f(a) {\n  var n = a.pop()\n  echo n\n}\n'
    var twice = 'def f(a) {\n  var n = a.pop()\n  echo n\n  echo n\n}\n'

    expect(
      applied(once, titled(actions_for(once, 'var n'), "Inline variable 'n'")),
    ).to_equal('def f(a) {\n  echo a.pop()\n}\n')
    expect(titled(actions_for(twice, 'var n'), "Inline variable 'n'"))
        .to_be_nil()
  })

  it(
    'is not offered for a variable set again, or when what it reads changes',
    @{
      var set_again = 'def f(a) {\n  var n = a\n  n = 2\n  echo n\n}\n'
      var read_changes = 'def f(a) {\n  var n = a + 1\n  a = 5\n  echo n\n}\n'

      expect(titled(actions_for(set_again, 'var n'), "Inline variable 'n'"))
          .to_be_nil()
      expect(titled(actions_for(read_changes, 'var n'), "Inline variable 'n'"))
          .to_be_nil()
    },
  )

  it('inlines every call of a one-line function and removes it', @{
    var source = 'def double(n) {\n  return n * 2\n}\n\necho double(3)\necho double(1 + 1)\n'
    var title = "Inline every call of 'double' and remove it"
    var action = titled(actions_for(source, 'def double'), title)

    expect(applied(source, action))
        .to_equal('\necho (3 * 2)\necho ((1 + 1) * 2)\n')
  })

  it('inlines the one call under the cursor', @{
    var source = 'def double(n) {\n  return n * 2\n}\n\necho double(3)\necho double(4)\n'
    var action = titled(
      actions_for(source, 'double(3)'),
      "Inline this call of 'double'",
    )

    expect(applied(source, action)).to_contain('echo (3 * 2)\necho double(4)')
  })
})

describe('formatting', @{
  it('sends only the lines that change', @{
    var source = 'def f( a ){\nreturn a}\n\necho 1\n'
    var address = client.open(SCRATCH, source)
    var edits = client.request('textDocument/formatting', {
      textDocument: { uri: address },
      options: { tabSize: 2, insertSpaces: true },
    })

    expect(apply(source, edits))
        .to_equal('def f(a) {\n  return a\n}\n\necho 1\n')
    expect(edits.every(@(edit) => edit.range.start.line < 3)).to_be_true()
    client.notify('textDocument/didClose', {
      textDocument: { uri: address },
    })
  })

  it('keeps to the range asked for', @{
    var source = 'var a = [1,2]\n\nvar b = [3,4]\n'
    var address = client.open(SCRATCH, source)
    var edits = client.request('textDocument/rangeFormatting', {
      textDocument: { uri: address },
      range: {
        start: { line: 2, character: 0 },
        end: { line: 3, character: 0 },
      },
      options: { tabSize: 2, insertSpaces: true },
    })

    expect(apply(source, edits)).to_equal('var a = [1,2]\n\nvar b = [3, 4]\n')
    client.notify('textDocument/didClose', {
      textDocument: { uri: address },
    })
  })

  it('leaves a file with a syntax error as it is', @{
    var address = client.open(SCRATCH, 'def f( {\n')
    var edits = client.request('textDocument/formatting', {
      textDocument: { uri: address },
      options: { tabSize: 2, insertSpaces: true },
    })

    expect(edits).to_equal([])
    client.notify('textDocument/didClose', {
      textDocument: { uri: address },
    })
  })
})
