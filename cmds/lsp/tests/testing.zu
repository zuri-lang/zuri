# Finding and running the tests a workspace declares with the `test`
# module.

import os
import test { * }

import ._client { Client, position, uri }
import ..features.testing { failure_path }

var FIXTURE = os.join_paths(os.dir_name(__file__), '_fixture')
var CHECKS = os.join_paths(FIXTURE, 'checks.zu')
var client = nil
var checks = nil

# Runs tests of checks.zu through the server's command.
def run(filter) {
  var target = { uri: checks, notify: false }

  if filter != nil {
    target.filter = filter
  }

  var command = {
    command: 'zuri.runTests',
    arguments: [target],
  }

  return client.request('workspace/executeCommand', command)
}

# Stands in for the server where only the files it knows are wanted.
class _Known {

  @new(keys: list) {
    self.keys = keys
  }

  paths() {
    return self.keys
  }
}

before_all(@{
  client = Client(FIXTURE, {
    diagnostics: { delay: 0 },
  })
  client.initialize(nil)
  client.wait_indexed()
  checks = client.open(CHECKS, nil)
})

after_all(@{
  client.stop()
})

describe('finding tests', @{
  it(
    'lists the suites and tests of a file, each with the filter that runs it',
    @{
      var found = client.request('zuri/tests', {
        textDocument: { uri: checks },
      })

      expect(found.map(@(t) => [t.kind, t.fullName, t.filter]))
          .to_equal([
            ['suite', 'points', '/^points > /'],
            ['test', 'doubles $0 to $1', '/^doubles .* to .*$/'],
          ])
      expect(found[0].children.map(@(t) => t.fullName)).to_equal([
        'points > measure the distance between them',
        'points > know where they are',
      ])
    },
  )

  it('lists every file of the workspace that declares tests', @{
    var found = client.request('zuri/workspaceTests', {})

    expect(found.map(@(f) => f.uri.split('/').last())).to_equal(['checks.zu'])
  })

  it('puts a lens to run them over each', @{
    var lenses = client.request('textDocument/codeLens', {
      textDocument: { uri: checks },
    })
    var titles = lenses
        .filter(@(l) => l.get('command', nil) != nil)
        .map(@(l) => l.command.title)

    expect(titles).to_equal([
      'Run tests in file',
      'Run suite',
      'Run test',
      'Run test',
      'Run test',
    ])
  })
})

describe('running tests', @{
  it('runs a file, reporting each result as it comes', @{
    var result = run(nil)

    expect([result.passed, result.failed, result.exitCode]).to_equal([3, 1, 1])
    expect(
      client.notifications
          .filter(@(n) => n.method == 'zuri/testEvent')
          .length(),
    )
        .to_equal(4)
  })

  it('shows a failed assertion on the line it failed at', @{
    client.wait_for(@() {
      var pushed = client.diagnostics.get(checks, nil)

      return pushed != nil and
          pushed.diagnostics.some(@(d) => d.source == 'zuri test')
    }, 'the failure shown')

    var failure = client.diagnostics[checks].diagnostics.find(
      @(d) => d.source == 'zuri test',
    )

    expect(failure.range.start.line).to_equal(11)
    expect(
      failure.message,
    ).to_contain('points > know where they are: Expected 1 to deeply equal 2')
  })

  it('runs one test, or a table of them, by its filter', @{
    var one = run('/^points > measure the distance between them$/')

    expect([one.passed, one.failed]).to_equal([1, 0])

    var table = run('/^doubles .* to .*$/')

    expect([table.passed, table.failed]).to_equal([2, 0])
  })

  it('forgets the failures shown in a file once it changes', @{
    client.change(checks, client.texts[checks] + '\n')
    client.wait_for(@() {
      var pushed = client.diagnostics.get(checks, nil)

      if pushed == nil or pushed.version != 2 {
        return false
      }

      return !pushed.diagnostics.some(@(d) => d.source == 'zuri test')
    }, 'the failures forgotten')
  })
})

describe('failure paths', @{
  it('resolves a name against where the run was', @{
    expect(failure_path(_Known([]), FIXTURE, 'checks.zu'))
        .to_equal(os.abs_path(CHECKS))
  })

  it('takes a whole name as it stands', @{
    var elsewhere = os.abs_path(os.join_paths(FIXTURE, '..', '_client.zu'))

    expect(failure_path(_Known([]), FIXTURE, elsewhere)).to_equal(elsewhere)
  })

  it('spells a whole name the way the server knows the file on Windows', @{
    if os.platform == 'windows' {
      var known = os.abs_path(CHECKS)

      expect(failure_path(_Known([known]), FIXTURE, known.upper()))
          .to_equal(known)
    }
  })
})
