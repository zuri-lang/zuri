/**
 * @command lsp
 * @description Runs the Zuri language server for editor integration 
 *    and support.
 *
 * Editors start the server themselves and talk to it over its
 * standard input and output:
 *
 *   zuri lsp [--stdio] [--log <path>] [--log-level <level>]
 *
 * `--stdio` names the only way the server talks, and is accepted
 * because clients pass it. `--log` appends the server's log to a file
 * as well as sending it to the editor, and `--log-level` sets how much
 * is logged: `error`, `warn`, `info` (the default), `debug`, or `trace`,
 * which also logs every message exchanged, to the file alone.
 *
 * The process exits with 0 when the editor shuts it down in order, and
 * with 1 when the connection ends without that or the editor that
 * started it exits.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import args
import io
import os.process { exit }

import .logging
import .server { Server }

def main() {
  var parser = args.Parser('zuri lsp', false)

  parser.description = 'Runs the Zuri language server for editor integration and support.'
  parser.epilog = 'Editors start the server themselves; see the Editor Support chapter of the book.'
  parser.add_option(
    'stdio',
    'Talk over standard input and output, as the server always does',
    nil,
  )
  parser.add_option('log', 'Append the log to this file as well', {
    type: args.STRING,
    metavar: 'path',
  })
  parser.add_option(
    'log-level',
    'How much to log: error, warn, info, debug or trace',
    {
      type: args.CHOICE,
      choices: logging.LEVELS,
      value: logging.DEFAULT_LEVEL,
      metavar: 'level',
    },
  )

  var parsed = parser.parse()
  var level = parsed.options.get('log-level', logging.DEFAULT_LEVEL)
  var path = parsed.options.get('log', nil)
  var client = nil

  catch {
    client = logging.configure(level, path)
  } as error {
    io.stderr.write('lsp: cannot log to ${path}: ${error.message}\n')
    client = logging.configure(level, nil)
  }

  var running = Server(client)

  if level == 'trace' {
    logging.trace_protocol(running.endpoint)
  }

  exit(running.run())
}

main()
