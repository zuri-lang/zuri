/**
 * @module fmt.printer
 *
 * Turns a layout document into text. Each group is laid out on one line
 * when what it holds fits in what is left of the line, and broken
 * otherwise, outermost first, so a long line breaks where its
 * expression holds together least before anywhere deeper. Of the
 * layouts a `first_fit` offers, the first whose opening line fits is
 * taken.
 *
 * "Fits" looks as far as the next newline that is certain to happen.
 * A block inside a layout opens on a line of its own whatever the
 * layout around it decides, so the layout only has to fit up to the
 * brace.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import .doc { flat_width, fill_from }

/**
 * How wide a line may be.
 */
var WIDTH = 80

/**
 * One level of indentation.
 */
var INDENT = '  '

var _BREAK = 1
var _FLAT = 0

# One piece of the document still to lay out, with the level its lines
# indent to and whether its groups are laid out broken or flat.
class Cmd {
  var level = 0
  var mode = 0
  var doc = nil

  @new(level: number, mode: number, doc) {
    self.level = level
    self.mode = mode
    self.doc = doc
  }
}

# The column just past `text` when it starts at `column`. Text spanning
# lines, a multi-line string, ends wherever its last line does.
def _advance(column: number, text: string) {
  var newline = text.last_index_of('\n')

  if newline == -1 {
    return column + text.length()
  }

  return text.length() - newline - 1
}

# Drops the spaces the last line ended on, so a line that breaks after
# a space never leaves it behind.
def _trim(out: list) {
  while !out.is_empty() {
    var last = out.last()
    var trimmed = last.rtrim(' ')

    if trimmed != '' or last == '' {
      out[out.length() - 1] = trimmed

      return
    }

    out.pop()
  }
}

# Whether `next` fits on what is left of the line, `limit - column`
# columns. Once it runs out, what follows it in `rest` is measured too,
# since the line goes on past it until something breaks it. A line laid
# out broken, or one that always breaks, ends the measure: whatever
# comes after starts a new line.
#
# When `whole`, every line of `next` has to fit, not just its first,
# with each group in it laid out flat unless it is broken already. A
# line that always breaks inside `next` fails the measure then, since
# what follows it was never measured.
def _fits(next, rest: list, column: number, limit: number, whole: bool) {
  var rest_at = rest.length()
  var stack = [next]
  var left = limit - column
  var strict = whole

  while left >= 0 {
    if stack.is_empty() {
      if rest_at == 0 {
        return true
      }

      rest_at -= 1
      stack.append(rest[rest_at])
      strict = false

      continue
    }

    var cmd = stack.pop()
    var doc = cmd.doc

    if is_string(doc) {
      var newline = doc.index_of('\n')

      if newline == -1 {
        left -= doc.length()

        continue
      }

      if !strict or left - newline < 0 {
        return left - newline >= 0
      }

      left = limit - (doc.length() - doc.last_index_of('\n') - 1)

      continue
    }

    if is_list(doc) {
      var index = doc.length() - 1

      while index >= 0 {
        stack.append(Cmd(cmd.level, cmd.mode, doc[index]))
        index -= 1
      }

      continue
    }

    using doc.t {
      when 'line' {
        if doc.hard {
          return !strict
        }

        if cmd.mode == _BREAK {
          if !strict {
            return true
          }

          left = limit - cmd.level * INDENT.length()
        } else if !doc.soft {
          left -= 1
        }
      }
      when 'group' {
        var mode = cmd.mode

        if flat_width(doc) < 0 {
          mode = _BREAK
        } else if strict {
          mode = _FLAT
        }

        stack.append(Cmd(cmd.level, mode, doc.doc))
      }
      when 'first_fit' {
        var chosen = doc.parts[0]

        if cmd.mode == _BREAK and !strict {
          chosen = doc.parts.last()
        }

        stack.append(Cmd(cmd.level, strict ? _FLAT : cmd.mode, chosen))
      }
      when 'free' {
        stack.append(Cmd(cmd.level, strict ? _FLAT : _BREAK, doc.doc))
      }
      when 'nest' {
        stack.append(Cmd(cmd.level + 1, cmd.mode, doc.doc))
      }
      when 'fill' {
        var index = doc.parts.length() - 1

        while index >= doc.at {
          stack.append(Cmd(cmd.level, cmd.mode, doc.parts[index]))
          index -= 1
        }
      }
      when 'if_break' {
        var chosen = cmd.mode == _BREAK ? doc.doc : doc.other

        stack.append(Cmd(cmd.level, cmd.mode, chosen))
      }
      when 'choose' {
        stack.append(Cmd(cmd.level, _FLAT, doc.doc))
      }
      when 'comment' {
        var newline = doc.text.index_of('\n')

        if strict and newline != -1 {
          return false
        }

        return left - (newline == -1 ? doc.text.length() : newline) >= 0
      }
      when 'whole' {
        stack.append(Cmd(cmd.level, cmd.mode, doc.doc))
      }
    }
  }

  return false
}

/**
 * Lays `document` out as text no wider than `width` where it can be.
 * A line with nowhere to break that would bring it within the width is
 * left as long as it is.
 *
 * @param any document
 * @param ?number width: Defaults to `WIDTH`.
 * @returns string
 */
def render(document, width: ?number) {
  var limit = width == nil ? WIDTH : width
  var out = []
  var column = 0
  var remeasure = false
  var cmds = [Cmd(0, _BREAK, document)]

  while !cmds.is_empty() {
    var cmd = cmds.pop()
    var doc = cmd.doc

    if is_string(doc) {
      if doc != '' {
        out.append(doc)
        column = _advance(column, doc)
      }

      continue
    }

    if is_list(doc) {
      var index = doc.length() - 1

      while index >= 0 {
        cmds.append(Cmd(cmd.level, cmd.mode, doc[index]))
        index -= 1
      }

      continue
    }

    using doc.t {
      when 'line' {
        if cmd.mode == _FLAT and !doc.hard {
          if !doc.soft {
            out.append(' ')
            column += 1
          }

          continue
        }

        # A newline forced inside a layout taken flat means the groups
        # after it start on a fresh line, and have to be measured again
        # rather than inherit a decision made for the line before.
        if cmd.mode == _FLAT {
          remeasure = true
        }

        _trim(out)
        out.append('\n' + INDENT * cmd.level)
        column = cmd.level * INDENT.length()
      }
      when 'group' {
        var width = flat_width(doc)

        if cmd.mode == _FLAT and !remeasure {
          cmds.append(Cmd(cmd.level, width < 0 ? _BREAK : _FLAT, doc.doc))

          continue
        }

        remeasure = false

        var flat = Cmd(cmd.level, _FLAT, doc.doc)

        if width >= 0 and _fits(flat, cmds, column, limit, false) {
          cmds.append(flat)
        } else {
          cmds.append(Cmd(cmd.level, _BREAK, doc.doc))
        }
      }
      when 'first_fit' {
        var layouts = doc.parts

        if cmd.mode == _FLAT and !remeasure {
          cmds.append(Cmd(cmd.level, _FLAT, layouts[0]))

          continue
        }

        remeasure = false

        var chosen = nil
        var index = 0

        while chosen == nil and index < layouts.length() - 1 {
          var layout = layouts[index]
          var whole = is_instance(layout) and layout.t == 'whole'
          var attempt = Cmd(cmd.level, _FLAT, layout)

          if _fits(attempt, cmds, column, limit, whole) {
            chosen = attempt
          }

          index += 1
        }

        cmds.append(
          chosen == nil ? Cmd(cmd.level, _BREAK, layouts.last()) : chosen,
        )
      }
      when 'free' {
        cmds.append(Cmd(cmd.level, _BREAK, doc.doc))
      }
      when 'whole' {
        cmds.append(Cmd(cmd.level, cmd.mode, doc.doc))
      }
      when 'fill' {
        _fill(doc, cmd, cmds, column, limit)
      }
      when 'nest' {
        cmds.append(Cmd(cmd.level + 1, cmd.mode, doc.doc))
      }
      when 'if_break' {
        var chosen = cmd.mode == _BREAK ? doc.doc : doc.other

        cmds.append(Cmd(cmd.level, cmd.mode, chosen))
      }
      when 'choose' {
        var width = flat_width(doc.doc)
        var fits = width >= 0 and column + width <= doc.limit

        if fits {
          cmds.append(Cmd(cmd.level, _FLAT, doc.doc))
        } else {
          cmds.append(Cmd(cmd.level, cmd.mode, doc.other))
        }
      }
      when 'comment' {
        var text = _realign(doc.text, doc.column, column)

        out.append(text)
        column = _advance(column, text)
      }
    }
  }

  _trim(out)

  return ''.join(out)
}

# Lays out the next content of a fill and its separator, and puts the
# rest of the fill back to be laid out after them. A separator breaks
# when the content after it would not fit on the line; content that does
# not fit even on a line of its own is laid out broken. The last content
# is measured with what follows the fill on its line, a trailing comma or
# a closer, which has to fit there too.
def _fill(doc, cmd, cmds: list, column: number, limit: number) {
  var parts = doc.parts
  var at = doc.at
  var count = parts.length() - at

  if count == 0 {
    return
  }

  var level = cmd.level
  var content = parts[at]
  var content_flat = Cmd(level, _FLAT, content)
  var content_broken = Cmd(level, _BREAK, content)
  var content_fits = _fits(
    content_flat,
    count <= 2 ? cmds : [],
    column,
    limit,
    false,
  )

  if count == 1 {
    cmds.append(content_fits ? content_flat : content_broken)

    return
  }

  var separator = parts[at + 1]
  var separator_flat = Cmd(level, _FLAT, separator)
  var separator_broken = Cmd(level, _BREAK, separator)

  if count == 2 {
    if content_fits {
      cmds.append(separator_flat)
      cmds.append(content_flat)
    } else {
      cmds.append(separator_broken)
      cmds.append(content_broken)
    }

    return
  }

  var next = parts[at + 2]
  var pair = Cmd(level, _FLAT, [content, separator, next])
  var pair_fits = _fits(pair, count == 3 ? cmds : [], column, limit, false)
  var rest = fill_from(parts, at + 2)

  cmds.append(Cmd(level, cmd.mode, rest))

  if pair_fits {
    cmds.append(separator_flat)
    cmds.append(content_flat)
  } else if content_fits {
    cmds.append(separator_broken)
    cmds.append(content_flat)
  } else {
    cmds.append(separator_broken)
    cmds.append(content_broken)
  }
}

# A doc block written at `from` and now starting at `to`, its later
# lines moved by the same amount so it keeps its shape. A line indented
# less than the block itself was is left where it is, and a blank one
# stays empty.
def _realign(text: string, from: number, to: number) {
  if from < 0 or from == to or text.index_of('\n') == -1 {
    return text
  }

  var lines = text.split('\n')
  var old_pad = ' ' * from
  var new_pad = ' ' * to
  var index = 1

  while index < lines.length() {
    var line = lines[index]

    if line.trim() == '' {
      lines[index] = ''
    } else if line.starts_with(old_pad) {
      lines[index] = new_pad + line[from,]
    }

    index += 1
  }

  return '\n'.join(lines)
}
