# Tests for the tree layer: grouping atoms by their brackets, telling a
# block apart from a dictionary, and collapsing `name: name` shorthand.

import test { * }

import ..atoms { stream }
import ..tree { parse }

# The groups in a parsed sequence, each as its kind.
def group_kinds(source) {
  return parse(stream(source))
    .filter(@(n) => n.node == 'group')
    .map(@(n) => n.kind)
}

# The first group found anywhere in `nodes`, depth first, or nil.
def first_group(nodes) {
  for node in nodes {
    if node.node == 'group' {
      return node
    }
  }

  return nil
}

# The bare token texts of a group's items, ignoring nested groups.
def token_texts(group) {
  return group.items.filter(@(n) => n.node == 'tok').map(@(n) => n.atom.text)
}

# Every `?` and `:` in `source`, in order, each paired with whether the
# tree read it as part of a conditional. Nested groups are walked, since
# that is where the counting has to start over.
def branch_marks(source) {
  return _marks(parse(stream(source)))
}

def _marks(nodes) {
  var found = []

  for node in nodes {
    if node.node == 'group' {
      found += _marks(node.items)

      continue
    }

    if node.node == 'tok'
      and (node.atom.kind == 'Question' or node.atom.kind == 'Colon') {
      found.append([node.atom.text, node.atom.ternary])
    }
  }

  return found
}

describe('parse', @{
  it('groups a call in parentheses', @{
    expect(group_kinds('f(a, b)')).to_equal(['paren'])
  })

  it('groups a list in brackets', @{
    expect(group_kinds('[1, 2, 3]')).to_equal(['bracket'])
  })

  it('reads a bracket after a name as a subscript', @{
    expect(group_kinds('var x = s[1]')).to_equal(['index'])
  })

  it('reads a bracket after a closer as a subscript', @{
    expect(group_kinds('var x = f()[0]')).to_equal(['paren', 'index'])
    expect(group_kinds("var x = { a: 1 }['a']")).to_equal(['dict', 'index'])
  })

  it('reads a bracket after a string as a subscript', @{
    expect(group_kinds("var x = 'hi'[0]")).to_equal(['index'])
  })

  it('reads a bracket opening a line as a list', @{
    expect(group_kinds('var x = y\n[1, 2]')).to_equal(['bracket'])
  })

  it('reads a bracket after an operator or comma as a list', @{
    expect(group_kinds('var x = [1]')).to_equal(['bracket'])
    expect(group_kinds('return [1]')).to_equal(['bracket'])

    var call = first_group(parse(stream('f(a, [1])')))

    expect(first_group(call.items).kind).to_be('bracket')
  })

  it('reads a brace after `=` as a dictionary', @{
    expect(group_kinds('var d = { a: 1 }')).to_equal(['dict'])
  })

  it('reads a brace opening a body as a block', @{
    expect(group_kinds('def f() {\n  return 1\n}')).to_contain('block')
  })

  it('reads a leading brace inside a call as a dictionary', @{
    var call = first_group(parse(stream('each({ a: 1 })')))

    expect(call.kind).to_be('paren')
    expect(first_group(call.items).kind).to_be('dict')
  })

  it('reads an import member list as a dictionary group', @{
    expect(group_kinds('import test { describe, it }')).to_equal(['dict'])
  })
})

describe('shorthand', @{
  it('collapses `name: name` inside a dictionary', @{
    var dict = first_group(parse(stream('var d = { name: name, age: 42 }')))

    expect(token_texts(dict)).to_equal(['name', ',', 'age', ':', '42'])
  })

  it('leaves `x: x + 1` alone', @{
    var dict = first_group(parse(stream('var d = { x: x + 1 }')))

    expect(token_texts(dict)).to_equal(['x', ':', 'x', '+', '1'])
  })
})

describe('branches', @{
  it('marks the `?` and `:` of a conditional', @{
    expect(branch_marks('var s = a ? b : c')).to_equal([
      ['?', true],
      [':', true],
    ])
  })

  it('leaves the `?` of an optional type unmarked', @{
    expect(branch_marks('def f(a: ?string) {')).to_equal([
      [':', false],
      ['?', false],
    ])
  })

  it('leaves the `:` of a dictionary key unmarked', @{
    expect(branch_marks('var d = { k: a ? b : c, j: 2 }')).to_equal([
      [':', false],
      ['?', true],
      [':', true],
      [':', false],
    ])
  })

  # A branch is a bracket depth of its own, so a dictionary written
  # inside one starts the count over rather than spending the `:` that
  # still has to close the branch.
  it('starts the count over inside a branch of its own', @{
    expect(branch_marks('var d = a ? { k: 1 } : { k: 2 }')).to_equal([
      ['?', true],
      [':', false],
      [':', true],
      [':', false],
    ])
  })

  it('pairs a conditional nested in another', @{
    expect(branch_marks('var s = a ? b ? 1 : 2 : 3')).to_equal([
      ['?', true],
      ['?', true],
      [':', true],
      [':', true],
    ])
  })
})
