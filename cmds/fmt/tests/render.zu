# Tests for one-line rendering: the spacing rules that decide where a
# space goes between two tokens and where none does.

import test { * }

import ..atoms { stream }
import ..tree { parse }
import ..render { flat }

# The one-line rendering of a snippet.
def line(source) {
  return flat(parse(stream(source)), false)
}

describe('flat', @{
  it('spaces binary operators and follows commas', @{
    expect(line('var x=f(a,b)+1')).to_be('var x = f(a, b) + 1')
  })

  it('keeps a call tight against its name', @{
    expect(line('f (a)')).to_be('f(a)')
  })

  it('keeps no space around a dot', @{
    expect(line('a . b . c')).to_be('a.b.c')
  })

  it('treats a leading `-` as unary', @{
    expect(line('var x = -1')).to_be('var x = -1')
  })

  it('treats a `-` opening a group as unary', @{
    expect(line('var x = f(-1)')).to_be('var x = f(-1)')
    expect(line('var x = a[-1]')).to_be('var x = a[-1]')
    expect(line('var x = (-1)')).to_be('var x = (-1)')
    expect(line('var x = [-1, -2]')).to_be('var x = [-1, -2]')
  })

  # `a + -b` has a sign and an operator side by side. Each has to be
  # judged by what sits to its own left, not by what the other one is.
  it('tells a sign after an operator from the operator', @{
    expect(line('var x = -a + -b')).to_be('var x = -a + -b')
    expect(line('var x = a - -b')).to_be('var x = a - -b')
    expect(line('var x = 3 * -2')).to_be('var x = 3 * -2')
    expect(line('var x = a - 1')).to_be('var x = a - 1')
  })

  it('stands a comment off from whatever it trails', @{
    expect(line('i++ # skip')).to_be('i++ # skip')
    expect(line('i-- # back')).to_be('i-- # back')
    expect(line('f() # done')).to_be('f() # done')
  })

  it('treats `-` between values as binary', @{
    expect(line('var x = a - 1')).to_be('var x = a - 1')
  })

  it('joins a type union with no spaces around the bar', @{
    expect(line('def f(x: ?list|dict) {\n}')).to_be('def f(x: ?list|dict) {}')
  })

  it('keeps the space in a relative import', @{
    expect(line('import .sibling')).to_be('import .sibling')
  })

  it('keeps the space in a parent import', @{
    expect(line('import ..sibling')).to_be('import ..sibling')
  })

  # `iter;` reads as a statement that went wrong. The space is the only
  # thing showing the first clause is deliberately empty.
  it('keeps the space before an empty iter clause', @{
    expect(line('iter ; i < n; i++')).to_be('iter ; i < n; i++')
    expect(line('iter var i = 0; i < n; i++')).to_be('iter var i = 0; i < n; i++')
  })

  it('spaces a ternary across its `?` and `:`', @{
    expect(line('var s = big ? one : two')).to_be('var s = big ? one : two')
    expect(line('var s = a ? b ? 1 : 2 : 3')).to_be('var s = a ? b ? 1 : 2 : 3')
  })

  # `?` and `:` each spell two things, and a branch of a conditional can
  # hold either of the other two: a dictionary key, or an optional type.
  it('tells a conditional from an optional type and a dictionary key', @{
    expect(line('def f(a: ?string, b: ?int)')).to_be(
      'def f(a: ?string, b: ?int)'
    )
    expect(line('var d = { k: a ? b : c, j: 2 }')).to_be(
      'var d = { k: a ? b : c, j: 2 }'
    )
    expect(line('var d = a ? { k: 1 } : { k: 2 }')).to_be(
      'var d = a ? { k: 1 } : { k: 2 }'
    )
    expect(line('var x: ?int = a ? b : c')).to_be('var x: ?int = a ? b : c')
  })

  it('applies the shorthand rewrite inside a dictionary', @{
    expect(line('var d={name:name,age:42}')).to_be('var d = { name, age: 42 }')
  })
})
