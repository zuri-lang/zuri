# Tests for the printer: when a group stays on one line, which layout a
# first_fit takes, how a fill packs its parts, and where each line is
# indented.

import test { * }

import ..doc { * }
import ..printer { render }

# A call's argument list laid out the way the formatter lays one out:
# on one line, or one argument to a line with a trailing comma.
def call(name, args: list) {
  var parts = [SOFTLINE]
  var index = 0

  for arg in args {
    if index > 0 {
      parts.append(LINE)
    }

    parts.append(index < args.length() - 1 ? [arg, ','] : arg)
    index += 1
  }

  return [
    name,
    group([
      '(',
      nest([parts, if_break(',', '')]),
      SOFTLINE,
      ')',
    ]),
  ]
}

# A block, the way a function's body is laid out.
def block(statement) {
  return broken_group([
    '@{',
    nest([HARDLINE, statement]),
    HARDLINE,
    '}',
  ])
}

describe('groups', @{
  it('keeps a group that fits on one line', @{
    expect(render(call('f', ['a', 'b']), 80)).to_be('f(a, b)')
  })

  it('breaks a group that does not fit, and only then adds the if_break', @{
    expect(render(call('f', ['alpha', 'beta', 'gamma']), 18))
        .to_be('f(\n  alpha,\n  beta,\n  gamma,\n)')
  })

  it('counts what follows a group on its line when deciding', @{
    var doc = [
      call('f', ['a', 'b']),
      ' + a_long_tail',
    ]

    expect(render(doc, 12)).to_be('f(\n  a,\n  b,\n) + a_long_tail')
  })

  # A group holding a block can never sit on one line, so it breaks
  # whatever the width.
  it('breaks a group that holds a block', @{
    expect(render(call('each', ['items', block('work()')]), 80))
        .to_be('each(\n  items,\n  @{\n    work()\n  },\n)')
  })

  it('never lays a broken group out on one line', @{
    expect(render(broken_group(['a', LINE, 'b']), 80)).to_be('a\nb')
  })
})

describe('first_fit', @{
  # The layouts of `each(items, @{ work() })`: the block opening out on
  # its own, or every argument on a line of its own.
  def layouts() {
    var hugged = ['each(items, ', block('work()'), ')']

    return first_fit([
      hugged,
      call('each', ['items', block('work()')]),
    ])
  }

  # A block opens on lines of its own whatever the layout around it, so
  # a layout only has to fit as far as the brace.
  it('takes the first layout whose opening line fits', @{
    expect(render(layouts(), 20)).to_be('each(items, @{\n  work()\n})')
  })

  it('takes the last layout when none fits', @{
    expect(render(layouts(), 12))
        .to_be('each(\n  items,\n  @{\n    work()\n  },\n)')
  })

  it('lays a free part out on its own inside a layout taken flat', @{
    var doc = first_fit([
      [
        'x.f',
        free(call('', ['alpha', 'beta'])),
      ],
      broken_group([
        'x',
        nest(nest([SOFTLINE, '.f(alpha, beta)'])),
      ]),
    ])

    expect(render(doc, 10)).to_be('x.f(\n  alpha,\n  beta,\n)')
  })

  # A layout marked whole is only worth having when nothing in it has to
  # break any further.
  it('takes a whole layout only when every one of its lines fits', @{
    def doc(name) {
      var chain = broken_group(nest(nest([SOFTLINE, name])))

      return first_fit([
        whole(['head', chain]),
        [
          'head',
          free(call('.f', ['a'])),
        ],
      ])
    }

    expect(render(doc('.go()'), 10)).to_be('head\n    .go()')
    expect(render(doc('.a_long_name()'), 10)).to_be('head.f(a)')
  })
})

describe('fills', @{
  it('packs as many parts on a line as fit', @{
    var parts = ['aaa,', LINE, 'bbb,', LINE, 'ccc,', LINE, 'ddd']

    expect(render(fill(parts), 9)).to_be('aaa, bbb,\nccc, ddd')
  })

  it('always breaks at a separator that always breaks', @{
    expect(render(fill(['a', HARDLINE, 'b', LINE, 'c']), 80)).to_be('a\nb c')
  })

  # The last part shares its line with whatever follows the fill, a
  # trailing comma or a closer, and has to fit along with it.
  it('measures its last part with what follows it on the line', @{
    var doc = [
      fill(['aaaa', LINE, 'bbbb']),
      ',)',
    ]

    expect(render(doc, 10)).to_be('aaaa\nbbbb,)')
  })
})

describe('indentation', @{
  it('nests one level past what holds it', @{
    var doc = [
      'a {',
      nest([
        HARDLINE,
        'b',
        nest([HARDLINE, 'c']),
      ]),
      HARDLINE,
      '}',
    ]

    expect(render(doc, 80)).to_be('a {\n  b\n    c\n}')
  })

  it('continues an expression two levels in', @{
    var doc = [
      'x = ',
      group(continued(['alpha +', LINE, 'beta'])),
    ]

    expect(render(doc, 10)).to_be('x = alpha +\n    beta')
  })

  it('leaves no spaces at the end of a line or on an empty one', @{
    expect(render(['a ', HARDLINE, HARDLINE, 'b'], 80)).to_be('a\n\nb')
  })
})

describe('choices and comments', @{
  it('takes the first choice while it fits within its limit', @{
    var doc = [
      'when 1',
      choose(12, ' a()', [
        ' {',
        nest([HARDLINE, 'a()']),
        HARDLINE,
        '}',
      ]),
    ]

    expect(render(doc, 80)).to_be('when 1 a()')
  })

  it('takes the second choice past its limit, whatever the width', @{
    var doc = [
      'when 1',
      choose(8, ' a()', [
        ' {',
        nest([HARDLINE, 'a()']),
        HARDLINE,
        '}',
      ]),
    ]

    expect(render(doc, 80)).to_be('when 1 {\n  a()\n}')
  })

  it('moves a doc block along with its first line', @{
    var doc = ['  ', comment('/**\n * text\n */', 0)]

    expect(render(doc, 80)).to_be('  /**\n   * text\n   */')
  })

  it('leaves a doc block line indented less than the block alone', @{
    var doc = comment('/**\nflush left\n   */', 2)

    expect(render(doc, 80)).to_be('/**\nflush left\n */')
  })
})
