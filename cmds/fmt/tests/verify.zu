# Tests for the check that formatting changed nothing but layout: two
# sources are one program when their trees match, positions aside, and
# their comments are the same in the same order.

import test { * }

import zuri

import ..verify { difference }

def compare(a, b) {
  return difference(zuri.parse(a), zuri.parse(b))
}

describe('difference', @{
  it('ignores where code sits and how it is spaced', @{
    expect(compare('var x=f(a,b)', 'var x = f(\n  a,\n  b,\n)')).to_be_nil()
  })

  it('tells two programs apart', @{
    expect(compare('var x = a - b', 'var x = a\n-b')).to_be('code')
    expect(compare('echo s[1]', 'echo s[1,]')).to_be('code')
    expect(compare('var x = 1', 'var x = 1.5')).to_be('code')
  })

  it('reads the dictionary shorthand as the entry it stands for', @{
    expect(compare('var d = {\n  name: name,\n}', 'var d = { name }'))
        .to_be_nil()
  })

  it('reads a braced single statement as that statement in a body', @{
    expect(compare('if a b()', 'if a {\n  b()\n}')).to_be_nil()
    expect(compare('while a b()', 'while a {\n  b()\n}')).to_be_nil()
  })

  # Braces give a declaration a scope of its own, so a braced `var` is a
  # different program from an unbraced one.
  it('never reads a braced declaration as an unbraced one', @{
    expect(compare('if a var b = 1', 'if a {\n  var b = 1\n}')).to_be('code')
  })
})

describe('comments', @{
  it('finds every comment, wherever the parser placed it', @{
    var source = '# one\ndef f() {\n  g(a, # two\n    b)\n  # three\n}'

    expect(compare(source, source)).to_be_nil()
    expect(compare(source, source.replace('# two', '# 2'))).to_be('comments')
  })

  it('notices a comment lost or moved past another', @{
    expect(compare('a() # x\nb() # y', 'a()\nb() # y')).to_be('comments')
    expect(compare('a() # x\nb() # y', 'a() # y\nb() # x')).to_be('comments')
  })

  it('counts the comments of a body it reads as unbraced', @{
    expect(compare('if a # c\n  b()', 'if a { # c\n  b()\n}')).to_be_nil()
  })

  it('ignores the indent of a doc block and the end of a comment', @{
    var before = '/**\n * x\n */\na() # c   '
    var after = '  /**\n     * x\n     */\na() # c'

    expect(compare(before, after)).to_be_nil()
  })
})
