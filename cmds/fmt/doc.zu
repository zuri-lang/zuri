/**
 * @module fmt.doc
 *
 * The layout document the formatter builds from a parse tree and the
 * printer turns into text. A document says what the text is and where
 * it may break, and leaves the printer to decide which of those breaks
 * the width calls for.
 *
 * A plain string is text and a list is its parts in order. Everything
 * else is a {Doc} tagged by `t`:
 *
 * - `line`: a place to break. While its group stays on one line it is a
 *   space, or nothing when `soft`; once the group breaks it is a
 *   newline, and it always is when `hard`.
 * - `group`: laid out on one line when it fits, otherwise broken as a
 *   whole. A group holding a line that always breaks is always broken,
 *   and so is one made `broken`.
 * - `first_fit`: several layouts of the same code, the first whose
 *   opening line fits taken, and the last when none does.
 * - `whole`: a layout of a `first_fit` taken only when all of its lines
 *   fit.
 * - `free`: what it holds decides its own breaks, even inside a layout
 *   taken on one line.
 * - `fill`: parts and separators in turn, each separator breaking only
 *   when what follows it does not fit.
 * - `nest`: lines inside sit one level past those of what holds it.
 * - `if_break`: one document when its group breaks, another when not.
 * - `choose`: the first document when it fits on one line within a
 *   column limit, otherwise the second.
 * - `comment`: a doc block, its later lines moved along with its first.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

/**
 * One piece of a layout document that is neither text nor a list of
 * parts. Every kind is the same class, told apart by `t`, and uses the
 * fields its kind needs: `doc` for what a group, a nest or a branch
 * holds, `other` for the second branch of an `if_break` or a `choose`,
 * `parts` for the layouts of a `first_fit` and the parts of a fill, `at`
 * for a fill, `soft` and `hard` for a line, `broken` for a group, `limit`
 * for a `choose`, and `text` and `column` for a doc block.
 *
 * Build one with the functions below rather than by hand.
 */
class Doc {
  var t = ''
  var doc = nil
  var other = nil
  var parts = nil
  var at = 0
  var broken = false
  var soft = false
  var hard = false
  var limit = 0
  var text = ''
  var column = 0

  /**
   * The width `flat_width()` found for a group or a `first_fit`, kept
   * so that each is measured once however often it is asked.
   *
   * @type ?number
   */
  var width = nil

  /**
   * @param string t: The kind, one of those listed for this module.
   */
  @new(t: string) {
    self.t = t
  }
}

# A line of the given sort.
def _line(soft: bool, hard: bool) {
  var line = Doc('line')

  line.soft = soft
  line.hard = hard

  return line
}

# A document of kind `t` holding `contents`.
def _holding(t: string, contents) {
  var held = Doc(t)

  held.doc = contents

  return held
}

/**
 * A space on one line, a newline once the group holding it breaks.
 */
var LINE = _line(false, false)

/**
 * Nothing on one line, a newline once the group holding it breaks.
 */
var SOFTLINE = _line(true, false)

/**
 * A newline, always.
 */
var HARDLINE = _line(false, true)

/**
 * An empty line followed by a newline, for a blank line kept between two
 * lines of code.
 */
var BLANKLINE = [HARDLINE, HARDLINE]

/**
 * Lays `contents` out on one line when it fits in what is left of the
 * line, and breaks every line in it otherwise.
 *
 * @param any contents
 * @returns Doc
 */
def group(contents) {
  return _holding('group', contents)
}

/**
 * A group that is always broken.
 *
 * @param any contents
 * @returns Doc
 */
def broken_group(contents) {
  var held = _holding('group', contents)

  held.broken = true

  return held
}

/**
 * `contents` with the last group it holds at its top level broken, the
 * group itself and not the ones inside it: the items of a list opened
 * out under its `[` rather than the whole list kept on one line. Of a
 * `first_fit`, its last layout is taken. Anything holding no group is
 * left as it is.
 *
 * @param any contents
 * @returns any
 */
def expanded(contents) {
  var opened = _opened(contents)

  return opened == nil ? contents : opened
}

# What `expanded()` gives for `contents`, or `nil` when it holds no
# group to break.
def _opened(contents) {
  if is_list(contents) {
    var index = contents.length() - 1

    while index >= 0 {
      var opened = _opened(contents[index])

      if opened != nil {
        var copy = contents[,]

        copy[index] = opened

        return copy
      }

      index -= 1
    }

    return nil
  }

  if !is_instance(contents) {
    return nil
  }

  using contents.t {
    when 'group' return broken_group(contents.doc)
    when 'first_fit' return contents.parts.last()
  }

  return nil
}

/**
 * Several layouts of the same code, most compact first. The printer
 * takes the first whose opening line fits, up to its first line break,
 * and the last when none does. Every layout but the last is laid out
 * on one line apart from the groups it breaks itself, so a break any of
 * them offers has to be in a broken group or a `free` part.
 *
 * @param list layouts
 * @returns Doc
 */
def first_fit(layouts: list) {
  if layouts.length() == 1 {
    return layouts[0]
  }

  var choice = Doc('first_fit')

  choice.parts = layouts

  return choice
}

/**
 * A layout of a `first_fit` taken only when every one of its lines
 * fits, not just its first, with each group in it laid out flat. It is
 * for a layout that is only worth having when nothing in it has to
 * break any further.
 *
 * @param any contents
 * @returns Doc
 */
def whole(contents) {
  return _holding('whole', contents)
}

/**
 * `contents` deciding its own breaks inside a layout otherwise laid out
 * on one line, the way the arguments of the last call in a chain open
 * out while the chain itself stays on its line.
 *
 * @param any contents
 * @returns Doc
 */
def free(contents) {
  return _holding('free', contents)
}

/**
 * Separators that each break on their own. `parts` alternates content
 * and separator, starting and ending with content; a separator breaks
 * only when the content after it does not fit on the line.
 *
 * @param list parts
 * @returns Doc
 */
def fill(parts: list) {
  return fill_from(parts, 0)
}

/**
 * What is left of a fill from the part at `at` on.
 *
 * @param list parts
 * @param number at
 * @returns Doc
 */
def fill_from(parts: list, at: number) {
  var rest = Doc('fill')

  rest.parts = parts
  rest.at = at

  return rest
}

/**
 * Lines inside sit one level past those of what holds this, the way a
 * block's body sits one level past the statement that owns it.
 *
 * @param any contents
 * @returns Doc
 */
def nest(contents) {
  return _holding('nest', contents)
}

/**
 * Lines inside sit two levels past those of what holds this, the indent
 * of an expression continued onto another line.
 *
 * @param any contents
 * @returns Doc
 */
def continued(contents) {
  return nest(nest(contents))
}

/**
 * `broken` when the group around it breaks, `flat` when it does not.
 *
 * @param any broken
 * @param any flat
 * @returns Doc
 */
def if_break(broken, flat) {
  var branches = _holding('if_break', broken)

  branches.other = flat

  return branches
}

/**
 * `first` when it fits on one line ending at or before column `limit`,
 * otherwise `second`.
 *
 * @param number limit
 * @param any first
 * @param any second
 * @returns Doc
 */
def choose(limit: number, first, second) {
  var choice = _holding('choose', first)

  choice.other = second
  choice.limit = limit

  return choice
}

/**
 * A doc block spread over several lines, written in the source with its
 * opening `/` at `column` (counted from 0). Its later lines move by as
 * much as its first does, so the block keeps its shape at a new indent.
 *
 * @param string text
 * @param number column
 * @returns Doc
 */
def comment(text: string, column: number) {
  var block = Doc('comment')

  block.text = text
  block.column = column

  return block
}

/**
 * The width of `contents` laid out on one line, or `-1` when it cannot
 * be: it holds a line that always breaks, a broken group, or text that
 * spans lines.
 *
 * @param any contents
 * @returns number
 */
def flat_width(contents) {
  if is_string(contents) {
    return contents.index_of('\n') == -1 ? contents.length() : -1
  }

  if is_list(contents) {
    var total = 0

    for part in contents {
      var width = flat_width(part)

      if width < 0 {
        return -1
      }

      total += width
    }

    return total
  }

  using contents.t {
    when 'line' {
      if contents.hard {
        return -1
      }

      return contents.soft ? 0 : 1
    }
    when 'group' {
      if contents.width == nil {
        contents.width = contents.broken ? -1 : flat_width(contents.doc)
      }

      return contents.width
    }
    when 'first_fit' {
      if contents.width == nil {
        contents.width = flat_width(contents.parts[0])
      }

      return contents.width
    }
    when 'fill' {
      return flat_width(contents.parts[contents.at,])
    }
    when 'if_break' return flat_width(contents.other)
    when 'choose' return flat_width(contents.doc)
    when 'comment' return -1
  }

  return flat_width(contents.doc)
}
