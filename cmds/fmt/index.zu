/**
 * @command fmt
 * @description Formats all Zuri files in the given path, or the 
 *    current directory.
 * 
 * The `fmt` command formats all Zuri files in the given path, or 
 * the current directory.
 *
 *   zuri fmt [path]
 *
 * `path` is either a single `.zu` file, which is formatted in place, or
 * a directory, in which case every `.zu` file inside it is formatted,
 * subdirectories included. If no path is given, the current directory is
 * formatted. The `--dry-run` flag shows what would change without
 * writing anything, which is what a commit hook or a CI job wants.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import args
import os
import os.process { exit }

import .engine

# Every `.zu` file `path` points at: the one file, or every file under
# the directory, deepest included, in a stable order.
def _targets(path: string) {
  if os.is_dir(path) {
    var found = []

    for name in os.read_dir(path, true) {
      if name.ends_with('.zu') {
        found.append(os.join_paths(path, name))
      }
    }

    return found.sort()
  }

  return [path]
}

# Formats one file. Returns `'unchanged'`, `'changed'` (written, unless
# checking), or `'would-change'` when checking. Raises through on a
# `FormatError`, which the caller turns into a skip.
def _apply(path: string, dry_run: bool) {
  var handle = file(path, 'r')
  var source = handle.read()

  handle.close()

  var formatted = engine.format(source)

  if formatted == source {
    return 'unchanged'
  }

  if dry_run {
    return 'would-change'
  }

  var out = file(path, 'w')

  out.write(formatted)
  out.close()

  return 'changed'
}

# `3 files`, or `1 file` when there is only the one of them.
def _count(number: int, noun: string) {
  return '${number} ${noun}${number == 1 ? "" : "s"}'
}

# What became of the files that were not rewritten. Left as its own
# sentence so the counts read as English rather than as a tally.
def _rest(unchanged: int, skipped: int) {
  var said = []

  if unchanged > 0 {
    var verb = unchanged == 1 ? 'was' : 'were'

    said.append('${_count(unchanged, "file")} ${verb} already formatted')
  }

  if skipped > 0 {
    var verb = skipped == 1 ? 'was' : 'were'

    said.append('${_count(skipped, "file")} ${verb} skipped')
  }

  return ' and '.join(said)
}

# The closing line. Counts on their own read as machine output, and
# this is the line a reader actually stops on.
def _summary(changed: int, unchanged: int, skipped: int, dry_run: bool) {
  if changed + unchanged + skipped == 0 {
    return 'There is no Zuri source here to format.'
  }

  var lead = 'Nothing to do.'

  if changed > 0 {
    if dry_run {
      lead = '${_count(changed, "file")} would change.'
    } else {
      lead = 'Formatted ${_count(changed, "file")}.'
    }
  } else if dry_run {
    lead = 'Nothing would change.'
  }

  # Nothing to rewrite and nothing to skip is the everyday case, and
  # it deserves the sentence that says so outright.
  if changed == 0 and skipped == 0 {
    if unchanged == 1 {
      return '${lead} The only file here is already formatted.'
    }

    return '${lead} All ${unchanged} files are already formatted.'
  }

  var rest = _rest(unchanged, skipped)

  return rest.is_empty() ? lead : '${lead} ${rest}.'
}

def main() {
  var parser = args.Parser('fmt', false)

  parser.description = 'Formats all Zuri files in the given path, or the current directory.'
  parser.epilog = 'If no path is given, all Zuri files in the current directory are formatted.'
  parser.add_index(
    'path', 'A .zu file, or a directory to format, subdirectories included'
  )
  parser.add_option(
    'dry-run', 'Show what would change without writing anything',
    { short_name: 'n' },
  )

  var parsed = parser.parse()
  var path = parsed.indexes.is_empty() ? os.cwd() : parsed.indexes[0]
  var dry_run = parsed.options.get('dry-run', false)

  if !os.is_dir(path) and !file(path).exists() {
    echo 'fmt: there is no file or directory at ${path}'

    exit(1)
  }

  var changed = 0
  var unchanged = 0
  var skipped = 0

  for target in _targets(path) {
    catch {
      var outcome = _apply(target, dry_run)

      if outcome == 'unchanged' {
        unchanged += 1
      } else {
        changed += 1

        echo dry_run ? 'would format ${target}' : 'formatted ${target}'
      }
    } as error {
      skipped += 1

      echo 'skipped ${target}: ${error.message}'
    }
  }

  echo _summary(changed, unchanged, skipped, dry_run)

  # In dry_run mode a would-be change is a non-zero exit, so a hook fails.
  if dry_run and changed > 0 {
    exit(1)
  }
}

main()
