/**
 * @module fmt.engine
 *
 * The engine `zuri fmt` runs. `format()` takes a source string and
 * returns the same program laid out in the project's style: two spaces
 * to a level, one statement to a line, explicit blocks, spacing the way
 * a reader expects it, and lines too long for the width broken where
 * the expression holds together least, following the Dart formatter's
 * rules. Where the source broke a line inside an expression makes no
 * difference.
 *
 * It works from the program's parse tree, so it knows what every piece
 * of code is rather than guessing from the characters around it, and
 * only ever breaks a line where the parser accepts a break.
 *
 * It never changes what a program does. Before returning, it parses its
 * own result and checks that the tree is the one it started from and
 * that every comment is still there, in order. A `FormatError` is
 * raised rather than handing back anything else, so the command can
 * leave that file as it was.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import zuri

import .source { Source }
import .layout { Layout }
import .printer { render }
import .verify

/**
 * Raised when a source cannot be formatted: it does not parse, or
 * formatting it would have changed more than its layout. The second
 * means a fault in the formatter rather than in the source, and either
 * way the source should be left as it was.
 */
class FormatError < Error {}

# Parses `source`, raising a `FormatError` that says `problem` and where
# when it has a syntax error.
def _parse(source: string, problem: string) {
  var parsed = zuri.parse_partial(source)

  if !parsed.is_clean() {
    raise FormatError('${problem}: ${parsed.errors[0].to_string()}')
  }

  return parsed.nodes
}

/**
 * Formats `source`, returning the laid-out program with a single
 * trailing newline. An empty source, or one holding only blank lines,
 * gives back an empty string.
 *
 * @param string source
 * @returns string
 * @throws FormatError if `source` does not parse, or if formatting it
 *    would have changed its tree or its comments.
 */
def format(source: string) {
  var nodes = _parse(source, 'it does not parse')
  var document = nil

  catch {
    document = Layout(Source(source)).program(nodes)
  } as error {
    raise FormatError('it could not be laid out: ${error.message}')
  }

  var result = render(document)

  if result != '' {
    result += '\n'
  }

  var formatted = _parse(
    result,
    'formatting would have produced code that no longer parses',
  )

  var difference = verify.difference(nodes, formatted)

  if difference == 'code' {
    raise FormatError(
      'formatting would have changed the code, not just its layout',
    )
  }

  if difference == 'comments' {
    raise FormatError('formatting would have moved or changed a comment')
  }

  return result
}

/**
 * Reads `path`, formats it, and returns the result. Does not write
 * anything back.
 *
 * @param string path
 * @returns string
 * @throws FormatError as `format()` does.
 */
def format_file(path: string) {
  var handle = file(path, 'r')
  var source = handle.read()

  handle.close()

  return format(source)
}
