/**
 * @module fmt.layout
 *
 * Builds the layout document for a parsed program: what each statement,
 * declaration and expression prints as, and every place it may break.
 *
 * The rules follow the Dart formatter's. A list of arguments, items or
 * parameters stays on one line when it fits; otherwise it opens out one
 * item to a line with a trailing comma, unless a single function or
 * collection among the arguments can open out on its own while the rest
 * stay on the line. An operator chain breaks after every operator of
 * one precedence, a conditional before its `?` and `:`, a method chain
 * before every call, and each continued line sits two levels past the
 * one it continues. The layout depends only on the code: where the
 * source broke its lines does not matter, apart from the blank lines
 * kept between statements and between items, and the rows of a
 * collection holding a `#` comment.
 *
 * The document is built in source order, which is what lets every
 * comment be placed where it was written: each piece of code takes the
 * comments that came before it.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import .doc { * }

# How wide a `when` or `default` arm may run on one line before its
# body is braced instead.
var _ARM_WIDTH = 60

# Statements that declare a name. Braces around one would give it a
# scope of its own, so an unbraced body that declares stays unbraced.
var _DECLARING = ['Var', 'VarList', 'Decl', 'Function']

# Node kinds that are written exactly as the source has them.
var _LEAVES = [
  'Nil',
  'Bool',
  'Integer',
  'Float',
  'BigNumber',
  'Literal',
  'Interpolation',
  'Identifier',
  'Self',
  'Parent',
]

# The kinds of number literal.
var _NUMBERS = ['Integer', 'Float', 'BigNumber']

# The links of a chain of calls and reads on one value.
var _LINKS = ['Call', 'Get', 'Index', 'Slice']

# The two quotes a string, or a dictionary key written as one, opens with.
var _QUOTES = ['\'', '"']

# Every node but the comments, which are placed from the source instead.
def _code(nodes: list) {
  return nodes.filter(
    @(node) => node.kind != 'Comment' and node.kind != 'DocBlock',
  )
}

# Whether `node` is a `nil` the source left out, as after a bare
# `return`: it has no text at all.
def _implicit(node) {
  return node.start == node.end
}

# Whether `node` is a number literal, signed or not.
def _number(node) {
  if node.kind == 'Unary' and node.fields.op == 'Minus' {
    return _NUMBERS.contains(node.fields.operand.kind)
  }

  return _NUMBERS.contains(node.kind)
}

# Whether `node` is a list or dictionary literal with something in it.
def _collection(node) {
  using node.kind {
    when 'List' return !node.fields.items.is_empty()
    when 'Dict' return !node.fields.keys.is_empty()
  }

  return false
}

# Whether `node` holds a list or dictionary with something in it,
# anywhere inside it, however deep and whatever lies in between.
def _holds_collection(node) {
  if is_list(node) {
    return node.some(_holds_collection)
  }

  if !is_instance(node) {
    return false
  }

  if _collection(node) {
    return true
  }

  for name in node.fields.keys() {
    if _holds_collection(node.fields[name]) {
      return true
    }
  }

  return false
}

# Whether `node` is a call or a collection holding exactly one argument
# or item.
def _single(node) {
  using node.kind {
    when 'Call' return node.fields.arguments.length() == 1
    when 'List' return node.fields.items.length() == 1
    when 'Dict' return node.fields.keys.length() == 1
  }

  return false
}

# Whether `node` is a collection or a call with something in its
# brackets, which can open out like a block.
def _opens_out(node) {
  if node.kind == 'Call' {
    return !node.fields.arguments.is_empty()
  }

  return _collection(node)
}

# Whether `name` reads as a class name, starting with a capital letter.
def _capitalized(name: string) {
  return name != '' and name[0].is_upper()
}

# How tightly an operator binds, loosest first. Operators of one level
# are laid out as one run; `0` is anything that is not an operator.
def _level(node) {
  using node.kind {
    when 'Circuit' return node.fields.op == 'Or' ? 1 : 2
    when 'Logical' return 3
    when 'Binary' {
      using node.fields.op {
        when 'EqualEq', 'BangEq' return 3
        when 'Bar' return 4
        when 'Xor' return 5
        when 'Amp' return 6
        when 'Lshift', 'Rshift', 'Urshift' return 7
        when 'Plus', 'Minus' return 8
        when 'Multiply', 'Divide', 'Floor', 'Percent' {
          return 9
        }
        when 'Pow' return 10
      }
    }
  }

  return 0
}

# The operands of a run of operators of one level, left to right.
# `a + b - c` is one run of three; `**` groups to the right and is never
# a run of more than two.
def _operands(node) {
  var level = _level(node)
  var backwards = []
  var current = node

  while current.kind == node.kind and _level(current) == level {
    backwards.append(current.fields.right)
    current = current.fields.left

    if level == 10 {
      break
    }
  }

  backwards.append(current)

  return backwards.reverse()
}

# One call or property read in a chain: the comments before its `.`,
# its `.name`, the arguments when it is a call, and the subscripts and
# calls that follow it before the next `.`. `kind` is `property`,
# `empty` for a call with no arguments, `call` for one with some, or
# `block` for one whose arguments include a function or collection that
# opens out on its own.
class _Link {
  var lead = nil
  var name = nil
  var arguments = nil
  var after = nil
  var kind = 'property'

  @new(lead, name) {
    self.lead = lead
    self.name = name
    self.after = []
  }

  # Whether its arguments can break.
  splits() {
    return self.kind == 'call' or self.kind == 'block'
  }

  # The link as it prints after its comments, with its arguments
  # deciding their own breaks when `free_arguments`.
  doc(free_arguments: bool) {
    if self.arguments == nil {
      return [self.name, self.after]
    }

    var arguments = free_arguments ? free(self.arguments) : self.arguments

    return [self.name, arguments, self.after]
  }
}

/**
 * Builds layout documents for one source.
 */
class Layout {
  /**
   * @param Source source: The source being laid out, with its tokens.
   */
  @new(source) {
    self.src = source
  }

  /**
   * The document for a whole program.
   *
   * @param list nodes: Its top-level nodes, from `zuri.parse()`.
   * @returns any
   */
  program(nodes: list) {
    return self._sequence(_code(nodes), self.src.text.length(), true)
  }

  # Comments

  # A comment as it prints. A `#` comment loses any space it trailed
  # off with; a doc block that opens a line of its own moves its later
  # lines along with its first.
  _comment(token, own_line: bool) {
    if token.kind == 'Comment' {
      return token.text.rtrim()
    }

    if own_line and token.text.index_of('\n') != -1 {
      return comment(token.text, token.column - 1)
    }

    return token.text
  }

  # The comments of a gap, each where it was written: one sharing the
  # line with the code before it at the end of that line, and one the
  # source gave a line of its own on a line of its own. Gives
  # `[doc, ends]`, where `ends` is whether the last comment ends its
  # line, as a `#` comment always does.
  _comments(gap) {
    var out = []

    for entry in gap.comments {
      if entry.before == 0 {
        out.append([' ', self._comment(entry.token, false)])
      } else {
        out.append(entry.before >= 2 ? BLANKLINE : HARDLINE)
        out.append(self._comment(entry.token, true))
      }
    }

    if gap.comments.is_empty() {
      return [out, false]
    }

    var last = gap.comments.last().token

    return [out, last.kind == 'Comment' or gap.after > 0]
  }

  # A gap where the layout may break: its comments, then `otherwise`,
  # or a line break when the last comment ends its line, with a blank
  # line after it kept.
  _break(gap, otherwise) {
    if gap.comments.is_empty() {
      return otherwise
    }

    var placed = self._comments(gap)

    if !placed[1] {
      return [placed[0], otherwise]
    }

    return [placed[0], gap.after >= 2 ? BLANKLINE : HARDLINE]
  }

  # A gap the layout writes no break into. A comment the author left in
  # it still ends its line, since a `#` runs to the end of one.
  _loose(gap) {
    if gap.comments.is_empty() {
      return ''
    }

    var placed = self._comments(gap)

    return [placed[0], placed[1] ? HARDLINE : ' ']
  }

  # Places the comments written before `offset`.
  _flush(offset: number) {
    return self._loose(self.src.take(offset))
  }

  # Sequences

  # Statements, members or arms, one to a line, with the comments around
  # them and the blank lines between them. `close` is where the sequence
  # ends: a block's `}`, or the end of the file when `top`. A block's
  # sequence starts with the line break after its `{`; a file's starts
  # with its first line.
  _sequence(items: list, close: number, top: bool) {
    var parts = []
    var previous = nil

    for item in items {
      parts.append(self._lead(self.src.take(item.start), previous, item, top))
      parts.append(self._item(item))
      previous = item
    }

    parts.append(self._tail(self.src.take(close), previous, top))

    return parts
  }

  # What goes before `item`: the comments since `previous` and the
  # break onto its line. A blank line the author left is kept, one at
  # most, and a declaration spanning several lines always has one on
  # either side of it, ahead of the comments that lead into it.
  _lead(gap, previous, item, top: bool) {
    var out = []
    var comments = gap.comments
    var first = previous == nil
    var at_top = first and top
    var start = 0

    # A comment on the line the code before it ended on, the previous
    # item's or the block's `{`, stays at the end of that line.
    if !comments.is_empty() and comments[0].before == 0 and !at_top {
      out.append([' ', self._comment(comments[0].token, false)])
      start = 1
    }

    var own = comments[start,]
    var blanks = own.map(@(entry) => entry.before >= 2)

    blanks.append(gap.after >= 2)

    if !first {
      if self._opens(previous) {
        blanks[0] = true
      }

      if self._opens(item) {
        var attached = blanks.length() - 1

        while attached > 0 and !blanks[attached] {
          attached -= 1
        }

        blanks[attached] = true
      }
    }

    var index = 0

    for entry in own {
      if !(at_top and index == 0) {
        out.append(blanks[index] ? BLANKLINE : HARDLINE)
      }

      out.append(self._comment(entry.token, true))
      index += 1
    }

    if !(at_top and own.is_empty()) {
      out.append(blanks[index] ? BLANKLINE : HARDLINE)
    }

    return out
  }

  # The comments after the last item, up to the block's `}` or the end
  # of the file. No blank line is left before the `}` itself.
  _tail(gap, previous, top: bool) {
    var out = []
    var comments = gap.comments
    var empty = previous == nil
    var start = 0

    if !comments.is_empty() and comments[0].before == 0 and !(empty and top) {
      out.append([' ', self._comment(comments[0].token, false)])
      start = 1
    }

    var index = start

    for entry in comments[start,] {
      if !(empty and top and index == 0) {
        out.append(entry.before >= 2 ? BLANKLINE : HARDLINE)
      }

      out.append(self._comment(entry.token, true))
      index += 1
    }

    return out
  }

  # Whether `node` is a declaration laid out across several lines: a
  # function, method or class with something in its body.
  _opens(node) {
    var target = node.kind == 'Decl' ? node.fields.declaration : node

    using target.kind {
      when 'Function', 'Method' {
        var body = target.fields.body

        return !_code(body.fields.statements).is_empty() or
            !self.src.quiet(body.start + 1, body.end - 1)
      }
      when 'Class' {
        var f = target.fields
        var open = self.src.next(self._class_head_end(target))

        return !_code(f.properties + f.methods).is_empty() or
            !self.src.quiet(open.end, target.end - 1)
      }
    }

    return false
  }

  # One item of a sequence.
  _item(node) {
    using node.kind {
      when 'Stmt' return self._item(node.fields.statement)
      when 'Decl' return self._item(node.fields.declaration)
      when 'Function' return self._function(node)
      when 'Class' return self._class(node)
      when 'Method' return self._method(node)
      when 'Property' return self._property(node)
      when 'Var' return self._var(node, true)
      when 'VarList' return self._var_list(node, true)
      when 'Expression' return self._expr(node.fields.value)
      when 'Echo' {
        return ['echo ', self._expr(node.fields.value)]
      }
      when 'Return' return self._keyword(node, 'return')
      when 'Raise' return self._keyword(node, 'raise')
      when 'Assert' return self._assert(node)
      when 'If' return self._if(node)
      when 'While' return self._while(node)
      when 'DoWhile' return self._do(node)
      when 'For' return self._for(node)
      when 'Iter' return self._iter(node)
      when 'Using' return self._using(node)
      when 'When' return self._when(node)
      when 'Default' return self._default(node)
      when 'Catch' return self._catch(node)
      when 'Import' return self._import(node)
      when 'Block' return self._block(node)
      when 'Continue' return 'continue'
      when 'Break' return 'break'
    }

    raise Error('there is no layout for a ${node.kind}')
  }

  # Blocks and bodies

  # The braces around a body and the lines inside them, a group that is
  # always broken so the body opens out wherever it is.
  _opened(body) {
    return broken_group(['{', nest(body), HARDLINE, '}'])
  }

  # A `{ }` block. One with statements always opens, one statement to a
  # line; an empty one closes up to `{}`.
  _block(block) {
    var lead = self._flush(block.start)
    var close = block.end - 1
    var items = _code(block.fields.statements)

    self.src.skip(block.start + 1)

    if items.is_empty() and self.src.quiet(block.start + 1, close) {
      self.src.skip(block.end)

      return [lead, '{}']
    }

    var body = self._sequence(items, close, false)

    self.src.skip(block.end)

    return [lead, self._opened(body)]
  }

  # A single statement braced into a block of its own: the body of an
  # `if` or a loop written without braces. A comment trailing it on its
  # line goes inside with it.
  _braced(statement) {
    var lead = self._lead(self.src.take(statement.start), nil, statement, false)
    var item = self._item(statement)
    var trailing = self._comments(self.src.take_trailing(statement.end))[0]

    return self._opened([lead, item, trailing])
  }

  # The body of an `if`, `else`, loop or arm, after its header. A block
  # is laid out as one, and anything else is braced unless it declares a
  # name, which braces would scope. A body left unbraced keeps the line
  # it was written on.
  _body(body) {
    if body.kind == 'Block' {
      return [' ', self._block(body)]
    }

    if _DECLARING.contains(body.kind) {
      var gap = self.src.take(body.start)

      if gap.is_broken() {
        var placed = self._comments(gap)

        return nest([
          placed[0],
          gap.after >= 2 ? BLANKLINE : HARDLINE,
          self._item(body),
        ])
      }

      return [self._loose(gap), ' ', self._item(body)]
    }

    return [' ', self._braced(body)]
  }

  # Whether a body ends on a `}`, the line an `else` or a `while` may
  # follow it on.
  _closes(body) {
    return !_DECLARING.contains(body.kind)
  }

  # The keyword joining a body to what follows it: `else` after an `if`
  # body, `while` after a `do` body. It follows a `}` on the same line;
  # after a body left unbraced it needs a line of its own, since that
  # body's statement ends at the line break.
  _joint(body, word: string) {
    var token = self.src.next(body.end)
    var gap = self.src.take(token.start)

    self.src.skip(token.end)

    if !self._closes(body) {
      return [self._break(gap, HARDLINE), word]
    }

    if gap.comments.is_empty() {
      return [' ', word]
    }

    return [self._break(gap, ' '), word]
  }

  # Statements

  _if(node) {
    var f = node.fields
    var out = ['if ', self._expr(f.condition), self._body(f.then)]

    if f.otherwise == nil {
      return out
    }

    out.append(self._joint(f.then, 'else'))

    if f.otherwise.kind == 'If' {
      out.append([' ', self._flush(f.otherwise.start), self._if(f.otherwise)])
    } else {
      out.append(self._body(f.otherwise))
    }

    return out
  }

  _while(node) {
    var f = node.fields

    return ['while ', self._expr(f.condition), self._body(f.body)]
  }

  _do(node) {
    var f = node.fields
    var body = self._body(f.body)
    var joint = self._joint(f.body, 'while')

    return ['do', body, joint, ' ', self._expr(f.condition)]
  }

  _for(node) {
    var f = node.fields
    var out = ['for ']

    if f.key_span != nil {
      out.append([self._flush(f.key_span.start), f.key, ', '])
    }

    out.append([self._flush(f.value_span.start), f.value, ' in '])
    self.src.skip(f.value_span.end)

    var in_word = self.src.next(f.value_span.end)

    out.append(self._flush(in_word.start))
    self.src.skip(in_word.end)
    out.append(self._expr(f.iterable))
    out.append(self._body(f.body))

    return out
  }

  # `iter init; condition; steps`. A clause left empty keeps the space
  # that shows it is there: `iter ; i < n; i++`.
  _iter(node) {
    var f = node.fields
    var out = ['iter']

    if f.initializer != nil {
      var init = f.initializer
      var spelled = self.src.next(init.start).kind == 'Var'

      if init.kind == 'VarList' {
        out.append([' ', self._var_list(init, spelled)])
      } else {
        out.append([' ', self._var(init, spelled)])
      }
    } else {
      out.append(' ')
    }

    out.append(';')

    if f.condition != nil {
      out.append([' ', self._expr(f.condition)])
    }

    out.append(';')

    if !f.steps.is_empty() {
      var steps = []
      var index = 0

      for step in f.steps {
        if index > 0 {
          steps.append(', ')
        }

        steps.append(self._expr(step))
        index += 1
      }

      out.append([' ', steps])
    }

    out.append([' ', self._block(f.body)])

    return out
  }

  _using(node) {
    var f = node.fields
    var out = ['using ', self._expr(f.subject), ' ']
    var open = self.src.next(f.subject.end)
    var close = node.end - 1
    var arms = _code(f.arms)

    out.append(self._flush(open.start))
    self.src.skip(open.end)

    if f.default_body != nil {
      var word = self.src.next(arms.is_empty() ? open.end : arms.last().end)

      arms.append({
        kind: 'Default',
        start: word.start,
        end: f.default_body.end,
        body: f.default_body,
        word_end: word.end,
      })
    }

    if arms.is_empty() and self.src.quiet(open.end, close) {
      self.src.skip(node.end)
      out.append('{}')

      return out
    }

    var body = self._sequence(arms, close, false)

    self.src.skip(node.end)
    out.append(self._opened(body))

    return out
  }

  _when(node) {
    var f = node.fields
    var labels = []
    var index = 0

    self.src.skip(node.start + 4)

    for label in f.labels {
      if index > 0 {
        var comma = self.src.next(f.labels[index - 1].end)
        var gap = self.src.take(comma.start)

        self.src.skip(comma.end)
        labels.append([self._loose(gap), ','])
        labels.append(self._break(self.src.take(label.start), LINE))
      }

      labels.append(self._expr(label))
      index += 1
    }

    return ['when ', group(continued(labels)), self._arm(f.body)]
  }

  _default(arm) {
    self.src.skip(arm.word_end)

    return ['default', self._arm(arm.body)]
  }

  # The body of a `when` or `default` arm. Written without braces, it
  # stays on the arm's line while that line is at most `_ARM_WIDTH`
  # wide, and is braced otherwise.
  _arm(body) {
    if body.kind == 'Block' or _DECLARING.contains(body.kind) {
      return self._body(body)
    }

    var gap = self.src.take(body.start)

    if !gap.comments.is_empty() {
      return [
        ' ',
        self._opened([self._break(gap, HARDLINE), self._item(body)]),
      ]
    }

    var statement = self._item(body)
    var braced = [
      ' ',
      self._opened([HARDLINE, statement]),
    ]

    return choose(_ARM_WIDTH, [' ', statement], braced)
  }

  _catch(node) {
    var f = node.fields
    var out = ['catch ', self._block(f.body)]

    if f.error_var == nil {
      return out
    }

    var as_word = self.src.next(f.body.end)

    out.append([self._flush(as_word.start), ' as '])
    self.src.skip(as_word.end)
    out.append(self._expr(f.error_var))

    if f.catch_body != nil {
      out.append([' ', self._block(f.catch_body)])
    }

    return out
  }

  # `return` and `raise`, with their value when the source gave one.
  _keyword(node, word: string) {
    var value = node.fields.value

    self.src.skip(node.start + word.length())

    if value.kind == 'Nil' and _implicit(value) {
      return word
    }

    return [word, ' ', self._expr(value)]
  }

  _assert(node) {
    var f = node.fields
    var condition = self._expr(f.condition)

    if f.message == nil {
      return ['assert ', condition]
    }

    var comma = self.src.next(f.condition.end)
    var before = self._loose(self.src.take(comma.start))

    self.src.skip(comma.end)

    var gap = self.src.take(f.message.start)
    var message = self._expr(f.message)

    return [
      'assert ',
      group([
        condition,
        before,
        ',',
        continued([self._break(gap, LINE), message]),
      ]),
    ]
  }

  # `var name: type = value`, or the same without `var` in an `iter`
  # that leaves the word out.
  _var(node, spelled: bool) {
    var f = node.fields
    var out = []

    if spelled {
      out.append(f.is_constant ? 'const ' : 'var ')
    }

    out.append([self._flush(f.name_span.start), f.name])
    self.src.skip(f.name_span.end)

    if f.type_hint != nil and !_implicit(f.type_hint) {
      out.append([': ', self._type(f.type_hint)])
    }

    if !(f.value.kind == 'Nil' and _implicit(f.value)) {
      var equal = self.src.next(self.src.taken)

      out.append([self._flush(equal.start), ' = '])
      self.src.skip(equal.end)
      out.append(self._expr(f.value))
    }

    return out
  }

  # `var a = 1, b = 2`, broken after a comma when it does not fit.
  _var_list(node, spelled: bool) {
    var declarations = node.fields.declarations
    var first = declarations[0]
    var parts = []
    var index = 0

    for declaration in declarations {
      if index > 0 {
        var comma = self.src.next(declarations[index - 1].end)

        parts.append([self._flush(comma.start), ','])
        self.src.skip(comma.end)
        parts.append(self._break(self.src.take(declaration.start), LINE))
      }

      parts.append(self._var(declaration, false))
      index += 1
    }

    var word = spelled ? (first.fields.is_constant ? 'const ' : 'var ') : ''

    return [word, group(continued(parts))]
  }

  _import(node) {
    var f = node.fields
    var out = ['import ']

    if f.exported {
      out.append('@')
    }

    var previous = nil

    for segment in f.segments {
      if previous != nil and segment.start > previous.end {
        out.append(' ')
      }

      out.append(segment.text)
      previous = segment
    }

    var path_end = previous == nil ? node.start + 6 : previous.end

    self.src.skip(path_end)

    if f.imports_all or !f.elements.is_empty() {
      var open = self.src.next(path_end)

      out.append(' ')

      if f.imports_all {
        var star = self.src.next(open.end)
        var close = self.src.next(star.end)

        out.append([
          self._flush(open.start),
          '{ ',
          self._flush(star.start),
          '* ',
        ])
        self.src.skip(star.end)
        out.append([self._flush(close.start), '}'])
        self.src.skip(close.end)

        return out
      }

      var close = self._closer(open, f.elements)

      out.append(
        self._bracket(
          '{',
          '}',
          open.start,
          close.start,
          f.elements,
          true,
          true,
          'expr',
          'plain',
        ),
      )

      return out
    }

    if f.aliased {
      var as_word = self.src.next(path_end)

      out.append([self._flush(as_word.start), ' as '])
      self.src.skip(as_word.end)
      out.append(self._leaf(f.name))
    }

    return out
  }

  # Declarations

  _function(node) {
    var f = node.fields
    var out = ['def ', self._flush(f.name_span.start), f.name]

    self.src.skip(f.name_span.end)
    out.append(
      self._parameters(
        self.src.next(f.name_span.end),
        f.parameters,
        f.is_variadic,
      ),
    )
    out.append([' ', self._block(f.body)])

    return out
  }

  _method(node) {
    var f = node.fields
    var out = []

    if f.is_static {
      out.append('static ')
    }

    out.append([self._flush(f.name_span.start), f.name])
    self.src.skip(f.name_span.end)
    out.append(
      self._parameters(
        self.src.next(f.name_span.end),
        f.parameters,
        f.is_variadic,
      ),
    )
    out.append([' ', self._block(f.body)])

    return out
  }

  _property(node) {
    var f = node.fields
    var out = []

    if f.is_static {
      out.append('static ')
    }

    out.append(f.is_constant ? 'const ' : 'var ')
    out.append([self._flush(f.name_span.start), f.name])
    self.src.skip(f.name_span.end)

    if !_implicit(f.type_hint) {
      out.append([': ', self._type(f.type_hint)])
    }

    if !(f.value.kind == 'Nil' and _implicit(f.value)) {
      var equal = self.src.next(self.src.taken)

      out.append([self._flush(equal.start), ' = '])
      self.src.skip(equal.end)
      out.append(self._expr(f.value))
    }

    return out
  }

  # Where a class's header ends: after its name, or the class it builds
  # on or extends.
  _class_head_end(node) {
    var f = node.fields

    return f.superclass == nil ? f.name_span.end : f.superclass.end
  }

  _class(node) {
    var f = node.fields
    var out = ['class ', self._flush(f.name_span.start), f.name]

    self.src.skip(f.name_span.end)

    if f.superclass != nil {
      var arrow = self.src.next(f.name_span.end)

      out.append([self._flush(arrow.start), f.is_extension ? ' > ' : ' < '])
      self.src.skip(arrow.end)
      out.append(self._expr(f.superclass))
    }

    var open = self.src.next(self._class_head_end(node))
    var close = node.end - 1
    var members = _code(f.properties + f.methods)
        .sort(@(a, b) => a.start - b.start)

    out.append([' ', self._flush(open.start)])
    self.src.skip(open.end)

    if members.is_empty() and self.src.quiet(open.end, close) {
      self.src.skip(node.end)
      out.append('{}')

      return out
    }

    var body = self._sequence(members, close, false)

    self.src.skip(node.end)
    out.append(self._opened(body))

    return out
  }

  # The `)` closing a parameter list or the `}` closing an import's names
  # that opened at `open`: the next token after the last item, or after
  # its trailing comma.
  _closer(open, items: list) {
    if items.is_empty() {
      return self.src.next(open.end)
    }

    var after = self.src.next(items.last().end)

    if after.kind == 'Comma' {
      return self.src.next(after.end)
    }

    return after
  }

  _parameters(open, parameters: list, variadic: bool) {
    var close = self._closer(open, parameters)

    return self._bracket(
      '(',
      ')',
      open.start,
      close.start,
      parameters,
      false,
      !variadic,
      'parameter',
      'plain',
    )
  }

  _parameter(node) {
    var f = node.fields
    var out = [self._flush(node.start)]

    if self.src.text[node.start] == '.' {
      out.append('...')
    }

    out.append(f.name)
    self.src.skip(f.name_span.end)

    if !_implicit(f.type_hint) {
      out.append([': ', self._type(f.type_hint)])
    }

    return out
  }

  # A type annotation, `?int|string`, written as the source spells its
  # names.
  _type(hint) {
    var lead = self._flush(hint.start)
    var names = hint.fields.types.map(
      @(name) => self.src.slice(name.start, name.end),
    )

    self.src.skip(hint.end)

    return [lead, hint.fields.nullable ? '?' : '', '|'.join(names)]
  }

  # Lists

  # A bracketed list of items separated by commas: arguments, parameters,
  # a list or dictionary literal, an import's names. `role` is
  # `arguments` for a call's arguments, `collection` for a list or
  # dictionary literal and `plain` for the rest.
  #
  # It stays on one line when it fits, and otherwise opens out one item
  # to a line with a trailing comma. A list or dictionary literal holding
  # another one with something in it, at any depth and through any call,
  # always opens out. Among a call's arguments, a single
  # function with a body, or failing that a single collection, followed
  # by at most one more argument, may instead open out on its own with
  # the other arguments kept on the line: `each(items, @{`. A blank line
  # between two items is kept once the list opens out.
  #
  # A list of numbers, with or without `nil` among them, fills its lines,
  # as many to a line as fit, and a collection holding a `#` comment
  # between its items keeps the source's rows, each laid out like a list
  # of its own.
  _bracket(
    open: string,
    close: string,
    open_at: number,
    close_at: number,
    items: list,
    spaced: bool,
    trailing: bool,
    kind: string,
    role: string,
  ) {
    var lead = self._flush(open_at)
    var count = items.length()

    self.src.skip(open_at + 1)

    if count == 0 {
      var inside = self.src.take(close_at)

      self.src.skip(close_at + 1)

      if inside.comments.is_empty() {
        return [lead, open, close]
      }

      var placed = self._comments(inside)

      return [
        lead,
        broken_group([open, nest(placed[0]), HARDLINE, close]),
      ]
    }

    var gaps = []
    var docs = []
    var quiet = true
    var index = 0

    for item in items {
      var gap = self.src.take(item.start)

      gaps.append(gap)
      quiet = quiet and gap.comments.is_empty()

      var item_doc = self._element(kind, item)

      if index < count - 1 {
        var comma = self.src.next(item.end)
        var before = self.src.take(comma.start)

        quiet = quiet and before.comments.is_empty()
        self.src.skip(comma.end)
        docs.append([item_doc, self._loose(before), ','])
      } else {
        var after = self.src.next(item.end)

        if after.kind == 'Comma' and after.start < close_at {
          var before = self.src.take(after.start)

          quiet = quiet and before.comments.is_empty()
          item_doc = [item_doc, self._loose(before)]
          self.src.skip(after.end)
        }

        docs.append(item_doc)
      }

      index += 1
    }

    var closing = self.src.take(close_at)

    quiet = quiet and closing.comments.is_empty()
    self.src.skip(close_at + 1)

    var soft = spaced ? LINE : SOFTLINE
    var placed = self._comments(closing)
    var comma = trailing ? if_break(',', '') : ''
    var end = [nest(placed[0]), placed[1] ? HARDLINE : soft, close]

    if role == 'collection' and self._has_line_comment(gaps, closing) {
      var rows = self._rows(gaps, docs)

      return [
        lead,
        broken_group([
          open,
          nest([rows, comma]),
          end,
        ]),
      ]
    }

    var parts = [self._break(gaps[0], soft)]

    index = 0

    for item_doc in docs {
      if index > 0 {
        parts.append(self._separator(gaps[index]))
      }

      parts.append(item_doc)
      index += 1
    }

    var numbers = role == 'collection' and
        kind == 'expr' and
        quiet and
        count > 1 and
        items.every(@(item) => _number(item) or item.kind == 'Nil') and
        items.some(_number)

    if numbers {
      var filled = [parts[0], fill(parts[1,])]

      return [
        lead,
        group([
          open,
          nest([filled, comma]),
          end,
        ]),
      ]
    }

    var opened = [
      open,
      nest([parts, comma]),
      end,
    ]

    if role == 'collection' and self._nests(items, kind) {
      return [lead, broken_group(opened)]
    }

    var block = role == 'arguments' and quiet ? self._block_index(items) : -1

    if block == -1 {
      return [lead, group(opened)]
    }

    index = 0

    for item_doc in docs {
      if index != block and flat_width(item_doc) < 0 {
        return [lead, group(opened)]
      }

      index += 1
    }

    var natural = [open]
    var hugged = [open]

    index = 0

    for item_doc in docs {
      if index > 0 {
        natural.append(' ')
        hugged.append(' ')
      }

      natural.append(item_doc)
      hugged.append(index == block ? expanded(item_doc) : item_doc)
      index += 1
    }

    natural.append(close)
    hugged.append(close)

    var layouts = [natural]

    if _collection(items[block]) {
      layouts.append(hugged)
    }

    layouts.append(broken_group(opened))

    return [lead, first_fit(layouts)]
  }

  # Whether a collection's items hold another list or dictionary with
  # something in it, anywhere inside them.
  _nests(items: list, kind: string) {
    if kind == 'entry' {
      return items.some(@(entry) => _holds_collection([entry.key, entry.value]))
    }

    return items.some(_holds_collection)
  }

  # What separates two items of an opened list: the comments between
  # them, and a blank line where the source left one.
  _separator(gap) {
    if gap.comments.is_empty() and gap.newlines >= 2 {
      return if_break(BLANKLINE, LINE)
    }

    return self._break(gap, LINE)
  }

  # Whether a `#` comment sits before any item of a list or before its
  # closer.
  _has_line_comment(gaps: list, closing) {
    var found = closing.comments.some(@(entry) => entry.token.kind == 'Comment')

    for gap in gaps {
      found = found or
          gap.comments.some(@(entry) => entry.token.kind == 'Comment')
    }

    return found
  }

  # The items of a collection laid out in the rows the source wrote them
  # in, the rows one to a line and each laid out like a list of its own.
  _rows(gaps: list, docs: list) {
    var parts = []
    var row = []
    var index = 0

    for item_doc in docs {
      var gap = gaps[index]
      var starts = index == 0 or gap.newlines > 0 or !gap.comments.is_empty()

      if starts {
        if !row.is_empty() {
          parts.append(group(row))
          row = []
        }

        if index == 0 {
          parts.append(self._break(gap, HARDLINE))
        } else {
          var blank = gap.comments.is_empty() and gap.newlines >= 2

          parts.append(blank ? BLANKLINE : self._break(gap, HARDLINE))
        }
      } else {
        row.append(LINE)
      }

      row.append(item_doc)
      index += 1
    }

    parts.append(group(row))

    return parts
  }

  # The argument that may open out on its own while the others stay on
  # the line, or `-1` when none may: the one function with a body, or
  # when there is none, the one collection with something in it. It has
  # to be the last argument or the one before it.
  _block_index(items: list) {
    var function = -1
    var collection = -1
    var index = 0

    for item in items {
      if self._block_function(item) {
        function = function == -1 ? index : -2
      } else if _collection(item) {
        collection = collection == -1 ? index : -2
      }

      index += 1
    }

    var chosen = function >= 0 ? function : collection

    if chosen < 0 or chosen < items.length() - 2 {
      return -1
    }

    return chosen
  }

  # Whether `node` is a function written as a value with a block body
  # that holds something.
  _block_function(node) {
    if node.kind != 'Anonymous' {
      return false
    }

    var body = node.fields.declaration.fields.body

    if body.kind != 'Block' {
      return false
    }

    return !_code(body.fields.statements).is_empty() or
        !self.src.quiet(body.start + 1, body.end - 1)
  }

  # Whether a dictionary entry is written as the shorthand `name`: it was
  # written that way, or as `name: name` with the key a bare name.
  _shorthand(entry) {
    var key = entry.key
    var value = entry.value

    if value.kind == 'Shorthand' {
      return true
    }

    return key.kind == 'Literal' and
        !_QUOTES.contains(self.src.text[key.start]) and
        value.kind == 'Identifier' and
        value.fields.name == key.fields.value and
        self.src.quiet(key.end, value.end)
  }

  # One item of a bracketed list.
  _element(kind: string, item) {
    using kind {
      when 'expr' return self._expr(item)
      when 'parameter' return self._parameter(item)
      when 'entry' return self._entry(item)
    }

    raise Error('there is no layout for a ${kind} list item')
  }

  # A dictionary entry, `key: value`. `name: name` with the key written
  # as a bare name is written as the shorthand `name`. A value made of
  # operators moves to a line of its own after the `:` when the entry
  # does not fit, its operands lined up under one another there.
  _entry(entry) {
    var key = entry.key
    var value = entry.value

    if self._shorthand(entry) {
      var name = self._leaf(key)

      self.src.skip(value.end)

      return name
    }

    var key_doc = self._expr(key)
    var colon = self.src.next(key.end)
    var before = self._loose(self.src.take(colon.start))

    self.src.skip(colon.end)

    var gap = self.src.take(value.start)

    if _level(value) > 0 {
      var operators = self._operators(value, false)

      return group([
        key_doc,
        before,
        ':',
        self._loose(gap),
        continued([LINE, operators]),
      ])
    }

    return [key_doc, before, ':', self._loose(gap), ' ', self._expr(value)]
  }

  # Expressions

  _expr(node) {
    if _LEAVES.contains(node.kind) {
      return self._leaf(node)
    }

    using node.kind {
      when 'Unary' return self._unary(node)
      when 'Binary', 'Logical', 'Circuit' {
        return self._operators(node, true)
      }
      when 'Condition' return self._conditional(node)
      when 'Grouping' return self._grouping(node)
      when 'Range' return self._range(node)
      when 'Call', 'Get', 'Index', 'Slice' {
        return self._chain(node)
      }
      when 'Set' return self._set(node)
      when 'List' return self._list(node)
      when 'Dict' return self._dict(node)
      when 'Assign', 'CompoundAssign' {
        return self._assign(node)
      }
      when 'Update' return self._update(node)
      when 'Anonymous' return self._anonymous(node)
      when 'Shorthand' return self._leaf(node)
    }

    raise Error('there is no layout for a ${node.kind}')
  }

  # Code written exactly as the source has it: a name, a number, a
  # string with everything inside it.
  _leaf(node) {
    var lead = self._flush(node.start)
    var text = self.src.slice(node.start, node.end)

    self.src.skip(node.end)

    return lead == '' ? text : [lead, text]
  }

  _unary(node) {
    var lead = self._flush(node.start)
    var operator = self.src.next(node.start)
    var operand = node.fields.operand

    self.src.skip(operator.end)

    # `- -x` written together would read as a decrement.
    var apart = operator.kind == 'Minus' and
        operand.kind == 'Unary' and
        operand.fields.op == 'Minus'

    return [lead, operator.text, apart ? ' ' : '', self._expr(operand)]
  }

  # A run of operators of one level, on one line when it fits and
  # otherwise broken after every one of its operators. The operands
  # after the first sit two levels in when `indented`, and line up with
  # the first when not, as they do on a line of their own after a `:`.
  _operators(node, indented: bool) {
    var operands = _operands(node)
    var count = operands.length()
    var parts = [self._expr(operands[0])]
    var index = 0

    while index < count - 1 {
      var token = self.src.next(operands[index].end)
      var gap_before = self.src.take(token.start)

      self.src.skip(token.end)

      var gap_after = self.src.take(operands[index + 1].start)
      var right = self._expr(operands[index + 1])

      parts.append([
        self._loose(gap_before),
        ' ',
        token.text,
        self._break(gap_after, LINE),
        right,
      ])
      index += 1
    }

    return group(indented ? continued(parts) : parts)
  }

  # `condition ? then : otherwise`, on one line when it fits and
  # otherwise broken before the `?` and the `:`, each branch two levels
  # in. A conditional in the last branch joins the chain, so a run of
  # them reads as a list of cases.
  _conditional(node) {
    var parts = [self._expr(node.fields.condition)]
    var current = node

    while true {
      var f = current.fields
      var question = self.src.next(f.condition.end)
      var gap_before = self.src.take(question.start)

      self.src.skip(question.end)

      var gap_after = self.src.take(f.then.start)
      var then = self._expr(f.then)

      parts.append([
        self._break(gap_before, LINE),
        '?',
        self._loose(gap_after),
        ' ',
        nest(then),
      ])

      var colon = self.src.next(f.then.end)
      var gap_colon = self.src.take(colon.start)

      self.src.skip(colon.end)

      var otherwise = f.otherwise
      var gap_otherwise = self.src.take(otherwise.start)
      var chained = otherwise.kind == 'Condition'
      var branch = chained
          ? self._expr(otherwise.fields.condition)
          : self._expr(otherwise)

      parts.append([
        self._break(gap_colon, LINE),
        ':',
        self._loose(gap_otherwise),
        ' ',
        nest(branch),
      ])

      if !chained {
        break
      }

      current = otherwise
    }

    return group(continued(parts))
  }

  # An expression in parentheses, its insides laid out as they would be
  # anywhere.
  _grouping(node) {
    var lead = self._flush(node.start)
    var inner = node.fields.inner

    self.src.skip(node.start + 1)

    var opening = self.src.take(inner.start)
    var inner_doc = self._expr(inner)
    var closing = self.src.take(node.end - 1)

    self.src.skip(node.end)

    return [
      lead,
      '(',
      self._loose(opening),
      inner_doc,
      self._loose(closing),
      ')',
    ]
  }

  _range(node) {
    var f = node.fields
    var lower = self._expr(f.lower)
    var dots = self.src.next(f.lower.end)
    var before = self._flush(dots.start)

    self.src.skip(dots.end)

    return [
      lower,
      before,
      '..',
      self._flush(f.upper.start),
      self._expr(f.upper),
    ]
  }

  # A chain of calls, property reads and subscripts on one value: the
  # value it starts from, then each `.name` with the arguments and
  # subscripts that follow it. A call on a capitalized name, `Color.of(x)`,
  # stays part of the value.
  #
  # It stays on one line when it fits. Otherwise, the value it starts
  # from opens out like a block when it is a call or a collection and
  # the rest of the chain fits after its closing bracket. Failing that,
  # when every call before the last takes no arguments, or the last
  # takes a function or collection that opens out on its own, only the
  # last call's arguments open out. Failing that too, it breaks before
  # each `.`, two levels in, the property reads it opens with kept
  # beside the value. A value that is a call or collection of a single
  # item breaks before its calls before anything else, if that keeps
  # each of them on its line.
  _chain(node) {
    var backwards = []
    var current = node

    while _LINKS.contains(current.kind) {
      backwards.append(current)
      current = current.kind == 'Call'
          ? current.fields.callee
          : current.fields.object
    }

    var nodes = backwards.reverse()
    var target = [self._expr(current)]
    var target_node = current
    var links = []
    var count = nodes.length()
    var index = 0

    while index < count {
      var link = nodes[index]
      var next = index + 1 < count ? nodes[index + 1] : nil
      var called = next != nil and next.kind == 'Call'

      if link.kind == 'Get' {
        var dot = self.src.next(link.fields.object.end)
        var gap = self.src.take(dot.start)

        self.src.skip(dot.end)

        var name = [
          '.',
          self._flush(link.fields.name_span.start),
          link.fields.name,
        ]

        self.src.skip(link.fields.name_span.end)

        var qualified = links.is_empty() and
            called and
            target_node.kind == 'Identifier' and
            (_capitalized(target_node.fields.name) or
                _capitalized(link.fields.name))

        if qualified {
          target.append([self._loose(gap), name])
        } else {
          links.append(_Link(gap, name))
        }
      } else if link.kind == 'Call' {
        var arguments = self._arguments(link)
        var last = links.is_empty() ? nil : links.last()

        if last != nil and last.kind == 'property' and last.after.is_empty() {
          var listed = link.fields.arguments

          last.arguments = arguments
          last.kind = listed.is_empty() ? 'empty' : 'call'

          if self._block_index(listed) >= 0 {
            last.kind = 'block'
          }
        } else if last != nil {
          last.after.append(arguments)
        } else {
          target.append(arguments)
        }
      } else if links.is_empty() {
        target.append(self._subscript(link))
      } else {
        links.last().after.append(self._subscript(link))
      }

      target_node = links.is_empty() ? link : target_node
      index += 1
    }

    if links.is_empty() {
      return target
    }

    return self._chain_layouts(target, target_node, links)
  }

  # The layouts of a chain, from `target`, the value it starts from, and
  # its `links`, most compact first.
  _chain_layouts(target, target_node, links: list) {
    var count = links.length()
    var properties = 0

    while properties < count and links[properties].kind == 'property' {
      properties += 1
    }

    var unsplittable = properties

    while unsplittable < count and !links[unsplittable].splits() {
      unsplittable += 1
    }

    var last = count - 1

    if !links[last].splits() and count > 1 and links[last - 1].kind == 'block' {
      last = count - 2
    }

    var block = -1

    if unsplittable == last and links[last].splits() {
      block = last
    } else if links[last].kind == 'block' {
      block = last
    }

    var flat = links.map(@(link) => [self._loose(link.lead), link.doc(false)])
    var layouts = []

    if flat_width(flat) >= 0 {
      layouts.append([target, flat])
    }

    var after_properties = nil

    if properties > 0 and properties < count {
      after_properties = self._split_chain(target, links, properties)
    }

    var split = self._split_chain(target, links, 0)

    if _single(target_node) and flat_width(target) >= 0 {
      layouts.append(whole(after_properties == nil ? split : after_properties))
    }

    if _opens_out(target_node) and flat_width(target) >= 0 {
      layouts.append(whole([expanded(target), flat]))
    }

    if block >= 0 {
      var trailing = [target]
      var others = []
      var index = 0

      for link in links {
        trailing.append([self._loose(link.lead), link.doc(index == block)])

        if index == block {
          others.append([self._loose(link.lead), link.name, link.after])
        } else {
          others.append(flat[index])
        }

        index += 1
      }

      if flat_width(others) >= 0 {
        layouts.append(trailing)
      }
    }

    if after_properties != nil {
      layouts.append(after_properties)
    }

    layouts.append(split)

    return first_fit(layouts)
  }

  # A chain broken before each of its links from the one at `from` on,
  # the links before it kept on the line of the value.
  _split_chain(target, links: list, from: number) {
    var kept = [target]
    var broken = []
    var index = 0

    for link in links {
      if index < from {
        kept.append([self._loose(link.lead), link.doc(false)])
      } else {
        broken.append([self._break(link.lead, SOFTLINE), link.doc(false)])
      }

      index += 1
    }

    return [kept, broken_group(continued(broken))]
  }

  _arguments(call) {
    var callee = call.fields.callee
    var open = self.src.next(callee.end)

    return self._bracket(
      '(',
      ')',
      open.start,
      call.end - 1,
      call.fields.arguments,
      false,
      true,
      'expr',
      'arguments',
    )
  }

  # A subscript, `s[i]`, or a slice. Its commas say what it reads, so it
  # is written as it stands: `s[1,]`, `s[,3]`, `s[1, 3]`.
  _subscript(link) {
    var f = link.fields
    var open = self.src.next(f.object.end)
    var close = link.end - 1
    var out = [self._flush(open.start), '[']

    self.src.skip(open.end)

    if link.kind == 'Index' {
      var opening = self.src.take(f.index.start)
      var index_doc = self._expr(f.index)
      var closing = self.src.take(close)

      self.src.skip(link.end)

      return [out, self._loose(opening), index_doc, self._loose(closing), ']']
    }

    var parts = []

    if !_implicit(f.lower) {
      parts.append([
        self._loose(self.src.take(f.lower.start)),
        self._expr(f.lower),
      ])
    }

    var comma = self.src.next(_implicit(f.lower) ? open.end : f.lower.end)

    parts.append([self._loose(self.src.take(comma.start)), ','])
    self.src.skip(comma.end)

    if !_implicit(f.upper) {
      var gap = self.src.take(f.upper.start)
      var spacer = _implicit(f.lower) ? '' : ' '

      parts.append([self._loose(gap), spacer, self._expr(f.upper)])
    }

    var closing = self.src.take(close)

    self.src.skip(link.end)

    return [out, parts, self._loose(closing), ']']
  }

  _set(node) {
    var f = node.fields
    var object = self._expr(f.object)
    var dot = self.src.next(f.object.end)
    var gap = self.src.take(dot.start)

    self.src.skip(dot.end)

    var name = [self._flush(f.name_span.start), f.name]

    self.src.skip(f.name_span.end)

    var equal = self.src.next(f.name_span.end)
    var before = self._flush(equal.start)

    self.src.skip(equal.end)

    return [
      object,
      self._loose(gap),
      '.',
      name,
      before,
      ' = ',
      self._expr(f.value),
    ]
  }

  _list(node) {
    return self._bracket(
      '[',
      ']',
      node.start,
      node.end - 1,
      node.fields.items,
      false,
      true,
      'expr',
      'collection',
    )
  }

  _dict(node) {
    var f = node.fields
    var entries = []
    var index = 0

    for key in f.keys {
      var value = f.values[index]
      var end = value.end > key.end ? value.end : key.end

      entries.append({ start: key.start, end, key, value })
      index += 1
    }

    return self._bracket(
      '{',
      '}',
      node.start,
      node.end - 1,
      entries,
      true,
      true,
      'entry',
      'collection',
    )
  }

  # `target = value` and its compound forms. Nothing breaks after the
  # operator, which the language does not allow.
  _assign(node) {
    var f = node.fields
    var target = self._expr(f.target)
    var operator = self.src.next(f.target.end)
    var before = self._loose(self.src.take(operator.start))

    self.src.skip(operator.end)

    var gap = self.src.take(f.value.start)
    var value = self._expr(f.value)

    return [target, before, ' ', operator.text, self._loose(gap), ' ', value]
  }

  _update(node) {
    var target = node.fields.target
    var target_doc = self._expr(target)
    var operator = self.src.next(target.end)
    var before = self._loose(self.src.take(operator.start))

    self.src.skip(operator.end)

    return [target_doc, before, operator.text]
  }

  # A function written as a value: `def(x) { }`, `@(x) { }`, `@{ }` or
  # `@(x) => x`. Its body opens from the line it starts on.
  _anonymous(node) {
    var function = node.fields.declaration
    var f = function.fields
    var lead = self._flush(node.start)
    var word = self.src.next(node.start)
    var out = [word.kind == 'Def' ? 'def' : '@']

    self.src.skip(word.end)

    var after = self.src.next(word.end)
    var parameters = after.kind == 'Lparen'

    if parameters {
      out.append(self._parameters(after, f.parameters, f.is_variadic))
    }

    var body = f.body

    if body.kind != 'Block' {
      var arrow = self.src.next(self.src.taken)

      out.append([self._flush(arrow.start), ' => '])
      self.src.skip(arrow.end)
      out.append(self._expr(body.fields.value))

      return [lead, out]
    }

    var tight = word.kind != 'Def' and !parameters

    out.append([tight ? '' : ' ', self._block(body)])

    return [lead, out]
  }
}
