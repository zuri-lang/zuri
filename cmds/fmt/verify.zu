/**
 * @module fmt.verify
 *
 * The check that formatting changed nothing but layout. Two sources are
 * the same program when they parse to the same tree, every position
 * aside, and hold the same comments in the same order.
 *
 * Two differences are allowed, both the formatter's own rewrites and
 * neither a change to what runs:
 *
 * - The dictionary shorthand `{ name }` and the entry it stands for, a
 *   key and a value of the same name.
 * - A body written as a single statement and the same statement braced,
 *   for the body of an `if`, `else`, loop, `when` or `default`. A body
 *   that declares a name is never braced, since braces would give the
 *   name a scope of its own, so it is never treated as the same either.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

# Fields that say where something is rather than what it is.
var _PLACES = [
  'start',
  'end',
  'line',
  'col',
  'end_line',
  'end_col',
  'name_span',
  'key_span',
  'value_span',
  'segments',
]

# Statements that declare a name, which braces would scope.
var _DECLARING = ['Var', 'VarList', 'Decl', 'Function']

# The fields of each kind that hold a body.
var _BODIES = {
  If: ['then', 'otherwise'],
  While: ['body'],
  For: ['body'],
  DoWhile: ['body'],
  When: ['body'],
  Using: ['default_body'],
}

def _is_comment(node) {
  return is_instance(node) and
      (node.kind == 'Comment' or node.kind == 'DocBlock')
}

# A comment's text with what layout is allowed to change taken out: the
# space a `#` comment trails off with, and the indent of a doc block's
# lines, which move with the code around it.
def _comment_text(node) {
  var text = node.fields.text

  if node.kind == 'Comment' {
    return '#' + text.rtrim()
  }

  return '/*' + '\n'.join(text.split('\n').map(@(line) => line.trim()))
}

# Notes a comment's place and text on one side.
def _note(node, notes: list) {
  notes.append({ start: node.start, text: _comment_text(node) })
}

# A body as it compares: a block of one statement that declares nothing
# reads as that statement. The comments the block held are noted, since
# its statement is all that is compared from here on.
def _unbraced(body, notes: list) {
  if !is_instance(body) or body.kind != 'Block' {
    return body
  }

  var statements = body.fields.statements
  var code = statements.filter(@(node) => !_is_comment(node))

  if code.length() != 1 or _DECLARING.contains(code[0].kind) {
    return body
  }

  for node in statements {
    if _is_comment(node) {
      _note(node, notes)
    }
  }

  return code[0]
}

# Whether two lists of values are the same, comments aside. Each side's
# comments are noted as the walk passes them.
def _same_lists(a: list, b: list, a_notes: list, b_notes: list) {
  var i = 0
  var j = 0

  while true {
    while i < a.length() and _is_comment(a[i]) {
      _note(a[i], a_notes)
      i += 1
    }

    while j < b.length() and _is_comment(b[j]) {
      _note(b[j], b_notes)
      j += 1
    }

    if i == a.length() or j == b.length() {
      return i == a.length() and j == b.length()
    }

    if !_same(a[i], b[j], a_notes, b_notes) {
      return false
    }

    i += 1
    j += 1
  }
}

# Whether two values of a tree are the same, positions aside and with
# the formatter's two rewrites read as what they replace.
def _same(a, b, a_notes: list, b_notes: list) {
  if is_list(a) {
    return is_list(b) and _same_lists(a, b, a_notes, b_notes)
  }

  if !is_instance(a) {
    return !is_instance(b) and typeof(a) == typeof(b) and a == b
  }

  if !is_instance(b) {
    return false
  }

  var kind = a.kind == 'Shorthand' ? 'Identifier' : a.kind
  var other = b.kind == 'Shorthand' ? 'Identifier' : b.kind

  if kind != other {
    return false
  }

  var bodies = _BODIES.get(kind, [])

  for name in a.fields.keys() {
    if !_PLACES.contains(name) {
      var left = a.fields[name]
      var right = b.fields.get(name, nil)

      if bodies.contains(name) {
        left = _unbraced(left, a_notes)
        right = _unbraced(right, b_notes)
      }

      if !_same(left, right, a_notes, b_notes) {
        return false
      }
    }
  }

  return true
}

# The text of each comment noted, in the order they were written.
def _in_order(notes: list) {
  return notes.sort(@(x, y) => x.start - y.start).map(@(note) => note.text)
}

/**
 * What differs between two parsed programs: `nil` when they are the
 * same program, `'code'` when their trees differ, and `'comments'` when
 * the trees match but their comments are not the same, in the same
 * order. Positions are never compared, and the formatter's two rewrites
 * read as what they replace.
 *
 * @param list before: The top-level nodes of one, from `zuri.parse()`.
 * @param list after: The top-level nodes of the other.
 * @returns ?string
 */
def difference(before: list, after: list) {
  var before_notes = []
  var after_notes = []

  if !_same_lists(before, after, before_notes, after_notes) {
    return 'code'
  }

  if _in_order(before_notes) != _in_order(after_notes) {
    return 'comments'
  }

  return nil
}
