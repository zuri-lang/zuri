/**
 * Where the running runtime is installed, and whether it can be
 * replaced from here.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import args
import os

import .._shared.errors { CommandError, UsageError }
import .._shared.fsx
import .._shared.semver
import .._shared.ui

/** What a release install holds beside the executable. */
var PARTS = ['libs', 'cmds']

/** The files a release carries that are copied over as they are. */
var EXTRAS = ['LICENSE', 'README.md']

/**
 * The command's parser.
 *
 * @returns args.Parser
 */
def parser() {
  var parser = args.Parser('upgrade', false)

  parser.description = 'Replaces this installation of zuri with a newer release.'

  parser.add_option('version', 'The release to install; the newest one by default',
    { short_name: 'V', type: args.STRING, metavar: 'version' })
  parser.add_option('check', 'Say whether a newer release exists, and exit 1 when one does', nil)
  parser.add_option('prerelease', 'Consider pre-releases too', nil)
  parser.add_option('allow-downgrade', 'Allow installing an older release than this one', nil)
  parser.add_option('dry-run', 'Download and check the release, and replace nothing',
    { short_name: 'n' })
  parser.add_option('json', 'Print the result as JSON', nil)

  return parser
}

/**
 * The installation the running runtime belongs to.
 *
 * @param string executable: the runtime's own path.
 * @param ?string zuri_root: `ZURI_ROOT`, when it is set.
 * @returns dict: `{ root, executable }`.
 * @raises UsageError when this is not an installation `upgrade` can
 *    replace: one with its standard library somewhere else, or not laid
 *    out the way a release is.
 */
def installation(executable: string, zuri_root: ?string) {
  var real = os.real_path(executable)
  var root = os.dir_name(real)

  if zuri_root != nil and !zuri_root.is_empty() and os.abs_path(zuri_root) != root {
    raise UsageError(
      'ZURI_ROOT points this runtime at ${zuri_root}, which is not where it is installed; '
        + 'unset it to upgrade, or upgrade however that installation was put there'
    )
  }

  for part in PARTS {
    if !os.dir_exists(os.join_paths(root, part)) {
      raise UsageError(
        'this runtime at ${real} is not laid out the way a release is (it has no ${part} '
          + 'beside it), so it was installed some other way; upgrade it the same way'
      )
    }
  }

  return { root, executable: real }
}

/**
 * Whether the installation directory can be written to.
 *
 * @param string root
 * @returns bool
 */
def writable(root: string) {
  var probe = os.join_paths(root, '.zuri-upgrade-probe-${fsx.unique()}')

  catch {
    file(probe, 'w').write('')
    file(probe).delete()

    return true
  } as error {
    return false
  }
}

/**
 * What moving from `current` to `offered` would be.
 *
 * @param string current
 * @param string offered
 * @returns string: `'same'`, `'newer'` or `'older'`.
 */
def direction(current: string, offered: string) {
  var order = semver.compare(offered, current)

  if order == 0 {
    return 'same'
  }

  return order > 0 ? 'newer' : 'older'
}

/**
 * Swaps the release staged in `staged` into the installation at
 * `root`: its standard library, its commands, and the executable.
 *
 * Every rename is recorded as it happens, so a failure part way
 * through puts back everything already moved, and the installation is
 * either wholly the new release or wholly the old one. What was
 * replaced is removed once the new release is in place, except on
 * Windows, where the running executable can be renamed but not
 * removed; it is left beside the new one as `<name>.old` for the next
 * start to clear away.
 *
 * @param string root
 * @param string executable: the runtime being replaced.
 * @param string staged: the unpacked release.
 * @param string stamp: what makes the names things are set aside
 *    under unique to this upgrade.
 * @param string platform: `os.platform`.
 * @raises CommandError when the swap failed and was undone.
 */
def swap(root: string, executable: string, staged: string, stamp: string, platform: string) {
  var done = []
  var windows = platform == 'windows'
  var exe_name = os.base_name(executable)

  catch {
    for part in PARTS {
      var current = os.join_paths(root, part)
      var aside = os.join_paths(root, '.${part}.old-${stamp}')

      os.rename(current, aside)
      done.append([aside, current])
      os.rename(os.join_paths(staged, part), current)
      done.append([current, nil])
    }

    # A running executable can be renamed everywhere, and replaced by a
    # rename everywhere but Windows, which keeps it where it was set
    # aside until the next start clears it away.
    var aside = windows
      ? executable + '.old'
      : os.join_paths(root, '.${exe_name}.old-${stamp}')

    fsx.remove(aside)
    os.rename(executable, aside)
    done.append([aside, executable])
    os.rename(os.join_paths(staged, windows ? 'zuri.exe' : 'zuri'), executable)
    done.append([executable, nil])

    if !windows {
      file(executable).chmod(0c755)
    }

    for extra in EXTRAS {
      var from = os.join_paths(staged, extra)

      if file(from).exists() {
        fsx.atomic_write(os.join_paths(root, extra), fsx.read_bytes(from))
      }
    }
  } as error {
    iter var i = done.length() - 1; i >= 0; i-- {
      var move = done[i]

      catch {
        if move[1] == nil {
          fsx.remove(move[0])
        } else {
          os.rename(move[0], move[1])
        }
      } as undo_error {
        ui.complain(ui.failure('could not put back ${move[1]}: ${undo_error.message}'))
      }
    }

    raise CommandError('the upgrade failed and the installation was put back: ${error.message}')
  }

  # What was replaced goes once the new installation is in place. On
  # Windows the old executable stays set aside for the next start.
  for part in PARTS {
    fsx.remove(os.join_paths(root, '.${part}.old-${stamp}'))
  }

  if !windows {
    fsx.remove(os.join_paths(root, '.${exe_name}.old-${stamp}'))
  }
}
