/**
 * @command upgrade
 * @description Replaces this installation of zuri with a newer
 *    release.
 *
 *   zuri upgrade [options]
 *
 * The release for this platform is downloaded, checked against its
 * published checksum, unpacked beside the installation and asked for
 * its version before anything is replaced. The executable, the
 * standard library and the shipped commands are then swapped in
 * together, and put back as they were if any part of that fails.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import os
import os.process { exit, spawn }

import .._shared.cli
import .._shared.errors { CommandError, UsageError, run }
import .._shared.fsx
import .._shared.releases
import .._shared.ui

import .plan

# Runs the staged runtime and checks it says it is `version`.
def _check_runs(runtime: string, version: string) {
  var said = ''

  catch {
    var child = spawn(runtime, ['--version'], {
      stdout: 'pipe', stderr: 'pipe', stdin: 'null', env: { NO_COLOR: '1' },
    })

    var status = child.wait(30000)

    if status == nil {
      child.kill()
      child.wait()
    }

    if status != 0 {
      raise CommandError('the downloaded runtime did not start')
    }

    said = child.read_stdout().to_string()
  } as error {
    raise CommandError('the downloaded runtime did not start: ${error.message}')
  }

  if !said.contains('Zuri ${version}') {
    raise CommandError(
      'the downloaded runtime says it is "${said.split("\n")[0].trim()}", not zuri ${version}'
    )
  }
}

def main() {
  var parsed = plan.parser().parse()
  var given = parsed.options
  var as_json = given.get('json', false) == true
  var current = os.version
  var target = os.target
  var wanted = given.get('version', 'latest')
  var release = releases.find(wanted, target, given.get('prerelease', false) == true)
  var direction = plan.direction(current, release.version)

  if given.get('check', false) == true {
    var newer = direction == 'newer'

    if as_json {
      cli.print_json({ current, latest: release.version, newer })
    } else if newer {
      echo 'zuri ${release.version} is out; this is ${current}. Run `zuri upgrade` to install it.'
    } else {
      echo 'zuri ${current} is the newest release.'
    }

    if newer {
      exit(1)
    }

    return
  }

  if direction == 'same' {
    echo 'zuri ${current} is already installed.'

    return
  }

  if direction == 'older' and given.get('allow-downgrade', false) != true {
    raise UsageError(
      '${release.version} is older than this installation (${current}); pass allow-downgrade '
        + 'to install it anyway'
    )
  }

  var installation = plan.installation(os.exe_path, os.get_env('ZURI_ROOT', nil))
  var root = installation.root

  if !plan.writable(root) {
    raise UsageError(
      'cannot write to ${root}; run the upgrade as the user that owns the installation'
    )
  }

  var stamp = fsx.unique(32)
  var staging = os.join_paths(root, '.upgrade-${stamp}')

  catch {
    echo 'Downloading zuri ${release.version} for ${target}'

    var archive_path = os.join_paths(staging, releases.asset_name(release.version, target))

    releases.download(release, target, archive_path)

    var staged = releases.unpack(
      archive_path, os.join_paths(staging, 'unpacked'), release.version, target
    )
    var staged_runtime = os.join_paths(staged, os.platform == 'windows' ? 'zuri.exe' : 'zuri')

    if os.platform != 'windows' {
      file(staged_runtime).chmod(0c755)
    }

    _check_runs(staged_runtime, release.version)

    if given.get('dry-run', false) == true {
      echo 'zuri ${release.version} downloaded, checked and runs; nothing was replaced.'
      fsx.remove(staging)

      return
    }

    plan.swap(root, installation.executable, staged, stamp, os.platform)
    fsx.remove(staging)
  } as error {
    fsx.remove(staging)

    raise error
  }

  if as_json {
    cli.print_json({ from: current, to: release.version, root })
  } else {
    echo 'Upgraded zuri from ${current} to ${ui.accent(release.version)} in ${root}.'
  }
}

run('upgrade', main)
