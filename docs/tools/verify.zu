/**
 * Runs every example in the documentation and checks what it prints.
 *
 * The claim both books make is that no output in them was typed from
 * memory, and this is what backs it. Every ```zuri block is extracted
 * and run; when a ```console block follows it directly, the two are
 * compared.
 *
 * Run it from the repository root. The first argument picks which set
 * of pages to check, the second narrows it to the pages whose name
 * contains a fragment:
 *
 * ```
 * zuri run docs/tools/verify.zu                  # the book and the reference
 * zuri run docs/tools/verify.zu book             # only the book
 * zuri run docs/tools/verify.zu book ch04        # only the book's chapter 4
 * zuri run docs/tools/verify.zu reference net    # only the net pages
 * ```
 *
 * A block tagged `zuri,ignore` is skipped. There are five legitimate
 * reasons to tag one: it deliberately shows an error, it is one file of
 * a multi-file program, it would never terminate (a server, a prompt),
 * it needs a resource that is not there, or it is a catalogue of
 * alternative calls rather than a program. Anything else is expected
 * to run.
 */

import os
import .blocks { * }

var ROOT = os.dir_name(os.dir_name(os.dir_name(__file__)))
# The two sets of pages this checks, in the order they are reported.
var BOOKS = [
  { name: 'book', pages: os.join_paths(ROOT, 'docs', 'book', 'src') },
  { name: 'reference', pages: os.join_paths(ROOT, 'target', 'reference', 'src') },
]

var WORK = os.join_paths(ROOT, 'tmp', 'docverify')
var ZURI = os.join_paths(ROOT, 'target', 'debug', 'zuri')

# How long one example may take before it is treated as hung. Nearly
# every example finishes in well under a second; the exceptions are the
# `imagine` ones, whose per-pixel work takes tens of seconds against a
# debug build. Anything exceeding even this is waiting on input or
# serving a socket, and wants an `ignore` tag.
var TIMEOUT_MS = 180000

def _pages(root: string, filter: string) {
  var found = []

  for name in os.read_dir(root) {
    if !name.ends_with('.md') or name == 'SUMMARY.md' {
      continue
    }

    if filter != '' and !name.contains(filter) {
      continue
    }

    found.append(name)
  }

  return found.sort()
}

# Runs one block and returns what it printed, or `nil` when it failed.
def _run(source: string) {
  # Named after the process so two runs can go at once without
  # overwriting each other's block.
  var path = os.join_paths(WORK, 'block-${os.pid()}.zu')
  file(path, 'w').write(source)

  var child = os.spawn(ZURI, ['run', path], { cwd: WORK })
  var status = child.wait(TIMEOUT_MS)

  if status == nil {
    child.kill()
    return { ok: false, output: '(timed out)' }
  }

  # Both streams arrive as bytes; the book deals in text.
  var out = child.read_stdout().to_string()
  var err = child.read_stderr().to_string()

  return { ok: status == 0, output: status == 0 ? out : err }
}

# The book writes a stand-in where the real output would name this
# machine or this run: an absolute path, an OS-assigned port, an elided
# tail. Those blocks are run but not compared.
def _has_placeholder(text: string) {
  for token in ['/path/to/', '/home/you/', '...', '<'] {
    if text.contains(token) {
      return true
    }
  }

  return false
}

def main(which: string, filter: string) {
  os.create_dir(WORK, nil, true)

  var ran = 0
  var failed = 0

  for book in BOOKS {
    if which != '' and book.name != which {
      continue
    }

    if !os.dir_exists(book.pages) {
      continue
    }

    ran += _check(book, filter, @(message) {
      echo message
      failed++
    })
  }

  echo ''
  echo '${ran} examples run, ${failed} failed'

  if failed > 0 {
    os.exit(1)
  }
}

# Runs one set of pages, reporting each failure through `fail` and
# returning how many examples it ran.
def _check(book, filter: string, fail: function) {
  var ran = 0

  for name in _pages(book.pages, filter) {
    var page = os.join_paths(book.pages, name)
    var examples = extract(file(page).read())

    # A reader working through a page has the earlier examples in
    # scope, so an example that only fails on its own is retried with
    # everything above it prepended.
    var earlier = []

    for example in examples {
      ran++

      var result = _run(example.source)
      var continued = false

      # An example that catches its own error still exits cleanly, so
      # "did it run" is not enough to decide whether it needs the rest of
      # the page: a wrong answer is a reason to retry too.
      var wrong = example.expected != nil
        and result.ok
        and result.output.rtrim() != example.expected.rtrim()

      if (!result.ok or wrong) and !earlier.is_empty() {
        var retry = _run('${'\n'.join(earlier)}\n${example.source}')

        if retry.ok {
          result = retry
          continued = true
        }
      }

      if !result.ok {
        fail('${book.name}/${name}:${example.line}  did not run\n    ${result.output.lines()[0]}')
        continue
      }

      earlier.append(example.source)

      if example.expected == nil or _has_placeholder(example.expected) {
        continue
      }

      var expected = example.expected.rtrim()
      var actual = result.output.rtrim()

      # When earlier examples were prepended, their output comes first.
      if continued and actual.ends_with(expected) {
        continue
      }

      if actual != expected {
        fail('${book.name}/${name}:${example.line}  wrong output\n'
          + '    expected: ${expected}\n'
          + '    actual:   ${actual}')
      }
    }
  }

  return ran
}

if __root__ == __file__ {
  main(
    os.args.length() > 2 ? os.args[2] : '',
    os.args.length() > 3 ? os.args[3] : ''
  )
}
