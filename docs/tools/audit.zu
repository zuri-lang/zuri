/**
 * Checks the doc blocks of everything the runtime ships for defects that
 * would reach a reader.
 *
 * Appendices D and E are generated from `libs/`, so a malformed doc block
 * there becomes a malformed page here. The renderer defends against the
 * worst of it, but the stub is the source of truth and is where a problem
 * should be fixed.
 *
 * `cmds/` is held to the same standard, and to one more: a command names
 * and describes itself in its doc block, and `zuri --help` lists it by
 * those two tags and nothing else.
 *
 * Run it on its own, or let `reference.zu` run it for you:
 *
 * ```
 * zuri run docs/tools/audit.zu
 * ```
 *
 * Exits non-zero when anything is reported.
 */

import os
import zuri

import .docs

var ROOT = os.dir_name(os.dir_name(os.dir_name(__file__)))
var LIBS = os.join_paths(ROOT, 'libs')
var CMDS = os.join_paths(ROOT, 'cmds')

# One thing wrong with one doc block.
class Finding {

  @new(path: string, line: number, summary: string, detail: string) {
    self.path = path
    self.line = line
    self.summary = summary
    self.detail = detail
  }

  to_string() {
    return '${self.path}:${self.line}  ${self.summary}\n    ${self.detail}'
  }
}

# Finds the offset just past the `*/` that closes the block opened at
# `start`, or `-1` when nothing closes it.
#
# Zuri block comments nest, so this counts depth rather than stopping at
# the first `*/`: one of the string stubs documents a callback whose own
# example contains `/* ... */`, and a naive scan ends the block there.
def _block_end(source: string, start: number) {
  var depth = 1
  var i = start + 3

  while depth > 0 {
    var open = source.index_of('/*', i)
    var close = source.index_of('*/', i)

    if close < 0 {
      return -1
    }

    if open >= 0 and open < close {
      depth++
      i = open + 2
    } else {
      depth--
      i = close + 2
    }
  }

  return i
}

# Every doc block in `source`, as `{ line, body }`.
def _doc_blocks(source: string) {
  var found = []
  var i = 0

  while true {
    var start = source.index_of('/**', i)

    if start < 0 {
      return found
    }

    var end = _block_end(source, start)

    if end < 0 {
      # An unterminated block is itself worth reporting, and there is
      # nothing after it to scan.
      found.append({ line: _line_of(source, start), body: nil })
      return found
    }

    found.append({
      line: _line_of(source, start),
      body: source[start + 3, end - 2],
    })

    i = end
  }
}

def _line_of(source: string, offset: number) {
  return source[0, offset].count('\n') + 1
}

# The comment furniture stripped from one line of a block body.
def _bare(line: string) {
  var text = line.trim()

  if !text.starts_with('*') {
    return text
  }

  return text[1, text.length()].trim()
}

# The first line of prose in a block, to name it in a report.
def _first_line(body: string) {
  for line in body.split('\n') {
    var text = _bare(line)

    if text != '' and !text.starts_with('@') {
      return text.length() > 60 ? text[0, 60] + '...' : text
    }
  }

  return '(no description)'
}

# Every fenced block in a doc block body, as `{ info, source, line }`.
# The body's own line numbering is relative to the block, which is what
# a report adds to the block's own line to point at the example.
def _fences(body: string) {
  var lines = body.split('\n')
  var found = []
  var i = 0

  while i < lines.length() {
    var opener = _bare(lines[i])

    if !opener.starts_with('```') {
      i++
      continue
    }

    var info = opener[3, opener.length()].trim()
    var start = i + 1
    var end = start

    while end < lines.length() and !_bare(lines[end]).starts_with('```') {
      end++
    }

    var body_lines = []

    iter var j = start; j < end; j++ {
      body_lines.append(_bare(lines[j]))
    }

    found.append({ info, line: i, source: '\n'.join(body_lines) })
    i = end + 1
  }

  return found
}

# A transcript of an interactive session is a dialogue, not a program,
# so it is not expected to parse as one.
def _is_transcript(source: string) {
  return source.ltrim().starts_with('%>')
}

def _fence_count(body: string) {
  var fences = 0

  for line in body.split('\n') {
    if _bare(line).starts_with('```') {
      fences++
    }
  }

  return fences
}

# Checks one file and returns what is wrong with it.
def check_source(path: string, source: string) {
  var findings = []

  for block in _doc_blocks(source) {
    if block.body == nil {
      findings.append(Finding(
        path,
        block.line,
        'doc block is never closed',
        'no matching */, so the rest of the file is inside the comment'
      ))
      continue
    }

    var fences = _fence_count(block.body)

    # An odd number means one fence was opened and never closed. That
    # swallows the block's own tags, and once rendered it swallows every
    # heading after it on the page.
    if fences % 2 != 0 {
      findings.append(Finding(
        path,
        block.line,
        'unbalanced code fence (${fences} markers)',
        _first_line(block.body)
      ))

      # With a fence unaccounted for there is no telling where one
      # example ends and the next begins, so checking them is pointless
      # until that is fixed.
      continue
    }

    # Every Zuri example in the documentation is expected to be Zuri.
    # Running them all is a separate job with separate costs (a socket,
    # a file, a REPL prompt); parsing them costs nothing and catches
    # the example that rotted when the syntax it used moved on.
    for fence in _fences(block.body) {
      if !fence.info.starts_with('zuri') or _is_transcript(fence.source) {
        continue
      }

      if fence.info.contains('ignore') {
        continue
      }

      catch {
        zuri.parse(fence.source)
      } as error {
        findings.append(Finding(
          path,
          block.line + fence.line,
          'example does not parse',
          ' '.join(error.message.lines().map(@(line) => line.trim())).trim()
        ))
      }
    }
  }

  return findings
}

# The command a file under `cmds/` is the entry point for, or `nil` for
# the files a command keeps beside itself. `name` is relative to
# `cmds/`, so `format.zu` and `format/index.zu` both name `format`
# while `format/engine.zu` and `format/tests/tree.zu` name nothing.
def _entry_command(name: string) {
  var enclosing = os.dir_name(name)
  var base = os.base_name(name)

  # A name starting with `_` is private and never a command, however
  # it is spelled: `_shared/`, `_help.zu`, `_help/index.zu`.
  if name.starts_with('_') {
    return nil
  }

  if enclosing == '' or enclosing == '.' {
    if base == 'index.zu' {
      return nil
    }

    return base[0, base.length() - 3]
  }

  # Only a command's own directory counts, never one nested inside it.
  var outer = os.dir_name(enclosing)

  if base == 'index.zu' and (outer == '' or outer == '.') {
    return enclosing
  }

  return nil
}

# Every `.zu` file the audit covers. `command` names the command a file
# is the entry point for, and is `nil` for everything else.
def _sources() {
  var found = []

  for name in os.read_dir(LIBS, true) {
    if name.ends_with('.zu') {
      found.append({
        path: os.join_paths(LIBS, name),
        relative: os.join_paths('libs', name),
        command: nil,
      })
    }
  }

  if !os.dir_exists(CMDS) {
    return found
  }

  for name in os.read_dir(CMDS, true) {
    if !name.ends_with('.zu') {
      continue
    }

    found.append({
      path: os.join_paths(CMDS, name),
      relative: os.join_paths('cmds', name),
      command: _entry_command(name),
    })
  }

  return found
}

# What a command has to say about itself. `zuri --help` reads these two
# tags and nothing else, so a command missing either is a command the
# listing cannot describe.
def check_command(path: string, name: string, source: string) {
  var findings = []
  var blocks = _doc_blocks(source)

  if blocks.is_empty() or blocks[0].body == nil {
    findings.append(Finding(
      path,
      1,
      'command has no doc block',
      'zuri --help reads @command and @description from it'
    ))

    return findings
  }

  var block = docs.parse(blocks[0].body.split('\n'))
  var declared = block.all('command')
  var described = block.all('description')

  if declared.is_empty() {
    findings.append(Finding(path, blocks[0].line, 'command does not name itself',
      'add "@command ${name}" to the doc block'))
  } else if declared[0].text.trim() != name {
    findings.append(Finding(path, blocks[0].line, 'command names itself wrongly',
      '@command says "${declared[0].text.trim()}" but this file answers to "${name}"'))
  }

  if described.is_empty() or described[0].text.trim() == '' {
    findings.append(Finding(path, blocks[0].line, 'command has no description',
      'add "@description <one line>", which is what zuri --help lists'))
  }

  return findings
}

def run() {
  var findings = []

  for source in _sources() {
    var text = file(source.path).read()

    for finding in check_source(source.relative, text) {
      findings.append(finding)
    }

    if source.command != nil {
      for finding in check_command(source.relative, source.command, text) {
        findings.append(finding)
      }
    }
  }

  for finding in findings {
    echo finding.to_string()
  }

  return findings
}

def main() {
  var findings = run()
  var checked = _sources().length()

  echo ''

  if findings.is_empty() {
    echo '${checked} files checked, no problems found'
    return
  }

  echo '${checked} files checked, ${findings.length()} problem${findings.length() == 1 ? '' : 's'} found'
  os.exit(1)
}

if __root__ == __file__ {
  main()
}
