/**
 * Renders parsed stub doc blocks as book appendix pages.
 *
 * The stubs are hard-wrapped narrow to sit comfortably in a source
 * file. Markdown does not care about the source wrapping, but the
 * result reads badly, so every paragraph is unwrapped and re-wrapped
 * at the width the rest of the book uses.
 */

var WIDTH = 72

# Unwraps a run of hard-wrapped lines and re-wraps them at `WIDTH`.
def _wrap(text: string) {
  var words = text.split(' ').filter(@(w) => w != '')
  var lines = []
  var current = ''

  for word in words {
    if current == '' {
      current = word
      continue
    }

    if current.length() + 1 + word.length() <= WIDTH {
      current = '${current} ${word}'
      continue
    }

    lines.append(current)
    current = word
  }

  if current != '' {
    lines.append(current)
  }

  return lines
}

# True for a line markdown treats structurally, which must survive
# reflowing exactly as written.
def _is_literal(line: string) {
  var text = line.trim()

  if text == '' {
    return true
  }

  return text.starts_with('#')
    or text.starts_with('>')
    or text.starts_with('|')
    or text.starts_with('- ')
    or text.starts_with('* ')
    or text.starts_with('```')
}

# Reflows a block of markdown, leaving fenced code and structural
# lines untouched.
def reflow(lines: list) {
  var out = []
  var paragraph = []
  var in_fence = false

  def flush() {
    if paragraph.is_empty() {
      return
    }

    for line in _wrap(' '.join(paragraph)) {
      out.append(line)
    }

    paragraph.clear()
  }

  for line in lines {
    var text = line.trim()

    if text.starts_with('```') {
      flush()
      in_fence = !in_fence

      # The stubs tag their examples `zuri-repl`. They are interactive
      # transcripts rather than programs, so they are highlighted as Zuri
      # but marked unrunnable.
      out.append(in_fence and text.starts_with('```zuri') ? '```zuri,ignore' : text)
      continue
    }

    if in_fence {
      out.append(line)
      continue
    }

    if _is_literal(line) {
      flush()
      out.append(text)
      continue
    }

    paragraph.append(text)
  }

  flush()

  # A doc block whose own fence was never closed would otherwise emit an
  # unterminated fence, swallowing every heading after it on the page.
  if in_fence {
    out.append('```')
  }

  return out
}

# Collapses the blank lines a reflow can leave doubled up.
def _squeeze(lines: list) {
  var out = []
  var blank = false

  for line in lines {
    if line.trim() == '' {
      if blank or out.is_empty() {
        continue
      }

      blank = true
      out.append('')
      continue
    }

    blank = false
    out.append(line)
  }

  while !out.is_empty() and out[out.length() - 1] == '' {
    out.pop()
  }

  return out
}

def _code(type: string) {
  return type == '' ? '' : '`${type}`'
}

# The one-line signature that heads every entry.
def _signature(member, receiver: string) {
  var returns = member.first_tag('returns')
  var suffix = returns != nil and returns.type != '' ? ' -> ${returns.type}' : ''
  return '${receiver}${member.signature()}${suffix}'
}

def render_member(member, receiver: string) {
  var out = []

  out.append('## `${member.name}()`')
  out.append('')
  out.append('```zuri,ignore')
  out.append(_signature(member, receiver))
  out.append('```')
  out.append('')

  for line in reflow(member.body) {
    out.append(line)
  }

  out.append('')

  var params = member.tags_of('param')

  if !params.is_empty() {
    out.append('**Parameters**')
    out.append('')

    for tag in params {
      var type = _code(tag.type)
      var head = type == '' ? '`${tag.label}`' : '`${tag.label}` (${type})'
      var line = tag.text == '' ? '- ${head}' : '- ${head} — ${tag.text}'

      for wrapped in _wrap_bullet(line) {
        out.append(wrapped)
      }
    }

    out.append('')
  }

  var returns = member.first_tag('returns')

  if returns != nil {
    var type = _code(returns.type)
    var head = type == '' ? '**Returns**' : '**Returns** ${type}'

    if returns.text == '' {
      out.append(head)
    } else {
      for wrapped in _wrap('${head} — ${returns.text}') {
        out.append(wrapped)
      }
    }

    out.append('')
  }

  for tag in member.tags_of('throws') {
    var type = _code(tag.type)
    var head = type == '' ? '**Raises**' : '**Raises** ${type}'

    for wrapped in _wrap('${head} ${tag.text}') {
      out.append(wrapped)
    }

    out.append('')
  }

  for tag in member.tags_of('note') {
    for wrapped in _wrap('**Note:** ${tag.text}') {
      out.append('> ${wrapped}')
    }

    out.append('')
  }

  return _squeeze(out)
}

# Wraps a bullet, indenting the continuation under the text.
def _wrap_bullet(line: string) {
  var wrapped = _wrap(line)
  var out = []

  iter var i = 0; i < wrapped.length(); i++ {
    out.append(i == 0 ? wrapped[i] : '  ${wrapped[i]}')
  }

  return out
}

# The table of contents that opens each page.
def _index(members: list, heading: string) {
  var out = []

  out.append('| ${heading} | Returns | Summary |')
  out.append('| --- | --- | --- |')

  for member in members {
    var returns = member.first_tag('returns')
    var type = returns == nil ? '' : _escape(_code(returns.type))
    out.append('| [`${_escape(member.signature())}`](#${member.anchor()}) | ${type} | ${_summary(member)} |')
  }

  return out
}

# The first sentence of a member's description, for the index table.
def _summary(member) {
  var text = ''

  for line in member.body {
    var trimmed = line.trim()

    if trimmed == '' or trimmed.starts_with('```') {
      break
    }

    text = text == '' ? trimmed : '${text} ${trimmed}'
  }

  # A hard break belongs in the body, never inside a table cell.
  text = text.replace('/<br\s*\/?>/', ' ').trim()

  var stop = text.index_of('. ')

  if stop > 0 {
    text = text[0, stop + 1]
  }

  return _escape(text)
}

# A table cell cannot hold a bare `|`, and union types such as
# `number|list` are full of them.
def _escape(text: string) {
  return text.replace('/\|/', '\\|')
}

# Stub prose links to its own overview, which is not part of the generated
# reference: a bare `#section` anchor would resolve to nothing, and a
# `./page` path to a site the stubs were written for. Point both at the
# book page that carries the same narrative.
var _STUB_LINKS = {
  './dictionaries': 'ch04-04-dictionaries.md',
  './lists': 'ch04-03-lists.md',
  './strings': 'ch04-01-strings.md',
  './numbers': 'ch04-02-numbers.md',
  './ranges': 'ch04-05-ranges-and-iteration.md',
  './bytes': 'ch10-00-binary-data.md',
  './files': 'ch09-00-files.md',
}

def _relink(lines: list, chapter: string) {
  return lines.map(@(line) {
    var fixed = line.replace('](#', '](${chapter}#', false)

    for target, page in _STUB_LINKS {
      fixed = fixed.replace('](${target})', '](${page})', false)
    }

    return fixed
  })
}

def render_type_page(spec, members: list) {
  var out = []

  out.append('# ${spec.title}')
  out.append('')

  for line in _wrap(
    'Every method on the built-in `${spec.stub}` type, with its '
    + 'signature, what it returns, and the cases where it does '
    + 'something other than the obvious thing.'
  ) {
    out.append(line)
  }

  out.append('')

  for line in _index(members, 'Method') {
    out.append(line)
  }

  out.append('')

  for member in members {
    for line in _relink(render_member(member, ''), spec.chapter) {
      out.append(line)
    }

    out.append('')
  }

  return '${'\n'.join(_squeeze(out))}\n'
}

def render_builtins_page(functions: list) {
  var out = []

  out.append('# Appendix D: Built-in Functions')
  out.append('')

  for line in _wrap(
    'These functions are available in every file with no import. '
    + 'They are the parts of the language that happen to be spelled '
    + 'as calls rather than as syntax.'
  ) {
    out.append(line)
  }

  out.append('')

  for line in _index(functions, 'Function') {
    out.append(line)
  }

  out.append('')

  for fn in functions {
    for line in render_member(fn, '') {
      out.append(line)
    }

    out.append('')
  }

  return '${'\n'.join(_squeeze(out))}\n'
}

# Appendix E's own front page: the table that points at the per-type
# pages, with counts taken from what was actually generated so they
# cannot drift.
def render_index_page(types: list, counts: dict) {
  var out = []

  out.append('# Appendix E: Built-in Type Methods')
  out.append('')

  for line in _wrap(
    'Every method on every built-in type, with its signature, what it '
    + 'returns, and its edge cases. This is the reference; the chapters '
    + 'in [Text, Numbers and Collections](ch04-00-collections.md) are '
    + 'the introduction.'
  ) {
    out.append(line)
  }

  out.append('')
  out.append('Methods are called with a dot, on the value itself:')
  out.append('')
  out.append('```zuri')
  out.append("echo 'zuri'.upper()")
  out.append('echo 255.hex()')
  out.append('echo [3, 1, 2].sort()')
  out.append('```')
  out.append('')
  out.append('```console')
  out.append('ZURI')
  out.append('ff')
  out.append('[1, 2, 3]')
  out.append('```')
  out.append('')
  out.append('| Type | Methods | Page |')
  out.append('| --- | --- | --- |')

  for spec in types {
    out.append('| `${spec.stub}` | ${counts[spec.stub]} | [${spec.title}](${spec.page}) |')
  }

  # `function` has no stub of its own: its methods live in the runtime
  # rather than in `libs/`, so that page is written by hand.
  out.append('| `function` | 5 | [Function Methods](appendix-05-10-function.md) |')
  out.append('')

  for line in [
    '## What Is Not Listed Here',
    '',
    '**`@key` and `@value`** exist on every iterable built-in type, which is',
    'what makes `for ... in` work on them. They are documented as a protocol',
    'in [Appendix C](appendix-03-decorators.md) rather than repeated on every',
    'page.',
    '',
    '**`to_string()`** exists on every value, `nil` included.',
    '',
    '**Class instances** carry whatever their class declares, plus',
    '`to_string()`. See [Classes and Objects](ch06-00-classes.md).',
    '',
    '**Module members** are not methods. See',
    '[Appendix F](appendix-06-stdlib-index.md).',
    '',
    '## Conventions in These Pages',
    '',
    'A parameter written `name: ?type` is optional. A parameter written',
    '`...name` is variadic. A parameter with no type shown takes any value.',
    '',
    'A method that **mutates** its receiver says so. Where a type has both,',
    'the distinction matters: `list.sort()` mutates and returns the list,',
    'while `list.reverse()` returns a new list and leaves the original',
    'alone.',
  ] {
    out.append(line)
  }

  return '${'\n'.join(_squeeze(out))}\n'
}
