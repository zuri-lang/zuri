/**
 * Parses the doc blocks in a standard library stub file.
 *
 * Finding the blocks and the declarations they belong to is the
 * `zuri` module's job. `zuri.parse()` keeps every doc block in the
 * tree as a node sitting right before whatever it documents, so both
 * the pairing and the signatures come from the parser rather than
 * from guessing at source text.
 *
 * What is left for this file is the body of a block. A block is free
 * markdown followed by a run of `@tag` lines, and a tag's text may
 * wrap onto following lines, which are recognised by their
 * indentation. Losing those continuations truncates the sentence, so
 * the wrapping rule is the part of this parser that matters most.
 */

import zuri

# A single `@tag` from a doc block, already unwrapped into one string.
#
# `kind` is the tag name without its `@`, normalised so that the
# aliases the stubs use (`@return` for `@returns`, `@raises` for
# `@throws`) collapse onto one spelling.
class Tag {

  @new(kind: string, type: string, label: string, text: string) {
    self.kind = kind
    self.type = type
    self.label = label
    self.text = text
  }
}

# One documented member: a method on a built-in type, or a built-in
# function. `body` is the markdown prose and `params` is the real
# parameter list the parser produced, not a slice of source text.
class Member {

  @new(name: string, params: list, body: list, tags: list) {
    self.name = name
    self.params = params
    self.body = body
    self.tags = tags
  }

  # The signature as it appears in a heading, e.g. `lpad(width, fill)`.
  signature() {
    return '${self.name}(${', '.join(self.params)})'
  }

  # The anchor mdBook generates for this member's heading.
  anchor() {
    return self.name
  }

  tags_of(kind: string) {
    return self.tags.filter(@(t) => t.kind == kind)
  }

  first_tag(kind: string) {
    var found = self.tags_of(kind)
    return found.is_empty() ? nil : found[0]
  }
}

# Strips the comment furniture from one line of a doc block, keeping
# whatever indentation followed the `*`. That indentation is what marks
# a tag continuation, so it cannot be trimmed away here.
def _strip_star(line: string) {
  var text = line.ltrim()

  if !text.starts_with('*') {
    return text
  }

  text = text[1, text.length()]

  if text.starts_with(' ') {
    return text[1, text.length()]
  }

  return text
}

# Splits `{type} label rest` off the front of a tag's text. Stubs write
# the type in braces, sometimes omit it, and sometimes separate the
# label from the description with a dash.
def _split_tag(kind: string, text: string) {
  var type = ''
  var rest = text

  if rest.starts_with('{') {
    var close = rest.index_of('}')

    if close > 0 {
      type = rest[1, close]
      rest = rest[close + 1, rest.length()].ltrim()
    }
  }

  var label = ''

  # Only the tags that name something take a label. A `@note` or a
  # `@returns` description starts immediately.
  if kind == 'param' {
    var space = rest.index_of(' ')

    if space < 0 {
      label = rest
      rest = ''
    } else {
      label = rest[0, space]
      rest = rest[space + 1, rest.length()].ltrim()
    }

    if rest.starts_with('- ') {
      rest = rest[2, rest.length()].ltrim()
    }

    # Some blocks write `@param type name: description`.
    if label.ends_with(':') {
      label = label[0, label.length() - 1]
    }
  }

  # A bare `@param ...number values` writes the type where the label
  # would be. Recover it rather than printing a type as a name.
  if kind == 'param' and type == '' and label != '' {
    if TYPE_WORDS.contains(label.replace('/^\.\.\./', '')) {
      var space = rest.index_of(' ')
      type = label

      if space < 0 {
        label = rest
        rest = ''
      } else {
        label = rest[0, space]
        rest = rest[space + 1, rest.length()].ltrim()
      }
    }
  }

  return Tag(kind, type, label, rest)
}

var TYPE_WORDS = [
  'any', 'number', 'int', 'string', 'list', 'dict', 'bool', 'boolean',
  'bytes', 'file', 'function', 'range', 'bigint', 'instance', 'class',
  'iterable', 'void', 'nil',
]

var TAG_ALIASES = {
  'return': 'returns',
  'raises': 'throws',
  'params': 'param',
}

# Turns the raw lines of a doc block into prose plus tags.
#
# Everything before the first tag is prose. Once tags start, a line
# that begins with whitespace continues the tag above it; a line that
# begins with `@` starts a new one. Fenced code is copied through
# untouched wherever it appears.
def parse_block(lines: list) {
  var body = []
  var tags = []
  var current = nil
  var in_fence = false

  iter var i = 0; i < lines.length(); i++ {
    var raw = _strip_star(lines[i])
    var text = raw.trim()

    if text.starts_with('```') {
      in_fence = !in_fence

      if current != nil {
        current = nil
      }

      body.append(raw)
      continue
    }

    if in_fence {
      body.append(raw)
      continue
    }

    if text.starts_with('@') {
      var space = text.index_of(' ')
      var kind = space < 0 ? text[1, text.length()] : text[1, space]
      var rest = space < 0 ? '' : text[space + 1, text.length()].ltrim()

      kind = TAG_ALIASES.get(kind, kind)
      current = { kind, text: rest }
      tags.append(current)
      continue
    }

    # An indented, non-empty line right after a tag is that tag's
    # continuation. This is the case the previous generator missed.
    if current != nil and text != '' and raw.starts_with(' ') {
      current.text = current.text == '' ? text : '${current.text} ${text}'
      continue
    }

    if text == '' {
      current = nil
    }

    if current == nil {
      body.append(raw)
    }
  }

  return {
    body: _tidy(body),
    tags: tags.map(@(t) => _split_tag(t.kind, t.text)),
  }
}

# Drops the blank lines that top and tail every block.
def _tidy(lines: list) {
  var start = 0
  var end = lines.length()

  while start < end and lines[start].trim() == '' {
    start++
  }

  while end > start and lines[end - 1].trim() == '' {
    end--
  }

  return lines[start, end]
}

# Renders one parameter node the way the stub's own source spells it.
def _param(node, variadic: bool) {
  var hint = node.fields.type_hint
  var name = node.fields.name

  if variadic {
    name = '...${name}'
  }

  if hint == nil {
    return name
  }

  var types = hint.fields.types.map(@(t) => t.kind.lower())

  # An unannotated parameter parses as a nullable `any`, which is the
  # absence of an annotation rather than something to print.
  if types.length() == 1 and types[0] == 'any' {
    return name
  }

  var prefix = hint.fields.nullable ? '?' : ''
  return '${name}: ${prefix}${'|'.join(types)}'
}

def _params_of(node) {
  var params = node.fields.parameters
  var variadic = node.fields.get('is_variadic', false)
  var out = []

  iter var i = 0; i < params.length(); i++ {
    out.append(_param(params[i], variadic and i == params.length() - 1))
  }

  return out
}

# Walks a list of sibling nodes, pairing each declaration with the doc
# block that precedes it. A declaration with no doc block above it is
# undocumented and does not belong in the reference.
def _members(nodes: list, kind: string) {
  var members = []
  var pending = nil

  for node in nodes {
    if node.kind == 'DocBlock' {
      pending = node.fields.text.split('\n')
      continue
    }

    if node.kind == kind and pending != nil {
      var parsed = parse_block(pending)
      members.append(Member(node.fields.name, _params_of(node), parsed.body, parsed.tags))
    }

    # Anything else between a block and a declaration breaks the
    # pairing, including a plain `#` comment.
    pending = nil
  }

  return members
}

def parse_members(source: string) {
  var members = []

  for node in zuri.parse(source) {
    if node.kind == 'Class' {
      for member in _members(node.fields.methods, 'Method') {
        members.append(member)
      }
    }
  }

  return members
}

# Every documented free function, for the built-ins appendix.
def parse_functions(source: string) {
  return _members(zuri.parse(source), 'Function')
}
