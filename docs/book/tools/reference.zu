/**
 * Generates the built-in reference appendices from the standard
 * library stubs in `libs/`.
 *
 * The stubs are the single source of truth for what a built-in
 * method does. This script reads their doc blocks and renders them
 * as the book's Appendix D and Appendix E, so the reference can
 * never drift from the documentation the runtime itself ships.
 *
 * Run it from the repository root:
 *
 * ```
 * zuri docs/book/tools/reference.zu
 * ```
 */

import os
import io
import .docblock { * }
import .render { * }
import .audit

var ROOT = os.dir_name(os.dir_name(os.dir_name(os.dir_name(__file__))))
var STUBS = os.join_paths(ROOT, 'libs')
var OUT = os.join_paths(ROOT, 'docs', 'book', 'src')

# Appendix E is split one page per type. The order here is the order
# the pages appear in SUMMARY.md, and it runs from the types a reader
# meets first to the ones they meet last.
var TYPES = [
  { stub: 'string',  page: 'appendix-05-01-string.md',  title: 'String Methods',     chapter: 'ch04-01-strings.md' },
  { stub: 'number',  page: 'appendix-05-02-number.md',  title: 'Number Methods',     chapter: 'ch04-02-numbers.md' },
  { stub: 'bigint',  page: 'appendix-05-03-bigint.md',  title: 'Bigint Methods',     chapter: 'ch04-02-numbers.md' },
  { stub: 'bool',    page: 'appendix-05-04-bool.md',    title: 'Boolean Methods',    chapter: 'ch03-02-data-types.md' },
  { stub: 'list',    page: 'appendix-05-05-list.md',    title: 'List Methods',       chapter: 'ch04-03-lists.md' },
  { stub: 'dict',    page: 'appendix-05-06-dict.md',    title: 'Dictionary Methods', chapter: 'ch04-04-dictionaries.md' },
  { stub: 'range',   page: 'appendix-05-07-range.md',   title: 'Range Methods',      chapter: 'ch04-05-ranges-and-iteration.md' },
  { stub: 'bytes',   page: 'appendix-05-08-bytes.md',   title: 'Bytes Methods',      chapter: 'ch10-00-binary-data.md' },
  { stub: 'file',    page: 'appendix-05-09-file.md',    title: 'File Methods',       chapter: 'ch09-00-files.md' },
]

def main() {
  # The stubs are the source of truth, so a defect there is reported
  # before the pages that come from them. Generation still runs: the
  # renderer is defensive enough to produce a usable page either way, and
  # a stale appendix helps nobody. The non-zero exit is the signal.
  var findings = audit.run()

  var counts = {}

  iter var i = 0; i < TYPES.length(); i++ {
    var spec = TYPES[i]
    var source = file(os.join_paths(STUBS, '_${spec.stub}.stub.zu')).read()
    var entries = parse_members(source)

    counts[spec.stub] = entries.length()

    var page = render_type_page(spec, entries)
    file(os.join_paths(OUT, spec.page), 'w').write(page)

    echo '${spec.page}: ${entries.length()} methods'
  }

  file(os.join_paths(OUT, 'appendix-05-type-methods.md'), 'w').write(render_index_page(TYPES, counts))

  var builtins = parse_functions(file(os.join_paths(STUBS, '_builtins.stub.zu')).read())
  file(os.join_paths(OUT, 'appendix-04-builtins.md'), 'w').write(render_builtins_page(builtins))

  echo 'appendix-04-builtins.md: ${builtins.length()} functions'

  if !findings.is_empty() {
    echo ''
    var count = findings.length()
    var subject = count == 1 ? '1 stub problem' : '${count} stub problems'

    echo 'generated, but ${subject} above ${count == 1 ? 'needs' : 'need'} fixing'
    os.exit(1)
  }
}

if __root__ == __file__ {
  main()
}
