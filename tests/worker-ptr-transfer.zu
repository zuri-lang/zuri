import worker
import compress.gzip

def compress_it(enc) {
  enc.write('hello from a worker, compressed on another thread')
  return enc.finish()
}

var enc = gzip.GzipEncoder(6)
var t = worker.spawn(compress_it, enc)
var result = t.join()
echo result.length() > 0

# the source encoder was MOVED, not copied; using it again fails
# cleanly instead of corrupting anything or crashing
catch {
  enc.write('should not work anymore')
} as e
if e {
  echo e.type
}
