# When a list is handed to a function and indexed inside a loop, the
# compiler bets on what the list holds: nothing but whole numbers, so a
# value read out of it can go straight into an index with no check of
# its own. The bet is checked by walking the list once on the way in,
# which is what these cover, in all three directions it can go wrong:
# the list turning out to hold a fraction, two parameters turning out
# to name one list, and the list picking up a fraction long after the
# loop is already running compiled.

def gather(values, indices, n, reps) {
  var total = 0.0

  iter var r = 0; r < reps; r++ {
    iter var i = 0; i < n; i++ {
      total += values[indices[i]]
    }
  }

  return total
}

# Two lists written through one, then read back as indices through the
# other. Nothing in the body says they are the same list, so the entry
# guard is the only thing that can notice.
def alias_probe(sink, idx, data, n) {
  var total = 0.0

  iter var i = 0; i < n; i++ {
    sink[i % 4] = i + 0.5
    total += data[idx[i % 4]]
  }

  return total
}

# The fraction only starts going in well past the point the loop has
# been compiled and re-entered, so an entry check alone never sees it.
def late_alias(idx, data, n, flag) {
  var copy = data

  if flag {
    copy = idx
  }

  var total = 0.0

  iter var i = 0; i < n; i++ {
    if i > 150_000 {
      copy[i % 4] = (i % 4) + 0.5
    }

    total += data[idx[i % 4]]
  }

  return total
}

# One list under two names. Nothing in the body says they are the same
# list, so the claim has to belong to the list rather than to either
# name, or the store through `copy` leaves `own` still claiming whole
# numbers. The fraction goes in long after the loop is compiled.
def own_alias(n, flag) {
  var own = [0, 1, 2, 3]
  var copy = own

  if !flag {
    copy = [0, 0, 0, 0]
  }

  var total = 0

  iter var i = 0; i < n; i++ {
    if i > 150_000 {
      copy[1] = 2.5
    }

    total += TABLE[own[1]]
  }

  return total
}

const TABLE = [10, 20, 30, 40]

var data = [10.5, 20.25, 30.125, 40.0625]
var idx = [0, 1, 2, 3]

echo gather(data, idx, 4, 200_000)

# Same function, same shape of argument, but one element is not whole.
var bad = [0, 1, 2.5, 3]
catch {
  echo gather(data, bad, 4, 200_000)
} as e {
  echo 'gather raised: ${e.message}'
}

var a = [0, 1, 2, 3]
var b = [0, 1, 2, 3]
echo alias_probe(a, b, data, 200_000)

var shared = [0, 1, 2, 3]
catch {
  echo alias_probe(shared, shared, data, 200_000)
} as e {
  echo 'alias raised: ${e.message}'
}

var m = [0, 1, 2, 3]
catch {
  echo late_alias(m, data, 200_000, true)
} as e {
  echo 'late raised: ${e.message}'
}

catch {
  echo own_alias(200_000, true)
} as e {
  echo 'own alias raised: ${e.message}'
}

# Arithmetic is not inert: `+`, `*` and `<` all fall back to a
# user-defined operator override when an operand is not a builtin
# value, and an override is ordinary Zuri code. One that writes a
# fraction into a list the compiled caller is holding has to end the
# claim on that list, wherever in the loop it runs.
class Poker {
  @new(target) {
    self.target = target
  }

  @add(other) {
    self.target[1] = 2.5
    return 1
  }

  # Hands back the caller's own array rather than a product, so the
  # store below goes through that array under a different name.
  @mul(other) {
    return self.target
  }

  @lt(other) {
    self.target[1] = 2.5
    return false
  }
}

def override_probe(idx, data, poker, n) {
  var total = 0
  var junk = 0

  iter var i = 0; i < n; i++ {
    if i == 150_000 {
      junk = poker + 1
    }

    total += data[idx[1]]
  }

  return total + junk
}

def compare_probe(idx, data, poker, n) {
  var total = 0

  iter var i = 0; i < n; i++ {
    if i == 150_000 {
      if poker < 1 {
        total += 0
      }
    }

    total += data[idx[1]]
  }

  return total
}

def mul_alias_probe(idx, data, poker, n) {
  var total = 0

  iter var i = 0; i < n; i++ {
    if i == 150_000 {
      var aliased = poker * 2
      aliased[1] = 2.5
    }

    total += data[idx[1]]
  }

  return total
}

var over = [0, 1, 2, 3]
catch {
  echo override_probe(over, TABLE, Poker(over), 200_000)
} as e {
  echo 'override raised: ${e.message}'
}

var compared = [0, 1, 2, 3]
catch {
  echo compare_probe(compared, TABLE, Poker(compared), 200_000)
} as e {
  echo 'compare raised: ${e.message}'
}

var aliased = [0, 1, 2, 3]
catch {
  echo mul_alias_probe(aliased, TABLE, Poker(aliased), 200_000)
} as e {
  echo 'mul alias raised: ${e.message}'
}
