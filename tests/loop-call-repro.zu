def identity(x) {
  return x
}

def run(n) {
  const marker = "hello"
  var i = 0
  iter ; i < n; i += 1 {
    var m = identity(marker)
    if (m != "hello") {
      echo 'BUG at i=${i}: got ${m}'
      return
    }
  }
  echo 'ok, checked ${n} iterations'
}

# Raised so the loop outlasts the background compile; at the old count
# the script exited before the compiled entry was ever installed.
run(500000)
