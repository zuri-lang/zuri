var message = "antigravity"
var len = message.length()

def collect_chars(text) {
  var out = []
  iter var i = 0; i < text.length(); i++ {
    out.append(text[i])
  }
  return out
}

# Run hot so the compiled tier's string indexing is what fills the list.
# Every round rebuilds from the same string, so the result does not depend
# on how many rounds run; only on `message`.
var char_codes = []
iter var r = 0; r < 100000; r++ {
  char_codes = collect_chars(message)
}

# Hardware srem test (including negative values)
var rem1 = 17 % 5
var rem2 = -17 % 5
var rem3 = 17 % -5
var rem4 = -17 % -5

var global_counter = 0

def leaf_increment(step) {
  global_counter = global_counter + step
  return global_counter
}

# Ten calls never reached the compiled tier, so the leaf-call inlining
# this fixture is named for went unexercised.
iter var k = 0; k < 200000; k++ {
  leaf_increment(k)
}

echo "Chars: ${char_codes.length()}"
echo "Rem: ${rem1}, ${rem2}, ${rem3}, ${rem4}"
echo "Final counter: ${global_counter}"
