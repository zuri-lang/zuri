/**
 * A dictionary field read compiles to the same instruction as an
 * instance field read, so a field name that exactly one class declares
 * is no evidence at all about what a receiver is. Betting on the class
 * anyway produces a guard that cannot pass, and a guard that cannot
 * pass hands every call back to the interpreter.
 *
 * The loop below runs both shapes past the tier-up threshold: the same
 * field name read off dictionaries, where the bet is always wrong, and
 * off real instances, where it is always right. Compiled code for
 * `total_from_dicts` gets thrown away and rebuilt part-way through, so
 * the answers have to hold across that too.
 */

class Reading {
  var kelvin = 0
  var scale = ''

  @new(kelvin) {
    self.kelvin = kelvin
    self.scale = 'K'
  }

  describe() {
    return '${self.kelvin}${self.scale}'
  }
}

# A live instance in a global is what gets `kelvin` seen as a numeric
# field, which is what makes the speculating body get built at all.
var probe = Reading(300)

/**
 * Reads `kelvin` off plain dictionaries. No instance ever reaches this.
 */
def total_from_dicts(samples) {
  var total = 0

  iter var i = 0; i < samples.length(); i++ {
    var sample = samples[i]
    total += sample.kelvin + sample.offset
  }

  return total
}

/**
 * The same field name, read off real instances.
 */
def total_from_instances(readings) {
  var total = 0

  iter var i = 0; i < readings.length(); i++ {
    total += readings[i].kelvin
  }

  return total
}

var samples = [
  { kelvin: 300, offset: 1 },
  { kelvin: 310, offset: 2 },
  { kelvin: 320, offset: 3 },
]

var readings = [Reading(100), Reading(200), Reading(300)]

var rounds = 30000
var dict_total = 0
var instance_total = 0

iter var round = 0; round < rounds; round++ {
  var from_dicts = total_from_dicts(samples)
  if from_dicts != 936 {
    raise Error('round ${round}: dict total ${from_dicts}, expected 936')
  }

  var from_instances = total_from_instances(readings)
  if from_instances != 600 {
    raise Error('round ${round}: instance total ${from_instances}, expected 600')
  }

  dict_total += from_dicts
  instance_total += from_instances
}

if dict_total != 936 * rounds {
  raise Error('dict total ${dict_total}, expected ${936 * rounds}')
}

if instance_total != 600 * rounds {
  raise Error('instance total ${instance_total}, expected ${600 * rounds}')
}

# The dictionaries stay dictionaries and the instances stay instances.
if samples[0].kelvin != 300 or samples[2].offset != 3 {
  raise Error('samples corrupted: ${samples}')
}

if probe.describe() != '300K' or readings[1].describe() != '200K' {
  raise Error('instances corrupted: ${probe.describe()} ${readings[1].describe()}')
}

echo 'deopt site feedback: ${rounds} rounds, dicts ${dict_total}, instances ${instance_total}'
