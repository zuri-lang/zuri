class Counter {
    @new() {
        self.count = 0
    }
    increment() {
        self.count = self.count + 1
    }
    getCount() {
        return self.count
    }
}
def countWithSelfInIterDirect(n) {
    const counter = Counter()
    iter var i = 0; i < n; i = i + 1 {
        counter.increment()
    }
    return counter.getCount()
}

echo countWithSelfInIterDirect(1000)