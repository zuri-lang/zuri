/* IntFacts' counterpart to list-shape-register-reuse.zu -- same bug
 * class, same fix (jit::typeflow's any_dst-based catch-all). A register
 * proven a whole number, then reassigned via Div (not covered by the
 * old conservative_dst/comparison_or_never_numeric_dst pair) to a
 * genuinely fractional value, kept the stale "is int" fact -- so
 * emit_list_get_index's idx_proven_int flag skipped the float-roundtrip
 * check and silently truncated a fractional index instead of raising.
 * Not a crash like the list-shape case (the fast path still bounds-
 * checks and loads a real list element), just a silent wrong answer --
 * still a real correctness bug. Run past the JIT tiering threshold.
 */

def reuse_after_int(bad) {
  var x = 4
  var probed = x + 1
  if bad {
    x = 7 / 2
  }
  var lst = [10, 20, 30, 40, 50]
  return lst[x]
}

var i = 0
while i < 300000 {
  reuse_after_int(false)
  i = i + 1
}

catch {
  reuse_after_int(true)
} as e
echo e.message
