# Regression test: a string interpolation literal used directly as the
# left operand of a binary operator must not swallow that operator (and
# its right-hand side) into its own internal concatenation chain.
#
# `Parser::interpolation` builds an interpolated string by looping and
# calling the full-precedence `self.expression()` for every trailing
# text segment, not just for the `${...}` expressions themselves. Since
# a plain `Literal` token (the static text up to the string's closing
# quote) was fed through that same full-precedence call, anything
# immediately following the string's closing quote -- `== y`, `!= y`,
# `and y`, `or y` -- got parsed as PART OF the interpolated string's own
# expression chain instead of being left for the outer expression to
# consume. `'--${x}' == y` silently became the STRING `'--' + x + ('' ==
# y)`, i.e. string-concatenated with the stringified boolean, rather
# than the boolean comparison it looks like. This broke real code: an
# args-module option-name lookup (`'--${opt.long_name}' == name`)
# matched the first option in the list nearly unconditionally, no
# matter what flag was actually typed.

var x = 'AAAA'
var y = '--BBBB'

echo 'equality does not swallow the operator:'
echo typeof('--${x}' == y)
echo ('--${x}' == y)
echo ('--${x}' == '--AAAA')

echo 'inequality does not swallow the operator:'
echo typeof('--${x}' != y)
echo ('--${x}' != y)
echo ('--${x}' != '--AAAA')

echo 'works when embedded directly in a condition:'
if '--${x}' == '--AAAA' {
  echo 'matched correctly'
} else {
  echo 'did not match (unexpected)'
}

echo 'a trailing static suffix after the interpolation still works:'
echo typeof('--${x}Z' == y)
echo ('--${x}Z' == '--AAAAZ')

echo 'multiple interpolations in one string still concatenate correctly:'
var a = 'A'
var b = 'B'
echo '${a}mid${b}end'
echo ('${a}mid${b}end' == 'AmidBend')

echo 'plain concatenation with + still works (this direction was never broken):'
echo ('--${x}' + 'z')
