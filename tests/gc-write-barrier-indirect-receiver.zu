# Write-barrier coverage for a receiver reached INDIRECTLY, which
# `gc-write-barrier-stress.zu` deliberately does not cover.
#
# That test mutates containers held directly in globals. A global is a
# GC root, so a minor collection reaches its young children by ordinary
# tracing whether or not the remembered set knows about the store --
# which means a missing write barrier on those sites stays invisible.
#
# Here the mutated objects are only reachable THROUGH a list, and the
# store goes through an arbitrary receiver register (`roots[i].kid = ...`)
# rather than through `self`. That is the shape where the remembered set
# is genuinely load-bearing: drop the barrier on either the `self.field`
# or the general `obj.field` JIT fast path and this test reports a wrong
# total, varying from run to run as collection timing shifts.

class Node {
  @new(tag) {
    self.tag = tag
    self.kid = nil
  }

  sum() {
    if self.kid == nil {
      return self.tag
    }
    return self.tag + self.kid.sum()
  }
}

var roots = []
iter var i = 0; i < 64; i++ {
  roots.append(Node(i))
}

# Churns throwaway garbage hard enough to force repeated minor
# collections, which is also what promotes `roots` and everything in it
# into the old generation. Mutates `self.kid` on its own short-lived
# nodes too, so the `self.field` fast path is exercised alongside the
# general one below.
def churn(n) {
  var junk = 0
  iter var i = 0; i < n; i++ {
    var t = Node(i)
    t.kid = Node(i + 1)
    junk += t.sum()
  }
  return junk
}

churn(20000)

var errors = 0
iter var round = 0; round < 60; round++ {
  # The old -> young store this test exists for.
  iter var i = 0; i < 64; i++ {
    roots[i].kid = Node(round * 1000 + i)
  }

  # More collections, now that the young nodes are referenced ONLY from
  # already-promoted parents.
  churn(4000)

  iter var i = 0; i < 64; i++ {
    if roots[i].sum() != 2 * i + round * 1000 {
      errors += 1
    }
  }
}

echo 'errors: ${errors}'
echo 'final: ${roots[0].sum()} ${roots[63].sum()}'
