class Box {
  @new(n) {
    self.n = n
  }
}

var d = {}
var keys = []
# Raised so the loop outlasts the background compile; at the old count
# the script exited before the compiled entry was ever installed.
var n = 200000

iter var i = 0; i < n; i++ {
  var k = Box(i)
  keys.append(k)
  d[k] = i * 2
  var junk = [i, i + 1, i + 2, "junk" + i.to_string()]
}

echo 'done'
