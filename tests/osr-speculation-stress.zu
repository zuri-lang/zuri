# h's first parameter is sometimes numeric, sometimes a string, across
# DIFFERENT recursive invocations; whichever invocation happens to
# trigger compilation (ordinary call OR OSR, race-dependent) seeds the
# speculative sample. Later/sibling invocations with the OPPOSITE type
# must still get correct results if their own execution reaches an
# already-compiled entry via OSR while running with a mismatched type.
# The loop itself stays purely numeric (bounded cost) regardless of
# `n`'s type; `n` only feeds `sum`'s SEED, so a mismatched `n` still
# exercises the guard without blowing up into pathological string
# growth.
def h(n, depth) {
  if depth <= 0 {
    return n
  }
  var sum = 0
  if is_number(n) {
    sum = n
  }
  var i = 0
  while i < 150000 {
    sum = sum + 1
    i = i + 1
  }
  var next_n = depth
  if depth % 3 == 0 {
    next_n = "sometimes-a-string"
  }
  return sum + h(next_n, depth - 1)
}

echo h(1, 20)
