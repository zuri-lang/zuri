def identity(x) { return x }

# Raised so the loop outlasts the background compile; at the old count
# the script exited before the compiled entry was ever installed.
var n = 200000

var sum = 0
iter var i = 0; i < n; i++ {
  sum = sum + identity(i)
}

var sum2 = 0
iter var i = 0; i < n; i++ {
  sum2 = sum2 + i
}

echo 'done ${sum} ${sum2}'
