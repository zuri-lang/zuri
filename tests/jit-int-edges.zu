# Integer arithmetic at the edges of what a double counts exactly. Each
# loop warms up on small whole numbers, and its running value also feeds
# a bitwise operator, so compiled code keeps it an integer. It then has to
# give the interpreter's answer for sums, differences, products and
# negations that leave 2^53, that would wrap an integer, and that land
# exactly on the boundary, whether the result is then compared, divided
# or taken apart bit by bit.

# `a` stepped by `b`, `n` times, with the parity of every step.
def walk(a, b, n) {
  var s = a
  var bits = 0
  iter var i = 0; i < n; i++ {
    s = s + b
    bits = bits ^ (s & 1)
  }
  return [s, bits]
}

# `a` stepped down by `b`, `n` times, with the parity of every step.
def walk_back(a, b, n) {
  var s = a
  var bits = 0
  iter var i = 0; i < n; i++ {
    s = s - b
    bits = bits ^ (s & 1)
  }
  return [s, bits]
}

# `a` counted up and down by one, `n` times each way.
def bounce(a, n) {
  var s = a
  var t = a
  var bits = 0
  iter var i = 0; i < n; i++ {
    s++
    t--
    bits = bits ^ (s & 1) ^ (t & 2)
  }
  return [s, t, bits]
}

# `a` multiplied by `k`, `n` times, with the parity of every step and of
# three times every step.
def scale(a, k, n) {
  var s = a
  var bits = 0
  iter var i = 0; i < n; i++ {
    s = s * k
    bits = bits ^ (s & 1) ^ ((s * 3) & 2)
  }
  return [s, bits]
}

# One past `a` against `mark`, and the low bits of its negation.
def reaches(a, mark) {
  var s = a + 1
  var t = -s
  return [s == mark, s > mark, s % 4, t & 3]
}

# Counted down while above zero, as an escape-time loop does, then taken
# apart. From 50 the count stays small; from `start` it need not.
def settle(limit) {
  var i = 50
  var steps = 0
  while steps < limit and i-- > 0 {
    steps++
  }
  return [i == 0, i % 4, i & 3, steps]
}

def countdown(start, limit) {
  var i = start
  var steps = 0
  while steps < limit and i-- > 0 {
    steps++
  }
  return [i == 0, i % 4, i & 3, steps]
}

var total = 0
iter var i = 0; i < 3000; i++ {
  total = total + walk(i, 3, 20)[0] + walk_back(i, 3, 20)[1] + bounce(i, 20)[2]
  total = total + scale(i, 3, 5)[1] + reaches(i, i + 1)[3]
  total = total + settle(i % 70)[1] + countdown(i % 60, 100)[2]
}
echo total

var edges = [
  [2 ** 53 - 1, 1],
  [2 ** 53, 1],
  [-(2 ** 53), -1],
  [-(2 ** 53) + 1, -1],
  [2 ** 62, 2 ** 62],
  [2 ** 62 + 2 ** 61, 2 ** 62],
  [-(2 ** 62), -(2 ** 62)],
  [-(2 ** 63), -(2 ** 62)],
  [2 ** 63 - 1024, 2 ** 62],
  [9007199254740993, 0],
  [4503599627370496, 4503599627370496]
]

for pair in edges {
  var a = pair[0]
  var b = pair[1]
  var up = bounce(a, 2)
  var down = bounce(-a, 2)
  echo [walk(a, b, 1), walk(a, b, 2), walk_back(a, b, 1), walk_back(b, a, 2)]
  echo [up, down]
  echo [scale(a, 3, 1), scale(b, 2, 2), reaches(a, 2 ** 53), reaches(-a, 2 ** 53)]
}

for start in [0, 1, 2 ** 53, 2 ** 53 + 4, 9007199254740993, -(2 ** 53) - 2] {
  echo [start, countdown(start, 3), settle(3), settle(60)]
}
