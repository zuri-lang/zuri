/* Exercises the same idx_proven_numeric/idx_proven_int skip
 * emit_list_get_index/emit_list_set_index already had, extended to
 * emit_scalar_list_get/emit_scalar_list_set (the stack-allocated,
 * escape-analyzed list fast path, see tests/scalar-list-replacement.zu)
 * -- these previously always did the full is_number + float-roundtrip
 * check on the index regardless of whether type_facts/int_facts
 * already proved it. Covers: a proven (loop-counter) index reading AND
 * writing, an in-range/out-of-range unproven index (the bounds check
 * must still fire even when the numeric/int half of the guard is
 * skipped), and a genuinely non-numeric unproven index. Run past the
 * JIT tiering threshold.
 *
 * NOTE: under a normal `cargo test` run this only exercises the GENERAL
 * (heap `Obj::List`) path's correctness, not the scalar-replaced one --
 * `scalar_replace_eligible` requires `speculative_params`/
 * `speculative_regs` to both be `None`, which essentially never holds
 * for a function that actually gets warmed up the ordinary way (every
 * function in this file compiles with a real speculative body). Run
 * with `ZURI_JIT_NO_SPECIALIZATION=1` (an existing debug env var) to
 * actually exercise the scalar-list fast path this test is nominally
 * about; confirmed via `ZURI_JIT_LOG_IR=1` that `stack_addr` (the
 * scalar path's own signature) only appears in the dumped IR with that
 * flag set. The fix is still correct and worth keeping regardless --
 * see project memory for the full finding.
 */

def scalar_list_sum(a, b, c) {
  var tmp = [a, b, c]
  var i = 0
  while i < 3 {
    /* i is proven both numeric and a whole number (loop counter) --
     * exercises the now-skipped guard on a genuinely stack-allocated
     * list, both for the read and the write below. */
    tmp[i] = tmp[i] + 1
    i = i + 1
  }
  return tmp[0] + tmp[1] + tmp[2]
}

def scalar_list_index(a, b, c, idx) {
  var tmp = [a, b, c]
  /* idx is NOT proven numeric/int -- exercises the unproven guard,
   * both when it turns out fine and when it's out of range. */
  return tmp[idx]
}

var i = 0
while i < 300000 {
  scalar_list_sum(1, 2, 3)
  scalar_list_index(1, 2, 3, 1)
  i = i + 1
}

echo scalar_list_sum(1, 2, 3)
echo scalar_list_index(10, 20, 30, 2)

catch {
  echo scalar_list_index(10, 20, 30, 5)
} as e1
if e1 {
  echo e1.message
}

catch {
  echo scalar_list_index(10, 20, 30, 'x')
} as e2
if e2 {
  echo e2.message
}
