echo 2 + 2
echo 2 * 2
echo ~2
echo 2 >>> -1


class A {
  @new(val) {
    self.val = val
  }

  @add(other) {
    return A(self.val + other.val)
  }

  @mul(other) {
    return A(self.val * other.val)
  }

  @urshift(other) {
    return A(self.val >>> other.val)
  }

  @not() {
    return A(self.val ** 2)
  }
}

echo (A(5) + A(11)).val
echo (A(5) >>> A(12)).val
echo (~(~(A(12)))).val

var g = A(24)
g += A(93)

echo g.val

echo ~12
