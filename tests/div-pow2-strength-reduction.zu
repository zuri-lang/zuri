/* Exercises jit::codegen::div_by_pow2_reciprocal, backed by
 * typeflow::ConstFacts (a real "must be this exact value" dataflow
 * proof): `x / <constant>` compiles to `x * (1.0/constant)` instead of
 * a real `fdiv` whenever the constant is PROVABLY an exact power of
 * two on every path reaching the Div, no matter how far its own
 * LoadConst sits from the division itself. Covers: the proven-numeric
 * fast path, the guarded (unproven receiver) path, a non-power-of-two
 * divisor (must stay real division), a negative power-of-two divisor,
 * a divisor reaching the Div through a MERGE POINT with two DIFFERENT
 * literals (must NOT take the shortcut; genuinely not a single known
 * constant there), a constant HOISTED into a local and reused across
 * every iteration of a loop (the case a purely local "check the
 * immediately preceding instruction" heuristic could never catch --
 * this is what makes `ConstFacts` a real dataflow pass and not just
 * that heuristic with extra steps), and a register reassigned to a
 * NON-constant partway through a function (must stop taking the
 * shortcut from that point on). Run past the JIT tiering threshold
 * since a wrong shortcut would only show up in compiled code.
 */

def proven_div2(x: number) {
  return x / 2.0
}

def proven_div_neg4(x: number) {
  return x / -4.0
}

def proven_div3(x: number) {
  /* NOT a power of two; must still be real division */
  return x / 3.0
}

def unproven_div2(x) {
  /* x's type isn't proven; exercises the guarded path with the
   * reciprocal rewrite still applied. */
  return x / 2.0
}

def merge_point_div(flag, x: number) {
  var d = 2.0
  if flag {
    d = 4.0
  }
  /* d is NOT provably 2.0 or 4.0 here (a genuine CFG merge point) --
   * must divide by whatever d actually is at runtime, not shortcut to
   * either branch's literal. */
  return x / d
}

def hoisted_const_div(n) {
  /* `half`'s own LoadConst is nowhere near the Div inside the loop --
   * only a real dataflow pass proves it's still exactly 2.0 on every
   * iteration. */
  var half = 2.0
  var total = 0.0
  var i = 0
  while i < n {
    total = total + (i / half)
    i = i + 1
  }
  return total
}

def reassigned_to_nonconstant(n) {
  var d = 2.0
  var first = 10.0 / d
  d = n
  /* d is REASSIGNED to a genuinely runtime value; must NOT still be
   * treated as the constant 2.0 here. */
  var second = 10.0 / d
  return first + second
}

var i = 0
while i < 300000 {
  proven_div2(7.0)
  proven_div_neg4(7.0)
  proven_div3(7.0)
  unproven_div2(7.0)
  merge_point_div(false, 7.0)
  merge_point_div(true, 7.0)
  reassigned_to_nonconstant(5.0)
  i = i + 1
}

echo proven_div2(7.0)
echo proven_div2(-7.0)
echo proven_div2(0.0)
echo proven_div_neg4(7.0)
echo proven_div_neg4(-8.0)
echo proven_div3(7.0)
echo proven_div3(10.0)
echo unproven_div2(9.0)
catch {
  echo unproven_div2('nope')
} as e
echo e.message
echo merge_point_div(false, 8.0)
echo merge_point_div(true, 8.0)
echo hoisted_const_div(1000000)
echo reassigned_to_nonconstant(5.0)
echo reassigned_to_nonconstant(4.0)
