/**
 * test_mail_server.zu
 *
 * The three protocols over real sockets: the SMTP client against the
 * SMTP server, the IMAP client against the IMAP server over both
 * stores, the POP3 client against a server written out by hand, and
 * the worker pool behind two of them at once.
 *
 * Every server runs in a spawned isolate (see `mail_server_app.zu`) so
 * that both ends live in one test process, the same way
 * `tests/libs/http_server.zu` does it.
 */

import mail
import mail.imap { ImapClient }
import mail.pool
import mail.pop3 { Pop3Client }
import mail.smtp { SmtpClient }

import isolate
import net.tls
import os

import .mail_server_app

isolate.configure(12)

var _passed = 0
var _failed = 0

def check(label, got, expected) {
  if got == expected {
    _passed++

    return
  }

  _failed++

  echo '  [FAIL] ${label}'
  echo '         got      ${got}'
  echo '         expected ${expected}'
}

def ok(label, condition) {
  check(label, condition, true)
}

def raises(body) {
  catch {
    body()

    return false
  } as error
  return true
}

def section(title) {
  echo ''
  echo '== ${title} =='
}

# The same certificate the http suite uses: issued for localhost by a
# root that is trusted only by pointing a client at it.
