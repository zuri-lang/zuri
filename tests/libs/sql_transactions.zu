# Transactions, and the savepoints that make nesting work. Run against
# SQLite, which is the engine a test can rely on being there; the
# postgres side of the same behaviour is covered by the integration
# suite.

import sql
import sql.errors { TransactionError, ClosedError }

def raises(fn) {
  catch {
    fn()
    return false
  } as _error {
  }

  return true
}

def fresh() {
  var db = sql.open(':memory:')
  db.exec('create table t (id integer primary key, name text)', nil)

  return db
}

def test_commit_and_rollback() {
  var db = fresh()

  db.transaction(@(tx) {
    tx.insert('t', { name: 'kept' }, nil)
  }, nil)

  assert db.count('t', nil) == 1

  catch {
    db.transaction(@(tx) {
      tx.insert('t', { name: 'discarded' }, nil)
      raise Error('stop')
    }, nil)
  } as _error {
  }

  assert db.count('t', nil) == 1
  assert !db.in_transaction()

  # Whatever the body returns comes back out.
  assert db.transaction(@(tx) => 'result', nil) == 'result'

  db.close()
  echo 'test_commit_and_rollback passed'
}

def test_nesting() {
  var db = fresh()

  db.transaction(@(outer) {
    outer.insert('t', { name: 'outer' }, nil)

    # An inner transaction is a savepoint, so its failure undoes only
    # its own work and the outer one carries on.
    catch {
      db.transaction(@(inner) {
        inner.insert('t', { name: 'inner' }, nil)
        raise Error('inner fails')
      }, nil)
    } as _error {
    }

    outer.insert('t', { name: 'after' }, nil)
  }, nil)

  var names = db.fetch_column('select name from t order by name', nil, nil)
  assert names == ['after', 'outer']

  db.close()
  echo 'test_nesting passed'
}

def test_manual() {
  var db = fresh()

  var tx = db.begin(nil)
  tx.insert('t', { name: 'one' }, nil)
  assert db.in_transaction()
  tx.commit()
  assert !db.in_transaction()
  assert db.count('t', nil) == 1

  var second = db.begin(nil)
  second.insert('t', { name: 'two' }, nil)
  second.rollback()
  assert db.count('t', nil) == 1

  # A transaction that has finished refuses to be used again.
  var reused = false

  catch {
    second.commit()
  } as error {
    reused = instance_of(error, TransactionError)
  }

  assert reused

  db.close()
  echo 'test_manual passed'
}

def test_isolation() {
  var db = fresh()

  # SQLite has no levels of its own, so these map onto its locking
  # modes: serializable takes the write lock up front.
  db.transaction(@(tx) {
    tx.insert('t', { name: 'a' }, nil)
  }, sql.SERIALIZABLE)

  db.transaction(@(tx) {
    tx.insert('t', { name: 'b' }, nil)
  }, sql.READ_COMMITTED)

  assert db.count('t', nil) == 2

  # Repeatable read is served by the same mode: SQLite has nothing
  # between the two, and serializable is the stronger.
  db.transaction(@(tx) => nil, sql.REPEATABLE_READ)
  assert db.capabilities().isolation_levels.contains(sql.REPEATABLE_READ)

  # A level it genuinely cannot offer says so rather than pretending.
  var refused = false

  catch {
    db.transaction(@(tx) => nil, sql.READ_UNCOMMITTED)
  } as error {
    refused = instance_of(error, sql.NotSupportedError)
  }

  assert refused

  db.close()
  echo 'test_isolation passed'
}

def test_savepoints_by_name() {
  var db = fresh()
  var connection = db.native()

  connection.begin(nil)
  db.insert('t', { name: 'first' }, nil)

  connection.savepoint('mark')
  db.insert('t', { name: 'second' }, nil)
  assert db.count('t', nil) == 2

  connection.rollback_to('mark')
  assert db.count('t', nil) == 1

  connection.release_savepoint('mark')
  connection.commit()

  assert db.count('t', nil) == 1

  db.close()
  echo 'test_savepoints_by_name passed'
}

def test_transaction_helpers() {
  var db = fresh()

  db.transaction(@(tx) {
    var id = tx.insert('t', { name: 'x' }, nil)
    assert tx.fetch_value('select name from t where id = ?', [id], nil) == 'x'
    assert tx.update('t', { name: 'y' }, { id }) == 1
    assert tx.fetch_one('select name from t where id = ?', [id]).name == 'y'
    assert tx.query('select * from t', nil).length() == 1
    assert tx.fetch_all('select * from t', nil).length() == 1
    assert tx.delete('t', { id }) == 1
  }, nil)

  assert db.count('t', nil) == 0

  db.close()
  echo 'test_transaction_helpers passed'
}

def test_transaction_reads() {
  var db = fresh()

  db.transaction(@(tx) {
    assert tx.insert_many('t', [{ name: 'a' }, { name: 'b' }, { name: 'c' }]) == 3

    # A read inside the transaction sees what the transaction has
    # written and nobody else has yet.
    assert tx.count('t', nil) == 3
    assert tx.count('t', { name: 'b' }) == 1
    assert tx.find('t', nil, { order: ['name desc'] }).column('name') ==
      ['c', 'b', 'a']
    assert tx.find_one('t', { name: 'b' }, nil).name == 'b'
    assert tx.find_one('t', { name: 'nobody' }, nil) == nil
  }, nil)

  assert db.count('t', nil) == 3

  # And a rollback takes the reads' subject with it.
  catch {
    db.transaction(@(tx) {
      tx.insert('t', { name: 'd' }, nil)
      assert tx.count('t', nil) == 4
      raise Error('stop')
    }, nil)
  } as _error {
  }

  assert db.count('t', nil) == 3

  # A finished transaction refuses them the way it refuses the rest.
  var tx = db.begin(nil)
  tx.commit()

  assert raises(@() { tx.count('t', nil) })
  assert raises(@() { tx.find('t', nil, nil) })
  assert raises(@() { tx.find_one('t', nil, nil) })
  assert raises(@() { tx.insert_many('t', [{ name: 'e' }]) })

  db.close()
  echo 'test_transaction_reads passed'
}

def test_transaction_scripts_and_cursors() {
  var db = fresh()

  # A script run inside a transaction goes with it: kept on commit,
  # gone on a rollback.
  db.transaction(@(tx) {
    tx.exec_script(
      'create table kept (n integer); insert into kept values (1); insert into kept values (2);'
    )
  }, nil)

  assert db.fetch_value('select count(*) from kept', nil, 0) == 2

  catch {
    db.transaction(@(tx) {
      tx.exec_script('create table dropped (n integer); insert into dropped values (1);')
      raise Error('stop')
    }, nil)
  } as _error {
  }

  assert db.fetch_column(
    "select name from sqlite_master where type = 'table' and name = 'dropped'", nil, nil
  ).is_empty()

  db.transaction(@(tx) {
    tx.insert_many('t', [{ name: 'a' }, { name: 'b' }, { name: 'c' }])

    assert tx.fetch_column('select name from t order by name', nil, nil) == ['a', 'b', 'c']

    var seen = []

    for row in tx.stream('select name from t order by name desc', nil, nil) {
      seen.append(row.name)
    }

    assert seen == ['c', 'b', 'a']

    var statement = tx.prepare('insert into t (name) values (?)')

    statement.exec(['d'])
    statement.close()

    assert tx.count('t', nil) == 4
  }, nil)

  var tx = db.begin(nil)
  tx.commit()

  assert raises(@() { tx.exec_script('create table late (n integer)') })
  assert raises(@() { tx.fetch_column('select name from t', nil, nil) })

  db.close()
  echo 'test_transaction_scripts_and_cursors passed'
}


test_commit_and_rollback()
test_nesting()
test_manual()
test_isolation()
test_savepoints_by_name()
test_transaction_helpers()
test_transaction_reads()
test_transaction_scripts_and_cursors()
