/**
 * test_io.zu
 *
 * Test suite for the core `io` standard library module surface: the
 * standard stream handles and their `is_tty()`/`is_repl` status, the
 * seek constants, output capture, and the free functions (`flush`,
 * `putc`, `getc`). `io.TTY` and `io.BytesIO` each get their own dedicated suite
 * (see `io_tty.zu` and `io_bytesio.zu`).
 */

import io
import os

var _passed = 0

def ok(label) {
  _passed++
  echo '  [PASS] ' + label
}

def raises(fn) {
  catch {
    fn()
    return false
  } as e
  return true
}

echo '═══════════════════════════════════════════════════════'
echo '  io module: test suite'
echo '═══════════════════════════════════════════════════════'

# ---------------------------------------------------------------------------
# Standard streams
# ---------------------------------------------------------------------------
assert is_file(io.stdin) and is_file(io.stdout) and is_file(io.stderr),
  'stdin, stdout, and stderr must all be real file handles'
ok('stdin/stdout/stderr are file handles')

assert io.is_repl == false, 'this test always runs as a script, never inside the REPL'
ok('is_repl reflects the current execution mode')

assert !io.stdout.is_tty(), 'stdout in this harness is always a captured pipe, never a real terminal'
assert !io.stderr.is_tty(), 'stderr in this harness is always a captured pipe, never a real terminal'
ok('is_tty() correctly reports false for a non-tty stream')

# Being a file handle is not the same as being an open one, and a
# stream that the platform never attached anything to fails only when
# something tries to write to it. An empty write reaches exactly that
# check without putting anything in the test's own output.
assert io.stdout.write('') == true, 'stdout must be open for writing'
assert io.stderr.write('') == true, 'stderr must be open for writing'
ok('stdout and stderr are attached to something that accepts writes')

# A standard stream reports the descriptor it is NAMED by, not the
# private duplicate the runtime holds open for it, so `number()` is
# what tells stdout apart from stderr.
if os.platform != 'windows' {
  assert io.stdin.number() == 0 and io.stdout.number() == 1 and io.stderr.number() == 2,
    'the standard streams must report descriptors 0, 1 and 2'
  ok('number() identifies each standard stream')
}

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------
assert io.SEEK_SET == 0 and io.SEEK_CUR == 1 and io.SEEK_END == 2,
  'the seek constants must match the conventional SEEK_SET/SEEK_CUR/SEEK_END values'
ok('SEEK_* constants')

# ---------------------------------------------------------------------------
# Output capture
# ---------------------------------------------------------------------------
assert io.capture_depth() == 0, 'no capture must be open before one is started'

var captured = io.capture(@{
  echo 'echoed'
  print('printed\n')
  io.stdout.write('written\n')
})

assert captured == 'echoed\nprinted\nwritten\n',
  'capture() must collect echo, print() and io.stdout writes in order, and nothing else'
assert io.capture_depth() == 0, 'capture() must close its frame before returning'
ok('capture() collects every Zuri-level write to standard output')

var outer = io.capture(@{
  echo 'outer-before'

  var inner = io.capture(@{
    echo 'inner-only'
  })

  assert inner == 'inner-only\n', 'an inner capture must receive only its own output'
  echo 'outer-after'
})

assert outer == 'outer-before\nouter-after\n',
  'an inner capture must not leak its output into the frame around it'
ok('captures nest, innermost first')

io.capture_begin()
echo 'manual'
assert io.capture_depth() == 1, 'capture_depth() must report the open frame'
var manual = io.capture_end()

assert manual == 'manual\n', 'capture_end() must return what the frame collected'
assert io.capture_end() == nil, 'capture_end() with no frame open must return nil, not raise'
ok('capture_begin()/capture_end() work as the manual pair')

assert raises(@{
  io.capture(@{
    echo 'discarded'
    raise ValueError('from inside a capture')
  })
}), 'capture() must re-raise what its body raised'
assert io.capture_depth() == 0, 'capture() must close its frame even when the body raises'
ok('capture() closes its frame and re-raises when the body fails')

# ---------------------------------------------------------------------------
# Free functions
# ---------------------------------------------------------------------------
io.flush(io.stdout)
ok('flush() succeeds on a real file handle')

assert raises(@() { io.flush(io.BytesIO(bytes(0), 'r')) }), 'flush() must reject a non-file argument (BytesIO is not is_file())'
assert raises(@() { io.flush('not a file') }), 'flush() must reject a plain string argument'
ok('flush() validates its argument')

assert raises(@() { io.putc(-1) }), 'putc() must reject a character code below 0'
assert raises(@() { io.putc(256) }), 'putc() must reject a character code above 255'
assert raises(@() { io.putc('ab') }), 'putc() must reject a multi-character string'
assert raises(@() { io.putc([]) }), 'putc() must reject a non-string, non-number argument'
ok('putc() validates its argument before writing anything')

assert !raises(@() { io.putc('x') }), 'putc() must accept a single-character string'
assert !raises(@() { io.putc(65) }), 'putc() must accept a character code and write it as that character'
ok('putc() succeeds for a valid character or character code')

assert raises(@() { io.getc(-1) }), 'getc() must reject a negative length before touching stdin'
assert raises(@() { io.getc('x') }), 'getc() must reject a non-numeric length before touching stdin'
ok('getc() validates its argument before touching stdin')

# getch() and readline() both perform a real blocking read from stdin with
# no argument validation to exercise safely in an automated, non-tty
# environment, so they're intentionally not called here.

# ===========================================================================
# Final summary
# ===========================================================================
echo ''
echo '═══════════════════════════════════════════════════════'
echo '  All ${_passed} assertions passed.'
echo '═══════════════════════════════════════════════════════'
