/**
 * env.zu
 *
 * Test suite for the `env` standard library module: the file grammar
 * and its errors, `$` expansion and its modifiers, the loader's
 * precedence and layering rules, the typed readers, and round-tripping
 * through `stringify()`.
 */

import env
import os

var _passed = 0

def ok(label) {
  _passed++
  echo '  [PASS] ' + label
}

def raises(fn) {
  catch {
    fn()
    return false
  } as e
  return true
}

# Catches whatever `fn` raises and hands it back for inspection.
def caught(fn) {
  catch {
    fn()
  } as e {
    return e
  }

  return nil
}

# A bare dollar sign, so that a `.env` fragment written in a Zuri
# string can carry `${NAME}` without Zuri interpolating it first.
var D = '$'

var _workspace = os.create_temp_dir('zuri-env-')

def write_file(name, content) {
  var path = os.join_paths(_workspace, name)

  file(path, 'w').write(content)

  return path
}

# Every test that touches the process environment uses these, so that
# nothing inherited from the shell can change the outcome.
var NAMES = [
  'ZURI_ENV_HOST', 'ZURI_ENV_PORT', 'ZURI_ENV_DEBUG', 'ZURI_ENV_EMPTY',
  'ZURI_ENV_FLAGS', 'ZURI_ENV_RATIO', 'ZURI_ENV_SECRET', 'ZURI_ENV_PUBLIC',
  'ZURI_ENV_EXTRA', 'ZURI_ENV_PATHLIKE', 'ZURI_ENV_ABSENT',
]

def clear_names() {
  for name in NAMES {
    os.unset_env(name)
  }
}

clear_names()

echo '═══════════════════════════════════════════════════════'
echo '  env module: test suite'
echo '═══════════════════════════════════════════════════════'

# ---------------------------------------------------------------------------
# parse(): the grammar
# ---------------------------------------------------------------------------
var basic = env.parse('BASIC=basic')
assert basic == { BASIC: 'basic' }, 'parse() must read a bare assignment'
ok('parse() reads a bare assignment')

var shapes = env.parse(
  '# a leading comment\n' +
  '\n' +
  'BARE=value\n' +
  'export EXPORTED=yes\n' +
  'EMPTY=\n' +
  'PADDED=   trimmed at both ends   \n' +
  'HASH=db#1\n' +
  'TRAILING=value # this is a comment\n' +
  'INDENTED=    \t   spaced\n'
)

assert shapes.BARE == 'value', 'a bare value is the text up to the end of the line'
assert shapes.EXPORTED == 'yes', 'a leading export is allowed and ignored'
assert shapes.EMPTY == '', 'KEY= is an empty value'
assert shapes.PADDED == 'trimmed at both ends', 'a bare value loses the whitespace around it'
assert shapes.HASH == 'db#1', 'a # with no space before it belongs to the value'
assert shapes.TRAILING == 'value', 'a # after a space opens a comment'
assert shapes.INDENTED == 'spaced', 'whitespace after the = is not part of the value'
ok('parse() handles bare values, export, comments and padding')

var quoted = env.parse(
  "SINGLE='  kept  exactly  '\n" +
  'DOUBLE="tab\\there"\n' +
  'BACKTICK=`has \'single\' and "double"`\n'
)

assert quoted.SINGLE == '  kept  exactly  ', 'single quotes keep every character'
assert quoted.DOUBLE == 'tab\there', 'double quotes resolve escapes'
assert quoted.BACKTICK == 'has \'single\' and "double"', 'backticks carry both quote characters'
ok('parse() handles all three quoting forms')

var multiline = env.parse('KEY="first\nsecond"\nAFTER=1\n')
assert multiline.KEY == 'first\nsecond', 'a quoted value may span lines'
assert multiline.AFTER == '1', 'parsing continues after a multi-line value'
ok('parse() reads multi-line values')

var escapes = env.parse(
  'ESCAPED="\\n\\r\\t\\\\\\"end"\n' +
  'CODEPOINTS="\\x41 \\u00e9 \\u{1f600}"\n' +
  'WINDOWS="C:\\Users\\me"\n' +
  'JOINED="one\\\ntwo"\n' +
  'DOLLAR="\\$LITERAL"\n'
)

assert escapes.ESCAPED == '\n\r\t\\"end', 'the single-character escapes resolve'
assert escapes.CODEPOINTS == 'A é 😀', 'the hex and unicode escapes resolve'
assert escapes.WINDOWS == 'C:\\Users\\me', 'an undefined escape keeps both characters'
assert escapes.JOINED == 'onetwo', 'a backslash before a newline joins the lines'
assert escapes.DOLLAR == '${D}LITERAL', 'a backslash before a dollar leaves a literal dollar'
ok('parse() resolves every escape inside double quotes')

assert env.parse('KEY=first\nKEY=second').KEY == 'second',
  'the last assignment to a name wins'
ok('parse() lets the last assignment win')

assert env.parse('A=1\r\nB=2\r\n') == { A: '1', B: '2' },
  'CRLF line endings are normalised'
assert env.parse(0xfeff.chr() + 'A=1').A == '1', 'a byte-order mark is discarded'
ok('parse() normalises line endings and drops a BOM')

assert env.parse('A=1'.to_bytes()) == { A: '1' }, 'parse() accepts bytes'
ok('parse() accepts bytes as well as a string')

assert env.parse('') == {}, 'an empty source has no names'
assert env.parse('\n\n# only a comment\n\n') == {}, 'a source of comments has no names'
ok('parse() reads an empty source')

# ---------------------------------------------------------------------------
# parse(): the errors
# ---------------------------------------------------------------------------
var bad_name = caught(@() { env.parse('12FACTOR=yes') })

assert instance_of(bad_name, env.ParseError), 'a bad name is a ParseError'
assert instance_of(bad_name, env.EnvError), 'every ParseError is an EnvError'
assert bad_name.line == 1 and bad_name.column == 1, 'a ParseError points at the character'
ok('parse() rejects a name that is not a name')

var unterminated = caught(@() { env.parse('A=1\nB="never closed') })
assert instance_of(unterminated, env.ParseError), 'an unclosed quote is a ParseError'
assert unterminated.line == 2, 'the error points at the line the quote opened on'
ok('parse() rejects an unterminated quoted value')

assert raises(@() { env.parse('KEY value') }), 'an assignment needs an ='
assert raises(@() { env.parse('KEY: value') }), 'a colon is not an ='
assert raises(@() { env.parse('KEY="a" junk') }), 'a quoted value owns the rest of its line'
assert raises(@() { env.parse('KEY="\\xZZ"') }), 'a hex escape needs hex digits'
assert raises(@() { env.parse('KEY="\\u{41"') }), 'a braced codepoint must be closed'
assert raises(@() { env.parse('KEY="trailing\\') }), 'a value must not end on a backslash'
ok('parse() rejects every malformed assignment')

# ---------------------------------------------------------------------------
# is_name()
# ---------------------------------------------------------------------------
assert env.is_name('HOST') and env.is_name('_private') and env.is_name('A1_b'),
  'a name is a letter or underscore then letters, digits and underscores'
assert !env.is_name('1HOST') and !env.is_name('WITH-DASH') and !env.is_name(''),
  'anything else is not a name'
ok('is_name() enforces the POSIX name rule')

# ---------------------------------------------------------------------------
# stringify()
# ---------------------------------------------------------------------------
assert env.stringify({}) == '', 'an empty dictionary is an empty file'

var written = env.stringify({
  PORT: 8080,
  DEBUG: false,
  PATHLIKE: '/var/lib/app',
  SPACED: 'two words',
  HASHED: '#leading',
  DOLLARED: '${D}notref',
  LINES: 'a\nb',
})

assert written.contains('PORT=8080'), 'a number is written as its text'
assert written.contains('DEBUG=false'), 'a boolean is written as true or false'
assert written.contains('PATHLIKE=/var/lib/app'), 'a safe value is written bare'
assert written.contains('SPACED="two words"'), 'a value with a space is quoted'
assert written.contains('HASHED="#leading"'), 'a value with a hash is quoted'
assert written.contains('DOLLARED="\\' + D + 'notref"'), 'a dollar is escaped on the way out'
assert written.contains('LINES="a\\nb"'), 'a newline is written as an escape'
ok('stringify() quotes exactly what needs quoting')

var round_trip = { A: 'x\ny', B: '#hash', C: '', D: 'sp ace', E: '${D}dollar', F: 'plain' }
assert env.parse(env.stringify(round_trip)) == round_trip,
  'stringify() and parse() must round-trip'
ok('stringify() round-trips through parse()')

assert raises(@() { env.stringify({ '1BAD': 'x' }) }), 'stringify() rejects an illegal name'
assert raises(@() { env.stringify({ OK: [1, 2] }) }), 'stringify() rejects a list value'
ok('stringify() rejects what it cannot write')

# ---------------------------------------------------------------------------
# Expansion
# ---------------------------------------------------------------------------
def expanded(source) {
  return env.loader().source(source).read().values
}

assert expanded('A=1\nB=${D}{A}/x').B == '1/x', 'a braced reference resolves'
assert expanded('A=1\nB=${D}A/x').B == '1/x', 'a bare reference resolves'
assert expanded('B=${D}{NOT_SET_ANYWHERE_AT_ALL}').B == '',
  'a reference to nothing is empty'
ok('expansion resolves $NAME and ${D}{NAME}')

assert expanded('B=${D}{MISSING_ONE:-fallback}').B == 'fallback', ':- supplies a fallback'
assert expanded('E=\nB=${D}{E:-fallback}').B == 'fallback', ':- counts empty as unset'
assert expanded('E=\nB=${D}{E-fallback}').B == '', '- counts empty as set'
assert expanded('A=1\nB=${D}{A:+instead}').B == 'instead', ':+ replaces a value that is there'
assert expanded('B=${D}{MISSING_ONE:+instead}').B == '', ':+ is empty when there is no value'
assert expanded('E=\nB=${D}{E+instead}').B == 'instead', '+ counts empty as set'
ok('expansion honours the :- - :+ and + modifiers')

assert expanded('A=1\nB=${D}{MISSING_ONE:-${D}{A}}').B == '1',
  'a fallback is expanded in its turn'
ok('expansion nests inside a fallback')

var demanded = caught(@() { expanded('B=${D}{MISSING_ONE:?this one is required}') })
assert instance_of(demanded, env.MissingVariable), ':? raises MissingVariable'
assert demanded.message == 'this one is required', ':? reports the reason it was given'
assert demanded.name == 'MISSING_ONE', 'the error carries the name that was wanted'
ok('expansion raises on a ${D}{NAME:?reason} that finds nothing')

assert expanded('B=\\' + D + '{A}\nA=1').B == '${D}{A}',
  'a backslash makes a dollar literal'
assert expanded("B='raw ${D}{A} here'\nA=1").B == 'raw ${D}{A} here',
  'a single-quoted value never expands'
assert expanded('B=costs ${D}5 always').B == 'costs ${D}5 always',
  'a dollar that names nothing stands for itself'
ok('expansion leaves literal dollars alone')

assert env.loader().source('A=1\nB=${D}{A}/x').expand(false).read().values.B == '${D}{A}/x',
  'expand(false) uses every value exactly as written'
ok('expand(false) turns expansion off')

var cycle = caught(@() { expanded('A=${D}{B}\nB=${D}{A}') })
assert instance_of(cycle, env.EnvError), 'a loop between two names is an EnvError'
assert cycle.message.contains('circular'), 'the error says what went wrong'
ok('expansion refuses a circular reference')

# ---------------------------------------------------------------------------
# Loading: precedence
# ---------------------------------------------------------------------------
clear_names()
os.set_env('ZURI_ENV_HOST', 'from-shell', true)

var defaults = env.loader()
  .source('ZURI_ENV_HOST=from-file\nZURI_ENV_PORT=8080')
  .load()

assert os.get_env('ZURI_ENV_HOST') == 'from-shell',
  'a name already set is left alone'
assert os.get_env('ZURI_ENV_PORT') == '8080', 'a name not yet set is written'
assert defaults.applied == ['ZURI_ENV_PORT'], 'applied lists what the load set'
assert defaults.skipped == ['ZURI_ENV_HOST'], 'skipped lists what was already set'
assert defaults.values.ZURI_ENV_HOST == 'from-file',
  'values reports what the source defined, set or not'
ok('load() leaves an existing value alone by default')

clear_names()
os.set_env('ZURI_ENV_HOST', 'from-shell', true)

env.loader().source('ZURI_ENV_HOST=from-file').override().load()
assert os.get_env('ZURI_ENV_HOST') == 'from-file', 'override() lets the source win'
ok('override() replaces an existing value')

clear_names()
os.set_env('ZURI_ENV_EMPTY', '', true)

env.loader().source('ZURI_ENV_EMPTY=filled').load()
assert os.get_env('ZURI_ENV_EMPTY') == 'filled',
  'a name set to the empty string counts as unset'
ok('an empty existing value does not block a load')

clear_names()
os.set_env('ZURI_ENV_PORT', '9000', true)

assert env.loader().source('ZURI_ENV_PORT=8080\nZURI_ENV_PUBLIC=:${D}{ZURI_ENV_PORT}')
  .read().values.ZURI_ENV_PUBLIC == ':9000',
  'a reference resolves to the value the name will hold'
assert env.loader().source('ZURI_ENV_PORT=8080\nZURI_ENV_PUBLIC=:${D}{ZURI_ENV_PORT}')
  .override().read().values.ZURI_ENV_PUBLIC == ':8080',
  'with override() on, that value is the source\'s'
ok('a reference resolves the way precedence says it will')

clear_names()
os.set_env('ZURI_ENV_PATHLIKE', '/usr/bin', true)

env.loader().source('ZURI_ENV_PATHLIKE=${D}{ZURI_ENV_PATHLIKE}:/opt/bin').override().load()
assert os.get_env('ZURI_ENV_PATHLIKE') == '/usr/bin:/opt/bin',
  'a definition may extend the value it is replacing'
ok('a self-reference reaches past itself to the environment')

# ---------------------------------------------------------------------------
# Loading: sources, layering and files
# ---------------------------------------------------------------------------
clear_names()

var shared = write_file('.env', 'ZURI_ENV_HOST=localhost\nZURI_ENV_PORT=8080\n')
var local = write_file('.env.local', 'ZURI_ENV_HOST=127.0.0.1\nZURI_ENV_EXTRA=local\n')

var layered = env.loader().paths([shared, local]).load()

assert layered.values.ZURI_ENV_HOST == '127.0.0.1', 'the last source to define a name wins'
assert layered.values.ZURI_ENV_PORT == '8080', 'an earlier source still contributes'
assert layered.values.ZURI_ENV_EXTRA == 'local', 'so does a later one'
assert layered.files == [shared, local], 'files lists what was read, in order'
assert layered.missing.is_empty(), 'nothing was missing'
ok('paths() layers files in the order they were added')

clear_names()

var absent = os.join_paths(_workspace, 'nowhere.env')
var optional = env.loader().path(absent).read()

assert optional.files.is_empty(), 'nothing was read'
assert optional.missing == [absent], 'missing lists the file that was not there'
assert optional.values == {}, 'an absent file contributes nothing'
ok('an absent file is not an error by default')

var demanded_file = caught(@() { env.loader().path(absent).required().read() })
assert instance_of(demanded_file, env.MissingFile), 'required() makes an absent file an error'
assert demanded_file.path == absent, 'the error carries the path it looked for'
ok('required() raises MissingFile for a file that is not there')

clear_names()

var inspected = env.loader().source('ZURI_ENV_SECRET=value').read()
assert inspected.values.ZURI_ENV_SECRET == 'value', 'read() returns what the source holds'
assert os.get_env('ZURI_ENV_SECRET') == nil, 'read() does not touch the environment'
assert inspected.applied.is_empty() and inspected.skipped.is_empty(),
  'read() applies and skips nothing'
ok('read() parses and expands without setting anything')

var reusable = env.loader().source('ZURI_ENV_EXTRA=once')
assert reusable.read().values == reusable.read().values, 'a loader may be run again'
ok('a loader is reusable')

clear_names()

var default_named = write_file('named.env', 'ZURI_ENV_DEBUG=yes\n')
assert env.load(default_named).values.ZURI_ENV_DEBUG == 'yes', 'load() takes a path'
assert os.get_env('ZURI_ENV_DEBUG') == 'yes', 'load() writes into the environment'
ok('load() reads the file it is given')

assert instance_of(env.loader(), env.Loader), 'loader() returns a Loader'
assert instance_of(env.load(absent), env.Result), 'load() returns a Result'
ok('loader() and load() return what they say they do')

# ---------------------------------------------------------------------------
# Reading values back
# ---------------------------------------------------------------------------
clear_names()

env.loader().source(
  'ZURI_ENV_HOST=example.com\n' +
  'ZURI_ENV_PORT=8080\n' +
  'ZURI_ENV_RATIO=-3\n' +
  'ZURI_ENV_DEBUG= YES \n' +
  'ZURI_ENV_FLAGS= a, b ,,c \n' +
  'ZURI_ENV_EMPTY=\n'
).load()

assert env.get('ZURI_ENV_HOST') == 'example.com', 'get() returns the value'
assert env.get('ZURI_ENV_ABSENT') == nil, 'get() returns nil for a name that is not set'
assert env.get('ZURI_ENV_ABSENT', 'fallback') == 'fallback', 'get() returns its default'
assert env.get('ZURI_ENV_EMPTY', 'fallback') == 'fallback', 'an empty value counts as unset'
ok('get() reads a value and falls back')

assert env.has('ZURI_ENV_HOST'), 'has() is true for a value that is set'
assert !env.has('ZURI_ENV_ABSENT'), 'has() is false for a name that is not set'
assert !env.has('ZURI_ENV_EMPTY'), 'has() is false for an empty value'
ok('has() reports whether a name is configured')

assert env.require('ZURI_ENV_HOST') == 'example.com', 'require() returns the value'

var required = caught(@() { env.require('ZURI_ENV_ABSENT') })
assert instance_of(required, env.MissingVariable), 'require() raises for a missing name'
assert required.name == 'ZURI_ENV_ABSENT', 'the error carries the name'
assert caught(@() { env.require('ZURI_ENV_ABSENT', 'set it in .env') }).message ==
  'set it in .env', 'require() reports the reason it was given'
assert raises(@() { env.require('ZURI_ENV_EMPTY') }), 'require() rejects an empty value'
ok('require() raises MissingVariable for anything unconfigured')

assert env.int('ZURI_ENV_PORT') == 8080, 'int() reads a whole number'
assert env.int('ZURI_ENV_RATIO') == -3, 'int() reads a signed number'
assert env.int('ZURI_ENV_ABSENT', 3000) == 3000, 'int() falls back'
assert env.int('ZURI_ENV_EMPTY', 3000) == 3000, 'an empty value falls back'
assert env.int('ZURI_ENV_ABSENT') == nil, 'int() with no default is nil'
assert raises(@() { env.int('ZURI_ENV_HOST') }), 'int() rejects text that is not a number'
ok('int() converts and rejects')

assert env.float('ZURI_ENV_PORT') == 8080, 'float() reads a whole number'
assert env.float('ZURI_ENV_ABSENT', 2.5) == 2.5, 'float() falls back'
assert raises(@() { env.float('ZURI_ENV_HOST') }), 'float() rejects text that is not a number'
ok('float() converts and rejects')

assert env.bool('ZURI_ENV_DEBUG') == true, 'bool() ignores case and surrounding space'
assert env.bool('ZURI_ENV_ABSENT', false) == false, 'bool() falls back'
assert raises(@() { env.bool('ZURI_ENV_HOST') }), 'bool() rejects anything else'
ok('bool() converts and rejects')

for word in ['1', 'true', 'TRUE', 'yes', 'y', 'on'] {
  os.set_env('ZURI_ENV_DEBUG', word, true)
  assert env.bool('ZURI_ENV_DEBUG') == true, '${word} reads as true'
}

for word in ['0', 'false', 'FALSE', 'no', 'n', 'off'] {
  os.set_env('ZURI_ENV_DEBUG', word, true)
  assert env.bool('ZURI_ENV_DEBUG') == false, '${word} reads as false'
}

ok('bool() accepts every documented spelling')

assert env.list('ZURI_ENV_FLAGS') == ['a', 'b', 'c'],
  'list() splits, trims and drops empty items'
assert env.list('ZURI_ENV_HOST', '.') == ['example', 'com'], 'list() takes a separator'
assert env.list('ZURI_ENV_ABSENT', ',', []) == [], 'list() falls back'
assert env.list('ZURI_ENV_ABSENT') == nil, 'list() with no default is nil'
ok('list() splits a value into items')

# ---------------------------------------------------------------------------
# Errors
# ---------------------------------------------------------------------------
assert instance_of(env.ParseError('x', 1, 1), env.EnvError), 'ParseError is an EnvError'
assert instance_of(env.MissingFile('x'), env.EnvError), 'MissingFile is an EnvError'
assert instance_of(env.MissingVariable('x'), env.EnvError), 'MissingVariable is an EnvError'
assert instance_of(env.EnvError('x'), Error), 'EnvError is an Error'
assert env.ParseError('x', 4, 9).to_string().contains('line 4'),
  'a ParseError prints where it stopped'
ok('every error hangs off EnvError')

clear_names()
os.remove_dir(_workspace, true)

echo ''
echo '═══════════════════════════════════════════════════════'
echo '  All ${_passed} assertions passed.'
echo '═══════════════════════════════════════════════════════'
