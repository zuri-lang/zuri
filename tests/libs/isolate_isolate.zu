/**
 * Helper module for `tests/libs/isolate.zu`; plain, module-scoped
 * declarations used to exercise the "Named" (by-binding) resolution
 * path, as opposed to the structural transplant path a main-script
 * declaration goes through.
 */

import isolate

var counter_seed = 100

# `__root__` names the entry file, and it has to name the same one on
# every thread. An isolate loads this module for itself, so a module
# variable reading `__root__` at its top level is what catches an
# isolate VM that was never told what the application's root is.
var root_file = __root__

def root_matches(expected) {
  return root_file == expected
}

def square(n) {
  return n * n
}

def add(a, b) {
  return a + b
}

def make_adder(x) {
  return @(n) {
    return n + x
  }
}

def make_fact() {
  var fact
  fact = @(n) {
    if n <= 1 {
      return 1
    }
    return n * fact(n - 1)
  }
  return fact
}

def uses_module_global(n) {
  return n + counter_seed
}

# A helper declared inside another function is a local of it, so it
# crosses structurally rather than by name.
def make_nested_scaler(factor) {
  def scale(n) {
    return n * factor
  }

  return scale
}

# The same, but the helper also reaches a module this file imported;
# the import is a local of this file's top level, which makes the
# module one of the helper's captured values.
def make_nested_module_user() {
  def pool_is_up(n) {
    return isolate.cpu_count() > 0 and n + counter_seed
  }

  return pool_is_up
}

def boom() {
  raise Error('boom from isolate')
}

def boom_typed() {
  raise TypeError('bad type from isolate')
}

class Counter {
  static var created = 0
  var value

  @new(value) {
    self.value = value
    Counter.created += 1
  }

  increment() {
    self.value += 1
    return self.value
  }

  sum_with(other) {
    return self.value + other.value
  }
}

def make_counter(value) {
  return Counter(value)
}

class Animal {
  var name
  @new(name) { self.name = name }
  speak() { return '${self.name} makes a sound' }
}

class Dog < Animal {
  speak() { return '${self.name} barks' }
}

def make_dog(name) {
  return Dog(name)
}

# Signals on `started` the moment it's actually running, then spins
# until `isolate.is_cancelled()` sees the caller's `cancel()`. The
# rendezvous means a test can call `cancel()` knowing the loop has
# already started, instead of racing isolate startup.
def cancellable_loop(started) {
  started.send(true)
  var iterations = 0
  while !isolate.is_cancelled() {
    iterations += 1
    if iterations > 5000000 {
      break
    }
  }
  return iterations
}

# The next three exist so a cancellation test can put a isolate
# blocked inside wait_any()/wait_all()/select(); those all need
# `isolate` in scope, so (like `cancellable_loop` above) they have to
# live in a real module rather than a main-script closure; a
# main-script closure captures its own `import isolate` as a
# root-global snapshot, and a Module value can't cross a isolate
# boundary at all.
def wait_any_one(started, target) {
  started.send(true)
  return isolate.wait_any([target])
}

def wait_all_one(started, target) {
  started.send(true)
  return isolate.wait_all([target])
}

def select_one(started, ch) {
  started.send(true)
  return isolate.select([ch])
}
