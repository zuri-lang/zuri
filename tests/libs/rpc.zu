var tls_ready = isolate.channel(2)
var tls_options = {
  port: 0,
  workers: 1,
  max_connections: 1,
  cert_chain: server_cert,
  private_key: server_key,
}
var tls_task = isolate.spawn(rpc_servers.run_serve, tls_ready, tls_options)
var tls_address = tls_ready.recv(PATIENCE)

var trust = tls.TlsConfig()
trust.add_ca_pem(ca_cert)

var tls_stream = net.TcpStream()
tls_stream.connect(tls_address)

var secure_client = rpc.endpoint(
  rpc.socket(tls.TlsStream.connect(tls_stream, trust, 'localhost')),
)
assert secure_client.request('secure', nil) == 'over TLS',
    'serve() puts its connections behind TLS'
secure_client.close()
assert tls_ready.recv(PATIENCE) == 'done', 'and ends with them'
tls_task.join(PATIENCE)

var stop_ready = isolate.channel(1)
var stop_task = isolate.spawn(rpc_servers.stop_at_once, stop_ready)
assert stop_ready.recv(PATIENCE) == 'stopped', 'a stopped server returns'
stop_task.join(PATIENCE)

assert raises(
      @() => rpc.serve(rpc_servers.serve_setup, { framing: 'xml' }),
      ValueError,
    ) !=
    nil,
    'an unknown framing is refused'
ok('serve() serves TLS and stops when told to')

# ---------------------------------------------------------------------------
# A child process over its standard streams
# ---------------------------------------------------------------------------
var server_script = os.join_paths(os.dir_name(__file__), '_rpc_stdio_server.zu')
var child = os.spawn(
  os.args[0],
  ['run', server_script],
  { stdin: 'pipe', stdout: 'pipe' },
)
var remote = rpc.endpoint(rpc.process(child))

assert remote.request('echo', { text: 'hé' }) == { text: 'hé' },
    'a child answers over its stdio'
assert raises(@() => remote.listen(), ValueError) != nil,
    'a child is read where it was spawned'
assert remote.request('stop', nil) == 'stopping',
    'and keeps answering until it stops'
remote.close()
assert child.wait(5000) == 0, 'the child ends cleanly'
ok('ProcessTransport and StdioTransport talk across processes')

