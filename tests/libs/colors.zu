/**
 * test_colors.zu
 *
 * Test suite for the `colors` standard library module: color space
 * conversions, hex parsing/formatting, terminal color codes, color
 * manipulation, and WCAG contrast.
 */

import colors

var _passed = 0

def ok(label) {
  _passed++
  echo '  [PASS] ' + label
}

def raises(fn) {
  catch {
    fn()
    return false
  } as e
  return true
}

def close(a, b, tolerance) {
  return (a - b).abs() < tolerance
}

echo '═══════════════════════════════════════════════════════'
echo '  colors module — test suite'
echo '═══════════════════════════════════════════════════════'

# ---------------------------------------------------------------------------
# rgb_to_hsl — saturation formula (2026-08-29 fix)
# ---------------------------------------------------------------------------
var hsl_dark = colors.rgb_to_hsl(0, 128, 0)
assert close(hsl_dark[1], 100, 0.5), 'rgb_to_hsl() saturation for l<=0.5 must use delta/(max+min), not the old always-2-2l formula'
var hsl_light = colors.rgb_to_hsl(200, 240, 200)
assert hsl_light[1] > 0 and hsl_light[1] <= 100, 'rgb_to_hsl() saturation for l>0.5 must stay in a sane 0-100 range'
ok('rgb_to_hsl() computes correct saturation on both sides of l=0.5')

# ---------------------------------------------------------------------------
# hwb_to_rgb — sector index (2026-08-29 fix)
# ---------------------------------------------------------------------------
var hwb_rgb = colors.hwb_to_rgb(322, 5, 60)
assert hwb_rgb[0] >= 0 and hwb_rgb[0] <= 255 and
       hwb_rgb[1] >= 0 and hwb_rgb[1] <= 255 and
       hwb_rgb[2] >= 0 and hwb_rgb[2] <= 255, 'hwb_to_rgb() must never produce an out-of-gamut channel'
ok('hwb_to_rgb() sector index no longer overflows the interpolation factor')

# ---------------------------------------------------------------------------
# ansi256_to_ansi — bit-packing (2026-08-29 fix)
# ---------------------------------------------------------------------------
iter var i = 0; i < 16; i++ {
  var expected = i < 8 ? 30 + i : 90 + (i - 8)
  assert colors.ansi256_to_ansi(i) == expected, 'ansi256_to_ansi() must pass the direct 0-15 range straight through'
}
assert colors.ansi256_to_ansi(21) == 94, 'ansi256_to_ansi() must weight blue correctly (was silently dropped entirely)'
assert colors.ansi256_to_ansi(196) == 91, 'ansi256_to_ansi() must not double-count red in place of blue'
ok('ansi256_to_ansi() bit-packing matches the canonical reference for direct and cube-mapped codes')

# ---------------------------------------------------------------------------
# rgb_to_hex / hex_to_rgb — nil bug, zero-padding, case, #, byte order
# ---------------------------------------------------------------------------
assert colors.rgb_to_hex(255, 0, 0) == 'ff0000', 'rgb_to_hex() must never embed the literal text "nil"'
assert colors.rgb_to_hex(0, 5, 255) == '0005ff', 'rgb_to_hex() must zero-pad every channel to two digits'
assert colors.rgb_to_hex(255, 255, 255, 0) == 'ffffff00', 'rgb_to_hex() must treat alpha=0 as real transparency, not absence'
ok('rgb_to_hex() pads correctly and never leaks a literal "nil"')

assert colors.hex_to_rgb('FF0000') == [255, 0, 0, 1], 'hex_to_rgb() must accept uppercase hex digits'
assert colors.hex_to_rgb('#fff') == [255, 255, 255, 1], 'hex_to_rgb() must accept a leading #'
var with_alpha = colors.hex_to_rgb('ff000080')
assert with_alpha[0] == 255 and with_alpha[1] == 0 and with_alpha[2] == 0,
  'hex_to_rgb() 8-digit form must read RGB from the first three bytes (RRGGBBAA order)'
assert close(with_alpha[3], 0.5019607843137255, 0.001), 'hex_to_rgb() alpha must come from the last byte, not the first'
assert raises(@() => colors.hex_to_rgb('not-a-color')), 'hex_to_rgb() must raise on malformed input, not silently return transparent black'
ok('hex_to_rgb() is case-insensitive, accepts #, and uses RRGGBBAA byte order')

var rt = colors.rgb_to_hex(103, 13, 69)
assert colors.hex_to_rgb(rt) == [103, 13, 69, 1], 'rgb_to_hex() and hex_to_rgb() must round-trip'
ok('rgb_to_hex()/hex_to_rgb() round-trip')

# ---------------------------------------------------------------------------
# hsv_to_rgb / hsl_to_rgb — hue wraparound (2026-08-29 fix)
# ---------------------------------------------------------------------------
assert colors.hsv_to_rgb(-30, 100, 100) != nil, 'hsv_to_rgb() must wrap a negative hue instead of returning nil'
assert colors.hsv_to_rgb(-30, 100, 100) == colors.hsv_to_rgb(330, 100, 100), 'hsv_to_rgb() negative hue must wrap to the same result as its positive equivalent'
ok('hsv_to_rgb() wraps negative hue correctly')

assert colors.hsl_to_rgb(-10, 50, 50) == colors.hsl_to_rgb(350, 50, 50), 'hsl_to_rgb() must wrap a negative hue instead of raising'
assert colors.hsl_to_rgb(370, 50, 50) == colors.hsl_to_rgb(10, 50, 50), 'hsl_to_rgb() must wrap an over-360 hue instead of raising'
assert raises(@() => colors.hsl_to_rgb(10, 150, 50)), 'hsl_to_rgb() must still raise for an out-of-range saturation'
ok('hsl_to_rgb() wraps hue but still validates saturation/lightness')

# ---------------------------------------------------------------------------
# lab_to_rgb — new inverse conversion
# ---------------------------------------------------------------------------
var lab = colors.rgb_to_lab(103, 13, 69)
var lab_back = colors.lab_to_rgb(lab[0], lab[1], lab[2])
assert close(lab_back[0], 103, 1) and close(lab_back[1], 13, 1) and close(lab_back[2], 69, 1),
  'lab_to_rgb() must invert rgb_to_lab() within rounding tolerance'
ok('lab_to_rgb() round-trips with rgb_to_lab()')

# ---------------------------------------------------------------------------
# Color manipulation — new
# ---------------------------------------------------------------------------
var base = '#336699'
var lighter = colors.lighten(base, 20)
var darker = colors.darken(base, 20)
assert colors.rgb_to_hsl(colors.hex_to_rgb(lighter)[0], colors.hex_to_rgb(lighter)[1], colors.hex_to_rgb(lighter)[2])[2] >
       colors.rgb_to_hsl(colors.hex_to_rgb(base)[0], colors.hex_to_rgb(base)[1], colors.hex_to_rgb(base)[2])[2],
  'lighten() must increase HSL lightness'
assert colors.rgb_to_hsl(colors.hex_to_rgb(darker)[0], colors.hex_to_rgb(darker)[1], colors.hex_to_rgb(darker)[2])[2] <
       colors.rgb_to_hsl(colors.hex_to_rgb(base)[0], colors.hex_to_rgb(base)[1], colors.hex_to_rgb(base)[2])[2],
  'darken() must decrease HSL lightness'
ok('lighten()/darken() move HSL lightness in the correct direction')

var more_sat = colors.saturate(base, 20)
var less_sat = colors.desaturate(base, 20)
assert colors.rgb_to_hsl(colors.hex_to_rgb(more_sat)[0], colors.hex_to_rgb(more_sat)[1], colors.hex_to_rgb(more_sat)[2])[1] >
       colors.rgb_to_hsl(colors.hex_to_rgb(base)[0], colors.hex_to_rgb(base)[1], colors.hex_to_rgb(base)[2])[1],
  'saturate() must increase HSL saturation'
assert colors.rgb_to_hsl(colors.hex_to_rgb(less_sat)[0], colors.hex_to_rgb(less_sat)[1], colors.hex_to_rgb(less_sat)[2])[1] <
       colors.rgb_to_hsl(colors.hex_to_rgb(base)[0], colors.hex_to_rgb(base)[1], colors.hex_to_rgb(base)[2])[1],
  'desaturate() must decrease HSL saturation'
ok('saturate()/desaturate() move HSL saturation in the correct direction')

assert colors.rgb_to_hsl(colors.hex_to_rgb(colors.grayscale(base))[0], colors.hex_to_rgb(colors.grayscale(base))[1], colors.hex_to_rgb(colors.grayscale(base))[2])[1] == 0,
  'grayscale() must produce zero HSL saturation'
ok('grayscale() zeroes out saturation')

assert colors.invert('#000000') == '000000' or colors.invert('#000000') == 'ffffff',
  'invert() must flip channels (sanity: black or white result)'
assert colors.hex_to_rgb(colors.invert('#336699'))[0] == 255 - colors.hex_to_rgb('#336699')[0],
  'invert() must compute 255 - channel per channel'
ok('invert() flips every RGB channel')

assert colors.mix('#000000', '#ffffff') == '808080', 'mix() with no weight must default to the midpoint'
assert colors.mix('#000000', '#ffffff', 0) == '000000', 'mix() with weight 0 must return the first color'
assert colors.mix('#000000', '#ffffff', 1) == 'ffffff', 'mix() with weight 1 must return the second color'
ok('mix() interpolates correctly across its weight range')

var translucent = colors.lighten('#ff000080', 0)
assert translucent.length() == 8, 'lighten() must preserve a non-opaque alpha channel through the hex round-trip'
var opaque = colors.lighten('#ff0000', 0)
assert opaque.length() == 6, 'lighten() must not add an alpha suffix to an already-opaque color'
ok('color manipulation functions preserve alpha only when the input actually has any')

# ---------------------------------------------------------------------------
# contrast_ratio — new
# ---------------------------------------------------------------------------
assert close(colors.contrast_ratio('#000000', '#ffffff'), 21, 0.01), 'contrast_ratio() black vs white must be 21'
assert colors.contrast_ratio('#336699', '#336699') == 1, 'contrast_ratio() of a color against itself must be 1'
assert colors.contrast_ratio('#000000', '#ffffff') == colors.contrast_ratio('#ffffff', '#000000'),
  'contrast_ratio() must be symmetric regardless of argument order'
ok('contrast_ratio() matches the WCAG formula at its known extremes')

# ===========================================================================
# Final summary
# ===========================================================================
echo ''
echo '═══════════════════════════════════════════════════════'
echo '  All ${_passed} assertions passed.'
echo '═══════════════════════════════════════════════════════'
