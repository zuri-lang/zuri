import isolate
import compress.gzip
import .isolate_isolate
import .isolate_panic_isolate

def test_basic_spawn_join() {
  var t = isolate.spawn(isolate_isolate.square, 9)
  assert t.join() == 81, 'basic spawn/join should return the callee result'
  echo 'test_basic_spawn_join passed'
}

def test_join_is_repeatable() {
  var t = isolate.spawn(isolate_isolate.square, 7)
  var first = t.join()
  var second = t.join()
  var third = t.join()
  assert first == 49 and second == 49 and third == 49,
    'join() must return the same result on every call'
  echo 'test_join_is_repeatable passed'
}

def test_is_done_and_try_join() {
  # a isolate blocked on a channel recv cannot possibly have
  # finished yet, so this is a deterministic way to observe "pending"
  # rather than racing a fast function against our own check.
  var gate = isolate.channel(0)
  var t = isolate.spawn(@(ch) {
    var v = ch.recv()
    return v * 2
  }, gate)

  assert !t.is_done(), 'isolate blocked on an unfed channel must not be done yet'
  assert t.try_join() == nil, 'try_join() must return nil while pending'

  gate.send(21)
  assert t.join() == 42, 'join() must block until the isolate actually finishes'
  assert t.is_done(), 'isolate must be done after join() returns'
  assert t.try_join() == 42, 'try_join() must return the result once finished'
  echo 'test_is_done_and_try_join passed'
}

def test_closure_capturing_local() {
  var add5 = isolate_isolate.make_adder(5)
  var t = isolate.spawn(add5, 10)
  assert t.join() == 15, 'closure must carry its captured value across'
  echo 'test_closure_capturing_local passed'
}

def test_closure_mutation_independence() {
  var state = [0]
  var bump = @() {
    state[0] += 1
    return state[0]
  }

  var t1 = isolate.spawn(bump)
  var t2 = isolate.spawn(bump)
  var r1 = t1.join()
  var r2 = t2.join()

  assert r1 == 1, 'each isolate must see its own independent snapshot, starting fresh'
  assert r2 == 1, 'a second isolate spawned from the same closure gets its own copy too'
  assert state[0] == 0, 'mutating the captured list inside a isolate must not affect the caller'

  state[0] += 1
  assert state[0] == 1, 'mutating the caller copy afterward must not affect anything already sent'
  echo 'test_closure_mutation_independence passed'
}

def test_recursive_closure() {
  var fact = isolate_isolate.make_fact()
  var t = isolate.spawn(fact, 6)
  assert t.join() == 720, 'a closure capturing itself must round-trip correctly'
  echo 'test_recursive_closure passed'
}

def test_closure_references_module_global() {
  var t = isolate.spawn(isolate_isolate.uses_module_global, 5)
  assert t.join() == 105, 'a function referencing its own module global must resolve it on the isolate'
  echo 'test_closure_references_module_global passed'
}

def test_anonymous_lambda() {
  var t = isolate.spawn(@(n) { return n + 100 }, 1)
  assert t.join() == 101, 'an anonymous lambda never bound to a name must still be spawnable'
  echo 'test_anonymous_lambda passed'
}

def test_main_script_function() {
  var t = isolate.spawn(local_double, 21)
  assert t.join() == 42, 'a function declared directly in this script must be spawnable'
  echo 'test_main_script_function passed'
}

def local_boom() {
  raise TypeError('a builtin error class raised from a main-script function')
}

def test_main_script_function_raises_builtin_error() {
  # `local_boom` never binds `TypeError` to a module-level name --
  # referencing it is a `GetGlobal` against the VM's own root table,
  # picked up transitively as a root global this main-script function
  # depends on. `TypeError` (like every builtin error class) is
  # installed fresh by every isolate's own `VM::init`, not declared in
  # any module; a naive structural clone of it would produce a class
  # the isolate's own `raise`/`catch` doesn't recognize, turning this
  # into a confusing "can only raise an Error or subclass" failure
  # instead of the real one.
  var t = isolate.spawn(local_boom)
  catch {
    t.join()
  } as e
  assert e != nil, 'raising a builtin error class inside a isolate must surface on join()'
  assert instance_of(e, isolate.IsolateError), 'it must surface as an ordinary IsolateError'
  assert e.message.contains('a builtin error class raised from a main-script function'),
    'the original message must be preserved, not replaced by an internal raise-machinery error'
  echo 'test_main_script_function_raises_builtin_error passed'
}

def local_double(n) {
  return n * 2
}

def test_main_script_class() {
  var box = LocalBox(41)
  var t = isolate.spawn(@() { return box.value + 1 })
  assert t.join() == 42, 'a class declared directly in this script must cross correctly'
  echo 'test_main_script_class passed'
}

class LocalBox {
  var value
  @new(value) { self.value = value }
}

def test_main_script_class_constructed_inside_isolate() {
  # a structurally-transferred class's constructor must actually run
  # on the isolate side too, not just when an already-built instance
  # crosses as data; this is what test_main_script_class exercises.
  var t = isolate.spawn(@() {
    var box = LocalBox(9)
    return box.value
  })
  assert t.join() == 9, "a class's own @new() must run correctly when constructed inside a isolate"
  echo 'test_main_script_class_constructed_inside_isolate passed'
}

def test_main_script_class_survives_gc_and_jit_warmup_inside_isolate() {
  # a materialized prototype's string constants (field/method names)
  # must be allocated the same "never moves" way the compiler's own
  # constants are: enough iterations here both warms this method up
  # to JIT-compiled code (which bakes a field name's raw bits in as a
  # machine-code immediate) AND pushes the isolate's nursery through a
  # real minor collection; if a constant were movable, that
  # collection would relocate it out from under the already-baked
  # pointer and crash the whole process, not just this isolate.
  var t = isolate.spawn(@() {
    var sum = 0
    iter var i = 0; i < 20000; i++ {
      var box = LocalBox(i)
      sum += box.value
    }
    return sum
  })
  assert t.join() == 199990000, 'field access on a fresh instance must stay correct across a GC inside the isolate'
  echo 'test_main_script_class_survives_gc_and_jit_warmup_inside_isolate passed'
}

def test_module_scoped_class_instance() {
  var c = isolate_isolate.make_counter(10)
  var t = isolate.spawn(@(counter) { return counter.increment() }, c)
  assert t.join() == 11, 'an instance argument must round-trip with its own methods usable'
  assert c.value == 10, 'mutating the copy inside a isolate must not affect the caller instance'
  echo 'test_module_scoped_class_instance passed'
}

def test_bound_method_as_spawn_target() {
  var c = isolate_isolate.make_counter(5)
  var t = isolate.spawn(c.increment)
  assert t.join() == 6, 'a bound method must be directly spawnable, receiver included'
  echo 'test_bound_method_as_spawn_target passed'
}

def test_bound_method_as_argument() {
  var a = isolate_isolate.make_counter(3)
  var b = isolate_isolate.make_counter(4)
  var t = isolate.spawn(@(sum_fn, other) { return sum_fn(other) }, a.sum_with, b)
  assert t.join() == 7, 'a bound method passed as ordinary data must still be callable on the isolate'
  echo 'test_bound_method_as_argument passed'
}

def test_class_inheritance_across_boundary() {
  var d = isolate_isolate.make_dog('Rex')
  var t = isolate.spawn(@(animal) { return animal.speak() }, d)
  assert t.join() == 'Rex barks', 'an overridden method must resolve to the subclass version'
  echo 'test_class_inheritance_across_boundary passed'
}

def test_class_statics_snapshot_independence() {
  var before = isolate_isolate.Counter.created
  var t = isolate.spawn(isolate_isolate.make_counter, 1)
  t.join()
  # the isolate constructed its own Counter on its own isolated copy
  # of the class, so the caller's own static field is untouched.
  assert isolate_isolate.Counter.created == before,
    'a static field mutated on the isolate must not affect the caller-side class'
  echo 'test_class_statics_snapshot_independence passed'
}

def test_nested_collection_aliasing() {
  var shared = [1, 2, 3]
  var outer = [shared, shared]
  var t = isolate.spawn(@(pair) {
    pair[0].append(4)
    return pair[1].length()
  }, outer)
  assert t.join() == 4, 'two arguments aliasing the same list must still alias each other after the copy'
  assert shared.length() == 3, 'the caller-side list must be unaffected'
  echo 'test_nested_collection_aliasing passed'
}

def test_self_referential_list_does_not_hang() {
  var cyclic = [1, 2]
  cyclic.append(cyclic)
  var t = isolate.spawn(@(x) {
    return is_list(x[2]) and x.length()
  }, cyclic)
  assert t.join() == 3, 'a self-referential list must round-trip without hanging or corrupting its shape'
  echo 'test_self_referential_list_does_not_hang passed'
}

def test_dict_argument() {
  var d = { a: 1, b: 2 }
  var t = isolate.spawn(@(m) { return m['a'] + m['b'] }, d)
  assert t.join() == 3, 'a dict argument must cross correctly'
  echo 'test_dict_argument passed'
}

def test_multiple_concurrent_isolates() {
  var tasks = []
  var i = 0
  while i < 8 {
    tasks.append(isolate.spawn(isolate_isolate.square, i))
    i += 1
  }

  var j = 0
  while j < 8 {
    assert tasks[j].join() == j * j, 'each concurrently-spawned isolate must return its own correct result'
    j += 1
  }
  echo 'test_multiple_concurrent_isolates passed'
}

def test_uncaught_error_propagates() {
  var t = isolate.spawn(isolate_isolate.boom)
  catch {
    t.join()
  } as e
  assert e != nil, 'an uncaught error inside a isolate must surface on join()'
  assert instance_of(e, isolate.IsolateError), 'it must surface specifically as a IsolateError'
  echo 'test_uncaught_error_propagates passed'
}

def test_isolate_panic_is_isolated() {
  var t = isolate.spawn(isolate_panic_isolate.trigger_panic)
  catch {
    t.join()
  } as e
  assert e != nil, 'a Rust-level panic inside a isolate must surface on join(), not crash the process'
  assert instance_of(e, isolate.IsolateError), 'a panic must surface as an ordinary IsolateError'

  # the pool's isolate threads must survive a panic and keep serving
  # later isolates; a panicked isolate is rebuilt, never reused.
  var t2 = isolate.spawn(isolate_isolate.square, 9)
  assert t2.join() == 81, 'the pool must still work correctly after a panic on one of its isolates'
  echo 'test_isolate_panic_is_isolated passed'
}

def test_uncaught_error_message_preserved() {
  var t = isolate.spawn(isolate_isolate.boom_typed)
  catch {
    t.join()
  } as e
  assert e != nil, 'a typed error must still be caught as a IsolateError'
  assert e.message.contains('bad type from isolate'), 'the original error text should be preserved in the message'
  echo 'test_uncaught_error_message_preserved passed'
}

