  catch {
    isolate.spawn(isolate_isolate.Counter)
  } as e
  assert e != nil and instance_of(e, TypeError),
    'spawning a class itself (as opposed to an instance method) must be rejected as not callable'
  echo 'test_spawn_rejects_class passed'
}

def test_file_handle_rejected() {
  var f = file(__file__)
  catch {
    isolate.spawn(isolate_isolate.square, f)
  } as e
  f.close()
  assert e != nil and instance_of(e, isolate.IsolateError),
    'a file handle must never be allowed to cross a isolate boundary'
  echo 'test_file_handle_rejected passed'
}

def test_channel_basic_send_recv() {
  var ch = isolate.channel()
  ch.send('hello')
  assert ch.recv() == 'hello', 'a sent value must be received unchanged'
  echo 'test_channel_basic_send_recv passed'
}

def test_channel_fifo_order() {
  var ch = isolate.channel()
  ch.send(1)
  ch.send(2)
  ch.send(3)
  assert ch.recv() == 1 and ch.recv() == 2 and ch.recv() == 3,
    'messages must be received in the order they were sent'
  echo 'test_channel_fifo_order passed'
}

def test_channel_close_semantics() {
  var ch = isolate.channel()
  ch.send('a')
  ch.close()

  assert ch.is_closed(), 'is_closed() must report true after close()'
  assert ch.recv() == 'a', 'a value queued before close() must still be receivable'
  assert ch.recv() == nil, 'recv() must return nil once a closed channel is fully drained'

  catch {
    ch.send('too late')
  } as e
  assert e != nil and instance_of(e, isolate.IsolateError), 'send() on a closed channel must raise'
  echo 'test_channel_close_semantics passed'
}

def test_channel_try_recv() {
  var ch = isolate.channel()
  assert ch.try_recv() == nil, 'try_recv() on an empty channel must return nil, not block'
  ch.send('x')
  assert ch.try_recv() == 'x', 'try_recv() must return an already-queued value immediately'
  echo 'test_channel_try_recv passed'
}

def test_channel_len() {
  var ch = isolate.channel()
  assert ch.length() == 0, 'a fresh channel must report zero queued values'
  ch.send(1)
  ch.send(2)
  assert ch.length() == 2, 'len() must reflect the number of unread queued values'
  ch.recv()
  assert ch.length() == 1, 'len() must decrease as values are received'
  echo 'test_channel_len passed'
}

def test_channel_producer_consumer() {
  var ch = isolate.channel(2)
  var producer = isolate.spawn(@(out) {
    var i = 0
    while i < 20 {
      out.send(i)
      i += 1
    }
    out.close()
    return i
  }, ch)

  var total = 0
  var count = 0
  var v = ch.recv()
  while v != nil {
    total += v
    count += 1
    v = ch.recv()
  }

  assert count == 20, 'a consumer draining a bounded channel must receive every message the producer sent'
  assert total == 190, 'every message must arrive with its correct value (sum 0..19 == 190)'
  assert producer.join() == 20, 'the producer isolate must still complete normally afterward'
  echo 'test_channel_producer_consumer passed'
}

def test_channel_constructor_validation() {
  catch {
    isolate.channel('bad')
  } as e1
  assert e1 != nil and instance_of(e1, TypeError), 'a non-integer capacity must raise TypeError'

  catch {
    isolate.channel(-1)
  } as e2
  assert e2 != nil and instance_of(e2, ValueError), 'a negative capacity must raise ValueError'
  echo 'test_channel_constructor_validation passed'
}

def test_ptr_transfer_move_semantics() {
  var enc = gzip.GzipEncoder(6)
  var t = isolate.spawn(@(e) {
    e.write('data compressed on a isolate thread')
    return e.finish()
  }, enc)

  var result = t.join()
  assert is_bytes(result) and result.length() > 0,
    'a native resource argument must be usable on the isolate and produce a real result'

  catch {
    enc.write('should not work on the sender anymore')
  } as e
  assert e != nil, 'the source reference must be inert after the resource has moved'
  echo 'test_ptr_transfer_move_semantics passed'
}

def test_cancellation_cooperative() {
  var started = isolate.channel(0)
  var t = isolate.spawn(isolate_isolate.cancellable_loop, started)
  started.recv()

  assert !t.is_cancelled(), 'must not be cancelled before cancel() is called'
  t.cancel()
  assert t.is_cancelled(), 'is_cancelled() must reflect cancel() right away'

  var iterations = t.join()
  assert iterations < 5000000, 'the loop must stop once it observes cancellation, not hit its safety cap'
  echo 'test_cancellation_cooperative passed'
}

def test_cancel_on_finished_isolate() {
  var t = isolate.spawn(isolate_isolate.square, 5)
  assert t.join() == 25, 'expected 25'
  assert !t.is_cancelled(), 'a isolate must not be cancelled unless cancel() was actually called'
  t.cancel()
  assert t.is_cancelled(), 'cancel() on an already-finished isolate is a harmless no-op, not an error'
  echo 'test_cancel_on_finished_isolate passed'
}

def test_is_cancelled_outside_a_isolate() {
  assert !isolate.is_cancelled(), 'is_cancelled() outside any isolate must always be false'
  echo 'test_is_cancelled_outside_a_isolate passed'
}

def test_join_timeout_elapses() {
  var gate = isolate.channel(0)
  var t = isolate.spawn(@(ch) { return ch.recv() }, gate)

  var timed_out = false
  catch {
    t.join(0.05)
  } as e {
    timed_out = instance_of(e, isolate.IsolateTimeoutError)
  }
  assert timed_out, 'join(timeout) must raise IsolateTimeoutError once the timeout elapses'

  gate.send(99)
  assert t.join() == 99, 'the isolate must still be joinable normally afterward'
  echo 'test_join_timeout_elapses passed'
}

def test_join_timeout_succeeds_in_time() {
  var t = isolate.spawn(isolate_isolate.square, 6)
  assert t.join(5) == 36, 'join(timeout) must return the result normally when it finishes in time'
  echo 'test_join_timeout_succeeds_in_time passed'
}

def test_channel_send_timeout() {
  var ch = isolate.channel(1)
  ch.send(1)

  var timed_out = false
  catch {
    ch.send(2, 0.05)
  } as e {
    timed_out = instance_of(e, isolate.IsolateTimeoutError)
  }
  assert timed_out, 'send(timeout) on a full channel must raise IsolateTimeoutError'
  assert ch.recv() == 1, 'the value already queued must still be there'
  echo 'test_channel_send_timeout passed'
}

def test_channel_recv_timeout() {
  var ch = isolate.channel(0)

  var timed_out = false
  catch {
    ch.recv(0.05)
  } as e {
    timed_out = instance_of(e, isolate.IsolateTimeoutError)
  }
  assert timed_out, 'recv(timeout) on an empty channel must raise IsolateTimeoutError'

  ch.send(7)
  assert ch.recv() == 7, 'the channel must still work normally afterward'
  echo 'test_channel_recv_timeout passed'
}

def test_wait_any_returns_first_finished() {
  var gate_a = isolate.channel(0)
  var gate_b = isolate.channel(0)
  var gate_c = isolate.channel(0)
  var a = isolate.spawn(@(ch) { return ch.recv() }, gate_a)
  var b = isolate.spawn(@(ch) { return ch.recv() }, gate_b)
  var c = isolate.spawn(@(ch) { return ch.recv() }, gate_c)

  gate_b.send(2)
  var winner = isolate.wait_any([a, b, c])
  assert winner == b, 'wait_any() must return the isolate that actually finished'
  assert winner.join() == 2, 'the winning handle must still be joinable normally'

  gate_a.send(1)
  gate_c.send(3)
  a.join()
  c.join()
  echo 'test_wait_any_returns_first_finished passed'
}

def test_wait_any_rejects_empty_list() {
  catch {
    isolate.wait_any([])
  } as e
  assert e != nil and instance_of(e, ValueError), 'wait_any() must reject an empty list'
  echo 'test_wait_any_rejects_empty_list passed'
}

def test_wait_any_timeout() {
  var gate = isolate.channel(0)
  var t = isolate.spawn(@(ch) { return ch.recv() }, gate)

  var timed_out = false
  catch {
    isolate.wait_any([t], 0.05)
  } as e {
    timed_out = instance_of(e, isolate.IsolateTimeoutError)
  }
  assert timed_out, 'wait_any() must raise IsolateTimeoutError once the timeout elapses'

  gate.send(7)
  assert t.join() == 7, 'the isolate must still be joinable normally after a timed-out wait_any()'
  echo 'test_wait_any_timeout passed'
}

def test_select_returns_ready_channel() {
  var x = isolate.channel(1)
  var y = isolate.channel(1)
  var z = isolate.channel(1)
  z.send('picked me')

  var result = isolate.select([x, y, z])
  assert result[0] == z, 'select() must report the channel that was actually ready'
  assert result[1] == 'picked me', 'select() must return the value already received from it'
  assert z.length() == 0, 'the value select() returned must have been removed from the channel'
  echo 'test_select_returns_ready_channel passed'
}

def test_select_on_closed_channel() {
  var open_ch = isolate.channel(0)
  var closed_ch = isolate.channel(0)
  closed_ch.close()

  var result = isolate.select([open_ch, closed_ch])
  assert result[0] == closed_ch, 'a closed, empty channel counts as immediately ready'
  assert result[1] == nil, 'a closed channel yields nil, same as recv() on one'
  echo 'test_select_on_closed_channel passed'
}

def test_select_rejects_empty_list() {
  catch {
    isolate.select([])
  } as e
  assert e != nil and instance_of(e, ValueError), 'select() must reject an empty list'
  echo 'test_select_rejects_empty_list passed'
}

def test_select_timeout() {
  var ch = isolate.channel(0)

  var timed_out = false
  catch {
    isolate.select([ch], 0.05)
  } as e {
    timed_out = instance_of(e, isolate.IsolateTimeoutError)
  }
  assert timed_out, 'select() must raise IsolateTimeoutError once the timeout elapses'

  ch.send(9)
  assert ch.recv() == 9, 'the channel must still work normally afterward'
  echo 'test_select_timeout passed'
}

def test_wait_all_collects_results_in_order() {
  var a = isolate.spawn(isolate_isolate.square, 2)
  var b = isolate.spawn(isolate_isolate.square, 3)
  var c = isolate.spawn(isolate_isolate.square, 4)
  var results = isolate.wait_all([a, b, c])
  assert results == [4, 9, 16], 'wait_all() must return results in the same order as its input'
  echo 'test_wait_all_collects_results_in_order passed'
}

def test_wait_all_empty_list() {
  assert isolate.wait_all([]) == [], 'wait_all() on an empty list must return an empty list'
  echo 'test_wait_all_empty_list passed'
}

def test_wait_all_raises_first_failure() {
  var ok = isolate.spawn(isolate_isolate.square, 5)
  var failing = isolate.spawn(isolate_isolate.boom)
  var e = nil
  catch {
    isolate.wait_all([ok, failing])
  } as caught {
    e = caught
  }
  assert e != nil and instance_of(e, isolate.IsolateError),
    'wait_all() must surface a failing isolate as IsolateError'
  echo 'test_wait_all_raises_first_failure passed'
}

def test_wait_all_timeout() {
  var gate = isolate.channel(0)
  var t = isolate.spawn(@(ch) { return ch.recv() }, gate)

  var timed_out = false
  catch {
    isolate.wait_all([t], 0.05)
  } as e {
    timed_out = instance_of(e, isolate.IsolateTimeoutError)
  }
  assert timed_out, 'wait_all() must raise IsolateTimeoutError once the timeout elapses'

  gate.send(3)
  assert t.join() == 3, 'the isolate must still be joinable normally afterward'
  echo 'test_wait_all_timeout passed'
}

def test_map_runs_in_parallel_and_preserves_order() {
  var results = isolate.map(isolate_isolate.square, [1, 2, 3, 4, 5])
  assert results == [1, 4, 9, 16, 25], 'map() must apply fn to every item and preserve input order'
  echo 'test_map_runs_in_parallel_and_preserves_order passed'
}

def test_map_propagates_failure() {
  var e = nil
  catch {
    isolate.map(@(n) { raise TypeError('boom ${n}') }, [1, 2])
  } as caught {
    e = caught
  }
  assert e != nil and instance_of(e, isolate.IsolateError),
    'map() must surface a failing call as IsolateError'
  echo 'test_map_propagates_failure passed'
}

def test_cancel_interrupts_blocked_recv() {
  var started = isolate.channel(0)
  var gate = isolate.channel(0)
  var t = isolate.spawn(@(st, ch) {
    st.send(true)
    return ch.recv()
  }, started, gate)
  started.recv()
  t.cancel()

  var e = nil
  catch {
    t.join()
  } as caught {
    e = caught
  }
  assert e != nil and instance_of(e, isolate.IsolateError),
    'a isolate cancelled while blocked in recv() must fail'
  assert e.message.starts_with('IsolateCancelledError:'),
    'the failure must specifically be a IsolateCancelledError, not a generic one'
  echo 'test_cancel_interrupts_blocked_recv passed'
}

def test_cancel_interrupts_blocked_send() {
  var started = isolate.channel(0)
  var ch = isolate.channel(1)
  ch.send(1)
  var t = isolate.spawn(@(st, c) {
    st.send(true)
    c.send(2)
    return nil
  }, started, ch)
  started.recv()
  t.cancel()

  var e = nil
  catch {
    t.join()
  } as caught {
    e = caught
  }
  assert e != nil and instance_of(e, isolate.IsolateError),
    'a isolate cancelled while blocked in send() must fail'
  assert e.message.starts_with('IsolateCancelledError:'),
    'the failure must specifically be a IsolateCancelledError, not a generic one'
  echo 'test_cancel_interrupts_blocked_send passed'
}

def test_cancel_interrupts_blocked_join() {
  var inner_gate = isolate.channel(0)
  var inner = isolate.spawn(@(ch) { return ch.recv() }, inner_gate)

  var started = isolate.channel(0)
  var outer = isolate.spawn(@(st, target) {
    st.send(true)
    return target.join()
  }, started, inner)
  started.recv()
  outer.cancel()

  var e = nil
  catch {
    outer.join()
  } as caught {
    e = caught
  }
  assert e != nil and instance_of(e, isolate.IsolateError),
    'a isolate cancelled while blocked joining another must fail'
  assert e.message.starts_with('IsolateCancelledError:'),
    'the failure must specifically be a IsolateCancelledError, not a generic one'

  inner_gate.send(1)
  assert inner.join() == 1, 'the isolate being joined is unaffected and still completes normally'
  echo 'test_cancel_interrupts_blocked_join passed'
}

