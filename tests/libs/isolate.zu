def test_scope_reports_real_child_failure_not_cancellation_artifact() {
  var started = isolate.channel(0)
  var gate = isolate.channel(0)
  var e = nil
  catch {
    isolate.scope(@(s) {
      # spawned FIRST; if the cancellation-artifact filtering in
      # scope() were broken, this one's own IsolateCancelledError
      # would incorrectly win as "first" in spawn order once cancelled
      s.spawn(@(st, ch) {
        st.send(true)
        return ch.recv()
      }, started, gate)
      started.recv()
      s.spawn(@() { raise TypeError('the real bug') })
    })
  } as caught {
    e = caught
  }
  assert e != nil and instance_of(e, isolate.IsolateError),
    'scope() must raise IsolateError from the genuinely failing child'
  assert e.message.contains('the real bug'), 'scope() must report the ACTUAL bug'
  assert !e.message.contains('IsolateCancelledError'),
    'scope() must not report a cancelled sibling as the root cause'
  echo 'test_scope_reports_real_child_failure_not_cancellation_artifact passed'
}

def test_spawn_named_and_name() {
  var t = isolate.spawn(isolate_isolate.square, 3)
  assert t.name() == nil, 'a plain spawn() must leave the isolate unnamed'
  assert t.join() == 9, 'expected 9'

  var named = isolate.spawn_named('squarer', isolate_isolate.square, 4)
  assert named.name() == 'squarer', 'spawn_named() must set the name spawn() leaves unset'
  assert named.join() == 16, 'expected 16'
  echo 'test_spawn_named_and_name passed'
}

def test_scope_spawn_named() {
  var result = isolate.scope(@(s) {
    var t = s.spawn_named('scoped-isolate', isolate_isolate.square, 5)
    assert t.name() == 'scoped-isolate', 'Scope.spawn_named() must set the name'
    return t.join()
  })
  assert result == 25, 'expected 25'
  echo 'test_scope_spawn_named passed'
}

def test_scope_happy_path() {
  var result = isolate.scope(@(s) {
    var a = s.spawn(isolate_isolate.square, 3)
    var b = s.spawn(isolate_isolate.square, 4)
    return a.join() + b.join()
  })
  assert result == 25, 'scope() must return whatever body() returned when nothing failed'
  echo 'test_scope_happy_path passed'
}

def test_scope_waits_for_children_even_without_joining_them() {
  var done_marker = isolate.channel(1)
  isolate.scope(@(s) {
    s.spawn(@(marker) {
      marker.send(true)
    }, done_marker)
  })
  assert done_marker.length() == 1, 'scope() must not return until every spawned child has actually finished'
  echo 'test_scope_waits_for_children_even_without_joining_them passed'
}

def test_scope_child_failure_cancels_siblings_and_raises() {
  var started = isolate.channel(0)
  var slow_handle = nil
  var e = nil
  catch {
    isolate.scope(@(s) {
      slow_handle = s.spawn(isolate_isolate.cancellable_loop, started)
      started.recv()
      s.spawn(@() { raise TypeError('kaboom') })
    })
  } as caught {
    e = caught
  }
  assert e != nil and instance_of(e, isolate.IsolateError),
    'scope() must raise IsolateError once a child fails'
  assert slow_handle.is_done(), 'scope() must not return until every child, cancelled or not, has finished'
  assert slow_handle.join() < 5000000,
    'the sibling must have noticed cancellation rather than hitting its safety cap'
  echo 'test_scope_child_failure_cancels_siblings_and_raises passed'
}

def test_scope_body_failure_cancels_children_and_wins() {
  var started = isolate.channel(0)
  var slow_handle = nil
  var e = nil
  catch {
    isolate.scope(@(s) {
      slow_handle = s.spawn(isolate_isolate.cancellable_loop, started)
      started.recv()
      raise ValueError('body blew up')
    })
  } as caught {
    e = caught
  }
  assert e != nil and instance_of(e, ValueError), "body()'s own error must win over a child's"
  assert e.message == 'body blew up', "body()'s own error must be re-raised unchanged"
  assert slow_handle.is_done(), 'scope() must still wait for the cancelled child before re-raising'
  echo 'test_scope_body_failure_cancels_children_and_wins passed'
}

def test_status_reflects_lifecycle() {
  var t = isolate.spawn(isolate_isolate.square, 6)
  assert t.status() == 'pending' or t.status() == 'done', 'status() must report a real lifecycle state'
  assert t.join() == 36, 'expected 36'
  assert t.status() == 'done', 'status() must report done once finished successfully'

  var f = isolate.spawn(isolate_isolate.boom)
  catch { f.join() } as e
  assert f.status() == 'error', 'status() must report error once finished with an uncaught error'
  echo 'test_status_reflects_lifecycle passed'
}

def test_status_does_not_suppress_unobserved_warning() {
  # peek()-based status() must never mark a failure "observed" --
  # poll it a few times and confirm join() can still see the failure
  # normally afterward.
  var f = isolate.spawn(isolate_isolate.boom)
  f.status()
  f.status()
  var e = nil
  catch {
    f.join()
  } as caught {
    e = caught
  }
  assert e != nil and instance_of(e, isolate.IsolateError),
    'polling status() must not interfere with join() still seeing the failure'
  echo 'test_status_does_not_suppress_unobserved_warning passed'
}

def test_introspection_pool_counts() {
  var size = isolate.pool_size()
  var started = isolate.channel(0)
  var gates = []
  var tasks = []
  var i = 0
  while i < size {
    var g = isolate.channel(0)
    gates.append(g)
    tasks.append(isolate.spawn(@(st, ch) {
      st.send(true)
      return ch.recv()
    }, started, g))
    i += 1
  }
  # wait for every one of them to actually be running (blocked on its
  # own gate), so the counts below can't be checked before they apply
  i = 0
  while i < size {
    started.recv()
    i += 1
  }

  # one more than the pool can possibly run at once; guaranteed to
  # sit in the queue, since every isolate is confirmed busy above
  var extra_gate = isolate.channel(0)
  var extra = isolate.spawn(@(ch) { return ch.recv() }, extra_gate)

  assert isolate.active_count() >= size, 'active_count() must report every busy isolate'
  assert isolate.queued_count() >= 1, 'a task beyond the pool size must sit in the queue'

  for g in gates {
    g.send(1)
  }
  extra_gate.send(1)
  for t in tasks {
    t.join()
  }
  extra.join()
  echo 'test_introspection_pool_counts passed'
}

def test_introspection_is_shutdown() {
  assert !isolate.is_shutdown(), 'is_shutdown() must be false before shutdown() is called'
  echo 'test_introspection_is_shutdown passed'
}

def test_broadcast_fanout_to_all_subscribers() {
  var b = isolate.broadcast()
  var s1 = b.subscribe()
  var s2 = b.subscribe()

  b.send('hello')
  assert s1.recv() == 'hello', 'every subscriber must receive a broadcast value'
  assert s2.recv() == 'hello', 'every subscriber must receive a broadcast value'
  echo 'test_broadcast_fanout_to_all_subscribers passed'
}

def test_broadcast_late_subscriber_misses_earlier_sends() {
  var b = isolate.broadcast()
  var early = b.subscribe()
  b.send('before')
  var late = b.subscribe()
  b.send('after')

  assert early.recv() == 'before', 'a subscriber sees everything sent after it subscribed'
  assert early.recv() == 'after', 'a subscriber sees everything sent after it subscribed'
  assert late.recv() == 'after', 'a subscriber must not see values sent before it subscribed'
  assert late.length() == 0, 'a late subscriber has nothing queued beyond what was sent after it joined'
  echo 'test_broadcast_late_subscriber_misses_earlier_sends passed'
}

def test_broadcast_unsubscribe() {
  var b = isolate.broadcast()
  var s1 = b.subscribe()
  var s2 = b.subscribe()
  assert b.subscriber_count() == 2, 'expected two subscribers'

  b.unsubscribe(s1)
  assert b.subscriber_count() == 1, 'unsubscribe() must remove the subscriber from the count'

  b.send('only s2')
  assert s2.recv() == 'only s2', 's2 must still receive broadcasts'
  assert s1.length() == 0, 'an unsubscribed channel must not receive further broadcasts'
  echo 'test_broadcast_unsubscribe passed'
}

def test_broadcast_close_closes_subscribers() {
  var b = isolate.broadcast()
  var s = b.subscribe()
  b.close()

  assert b.is_closed(), 'is_closed() must reflect close()'
  assert s.is_closed(), 'close() must close every current subscriber channel too'
  echo 'test_broadcast_close_closes_subscribers passed'
}

def test_broadcast_rejects_operations_after_close() {
  var b = isolate.broadcast()
  b.close()

  var e = nil
  catch {
    b.subscribe()
  } as caught {
    e = caught
  }
  assert e != nil and instance_of(e, isolate.IsolateError), 'subscribe() after close() must raise'

  e = nil
  catch {
    b.send('nope')
  } as caught {
    e = caught
  }
  assert e != nil and instance_of(e, isolate.IsolateError), 'send() after close() must raise'
  echo 'test_broadcast_rejects_operations_after_close passed'
}

def test_broadcast_bounded_capacity_drops_when_full() {
  var b = isolate.broadcast(1)
  var slow = b.subscribe()

  b.send('a')
  b.send('b')

  assert slow.recv() == 'a', 'a slow subscriber keeps whatever fit in its buffer'
  assert slow.length() == 0, 'a value that arrived while the buffer was full must be dropped, not queued'
  echo 'test_broadcast_bounded_capacity_drops_when_full passed'
}

def test_shutdown_drains_and_blocks_new_spawns() {
  # this must stay the LAST test in the file; shutdown() is
  # permanent for the rest of the process, so nothing after it can
  # spawn() again.
  var gate = isolate.channel(0)
  var t1 = isolate.spawn(@(ch) { return ch.recv() }, gate)
  var t2 = isolate.spawn(isolate_isolate.square, 6)

  gate.send(11)
  isolate.shutdown()

  assert t1.join() == 11, 'a task already in flight when shutdown() was called must still finish'
  assert t2.join() == 36, 'a task already in flight when shutdown() was called must still finish'

  var rejected = false
  catch {
    isolate.spawn(isolate_isolate.square, 1)
  } as e {
    rejected = instance_of(e, isolate.IsolateError)
  }
  assert rejected, 'spawn() after shutdown() must be rejected as a IsolateError'
  echo 'test_shutdown_drains_and_blocks_new_spawns passed'
}

def test_configure_rejects_invalid() {
  catch {
    isolate.configure(0)
  } as e
  assert e != nil and instance_of(e, ValueError), 'configure() must reject a non-positive thread count'
  echo 'test_configure_rejects_invalid passed'
}

def test_configure_after_pool_started() {
  # by this point in the suite the pool has already started many times
  # over, so configure() must reliably report that it had no effect.
  assert isolate.configure(2) == false,
    'configure() must return false once the pool has already started'
  echo 'test_configure_after_pool_started passed'
}

def test_pool_size_and_cpu_count() {
  assert isolate.pool_size() > 0, 'pool_size() must report a real, positive isolate count'
  assert isolate.cpu_count() > 0, 'cpu_count() must report a real, positive CPU count'
  echo 'test_pool_size_and_cpu_count passed'
}

