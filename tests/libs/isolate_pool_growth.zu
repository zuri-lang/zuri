# The isolate pool starts a thread only when an isolate is waiting and
# every started thread is busy, and never more than its configured size.

import isolate
import os

isolate.configure(4)

assert isolate.started_count() == 0, 'a pool nothing has used yet must have started no threads'

# Isolates run one after another reuse the one thread.
iter var i = 0; i < 5; i++ {
  assert isolate.spawn(@(n) => n * 2, i).join() == i * 2
}

assert isolate.started_count() == 1,
  'isolates that never overlap must share one thread, started ${isolate.started_count()}'

def hold(gate) {
  return gate.recv()
}

# Waits until `count` isolates are running, or a few seconds pass.
def settle(count) {
  iter var tries = 0; tries < 200 and isolate.active_count() < count; tries++ {
    os.sleep(0.02)
  }
}

# Three at once need three threads.
var gate = isolate.channel(8)
var held = []

iter var i = 0; i < 3; i++ {
  held.append(isolate.spawn(hold, gate))
}

settle(3)
assert isolate.started_count() == 3,
  'three isolates waiting at once must have three threads, started ${isolate.started_count()}'

# Six at once on a pool of four get four threads, and two wait in line.
iter var i = 0; i < 3; i++ {
  held.append(isolate.spawn(hold, gate))
}

settle(4)
assert isolate.started_count() == 4, 'the pool must never start more threads than its size'
assert isolate.queued_count() == 2, 'what does not fit must wait in the queue'

iter var i = 0; i < 6; i++ {
  gate.send(i)
}

var total = 0

for task in held {
  total += task.join()
}

assert total == 15, 'every held isolate must still run to the end'
assert isolate.started_count() == 4, 'running the queue down must not start more threads'

echo 'isolate pool growth passed'
