/**
 * test_net_poll.zu
 *
 * Test suite for `net.Poller`: registration, readiness for reads,
 * writes and listeners, what happens to a socket that is closed or
 * moved to another isolate, and polling a TLS connection, including
 * one that already holds data it decrypted along with its handshake.
 *
 * The certificate fixture is the same throwaway self-signed pair the
 * `net.tls` suite uses, committed rather than generated so this suite
 * does not depend on the `crypto` module.
 */

import isolate
import net
import net.tls
import os
import .net_poll_helper

var _passed = 0

def ok(label) {
  _passed++
  echo '  [PASS] ' + label
}

def raises(fn) {
  catch {
    fn()
    return false
  } as e
  return true
}

# Waits for a specific token to report something, so a test never
# depends on how quickly the kernel notices a state change.
def wait_for(poller, token, deadline_ms) {
  var waited = 0

  while waited < deadline_ms {
    for event in poller.wait(50) {
      if event[0] == token {
        return event[1]
      }
    }
    waited += 50
  }

  return 0
}

var server_cert = '-----BEGIN CERTIFICATE-----
MIIBxjCCAWugAwIBAgIUKY6KD8+UhDTVfnuwbeg/aqGZjEUwCgYIKoZIzj0EAwIw
HDEaMBgGA1UEAwwRWnVyaSBUZXN0IFJvb3QgQ0EwHhcNMjYwODI4MDE1MjE1WhcN
MzYwODI1MDE1MjE1WjAUMRIwEAYDVQQDDAlsb2NhbGhvc3QwWTATBgcqhkjOPQIB
BggqhkjOPQMBBwNCAAQktM0xvAHGLQrfkjDG9GgqlkQ7Jp/M3J5nouQxtkO2DRbN
8wTgShvkOwPLtTn4QsZzNvNcfYd5yVw3QEbWUygko4GSMIGPMAwGA1UdEwEB/wQC
MAAwDgYDVR0PAQH/BAQDAgeAMBMGA1UdJQQMMAoGCCsGAQUFBwMBMBoGA1UdEQQT
MBGCCWxvY2FsaG9zdIcEfwAAATAdBgNVHQ4EFgQUYWdSTBIeJ8/+kYIfmzI1jQtz
t3owHwYDVR0jBBgwFoAUN3Y9x0t+nPvtrH8VBF783RE4PfcwCgYIKoZIzj0EAwID
SQAwRgIhAKyTEhmIrP+F4HYULeh1NlzYB+Fn8xgSY3OHQEemXM0eAiEA+zIv/TKY
ygqPPVtOmV8uMme4Jp3vxdZJhkGY4OPTTUQ=
-----END CERTIFICATE-----
'

var server_key = '-----BEGIN EC PRIVATE KEY-----
MHcCAQEEIKCvr/d71GiDa9QHie6zXXMk+h/PJ6j2mc2dr31IL/xIoAoGCCqGSM49
AwEHoUQDQgAEJLTNMbwBxi0K35IwxvRoKpZEOyafzNyeZ6LkMbZDtg0WzfME4Eob
5DsDy7U5+ELGczbzXH2HeclcN0BG1lMoJA==
-----END EC PRIVATE KEY-----
'

echo '═══════════════════════════════════════════════════════'
echo '  net.Poller module - test suite'
echo '═══════════════════════════════════════════════════════'

# ---------------------------------------------------------------------------
# Registration
# ---------------------------------------------------------------------------

var listener = net.TcpStream()
listener.bind('127.0.0.1:0')
var address = listener.local_address()

var poller = net.Poller()

assert poller.is_empty(), 'a new poller watches nothing'
assert poller.wait(0).length() == 0, 'and waiting on nothing returns at once'

poller.add(listener, 0, net.READABLE)

assert poller.length() == 1, 'a registered socket is counted'
assert poller.contains(0), 'and found by its token'
assert poller.interest(0) == net.READABLE, 'with the interest it was given'
assert poller.tokens() == [0], 'and listed'

poller.add(listener, 0, net.WRITABLE)
assert poller.length() == 1, 're-registering a token replaces it'
assert poller.interest(0) == net.WRITABLE, 'with the new interest'

assert poller.modify(0, net.READABLE), 'modify reports that the token was known'
assert poller.interest(0) == net.READABLE, 'and changes what it waits for'
assert !poller.modify(99, net.READABLE), 'and reports an unknown token as such'

assert raises(@() {
  poller.add(listener, 1, 0)
}), 'an empty interest is refused'
assert raises(@() {
  poller.modify(0, 0)
}), 'including through modify()'
assert raises(@() {
  poller.add('not a socket', 1, net.READABLE)
}),
  'and something that is not a socket is refused'
ok('registration, replacement, and interest changes')

# ---------------------------------------------------------------------------
# Readiness
# ---------------------------------------------------------------------------

assert poller.wait(50).length() == 0, 'an idle listener is not ready'

var client = net.TcpStream()
client.connect(address)

assert wait_for(poller, 0, 2000) & net.READABLE != 0,
  'a listener with a connection waiting is readable'
ok('a pending connection makes a listener readable')

var accepted = listener.accept()
poller.add(accepted, 1, net.WRITABLE)

assert wait_for(poller, 1, 2000) & net.WRITABLE != 0,
  'a connected socket with room in its buffer is writable'

poller.modify(1, net.READABLE)
assert poller.wait(50).length() == 0, 'and is not readable with nothing sent'

client.write_all('ping')
assert wait_for(poller, 1, 2000) & net.READABLE != 0, 'until data arrives'
assert accepted.read(16).to_string() == 'ping', 'which is then there to read'
ok('readability and writability track the socket')

# ---------------------------------------------------------------------------
# A peer that goes away
# ---------------------------------------------------------------------------

client.close()

var after_close = wait_for(poller, 1, 2000)
assert after_close != 0, 'a peer closing wakes the poller'
assert after_close & (net.READABLE | net.HANGUP) != 0,
  'reported as readable (the end-of-stream is there to read) or as a hangup'
assert accepted.read(16).length() == 0, 'and the read that follows sees EOF'
ok('a peer closing is reported rather than left to be discovered')

# ---------------------------------------------------------------------------
# A socket that can no longer supply a descriptor
# ---------------------------------------------------------------------------

accepted.close()

var closed_flags = wait_for(poller, 1, 1000)
assert closed_flags & net.ERROR != 0,
  'a closed socket is reported as an error against its own token'
ok('a closed socket is reported, not polled')

poller.remove(1)
assert !poller.contains(1), 'removal takes it out'
assert poller.length() == 1, 'leaving the rest alone'
assert !poller.remove(1), 'and removing it twice is not an error'

# ---------------------------------------------------------------------------
# accept() on a non-blocking listener
# ---------------------------------------------------------------------------

# The pairing a polled accept loop depends on: the poller says whether
# anyone is waiting, and accept() answers with nobody rather than
# failing when they are not.
var idle = net.TcpStream()
idle.bind('127.0.0.1:0')
idle.set_non_blocking(true)

var idle_address = '127.0.0.1:${idle.local_address().port()}'
var idle_poller = net.Poller()
idle_poller.add(idle, 0, net.READABLE)

assert idle_poller.wait(50).length() == 0,
  'nothing is waiting on a fresh listener'
assert idle.accept() == nil, 'and accept() says so instead of raising'

var caller = net.TcpStream()
caller.connect(idle_address)

assert wait_for(idle_poller, 0, 2000) & net.READABLE != 0,
  'a connection waiting makes the listener readable'

var answered = idle.accept()
assert answered != nil, 'and accept() hands it over'
assert instance_of(answered, net.TcpStream), 'as a connected stream'

assert idle.accept() == nil, 'with nobody left behind it'
ok('a non-blocking accept() reports an empty queue as nil')

answered.close()
caller.close()
idle.close()

# ---------------------------------------------------------------------------
# Acceptor
# ---------------------------------------------------------------------------

var served_by = net.TcpStream()
served_by.bind('127.0.0.1:0')

var acceptor = net.Acceptor(served_by, 20)
var acceptor_address = '127.0.0.1:${served_by.local_address().port()}'

assert acceptor.listener() == served_by, 'an acceptor knows its listener'
assert acceptor.next() == nil, 'and reports an empty round as nil'

var knocker = net.TcpStream()
knocker.connect(acceptor_address)

var taken = acceptor.wait_for_one()
assert taken != nil, 'wait_for_one() waits until there is one'

# Whatever mode the listener is in, the connection is handed over
# blocking, so a read timeout on it means what it says.
taken.set_read_timeout(50)
assert raises(@() {
  taken.read_exact(4)
}),
  'so a read with nothing sent times out rather than returning empty'

assert raises(@() {
  net.Acceptor(served_by, -1)
}),
  'a negative interval is refused, since it would wait forever'
ok('an Acceptor accepts without parking the thread')

taken.close()
knocker.close()
served_by.close()

# ---------------------------------------------------------------------------
# A socket moved to another isolate
# ---------------------------------------------------------------------------

var mover = net.TcpStream()
mover.connect(address)
var moved = listener.accept()

var moving_poller = net.Poller()
moving_poller.add(moved, 5, net.WRITABLE)

assert moving_poller.wait(200)[0][1] & net.WRITABLE != 0,
  'the socket is watched normally to begin with'

var inbox = isolate.channel(1)
var reply = isolate.channel(1)
var task = isolate.spawn(net_poll_helper.take_socket, inbox, reply)

inbox.send(moved)
assert reply.recv(5000), 'the socket really did arrive in the other isolate'

# Its Ptr moved with it, so this side can no longer supply a
# descriptor. The poller has to say so rather than carry on watching a
# number the operating system may since have handed to something else.
var moved_flags = wait_for(moving_poller, 5, 1000)
assert moved_flags & net.ERROR != 0,
  'a socket moved to another isolate is reported as an error, never polled'
ok('a socket moved across an isolate boundary cannot be polled by mistake')

catch {
  task.join(5000)
}
mover.close()

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------

var tls_channel = isolate.channel(1)
var tls_task = isolate.spawn(
  net_poll_helper.tls_echo, tls_channel, server_cert, server_key,
)
var tls_address = tls_channel.recv()

var config = tls.TlsConfig()
config.set_insecure(true)

var tcp = net.TcpStream()
tcp.connect(tls_address)
var secure = tls.TlsStream.connect(tcp, config, 'localhost')

var tls_poller = net.Poller()
tls_poller.add(secure, 3, net.READABLE)

secure.write_all('hello')

assert wait_for(tls_poller, 3, 3000) & net.READABLE != 0,
  'a TLS stream becomes readable when its socket does'
assert secure.read(16).to_string() == 'polled',
  'and the decrypted data is there'
ok('a TLS stream is pollable through the socket underneath it')

tls_channel.send('done')
secure.close()
catch {
  tls_task.join(5000)
}

# What a client sends straight after its handshake can be read off the
# socket along with its last handshake message. The relay makes sure
# it is, however quickly this side reads, and the server is held to
# TLS 1.3, where the client is the one to finish the handshake.
var relay_ready = isolate.channel(1)
var relay_done = isolate.channel(1)
var origin = net.TcpStream()
origin.bind('127.0.0.1:0')

var relay_task = isolate.spawn(
  net_poll_helper.coalescing_relay, relay_ready,
  origin.local_address().to_string(), relay_done,
)

var hurried_done = isolate.channel(1)
var hurried_task = isolate.spawn(
  net_poll_helper.tls_hurried_client, relay_ready.recv(), hurried_done,
)

var arrived = origin.accept()
arrived.set_read_timeout(5000)

var serving = tls.TlsConfig()
serving.set_cert_chain(server_cert, server_key)
serving.set_versions('1.3', '1.3')

var held = tls.TlsStream.accept(arrived, serving)
var held_poller = net.Poller()
held_poller.add(held, 5, net.READABLE)

var started = time()
var held_events = held_poller.wait(5000)

assert held_events.length() == 1 and held_events[0][1] & net.READABLE != 0,
  'data that arrived with the handshake makes a TLS stream readable'
assert time() - started < 1, 'at once, rather than once the timeout is up'
assert held.read(5).to_string() == 'early', 'and the read returns it'

started = time()
held_events = held_poller.wait(5000)

assert held_events.length() == 1 and held_events[0][1] & net.READABLE != 0,
  'so does what a short read leaves behind'
assert time() - started < 1, 'just as quickly'
assert held.read(16).to_string() == ' bird',
  'and the next read returns the rest'
ok('a TLS stream is readable for data it already holds')

relay_done.send('done')
hurried_done.send('done')
held.close()
catch {
  relay_task.join(5000)
  hurried_task.join(5000)
}
origin.close()

listener.close()

# ===========================================================================
# Taking connections, reading and writing without waiting
# ===========================================================================

var ready_listener = net.TcpStream()
ready_listener.bind('127.0.0.1:0')

var ready_address = ready_listener.local_address().to_string()
var ready_acceptor = net.Acceptor(ready_listener)

assert ready_acceptor.take() == nil, 'take() does not wait for a connection'

var ready_client = net.TcpStream()
ready_client.connect(ready_address)

var ready_watch = net.Poller()
ready_watch.add(ready_listener, 1, net.READABLE)
ready_watch.wait(5000)

var ready_side = ready_acceptor.take()

assert ready_side != nil, 'and hands over one that is waiting'
ok('Acceptor.take() never waits')

ready_side.set_non_blocking(true)
assert ready_side.try_read(16) == nil, 'nothing arrived is nil, not an error'

var ready_reads = net.Poller()
ready_reads.add(ready_side, 2, net.READABLE)

ready_client.write_all('hello')
ready_reads.wait(5000)

assert ready_side.try_read(16).to_string() == 'hello',
  'what arrived is returned'
ok('try_read() reports nothing arrived as nil')

assert ready_side.try_write('abcdef', 2) == 4, 'offset skips what already went'
ready_client.set_read_timeout(5000)
assert ready_client.read(16).to_string() == 'cdef', 'and the rest arrives'

var filler = bytes(1048576)
var taken = 1

while taken > 0 {
  taken = ready_side.try_write(filler)
}

assert ready_side.try_write(filler) == 0, 'a full socket takes nothing'
ok('try_write() reports a full socket as 0')

ready_client.close()
assert ready_reads.wait(5000).length() == 1, 'a close makes the socket readable'

var at_end = false

catch {
  while !at_end {
    var tail = ready_side.try_read(65536)
    at_end = tail != nil and tail.length() == 0
  }
} as reset

assert at_end or reset != nil, 'try_read() reaches the end of a closed stream'
ready_side.close()
ok('try_read() sees the end of the stream')

var driven_done = isolate.channel(1)
var driven_task = isolate.spawn(
  net_poll_helper.tls_hurried_client, ready_address, driven_done,
)

ready_watch.wait(5000)

var driven_tcp = ready_acceptor.take()
var driven_config = tls.TlsConfig()
driven_config.set_cert_chain(server_cert, server_key)

var driven = tls.TlsStream.begin_accept(driven_tcp, driven_config)
driven.set_non_blocking(true)

var driven_poller = net.Poller()
driven_poller.add(driven, 7, net.READABLE)

var step = driven.advance_handshake()

while step != 0 {
  driven_poller.modify(7, step)
  driven_poller.wait(5000)
  step = driven.advance_handshake()
}

ok('a handshake can be driven by readiness')

driven_poller.modify(7, net.READABLE)

var arrived_text = bytes(0)
var read_started = time()

while arrived_text.length() < 10 and time() - read_started < 5 {
  driven_poller.wait(1000)

  var part = driven.try_read(64)

  if part != nil {
    arrived_text.extend(part)
  }
}

assert arrived_text.to_string() == 'early bird',
  'what it sent arrives decrypted'
assert driven.try_read(64) == nil, 'and then there is nothing to read'
assert driven.try_write('ok') == 2, 'the session takes what it can'
assert driven.try_flush(), 'and it reaches the socket'
ok('a TLS stream reads and writes without waiting')

driven.close_now()
driven_done.send('done')

catch {
  driven_task.join(5000)
}

ready_listener.close()

# ===========================================================================
echo ''
echo '  All ${_passed} checks passed.'
