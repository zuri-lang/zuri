/**
 * Helper module for `tests/libs/coroutine.zu`'s panic-isolation test.
 * Kept separate from `coroutine_worker.zu` so that ordinary worker
 * functions aren't sitting next to a deliberate crash trigger.
 */

import _coroutine

def trigger_panic() {
  _coroutine.debug_panic()
  return 'unreachable'
}
