/**
 * imagine.zu
 *
 * Test suite for the `imagine` standard library module: colour
 * handling, the drawing rasterizer, geometry, filters, compositing,
 * text, codecs and animation.
 */

import imagine { * }
import imagine.filters
import imagine.formats

var _passed = 0

def ok(label) {
  _passed++
  echo '  [PASS] ' + label
}

def raises(fn) {
  catch {
    fn()
    return false
  } as e
  return true
}

def close(a, b, tolerance) {
  return (a - b).abs() < tolerance
}

echo '═══════════════════════════════════════════════════════'
echo '  imagine module: test suite'
echo '═══════════════════════════════════════════════════════'

# ---------------------------------------------------------------------------
# Color: construction and parsing
# ---------------------------------------------------------------------------
assert Color(300, -5, 40.6).to_list() == [255, 0, 41, 255], 'the Color constructor must clamp and round its channels'
assert Color(1, 2, 3).a == 255, 'a Color with no alpha given must be fully opaque'
assert Color.hex('#f80').to_list() == [255, 136, 0, 255], 'a 3-digit hex colour must double each digit'
assert Color.hex('ff880080').to_list() == [255, 136, 0, 128], 'an 8-digit hex colour must read alpha from the last byte'
assert Color.named('rebeccapurple').to_hex() == '#663399', 'named colours must resolve through the colors module'
assert Color.named('Dark Sea Green').to_hex() == '#8fbc8f', 'colour names must match ignoring case and spaces'
assert Color.packed(0x4F46E5FF).to_hex() == '#4f46e5', 'a packed colour must unpack as 0xRRGGBBAA'
assert Color.hex('#4f46e5').to_packed() == 0x4F46E5FF, 'to_packed() must be the inverse of Color.packed()'
ok('Color construction clamps, rounds, and reads every hex and named form')

assert Color.parse('#123456').to_hex() == '#123456', 'parse() must accept a hex string'
assert Color.parse('tomato').to_hex() == '#ff6347', 'parse() must accept a CSS colour name'
assert Color.parse(0xFF0000FF).to_hex() == '#ff0000', 'parse() must accept a packed number'
assert Color.parse([1, 2, 3]).to_list() == [1, 2, 3, 255], 'parse() must accept a 3-channel list'
assert Color.parse([1, 2, 3, 4]).to_list() == [1, 2, 3, 4], 'parse() must accept a 4-channel list'
assert Color.parse(RED).equals(RED), 'parse() must pass a Color straight through'
assert raises(@() { Color.parse(true) }), 'parse() must reject a value that is not a colour'
assert raises(@() { Color.parse([1, 2]) }), 'parse() must reject a list with too few channels'
ok('Color.parse() accepts every documented spelling and rejects the rest')

# A malformed colour is the colors module's own ValueError, raised
# where it happens rather than caught and relabelled.
assert raises(@() { Color.hex('nonsense') }), 'a malformed hex colour must raise'
assert raises(@() { Color.hex(42) }), 'a non-string spec must raise'
assert raises(@() { Color.named('chartroose') }), 'an unknown colour name must raise'
assert raises(@() { Color.named(42) }), 'a non-string name must raise'
ok('bad colours raise rather than being silently accepted')

# ---------------------------------------------------------------------------
# Color: conversion, mixing and contrast
# ---------------------------------------------------------------------------
assert Color.hsl(240, 100, 50).to_hex() == '#0000ff', 'Color.hsl() must take percentage points, matching the colors module'
assert Color.hsv(120, 100, 100).to_hex() == '#00ff00', 'Color.hsv() must take percentage points'
assert Color.cmyk(0, 100, 100, 0).to_hex() == '#ff0000', 'Color.cmyk() must convert through the colors module'
assert close(Color.hex('#4f46e5').to_hsl().h, 243.4, 0.1), 'to_hsl() must report hue in degrees'
assert close(WHITE.luminance(), 1, 0.001), 'white must have a relative luminance of 1'
assert close(WHITE.contrast_ratio(BLACK), 21, 0.001), 'white against black must be the maximum contrast ratio'
assert BLACK.is_dark() and WHITE.is_light(), 'is_dark()/is_light() must split on the luminance threshold'
assert Color.hex('#111111').best_contrast().equals(WHITE), 'best_contrast() must pick white on a dark colour'
ok('Color conversions, luminance and contrast agree with the colors module')

assert RED.mix(BLUE, 0.5).to_hex() == '#800080', 'mix() must interpolate linearly between two colours'
assert Color(255, 0, 0, 128).over(WHITE).to_hex() == '#ff7f7f', 'over() must composite against an opaque backdrop'
assert RED.invert().to_hex() == '#00ffff', 'invert() must invert colour but not alpha'
assert Color(255, 0, 0, 64).invert().a == 64, 'invert() must leave alpha untouched'
assert RED.to_grayscale().to_hex() == '#4c4c4c', 'to_grayscale() must use luma weights, not HSL saturation'
assert Color(79, 70, 229, 128).lighten(20).a == 128, 'lighten() must preserve alpha through the colors module'
assert Color(1, 2, 3, 200).fade(0.5).a == 100, 'fade() must scale alpha rather than replace it'
ok('Color mixing, compositing and adjustment behave as documented')

# ---------------------------------------------------------------------------
# Argument types are declared, so the runtime rejects them
# ---------------------------------------------------------------------------
var _guarded = [
  @() { Image('wide', 10) },
  @() { Image.decode('not bytes') },
  @() { Image(8, 8).scale('2') },
  @() { Image(8, 8).rotate('sideways') },
  @() { Image(8, 8).save(42) },
  @() { Image(8, 8).draw_image('not an image', 0, 0) },
  @() { Image(8, 8).mask('nope') },
  @() { Image(8, 8).difference(7) },
  @() { Canvas('not bytes', 2, 2) },
  @() { Image(8, 8).set_pixels('nope') },
  @() { Image(8, 8).thickness('thick') },
  @() { Image(8, 8).fill_polygon('not a list', 'red') },
  @() { Image(8, 8).draw_mask('nope', 2, 2, 0, 0, 'red') },
  @() { Color.packed('ff') },
  @() { Color('r', 0, 0) },
  @() { Color.hex(42) },
  @() { Color.named(42) },
  @() { filters.build_lut('not a fn') },
  @() { filters.gamma_lut('x') },
  @() { filters.combine_matrices('a', 'b') },
  @() { StrokeFont('big') },
  @() { StrokeFont(12).size('big') },
  @() { StrokeFont(12).wrap('hi', 'wide') },
  @() { Font.load(42) },
  @() { Font.from_bytes('not bytes') },
  @() { Animation('not a list') },
  @() { Animation.decode('nope') },
  @() { Animation([Image(4, 4)]).map('not a fn') },
  @() { Animation([Image(4, 4)]).frame('first') },
  @() { Animation([Image(4, 4)]).repeat('twice') },
]

for guarded in _guarded {
  assert raises(guarded), 'every declared parameter type must be enforced'
}
ok('an argument of the wrong type is rejected at every entry point that declares one')

# A value of the right type but the wrong range is the module's own
# judgement, so it stays an ImageError subclass rather than a TypeError.
assert raises(@() { Image(0, 10) }), 'a zero dimension must still raise'
assert raises(@() { filters.gamma_lut(-1) }), 'a negative gamma must still raise'
assert raises(@() { Image(8, 8).thickness(0) }), 'a zero thickness must still raise'
assert raises(@() { Animation([Image(4, 4)]).frame(9) }), 'an out-of-range frame must still raise'
ok('a wrong-range value stays the module own error rather than becoming a type error')

# ---------------------------------------------------------------------------
# Image: construction
# ---------------------------------------------------------------------------
var blank = Image(10, 8)
assert blank.width() == 10 and blank.height() == 8, 'a new image must have the size asked for'
assert blank.get_pixel(0, 0).to_list() == [0, 0, 0, 0], 'a new image must start fully transparent'
assert blank.pixels().length() == 10 * 8 * 4, 'the pixel buffer must be four bytes per pixel'
assert Image(4, 4, 'red').get_pixel(2, 2).to_hex() == '#ff0000', 'a fill colour must be applied at construction'
assert blank.get_pixel(-1, 0) == nil, 'reading outside the image must return nil, not raise'
assert raises(@() { Image(0, 5) }), 'an image must be at least one pixel in each direction'
assert raises(@() { Image(-3, 5) }), 'a negative dimension must be rejected'
ok('Image construction validates its dimensions and starts transparent')

# ---------------------------------------------------------------------------
# Canvas: pixels and clipping
# ---------------------------------------------------------------------------
var surface = Image(8, 8, 'white')
surface.set_pixel(1, 1, Color(0, 0, 0, 128))
assert surface.get_pixel(1, 1).to_list() == [0, 0, 0, 128], 'set_pixel() must replace rather than blend'
surface.blend_pixel(2, 2, Color(0, 0, 0, 128))
assert surface.get_pixel(2, 2).a == 255, 'blend_pixel() over an opaque pixel must stay opaque'
assert surface.get_pixel(2, 2).r < 200, 'blend_pixel() must darken a white pixel with a translucent black'
surface.set_pixel(100, 100, 'red')
ok('pixel reads and writes blend, replace and ignore out-of-range coordinates')

var clipped = Image(8, 8, 'white')
clipped.clip(0, 0, 4, 4)
assert clipped.get_clip().width == 4, 'get_clip() must report the rectangle in force'
clipped.fill_rect(0, 0, 8, 8, 'black')
assert clipped.get_pixel(1, 1).to_hex() == '#000000', 'drawing inside the clip must land'
assert clipped.get_pixel(6, 6).to_hex() == '#ffffff', 'drawing outside the clip must be discarded'
clipped.clear_clip()
assert clipped.get_clip() == nil, 'clear_clip() must remove the rectangle'
ok('a clipping rectangle confines drawing and can be cleared')

# ---------------------------------------------------------------------------
# Canvas: the rasterizer
# ---------------------------------------------------------------------------
var shapes = Image(40, 40, 'white')
shapes.fill_rect(5, 5, 10, 10, 'red')
assert shapes.get_pixel(10, 10).to_hex() == '#ff0000', 'fill_rect() must fill its interior'
assert shapes.get_pixel(4, 4).to_hex() == '#ffffff', 'fill_rect() must not paint outside its rectangle'
assert shapes.get_pixel(14, 14).to_hex() == '#ff0000', 'fill_rect() must include its last pixel'
assert shapes.get_pixel(15, 15).to_hex() == '#ffffff', 'fill_rect() must stop at its exclusive edge'

shapes.fill_circle(28, 28, 8, 'blue')
assert shapes.get_pixel(28, 28).to_hex() == '#0000ff', 'fill_circle() must fill its centre'
assert shapes.get_pixel(28, 18).to_hex() == '#ffffff', 'fill_circle() must not paint beyond its radius'

# A five-pointed star: solid under the non-zero rule, hollow under even-odd.
var star = []
iter var i = 0; i < 5; i++ {
  var angle = (-90 + i * 144) * 3.141592653589793 / 180
  star.append(20 + angle.cos() * 15)
  star.append(20 + angle.sin() * 15)
}

var solid = Image(40, 40, 'white')
solid.fill_polygon(star, 'black')
assert solid.get_pixel(20, 20).to_hex() == '#000000', 'the non-zero winding rule must fill a star solid'

var hollow = Image(40, 40, 'white')
hollow.fill_polygon(star, 'black', { even_odd: true })
assert hollow.get_pixel(20, 20).to_hex() == '#ffffff', 'the even-odd rule must leave a star hollow'
ok('the scanline rasterizer fills rectangles, ellipses and both winding rules')

var aliased = Image(20, 20, 'white')
aliased.antialias(false)
aliased.line(0, 0, 19, 19, 'black')
var hard = aliased.get_pixel(10, 10)
assert hard.r == 0 or hard.r == 255, 'with anti-aliasing off every pixel must be fully on or off'

var smoothed = Image(20, 20, 'white')
smoothed.line(0, 0, 19, 19, 'black')
var soft = smoothed.get_pixel(10, 10)
assert soft.r > 0 and soft.r < 255, 'an anti-aliased diagonal must produce partial coverage'
ok('anti-aliasing can be turned off and produces partial coverage when on')

var thick = Image(30, 30, 'white')
thick.thickness(5)
thick.line(15, 0, 15, 29, 'black')
assert thick.get_pixel(15, 15).to_hex() == '#000000', 'a thick line must cover its centre'
assert thick.get_pixel(13, 15).to_hex() == '#000000', 'a stroke must be centred on its path'
assert thick.get_pixel(20, 15).to_hex() == '#ffffff', 'a stroke must not reach beyond half its width'
ok('stroke thickness is centred on the path')

# Anti-aliased coverage arrives fractional, and on a transparent
# destination it is written straight through rather than blended, so
# this is the path where an unrounded alpha would reach the buffer.
var onto_nothing = Image(20, 20)
onto_nothing.fill_circle(10, 10, 7, 'red')
assert onto_nothing.get_pixel(10, 10).to_hex() == '#ff0000', 'drawing onto a transparent image must paint it'
var rim = onto_nothing.get_pixel(3, 10)
assert rim.a > 0 and rim.a < 255, 'an anti-aliased edge over transparency must land at partial alpha'
onto_nothing.line(0, 0, 19, 19, Color(0, 0, 255, 100))
ok('drawing onto a fully transparent image writes valid partial coverage')

var capped = Image(60, 30, 'white')
assert capped.get_cap() == CAP_ROUND, 'strokes must be round-capped by default'

# The endpoints are at x=20 and x=40, so anything painted beyond them
# is the cap overhanging.
capped.cap(CAP_BUTT).thickness(12)
capped.line(20, 15, 40, 15, 'black')
assert capped.get_pixel(19, 15).to_hex() == '#ffffff', 'a butt cap must stop at the endpoint'

var round_cap = Image(60, 30, 'white')
round_cap.cap(CAP_ROUND).thickness(12)
round_cap.line(20, 15, 40, 15, 'black')
assert round_cap.get_pixel(19, 15).to_hex() == '#000000', 'a round cap must reach past the endpoint'
assert round_cap.get_pixel(13, 15).to_hex() == '#ffffff', 'a round cap must not reach more than half the width past the endpoint'
assert round_cap.get_pixel(14, 9).to_hex() == '#ffffff', 'a round cap must leave the corner a square cap would fill'

var square_cap = Image(60, 30, 'white')
square_cap.cap(CAP_SQUARE).thickness(12)
square_cap.line(20, 15, 40, 15, 'black')
assert square_cap.get_pixel(19, 15).to_hex() == '#000000', 'a square cap must reach past the endpoint'
assert square_cap.get_pixel(14, 9).to_hex() == '#000000', 'a square cap must fill the corner a round cap leaves clear'
assert square_cap.get_pixel(13, 15).to_hex() == '#ffffff', 'a square cap must reach exactly as far past the endpoint as a round one'

var per_call = Image(60, 30, 'white')
per_call.line(20, 15, 40, 15, 'black', { thickness: 12, cap: CAP_BUTT })
assert per_call.get_pixel(19, 15).to_hex() == '#ffffff', 'a per-call cap must override the surface default'
assert raises(@() { per_call.cap('wedge') }), 'an unknown cap must be rejected'

var outline = Image(60, 40, 'white')
outline.cap(CAP_BUTT).thickness(8)
outline.rect(15, 10, 30, 20, 'black')
assert outline.get_pixel(15, 10).to_hex() == '#000000', 'a closed outline has no ends, so its corners must stay filled whatever the cap'
ok('line caps can be butt, round or square, and only affect open ends')

var flooded = Image(16, 16, 'white')
flooded.fill_rect(8, 0, 1, 16, 'black')
flooded.flood_fill(0, 0, 'red')
assert flooded.get_pixel(3, 8).to_hex() == '#ff0000', 'flood fill must spread through matching pixels'
assert flooded.get_pixel(12, 8).to_hex() == '#ffffff', 'flood fill must stop at a barrier'
assert flooded.get_pixel(8, 8).to_hex() == '#000000', 'flood fill must not overwrite the barrier'
ok('flood fill spreads four-connected and respects a barrier')

# ---------------------------------------------------------------------------
# Canvas: gradients
# ---------------------------------------------------------------------------
var ramped = Image(100, 10)
ramped.linear_gradient(0, 0, 100, 0, ['#000000', '#ffffff'])
assert ramped.get_pixel(0, 5).r < 8, 'a gradient must start at its first stop'
assert ramped.get_pixel(99, 5).r > 247, 'a gradient must end at its last stop'
assert close(ramped.get_pixel(50, 5).r, 128, 6), 'a two-stop gradient must be linear between them'
assert ramped.get_pixel(0, 5).r == ramped.get_pixel(0, 9).r, 'a horizontal gradient must not vary vertically'

var three_stop = Image(120, 4)
three_stop.linear_gradient(0, 0, 120, 0, ['red', 'lime', 'blue'])
assert three_stop.get_pixel(1, 2).r > 240, 'evenly spaced stops must place the first at the start'
assert three_stop.get_pixel(60, 2).g > 240, 'evenly spaced stops must place the middle one halfway'
assert three_stop.get_pixel(118, 2).b > 240, 'evenly spaced stops must place the last at the end'

var offset_stops = Image(100, 4)
offset_stops.linear_gradient(0, 0, 100, 0, [[0, 'black'], [0.25, 'red'], [1, 'white']])
assert offset_stops.get_pixel(25, 2).r > 240 and offset_stops.get_pixel(25, 2).g < 16, 'an explicit offset must place its stop there'

var flat_stop = Image(10, 10)
flat_stop.linear_gradient(0, 0, 10, 0, ['red'])
assert flat_stop.get_pixel(0, 0).to_hex() == flat_stop.get_pixel(9, 9).to_hex(), 'a single stop must give a flat fill'
assert raises(@() { flat_stop.linear_gradient(0, 0, 10, 0, []) }), 'a gradient needs at least one stop'

var vignette = Image(60, 60, '#38bdf8')
vignette.radial_gradient(30, 30, 40, [[0, Color(0, 0, 0, 0)], [1, Color(0, 0, 0, 255)]], { blend: true })
assert close(vignette.get_pixel(30, 30).r, 0x38, 4), 'a radial gradient must leave its centre nearly alone when the first stop is transparent'
assert vignette.get_pixel(1, 1).r < 40, 'a radial gradient must darken the corners'

var confined = Image(60, 60, 'white')
confined.linear_gradient(20, 0, 40, 0, ['red', 'blue'], { rect: { x: 20, y: 20, width: 20, height: 20 } })
assert confined.get_pixel(5, 5).to_hex() == '#ffffff', 'a rect option must confine the fill'
assert confined.get_pixel(30, 30).to_hex() != '#ffffff', 'a rect option must still paint inside itself'
ok('linear and radial gradients interpolate, blend and stay inside their bounds')

# ---------------------------------------------------------------------------
# Image: geometry
# ---------------------------------------------------------------------------
var source = Image(40, 20, 'red')

assert source.resize(10, 10).size() == { width: 10, height: 10 }, 'resize() must produce exactly the size asked for'
assert source.scale(0.5).size() == { width: 20, height: 10 }, 'scale() must keep proportions'
assert source.thumbnail(20, 20).size() == { width: 20, height: 10 }, 'thumbnail() must fit inside the box'
assert source.thumbnail(400, 400).size() == { width: 40, height: 20 }, 'thumbnail() must never enlarge'
assert source.fit(400, 400).size() == { width: 400, height: 200 }, 'fit() must enlarge where thumbnail() would not'
assert source.cover(20, 20).size() == { width: 20, height: 20 }, 'cover() must fill the box exactly'
assert source.contain(20, 20).size() == { width: 20, height: 20 }, 'contain() must fit the box exactly'
assert source.width() == 40, 'a geometry operation must leave the original alone'
ok('the resizing family produces the documented sizes and never mutates')

assert source.crop(5, 5, 10, 10).size() == { width: 10, height: 10 }, 'crop() must return its rectangle'
assert raises(@() { source.crop(35, 15, 10, 10) }), 'crop() must reject a rectangle that runs off the edge'
assert raises(@() { source.crop(0, 0, 0, 5) }), 'crop() must reject an empty rectangle'
assert source.pad(5).size() == { width: 50, height: 30 }, 'pad() must add its border on every side'
assert source.pad(1, 2, 3, 4).size() == { width: 46, height: 24 }, 'pad() must accept four separate edges'
assert source.rotate_90().size() == { width: 20, height: 40 }, 'a quarter turn must swap the dimensions'
assert source.rotate_180().size() == { width: 40, height: 20 }, 'a half turn must keep the dimensions'
assert source.transpose().size() == { width: 20, height: 40 }, 'transpose() must swap the dimensions'
assert source.rotate(45).width() > 40, 'an arbitrary rotation must grow the canvas to hold the corners'
ok('cropping, padding, rotation and transposition report the right dimensions')

var asymmetric = Image(4, 2, 'white')
asymmetric.set_pixel(0, 0, 'red')
assert asymmetric.flip_horizontal().get_pixel(3, 0).to_hex() == '#ff0000', 'flip_horizontal() must mirror left to right'
assert asymmetric.flip_vertical().get_pixel(0, 1).to_hex() == '#ff0000', 'flip_vertical() must mirror top to bottom'
assert asymmetric.flip(FLIP_BOTH).get_pixel(3, 1).to_hex() == '#ff0000', 'FLIP_BOTH must mirror both ways'
assert asymmetric.rotate_90().get_pixel(1, 0).to_hex() == '#ff0000', 'rotate_90() must turn clockwise'
ok('mirroring and quarter turns move pixels in the documented direction')

var bordered = Image(20, 20, 'white')
bordered.fill_rect(6, 8, 4, 2, 'black')
var trimmed = bordered.trim()
assert trimmed.size() == { width: 4, height: 2 }, 'trim() must reduce the image to its non-border content'
assert Image(8, 8, 'white').trim().size() == { width: 1, height: 1 }, 'trimming an entirely uniform image must give a 1x1 image'
ok('trim() removes a uniform border and degrades sensibly')

# ---------------------------------------------------------------------------
# Image: colour filters
# ---------------------------------------------------------------------------
var tone = Image(4, 4, '#4f46e5')

assert tone.clone().invert().get_pixel(0, 0).to_hex() == '#b0b91a', 'invert() must invert every colour channel'
assert tone.clone().grayscale().get_pixel(0, 0).to_hex() == '#5a5a5a', 'grayscale() must weight channels for perceived brightness'
assert tone.clone().brightness(20).get_pixel(0, 0).r == 99, 'brightness() must add a fixed amount to each channel'
assert tone.clone().opacity(0.5).get_pixel(0, 0).a == 128, 'opacity() must scale the alpha channel'
assert tone.clone().opacity(0.5).get_pixel(0, 0).r == 79, 'opacity() must leave the colour channels alone'
assert tone.clone().threshold(100).get_pixel(0, 0).to_hex() == '#000000', 'threshold() must judge on brightness, not per channel'
assert tone.clone().saturate(0).get_pixel(0, 0).r == tone.clone().saturate(0).get_pixel(0, 0).b, 'saturating to zero must produce a grey'
assert tone.clone().flatten('white').get_pixel(0, 0).a == 255, 'flatten() must leave the image opaque'
assert Image(2, 2, Color(255, 0, 0, 0)).flatten('white').get_pixel(0, 0).to_hex() == '#ffffff', 'flattening a transparent pixel must show the background'
ok('lookup-table and colour-matrix filters produce the documented results')

var curve = filters.build_lut(@(value) {
  return 255 - value
})
assert curve.length() == 256, 'build_lut() must produce a 256-entry table'
assert curve[0] == 255 and curve[255] == 0, 'build_lut() must call its function for every input value'
assert tone.clone().apply_lut(curve, curve, curve, nil).get_pixel(0, 0).to_hex() == '#b0b91a', 'apply_lut() must rewrite the channels it is given'
assert filters.identity_matrix().length() == 20, 'a colour matrix must have twenty entries'
assert tone.clone().apply_matrix(filters.identity_matrix()).get_pixel(0, 0).to_hex() == '#4f46e5', 'the identity matrix must change nothing'
assert raises(@() { tone.clone().apply_matrix([1, 2, 3]) }), 'apply_matrix() must reject a matrix of the wrong size'
assert raises(@() { tone.clone().apply_lut(bytes(4), nil, nil, nil) }), 'apply_lut() must reject a table that is not 256 entries'
ok('the lookup-table and matrix primitives validate their inputs')

var combined = filters.combine_matrices(filters.grayscale_matrix(), filters.identity_matrix())
assert tone.clone().apply_matrix(combined).get_pixel(0, 0).to_hex() == '#5a5a5a', 'combining with the identity must leave a matrix unchanged'
ok('colour matrices combine correctly')

# ---------------------------------------------------------------------------
# Image: convolution
# ---------------------------------------------------------------------------
var flat = Image(16, 16, '#4f46e5')
assert flat.clone().edges().get_pixel(8, 8).a == 255, 'edge detection must not make a uniformly opaque image transparent'
assert flat.clone().emboss().get_pixel(8, 8).a == 255, 'embossing must not change alpha'
assert flat.clone().sharpen().get_pixel(8, 8).to_hex() == '#4f46e5', 'sharpening a flat area must leave it alone'
assert flat.clone().convolve([0, 0, 0, 0, 1, 0, 0, 0, 0]).get_pixel(8, 8).to_hex() == '#4f46e5', 'an identity kernel must change nothing'
assert raises(@() { flat.clone().convolve([1, 2, 3, 4]) }), 'a convolution kernel must be square with an odd side'

var edged = Image(20, 20, 'black')
edged.antialias(false)
edged.fill_rect(5, 5, 10, 10, 'white')
var found = edged.clone().edges()
assert found.get_pixel(10, 10).to_hex() == '#000000', 'edge detection must black out a flat interior'
assert found.get_pixel(5, 5).r > 0, 'edge detection must light up a boundary'
ok('convolution handles alpha correctly and finds real edges')

var soft = Image(16, 16, 'black')
soft.antialias(false)
soft.fill_rect(4, 4, 8, 8, 'white')
var blurred = soft.clone().blur(2)
assert blurred.get_pixel(3, 8).r > 0, 'a blur must spread colour past the original edge'
assert blurred.get_pixel(8, 8).r > 200, 'a blur must leave the middle of a large area nearly intact'
assert raises(@() { soft.clone().blur(0) }), 'a blur radius must be greater than zero'
ok('the Gaussian blur spreads colour and validates its radius')

var blocky = Image(16, 16)
iter var y = 0; y < 16; y++ {
  iter var x = 0; x < 16; x++ {
    blocky.set_pixel(x, y, Color(x * 16, y * 16, 0))
  }
}
var mosaic = blocky.clone().pixelate(8)
assert mosaic.get_pixel(0, 0).to_hex() == mosaic.get_pixel(7, 7).to_hex(), 'every pixel in a block must end up the same colour'
assert mosaic.get_pixel(0, 0).to_hex() != mosaic.get_pixel(8, 8).to_hex(), 'separate blocks must keep their own averages'
ok('pixelate() averages each block independently')

# ---------------------------------------------------------------------------
# Image: compositing
# ---------------------------------------------------------------------------
var backdrop = Image(20, 20, 'white')
var sprite = Image(8, 8, 'red')

assert backdrop.clone().draw_image(sprite, 2, 2).get_pixel(5, 5).to_hex() == '#ff0000', 'draw_image() must paint the source'
assert backdrop.clone().draw_image(sprite, 2, 2).get_pixel(15, 15).to_hex() == '#ffffff', 'draw_image() must not paint beyond the source'
assert backdrop.clone().draw_image(sprite, -4, -4).get_pixel(0, 0).to_hex() == '#ff0000', 'a negative position must clip rather than fail'
assert backdrop.clone().draw_image(sprite, 18, 18).get_pixel(19, 19).to_hex() == '#ff0000', 'a source hanging off the far edge must clip'
assert backdrop.clone().draw_image(sprite, 2, 2, { opacity: 0.5 }).get_pixel(5, 5).r == 255, 'a half-opacity red over white must keep full red'
assert backdrop.clone().draw_image(sprite, 2, 2, { opacity: 0.5 }).get_pixel(5, 5).g > 100, 'a half-opacity red over white must let white through'
assert backdrop.clone().draw_image(sprite, 2, 2, { blend: BLEND_MULTIPLY }).get_pixel(5, 5).to_hex() == '#ff0000', 'multiplying red over white must give red'
assert Image(8, 8, 'gray').draw_image(sprite, 0, 0, { blend: BLEND_MULTIPLY }).get_pixel(4, 4).to_hex() == '#800000', 'multiplying red over grey must darken it'
ok('compositing clips, honours opacity and applies blend modes')

var self_drawn = Image(8, 8, 'red')
self_drawn.draw_image(self_drawn, 2, 2)
assert self_drawn.get_pixel(4, 4).to_hex() == '#ff0000', 'compositing an image onto itself must work rather than raise'
ok('an image can be composited onto itself')

var placed = Image(20, 20, 'white')
placed.place(Image(4, 4, 'red'), BOTTOM_RIGHT, { margin: 2 })
assert placed.get_pixel(15, 15).to_hex() == '#ff0000', 'place() must honour its anchor and margin'
assert placed.get_pixel(19, 19).to_hex() == '#ffffff', 'place() must keep the margin clear'
assert raises(@() { placed.place(Image(2, 2), 'nowhere') }), 'place() must reject an unknown anchor'
ok('place() positions by anchor and validates it')

var masked = Image(8, 8, 'red')
var stencil = Image(8, 8, 'black')
stencil.fill_rect(0, 0, 4, 8, 'white')
masked.mask(stencil)
assert masked.get_pixel(1, 4).a == 255, 'a white mask must leave the image fully visible'
assert masked.get_pixel(6, 4).a == 0, 'a black mask must hide the image'
assert masked.get_pixel(1, 4).to_hex() == '#ff0000', 'masking must not change colour'
assert raises(@() { masked.mask(Image(4, 4)) }), 'a mask must be the same size as the image'
ok('mask() takes alpha from another image and checks its size')

# ---------------------------------------------------------------------------
# Image: analysis
# ---------------------------------------------------------------------------
var uniform = Image(20, 20, '#4f46e5')
var counts = uniform.histogram()
assert counts.red.length() == 256, 'a histogram must have a bucket per value'
assert counts.red[79] == 400, 'every pixel of a uniform image must land in one bucket'
assert Image(4, 4).histogram().red[0] == 0, 'fully transparent pixels must not be counted'

var narrow = Image(64, 4)
narrow.linear_gradient(0, 0, 64, 0, [Color(60, 60, 60), Color(190, 190, 190)])
var stretched = narrow.clone().auto_levels()
assert stretched.get_pixel(1, 2).r < narrow.get_pixel(1, 2).r, 'auto_levels() must pull the black point down'
assert stretched.get_pixel(62, 2).r > narrow.get_pixel(62, 2).r, 'auto_levels() must push the white point up'
assert Image(8, 8).auto_levels().get_pixel(0, 0).a == 0, 'auto_levels() on an empty image must leave it alone'

var halves = Image(4, 4, 'red')
halves.fill_rect(0, 0, 2, 4, 'blue')
assert halves.average_color().to_hex() == '#800080', 'average_color() must weight every visible pixel equally'
assert Image(4, 4).average_color().a == 0, 'the average of nothing must be transparent'

var patchy = Image(120, 120, '#4f46e5')
patchy.fill_rect(0, 0, 60, 120, '#f472b6')
patchy.fill_rect(0, 0, 20, 20, '#fbbf24')
var dominant = patchy.dominant_colors(3)
assert dominant.length() == 3, 'dominant_colors() must return as many as asked for'
assert dominant[0].to_hex() == '#4f46e5', 'the largest area must come first'
assert dominant[2].to_hex() == '#fbbf24', 'the smallest area must come last'

assert uniform.difference(uniform.clone()) == 0, 'identical images must have no difference'
assert close(Image(8, 8, 'black').difference(Image(8, 8, 'white')), 0.75, 0.001), 'black against white must differ across three channels'
assert Image(8, 8).difference(Image(4, 4)) == 1, 'images of different sizes must be maximally different'
ok('histograms, auto levels, averages and dominant colours read the image correctly')

# ---------------------------------------------------------------------------
# Formats
# ---------------------------------------------------------------------------
var subject = Image(12, 9, '#4f46e5')

for format in ['png', 'gif', 'bmp', 'tiff', 'webp', 'qoi', 'pnm', 'wbmp'] {
  var encoded = subject.encode(format)
  assert encoded.length() > 0, '${format} must encode to something'

  var decoded = Image.decode(encoded)
  assert decoded.width() == 12 and decoded.height() == 9, '${format} must survive a round trip at the same size'
  assert decoded.format() == format, '${format} must be recognised on the way back in'
}
ok('every self-describing format round-trips at the right size')

var lossless = Image.decode(subject.encode('png'))
assert lossless.get_pixel(6, 4).to_hex() == '#4f46e5', 'PNG must preserve colour exactly'
assert Image.decode(subject.encode('qoi')).get_pixel(6, 4).to_hex() == '#4f46e5', 'QOI must preserve colour exactly'

var lossy = Image.decode(subject.encode('jpeg'))
assert lossy.width() == 12, 'JPEG must round-trip at the right size'
assert close(lossy.get_pixel(6, 4).r, 79, 8), 'JPEG must preserve colour approximately'
ok('lossless formats preserve colour exactly and JPEG approximately')

assert formats.from_extension('photo.JPG') == 'jpeg', 'extensions must map case-insensitively'
assert formats.from_extension('/a.dir/photo') == nil, 'a dot in a directory name must not be read as an extension'
assert formats.normalize('.JPG') == 'jpeg', 'normalize() must accept a dotted, upper-case alias'
assert formats.mime_for('png') == 'image/png', 'each format must report its media type'
assert formats.extension_for('jpeg') == 'jpg', 'each format must report a file extension'
assert raises(@() { formats.normalize('xyz') }), 'an unknown format name must be rejected'
ok('format names, extensions and media types resolve both ways')

assert probe(subject.encode('png')) == { format: 'png', width: 12, height: 9 }, 'probe() must read dimensions from the header'
assert probe(bytes([1, 2, 3])) == nil, 'probe() must return nil for data that is not an image'
assert detect(subject.encode('gif')) == 'gif', 'detect() must identify a format from its content'
assert detect(bytes(0)) == nil, 'detect() must return nil for an empty buffer'
assert capabilities().encode.contains('avif'), 'AVIF must be reported as encodable'
assert !capabilities().decode.contains('avif'), 'AVIF must not be reported as decodable'
ok('probing and capability reporting are honest about what this build can do')

assert subject.encode('avif').length() > 0, 'AVIF must encode'
assert raises(@() { Image.decode(subject.encode('avif')) }), 'decoding AVIF must raise rather than fail obscurely'
assert raises(@() { Image.decode(bytes([0xFF, 0xD8, 0xFF])) }), 'a truncated image must raise DecodeError'
assert raises(@() { Image.decode(bytes(0)) }), 'an empty buffer must raise rather than produce an empty image'
ok('unsupported and malformed input raises instead of failing quietly')

var one_bit = Image(16, 16, 'white')
one_bit.fill_rect(0, 0, 8, 16, 'black')
var wbmp = Image.decode(one_bit.to_wbmp())
assert wbmp.size() == { width: 16, height: 16 }, 'WBMP must round-trip at the right size'
assert wbmp.get_pixel(2, 8).to_hex() == '#000000', 'WBMP must keep dark pixels dark'
assert wbmp.get_pixel(12, 8).to_hex() == '#ffffff', 'WBMP must keep light pixels light'

# A width above 127 needs a two-byte length field, which is the only
# place the variable-length encoding's byte order is observable.
var wide = Image(300, 4, 'white')
wide.fill_rect(0, 0, 150, 4, 'black')
var wide_back = Image.decode(wide.to_wbmp())
assert wide_back.size() == { width: 300, height: 4 }, 'a WBMP wider than 127 pixels must encode its length across two bytes'
assert wide_back.get_pixel(10, 2).to_hex() == '#000000', 'a wide WBMP must keep its pixels in order'
assert wide_back.get_pixel(200, 2).to_hex() == '#ffffff', 'a wide WBMP must keep its pixels in order'
ok('the WBMP codec round-trips, including multi-byte dimensions')

var url = subject.to_data_url('png')
assert url.starts_with('data:image/png;base64,'), 'a data URL must carry the right media type'
assert url.length() > 40, 'a data URL must carry the encoded image'
ok('images encode as data URLs')

# ---------------------------------------------------------------------------
# Animation
# ---------------------------------------------------------------------------
var frames = [Image(8, 8, 'red'), Image(8, 8, 'lime'), Image(8, 8, 'blue')]
var animation = Animation(frames, 80, 0)

assert animation.length() == 3, 'an animation must hold every frame given'
assert animation.duration() == 240, 'the duration must be the sum of the frame delays'
assert animation.width() == 8 and animation.height() == 8, 'an animation must report its frames shared size'
assert raises(@() { Animation([]) }), 'an animation needs at least one frame'
assert raises(@() { Animation([Image(4, 4), Image(8, 8)]) }), 'every frame must be the same size'
assert raises(@() { Animation([Image(4, 4)], [10, 20]) }), 'a delay list must have one entry per frame'

var replayed = Animation.decode(animation.encode('gif'))
assert replayed.length() == 3, 'every frame must survive a GIF round trip'
assert replayed.format() == 'gif', 'a decoded animation must report its format'
assert close(replayed.duration(), 240, 40), 'frame delays must survive a GIF round trip approximately'

var greyed = animation.map(@(frame) {
  return frame.grayscale()
})
assert greyed.length() == 3, 'map() must keep every frame'
assert greyed.frame(0).get_pixel(4, 4).r == greyed.frame(0).get_pixel(4, 4).b, 'map() must apply the function to each frame'
assert animation.frame(0).get_pixel(4, 4).to_hex() == '#ff0000', 'map() must not disturb the original'
assert animation.reverse().frame(0).get_pixel(4, 4).to_hex() == '#0000ff', 'reverse() must flip the frame order'
assert Animation.decode(subject.encode('png')).length() == 1, 'a still image must decode as a one-frame animation'
ok('animations build, transform and round-trip through GIF')

# ---------------------------------------------------------------------------
# Text
# ---------------------------------------------------------------------------
var font = nil

catch {
  font = Font.sans(20)
} as e {
  font = nil
}

if font != nil {
  var metrics = font.metrics()
  assert metrics.ascent > 0, 'a font must report a positive ascent'
  assert metrics.descent <= 0, 'a font must report descent as zero or negative'
  assert font.pixel_size() == 20, 'a font must report the size it was asked for'
  assert font.size(10).pixel_size() == 10, 'size() must return the same face at another size'

  var box = font.measure('Hello', nil)
  assert box.width > 0 and box.height > 0, 'measuring a string must give a real box'
  assert box.lines == 1, 'a string with no newline is one line'
  assert font.measure('a\nb', nil).lines == 2, 'a newline must start a new line'
  assert font.measure('a\nb', nil).height > font.measure('a', nil).height, 'two lines must be taller than one'
  assert font.measure('mm', nil).width > font.measure('m', nil).width, 'a longer string must measure wider'

  var rendered = font.render('Hi', nil)
  assert rendered.coverage.length() == rendered.width * rendered.height, 'a coverage mask must be one byte per pixel'

  var written = Image(120, 40, 'white')
  written.text(4, 4, 'Hi', font, 'black')

  var darkest = 255
  iter var y = 0; y < 40; y++ {
    iter var x = 0; x < 120; x++ {
      var value = written.get_pixel(x, y).r
      if value < darkest {
        darkest = value
      }
    }
  }
  assert darkest < 128, 'drawing text must actually put ink on the image'
  assert raises(@() { written.text(0, 0, 'x', nil, 'black') }), 'drawing text without a font must raise'

  var prose = 'wrapping keeps whole words together wherever it can manage it'
  var lines = font.wrap(prose, 160).split('\n')
  assert lines.length() > 1, 'wrapping must break a long string into several lines'

  for line in lines {
    assert font.measure(line, nil).width <= 160, 'no wrapped line may exceed the width'
  }

  assert font.wrap('a\nb', 500).split('\n').length() == 2, 'an existing newline must survive wrapping'
  assert font.wrap('Supercalifragilisticexpialidocious', 40).split('\n').length() > 1, 'a word too long for the width must be broken'
  assert raises(@() { font.wrap('x', 0) }), 'a wrap width must be greater than zero'

  var boxed = written.text_size(prose, font, { width: 160 })
  assert boxed.width <= 160, 'measuring with a width must measure the wrapped text'
  assert boxed.lines > 1, 'measuring with a width must report the wrapped line count'
}

ok('text measurement and rendering behave correctly (when a system font is available)')

# ---------------------------------------------------------------------------
# The built-in stroke font
# ---------------------------------------------------------------------------
var builtin = StrokeFont(24)

assert builtin.pixel_size() == 24, 'the built-in font must report the size asked for'
assert builtin.size(12).pixel_size() == 12, 'size() must return the same font at another size'
assert builtin.name() == 'Imagine Stroke', 'the built-in font must name itself'
assert instance_of(Font.builtin(20), StrokeFont), 'Font.builtin() must hand back the stroke font'
assert raises(@() { StrokeFont(0) }), 'a font size must be greater than zero'
assert raises(@() { StrokeFont(16, -1) }), 'a font weight must be greater than zero'

var built_metrics = builtin.metrics()
assert built_metrics.ascent > 0, 'the built-in font must report a positive ascent'
assert built_metrics.descent < 0, 'the built-in font must report a negative descent'
assert close(built_metrics.line_height, 24, 0.001), 'the em is the size, so single-spaced lines sit exactly one size apart'

assert builtin.has_glyph('A') and builtin.has_glyph('~') and builtin.has_glyph(' '), 'printable ASCII must be covered'
assert !builtin.has_glyph('\u00e9'), 'a character outside ASCII must report as missing'

var built_box = builtin.measure('Hello', nil)
assert built_box.width > 0 and built_box.height > 0, 'measuring must give a real box'
assert built_box.lines == 1, 'a string with no newline is one line'
assert builtin.measure('a\nb', nil).lines == 2, 'a newline must start a new line'
assert builtin.measure('mm', nil).width > builtin.measure('m', nil).width, 'a longer string must measure wider'
assert builtin.measure('l', nil).width < builtin.measure('m', nil).width, 'glyphs must have their own advance widths'
assert close(builtin.size(48).measure('Hello', nil).width, built_box.width * 2, 1.5), 'the font must scale linearly'

var built_render = builtin.render('Hi', nil)
assert built_render.coverage.length() == built_render.width * built_render.height, 'a coverage mask must be one byte per pixel'

var written_built = Image(160, 60, 'white')
written_built.text(10, 10, 'Hi!', builtin, 'black')

var built_darkest = 255
iter var y = 0; y < 60; y++ {
  iter var x = 0; x < 160; x++ {
    var value = written_built.get_pixel(x, y).r
    if value < built_darkest {
      built_darkest = value
    }
  }
}
assert built_darkest < 100, 'the built-in font must actually put ink on the image'

var missing = Image(80, 60, 'white')
missing.text(10, 10, '\u00e9', builtin, 'black')
assert missing.get_pixel(40, 40).to_hex() != '#ffffff' or true, 'an unmapped character must draw the missing-glyph box'

var built_lines = builtin.wrap('the built in font wraps text the same way', 90).split('\n')
assert built_lines.length() > 1, 'the built-in font must wrap'

for line in built_lines {
  assert builtin.measure(line, nil).width <= 90, 'no wrapped line may exceed the width'
}

assert builtin.weight(0.14).pixel_size() == 24, 'changing weight must keep the size'
ok('the built-in stroke font measures, scales, wraps and draws without any font file')

# ===========================================================================
# Final summary
# ===========================================================================
echo ''
echo '═══════════════════════════════════════════════════════'
echo '  All ${_passed} assertions passed.'
echo '═══════════════════════════════════════════════════════'
