var client_cert = '-----BEGIN CERTIFICATE-----
MIIBqjCCAU+gAwIBAgIUKY6KD8+UhDTVfnuwbeg/aqGZjEYwCgYIKoZIzj0EAwIw
HDEaMBgGA1UEAwwRWnVyaSBUZXN0IFJvb3QgQ0EwHhcNMjYwODI4MDE1MjE1WhcN
MzYwODI1MDE1MjE1WjAWMRQwEgYDVQQDDAt0ZXN0LWNsaWVudDBZMBMGByqGSM49
AgEGCCqGSM49AwEHA0IABPpEubbKD+COTVAgX9PLA1TCLpOuLmG/2/cCOrAjStdf
NuGrPGJM0AqZgiLhm1IH3gow+Nl18wVI3GieAqs5VgujdTBzMAwGA1UdEwEB/wQC
MAAwDgYDVR0PAQH/BAQDAgeAMBMGA1UdJQQMMAoGCCsGAQUFBwMCMB0GA1UdDgQW
