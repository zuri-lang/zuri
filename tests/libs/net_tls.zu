echo '═══════════════════════════════════════════════════════'
echo '  net.tls module: test suite'
echo '═══════════════════════════════════════════════════════'

# ---------------------------------------------------------------------------
# Client/server echo, over a real certificate chain
# ---------------------------------------------------------------------------
var ch1 = isolate.channel(1)
var task1 = isolate.spawn(net_tls_server.echo_server, ch1, server_cert, server_key)
var addr1 = ch1.recv()

var config1 = tls.TlsConfig()
config1.add_ca_pem(ca_cert)

var tcp1 = net.TcpStream()
tcp1.connect(addr1)
var stream1 = tls.TlsStream.connect(tcp1, config1, 'localhost')
stream1.write_all('hello')
stream1.shutdown()
var reply1 = stream1.read_as_string()
stream1.close()
task1.join()

assert reply1 == 'echo:hello', 'expected the server to echo back the message'
ok('client/server echo round-trip over a verified certificate chain')

# ---------------------------------------------------------------------------
# Certificate rejection: an untrusted root must be refused
# ---------------------------------------------------------------------------
var ch2 = isolate.channel(1)
var task2 = isolate.spawn(net_tls_server.echo_server, ch2, server_cert, server_key)
var addr2 = ch2.recv()

var config2 = tls.TlsConfig() # bundled roots only - does not trust our test CA

var tcp2 = net.TcpStream()
tcp2.connect(addr2)
assert raises(@() { tls.TlsStream.connect(tcp2, config2, 'localhost') }),
  'connecting without trusting the test CA must raise'
ok('untrusted certificate is rejected')

# ---------------------------------------------------------------------------
# Mutual TLS: server requires and verifies a client certificate
# ---------------------------------------------------------------------------
var ch3 = isolate.channel(1)
var task3 = isolate.spawn(
  net_tls_server.mutual_tls_server, ch3, server_cert, server_key, ca_cert)
var addr3 = ch3.recv()

var config3 = tls.TlsConfig()
config3.add_ca_pem(ca_cert)
config3.set_cert_chain(client_cert, client_key)

var tcp3 = net.TcpStream()
tcp3.connect(addr3)
var stream3 = tls.TlsStream.connect(tcp3, config3, 'localhost')
stream3.shutdown()
var reply3 = stream3.read_as_string()
stream3.close()
task3.join()

assert reply3 == 'subject:CN=test-client',
  'server must see and report the client certificate subject'
ok('mutual TLS: server verifies and reads the client certificate')

# ---------------------------------------------------------------------------
# ALPN negotiation
# ---------------------------------------------------------------------------
var ch4 = isolate.channel(1)
var task4 = isolate.spawn(
  net_tls_server.alpn_server, ch4, server_cert, server_key, ['h2', 'http/1.1'])
var addr4 = ch4.recv()

var config4 = tls.TlsConfig()
config4.add_ca_pem(ca_cert)
config4.set_alpn(['http/1.1'])

var tcp4 = net.TcpStream()
tcp4.connect(addr4)
var stream4 = tls.TlsStream.connect(tcp4, config4, 'localhost')
assert stream4.alpn_protocol() == 'http/1.1',
  'client must see the negotiated ALPN protocol too'
# The server never reads from the client here, it just replies and
# closes - so, unlike the echo/mTLS scenarios, there's nothing for the
# client to signal EOF on first; shutdown() before reading would just
# race the server's own close.
var reply4 = stream4.read_as_string()
stream4.close()
task4.join()

assert reply4 == 'negotiated:http/1.1',
  'client and server must negotiate the one protocol they both offer'
ok('ALPN negotiation picks the overlapping protocol')

# ---------------------------------------------------------------------------
# STARTTLS-style upgrade: plaintext greeting, then wrap the same socket
# ---------------------------------------------------------------------------
var ch5 = isolate.channel(1)
var task5 = isolate.spawn(net_tls_server.starttls_server, ch5, server_cert, server_key)
var addr5 = ch5.recv()

var config5 = tls.TlsConfig()
config5.add_ca_pem(ca_cert)

var tcp5 = net.TcpStream()
tcp5.connect(addr5)
var greeting = tcp5.read_exact(11) # '220 ready\r\n'
tcp5.write_all('STARTTLS\r\n')
var stream5 = tls.TlsStream.connect(tcp5, config5, 'localhost')
var reply5 = stream5.read_all()
stream5.close()
task5.join()

assert greeting.to_string() == '220 ready\r\n', 'must read the plaintext greeting first'
assert reply5.to_string() == 'secure-hello',
  'the connection must be encrypted, and usable, after the STARTTLS upgrade'
ok('STARTTLS-style upgrade after a plaintext greeting')

# ---------------------------------------------------------------------------
# Non-blocking socket: the handshake must work by retrying on the
# underlying socket's own WouldBlock, same contract as plain TcpStream
# ---------------------------------------------------------------------------
var ch6 = isolate.channel(1)
var task6 = isolate.spawn(net_tls_server.non_blocking_server, ch6, server_cert, server_key)
var addr6 = ch6.recv()

var config6 = tls.TlsConfig()
config6.add_ca_pem(ca_cert)

# A handshake is a multi-flight exchange, not a single request, so
# connect() drives it to completion internally rather than surfacing a
# WouldBlock the caller would have to retry (retrying would mean
# starting a brand new ClientHello over a connection that already has
# a partial one on the wire). Non-blocking mode still has to produce a
# correct result, not just an immediate one.
var tcp6 = net.TcpStream()
tcp6.connect(addr6)
tcp6.set_non_blocking(true)
var stream6 = tls.TlsStream.connect(tcp6, config6, 'localhost')

# Once established, a read/write DOES keep the normal "caller retries
# the same call" contract - each is independent at the TCP-byte level,
# unlike the handshake. Loop until the server's reply actually arrives.
var reply6 = nil
var read_attempts = 0
while reply6 == nil and read_attempts < 10000 {
  catch {
    var chunk = stream6.read(16)
    if chunk.length() > 0 {
      reply6 = chunk.to_string()
    }
  } as e
  read_attempts++
}
stream6.close()
task6.join()

assert reply6 == 'ok', 'the stream must be fully usable once the handshake completes'
ok('TLS handshake completes correctly over a non-blocking socket')

# ===========================================================================
# Final summary
# ===========================================================================
echo ''
echo '═══════════════════════════════════════════════════════'
echo '  All ${_passed} assertions passed.'
echo '═══════════════════════════════════════════════════════'
