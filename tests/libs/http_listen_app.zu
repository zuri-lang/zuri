/**
 * Runs one server on `listen()` until a request to `/quit`.
 *
 * @param Channel port_channel: told the bound address
 * @param dict settings: `HttpServer` fields to set, plus `file` (a path
 *    to serve at `/file`) and `cert` and `key` for TLS
 */
def serve(port_channel, settings) {
  var server = http.HttpServer(0, '127.0.0.1')
  var big = 'x' * BIG_SIZE
  var connects = [0]
  var disconnects = [0]
  var errors = []

  server.compression = false

  for name, value in settings {
    if hasprop(server, name) {
      setprop(server, name, value)
    }
  }

  if settings.get('cert', nil) != nil {
    server.use_tls(settings.cert, settings.key)
  }

  server.on_connect(@(connection) {
    connects[0] += 1
  })

  server.on_disconnect(@(connection) {
    disconnects[0] += 1
  })

  server.on_error(@(error, connection) {
    errors.append(error.message)
  })

  server.get('/ping', @(request, response) {
    response.text('pong')
  })

  server.get('/say/:word', @(request, response) {
    response.text(request.param('word'))
  })

  server.get('/big', @(request, response) {
    response.text(big)
  })

  server.get('/file', @(request, response) {
    response.file(settings.file)
  })

  server.get('/stream', @(request, response) {
    response.stream(@(writer) {
      writer.write('one ')
      writer.flush()
      writer.write('two')
    })
  })

  server.post('/echo', @(request, response) {
    response.write(request.body)
  })

  server.get('/socket', @(request, response) {
    var socket = websocket.accept(request, response)

    socket.send('hello ' + socket.receive().text())
    socket.close()
  })

  server.get('/events', @(request, response) {
    response.json({
      connects: connects[0],
      disconnects: disconnects[0],
      errors,
    })
  })

  server.get('/quit', @(request, response) {
    response.text('bye')
    server.close()
  })

  server.bind()
  port_channel.send(server.address().to_string())
  server.listen()

  return disconnects[0]
}
