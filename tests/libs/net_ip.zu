for entry in REGISTRY {
  check('${entry[0]} is_global', net.Ip.parse(entry[0]).is_global(), entry[1])
}

section('either family')

check('a private ipv4 address', net.Ip.parse('192.168.1.10').is_private(), true)
check('a unique local ipv6 address', net.Ip.parse('fd00::1').is_private(), true)
check(
  'a public ipv4 address is not private',
  net.Ip.parse('8.8.8.8').is_private(),
  false,
)
check('is_global for ipv4', net.Ip.parse('8.8.8.8').is_global(), true)
check('is_global for ipv6', net.Ip.parse('fe80::1').is_global(), false)

echo ''

if _failed > 0 {
  echo '${_failed} of ${_passed + _failed} checks failed'

  os.exit(1)
}

echo 'all ${_passed} checks passed'
