/**
 * test_net_ip.zu
 *
 * How `net.ip` classifies addresses: the special-purpose blocks of
 * each family, and `is_global()` measured against the IANA registries
 * it follows.
 */

import net
import os

var _passed = 0
var _failed = 0

def check(label, got, expected) {
  if got == expected {
    _passed++

    return
  }

  _failed++

  echo '  [FAIL] ${label}'
  echo '         got      ${got}'
  echo '         expected ${expected}'
}

def section(title) {
  echo ''
  echo '== ${title} =='
}

# Whether `asking` answers `expected` for each address in `addresses`,
# handed the address of its own family.
def each(question, asking, addresses, expected) {
  for text in addresses {
    var address = net.Ip.parse(text)
    var inner = address.is_ipv4() ? address.as_ipv4() : address.as_ipv6()

    check('${text} ${question}', asking(inner), expected)
  }
}

section('ipv4 blocks')

each('is_shared', @(a) => a.is_shared(), [
  '100.64.0.1',
  '100.127.255.254',
], true)
each('is_shared', @(a) => a.is_shared(), [
  '100.63.255.255',
  '100.128.0.0',
], false)
each('is_benchmarking', @(a) => a.is_benchmarking(), [
  '198.18.0.1',
  '198.19.255.255',
], true)
each('is_benchmarking', @(a) => a.is_benchmarking(), [
  '198.17.0.1',
  '198.20.0.1',
], false)
each('is_reserved', @(a) => a.is_reserved(), [
  '240.0.0.1',
  '254.255.255.255',
], true)
each('is_reserved', @(a) => a.is_reserved(), [
  '239.255.255.255',
  '255.255.255.255',
], false)

section('ipv6 blocks')

each('is_unique_local', @(a) => a.is_unique_local(), [
  'fc00::1',
  'fd12:3456::1',
], true)
each('is_unique_local', @(a) => a.is_unique_local(), [
  'fe80::1',
  'fbff::1',
], false)
each('is_documentation', @(a) => a.is_documentation(), [
  '2001:db8::1',
  '3fff::1',
  '3fff:fff::1',
], true)
each('is_documentation', @(a) => a.is_documentation(), [
  '2001:db9::1',
  '3fff:1000::1',
], false)

section('is_global')

# Every block in the IANA IPv4 and IPv6 Special-Purpose Address
