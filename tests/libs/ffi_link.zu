/**
 * ffi_link.zu
 *
 * Test suite for `ffi.link()`: a C static library and a Rust staticlib
 * linked into loadable libraries with the platform's linker, the cache
 * that makes a second link free, and the errors a bad input gives.
 */
# @fixture: ffi

import ffi
import os

var _passed = 0

def ok(label) {
  _passed++
  echo '  [PASS] ' + label
}

# Catches whatever `fn` raises and hands it back for inspection.
def caught(fn) {
  catch {
    fn()
  } as e {
    return e
  }

  return nil
}

echo '═══════════════════════════════════════════════════════'
echo '  ffi link: test suite'
echo '═══════════════════════════════════════════════════════'

var fixtures = os.get_env('ZURI_FFI_FIXTURES')
assert fixtures, 'ZURI_FFI_FIXTURES names the directory the fixture libraries were built into'

var windows = ffi.platform().os == 'windows'

def archive(name) {
  return os.join_paths(fixtures, windows ? '${name}.lib' : 'lib${name}.a')
}

var cache = os.create_temp_dir('zuri-ffi-link-')

# A C static library.

var c = ffi.link(archive('ffifixture'), { cache })
assert c.path().starts_with(cache), 'the linked library lands in the cache'
var add = c.function('fx_add', ffi.int, [ffi.int, ffi.int])
assert add(20, 22) == 42, 'a function from the static library is callable'
var greeting = c.function('fx_greeting', ffi.string, [])
assert greeting() == 'hello from C', 'with its data'
ok('a C static library linked and loaded')

var again = ffi.link([archive('ffifixture')], { cache })
assert again.path() == c.path(), 'the same input links to the same cached library'
ok('the cache is keyed by content')

# A Rust staticlib.

var rust = ffi.link(archive('ffirust'), { cache })
var Point = ffi.struct('Point').add_field('x', ffi.f64).add_field('y', ffi.f64)
var distance = rust.function('rs_distance', ffi.double, [Point, Point])
assert distance({ x: 0, y: 0 }, { x: 6, y: 8 }) == 10, 'Rust code from a staticlib'
var greet = rust.function('rs_greet', ffi.pointer(ffi.char), [ffi.string])
var free_text = rust.function('rs_string_free', ffi.void, [ffi.pointer(ffi.char)])
var hello = greet('linker').own(free_text)
assert hello.read_string() == 'hello, linker', 'the standard library links in with it'
hello.free()
ok('a Rust staticlib linked with the system libraries it needs')

# Errors.

var missing = caught(@() => ffi.link(os.join_paths(cache, 'nothing.a'), { cache }))
assert missing and missing.type == 'LinkError', 'a missing archive is a LinkError'

var not_archive = os.join_paths(cache, 'fake.a')
file(not_archive, 'w').write('not an archive')
var e = caught(@() => ffi.link(not_archive, { cache }))
assert e and e.type == 'LinkError' and e.message.contains('not a static library'),
  'the content is checked'

e = caught(@() => ffi.link(archive('ffifixture'), { cache, frobnicate: true }))
assert e and e.type == 'ValueError', 'an unknown option is refused'

var fresh = os.join_paths(cache, 'fresh')
e = caught(@() => ffi.link(archive('ffifixture'), {
  cache: fresh,
  libraries: ['zuri_no_such_library'],
}))
assert e and e.type == 'LinkError', 'a linker failure is a LinkError'
ok('bad inputs are refused with the reason')

assert ffi.default_link_cache().contains('zuri'), 'the default cache is a zuri directory'
ok('the default cache')

echo ''
echo '═══════════════════════════════════════════════════════'
echo '  All ${_passed} assertions passed.'
echo '═══════════════════════════════════════════════════════'
