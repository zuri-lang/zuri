# Tables described once with a Blueprint, created and changed the same
# way on every engine.
#
# The statements each adapter writes are checked as text for all of
# them, which needs no server. Everything else runs against SQLite, and
# against PostgreSQL, MySQL and MariaDB when ZURI_TEST_POSTGRES,
# ZURI_TEST_MYSQL and ZURI_TEST_MARIADB name a server. Those runs use
# tables of their own, dropped before and after.

import json
import os
import sql
import sql.blueprint { Blueprint, index_name }
import sql.errors {
  QueryError,
  NotSupportedError,
  NotNullViolation,
  ForeignKeyViolation,
  UniqueViolation,
}

def raises(body, kind) {
  catch {
    body()
  } as error {
    return instance_of(error, kind)
  }

  return false
}

# The statements creating one table, for one engine, without a server.
def rendered(driver, body, options) {
  var blueprint = Blueprint('posts', true)
  body(blueprint)

  return sql
      .driver(driver)
      .ddl()
      .create_table_statements(blueprint, options or {})
}

def sample(table) {
  table.id()
  table.references('author_id', 'authors').on_delete('cascade')
  table.string('slug', 120).exact().unique()
  table.text('body').nullable()
  table.boolean('published').default_value(true)
  table.json('tags').default_value([])
  table.decimal('price', 10, 2).default_value(0)
  table.datetime('seen_at').use_current()
  table.index(['published', 'seen_at'])
}

def test_rendering() {
  var lite = rendered('sqlite', sample, nil)

  assert lite.length() == 3
  assert lite[0] ==
      'create table "posts" (\n' +
          '  "id" integer primary key autoincrement,\n' +
          '  "author_id" bigint not null,\n' +
          '  "slug" varchar(120) not null,\n' +
          '  "body" text null,\n' +
          '  "published" boolean not null default 1,\n' +
          "  \"tags\" json not null default '[]',\n" +
          '  "price" decimal(10, 2) not null default 0,\n' +
          "  \"seen_at\" datetime not null default (strftime('%Y-%m-%dT%H:%M:%S', 'now') || " +
          "substr(strftime('%f', 'now'), 3) || '000+00:00'),\n" +
          '  constraint "posts_author_id_foreign" foreign key ("author_id") references ' +
          '"authors" ("id") on delete cascade\n' +
          ')'
  assert lite[1] ==
      'create unique index "posts_slug_unique" on "posts" ("slug")'
  assert lite[2] ==
      'create index "posts_published_seen_at_index" on "posts" ("published", "seen_at")'

  var pg = rendered('postgres', sample, { if_not_exists: true })

  assert pg[0].starts_with(
    'create table if not exists "posts" (\n  "id" bigint generated by default as identity primary key,',
  )
  assert pg[0].contains('"slug" varchar(120) collate "C" not null')
  assert pg[0].contains('"published" boolean not null default true')
  assert pg[0].contains('"tags" jsonb not null')
  assert pg[0].contains('"price" numeric(10, 2) not null default 0')
  assert pg[0].contains(
    '"seen_at" timestamp with time zone not null default current_timestamp',
  )
  assert pg[1] ==
      'create unique index if not exists "posts_slug_unique" on "posts" ("slug")'

  var my = rendered('mysql', sample, nil)

  # Indexes go inside the statement, so if_not_exists covers them too.
  assert my.length() == 1
  assert my[0].starts_with(
    'create table `posts` (\n  `id` bigint auto_increment primary key,',
  )
  assert my[0].contains('`slug` varchar(120) collate utf8mb4_bin not null')
  assert my[0].contains('`published` tinyint(1) not null default 1')
  assert my[0].contains("`tags` json not null default ('[]')")
  assert my[0].contains('`body` longtext null')
  assert my[0].contains(
    '`seen_at` datetime(6) not null default current_timestamp(6)',
  )
  assert my[0].contains('unique key `posts_slug_unique` (`slug`)')
  assert my[0].contains(
    'key `posts_published_seen_at_index` (`published`, `seen_at`)',
  )
  assert my[0].ends_with(') engine=InnoDB default charset=utf8mb4')

  # MariaDB shares MySQL's.
  assert rendered('mariadb', sample, nil) == my

  echo 'test_rendering passed'
}

def test_literals() {
  def defaulting(value) {
    return @(table) {
      table.string('note', 40).default_value(value)
    }
  }

  var quote = "it's"
  var slash = 'a\\b'

  assert rendered('sqlite', defaulting(quote), nil)[0].contains(
    "default 'it''s'",
  )
  assert rendered('postgres', defaulting(quote), nil)[0].contains(
    "default 'it''s'",
  )
  assert rendered('mysql', defaulting(quote), nil)[0].contains(
    "default 'it''s'",
  )

  # A backslash means the same however each server reads one.
  assert rendered('sqlite', defaulting(slash), nil)[0].contains(
    "default 'a\\b'",
  )
  assert rendered('postgres', defaulting(slash), nil)[0].contains(
    "default E'a\\\\b'",
  )
  assert rendered('mysql', defaulting(slash), nil)[0].contains(
    "default _utf8mb4 X'615c62'",
  )

  assert rendered('sqlite', defaulting(nil), nil)[0].contains('default null')
  assert rendered('sqlite', defaulting(sql.Decimal('1.50')), nil)[0].contains(
    'default 1.50',
  )
  assert rendered('sqlite', defaulting(sql.raw('lower(\'X\')')), nil)[0]
      .contains("default lower('X')")

  assert raises(@() {
    rendered('sqlite', defaulting(1 / 0), nil)
  }, QueryError)

  assert raises(@() {
    rendered('sqlite', defaulting(Blueprint('x', true)), nil)
  }, QueryError)

  echo 'test_literals passed'
}

def test_descriptions() {
  # Mistakes in a description are caught as it is written.
  assert raises(@() {
    Blueprint('t', true).string('s', 0)
  }, QueryError)

  assert raises(@() {
    Blueprint('t', true).decimal('d', 10, 11)
  }, QueryError)

  assert raises(@() {
    Blueprint('t', true).integer('n').use_current()
  }, QueryError)

  assert raises(@() {
    Blueprint('t', true).integer('n').exact()
  }, QueryError)

  assert raises(@() {
    Blueprint('t', true).integer('n').on_delete('cascade')
  }, QueryError)

  assert raises(@() {
    Blueprint('t', true).references('a_id', 'a').on_delete('explode')
  }, QueryError)

  assert raises(@() {
    Blueprint('t', true).foreign(['a', 'b'], 'other', ['id'])
  }, QueryError)

  assert raises(@() {
    Blueprint('t', true).drop_column('x')
  }, QueryError)

  # Actions read however they were spelled.
  var key = Blueprint(
    't',
    true,
  ).foreign('a_id', 'a', nil).on_delete('SET  NULL').on_update('No Action')

  assert key.on_delete_action == 'set null'
  assert key.on_update_action == 'no action'

  # A table creating nothing, a change in a creation, two keys.
  assert raises(@() {
    rendered('sqlite', @(table) {}, nil)
  }, QueryError)

  assert raises(@() {
    rendered('sqlite', @(table) {
      table.string('s', 10).change()
    }, nil)
  }, QueryError)

  assert raises(@() {
    rendered('sqlite', @(table) {
      table.id()
      table.integer('other').primary()
    }, nil)
  }, QueryError)

  # Engines refuse what they cannot hold.
  assert raises(@() {
    rendered('sqlite', @(table) {
      table.decimal('big', 20, 2)
    }, nil)
  }, NotSupportedError)

  assert rendered('postgres', @(table) {
    table.decimal('big', 20, 2)
  }, nil)[0].contains('numeric(20, 2)')

  assert raises(@() {
    rendered('mysql', @(table) {
      table.text('body').index()
    }, nil)
  }, NotSupportedError)

  echo 'test_descriptions passed'
}

def test_index_names() {
  assert index_name('posts', ['author_id'], 'foreign') ==
      'posts_author_id_foreign'
  assert index_name('public.posts', ['a', 'b'], 'index') == 'posts_a_b_index'
  assert index_name('Posts', ['Slug'], 'unique') == 'posts_slug_unique'

  var long = index_name('a_table_with_a_rather_long_name', [
    'and_a_long_column',
    'and_another',
  ], 'index')
  var other = index_name('a_table_with_a_rather_long_name', [
    'and_a_long_column',
    'and_yet_another',
  ], 'index')

  assert long.length() == 63
  assert other.length() == 63
  assert long != other

  echo 'test_index_names passed'
}

# Tables for the SQLite tests, with rows, a view, a trigger, a check and
# a child table referring to the parent.
def fixture() {
  var db = sql.open(':memory:')

  db.schema.create_table('authors', @(table) {
    table.id()
    table.string('name', 80).unique()
  })

  db.schema.create_table('books', @(table) {
    table.id()
    table.references('author_id', 'authors').on_delete('cascade')
    table.string('title', 120)
    table.integer('pages').default_value(0)
    table.index('title')
  })

  db.exec("create table book_log (what text)", nil)
  db.exec(
    'create trigger books_logged after insert on books begin ' +
        'insert into book_log values (new.title); end',
    nil,
  )
  db.exec(
    'create view long_books as select title from books where pages > 100',
    nil,
  )

  var ada = db.insert('authors', { name: 'Ada' })
  var grace = db.insert('authors', { name: 'Grace' })

  db.insert('books', { author_id: ada, title: 'Engines', pages: 300 })
  db.insert('books', { author_id: grace, title: 'Compilers', pages: 90 })
  var gone = db.insert('books', { author_id: grace, title: 'Gone', pages: 1 })
  db.delete('books', { id: gone })

  return db
}

def test_rebuild_keeps_everything() {
  var db = fixture()

  # Changing a column needs a rebuild of the parent here: authors has
  # children that must survive it.
  db.schema.alter_table('authors', @(table) {
    table.string('name', 200).change()
  })

  assert db.count('authors') == 2
  assert db.count('books') == 2, 'rows referring to a rebuilt table survive'
  assert db.schema.foreign_keys('books')[0].references_table == 'authors'
  assert db.schema
      .indexes('authors')
      .map(@(index) => index.name)
      .contains('authors_name_unique')

  db.schema.alter_table('books', @(table) {
    table.string('title', 300).change()
    table.drop_column('pages')
  })

  assert db.schema.column_names('books') == ['id', 'author_id', 'title']
  assert db.schema.indexes('books').map(@(index) => index.name) ==
      ['books_title_index']
  assert db.fetch_column('select title from books order by id', nil, nil) ==
      ['Engines', 'Compilers']

  # The trigger came back, and the sequence did: the deleted row's id is
  # not handed out again.
  var next = db.insert('books', { author_id: 1, title: 'Looms' })

  assert next == 4
  assert db
      .fetch_column('select what from book_log', nil, nil)
      .contains('Looms')

  # The foreign key is enforced again, cascade and all.
  assert raises(@() {
    db.insert('books', { author_id: 99, title: 'Orphan' })
  }, ForeignKeyViolation)

  db.delete('authors', { name: 'Grace' })
  assert db.count('books') == 2

  db.close()
  echo 'test_rebuild_keeps_everything passed'
}

def test_rebuild_keeps_what_it_does_not_know() {
  var db = sql.open(':memory:')

  db.exec_script(
    "
    create table prices (
      id integer primary key,
      amount integer not null check (amount >= 0),
      code text collate nocase,
      extra text
    );
  ",
  )

  db.schema.alter_table('prices', @(table) {
    table.drop_column('extra')
  })

  var definition = db.fetch_value(
    "select sql from sqlite_master where name = 'prices'",
    nil,
    nil,
  )

  assert definition.contains('check (amount >= 0)')
  assert definition.contains('collate nocase')

  assert raises(@() {
    db.insert('prices', { amount: -1 })
  }, sql.CheckViolation)

  # Dropping a column a check names takes the check with it, as
  # PostgreSQL does.
  db.schema.alter_table('prices', @(table) {
    table.drop_column('amount')
  })

  assert !db
      .fetch_value(
        "select sql from sqlite_master where name = 'prices'",
        nil,
        nil,
      )
      .contains('check')

  db.close()
  echo 'test_rebuild_keeps_what_it_does_not_know passed'
}

def test_alterations() {
  var db = fixture()

  db.schema.alter_table('books', @(table) {
    table.string('isbn', 20).nullable().unique()
    table.rename_column('pages', 'page_count')
    table.integer('edition').default_value(1)
  })

  assert db.schema.column_names('books').contains('page_count')
  assert db.fetch_value('select edition from books where id = 1', nil, nil) == 1

  db.exec("update books set isbn = 'x' where id = 1", nil)
  assert raises(@() {
    db.exec(
      "insert into books (author_id, title, isbn) values (1, 'Twin', 'x')",
      nil,
    )
  }, UniqueViolation)

  db.schema.alter_table('books', @(table) {
    table.drop_unique(['isbn'])
    table.drop_index(['title'])
    table.drop_foreign(['author_id'])
  })

  assert db.schema.indexes('books').is_empty()
  assert db.schema.foreign_keys('books').is_empty()

  db.schema.alter_table('books', @(table) {
    table.foreign('author_id', 'authors', nil).on_delete('restrict')
  })

  assert db.schema.foreign_keys('books')[0].on_delete == 'RESTRICT'

  # A required column with nothing to fill the rows with.
  assert raises(@() {
    db.schema.alter_table('books', @(table) {
      table.string('required', 10)
    })
  }, NotNullViolation)

  assert !db.schema.column_names('books').contains('required')

  db.close()
  echo 'test_alterations passed'
}

def test_keys() {
  var db = sql.open(':memory:')

  db.schema.create_table('pairs', @(table) {
    table.integer('left')
    table.integer('right')
  })

  db.schema.alter_table('pairs', @(table) {
    table.primary(['left', 'right'])
  })

  assert db.schema.primary_key_columns('pairs') == ['left', 'right']

  assert raises(@() {
    db.schema.alter_table('pairs', @(table) {
      table.primary('left')
    })
  }, QueryError)

  db.schema.alter_table('pairs', @(table) {
    table.drop_primary()
  })

  assert db.schema.primary_key_columns('pairs').is_empty()

  # An id() added to a table with rows numbers them.
  db.insert('pairs', { left: 1, right: 2 })
  db.insert('pairs', { left: 3, right: 4 })

  db.schema.alter_table('pairs', @(table) {
    table.id()
  })

  assert db.fetch_column('select id from pairs order by id', nil, nil) == [1, 2]

  db.close()
  echo 'test_keys passed'
}

def test_atomic() {
  var db = fixture()

  # The second change fails, and the first is undone with it.
  assert raises(@() {
    db.schema.alter_table('books', @(table) {
      table.integer('kept').nullable()
      table.drop_column('no_such_column')
    })
  }, QueryError)

  assert !db.schema.column_names('books').contains('kept')

  db.close()
  echo 'test_atomic passed'
}

def test_inside_a_transaction() {
  var db = fixture()

  # A rebuild cannot switch foreign keys off inside a transaction, and
  # with them on it would take the children along, so it refuses.
  assert raises(@() {
    db.transaction(@(tx) {
      tx.schema.alter_table('authors', @(table) {
        table.string('name', 200).change()
      })
    })
  }, NotSupportedError)

  # A change SQLite makes in place is fine, and is part of the
  # transaction: rolled back with it.
  catch {
    db.transaction(@(tx) {
      tx.schema.alter_table('authors', @(table) {
        table.integer('born').nullable()
      })

      raise Error('undo')
    })
  } as _ignored {}

  assert !db.schema.column_names('authors').contains('born')

  db.close()
  echo 'test_inside_a_transaction passed'
}

def test_tables() {
  var db = fixture()

  assert raises(@() {
    db.schema.drop_table('authors')
  }, QueryError)

  assert db.count('books') == 2

  db.schema.rename_table('books', 'volumes')
  assert db.schema.has_table('volumes')
  assert !db.schema.has_table('books')

  db.schema.drop_table('volumes')
  db.schema.drop_table('volumes', { if_exists: true })
  db.schema.drop_table('authors')

  assert raises(@() {
    db.schema.drop_table('authors')
  }, QueryError)

  # Creating what exists is an error, unless asked not to be.
  db.schema.create_table('t', @(table) {
    table.id()
  })

  assert raises(@() {
    db.schema.create_table('t', @(table) {
      table.id()
    })
  }, QueryError)

  db.schema.create_table('t', @(table) {
    table.id()
    table.string('name', 10).unique()
  }, { if_not_exists: true })

  assert db.schema.column_names('t') == ['id']

  db.close()
  echo 'test_tables passed'
}

def test_values_round_trip() {
  var db = sql.open(':memory:')

  db.schema.create_table('kinds', @(table) {
    table.id()
    table.boolean('flag').default_value(true)
    table.json('doc').default_value({ a: 1 })
    table.decimal('money', 12, 2).default_value(sql.Decimal('0.10'))
    table.datetime('at').use_current()
    table.uuid('ref').nullable()
  })

  db.insert('kinds', { ref: '0b9e7b1e-3a4f-4c1e-9d2b-5f6a7b8c9d0e' })
  var row = db.fetch_one('select * from kinds', nil)

  assert row.flag == true
  assert row.doc == { a: 1 }
  assert instance_of(row.money, sql.Decimal)
  assert row.money.to_string() == '0.1'
  assert typeof(row.at) == 'Date'
  assert row.ref == '0b9e7b1e-3a4f-4c1e-9d2b-5f6a7b8c9d0e'

  # A database default and a program's own timestamp sort as times.
  var stamped = db.fetch_value("select cast(at as text) from kinds", nil, nil)
  assert stamped.length() == '2026-01-01T00:00:00.000000+00:00'.length()
  assert stamped.ends_with('+00:00')

  db.close()
  echo 'test_values_round_trip passed'
}

# What every engine does the same, run against a live server.
def portable(db) {
  var authors = 'zuri_bp_authors'
  var posts = 'zuri_bp_posts'

  db.schema.drop_table(posts, { if_exists: true })
  db.schema.drop_table('zuri_bp_articles', { if_exists: true })
  db.schema.drop_table(authors, { if_exists: true })

  db.schema.create_table(authors, @(table) {
    table.id()
    table.string('name', 80).exact().unique()
    table.timestamps()
  })

  db.schema.create_table(posts, @(table) {
    table.id()
    table.references('author_id', authors).on_delete('cascade')
    table.string('title', 200)
    table.text('body').nullable()
    table.boolean('published').default_value(false)
    table.json('tags').default_value([])
    table.decimal('price', 10, 2).default_value(0)
    table.string('note', 20).default_value("a\\b 'q'")
    table.timestamps()
    table.index(['published', 'created_at'])
  })

  db.schema.create_table(posts, @(table) {
    table.id()
  }, { if_not_exists: true })

  var ada = db.insert(authors, { name: 'Ada' })
  db.insert(authors, { name: 'ada' })
  db.insert(posts, { author_id: ada, title: 'On Engines' })

  var row = db.fetch_one('select * from ${posts}', nil)

  # MariaDB keeps JSON as text, and the capability says so.
  if db.supports('json') {
    assert row.tags == []
  } else {
    assert json.decode(row.tags) == []
  }

  assert instance_of(row.price, sql.Decimal)
  assert row.note == "a\\b 'q'"
  assert typeof(row.created_at) == 'Date'

  db.schema.alter_table(posts, @(table) {
    table.string('slug', 200).nullable().unique()
    table.string('title', 300).change()
    table.rename_column('body', 'content')
    table.drop_column('price')
    table.integer('views').default_value(0)
  })

  assert db.schema.column_names(posts) ==
      [
        'id',
        'author_id',
        'title',
        'content',
        'published',
        'tags',
        'note',
        'created_at',
        'updated_at',
        'slug',
        'views',
      ]

  var kept = db.fetch_one('select title, views from ${posts}', nil)

  assert kept.title == 'On Engines'
  assert kept.views == 0

  assert raises(@() {
    db.schema.alter_table(posts, @(table) {
      table.string('required', 10)
    })
  }, NotNullViolation)

  assert raises(@() {
    db.schema.drop_table(authors)
  }, QueryError)

  db.schema.alter_table(posts, @(table) {
    table.drop_foreign(['author_id'])
    table.drop_index(['published', 'created_at'])
    table.drop_unique(['slug'])
  })

  # What remains is the primary key's own index, under whatever name
  # the engine gives it.
  var left = db.schema
      .indexes(posts)
      .filter(@(index) => index.columns != ['id'])
      .map(@(index) => index.name)

  assert left.is_empty(), 'indexes left behind: ${left}'
  assert db.schema.foreign_keys(posts).is_empty()

  db.schema.rename_table(posts, 'zuri_bp_articles')
  db.schema.drop_table('zuri_bp_articles')
  db.schema.drop_table(authors)
}

def test_servers() {
  var servers = {
    ZURI_TEST_POSTGRES: 'postgres',
    ZURI_TEST_MYSQL: 'mysql',
    ZURI_TEST_MARIADB: 'mariadb',
  }

  for variable, label in servers {
    var dsn = os.get_env(variable, nil)

    if dsn == nil or dsn == '' {
      echo 'test_servers ${label} skipped: set ${variable} to a connection string'
      continue
    }

    var db = sql.open(dsn)

    if label != 'postgres' {
      db.exec_script('create database if not exists zuri_sql_blueprint')
      db.exec('use zuri_sql_blueprint', nil)
    }

    portable(db)

    if label != 'postgres' {
      db.exec_script('drop database if exists zuri_sql_blueprint')
    }

    db.close()
    echo 'test_servers ${label} passed'
  }
}

test_rendering()
test_literals()
test_descriptions()
test_index_names()
test_rebuild_keeps_everything()
test_rebuild_keeps_what_it_does_not_know()
test_alterations()
test_keys()
test_atomic()
test_inside_a_transaction()
test_tables()
test_values_round_trip()
test_servers()
