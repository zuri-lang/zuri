import csv
import io

def test_reader() {
  var data = "name,age,city\nJohn Doe,30,New York\nJane Smith,25,Los Angeles"
  var b = io.BytesIO(data.to_bytes())
  var r = csv.Reader(b)

  var row1 = r.read_record()
  assert row1 == ["name", "age", "city"]

  var row2 = r.read_record()
  assert row2 == ["John Doe", "30", "New York"]

  var row3 = r.read_record()
  assert row3 == ["Jane Smith", "25", "Los Angeles"]

  var row4 = r.read_record()
  assert row4 == nil
  echo "test_reader passed"
}

def test_reader_quoted() {
  var data = 'name,notes\n"Doe, John","Lives in ""New York"""'
  var b = io.BytesIO(data.to_bytes())
  var r = csv.Reader(b)

  var row1 = r.read_record()
  assert row1 == ["name", "notes"]

  var row2 = r.read_record()
  assert row2 == ["Doe, John", 'Lives in "New York"']
  echo "test_reader_quoted passed"
}

def test_reader_multiline() {
  var data = 'name,bio\nJohn,"Line 1\nLine 2"'
  var b = io.BytesIO(data.to_bytes())
  var r = csv.Reader(b)

  r.read_record() # skip header
  var row = r.read_record()
  assert row == ["John", "Line 1\nLine 2"]
  echo "test_reader_multiline passed"
}

def test_writer() {
  var b = io.BytesIO(bytes(0), "w+")
  var w = csv.Writer(b)
  w.write_row(["name", "age"])
  w.write_row(["John", 30])

  assert b.read().to_string().count('\n') == 2
  w.close()

  echo "test_writer passed"
}

def test_parse() {
  var data = "a,b,c\nd,e,f"
  var rows = csv.parse(data)
  assert rows == [["a", "b", "c"], ["d", "e", "f"]]
  echo "test_parse passed"
}

def test_sniff_dialect() {
  var comma = csv.sniff_dialect("a,b,c\n1,2,3\n4,5,6")
  assert comma.delimiter == ','

  var semicolon = csv.sniff_dialect("a;b;c\n1;2;3\n4;5;6")
  assert semicolon.delimiter == ';'

  var tab = csv.sniff_dialect("a\tb\tc\n1\t2\t3\n4\t5\t6")
  assert tab.delimiter == '\t'

  var pipe = csv.sniff_dialect("a|b|c\n1|2|3\n4|5|6")
  assert pipe.delimiter == '|'

  # No candidate delimiter appears consistently anywhere in this
  # sample, so sniff_dialect() must fall back to the first candidate
  # (a plain comma) rather than raise or pick one at random.
  var no_delimiter = csv.sniff_dialect("just one column\nanother line\nthird line")
  assert no_delimiter.delimiter == ','

  # The detected dialect must actually be usable for real parsing.
  var rows = csv.parse("a;b\n1;2", semicolon)
  assert rows == [["a", "b"], ["1", "2"]]

  echo "test_sniff_dialect passed"
}

test_reader()
test_reader_quoted()
test_reader_multiline()
test_writer()
test_parse()
test_sniff_dialect()
