/**
 * test_bcrypt.zu
 *
 * Test suite for the `bcrypt` standard library module: hash(),
 * compare(), get_rounds(), get_salt(), and needs_rehash().
 */

import bcrypt

var _passed = 0

def ok(label) {
  _passed++
  echo '  [PASS] ' + label
}

def raises(fn) {
  catch {
    fn()
    return false
  } as e
  return true
}

echo '═══════════════════════════════════════════════════════'
echo '  bcrypt module: test suite'
echo '═══════════════════════════════════════════════════════'

# ---------------------------------------------------------------------------
# Known-answer test: a fixed hash generated by Python's independent
# `bcrypt` library for the password "password", cross-checked by hand
# against this implementation before being pinned here.
# ---------------------------------------------------------------------------
var known_hash = '$2b$10$gJDTDLsvnXNm7hqktY85gOtWcOtGHNC0NUr1x7UbBq7D/bt4pXQZG'
assert bcrypt.compare('password', known_hash) == true,
  'compare() must accept the correct password against a known-good external hash'
assert bcrypt.compare('wrongpassword', known_hash) == false,
  'compare() must reject an incorrect password against the same hash'
ok('compare() matches a known-answer hash produced by an independent bcrypt implementation')

# ---------------------------------------------------------------------------
# hash() / compare() round trip
# ---------------------------------------------------------------------------
var h1 = bcrypt.hash('correct horse battery staple')
assert h1.length() == 60, 'hash() must produce a standard 60-character bcrypt string'
assert bcrypt.compare('correct horse battery staple', h1) == true,
  'compare() must accept the exact password hash() just produced'
assert bcrypt.compare('incorrect horse battery staple', h1) == false,
  'compare() must reject a similar but wrong password'
ok('hash() and compare() round-trip correctly')

var h2 = bcrypt.hash('correct horse battery staple')
assert h1 != h2, 'two hash() calls on the same password must produce different hashes (random salt)'
assert bcrypt.compare('correct horse battery staple', h2) == true,
  'the second hash must still verify correctly despite having a different salt'
ok('hash() generates a fresh random salt on every call')

# ---------------------------------------------------------------------------
# rounds parameter
# ---------------------------------------------------------------------------
assert bcrypt.get_rounds(bcrypt.hash('x')) == bcrypt.DEFAULT_LOG2_ROUNDS,
  'hash() with no rounds argument must use DEFAULT_LOG2_ROUNDS'
var h3 = bcrypt.hash('x', 4)
assert bcrypt.get_rounds(h3) == 4, 'hash() must honor an explicit rounds argument'
assert bcrypt.compare('x', h3) == true, 'a hash created with a non-default rounds value must still verify'
ok('hash() honors an explicit rounds parameter, defaulting to DEFAULT_LOG2_ROUNDS otherwise')

# ---------------------------------------------------------------------------
# get_rounds() / get_salt()
# ---------------------------------------------------------------------------
assert bcrypt.get_rounds(known_hash) == 10, 'get_rounds() must read the cost factor out of a hash'
assert bcrypt.get_salt(known_hash) == known_hash[,29],
  'get_salt() must return exactly the first 29 characters of the hash'
assert bcrypt.get_salt(known_hash).length() == 29, 'the salt portion of a bcrypt hash is always 29 characters'
ok('get_rounds()/get_salt() read metadata back out of an existing hash')

# ---------------------------------------------------------------------------
# needs_rehash()
# ---------------------------------------------------------------------------
var low_cost = bcrypt.hash('x', 4)
assert bcrypt.needs_rehash(low_cost, 10) == true,
  'needs_rehash() must be true when the stored cost factor is below the target'
assert bcrypt.needs_rehash(low_cost, 4) == false,
  'needs_rehash() must be false when the stored cost factor already meets the target'
assert bcrypt.needs_rehash(low_cost, 2) == false,
  'needs_rehash() must be false when the stored cost factor exceeds the target'
ok('needs_rehash() correctly compares a hash\'s cost factor against a target')

# ---------------------------------------------------------------------------
# malformed input
# ---------------------------------------------------------------------------
assert bcrypt.compare('anything', 'not-a-real-bcrypt-hash') == false,
  'compare() must return false (not raise) for a hash that is not well-formed'
assert raises(@() { bcrypt.get_salt('too-short') }),
  'get_salt() must raise for a hash shorter than a real bcrypt hash'
ok('malformed hashes are rejected without crashing the caller')

# ===========================================================================
# Final summary
# ===========================================================================
echo ''
echo '═══════════════════════════════════════════════════════'
echo '  All ${_passed} assertions passed.'
echo '═══════════════════════════════════════════════════════'
