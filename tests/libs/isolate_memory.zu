# Memory a program no longer uses goes back to the system: after a
# collection, from an isolate left waiting on a channel, and from the
# main thread while it waits. Each runs in a process of its own, since
# memory an earlier test freed would otherwise be reused and hide what
# this one makes. Resident memory is read from /proc, so the checks run
# on Linux and are skipped elsewhere.

import os
import zuri
import isolate

# This process's resident memory in MB, or nil where it cannot be read.
def _resident_mb() {
  if os.platform != 'linux' {
    return nil
  }

  for line in file('/proc/self/status').read().split('\n') {
    if line.starts_with('VmRSS:') {
      return line.split(':')[1].trim().split(' ')[0].to_number() / 1024
    }
  }

  return nil
}

# Makes a couple of hundred MB of records and lets them all go.
def _churn() {
  var held = []

  iter var i = 0; i < 800000; i++ {
    held.append({ name: 'item ${i}', kind: 'function', start: i, end: i + 5 })
  }

  return held.length()
}

# Waits on a channel long enough to count as idle while holding
# `count` records, so the collection that wait makes finds them all
# live. They are let go when this returns.
def _hold_while_waiting(count) {
  var held = []

  iter var i = 0; i < count; i++ {
    held.append({ name: 'held ${i}', start: i, end: i + 5 })
  }

  catch {
    isolate.channel().recv(1.5)
  } as timeout {
    return held.length()
  }
}

# Calls `wait` until resident memory falls to `limit`, for at most ten
# seconds.
def _falls_to(limit, wait) {
  var deadline = time() + 10

  while time() < deadline {
    if _resident_mb() <= limit {
      return true
    }

    wait()
  }

  return false
}

def test_a_collection_gives_freed_memory_back() {
  var before = _resident_mb()

  if before == nil {
    echo 'test_a_collection_gives_freed_memory_back skipped'
    return
  }

  _churn()

  var peak = _resident_mb()

  zuri.reflect.gc()

  var after = _resident_mb()

  assert peak - before > 100, 'the records must have taken real memory'
  assert after <= before + (peak - before) / 2,
      'memory a collection frees must be back with the system when gc() returns'
  echo 'test_a_collection_gives_freed_memory_back passed'
}

def test_an_isolate_waiting_on_a_channel_gives_its_garbage_back() {
  var before = _resident_mb()

  if before == nil {
    echo 'test_an_isolate_waiting_on_a_channel_gives_its_garbage_back skipped'
    return
  }

  var made = isolate.channel()
  var go = isolate.channel()
  var t = isolate.spawn(
    @(made, go, churn) {
      churn()
      made.send(true)
      go.recv()
      return true
    },
    made,
    go,
    _churn,
  )

  made.recv()

  var peak = _resident_mb()
  var fell = _falls_to(before + (peak - before) / 2, @() => os.sleep(0.25))

  go.send(true)
  t.join()

  assert peak - before > 100, 'the records must have taken real memory'
  assert fell, 'an isolate left waiting must give its garbage back'
  echo 'test_an_isolate_waiting_on_a_channel_gives_its_garbage_back passed'
}

def test_the_main_thread_gives_its_garbage_back_while_it_waits() {
  var before = _resident_mb()

  if before == nil {
    echo 'test_the_main_thread_gives_its_garbage_back_while_it_waits skipped'
    return
  }

  # Held across every wait below, so the collections the waits make
  # have to keep it, wherever it has moved to.
  var kept = [
    { name: 'kept', at: before },
    'held ${before}',
  ]

  _churn()

  var peak = _resident_mb()
  var quiet = isolate.channel()

  # Waits longer than a thread takes to count as idle.
  var wait = @() {
    catch {
      quiet.recv(1.5)
    } as timeout {
      return nil
    }
  }

  assert peak - before > 100, 'the records must have taken real memory'
  assert _falls_to(before + (peak - before) / 2, wait),
      'a waiting thread must give its garbage back'
  assert kept[0].name == 'kept' and
      kept[0].at == before and
      kept[1] == 'held ${before}',
      'what the program still holds must survive the collections'
  echo 'test_the_main_thread_gives_its_garbage_back_while_it_waits passed'
}

def test_a_thread_that_shrank_gives_back_again() {
  if _resident_mb() == nil {
    echo 'test_a_thread_that_shrank_gives_back_again skipped'
    return
  }

  # A wait made while a large set is live, then a collection that is not
  # a wait's, which shrinks the heap again, then less garbage than that
  # set was.
  _hold_while_waiting(1200000)
  zuri.reflect.gc()

  var before = _resident_mb()

  _churn()

  var peak = _resident_mb()
  var quiet = isolate.channel()
  var wait = @() {
    catch {
      quiet.recv(1.5)
    } as timeout {
      return nil
    }
  }

  assert peak - before > 100, 'the records must have taken real memory'
  assert _falls_to(before + (peak - before) / 2, wait),
      'a thread whose heap shrank must still give its garbage back'
  echo 'test_a_thread_that_shrank_gives_back_again passed'
}

test_a_collection_gives_freed_memory_back()
test_an_isolate_waiting_on_a_channel_gives_its_garbage_back()
test_the_main_thread_gives_its_garbage_back_while_it_waits()
test_a_thread_that_shrank_gives_back_again()
