/**
 * test_http_server.zu
 *
 * The `http` module end to end, over real sockets: routing, request
 * and response bodies, cookies, compression, redirects, streaming,
 * static files with conditional and range requests, limits,
 * middleware, a reverse proxy, WebSockets, and HTTP/2 over TLS.
 *
 * Every server runs in a spawned isolate (see `http_server_app.zu`)
 * so a client and a server can talk to each other inside one test
 * process, the same pattern `tests/libs/net_tls.zu` uses.
 */

import http
import http.sse
import http.websocket as ws

import isolate
import net
import os
import .http_server_app

# Sized before anything spawns, because the pool is fixed once it
# exists. This suite runs servers, worker pools and several concurrent
# clients at once; the default of one thread per core is not enough for
# that, and a starved pool shows up as a hang rather than an error.
isolate.configure(16)

var _passed = 0

def ok(label) {
  _passed++
  echo '  [PASS] ' + label
}

def raises(fn) {
  catch {
    fn()
    return false
  } as e
  return true
}

# Starts one of the app module's servers and hands back its address.
# The arguments are spelled out rather than gathered, since a call
# site cannot spread a list back into an argument position.
def start(fn, first, second) {
  var channel = isolate.channel(1)
  var task

  if second != nil {
    task = isolate.spawn(fn, channel, first, second)
  } else if first != nil {
    task = isolate.spawn(fn, channel, first)
  } else {
    task = isolate.spawn(fn, channel)
  }

  return [task, channel.recv()]
}

# Closes the client's pooled connections first: a server serving one
# connection at a time cannot accept the shutdown request while an
# idle keep-alive connection is still holding it.
# Sends a handcrafted request over a bare socket and reads until the
# server closes. Every request below asks for `Connection: close` so
# that read actually ends; anything the module's own client could
# send is already covered elsewhere, and these are exactly the
# malformed shapes it will not send.
def raw_exchange(address, text) {
  var socket = net.TcpStream()
  socket.connect(address)
  socket.set_read_timeout(4000)
  socket.write_all(text)

  var received = bytes(0)

  catch {
    while true {
      var chunk = socket.read(65536)

      if chunk.length() == 0 {
        break
      }

      received.extend(chunk)
    }
  }

  catch {
    socket.close()
  }

  return received.to_string()
}

def stop(task, base, client) {
  catch {
    client.close()
  }

  # The same client is reused for the shutdown request so that a TLS
  # server is still reached with the certificate authority it needs;
  # closing the pool above only dropped the idle connections.
  catch {
    client.get(base + '/quit')
  }

  catch {
    client.close()
  }

  catch {
    task.join(5000)
  }
}

