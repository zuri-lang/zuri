/**
 * test_os_process.zu
 *
 * Test suite for the `os` module's process functions: exec(), pid(),
 * ppid(), kill(), on_signal(), and spawn()/Process. These tests spawn
 * real Unix shell utilities (sh, echo, cat, grep) since that's the
 * only meaningful way to exercise a real subprocess boundary.
 */

import os

var _passed = 0

def ok(label) {
  _passed++
  echo '  [PASS] ' + label
}

# A child ends its last line with whatever terminator the platform
# uses, and Windows uses two characters where Unix uses one. trim()
# removes a single named character per call, so stripping a line ending
# portably takes one call for each.
def line(text) {
  return text.rtrim('\n').rtrim('\r')
}

echo '═══════════════════════════════════════════════════════'
echo '  os module: process test suite'
echo '═══════════════════════════════════════════════════════'

# ---------------------------------------------------------------------------
# pid() / ppid()
# ---------------------------------------------------------------------------
assert os.pid() > 0, 'pid() must return a positive process id'
assert os.pid() == os.pid(), 'pid() must be stable across calls within the same process'
ok('pid() returns a stable, positive process id')

assert os.ppid() >= 0, 'ppid() must return a non-negative value'
ok('ppid() returns a non-negative value')

# ---------------------------------------------------------------------------
# exec()
# ---------------------------------------------------------------------------
var result = os.exec('echo', 'hello from exec')
assert result.exit_code == 0, 'exec() of a successful command must report exit_code 0'
assert line(result.output) == 'hello from exec', 'exec() must capture the command\'s stdout'
ok('exec() runs a command and captures its exit code and output')

var failed = os.exec('exit', '7')
assert failed.exit_code == 7, 'exec() must report a non-zero exit code accurately'
ok('exec() reports a non-zero exit code for a failing command')

# ---------------------------------------------------------------------------
# spawn(): basic run to completion
# ---------------------------------------------------------------------------
var p1 = os.spawn('echo', ['spawned', 'output'])
assert line(p1.read_stdout().to_string()) == 'spawned output',
  'Process.read_stdout() must return what the child wrote to stdout'
assert p1.wait() == 0, 'Process.wait() must return the child\'s exit code'
ok('spawn() runs a command and read_stdout()/wait() report its output and exit code')

# ---------------------------------------------------------------------------
# spawn(): piped stdin
# ---------------------------------------------------------------------------
var p2 = os.spawn('cat', [], { stdin: 'pipe' })
p2.write_stdin('line one\nline two\n')
p2.close_stdin()
assert p2.read_stdout().to_string() == 'line one\nline two\n',
  'a piped child must echo back exactly what was written to its stdin'
assert p2.wait() == 0
ok('spawn() with stdin: \'pipe\' lets the caller write to the child and read its output')

# ---------------------------------------------------------------------------
# spawn(): separate stdout/stderr streams
# ---------------------------------------------------------------------------
var p3 = os.spawn('sh', ['-c', 'echo to-stdout; echo to-stderr 1>&2'])
var out3 = line(p3.read_stdout().to_string())
var err3 = line(p3.read_stderr().to_string())
p3.wait()
assert out3 == 'to-stdout', 'read_stdout() must not include anything written to stderr'
assert err3 == 'to-stderr', 'read_stderr() must not include anything written to stdout'
ok('spawn() keeps stdout and stderr as independent streams')

# ---------------------------------------------------------------------------
# spawn(): options: cwd and env
# ---------------------------------------------------------------------------
var scratch = os.create_temp_dir('zuri-os-process-')
var p4 = os.spawn('sh', ['-c', 'pwd'], { cwd: scratch })
var cwd_out = line(p4.read_stdout().to_string())
p4.wait()

# Both sides resolved before comparing. `pwd` in a child reports the
# physical directory, while `create_temp_dir()` returns whatever path it
# was given; on a platform whose temporary directory sits behind a
# symlink, the two spell the same directory differently.
assert os.real_path(cwd_out) == os.real_path(scratch),
  'spawn() with a cwd option must run the child in that directory'
ok('spawn() options.cwd changes the child\'s working directory')

var p5 = os.spawn('sh', ['-c', 'echo $ZURI_TEST_SPAWN_VAR'], { env: { ZURI_TEST_SPAWN_VAR: 'from-env-option' } })
var env_out = line(p5.read_stdout().to_string())
p5.wait()
assert env_out == 'from-env-option', 'spawn() with an env option must set that variable in the child'
ok('spawn() options.env sets an extra environment variable for the child')

os.remove_dir(scratch, true)

# ---------------------------------------------------------------------------
# spawn(): try_wait() and exit code for a still-running vs finished child
# ---------------------------------------------------------------------------
var p6 = os.spawn('sh', ['-c', 'sleep 0.2; exit 3'])
assert p6.try_wait() == nil, 'try_wait() must return nil for a child that has not exited yet'
assert p6.wait() == 3, 'wait() must block until the child exits and report its real exit code'
assert p6.try_wait() == 3, 'try_wait() after the child has exited must report the same exit code'
ok('try_wait() distinguishes a still-running child from a finished one')

# ---------------------------------------------------------------------------
# spawn(): kill()
# ---------------------------------------------------------------------------
var p7 = os.spawn('sh', ['-c', 'sleep 30'])
assert p7.try_wait() == nil, 'the sleep child must still be running right after spawn()'
p7.kill()
var killed_code = p7.wait()
assert killed_code != 0, 'a killed child must not report a clean (0) exit code'
ok('Process.kill() terminates a still-running child')

# ---------------------------------------------------------------------------
# kill(): free function against this process's own pid, with a
# harmless signal
# ---------------------------------------------------------------------------
assert os.kill(os.pid(), 0) == true,
  'kill() with signal 0 must succeed against this process\'s own pid without actually sending anything'
ok('kill() with signal 0 can probe that a process exists without disturbing it')

var probed = true

catch {
  # Above every pid either platform hands out, so nothing is behind it.
  os.kill(2147483646, 0)
} as e {
  probed = false
}

assert !probed, 'probing a pid that names no process must raise rather than report success'
ok('kill() with signal 0 reports a process that is not there')

# ---------------------------------------------------------------------------
# on_signal()
# ---------------------------------------------------------------------------
# Windows has no way to send a signal to a process id at all, so there
# is nothing to deliver here and nothing to wait for. Registering the
# handler still works there, and still gets checked.
if os.platform != 'windows' {
  var signaled = false

  # `return true` is what claims the signal. Without it the callback
  # declines, the signal falls through to its default action, and this
  # test process is killed by the `os.kill()` below.
  os.on_signal('INT', @() {
    signaled = true
    return true
  })
  os.kill(os.pid(), 2)

  var spins = 0
  while !signaled and spins < 50000000 {
    spins++
  }
  assert signaled, 'a registered on_signal() callback must run once the signal actually arrives'
  ok('on_signal() delivers a callback when the process receives the signal')
} else {
  assert os.on_signal('INT', @() { return true }) == true,
    'on_signal() must still register a handler on a platform that cannot deliver to a pid'
  ok('on_signal() registers a handler')
}

# ===========================================================================
# Final summary
# ===========================================================================
echo ''
echo '═══════════════════════════════════════════════════════'
echo '  All ${_passed} assertions passed.'
echo '═══════════════════════════════════════════════════════'
