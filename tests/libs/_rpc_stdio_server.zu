# A JSON-RPC server on its own standard streams, started as a child
# process by the rpc test suite.

import rpc

var server = rpc.endpoint(rpc.stdio())

server.on_request('echo', @(params) => params).on_request(
  'stop',
  @(params, context) {
    context.endpoint.stop()
    return 'stopping'
  },
).serve()
