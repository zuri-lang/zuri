/**
 * wire_expression.zu
 *
 * Test suite for Wire's expression language and its built-in filters:
 * literals, lookup, operators, truthiness, filters and the errors a
 * malformed expression raises.
 */

import wire

var _passed = 0

def ok(label) {
  _passed++
  echo '  [PASS] ' + label
}

def raises(fn) {
  var raised = false

  catch {
    fn()
  } as e {
    raised = true
  }

  return raised
}

var view = wire.wire()

def out(source, variables) {
  return view.render_string('<i>' + source + '</i>', variables, nil)[3, -4]
}

def value(source) {
  return out('{{ ' + source + ' }}', {
    name: 'Ada Lovelace',
    items: ['a', 'b', 'c'],
    user: { age: 36, address: { city: 'London' }, tags: [] },
    zero: 0,
    negative: -5,
    blank: '',
    yes: true,
    no: false,
  })
}

echo '═══════════════════════════════════════════════════════'
echo '  wire.expression: test suite'
echo '═══════════════════════════════════════════════════════'

# ---------------------------------------------------------------------------
# Literals
# ---------------------------------------------------------------------------
assert value('12') == '12', 'an integer literal'
assert value('1.5') == '1.5', 'a decimal literal'
assert value("'text'") == 'text', 'a single quoted string'
assert value('"text"') == 'text', 'a double quoted string'
assert value("'a\\'b'") == "a'b", 'an escaped quote inside a string'
assert value("'a\\nb'").length() == 3, 'a newline escape inside a string'
assert value('true') == 'true', 'the true literal'
assert value('false') == 'false', 'the false literal'
assert value('nil') == '', 'nil renders as nothing at all'
ok('literals')

# ---------------------------------------------------------------------------
# Lookup
# ---------------------------------------------------------------------------
assert value('name') == 'Ada Lovelace', 'a bare name'
assert value('user.age') == '36', 'a dotted lookup'
assert value('user.address.city') == 'London', 'a nested dotted lookup'
assert value('items.0') == 'a', 'a numeric key reads a list position'
assert value('items[1]') == 'b', 'a bracketed lookup'
assert value('items[-1]') == 'c', 'a negative position counts from the end'
assert value('items.length') == '3', 'a collection answers length by name'
assert value('missing') == '', 'a name that was never supplied is nothing'
assert value('missing.deeply.nested') == '',
  'a chain through a missing name stops quietly instead of raising'
assert value('items[99]') == '', 'a position past the end is nothing, not an error'
ok('lookup, including the chains that go nowhere')

assert raises(@() { value('user._secret') }),
  'an underscore-prefixed member cannot be read'
assert raises(@() { value('_hidden') }),
  'an underscore-prefixed name cannot be read'
ok('private names are refused')

# ---------------------------------------------------------------------------
# Arithmetic and comparison
# ---------------------------------------------------------------------------
assert value('2 + 3') == '5', 'addition'
assert value('7 - 2') == '5', 'subtraction'
assert value('3 * 4') == '12', 'multiplication'
assert value('10 / 4') == '2.5', 'division'
assert value('10 % 3') == '1', 'remainder'
assert value('-negative') == '5', 'negation'
assert value('2 + 3 * 4') == '14', 'multiplication binds tighter than addition'
assert value('(2 + 3) * 4') == '20', 'parentheses override precedence'
assert value("'a' + 'b'") == 'ab', 'a string on either side concatenates'
assert value("'n=' + 12") == 'n=12', 'concatenation reaches across types'
ok('arithmetic')

assert value('1 == 1') == 'true', 'equality'
assert value('1 != 2') == 'true', 'inequality'
assert value('1 < 2') == 'true', 'less than'
assert value('2 <= 2') == 'true', 'less than or equal'
assert value('3 > 2') == 'true', 'greater than'
assert value('3 >= 4') == 'false', 'greater than or equal'
assert value("'a' < 'b'") == 'true', 'strings order by code point'
assert value("'b' < 'a'") == 'false', 'and in the other direction'
ok('comparison, for numbers and for strings')

assert value("'a' in items") == 'true', 'in finds a list entry'
assert value("'z' in items") == 'false', 'in misses what is not there'
assert value("'z' not in items") == 'true', 'not in is the inverse'
assert value("'Ada' in name") == 'true', 'in finds a substring'
assert value("'age' in user") == 'true', 'in finds a dictionary key'
ok('the in operator')

assert raises(@() { value("'a' * 2") }), 'arithmetic on a string is refused'
assert raises(@() { value('1 / 0') }), 'division by zero is refused'
assert raises(@() { value('items < 3') }), 'ordering a list against a number is refused'
ok('operators refuse what they cannot answer')

# ---------------------------------------------------------------------------
# Truthiness
# ---------------------------------------------------------------------------
assert value('zero ? 1 : 2') == '2', 'zero is false'
assert value('negative ? 1 : 2') == '1',
  'a negative number is true, unlike in Zuri itself'
assert value('blank ? 1 : 2') == '2', 'an empty string is false'
assert value('user.tags ? 1 : 2') == '2',
  'an empty list is false, unlike in Zuri itself'
assert value('items ? 1 : 2') == '1', 'a list with entries is true'
assert value('missing ? 1 : 2') == '2', 'a missing name is false'
assert value('not missing') == 'true', 'not on a missing name'
assert value('!zero') == 'true', '! is the same as not'
ok('Wire truthiness, where it differs from Zuri and where it does not')

assert value('yes and no') == 'false', 'and'
assert value('no or yes') == 'true', 'or'
assert value('yes && yes') == 'true', '&& is the same as and'
assert value('no || no') == 'false', '|| is the same as or'
assert value("missing or 'fallback'") == 'fallback', 'or falls back on a falsy value'
assert value("zero or 'fallback'") == 'fallback', 'or falls back on zero too'
assert value("missing ?? 'fallback'") == 'fallback', '?? falls back on nil'
assert value("zero ?? 'fallback'") == '0', '?? keeps a zero, which is the point of it'
ok('logical operators, and the difference between or and ??')

# ---------------------------------------------------------------------------
# Collections and calls
# ---------------------------------------------------------------------------
assert value('[1, 2, 3]|length') == '3', 'a list literal'
assert value('[1, 2, 3,]|length') == '3', 'a trailing comma is allowed'
assert value("{ a: 1, b: 2 }|length") == '2', 'a dictionary literal'
assert out('{{ { name }|json }}', { name: 'Ada' }) == '{"name":"Ada"}',
  'the bare name shorthand in a dictionary literal'
assert value("{ 'quoted': 1 }|keys|first") == 'quoted', 'a quoted key'
ok('list and dictionary literals')

view.register_global('shout', @(text) {
  return text.upper() + '!'
})

view.register_global('stamp', @() { return 'v1' })

assert out("{{ shout('hi') }}", nil) == 'HI!', 'a registered function is callable'
assert out('{! stamp !}', nil) == 'v1', '{! name !} calls a function with no arguments'
assert out('%{! stamp !}', nil) == '{! stamp !}', 'a call can be escaped with %'
assert raises(@() { out('{{ name() }}', { name: 'Ada' }) }),
  'calling something that is not callable is refused'
ok('function calls, in both spellings')

# ---------------------------------------------------------------------------
# Filters
# ---------------------------------------------------------------------------
assert value('name|upper') == 'ADA LOVELACE', 'a filter'
assert value('name|upper|lower') == 'ada lovelace', 'filters chain'
assert value("name|is='Ada Lovelace'") == 'true', 'the = shorthand for one argument'
assert value("items|join('-')") == 'a-b-c', 'a filter with a parenthesised argument'
assert value('items|length > 2') == 'true',
  'a filter binds tighter than a comparison'
assert value('1.5|round(0)') == '2', 'a filter taking a number'
assert raises(@() { value('name|nope') }), 'an unknown filter is refused'
ok('filter application')

assert out('{{ v|upper }}', { v: 'a' }) == 'A', 'upper'
assert out('{{ v|lower }}', { v: 'A' }) == 'a', 'lower'
assert out('{{ v|title }}', { v: 'jane IS here' }) == 'Jane Is Here', 'title'
assert out('{{ v|capitalize }}', { v: 'hello THERE' }) == 'Hello THERE', 'capitalize'
assert out('{{ v|trim }}', { v: '  a\n ' }) == 'a', 'trim removes every kind of whitespace'
assert out('{{ v|truncate(3) }}', { v: 'abcdef' }) == 'abc…', 'truncate'
assert out('{{ v|truncate(3, "!") }}', { v: 'abcdef' }) == 'abc!', 'truncate with a suffix'
assert out('{{ v|truncate(9) }}', { v: 'abcdef' }) == 'abcdef',
  'truncate leaves a short value alone, suffix and all'
assert out('{{ v|replace("a", "z") }}', { v: 'aba' }) == 'zbz', 'replace'
assert out('{{ v|replace(".") }}', { v: 'a.b' }) == 'ab', 'replace with no replacement strips'
assert out('{{ v|lpad(4, ".") }}', { v: 'a' }) == '...a', 'lpad'
assert out('{{ v|rpad(4, ".") }}', { v: 'a' }) == 'a...', 'rpad'
assert out('{{ v|repeat(3) }}', { v: 'ab' }) == 'ababab', 'repeat'
assert out('{{ v|slug }}', { v: 'Hello, World! 12' }) == 'hello-world-12', 'slug'
assert out('{{ v|strip_tags }}', { v: '<p title="a>b">x<b>y</b></p>' }) == 'xy',
  'strip_tags really parses rather than pattern-matching'
ok('the text filters')

assert out('{{ v|abs }}', { v: -3 }) == '3', 'abs'
assert out('{{ v|round(2) }}', { v: 2.567 }) == '2.57', 'round to places'
assert out('{{ v|floor }}', { v: 2.9 }) == '2', 'floor'
assert out('{{ v|ceil }}', { v: 2.1 }) == '3', 'ceil'
assert out('{{ v|number_format(2) }}', { v: 1234567.891 }) == '1,234,567.89',
  'number_format groups and fixes the decimals'
assert out('{{ v|number_format(2, ",", ".") }}', { v: 1234.5 }) == '1.234,50',
  'number_format takes the separators the other way round'
assert out('{{ v|number_format(0) }}', { v: -1234 }) == '-1,234',
  'number_format keeps the sign'
assert out('{{ v|filesize }}', { v: 512 }) == '512 B', 'filesize below a kilobyte'
assert out('{{ v|filesize }}', { v: 1400000 }) == '1.4 MB', 'filesize in decimal units'
assert out('{{ v|filesize(true) }}', { v: 1400000 }) == '1.3 MiB',
  'filesize in binary units'
ok('the number filters')

assert out('{{ v|length }}', { v: [1, 2] }) == '2', 'length of a list'
assert out('{{ v|length }}', { v: nil }) == '0', 'length of nothing is zero'
assert out('{{ v|first }}', { v: [1, 2] }) == '1', 'first'
assert out('{{ v|last }}', { v: [1, 2] }) == '2', 'last'
assert out('{{ v|first }}', { v: [] }) == '', 'first of an empty list is nothing'
assert out('{{ v|join(",") }}', { v: [1, 2] }) == '1,2', 'join'
assert out('{{ v|sort|join(",") }}', { v: [3, 1, 2] }) == '1,2,3', 'sort'
assert out('{{ v|sort("n")|first|json }}', { v: [{ n: 'b' }, { n: 'a' }] }) ==
  '{"n":"a"}', 'sort by a key'
assert out('{{ v|reverse|join(",") }}', { v: [1, 2] }) == '2,1', 'reverse a list'
assert out('{{ v|reverse }}', { v: 'abc' }) == 'cba', 'reverse a string'
assert out('{{ v|unique|join(",") }}', { v: [1, 1, 2] }) == '1,2', 'unique'
assert out('{{ v|keys|join(",") }}', { v: { a: 1, b: 2 } }) == 'a,b', 'keys'
assert out('{{ v|values|join(",") }}', { v: { a: 1, b: 2 } }) == '1,2', 'values'
assert out('{{ v|slice(1, 3)|join(",") }}', { v: [1, 2, 3, 4] }) == '2,3', 'slice'
assert out('{{ v|slice(-2)|join(",") }}', { v: [1, 2, 3, 4] }) == '3,4',
  'slice from a negative position'
assert out('{{ v|slice(1, 3) }}', { v: 'abcdef' }) == 'bc', 'slice a string'
assert out('{{ v|sum }}', { v: [1, 2, 3] }) == '6', 'sum'
assert out('{{ v|sum("p") }}', { v: [{ p: 1 }, { p: 2 }] }) == '3', 'sum by a key'
assert out('{{ v|split|length }}', { v: 'a  b c' }) == '3', 'split on whitespace'
assert out('{{ v|split(",")|length }}', { v: 'a,b' }) == '2', 'split on a separator'
ok('the collection filters')

assert out('{{ v|default("x") }}', { v: nil }) == 'x', 'default on nil'
assert out('{{ v|default("x") }}', { v: 0 }) == 'x', 'default on zero'
assert out('{{ v|default("x") }}', { v: -1 }) == '-1',
  'default keeps a negative number, which is not falsy in Wire'
assert out('{{ v|alt("x") }}', { v: '' }) == 'x', 'alt is the older name for default'
assert out('{{ v|empty }}', { v: [] }) == 'true', 'empty on a list'
assert out('{{ v|empty }}', { v: 0 }) == 'false',
  'a number is never empty, however falsy it is'
assert out('{{ v|is(2) }}', { v: 2 }) == 'true', 'is'
assert out('{{ v|not(2) }}', { v: 3 }) == 'true', 'not'
ok('the choice filters')

assert out('{{ v|date("Y-m-d") }}', { v: 0 }) == '1970-01-01',
  'date reads a Unix timestamp'
assert out('{{ v|date("Y") }}', { v: '2026-03-04' }) == '2026', 'date parses a string'
ok('the date filter')

assert raises(@() { out('{{ v|abs }}', { v: 'text' }) }),
  'a filter given the wrong type raises'
assert raises(@() { out('{{ v|truncate }}', { v: 'text' }) }),
  'a filter missing a required argument raises'
ok('filters report what they cannot do')

# ---------------------------------------------------------------------------
# Syntax errors
# ---------------------------------------------------------------------------
assert raises(@() { out('{{ }}', nil) }), 'an empty interpolation is refused'
assert raises(@() { out('{{ 1 + }}', nil) }), 'a dangling operator is refused'
assert raises(@() { out('{{ (1 }}', nil) }), 'an unclosed parenthesis is refused'
assert raises(@() { out("{{ 'a }}", nil) }), 'an unterminated string is refused'
assert raises(@() { out('{{ a', nil) }), 'an unclosed interpolation is refused'
assert raises(@() { out('{{ and }}', nil) }), 'a keyword used as a name is refused'
assert raises(@() { out('{{ a. }}', nil) }), 'a dot with nothing after it is refused'
assert raises(@() { out('{{ a | }}', nil) }), 'a pipe with no filter is refused'
ok('malformed expressions are refused at compile time')

# ---------------------------------------------------------------------------
# The scanner's tricky cases
# ---------------------------------------------------------------------------
assert out("{{ 'a}}b' }}", nil) == 'a}}b',
  'a closing delimiter inside a string does not end the interpolation'
assert out('{{ { a: { b: 2 } }|json }}', nil) == '{"a":{"b":2}}',
  'nested braces do not end the interpolation early'
assert out("{{ '(' + ')' }}", nil) == '()', 'brackets inside strings are not counted'
assert out('%{{ name }}', nil) == '{{ name }}', 'an interpolation can be escaped with %'
assert out('100% {{ v }}', { v: 'sure' }) == '100% sure',
  'a percent that is not escaping anything is just a percent'
ok('the interpolation scanner handles quoting and nesting')

echo ''
echo '═══════════════════════════════════════════════════════'
echo '  All ${_passed} expression checks passed.'
echo '═══════════════════════════════════════════════════════'
