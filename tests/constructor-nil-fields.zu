/* Constructors that set fields to nil alongside copying their
 * parameters. Built in a hot loop, so compiled code makes the instances,
 * and each field has to read back what the constructor left there: nil
 * where it said nil, even over a literal default, and the parameter
 * wherever a parameter was written last.
 */

class Node {
  @new(value, left) {
    self.hash = nil
    self.value = value
    self.left = left
  }
}

class Defaulted {
  var hash = 7

  @new(v) {
    self.hash = nil
    self.v = v
  }
}

class Twice {
  @new(v) {
    self.v = nil
    self.v = v
  }
}

class After {
  @new(v) {
    self.v = v
    self.w = nil
  }
}

var nodes = 0, defaulted = 0, twice = 0, after = 0
var last = nil

iter var i = 0; i < 20000; i++ {
  var n = Node(i, last)
  if n.hash == nil and n.value == i and n.left == last {
    nodes++
  }
  n.hash = i * 2
  last = n

  var d = Defaulted(i)
  if d.hash == nil and d.v == i {
    defaulted++
  }

  var t = Twice(i)
  if t.v == i {
    twice++
  }

  var a = After(i)
  if a.v == i and a.w == nil {
    after++
  }
}

echo nodes
echo defaulted
echo twice
echo after
echo last.hash
echo last.left.hash

# The same constructions inside a function, compiled on its own.
def build(depth) {
  if depth == 0 {
    return Node(1, nil)
  }
  return Node(depth, build(depth - 1))
}

def pair(i) {
  return [After(i), Node(i, nil)]
}

var built = 0
iter var i = 0; i < 3000; i++ {
  var n = build(12)
  var p = pair(i)
  if n.value == 12
    and n.left.value == 11
    and n.left.hash == nil
    and p[0].v == i
    and p[0].w == nil
    and p[1].hash == nil {
    built++
  }
}
echo built
