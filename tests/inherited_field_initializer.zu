/**
 * A base class's field initializer runs against subclass instances,
 * never only its own, so nothing compiled for it may assume a single
 * receiver class. Every field below is written by `Shape`'s
 * initializer and then read back through an instance of some subclass,
 * over enough rounds to get both the initializer and the constructors
 * well past the tier-up threshold.
 */

import .inherited_field_initializer_kinds { make_all }

var rounds = 40000

# A live instance parked in a global is what gets `sides` recognised as
# a numeric field, which is in turn what makes the initializer compile
# its speculating body at all. Without one the interesting path never
# gets built and the fixture quietly covers nothing.
var anchor = make_all()[2]

var expected_kinds = ['dot', 'line', 'tri', 'quad', 'penta', 'hexa']
var expected_sides = [0, 1, 3, 4, 5, 6]

var total_sides = 0
var checked = 0

iter var round = 0; round < rounds; round++ {
  var shapes = make_all()

  iter var i = 0; i < shapes.length(); i++ {
    var shape = shapes[i]

    if shape.kind != expected_kinds[i] {
      raise Error('round ${round}: kind ${shape.kind}, expected ${expected_kinds[i]}')
    }

    if shape.sides != expected_sides[i] {
      raise Error('round ${round}: ${shape.kind} sides ${shape.sides}, expected ${expected_sides[i]}')
    }

    if shape.describe() != '${expected_kinds[i]}/${expected_sides[i]}' {
      raise Error('round ${round}: describe() gave ${shape.describe()}')
    }

    # Each instance owns the dictionary its initializer built for it,
    # so a sibling's write must never be visible here.
    if shape.meta.length() != 0 {
      raise Error('round ${round}: ${shape.kind} started with meta ${shape.meta}')
    }

    shape.meta.set('round', round)
    total_sides += shape.sides
    checked++
  }
}

if total_sides != 19 * rounds {
  raise Error('total sides ${total_sides}, expected ${19 * rounds}')
}

if checked != 6 * rounds {
  raise Error('checked ${checked} shapes, expected ${6 * rounds}')
}

# The subclasses that declare fields of their own run two initializers,
# the base's and their own; both sets of slots have to survive that.
var shapes = make_all()

if shapes[1].length != 2 or shapes[1].sides != 1 or shapes[1].kind != 'line' {
  raise Error('Line: ${shapes[1].kind} ${shapes[1].sides} ${shapes[1].length}')
}

if shapes[3].corners != [1] or shapes[3].sides != 4 or shapes[3].kind != 'quad' {
  raise Error('Quad: ${shapes[3].kind} ${shapes[3].sides} ${shapes[3].corners}')
}

if shapes[5].label != 'six' or shapes[5].sides != 6 or shapes[5].kind != 'hexa' {
  raise Error('Hexa: ${shapes[5].kind} ${shapes[5].sides} ${shapes[5].label}')
}

if anchor.describe() != 'tri/3' {
  raise Error('anchor: ${anchor.describe()}')
}

echo 'inherited field initializer: ${checked} instances checked over ${rounds} rounds'
