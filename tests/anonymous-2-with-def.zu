var test = def (a) {
  echo a
}
test('It works!')

var test_compat = def (a) {
  echo a
}
test_compat('It works still!')

def main() {
  var g = 'Coke'
  echo g

  var concat = def {
    g += ' is the best'
  }
  concat()
  echo g

  var concat_compat = def {
    g += ' still!'
  }
  concat_compat()
  echo g
}

main()
