class Box {
  @new(n) {
    self.n = n
  }
}

var d = {}
var keys = []
# Raised so the loop outlasts the background compile; at the old count
# the script exited before the compiled entry was ever installed.
var n = 200000

iter var i = 0; i < n; i++ {
  var k = Box(i)
  keys.append(k)
  d[k] = i * 2
}

var errors = 0
iter var i = 0; i < n; i++ {
  var k = keys[i]
  if d[k] != i * 2 {
    errors += 1
  }
}

echo 'errors: ${errors}'
