/**
 * @module channel
 *
 * Thread-safe queues for passing values between coroutines. Re-exported
 * by `coroutine`, so `import coroutine` alone is enough to use
 * `coroutine.Channel`/`coroutine.channel()`.
 */

import _coroutine
import .error { CoroutineError, CoroutineTimeoutError }

/**
 * A thread-safe queue for passing values between coroutines.
 */
class Channel {
  var _ptr

  /**
   * @param ?int capacity: maximum number of unread messages before
   *   `send()` blocks. `nil` or `0` (the default) means unbounded.
   */
  @new(capacity: ?int) {
    if capacity == nil {
      capacity = 0
    }
    if capacity < 0 {
      raise ValueError('Channel() expects capacity to be non-negative, got ${capacity}')
    }
    self._ptr = _coroutine.channel_new(capacity)
  }

  /**
   * Sends `value` on the channel, blocking while it is at capacity.
   *
   * @param any value
   * @param number timeout: seconds to wait before giving up. Waits
   *   indefinitely if omitted.
   * @raises CoroutineError if the channel is closed
   * @raises CoroutineTimeoutError if `timeout` elapses first
   */
  send(value, timeout: ?number) {
    var status = _coroutine.channel_send(self._ptr, value, timeout)
    if status == 'closed' {
      raise CoroutineError('cannot send on a closed channel')
    }
    if status == 'timeout' {
      raise CoroutineTimeoutError('send() timed out after ${timeout} seconds')
    }
  }

  /**
   * Blocks until a value is available and returns it. Returns `nil`
   * once the channel is closed and empty.
   *
   * @param number timeout: seconds to wait before giving up. Waits
   *   indefinitely if omitted.
   * @returns any
   * @raises CoroutineTimeoutError if `timeout` elapses first
   */
  recv(timeout: ?number) {
    var r = _coroutine.channel_recv(self._ptr, timeout)
    if r[0] == 'closed' {
      return nil
    }
    if r[0] == 'timeout' {
      raise CoroutineTimeoutError('recv() timed out after ${timeout} seconds')
    }
    return r[1]
  }

  /**
   * Returns the next available value, or `nil` if none is available.
   * Does not block.
   *
   * @returns any
   */
  try_recv() {
    var r = _coroutine.channel_try_recv(self._ptr)
    if r[0] == 'ok' {
      return r[1]
    }
    return nil
  }

  /**
   * Closes the channel. Queued values may still be received;
   * `send()` afterward raises `CoroutineError`.
   */
  close() {
    _coroutine.channel_close(self._ptr)
  }

  /**
   * @returns bool: `true` if the channel is closed.
   */
  is_closed() {
    return _coroutine.channel_is_closed(self._ptr)
  }

  /**
   * @returns int: the number of values currently queued.
   */
  len() {
    return _coroutine.channel_len(self._ptr)
  }

  /**
   * This channel's underlying native handle, needed by `select()` to
   * operate on a plain list of `Channel`s from outside the class. Not
   * meant for direct use.
   */
  handle() {
    return self._ptr
  }
}

/**
 * @param ?int capacity: `nil` or `0` (the default) means unbounded.
 * @returns Channel
 */
def channel(capacity: ?int) {
  return Channel(capacity)
}

/**
 * Blocks until at least one of `channels` has a value ready to
 * receive or is closed, and returns which one and what it yielded --
 * the returned value has already been removed from that channel's
 * queue, exactly as if `recv()` had been called on it directly.
 *
 * Ties (more than one channel already ready) resolve to whichever
 * comes first in `channels`.
 *
 * @param [Channel] channels: must not be empty.
 * @param number timeout: seconds to wait before giving up. Waits
 *   indefinitely if omitted.
 * @returns [Channel, any]: the channel that was ready, and the value
 *   received from it (`nil` if that channel was closed and empty).
 * @raises ValueError if `channels` is empty
 * @raises CoroutineTimeoutError if `timeout` elapses before any
 *   channel is ready
 */
def select(channels: list, timeout: ?number) {
  if channels.length() == 0 {
    raise ValueError('select() expects at least one channel')
  }
  var ptrs = []
  for c in channels {
    ptrs.append(c.handle())
  }
  var r = _coroutine.select(ptrs, timeout)
  if r[1] == 'timeout' {
    raise CoroutineTimeoutError('select() timed out after ${timeout} seconds')
  }
  return [channels[r[0]], r[2]]
}
