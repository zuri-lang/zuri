/**
 * @module error
 *
 * `CoroutineError`, kept in its own leaf module (no imports of its
 * own) so both `index` and `channel` can depend on it without a
 * circular import between them. Re-exported by `coroutine`.
 */

/**
 * Raised when a coroutine's function raises an uncaught exception, a
 * `Channel` operation fails, or a value cannot cross a coroutine
 * boundary.
 */
class CoroutineError < Error {
  @new(message) {
    self.message = message or self.message
    self.type = 'CoroutineError'
  }
}

/**
 * Raised when `Coroutine.join()`, `Channel.send()`, or `Channel.recv()`
 * is given a `timeout` and it elapses before the operation completes.
 */
class CoroutineTimeoutError < CoroutineError {
  @new(message) {
    self.message = message or self.message
    self.type = 'CoroutineTimeoutError'
  }
}

/**
 * Raised from `Coroutine.join()`, `Channel.send()`, `Channel.recv()`,
 * `coroutine.wait_any()`, `coroutine.wait_all()`, or `coroutine.select()`
 * when the CALLING coroutine -- the one blocked in that call, not
 * whatever it was waiting on -- is `cancel()`ed while still waiting.
 */
class CoroutineCancelledError < CoroutineError {
  @new(message) {
    self.message = message or self.message
    self.type = 'CoroutineCancelledError'
  }
}
