/**
 * @module animation
 *
 * `Animation`, an ordered list of frames with a delay for each one.
 * It's what an animated GIF or WebP is decoded to and encoded from.
 *
 * Each frame is a complete image, not a difference from the frame
 * before it, so each frame can be edited by itself, and the encoder
 * works out what actually changed.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

#!-- part of the imagine module

import _imagine

import .errors { DecodeError, EncodeError, ImageError }
import .formats
import .image { Image }

/**
 * A sequence of images with a delay after each one, read from or
 * written to an animated format.
 *
 * Each frame is a whole image, already composited over the frames
 * before it, so you can take frame 5 and use it by itself without
 * replaying the first four. That's what you want almost every time, and
 * it's why the disposal and transparency rules that animated GIFs are
 * built on never show up here.
 *
 * ```zuri
 * import imagine { Animation }
 *
 * var animation = Animation.open('loading.gif')
 *
 * echo '${animation.length()} frames, ${animation.duration()}ms total'
 *
 * animation
 *   .map(@(frame) {
 *     return frame.grayscale()
 *   })
 *   .save('loading-grey.gif')
 * ```
 *
 * ## Reading and writing
 *
 * Animated GIF and animated WebP can both be read, but only GIF can be
 * written. Saving an animation as WebP raises an `EncodeError` instead
 * of silently writing a single frame. [[imagine.capabilities]] lists
 * what's available under `animated`.
 *
 * ## Memory
 *
 * Every frame is a whole image, so a 100-frame animation of 500x500
 * pixels takes 100 MB once it's decoded. For a large animation, it's
 * worth processing one frame at a time, which `frames()` lets you do by
 * returning the list itself.
 *
 * @printable
 */
class Animation {

  var _frames
  var _delays
  var _repeat
  var _format

  /**
   * Creates an animation from a list of images.
   *
   * Every frame must be the same size, because animated formats have a
   * single canvas that each frame is drawn on.
   *
   * @param list frames: a list of [[imagine.Image]]
   * @param ?number|list delay: the delay after each frame in
   *    milliseconds, either one number for every frame or one for each
   *    frame. Defaults to 100.
   * @param ?number repeat: how many times to loop, or 0 to loop
   *    forever. Defaults to 0.
   * @param ?string format: the format the frames were decoded from,
   *    kept as metadata. Defaults to nil.
   * @throws ImageError when the frames aren't all images of the same
   *    size.
   */
  @new(frames: list, delay, repeat, format) {
    if frames.length() == 0 {
      raise ImageError('an animation needs at least one frame')
    }

    var width = nil
    var height = nil

    for frame in frames {
      if !is_instance(frame) or !instance_of(frame, Image) {
        raise ImageError('every frame must be an Image, got ${typeof(frame)}')
      }

      if width == nil {
        width = frame.width()
        height = frame.height()
      } else if frame.width() != width or frame.height() != height {
        raise ImageError(
          'every frame must be the same size; found ${frame.width()}x${frame.height()} ' +
              'among ${width}x${height} frames',
        )
      }
    }

    self._frames = frames
    self._delays = _expand_delays(delay, frames.length())
    self._repeat = repeat == nil ? 0 : repeat
    self._format = format
  }

  /**
   * Opens an animated image file.
   *
   * A still image opens as an animation with one frame, not as an
   * error, so code that handles both doesn't need to check which it
   * has.
   *
   * @param string|file source
   * @returns Animation
   * @throws DecodeError when the file isn't an image that can be read.
   */
  static open(source) {
    var handle = source

    if is_string(source) {
      handle = file(source, 'rb')
    }

    if !is_file(handle) {
      raise ImageError('expected a path or a file, ${typeof(source)} given')
    }

    if !handle.exists() {
      raise DecodeError("no such file: '${handle.path()}'")
    }

    return Animation.decode(handle.read())
  }

  /**
   * Decodes animated image data held in memory.
   *
   * @param bytes data
   * @returns Animation
   * @throws DecodeError When the data is not a readable image.
   */
  static decode(data: bytes) {
    var kind = formats.detect(data)

    if kind == nil {
      raise DecodeError('not a recognisable image')
    }

    # A still image is a perfectly good one-frame animation, and
    # treating it as one saves every caller a branch.
    if !formats.animatable().contains(kind) {
      return Animation([Image.decode(data)], 100, 0)
    }

    var decoded = nil

    catch {
      decoded = _imagine.decode_frames(data, kind)
    } as e {
      raise DecodeError(e.message)
    }

    var frames = []
    var delays = []

    for entry in decoded {
      frames.append(Image.from_pixels(entry.width, entry.height, entry.pixels))
      delays.append(entry.delay)
    }

    return Animation(frames, delays, 0, kind)
  }

  /**
   * How many frames the animation has.
   *
   * @returns number
   */
  length() {
    return self._frames.length()
  }

  /**
   * The frames, as a list of [[imagine.Image]].
   *
   * This is the list itself, not a copy, so changing an image in it
   * changes the animation. That's what lets you edit frames one at a
   * time without copying everything. Use `map()` when you want to leave
   * the original unchanged.
   *
   * @returns list
   */
  frames() {
    return self._frames
  }

  /**
   * One frame by index, counting from zero.
   *
   * @param number index
   * @returns Image
   * @throws ImageError When there is no such frame.
   */
  frame(index: number) {
    if index < 0 or index >= self._frames.length() {
      raise ImageError(
        'no frame ${index}; the animation has ${self._frames.length()}',
      )
    }

    return self._frames[index.floor()]
  }

  /**
   * The per-frame delays in milliseconds.
   *
   * @returns list
   */
  delays() {
    return self._delays
  }

  /**
   * How long one pass through the animation takes, in milliseconds.
   *
   * @returns number
   */
  duration() {
    var total = 0

    for delay in self._delays {
      total += delay
    }

    return total
  }

  /**
   * The frames' shared width in pixels.
   *
   * @returns number
   */
  width() {
    return self._frames[0].width()
  }

  /**
   * The frames' shared height in pixels.
   *
   * @returns number
   */
  height() {
    return self._frames[0].height()
  }

  /**
   * The format this animation was decoded from, or `nil`.
   *
   * @returns ?string
   */
  format() {
    return self._format
  }

  /**
   * Sets how many times the animation loops when written out.
   *
   * @param number times: 0 loops forever.
   * @returns self
   */
  repeat(times: number) {
    if times < 0 {
      raise ImageError('repeat count must not be negative, got ${times}')
    }

    self._repeat = times.floor()
    return self
  }

  /**
   * Sets the delay between frames.
   *
   * @param number|list delay: One value for every frame, or one per
   *    frame.
   * @returns self
   */
  delay(delay) {
    self._delays = _expand_delays(delay, self._frames.length())
    return self
  }

  /**
   * Calls a function on every frame, and returns a new animation.
   *
   * Each frame is copied before the function receives it, so a chain of
   * filters can be used directly as the body, and this animation is
   * left unchanged. Because of that copy, `map()` needs as much memory
   * again as the animation itself. To filter the frames in place
   * instead, go through `frames()` and change each image directly.
   *
   * ```zuri
   * var grey = animation.map(@(frame) {
   *   return frame.grayscale().blur(1)
   * })
   * ```
   *
   * @param function(1) fn
   * @returns Animation
   * @throws ImageError when the function returns anything other than an
   *    image.
   */
  map(fn: function) {
    var mapped = []

    for frame in self._frames {
      var result = fn(frame.clone())

      if !is_instance(result) or !instance_of(result, Image) {
        raise ImageError('the mapping function must return an Image')
      }

      mapped.append(result)
    }

    return Animation(mapped, self._delays.clone(), self._repeat, self._format)
  }

  /**
   * Returns a new animation with the frames in reverse order.
   *
   * The frames themselves are shared with this animation, not copied,
   * because changing their order doesn't change the frames. If you edit
   * a frame afterwards, the change shows in both animations. `map()` is
   * the method that copies.
   *
   * @returns Animation
   */
  reverse() {
    return Animation(
      self._frames.reverse(),
      self._delays.reverse(),
      self._repeat,
      self._format,
    )
  }

  /**
   * Returns the animation as a single image: its first frame.
   *
   * @returns Image
   */
  to_image() {
    return self._frames[0]
  }

  /**
   * Encodes the animation and returns the bytes.
   *
   * @param ?string format: defaults to `GIF`.
   * @param ?dict options
   * @returns bytes
   * @throws EncodeError when the format can't hold an animation.
   */
  encode(format, options) {
    var target = formats.normalize(format == nil ? 'gif' : format)

    var entries = []

    iter var i = 0; i < self._frames.length(); i++ {
      var frame = self._frames[i]

      entries.append({
        pixels: frame.pixels(),
        width: frame.width(),
        height: frame.height(),
        delay: self._delays[i],
      })
    }

    var settings = is_dict(options) ? options.clone() : {}
    settings.set('repeat', self._repeat)

    catch {
      return _imagine.encode_frames(entries, target, settings)
    } as e {
      raise EncodeError(e.message)
    }
  }

  /**
   * Writes the animation to a file.
   *
   * @param string path
   * @param ?dict options: `format`, plus everything `encode()` takes.
   * @returns self
   */
  save(path: string, options) {
    var target = is_dict(options) ? options.get('format') : nil

    if target == nil {
      target = formats.from_extension(path)
    }

    if target == nil {
      target = 'gif'
    }

    file(path, 'wb').write(self.encode(target, options))
    return self
  }

  to_string() {
    return '<Animation ${self._frames.length()} frames, ${self.width()}x${self.height()}>'
  }

  @to_string() {
    return self.to_string()
  }
}

/**
 * Turns a delay argument into one value per frame.
 */
def _expand_delays(delay, count) {
  if delay == nil {
    return [100] * count
  }

  if is_number(delay) {
    return [delay] * count
  }

  if is_list(delay) {
    if delay.length() != count {
      raise ImageError('got ${delay.length()} delays for ${count} frames')
    }

    return delay.clone()
  }

  raise ImageError(
    'frame delay must be a number or a list, ${typeof(delay)} given',
  )
}
