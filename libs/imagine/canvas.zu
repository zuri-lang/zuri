/**
 * @module canvas
 *
 * `Canvas`: the drawing surface. Every shape the module can draw is a
 * method on it.
 *
 * A canvas wraps an `Image`'s pixel buffer rather than copying it, so
 * drawing goes straight into the image being built. The shape methods
 * share three primitives underneath (span fill, blend, and stroke),
 * which is why a new shape rarely needs new native code.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

#!-- part of the imagine module

import math

import _imagine

import .color { Color }
import .constants { CAP_BUTT, CAP_ROUND, CAP_SQUARE }
import .errors { BoundsError, ImageError }


/**
 * How many sub-scanlines an anti-aliased fill samples per pixel row.
 *
 * Coverage is exact horizontally (a span's fractional ends are
 * measured, not sampled), so this only controls vertical quality.
 * Four is the point where a near-horizontal edge stops looking
 * stepped; eight is not visibly better and costs twice as much.
 */
var _SUBSAMPLES = 4

/**
 * How many straight segments approximate a full ellipse.
 *
 * Scaled by size in `_ellipse_points` so a small circle is not paying
 * for detail nobody can see, and a large one does not go polygonal.
 */
var _MIN_ELLIPSE_SEGMENTS = 16
var _MAX_ELLIPSE_SEGMENTS = 512


/**
 * A mutable RGBA pixel surface and everything that draws onto one.
 *
 * `Canvas` is the lower half of `Image`: it owns the pixel buffer and
 * knows how to put colour into it, but nothing about files, formats or
 * resizing. It is separate mostly so the drawing code can be read on
 * its own, and it is rarely worth using directly; `Image` inherits all
 * of this.
 *
 * ## How drawing works here
 *
 * Every filled shape becomes a polygon and goes through one scanline
 * rasterizer, and every stroked shape becomes the polygon outlining
 * its stroke and goes through the same one. That means anti-aliasing,
 * clipping and the fill rule are implemented once rather than once per
 * primitive, and a shape this module does not offer can be drawn by
 * handing `fill_polygon()` the points for it.
 *
 * ## Coordinates
 *
 * The origin is the top-left corner. Integer coordinates fall on pixel
 * corners, not centres, so a rectangle from (0, 0) to (10, 10) covers
 * exactly the first ten pixels in each direction with no half-covered
 * edge. Fractional coordinates are meaningful and are what
 * anti-aliasing acts on.
 *
 * Drawing outside the surface is not an error. Anything that falls
 * outside is clipped away, which is what makes it safe to draw a shape
 * that only partly overlaps the image.
 */
class Canvas {

  # The RGBA8 buffer itself, width * height * 4 bytes, straight (not
  # premultiplied) alpha, no row padding.
  var _pixels

  var _width
  var _height

  # nil, or [x0, y0, x1, y1] with x1/y1 exclusive. Every write goes
  # through _blend_pixel, so this is the only place clipping is
  # enforced.
  var _clip

  # Drawing defaults, changed through the setters below rather than
  # passed to every call.
  var _antialias
  var _thickness
  var _cap

  /**
   * Wraps an existing pixel buffer.
   *
   * The buffer is taken as-is and not copied, so the caller must not
   * keep writing to it independently. `Image` is the supported way to
   * get a `Canvas`; this constructor exists for code that already has
   * pixels from somewhere else.
   *
   * @param bytes pixels: `width * height * 4` bytes of RGBA.
   * @param number width
   * @param number height
   */
  @new(pixels: bytes, width: number, height: number) {
    if width < 1 or height < 1 {
      raise BoundsError('a canvas must be at least 1x1, got ${width}x${height}')
    }

    var expected = width * height * 4
    if pixels.length() != expected {
      raise ImageError(
        'pixel buffer holds ${pixels.length()} bytes, but ${width}x${height} RGBA needs ${expected}'
      )
    }

    self._pixels = pixels
    self._width = width
    self._height = height
    self._clip = nil
    self._antialias = true
    self._thickness = 1
    self._cap = CAP_ROUND
  }

  # ------------------------------------------------------------------
  # surface
  # ------------------------------------------------------------------

  /**
   * The width in pixels.
   *
   * @returns number
   */
  width() {
    return self._width
  }

  /**
   * The height in pixels.
   *
   * @returns number
   */
  height() {
    return self._height
  }

  /**
   * The raw RGBA pixel buffer.
   *
   * This is the live buffer, not a copy: writing to it changes the
   * image. Pixel `(x, y)` starts at byte `(y * width + x) * 4` and runs
   * red, green, blue, alpha, with alpha straight rather than
   * premultiplied.
   *
   * Handing this out is deliberate. Reading and writing bytes directly
   * is far faster than a method call per pixel, so an operation this
   * module does not provide can still be written efficiently in Zuri.
   *
   * @returns bytes
   */
  pixels() {
    return self._pixels
  }

  /**
   * Replaces the surface's pixels with another buffer.
   *
   * The buffer must hold exactly `width * height * 4` bytes, and is
   * adopted rather than copied, so whatever produced it must not keep
   * writing to it afterwards.
   *
   * The pair to `pixels()`: that one hands the buffer out so an
   * operation this module does not provide can be written directly,
   * and this one takes a buffer back. Saving a copy before a
   * destructive filter and restoring it afterwards is the usual
   * reason to want it.
   *
   * @param bytes pixels
   * @returns self
   * @throws ImageError When the buffer is the wrong size.
   */
  set_pixels(pixels: bytes) {
    var expected = self._width * self._height * 4

    if pixels.length() != expected {
      raise ImageError(
        'pixel buffer holds ${pixels.length()} bytes, but this ' +
        '${self._width}x${self._height} surface needs ${expected}'
      )
    }

    self._pixels = pixels
    return self
  }

  /**
   * Restricts every subsequent drawing operation to a rectangle.
   *
   * The rectangle is intersected with the surface, so a clip larger
   * than the image is the same as no clip. Passing no arguments, or
   * calling `clear_clip()`, removes it.
   *
   * @param number x
   * @param number y
   * @param number width
   * @param number height
   * @returns self
   */
  clip(x, y, width, height) {
    if x == nil {
      return self.clear_clip()
    }

    var x0 = (0).max(x.floor())
    var y0 = (0).max(y.floor())
    var x1 = self._width.min((x + width).ceil())
    var y1 = self._height.min((y + height).ceil())

    self._clip = [x0, y0, x1, y1]
    return self
  }

  /**
   * Removes any clipping rectangle.
   *
   * @returns self
   */
  clear_clip() {
    self._clip = nil
    return self
  }

  /**
   * The current clipping rectangle as `{x, y, width, height}`, or
   * `nil` when there isn't one.
   *
   * @returns ?dict
   */
  get_clip() {
    if self._clip == nil {
      return nil
    }

    var x = self._clip[0]
    var y = self._clip[1]
    var width = self._clip[2] - x
    var height = self._clip[3] - y

    return { x, y, width, height }
  }

  /**
   * Turns anti-aliasing on or off for subsequent drawing.
   *
   * On by default. Turning it off makes every edge hard, which is
   * faster and is what you want for pixel-exact output such as
   * barcodes, or when drawing into a mask that will be thresholded
   * anyway.
   *
   * @param bool enabled
   * @returns self
   */
  antialias(enabled) {
    self._antialias = enabled == nil ? true : enabled == true
    return self
  }

  /**
   * Sets the stroke width in pixels for lines and outlines.
   *
   * Strokes are centred on the path, so a thickness of 4 puts 2 pixels
   * on each side. The default is 1.
   *
   * @param number thickness
   * @returns self
   */
  thickness(thickness: number) {
    if thickness <= 0 {
      raise ImageError('stroke thickness must be greater than zero')
    }

    self._thickness = thickness
    return self
  }

  /**
   * Sets how the two ends of an open stroke are finished.
   *
   * `CAP_ROUND` (the default) ends in a half-disc, `CAP_SQUARE` in a
   * square, and both reach half the stroke's width past the endpoint.
   * `CAP_BUTT` stops exactly at it.
   *
   * Reach for `CAP_BUTT` when the coordinates have to mean exactly
   * what they say: segments meeting end to end, a scale bar of a known
   * length, the pieces of a dashed line. The joins between a path's
   * segments are always round and are not affected by this.
   *
   * ```zuri
   * chart.cap(CAP_BUTT).thickness(6)
   * chart.line(40, 200, 40, 40, '#334155')
   * ```
   *
   * @param string style: `CAP_BUTT`, `CAP_ROUND` or `CAP_SQUARE`.
   * @returns self
   */
  cap(style) {
    if style != CAP_BUTT and style != CAP_ROUND and style != CAP_SQUARE {
      raise ImageError("'${style}' is not a line cap, expected butt, round or square")
    }

    self._cap = style
    return self
  }

  /**
   * The line cap in force.
   *
   * @returns string
   */
  get_cap() {
    return self._cap
  }

  # ------------------------------------------------------------------
  # pixels
  # ------------------------------------------------------------------

  /**
   * Returns the colour at a pixel, or `nil` when the coordinates fall
   * outside the image.
   *
   * Clipping does not apply; a clip restricts what is written, not
   * what can be read.
   *
   * @param number x
   * @param number y
   * @returns ?Color
   */
  get_pixel(x, y) {
    var px = x.floor()
    var py = y.floor()

    if px < 0 or py < 0 or px >= self._width or py >= self._height {
      return nil
    }

    var at = (py * self._width + px) * 4
    var buffer = self._pixels

    return Color(buffer[at], buffer[at + 1], buffer[at + 2], buffer[at + 3])
  }

  /**
   * Replaces the colour at a pixel, ignoring whatever was there.
   *
   * This overwrites rather than blends, so drawing a half-transparent
   * colour leaves a half-transparent pixel instead of compositing it
   * over the old one. Use `blend_pixel()` for the compositing version,
   * which is what every other drawing method uses.
   *
   * Coordinates outside the image or outside the clip are ignored.
   *
   * @param number x
   * @param number y
   * @param Color|string|number color
   * @returns self
   */
  set_pixel(x, y, color) {
    var paint = Color.parse(color)
    var px = x.floor()
    var py = y.floor()

    if !self._writable(px, py) {
      return self
    }

    var at = (py * self._width + px) * 4
    var buffer = self._pixels

    buffer[at] = paint.r
    buffer[at + 1] = paint.g
    buffer[at + 2] = paint.b
    buffer[at + 3] = paint.a

    return self
  }

  /**
   * Draws one pixel, compositing it over whatever is already there.
   *
   * The single-pixel member of the drawing family, alongside `line()`
   * and `rect()`. It is the same operation as `blend_pixel()`, under
   * the name that reads correctly in a chain of drawing calls.
   *
   * Coordinates outside the image or outside the clip are ignored.
   *
   * @param number x
   * @param number y
   * @param Color|string|number color
   * @returns self
   */
  pixel(x, y, color) {
    return self.blend_pixel(x, y, color)
  }

  /**
   * Composites a colour over the pixel already there, the way every
   * drawing operation does.
   *
   * Coordinates outside the image or outside the clip are ignored.
   *
   * @param number x
   * @param number y
   * @param Color|string|number color
   * @returns self
   */
  blend_pixel(x, y, color) {
    var paint = Color.parse(color)

    self._blend(x.floor(), y.floor(), paint.r, paint.g, paint.b, paint.a)
    return self
  }

  /**
   * True when this pixel may be written: inside the surface, and
   * inside the clip if there is one.
   */
  _writable(px, py) {
    if px < 0 or py < 0 or px >= self._width or py >= self._height {
      return false
    }

    if self._clip != nil {
      if px < self._clip[0] or py < self._clip[1] or
         px >= self._clip[2] or py >= self._clip[3] {
        return false
      }
    }

    return true
  }

  /**
   * Source-over compositing of one pixel, in straight alpha.
   *
   * The single place colour reaches the buffer. Everything above ends
   * up here, so clipping, bounds and the blend arithmetic are written
   * once. Kept in terms of plain numbers rather than `Color` because
   * a filled shape calls it once per pixel.
   */
  
  /**
   * Draws one hairline segment straight onto the buffer.
   *
   * Steps along whichever axis the segment covers more of, one pixel
   * column at a time, and works out that column's coverage directly.
   * The work is proportional to the segment's length rather than to
   * the area of its bounding box, which is what the general scanline
   * path costs for a shape this thin.
   *
   * The stroke this models is the same one the rasterizer would fill:
   * a quad one pixel wide measured perpendicular to the line. A sloped
   * line therefore spans a little over a pixel vertically in each
   * column, and both rows it touches take a share of the colour. That
   * is why this is not simply Wu's line, which would put a 45-degree
   * diagonal entirely on one row and lose the softness.
   *
   * Every write goes through `_blend`, so clipping and the surface
   * bounds are enforced exactly as they are everywhere else.
   */
  _thin_segment(x1, y1, x2, y2, paint) {
    var x0 = x1
    var y0 = y1
    var xn = x2
    var yn = y2

    # Step along the axis the line covers more of, so consecutive
    # columns are always neighbours and never leave a gap.
    var steep = (yn - y0).abs() > (xn - x0).abs()

    if steep {
      var swap = x0
      x0 = y0
      y0 = swap

      swap = xn
      xn = yn
      yn = swap
    }

    if x0 > xn {
      var swap = x0
      x0 = xn
      xn = swap

      swap = y0
      y0 = yn
      yn = swap
    }

    var dx = xn - x0

    if dx == 0 {
      return
    }

    var gradient = (yn - y0) / dx

    var r = paint.r
    var g = paint.g
    var b = paint.b
    var a = paint.a

    # Half the stroke's vertical extent in one column. A level line
    # covers exactly one row; the more it slopes, the further it
    # reaches, up to about 1.41 rows at 45 degrees.
    var half_span = 0.5 * (1 + gradient * gradient).sqrt()

    var col_end = xn.ceil()

    # Coverage is averaged over a few positions across each column
    # rather than read off its middle. The stroke's vertical reach
    # changes as it crosses the column, and a single reading in the
    # centre calls the middle row fully covered on a 45-degree line when
    # the true figure is about 91%: enough to lose the soft edge the
    # rasterizer produces. Four readings land within a fraction of a
    # percent of the exact area.
    var SAMPLES = 4
    var step = 1.0 / SAMPLES

    iter var col = x0.floor(); col < col_end; col++ {

      # The rows this column can reach, taken from the stroke's extent
      # at both of its edges.
      var left = y0 + gradient * (col - x0)
      var right = y0 + gradient * (col + 1 - x0)
      var first_row = (left.min(right) - half_span).floor()
      var last_row = (left.max(right) + half_span).floor()

      iter var row = first_row; row <= last_row; row++ {
        var total = 0.0

        iter var i = 0; i < SAMPLES; i++ {
          var sx = col + (i + 0.5) * step

          # Outside the segment's own span: this is what gives a butt
          # cap its clean end instead of a half-pixel overhang.
          if sx < x0 or sx > xn {
            continue
          }

          var sy = y0 + gradient * (sx - x0)
          var covered = (sy + half_span).min(row + 1) - (sy - half_span).max(row)

          if covered > 0 {
            total = total + covered
          }
        }

        if total <= 0 {
          continue
        }

        var cover = total * step

        if steep {
          self._blend(row, col, r, g, b, a * cover)
        } else {
          self._blend(col, row, r, g, b, a * cover)
        }
      }
    }
  }

  _blend(px, py, r, g, b, a) {
    if a <= 0 or !self._writable(px, py) {
      return
    }

    _blend_at(self._pixels, (py * self._width + px) * 4, r, g, b, a)
  }

  # ------------------------------------------------------------------
  # the rasterizer
  # ------------------------------------------------------------------

  /**
   * Fills a polygon.
   *
   * The points are a flat list of alternating x and y values, or a
   * list of `[x, y]` pairs; both are accepted because both read
   * naturally depending on where the points came from. The outline is
   * closed automatically, so the last point does not need to repeat
   * the first.
   *
   * Self-intersecting outlines are filled by the non-zero winding
   * rule by default, which is what fills a five-pointed star solid.
   * Pass `{ even_odd: true }` for the other convention, which leaves
   * the middle of that star empty.
   *
   * @param list points
   * @param Color|string|number color
   * @param ?dict options: `even_odd` (bool).
   * @returns self
   */
  fill_polygon(points, color, options) {
    var flat = self._flatten_points(points)

    if flat.length() < 6 {
      return self
    }

    var paint = Color.parse(color)
    var even_odd = is_dict(options) ? options.get('even_odd', false) == true : false

    self._scan_fill(flat, paint, even_odd)
    return self
  }

  /**
   * Draws a polygon's outline, closing it back to the first point.
   *
   * @param list points
   * @param Color|string|number color
   * @param ?dict options: `thickness`.
   * @returns self
   */
  polygon(points, color, options) {
    return self._stroke(self._flatten_points(points), color, true, options)
  }

  /**
   * Draws a connected run of line segments without closing it.
   *
   * @param list points
   * @param Color|string|number color
   * @param ?dict options: `thickness`.
   * @returns self
   */
  polyline(points, color, options) {
    return self._stroke(self._flatten_points(points), color, false, options)
  }

  /**
   * Accepts either `[x1, y1, x2, y2, ...]` or `[[x1, y1], [x2, y2], ...]`
   * and returns the flat form the rasterizer works in.
   */
  _flatten_points(points: list) {
    if points.length() == 0 {
      return []
    }

    if is_list(points[0]) {
      var flat = []

      for point in points {
        if !is_list(point) or point.length() < 2 {
          raise ImageError('each point must be a list of two numbers')
        }

        flat.append(point[0])
        flat.append(point[1])
      }

      return flat
    }

    if points.length() % 2 != 0 {
      raise ImageError('a flat point list needs an even number of values')
    }

    return points
  }

  /**
   * Scanline polygon fill with analytic horizontal coverage and
   * `_SUBSAMPLES` sub-scanlines vertically.
   *
   * Coverage is accumulated for one pixel row at a time into a reused
   * buffer, then blended in a single pass over that row. Working a row
   * at a time is what keeps memory flat regardless of how large the
   * shape is.
   */
  _scan_fill(flat, paint, even_odd) {
    var count = flat.length() / 2

    # Bounding box, clipped to whatever we are allowed to touch.
    var min_x = flat[0]
    var max_x = flat[0]
    var min_y = flat[1]
    var max_y = flat[1]

    iter var i = 1; i < count; i++ {
      var x = flat[i * 2]
      var y = flat[i * 2 + 1]

      if x < min_x {
        min_x = x
      }
      if x > max_x {
        max_x = x
      }
      if y < min_y {
        min_y = y
      }
      if y > max_y {
        max_y = y
      }
    }

    var bounds = self._drawable_bounds()
    var start_x = bounds[0].max(min_x.floor())
    var end_x = bounds[2].min(max_x.ceil())
    var start_y = bounds[1].max(min_y.floor())
    var end_y = bounds[3].min(max_y.ceil())

    if start_x >= end_x or start_y >= end_y {
      return
    }

    var row_width = end_x - start_x
    var coverage = [0] * row_width
    var steps = self._antialias ? _SUBSAMPLES : 1
    var step_weight = 1 / steps

    # The range of the coverage buffer the previous row wrote into.
    # Only that range is cleared and blended, so a shape costs what it
    # actually covers rather than the width of the box it spans; a thin
    # diagonal touches a few entries per row out of the whole width.
    var dirty_lo = 0
    var dirty_hi = -1

    iter var py = start_y; py < end_y; py++ {
      iter var i = dirty_lo; i <= dirty_hi; i++ {
        coverage[i] = 0
      }

      dirty_lo = row_width
      dirty_hi = -1

      iter var s = 0; s < steps; s++ {
        var sample_y = py + (s + 0.5) / steps
        var crossings = self._crossings(flat, count, sample_y)

        if crossings.length() == 0 {
          continue
        }

        var spans = even_odd ?
          self._spans_even_odd(crossings) :
          self._spans_non_zero(crossings)

        for span in spans {
          var left = span[0].max(start_x)
          var right = span[1].min(end_x)

          if right <= left {
            continue
          }

          var first = left.floor() - start_x
          var last = right.ceil() - 1 - start_x

          if first < dirty_lo {
            dirty_lo = first
          }

          if last > dirty_hi {
            dirty_hi = last
          }

          self._accumulate(coverage, start_x, end_x, span[0], span[1], step_weight)
        }
      }

      if dirty_hi < dirty_lo {
        continue
      }

      self._blend_row(py, start_x + dirty_lo, dirty_hi - dirty_lo + 1, coverage, paint, dirty_lo)
    }
  }

  /**
   * The rectangle drawing is allowed to touch: the surface, narrowed
   * by the clip when there is one.
   */
  _drawable_bounds() {
    if self._clip == nil {
      return [0, 0, self._width, self._height]
    }

    return self._clip
  }

  /**
   * Every edge crossing of the horizontal line at `sample_y`, as
   * `[x, direction]` pairs sorted by x. Direction is +1 for a
   * downward edge and -1 for an upward one, which is what the non-zero
   * rule counts.
   *
   * A vertex sitting exactly on the sample line would otherwise be
   * counted twice; the half-open test (`y0 <= sample_y < y1`) is what
   * prevents that, and is why the sample lines sit at pixel centres
   * rather than on integers.
   */
  _crossings(flat, count, sample_y) {
    var found = []

    iter var i = 0; i < count; i++ {
      var j = (i + 1) % count

      var x0 = flat[i * 2]
      var y0 = flat[i * 2 + 1]
      var x1 = flat[j * 2]
      var y1 = flat[j * 2 + 1]

      if y0 == y1 {
        continue
      }

      var direction = 1
      var top = y0
      var bottom = y1
      var top_x = x0
      var bottom_x = x1

      if y0 > y1 {
        direction = -1
        top = y1
        bottom = y0
        top_x = x1
        bottom_x = x0
      }

      if sample_y < top or sample_y >= bottom {
        continue
      }

      var t = (sample_y - top) / (bottom - top)
      found.append([top_x + (bottom_x - top_x) * t, direction])
    }

    # Insertion sort by x. A scanline crosses a handful of edges even
    # for a complicated outline, and `list.sort()` takes no comparator,
    # so this is both the simplest and the fastest option here.
    iter var i = 1; i < found.length(); i++ {
      var current = found[i]
      var j = i - 1

      while j >= 0 and found[j][0] > current[0] {
        found[j + 1] = found[j]
        j--
      }

      found[j + 1] = current
    }

    return found
  }

  /**
   * Spans under the even-odd rule: fill between the first and second
   * crossing, the third and fourth, and so on.
   */
  _spans_even_odd(crossings) {
    var spans = []

    iter var i = 0; i + 1 < crossings.length(); i += 2 {
      spans.append([crossings[i][0], crossings[i + 1][0]])
    }

    return spans
  }

  /**
   * Spans under the non-zero winding rule: a span is filled wherever
   * the running sum of edge directions is not zero.
   */
  _spans_non_zero(crossings) {
    var spans = []
    var winding = 0
    var span_start = 0

    for crossing in crossings {
      var was_inside = winding != 0
      winding += crossing[1]
      var is_inside = winding != 0

      if !was_inside and is_inside {
        span_start = crossing[0]
      } else if was_inside and !is_inside {
        spans.append([span_start, crossing[0]])
      }
    }

    return spans
  }

  /**
   * Adds one span's horizontal coverage into the row buffer.
   *
   * The two end pixels get the fraction of themselves the span
   * actually covers; everything between gets the full weight. This is
   * where the horizontal half of anti-aliasing comes from, and it is
   * exact rather than sampled.
   *
   * Returns true when anything was added.
   */
  _accumulate(coverage, start_x, end_x, from_x, to_x, weight) {
    var left = from_x.max(start_x)
    var right = to_x.min(end_x)

    if right <= left {
      return false
    }

    var first = left.floor()
    var last = right.ceil() - 1

    if first == last {
      coverage[first - start_x] += (right - left) * weight
      return true
    }

    coverage[first - start_x] += (first + 1 - left) * weight

    iter var px = first + 1; px < last; px++ {
      coverage[px - start_x] += weight
    }

    coverage[last - start_x] += (right - last) * weight
    return true
  }

  /**
   * Blends one row of accumulated coverage.
   *
   * Coverage scales the paint's alpha, so filling with a colour that
   * is already half transparent through an edge pixel at half coverage
   * lands at a quarter, which is what stacking the two would give.
   */
  _blend_row(py, start_x, row_width, coverage, paint, offset) {
    _blend_coverage(
      self._pixels,
      (py * self._width + start_x) * 4,
      offset,
      row_width,
      coverage,
      paint.r,
      paint.g,
      paint.b,
      paint.a
    )
  }

  # ------------------------------------------------------------------
  # strokes
  # ------------------------------------------------------------------

  /**
   * Strokes a path by turning it into the polygon that outlines it,
   * then filling that.
   *
   * Each segment becomes its own quadrilateral and each interior joint
   * gets a round cap, rather than computing proper mitres. Overlapping
   * quads would double-blend a translucent stroke, so they are filled
   * as one polygon under the non-zero rule, which counts the overlap
   * once.
   */
  _stroke(flat, color, closed, options) {
    var count = flat.length() / 2

    if count < 2 {
      if count == 1 and self._thickness > 1 {
        return self.fill_circle(flat[0], flat[1], self._thickness / 2, color)
      }

      return self
    }

    var paint = Color.parse(color)
    var width = self._thickness
    var cap = self._cap

    if is_dict(options) {
      if is_number(options.get('thickness')) {
        width = options.thickness
      }

      if options.get('cap') != nil {
        cap = options.cap
      }
    }

    if cap != CAP_BUTT and cap != CAP_ROUND and cap != CAP_SQUARE {
      raise ImageError("'${cap}' is not a line cap, expected butt, round or square")
    }

    var half = width / 2
    var segments = closed ? count : count - 1

    # A hairline has almost no interior for the scanline rasterizer to
    # find. Its stroke quad is a pixel wide, so filling it costs a pass
    # over the whole bounding box (every scanline the segment crosses,
    # sampled for coverage) to light what is really just one run of
    # pixels. Walking the segment itself writes exactly those pixels and
    # nothing else.
    #
    # Anti-aliased only. With it off the rasterizer still accumulates
    # fractional coverage across x while sampling a single scanline per
    # row, and reproducing that rule exactly is a different job from
    # this one; drawing a hairline the obvious way instead comes out
    # visibly thinner, so those keep the general path.
    #
    # Every cap but square, which is the only one that changes the shape
    # at this width: it pushes the endpoints out by half the stroke
    # before the quad is even built. A round cap draws a disc of radius
    # half a pixel, which the general path below skips anyway (it only
    # bothers past 1.5 wide), so round and butt come out identical here.
    if self._antialias and width <= 1 and cap != CAP_SQUARE {
      iter var i = 0; i < segments; i++ {
        var j = (i + 1) % count

        self._thin_segment(
          flat[i * 2],
          flat[i * 2 + 1],
          flat[j * 2],
          flat[j * 2 + 1],
          paint
        )
      }

      return self
    }

    # Every quad and every joint disc, filled together so the overlaps
    # count once.
    var pieces = []

    iter var i = 0; i < segments; i++ {
      var j = (i + 1) % count

      var x0 = flat[i * 2]
      var y0 = flat[i * 2 + 1]
      var x1 = flat[j * 2]
      var y1 = flat[j * 2 + 1]

      var dx = x1 - x0
      var dy = y1 - y0
      var length = (dx * dx + dy * dy).sqrt()

      if length == 0 {
        continue
      }

      if !closed and cap == CAP_SQUARE {
        var ex = dx / length * half
        var ey = dy / length * half

        if i == 0 {
          x0 -= ex
          y0 -= ey
        }

        if i == segments - 1 {
          x1 += ex
          y1 += ey
        }
      }

      # The unit normal, scaled to half the stroke width.
      var nx = -dy / length * half
      var ny = dx / length * half

      pieces.append([
        x0 + nx, y0 + ny,
        x1 + nx, y1 + ny,
        x1 - nx, y1 - ny,
        x0 - nx, y0 - ny,
      ])
    }

    if pieces.length() == 0 {
      return self
    }

    for piece in pieces {
      self._scan_fill(piece, paint, false)
    }

    # A disc at every interior joint, filling the wedge two quads leave
    # between them, so joins are always round. The two ends of an open
    # path get one only when the cap is round; a square cap was already
    # handled by extending the end segments, and a butt cap wants
    # nothing past the endpoint at all. Only worth drawing once the
    # stroke is wide enough for any of it to show.
    if width > 1.5 {
      var first = closed or cap == CAP_ROUND ? 0 : 1
      var last = closed or cap == CAP_ROUND ? count : count - 1

      iter var i = first; i < last; i++ {
        self._fill_disc(flat[i * 2], flat[i * 2 + 1], half, paint)
      }
    }

    return self
  }

  /**
   * A filled circle used for stroke joints, kept private so it can
   * take an already-parsed colour.
   */
  _fill_disc(cx, cy, radius, paint) {
    if radius <= 0.5 {
      return
    }

    self._scan_fill(self._ellipse_points(cx, cy, radius, radius, 0, 360, false), paint, false)
  }

  # ------------------------------------------------------------------
  # primitives
  # ------------------------------------------------------------------

  /**
   * Draws a straight line between two points.
   *
   * The line is `thickness()` pixels wide, centred on the path, and
   * anti-aliased unless that has been turned off.
   *
   * @param number x1
   * @param number y1
   * @param number x2
   * @param number y2
   * @param Color|string|number color
   * @param ?dict options: `thickness`.
   * @returns self
   */
  line(x1, y1, x2, y2, color, options) {
    return self._stroke([x1, y1, x2, y2], color, false, options)
  }

  /**
   * Draws the outline of a rectangle.
   *
   * The stroke is centred on the rectangle's edge, so half of a thick
   * outline falls inside it and half outside.
   *
   * @param number x
   * @param number y
   * @param number width
   * @param number height
   * @param Color|string|number color
   * @param ?dict options: `thickness`.
   * @returns self
   */
  rect(x, y, width, height, color, options) {
    return self._stroke(
      [x, y, x + width, y, x + width, y + height, x, y + height],
      color,
      true,
      options
    )
  }

  /**
   * Fills a rectangle.
   *
   * @param number x
   * @param number y
   * @param number width
   * @param number height
   * @param Color|string|number color
   * @returns self
   */
  fill_rect(x, y, width, height, color) {
    if width <= 0 or height <= 0 {
      return self
    }

    return self.fill_polygon(
      [x, y, x + width, y, x + width, y + height, x, y + height],
      color
    )
  }

  /**
   * Draws the outline of a rectangle with rounded corners.
   *
   * A radius larger than half the shorter side is reduced to fit, so a
   * very large radius gives a stadium shape rather than a broken one.
   *
   * @param number x
   * @param number y
   * @param number width
   * @param number height
   * @param number radius
   * @param Color|string|number color
   * @param ?dict options: `thickness`.
   * @returns self
   */
  rounded_rect(x, y, width, height, radius, color, options) {
    return self._stroke(
      self._rounded_points(x, y, width, height, radius),
      color,
      true,
      options
    )
  }

  /**
   * Fills a rectangle with rounded corners.
   *
   * @param number x
   * @param number y
   * @param number width
   * @param number height
   * @param number radius
   * @param Color|string|number color
   * @returns self
   */
  fill_rounded_rect(x, y, width, height, radius, color) {
    if width <= 0 or height <= 0 {
      return self
    }

    return self.fill_polygon(self._rounded_points(x, y, width, height, radius), color)
  }

  /**
   * The outline of a rounded rectangle, corner by corner.
   */
  _rounded_points(x, y, width, height, radius) {
    var limit = width.min(height) / 2
    var r = (0).max(radius.min(limit))

    if r <= 0 {
      return [x, y, x + width, y, x + width, y + height, x, y + height]
    }

    var steps = (4).max(r.ceil())
    var points = []

    # Each corner is a quarter arc, walked clockwise starting from the
    # top-left so the outline comes out in a consistent direction.
    var corners = [
      [x + r, y + r, 180, 270],
      [x + width - r, y + r, 270, 360],
      [x + width - r, y + height - r, 0, 90],
      [x + r, y + height - r, 90, 180],
    ]

    for corner in corners {
      iter var i = 0; i <= steps; i++ {
        var angle = (corner[2] + (corner[3] - corner[2]) * i / steps) * math.PI / 180

        points.append(corner[0] + angle.cos() * r)
        points.append(corner[1] + angle.sin() * r)
      }
    }

    return points
  }

  /**
   * Draws the outline of a circle.
   *
   * @param number cx: The centre's x coordinate.
   * @param number cy: The centre's y coordinate.
   * @param number radius
   * @param Color|string|number color
   * @param ?dict options: `thickness`.
   * @returns self
   */
  circle(cx, cy, radius, color, options) {
    return self.ellipse(cx, cy, radius, radius, color, options)
  }

  /**
   * Fills a circle.
   *
   * @param number cx
   * @param number cy
   * @param number radius
   * @param Color|string|number color
   * @returns self
   */
  fill_circle(cx, cy, radius, color) {
    return self.fill_ellipse(cx, cy, radius, radius, color)
  }

  /**
   * Draws the outline of an ellipse.
   *
   * @param number cx: The centre's x coordinate.
   * @param number cy: The centre's y coordinate.
   * @param number rx: The horizontal radius.
   * @param number ry: The vertical radius.
   * @param Color|string|number color
   * @param ?dict options: `thickness`.
   * @returns self
   */
  ellipse(cx, cy, rx, ry, color, options) {
    if rx <= 0 or ry <= 0 {
      return self
    }

    return self._stroke(
      self._ellipse_points(cx, cy, rx, ry, 0, 360, false),
      color,
      true,
      options
    )
  }

  /**
   * Fills an ellipse.
   *
   * @param number cx
   * @param number cy
   * @param number rx
   * @param number ry
   * @param Color|string|number color
   * @returns self
   */
  fill_ellipse(cx, cy, rx, ry, color) {
    if rx <= 0 or ry <= 0 {
      return self
    }

    return self.fill_polygon(self._ellipse_points(cx, cy, rx, ry, 0, 360, false), color)
  }

  /**
   * Draws an elliptical arc.
   *
   * Angles are in degrees, measured clockwise from three o'clock,
   * matching the direction the y axis runs. An end angle below the
   * start angle sweeps the long way round.
   *
   * @param number cx
   * @param number cy
   * @param number rx
   * @param number ry
   * @param number start: The starting angle in degrees.
   * @param number end: The ending angle in degrees.
   * @param Color|string|number color
   * @param ?dict options: `thickness`.
   * @returns self
   */
  arc(cx, cy, rx, ry, start, end, color, options) {
    if rx <= 0 or ry <= 0 {
      return self
    }

    return self._stroke(
      self._ellipse_points(cx, cy, rx, ry, start, end, false),
      color,
      false,
      options
    )
  }

  /**
   * Fills a pie slice: an arc closed back through the centre.
   *
   * @param number cx
   * @param number cy
   * @param number rx
   * @param number ry
   * @param number start: The starting angle in degrees.
   * @param number end: The ending angle in degrees.
   * @param Color|string|number color
   * @returns self
   */
  pie(cx, cy, rx, ry, start, end, color) {
    if rx <= 0 or ry <= 0 {
      return self
    }

    return self.fill_polygon(self._ellipse_points(cx, cy, rx, ry, start, end, true), color)
  }

  /**
   * Fills the region between an arc and its chord.
   *
   * @param number cx
   * @param number cy
   * @param number rx
   * @param number ry
   * @param number start
   * @param number end
   * @param Color|string|number color
   * @returns self
   */
  chord(cx, cy, rx, ry, start, end, color) {
    if rx <= 0 or ry <= 0 {
      return self
    }

    return self.fill_polygon(self._ellipse_points(cx, cy, rx, ry, start, end, false), color)
  }

  /**
   * Points along an elliptical arc.
   *
   * The segment count scales with the arc's size so a small circle is
   * not paying for detail nobody can see and a large one does not go
   * visibly polygonal. `to_center` adds the centre point, turning the
   * arc into a pie slice.
   */
  _ellipse_points(cx, cy, rx, ry, start, end, to_center) {
    var sweep = end - start

    if sweep <= 0 {
      sweep += 360
    }

    if sweep > 360 {
      sweep = 360
    }

    var size = rx.max(ry)
    var full = _MIN_ELLIPSE_SEGMENTS.max(_MAX_ELLIPSE_SEGMENTS.min((size * 2).ceil()))
    var steps = (2).max((full * sweep / 360).ceil())

    var points = []

    if to_center {
      points.append(cx)
      points.append(cy)
    }

    iter var i = 0; i <= steps; i++ {
      var angle = (start + sweep * i / steps) * math.PI / 180

      points.append(cx + angle.cos() * rx)
      points.append(cy + angle.sin() * ry)
    }

    return points
  }

  /**
   * Draws a cubic Bezier curve through four control points.
   *
   * The curve starts at the first point, ends at the fourth, and is
   * pulled toward the two in between without passing through them.
   *
   * @param number x1
   * @param number y1
   * @param number cx1: The first control point's x coordinate.
   * @param number cy1
   * @param number cx2: The second control point's x coordinate.
   * @param number cy2
   * @param number x2
   * @param number y2
   * @param Color|string|number color
   * @param ?dict options: `thickness`.
   * @returns self
   */
  bezier(x1, y1, cx1, cy1, cx2, cy2, x2, y2, color, options) {
    return self._stroke(
      self._bezier_points(x1, y1, cx1, cy1, cx2, cy2, x2, y2),
      color,
      false,
      options
    )
  }

  /**
   * Flattens a cubic Bezier into line segments, using the control
   * polygon's length to decide how many are needed.
   */
  _bezier_points(x1, y1, cx1, cy1, cx2, cy2, x2, y2) {
    var rough = (cx1 - x1).abs() + (cy1 - y1).abs() +
      (cx2 - cx1).abs() + (cy2 - cy1).abs() +
      (x2 - cx2).abs() + (y2 - cy2).abs()

    var steps = (8).max((256).min((rough / 3).ceil()))
    var points = []

    iter var i = 0; i <= steps; i++ {
      var t = i / steps
      var u = 1 - t

      var a = u * u * u
      var b = 3 * u * u * t
      var c = 3 * u * t * t
      var d = t * t * t

      points.append(a * x1 + b * cx1 + c * cx2 + d * x2)
      points.append(a * y1 + b * cy1 + c * cy2 + d * y2)
    }

    return points
  }

  # ------------------------------------------------------------------
  # area fills
  # ------------------------------------------------------------------

  /**
   * Paints every pixel of the surface, ignoring the clip and whatever
   * was there before.
   *
   * This is a replace, not a blend: filling with a transparent colour
   * empties the image rather than leaving it unchanged.
   *
   * @param Color|string|number color
   * @returns self
   */
  fill(color) {
    var paint = Color.parse(color)

    _fill_buffer(self._pixels, paint.r, paint.g, paint.b, paint.a)
    return self
  }

  /**
   * Clears the surface to fully transparent.
   *
   * @returns self
   */
  clear() {
    return self.fill(Color(0, 0, 0, 0))
  }

  /**
   * Flood fills the connected region of similar colour containing
   * `(x, y)`.
   *
   * Similarity is measured against the colour that was at the starting
   * point, as the largest difference across the four channels.
   * `tolerance` is that difference in 0-255 units, so 0 spreads only
   * through exactly equal pixels and 255 fills everything.
   *
   * Filling is four-connected: it spreads up, down, left and right,
   * but not diagonally, so a one-pixel diagonal line holds it back.
   * The fill is never anti-aliased.
   *
   * @param number x
   * @param number y
   * @param Color|string|number color
   * @param ?number tolerance: - Default: 0.
   * @returns self
   */
  flood_fill(x, y, color, tolerance) {
    var px = x.floor()
    var py = y.floor()

    if !self._writable(px, py) {
      return self
    }

    var paint = Color.parse(color)
    var limit = tolerance == nil ? 0 : (0).max(tolerance)

    var buffer = self._pixels
    var width = self._width
    var bounds = self._drawable_bounds()

    var at = (py * width + px) * 4
    var seed = [buffer[at], buffer[at + 1], buffer[at + 2], buffer[at + 3]]

    # Painting the seed colour over itself would never terminate, since
    # every filled pixel still matches.
    if paint.r == seed[0] and paint.g == seed[1] and
       paint.b == seed[2] and paint.a == seed[3] {
      return self
    }

    # Scanline flood fill: each stack entry is a horizontal run to
    # paint, and only the runs above and below it need testing. That
    # visits far fewer pixels than pushing every neighbour.
    var stack = [[px, px, py]]

    while stack.length() > 0 {
      var run = stack.pop()
      var left = run[0]
      var right = run[1]
      var row = run[2]

      # Grow the run outwards before painting it.
      while left - 1 >= bounds[0] and self._matches(left - 1, row, seed, limit) {
        left--
      }

      while right + 1 < bounds[2] and self._matches(right + 1, row, seed, limit) {
        right++
      }

      iter var i = left; i <= right; i++ {
        var to = (row * width + i) * 4

        buffer[to] = paint.r
        buffer[to + 1] = paint.g
        buffer[to + 2] = paint.b
        buffer[to + 3] = paint.a
      }

      if row - 1 >= bounds[1] {
        self._scan_row(stack, left, right, row - 1, seed, limit, bounds)
      }

      if row + 1 < bounds[3] {
        self._scan_row(stack, left, right, row + 1, seed, limit, bounds)
      }
    }

    return self
  }

  /**
   * Finds the runs of still-matching pixels in one row above or below
   * a just-painted run, and pushes each as new work.
   */
  _scan_row(stack, left, right, row, seed, limit, bounds) {
    var run_start = nil

    iter var i = left; i <= right; i++ {
      if self._matches(i, row, seed, limit) {
        if run_start == nil {
          run_start = i
        }
      } else if run_start != nil {
        stack.append([run_start, i - 1, row])
        run_start = nil
      }
    }

    if run_start != nil {
      stack.append([run_start, right, row])
    }
  }

  /**
   * True when a pixel is close enough to the flood fill's seed colour.
   */
  _matches(px, py, seed, limit) {
    if px < 0 or py < 0 or px >= self._width or py >= self._height {
      return false
    }

    var buffer = self._pixels
    var at = (py * self._width + px) * 4

    var dr = (buffer[at] - seed[0]).abs()
    var dg = (buffer[at + 1] - seed[1]).abs()
    var db = (buffer[at + 2] - seed[2]).abs()
    var da = (buffer[at + 3] - seed[3]).abs()

    return dr.max(dg.max(db.max(da))) <= limit
  }


  # ------------------------------------------------------------------
  # gradients
  # ------------------------------------------------------------------

  /**
   * Fills a rectangle with a linear gradient running between two
   * points.
   *
   * The gradient's direction and length are the vector from
   * `(x1, y1)` to `(x2, y2)`. Everything before the first point takes
   * the first stop's colour and everything past the second takes the
   * last stop's, so a short vector across a large area gives a hard
   * transition with flat bands on either side.
   *
   * ```zuri
   * # top to bottom, dark to light
   * image.linear_gradient(0, 0, 0, image.height(), ['#0f172a', '#334155'])
   * ```
   *
   * @param number x1
   * @param number y1
   * @param number x2
   * @param number y2
   * @param list stops: Colours, or `[offset, colour]` pairs with the
   *    offset from 0 to 1.
   * @param ?dict options: `rect` (a `{x, y, width, height}` to confine
   *    the fill to, default the whole surface), `blend` (bool, default
   *    false: composite over what is there rather than replacing it).
   * @returns self
   */
  linear_gradient(x1, y1, x2, y2, stops, options) {
    var ramp = _build_ramp(stops)
    var area = self._gradient_area(options)
    var blend = is_dict(options) ? options.get('blend', false) : false

    var dx = x2 - x1
    var dy = y2 - y1
    var length_squared = dx * dx + dy * dy

    if length_squared == 0 {
      # A zero-length gradient vector: every pixel sits at the far end.
      return self._paint_ramp_linear(area, ramp, blend, x1, y1, 0, 0)
    }

    return self._paint_ramp_linear(area, ramp, blend, x1, y1, dx, dy)
  }

  /**
   * Fills a rectangle with a radial gradient spreading from a centre.
   *
   * ```zuri
   * # a soft vignette
   * image.radial_gradient(cx, cy, radius, [
   *   [0, Color(0, 0, 0, 0)],
   *   [1, Color(0, 0, 0, 180)],
   * ], { blend: true })
   * ```
   *
   * @param number cx: The centre's x coordinate.
   * @param number cy: The centre's y coordinate.
   * @param number radius: Where the last stop lands.
   * @param list stops: Colours, or `[offset, colour]` pairs.
   * @param ?dict options: `rect`, `blend`. The same as
   *    `linear_gradient()`.
   * @returns self
   */
  radial_gradient(cx, cy, radius, stops, options) {
    var ramp = _build_ramp(stops)
    var area = self._gradient_area(options)
    var blend = is_dict(options) ? options.get('blend', false) : false

    if radius <= 0 {
      return self
    }

    return self._paint_ramp_radial(area, ramp, blend, cx, cy, radius)
  }

  /**
   * The rectangle a gradient covers: the `rect` option if there is
   * one, narrowed by the clip and the surface either way.
   */
  _gradient_area(options) {
    var bounds = self._drawable_bounds()

    if !is_dict(options) or options.get('rect') == nil {
      return bounds
    }

    var rect = options.rect

    return [
      bounds[0].max(rect.x.floor()),
      bounds[1].max(rect.y.floor()),
      bounds[2].min((rect.x + rect.width).ceil()),
      bounds[3].min((rect.y + rect.height).ceil()),
    ]
  }

  /**
   * Walks a rectangle, asking `position` where each pixel falls along
   * the gradient and painting the colour the ramp holds there.
   *
   * The ramp is precomputed, so the inner loop is one call, one index
   * and four byte writes: interpolating between stops per pixel would
   * cost several times as much for a result nobody can distinguish at
   * 8 bits.
   */
  /**
   * Paints a gradient ramp over `area`.
   *
   * Hands off to a free function per gradient shape rather than taking
   * a closure for the position. A closure asked once per pixel is a
   * real call a million times over, and the loop body either side of it
   * is only a few array reads; measured on a full-surface gradient the
   * call alone was around a fifth of the total.
   */
  _paint_ramp_linear(area, ramp, blend, x1, y1, dx, dy) {
    _paint_linear(
      self._pixels,
      ramp,
      self._width,
      area[0],
      area[1],
      area[2],
      area[3],
      x1,
      y1,
      dx,
      dy,
      blend != true
    )

    return self
  }

  _paint_ramp_radial(area, ramp, blend, cx, cy, radius) {
    _paint_radial(
      self._pixels,
      ramp,
      self._width,
      area[0],
      area[1],
      area[2],
      area[3],
      cx,
      cy,
      radius,
      blend != true
    )

    return self
  }

  # ------------------------------------------------------------------
  # masks
  # ------------------------------------------------------------------

  /**
   * Paints a colour through an 8-bit coverage mask.
   *
   * The mask is one byte per pixel, 0 for nothing and 255 for full
   * coverage, laid out row-major with no padding. Coverage scales the
   * colour's alpha, so this is how anti-aliased text and any
   * externally rasterized shape reach the surface.
   *
   * @param bytes mask
   * @param number mask_width
   * @param number mask_height
   * @param number x: Where the mask's top-left corner lands.
   * @param number y
   * @param Color|string|number color
   * @returns self
   */
  draw_mask(mask: bytes, mask_width, mask_height, x, y, color) {
    if mask.length() != mask_width * mask_height {
      raise ImageError(
        'mask holds ${mask.length()} bytes, but ${mask_width}x${mask_height} needs ${mask_width * mask_height}'
      )
    }

    var paint = Color.parse(color)
    var at_x = x.floor()
    var at_y = y.floor()

    var bounds = self._drawable_bounds()

    var start_x = bounds[0].max(at_x)
    var start_y = bounds[1].max(at_y)
    var end_x = bounds[2].min(at_x + mask_width)
    var end_y = bounds[3].min(at_y + mask_height)

    if start_x >= end_x or start_y >= end_y {
      return self
    }

    iter var py = start_y; py < end_y; py++ {
      _blend_mask_row(
        self._pixels,
        (py * self._width + start_x) * 4,
        mask,
        (py - at_y) * mask_width + start_x - at_x,
        end_x - start_x,
        paint.r,
        paint.g,
        paint.b,
        paint.a
      )
    }

    return self
  }
}


/**
 * Turns a stop list into a 256-entry RGBA ramp.
 *
 * Stops may be bare colours, spaced evenly, or `[offset, colour]`
 * pairs with the offset running 0 to 1. Pairs need not be in order.
 * A single stop gives a flat ramp of that colour.
 *
 * Precomputing the ramp is what keeps a gradient's inner loop to an
 * index and four byte writes rather than an interpolation per pixel.
 */
def _build_ramp(stops: list) {
  if stops.length() == 0 {
    raise ImageError('a gradient needs at least one colour stop')
  }

  var offsets = []
  var paints = []

  iter var i = 0; i < stops.length(); i++ {
    var entry = stops[i]

    # A two-element list is ambiguous: [0.5, 'red'] is a stop, but
    # [255, 0] would be a malformed colour. A leading number settles it.
    if is_list(entry) and entry.length() == 2 and is_number(entry[0]) and
       !is_number(entry[1]) {
      offsets.append((0).max((1).min(entry[0])))
      paints.append(Color.parse(entry[1]))
      continue
    }

    offsets.append(stops.length() == 1 ? 0 : i / (stops.length() - 1))
    paints.append(Color.parse(entry))
  }

  # Insertion sort by offset; a gradient has a handful of stops, and
  # list.sort() takes no comparator.
  iter var i = 1; i < offsets.length(); i++ {
    var offset = offsets[i]
    var paint = paints[i]
    var j = i - 1

    while j >= 0 and offsets[j] > offset {
      offsets[j + 1] = offsets[j]
      paints[j + 1] = paints[j]
      j--
    }

    offsets[j + 1] = offset
    paints[j + 1] = paint
  }

  var ramp = bytes(256 * 4)
  var index = 0

  iter var step = 0; step < 256; step++ {
    var t = step / 255

    # Advance to the segment this position falls in.
    while index < offsets.length() - 2 and t > offsets[index + 1] {
      index++
    }

    var paint = paints[index]

    if paints.length() > 1 {
      var low = offsets[index]
      var high = offsets[index + 1]
      var span = high - low
      var local = span <= 0 ? 0 : (0).max((1).min((t - low) / span))

      paint = paints[index].mix(paints[index + 1], local)
    }

    var at = step * 4

    ramp[at] = paint.r
    ramp[at + 1] = paint.g
    ramp[at + 2] = paint.b
    ramp[at + 3] = paint.a
  }

  return ramp
}


# ---------------------------------------------------------------------
# The per-pixel inner loops
# ---------------------------------------------------------------------
#
# These are ordinary functions rather than methods, and their buffers
# are annotated `bytes`, for one reason: the JIT can prove a typed
# parameter's shape and drop the guard in front of every indexed
# access, and it cannot do the same for a value read out of a field.
# That is worth the indirection on exactly the paths that touch every
# pixel, and nowhere else.
#
# All of them index without bounds checks. Their callers have already
# clipped, which is what makes that safe and is why none of them is
# part of the public surface.


/**
 * Source-over compositing of one pixel already known to be in range.
 *
 * The single place colour reaches a buffer. Straight (not
 * premultiplied) alpha, everything in 0-255 fixed point.
 */
def _blend_at(pixels: bytes, at: number, r: number, g: number, b: number, a: number) {
  if a >= 255 {
    pixels[at] = r.round()
    pixels[at + 1] = g.round()
    pixels[at + 2] = b.round()
    pixels[at + 3] = 255
    return
  }

  var under = pixels[at + 3]

  # Nothing underneath to composite against, so the source lands as it
  # is. The alpha still has to be rounded: coverage from an
  # anti-aliased edge arrives fractional.
  if under == 0 {
    pixels[at] = r.round()
    pixels[at + 1] = g.round()
    pixels[at + 2] = b.round()
    pixels[at + 3] = a.round()
    return
  }

  # out_a = src_a + dst_a * (1 - src_a)
  var out_a = a + under * (255 - a) / 255

  if out_a <= 0 {
    pixels[at] = 0
    pixels[at + 1] = 0
    pixels[at + 2] = 0
    pixels[at + 3] = 0
    return
  }

  var src_weight = a * 255 / out_a
  var dst_weight = 255 - src_weight

  pixels[at] = ((r * src_weight + pixels[at] * dst_weight) / 255).round()
  pixels[at + 1] = ((g * src_weight + pixels[at + 1] * dst_weight) / 255).round()
  pixels[at + 2] = ((b * src_weight + pixels[at + 2] * dst_weight) / 255).round()
  pixels[at + 3] = out_a.round()
}


/**
 * Blends one rasterized run, scaling the paint's alpha by the coverage
 * accumulated for each pixel.
 */
def _blend_coverage(
  pixels: bytes,
  at: number,
  offset: number,
  count: number,
  coverage: list,
  r: number,
  g: number,
  b: number,
  a: number
) {
  iter var i = 0; i < count; i++ {
    var amount = coverage[offset + i]

    # Below this the contribution rounds away to nothing, and skipping
    # it saves the whole blend on the many empty pixels a shape's
    # bounding box contains.
    if amount <= 0.002 {
      continue
    }

    if amount > 1 {
      amount = 1
    }

    _blend_at(pixels, at + i * 4, r, g, b, a * amount)
  }
}


/**
 * Blends one row of an 8-bit coverage mask, which is how text and any
 * externally rasterized shape reach the surface.
 */
def _blend_mask_row(
  pixels: bytes,
  at: number,
  mask: bytes,
  mask_at: number,
  count: number,
  r: number,
  g: number,
  b: number,
  a: number
) {
  iter var i = 0; i < count; i++ {
    var coverage = mask[mask_at + i]

    if coverage == 0 {
      continue
    }

    _blend_at(pixels, at + i * 4, r, g, b, a * coverage / 255)
  }
}


/**
 * Writes one colour over every pixel of a buffer.
 */
def _fill_buffer(pixels: bytes, r: number, g: number, b: number, a: number) {
  var total = pixels.length()

  iter var at = 0; at < total; at += 4 {
    pixels[at] = r
    pixels[at + 1] = g
    pixels[at + 2] = b
    pixels[at + 3] = a
  }
}


/**
 * Copies one pixel between two buffers.
 */
/**
 * Paints a linear gradient over the given area.
 *
 * The ramp lookup and the four writes are spelled out in the loop
 * rather than factored into helpers. At one call per pixel the call
 * itself costs several times the work it wraps, because the JIT's
 * inliner only takes leaf functions whose every argument is a proven
 * number and a `bytes` buffer is not one.
 *
 * A zero-length gradient vector leaves every pixel at the far end of
 * the ramp, which is what the projection converges to.
 */
def _paint_linear(
  buffer: bytes,
  ramp: bytes,
  width: number,
  left: number,
  top: number,
  right: number,
  bottom: number,
  x1: number,
  y1: number,
  dx: number,
  dy: number,
  replace: bool
) {
  var length_squared = dx * dx + dy * dy
  var flat = length_squared == 0

  iter var py = top; py < bottom; py++ {
    var row = py * width * 4
    var oy = py + 0.5 - y1

    iter var px = left; px < right; px++ {
      var step = flat ? 255 : (((px + 0.5 - x1) * dx + oy * dy) / length_squared * 255).round()

      if step < 0 {
        step = 0
      } else if step > 255 {
        step = 255
      }

      var from = step * 4

      var at = row + px * 4

      if replace {
        buffer[at] = ramp[from]
        buffer[at + 1] = ramp[from + 1]
        buffer[at + 2] = ramp[from + 2]
        buffer[at + 3] = ramp[from + 3]
        continue
      }

      _blend_at(buffer, at, ramp[from], ramp[from + 1], ramp[from + 2], ramp[from + 3])
    }
  }
}


/**
 * Paints a radial gradient over the given area, the ramp running from
 * the centre outwards and clamping past `radius`.
 */
def _paint_radial(
  buffer: bytes,
  ramp: bytes,
  width: number,
  left: number,
  top: number,
  right: number,
  bottom: number,
  cx: number,
  cy: number,
  radius: number,
  replace: bool
) {
  iter var py = top; py < bottom; py++ {
    var row = py * width * 4
    var oy = py + 0.5 - cy
    var oy2 = oy * oy

    iter var px = left; px < right; px++ {
      var ox = px + 0.5 - cx
      var step = ((ox * ox + oy2).sqrt() / radius * 255).round()

      if step < 0 {
        step = 0
      } else if step > 255 {
        step = 255
      }

      var from = step * 4
      var at = row + px * 4

      if replace {
        buffer[at] = ramp[from]
        buffer[at + 1] = ramp[from + 1]
        buffer[at + 2] = ramp[from + 2]
        buffer[at + 3] = ramp[from + 3]
        continue
      }

      _blend_at(buffer, at, ramp[from], ramp[from + 1], ramp[from + 2], ramp[from + 3])
    }
  }
}
