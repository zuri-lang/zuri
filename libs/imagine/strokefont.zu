/**
 * What an unmapped character draws: an empty box, the same convention
 * a font uses for a glyph it does not have.
 */
var NOTDEF = { advance: 11, strokes: [
  _l(1.5, 0, 9.5, 0, 9.5, 13, 1.5, 13, 1.5, 0),
] }


/**
 * The built-in font: a sans-serif drawn from centre-line strokes
 * rather than loaded from a file.
 *
 * `imagine` deliberately ships no font file, so
 * [[imagine.Font.system]] and [[imagine.Font.sans]] both depend on
 * what happens to be installed. This one is always there. It is
 * defined as geometry in [[imagine.strokefont]], drawn through the
 * same anti-aliased rasterizer everything else uses, and therefore
 * scales cleanly to any size and takes a weight as a parameter.
 *
 * ```zuri
 * import imagine { Image, StrokeFont }
 *
 * Image(300, 80, 'white')
 *   .text(16, 22, 'Always available', StrokeFont(28), '#0f172a')
 *   .save('label.png')
 * ```
 *
 * It has the same interface as [[imagine.Font]], so anywhere a font is
 * accepted this can be used instead.
 *
 * ## What it is for
 *
 * Labels, chart axes, watermarks, diagrams, placeholder text, and any
 * output that has to work on a machine with no fonts installed. The
 * look is geometric and single-weight, closer to a technical drawing
 * than to a typeface, because that is what centre-line strokes give
 * you honestly.
 *
 * It is not a substitute for real typography. For body text, a
 * headline, or anything where the shapes matter, load an actual font
 * with [[imagine.Font.load]].
 *
 * ## Coverage
 *
 * Printable ASCII, from space through `~`. Anything else draws the
 * empty box a font uses for a glyph it does not have, so text in
 * another script comes out visibly missing rather than silently blank.
 *
 * @printable
 */
class StrokeFont {

  var _size
  var _weight

  /**
   * Creates the built-in font at a size.
   *
   * @param ?number size: The size in pixels - Default: 16.
   * @param ?number weight: The stroke width, as a fraction of the size
   *    - Default: 0.085, a regular weight. Around 0.13 reads as bold.
   */
  @new(size: ?number, weight: ?number) {
    var pixels = size == nil ? 16 : size

    if pixels <= 0 or pixels > 4096 {
      raise FontError('font size must be between 1 and 4096 pixels, got ${size}')
    }

    if weight != nil and weight <= 0 {
      raise FontError('font weight must be greater than zero, got ${weight}')
    }

    self._size = pixels
    self._weight = weight == nil ? WEIGHT / EM : weight
  }

  /**
   * Returns the same font at a different size.
   *
   * @param number pixels
   * @returns StrokeFont
   */
  size(pixels) {
    return StrokeFont(pixels, self._weight)
  }

  /**
   * Returns the same font at a different stroke weight.
   *
   * @param number weight: A fraction of the size. 0.085 is regular,
   *    0.13 reads as bold, 0.05 as light.
   * @returns StrokeFont
   */
  weight(weight) {
    return StrokeFont(self._size, weight)
  }

  /**
   * The size in pixels this font draws at.
   *
   * @returns number
   */
  pixel_size() {
    return self._size
  }

  /**
   * The font's name.
   *
   * @returns string
   */
  name() {
    return 'Imagine Stroke'
  }

  /**
   * Where this font came from.
   *
   * @returns string
   */
  source() {
    return '<built-in>'
  }

  /**
   * `true` when this font has a glyph for a character, which for the
   * built-in font means printable ASCII.
   *
   * @param string character
   * @returns bool
   */
  has_glyph(character) {
    return GLYPHS.contains(character)
  }

  /**
   * The font's vertical metrics at its current size, in pixels.
   *
   * The dictionary holds `name`, `ascent`, `descent` (negative),
   * `line_gap` and `line_height`, the same shape [[imagine.Font]]
   * reports. The em is the size, so single-spaced lines sit exactly
   * `size` pixels apart.
   *
   * @returns dict
   */
  metrics() {
    var scale = self._size / EM

    var name = self.name()
    var ascent = ASCENDER * scale
    var descent = DESCENDER * scale
    var line_gap = 0
    var line_height = (ASCENDER - DESCENDER) * scale

    return { name, ascent, descent, line_gap, line_height }
  }

  /**
   * Breaks a string into lines that fit within a width, returning the
   * text with newlines inserted.
   *
   * @param string text
   * @param number width: The maximum line width in pixels.
   * @param ?dict options: `tracking`.
   * @returns string
   */
  wrap(text, width: number, options) {
    if width <= 0 {
      raise FontError('wrap width must be greater than zero, got ${width}')
    }

    var content = text.to_string()
    var wrapped = []

    for paragraph in content.split('\n') {
      var line = ''

      for word in paragraph.split(' ') {
        if word == '' {
          continue
        }

        var candidate = line == '' ? word : line + ' ' + word

        if self._width_of(candidate, options) <= width {
          line = candidate
          continue
        }

        if line != '' {
          wrapped.append(line)
          line = ''
        }

        if self._width_of(word, options) > width {
          var piece = ''

          iter var i = 0; i < word.length(); i++ {
            var grown = piece + word[i]

            if piece != '' and self._width_of(grown, options) > width {
              wrapped.append(piece)
              piece = word[i]
            } else {
              piece = grown
            }
          }

          line = piece
          continue
        }

        line = word
      }

      wrapped.append(line)
    }

    return '\n'.join(wrapped)
  }

  /**
   * Measures a string without drawing it.
   *
   * Returns `width`, `height`, `baseline` (the first line's baseline,
   * measured down from the top of the box) and `lines`.
   *
   * @param string text
   * @param ?dict options: `tracking`, `line_height`, `align`.
   * @returns dict
   */
  measure(text, options) {
    var laid = self._layout(text, options)

    var width = laid.width.ceil()
    var height = laid.height.ceil()
    var baseline = laid.ascent
    var lines = laid.lines.length()

    return { width, height, baseline, lines }
  }

  /**
   * Rasterizes a string into an 8-bit coverage mask.
   *
   * Returns `coverage`, `width`, `height` and `baseline`, the same
   * shape [[imagine.Font]] returns, which is what lets both be handed
   * to `Image.text()` interchangeably.
   *
   * @param string text
   * @param ?dict options: `tracking`, `line_height`, `align`.
   * @returns dict
   */
  render(text, options) {
    var laid = self._layout(text, options)
    var scale = self._size / EM

    # Strokes are centred on the path and joints are round, so a glyph
    # paints up to half a stroke beyond its box. The mask is grown to
    # hold that, and the padding is folded into the reported baseline
    # exactly as the loaded-font path does it.
    var padding = (self._size * 0.5).ceil()

    var width = (laid.width.ceil() + padding * 2).max(1)
    var height = (laid.height.ceil() + padding * 2).max(1)

    # Drawn white on transparent, then reduced to its alpha channel:
    # colour belongs to whoever is drawing, not to the glyphs.
    var sheet = Canvas(bytes(width * height * 4), width, height)
    sheet.thickness((self._size * self._weight).max(0.8))

    var ink = Color(255, 255, 255, 255)

    iter var index = 0; index < laid.lines.length(); index++ {
      var line = laid.lines[index]
      var baseline = padding + laid.ascent + laid.step * index

      var pen = padding + laid.offsets[index]

      for character in line {
        var glyph = GLYPHS.get(character, NOTDEF)

        for stroke in glyph.strokes {
          sheet.polyline(_place(stroke, pen, baseline, scale), ink)
        }

        pen += glyph.advance * scale + laid.tracking
      }
    }

    var coverage = _alpha_of(sheet.pixels())

    return {
      coverage,
      width,
      height,
      baseline: padding + laid.ascent,
    }
  }

  /**
   * The advance width of one line, in pixels.
   */
  _width_of(text, options) {
    var scale = self._size / EM
    var tracking = is_dict(options) ? options.get('tracking', 0) : 0

    var width = 0
    var count = 0

    for character in text {
      width += GLYPHS.get(character, NOTDEF).advance * scale
      count++
    }

    if count > 1 {
      width += tracking * (count - 1)
    }

    return width.max(0)
  }

  /**
   * Splits the text into lines and works out the block's size, the
   * baseline of its first line, and each line's horizontal offset
   * under the requested alignment.
   */
  _layout(text, options) {
    var scale = self._size / EM
    var tracking = is_dict(options) ? options.get('tracking', 0) : 0
    var spacing = is_dict(options) ? options.get('line_height', 1) : 1
    var align = is_dict(options) ? options.get('align', 'left') : 'left'

    if align != 'left' and align != 'center' and
       align != 'centre' and align != 'right' {
      raise FontError("unknown text alignment '${align}', expected left, center or right")
    }

    var lines = text.to_string().split('\n')
    var widths = []
    var width = 0

    for line in lines {
      var measured = self._width_of(line, options)

      widths.append(measured)
      width = width.max(measured)
    }

    var natural = (ASCENDER - DESCENDER) * scale
    var step = natural * spacing.max(0)

    var height = lines.length() <= 1 ?
      natural :
      step * (lines.length() - 1) + natural

    var offsets = []

    for measured in widths {
      if align == 'right' {
        offsets.append(width - measured)
      } else if align == 'center' or align == 'centre' {
        offsets.append((width - measured) / 2)
      } else {
        offsets.append(0)
      }
    }

    return {
      lines,
      widths,
      offsets,
      width,
      height,
      step,
      tracking,
      ascent: ASCENDER * scale,
    }
  }

  to_string() {
    return '<StrokeFont built-in at ${self._size}px>'
  }

  @to_string() {
    return self.to_string()
  }
}


/**
 * Places one stroke on the sheet: design units, y up from the
 * baseline, become pixels with y down from the top.
 */
def _place(stroke, pen, baseline, scale) {
  var points = []
  var count = stroke.length()

  iter var i = 0; i < count; i += 2 {
    points.append(pen + stroke[i] * scale)
    points.append(baseline - stroke[i + 1] * scale)
  }

  return points
}


/**
 * The alpha channel of an RGBA buffer, as a coverage mask.
 *
 * A typed free function for the reason given at the bottom of
 * canvas.zu: this walks every pixel of the glyph sheet.
 */
def _alpha_of(pixels: bytes) {
  var total = pixels.length()
  var mask = bytes(total / 4)
  var out = 0

  iter var at = 3; at < total; at += 4 {
    mask[out] = pixels[at]
    out++
  }

  return mask
}
