#!-- part of the imagine module

import .canvas { Canvas }
import .color { Color }
import .errors { FontError }


# ---------------------------------------------------------------------
# Design grid
# ---------------------------------------------------------------------
#
# Glyphs are drawn on a grid with the baseline at y = 0 and y running
# UP, which is how type is normally drawn and keeps the data readable.
# The renderer flips it when it puts the glyph on an image.
#
# The em is 20 units, and the vertical proportions below are the
# conventional ones for a sans-serif, scaled to that em. Everything a
# glyph is built from is expressed in these units, so a glyph is
# resolution-independent: it is drawn at whatever size is asked for
# rather than scaled up from a fixed bitmap.

/**
 * The em square's height in design units. A font asked for 20 pixels
 * draws its em at 20 pixels, so `scale` is simply `size / EM`.
 *
 * @type number
 */
var EM = 20

/**
 * The height of a capital letter.
 *
 * @type number
 */
var CAP_HEIGHT = 14

/**
 * The height of a lowercase letter with no ascender.
 *
 * @type number
 */
var X_HEIGHT = 10

/**
 * How far the tallest glyphs rise above the baseline.
 *
 * @type number
 */
var ASCENDER = 15

/**
 * How far descenders fall below the baseline, as a negative number.
 *
 * @type number
 */
var DESCENDER = -5

/**
 * The default stroke width in design units, a little under a tenth of
 * the em, which is the usual weight for a regular sans-serif.
 *
 * @type number
 */
var WEIGHT = 1.7


# ---------------------------------------------------------------------
# Glyph construction
# ---------------------------------------------------------------------
#
# Every glyph is a list of open polylines in design units, drawn as
# centre-line strokes rather than filled outlines. That is what keeps
# the data small enough to read: a letter is a handful of points rather
# than a pair of contours, and its weight is a rendering parameter
# instead of part of the shape.
#
# The three builders below are evaluated once when this module loads,
# so the curved letters are stored as real point lists and cost nothing
# to draw.


/**
 * A polyline from a flat run of coordinates.
 */
def _l(...points) {
  return points
}


/**
 * Points along an elliptical arc, in degrees measured anticlockwise
 * from three o'clock, on the y-up design grid.
 *
 * The sweep may run either way: `_a(cx, cy, r, r, 90, -90)` goes over
 * the right-hand side and `_a(cx, cy, r, r, 90, 270)` over the left.
 */
def _a(cx, cy, rx, ry, from_angle, to_angle) {
  var sweep = to_angle - from_angle
  var steps = (8).max((sweep.abs() / 8).ceil())

  var points = []

  iter var i = 0; i <= steps; i++ {
    var angle = (from_angle + sweep * i / steps) * 3.141592653589793 / 180

    points.append(cx + angle.cos() * rx)
    points.append(cy + angle.sin() * ry)
  }

  return points
}


/**
 * A closed ellipse, as one polyline that returns to its start.
 */
def _o(cx, cy, rx, ry) {
  return _a(cx, cy, rx, ry, 0, 360)
}


/**
 * Concatenates several point runs into one continuous polyline, so a
 * letter built from a straight and a curve is stroked as a single path
 * with no seam where they meet.
 */
def _join(...runs) {
  var points = []

  for run in runs {
    for value in run {
      points.append(value)
    }
  }

  return points
}


/**
 * Every glyph, keyed by character.
 *
 * `advance` is how far the pen moves after drawing, in design units.
 * `strokes` is a list of polylines.
 */
var GLYPHS = {

