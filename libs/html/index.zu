/**
 * @module html
 *
 * An HTML5 parser, DOM and serializer, following the [WHATWG HTML
 * Living Standard](https://html.spec.whatwg.org/multipage/).
 *
 * You can parse a page, walk through it, query it with CSS selectors,
 * change it, and write it out again. Nothing here fetches anything over
 * the network or runs any scripts. The content of a `<script>` element
 * is just text.
 *
 * ### A first example
 *
 * ```zuri
 * import html
 *
 * var doc = html.parse('
 *   <article>
 *     <h1 id="title">Zuri</h1>
 *     <ul class="links">
 *       <li><a href="/docs">Docs</a>
 *       <li><a href="/spec">Spec</a>
 *     </ul>
 *   </article>
 * ')
 *
 * echo doc.get_element_by_id('title').text_content()
 *
 * for link in doc.query_selector_all('ul.links a') {
 *   echo '${link.text_content()} -> ${link.get_attribute("href")}'
 * }
 * ```
 *
 * Neither `<li>` is closed, and there's no `<html>`, `<head>` or
 * `<body>` anywhere. That's fine. The standard defines a tree for every
 * possible input, and this module builds it, so parsing never raises an
 * error on malformed markup.
 *
 * ### Finding elements
 *
 * | Method                          | Finds                        |
 * | ------------------------------- | ---------------------------- |
 * | `get_element_by_id(id)`         | the first element with that id |
 * | `get_elements_by_class_name(c)` | every element with those classes |
 * | `get_elements_by_tag_name(t)`   | every element with that tag  |
 * | `query_selector(sel)`           | the first match for a CSS selector |
 * | `query_selector_all(sel)`       | every match for a CSS selector |
 * | `element.matches(sel)`          | whether this element matches |
 * | `element.closest(sel)`          | this element or its nearest ancestor that matches |
 *
 * The selector syntax is an intentionally limited subset: type, `*`,
 * `#id`, `.class`, `[attr]`, `[attr="value"]`, the combinators `>`, `+`
 * and `~`, descendant selectors separated by whitespace,
 * `:first-child`, `:last-child`, `:nth-child()`, and comma-separated
 * lists of all of those. Anything else raises a `SelectorError`,
 * instead of silently matching nothing.
 *
 * ### Changing a document
 *
 * ```zuri
 * import html
 *
 * var doc = html.parse('<div class="box"><p>old</p></div>')
 * var box = doc.query_selector('.box')
 *
 * box.set_attribute('data-seen', 'yes')
 * box.class_list().add('active')
 * box.set_inner_html('<p>new</p>')
 *
 * echo box.outer_html()
 * # <div class="box active" data-seen="yes"><p>new</p></div>
 * ```
 *
 * Zuri doesn't have property setters, so every writable DOM property is
 * a pair of methods: `text_content()` reads it and `set_text_content()`
 * writes it, and the same goes for `inner_html` and `outer_html`.
 *
 * ### Writing it out
 *
 * `outer_html()` reproduces a node exactly. When you want the output
 * shaped for a particular reader, `minify()` removes what a browser
 * doesn't need, and `format()` indents it for a person.
 *
 * A string is parsed as a whole document, so `<html>`, `<head>` and
 * `<body>` appear in the output, as a browser would produce them. Pass
 * `{ fragment: true }` when the input is a fragment and you only want
 * that fragment back:
 *
 * ```zuri-repl
 * %> import html
 * %> html.minify('<p>  a   b  </p>\\n<p>c</p>', { fragment: true })
 * '<p>a b</p><p>c</p>'
 * %> echo html.format('<ul><li>a<li>b</ul>', { fragment: true })
 * <ul>
 *   <li>a</li>
 *   <li>b</li>
 * </ul>
 * ```
 *
 * ### Escaping
 *
 * `encode()` makes text safe to include in a document, and `decode()`
 * resolves character references. Decoding knows all 2231 named
 * references, not just a shortlist:
 *
 * ```zuri-repl
 * %> import html
 * %> html.encode('<b>Tom & Jerry</b>')
 * '&lt;b&gt;Tom &amp; Jerry&lt;/b&gt;'
 * %> html.decode('caf&eacute; &#169; &#x2603;')
 * 'café © ☃'
 * ```
 *
 * ### Character encoding
 *
 * The input is UTF-8 text that has already been decoded, which a Zuri
 * string always is. There's no character set detection, no byte order
 * mark handling and no `<meta charset>` processing. If you're reading
 * bytes from a socket, decode them before passing them here.
 *
 * ### Parse errors
 *
 * HTML has no fatal errors, so parsing always succeeds. Every
 * conformance problem that the standard defines is collected instead:
 *
 * ```zuri-repl
 * %> import html
 * %> var doc = html.parse('<p><b>x</p>')
 * %> for e in doc.errors { echo e.to_string() }
 * missing-doctype at 1:1
 * unexpected-end-tag at 1:8
 * ```
 *
 * Each entry has the standard's own name for the error, so you can look
 * it up, along with the line and column where it was found.
 *
 * @copyright 2026, Richard Ore and The Zuri Contributors
 */

import @.namespaces { * }
import @.node { * }
import @.selector { Selector, SelectorError, compile }
import @.tokenizer { Token, ParseError, Tokenizer, tokenize }
import @.parser { TreeBuilder, parse, parse_file, parse_fragment }
import @.entities { encode, decode, escape_text, escape_attribute }
import @.serialize { minify, format }

import @.entities
import @.selector
import @.serialize
import @.tokenizer
import @.parser
import @.elements
import @.namespaces
