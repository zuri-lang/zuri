/**
 * @module bcrypt
 *
 * Creates and verifies bcrypt password hashes, and reads the cost
 * factor and salt from an existing hash.
 *
 * Most programs only need `hash()` and `compare()`: hash a password
 * before storing it, and later compare a login attempt with the stored
 * hash. The salt is generated from a cryptographically secure random
 * source, stored in the returned hash string, and never needs to be
 * handled separately.
 *
 * For example:
 *
 * ```zuri-repl
 * %> import bcrypt
 * %> var stored = bcrypt.hash('correct horse battery staple')
 * %> stored
 * '$2b$10$N9qo8uLOickgx2ZMRZoMy.MrqmVwj0dJmwB3vk...'
 * %> bcrypt.compare('correct horse battery staple', stored)
 * true
 * %> bcrypt.compare('wrong password', stored)
 * false
 * ```
 *
 * @copyright 2022, Richard Ore and The Zuri Contributors
 */

import _crypto

/**
 * The cost factor that `hash()` uses when `rounds` isn't given. A
 * higher value makes hashes slower to compute, and so slower to attack
 * by brute force. Each step up roughly doubles the work. `10` is a
 * reasonable default for an interactive login. Increase it over time as
 * hardware gets faster (see `needs_rehash()`).
 *
 * @type number
 */
var DEFAULT_LOG2_ROUNDS = 10

/**
 * Hashes `str` with bcrypt, generating a fresh random salt
 * internally on every call: hashing the same string twice always
 * produces two different (but equally valid) hashes.
 *
 * @param string str
 * @param ?number rounds: The cost factor, `4`-`31`. Default
 *    `DEFAULT_LOG2_ROUNDS`.
 * @returns string
 * @raises Error if `rounds` is out of range.
 */
def hash(str: string, rounds: ?number) {
  if rounds == nil {
    rounds = DEFAULT_LOG2_ROUNDS
  }

  return _crypto.bcrypt_hash(str, rounds)
}

/**
 * Checks whether `str` is the password that `known_hash` was created
 * from.
 *
 * @param string str
 * @param string known_hash
 * @returns bool: `false` for a wrong password, and also `false`,
 *    instead of an error, for a `known_hash` that isn't a well-formed
 *    bcrypt hash at all.
 */
def compare(str: string, known_hash: string) {
  return _crypto.bcrypt_verify(str, known_hash)
}

/**
 * Reads the cost factor a hash was generated with back out of it.
 *
 * @param string hash
 * @returns number
 * @raises Error if `hash` isn't a well-formed bcrypt hash.
 */
def get_rounds(hash: string) {
  return hash.split('$')[2].to_number()
}

/**
 * Reads the salt from a hash, which is the first 29 characters,
 * covering the `$2x$rounds$salt` prefix.
 *
 * @note This doesn't check that `hash` is a well-formed bcrypt hash.
 *    Call `get_rounds()` first if you need that checked.
 * @param string hash
 * @returns string
 * @raises Error if `hash` is shorter than a real bcrypt hash.
 */
def get_salt(hash: string) {
  if hash.length() != 60 {
    raise ValueError('illegal hash length: ${hash.length()} != 60')
  }
  return hash[,29]
}

/**
 * Checks whether a stored hash was generated with a lower cost
 * factor than `target_rounds`, meaning it should be re-hashed (at
 * the user's next successful login, typically) to bring it up to
 * the current standard.
 *
 * Example,
 *
 * ```zuri-repl
 * %> if bcrypt.compare(password, user.password_hash) {
 * ..   if bcrypt.needs_rehash(user.password_hash, 12) {
 * ..     user.password_hash = bcrypt.hash(password, 12)
 * ..   }
 * ..   # ... proceed with login
 * .. }
 * ```
 *
 * @param string hash
 * @param number target_rounds
 * @returns bool
 */
def needs_rehash(hash: string, target_rounds: number) {
  return get_rounds(hash) < target_rounds
}
