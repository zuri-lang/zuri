/**
 * @module messages
 *
 * Framing for the PostgreSQL wire protocol, version 3.
 *
 * Every message is a one byte tag, a four byte big-endian length that
 * counts itself, and then the body. The one exception is the startup
 * message, which has no tag because the server has not yet been told
 * which protocol version is in use.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import ..errors { ConnectionError }
import .types { write_int16, write_int32, read_uint32 }

/**
 * Messages the server sends, by tag.
 */
var AUTHENTICATION = 'R'
var BACKEND_KEY_DATA = 'K'
var BIND_COMPLETE = '2'
var CLOSE_COMPLETE = '3'
var COMMAND_COMPLETE = 'C'
var COPY_IN_RESPONSE = 'G'
var COPY_OUT_RESPONSE = 'H'
var COPY_DATA = 'd'
var COPY_DONE = 'c'
var DATA_ROW = 'D'
var EMPTY_QUERY_RESPONSE = 'I'
var ERROR_RESPONSE = 'E'
var NO_DATA = 'n'
var NOTICE_RESPONSE = 'N'
var NOTIFICATION_RESPONSE = 'A'
var PARAMETER_DESCRIPTION = 't'
var PARAMETER_STATUS = 'S'
var PARSE_COMPLETE = '1'
var PORTAL_SUSPENDED = 's'
var READY_FOR_QUERY = 'Z'
var ROW_DESCRIPTION = 'T'

/**
 * Authentication requests, by the number that follows the tag.
 */
var AUTH_OK = 0
var AUTH_CLEARTEXT = 3
var AUTH_MD5 = 5
var AUTH_SASL = 10
var AUTH_SASL_CONTINUE = 11
var AUTH_SASL_FINAL = 12

/**
 * The protocol version this adapter speaks: 3.0, as a single number
 * with the major version in the high half.
 */
var PROTOCOL_VERSION = 196608

/**
 * The number the server recognises as a request to start TLS. It takes
 * the place of a protocol version in a startup-shaped message.
 */
var SSL_REQUEST = 80877103

/**
 * Builds one outgoing message.
 *
 * The body accumulates as bytes and `frame()` puts the tag and length
 * on the front, since the length cannot be known until the body is
 * finished.
 */
class Writer {
  var _bytes = bytes(0)

  /**
   * Appends one byte.
   *
   * @param number value
   * @returns Writer This writer, so calls chain.
   */
  byte(value: number) {
    self._bytes.append(value & 0xff)

    return self
  }

  /**
   * Appends a big-endian 16 bit integer.
   *
   * @param number value
   * @returns Writer
   */
  int16(value: number) {
    self._bytes.extend(write_int16(value))

    return self
  }

  /**
   * Appends a big-endian 32 bit integer.
   *
   * @param number value
   * @returns Writer
   */
  int32(value: number) {
    self._bytes.extend(write_int32(value))

    return self
  }

  /**
   * Appends a string and the zero byte that ends it.
   *
   * @param string value
   * @returns Writer
   */
  cstring(value: string) {
    self._bytes.extend(value.to_bytes())
    self._bytes.append(0)

    return self
  }

  /**
   * Appends raw bytes.
   *
   * @param bytes|list values The bytes, or a list of byte values.
   * @returns Writer
   */
  raw(values) {
    self._bytes.extend(is_list(values) ? bytes(values) : values)

    return self
  }

  /**
   * How many bytes the body holds so far.
   *
   * @returns number
   */
  length() {
    return self._bytes.length()
  }

  /**
   * The finished message, ready to send.
   *
   * @param string|nil tag The message's tag, or nil for a startup
   *    message, which has none.
   * @returns bytes
   */
  frame(tag) {
    var out = bytes(0)

    if tag != nil {
      out.append(tag.ord())
    }

    # The length counts itself but not the tag.
    out.extend(write_int32(self._bytes.length() + 4))
    out.extend(self._bytes)

    return out
  }
}

/**
 * A finished message from a body already built.
 *
 * The same framing `Writer.frame()` gives, for a body put together
 * without a `Writer`.
 *
 * @param string tag
 * @param bytes body
 * @returns bytes
 */
def frame(tag: string, body: bytes) {
  var out = bytes(0)

  out.append(tag.ord())
  out.extend(write_int32(body.length() + 4))
  out.extend(body)

  return out
}

/**
 * How much a `Reader` asks the stream for at a time.
 */
var READ_SIZE = 65536

/**
 * Reads framed messages from a connected stream.
 *
 * Works over a plain `TcpStream` or a `TlsStream` without caring
 * which, since both read the same way. Reads are buffered: one read
 * from the stream usually brings in every message of a reply, and the
 * messages are then taken from the buffer.
 */
class Reader {
  var _stream

  /**
   * What has been read from the stream and not yet taken, with the
   * body of the message `next_message()` last returned inside it.
   *
   * Valid until the next read, which may replace it.
   *
   * @type bytes
   */
  var buffer = bytes(0)

  /**
   * Where the body of the message `next_message()` last returned
   * starts in `buffer`.
   *
   * @type number
   */
  var start = 0

  /**
   * Where that body ends in `buffer`, exclusive.
   *
   * @type number
   */
  var end = 0

  var _at = 0

  /**
   * @param TcpStream|TlsStream stream An already-connected stream.
   */
  @new(stream) {
    self._stream = stream
  }

  /**
   * Swaps the stream, for the point in the handshake where a plain
   * connection becomes a TLS one.
   *
   * @param TlsStream stream
   * @throws ConnectionError if bytes the server sent before the
   *    handshake are still unread. They arrived in the clear, so
   *    nothing that follows may treat them as protected.
   */
  upgrade(stream) {
    if self._at < self.buffer.length() {
      raise ConnectionError(
        'the server sent data before the TLS handshake finished',
        { driver: 'postgres' },
      )
    }

    self._stream = stream
    self.buffer = bytes(0)
    self._at = 0
  }

  /**
   * Reads exactly `count` bytes, waiting for as many as it takes.
   *
   * @param number count
   * @returns bytes
   * @throws ConnectionError if the server closes first.
   */
  read_exact(count: number) {
    if count == 0 {
      return bytes(0)
    }

    self._fill(count)

    var at = self._at
    self._at = at + count

    return self.buffer[at, at + count]
  }

  /**
   * Reads the next message and returns its tag as a number, leaving its
   * body where it arrived: from `start` to `end` in `buffer`.
   *
   * Nothing is copied, which is what a reply of many rows wants. The
   * body is only there until the next read; `read_message()` is the
   * form to use for one that has to outlast it.
   *
   * @returns number The tag's byte, such as 68 for a `DataRow`.
   * @throws ConnectionError if the server closes first.
   */
  next_message() {
    if self.buffer.length() - self._at < 5 {
      self._fill(5)
    }

    var buffer = self.buffer
    var at = self._at
    var length = read_uint32(buffer, at + 1)

    if buffer.length() - at < length + 1 {
      self._fill(length + 1)
      buffer = self.buffer
      at = self._at
    }

    self.start = at + 5
    self.end = at + length + 1
    self._at = self.end

    return buffer[at]
  }

  /**
   * Reads the next message as a copy of its own.
   *
   * @returns dict `{ tag, payload }`
   * @throws ConnectionError if the server closes first.
   */
  read_message() {
    var tag = self.next_message()

    return { tag: tag.chr(), payload: self.buffer[self.start, self.end] }
  }

  # Reads from the stream until at least `count` unread bytes are
  # buffered.
  _fill(count) {
    while self.buffer.length() - self._at < count {
      var chunk

      catch {
        chunk = self._stream.read(READ_SIZE)
      } as error {
        raise ConnectionError(
          'the connection to the server failed while reading: ' + error.message,
          { driver: 'postgres' },
        )
      }

      if chunk == nil or chunk.length() == 0 {
        raise ConnectionError('the server closed the connection', {
          driver: 'postgres',
        })
      }

      # What was read already is dropped before more is added, so the
      # buffer only ever holds what has not been read yet.
      if self._at > 0 {
        self.buffer = self.buffer[self._at, self.buffer.length()]
        self._at = 0
      }

      self.buffer.extend(chunk)
    }
  }
}

/**
 * Splits a run of zero-terminated strings.
 *
 * Several messages are built this way, including the error report,
 * where each field is a one byte code followed by its text.
 *
 * @param bytes payload
 * @param number at Where to start.
 * @returns dict `{ value, next }`
 */
def read_cstring(payload, at: number) {
  var end = at

  while end < payload.length() and payload[end] != 0 {
    end++
  }

  return { value: end > at ? payload[at, end].to_string() : '', next: end + 1 }
}
