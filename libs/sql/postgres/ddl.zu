/**
 * @module ddl
 *
 * Schema changes for PostgreSQL.
 *
 * PostgreSQL can make every change a blueprint describes with a plain
 * statement, and rolls schema changes back with the transaction they
 * ran in, so a migration that fails part way leaves nothing behind.
 *
 * An `id()` is an identity column, `generated by default`, so a row can
 * still be inserted with an id of its own choosing. A column changing
 * type is converted with a cast from what it held, which is what lets
 * text holding numbers become a number column.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import ..ddl { DdlAdapter }
import ..errors { QueryError }

/**
 * Turns blueprints into PostgreSQL's statements.
 */
class PostgresDdl < DdlAdapter {

  /**
   * @param Column column
   * @returns string
   */
  type_name(column) {
    using column.kind {
      when 'integer' return 'integer'
      when 'big_integer' return 'bigint'
      when 'small_integer' return 'smallint'
      when 'float' return 'double precision'
      when 'decimal' {
        return 'numeric(${column.precision}, ${column.scale})'
      }
      when 'string' return 'varchar(${column.length})'
      when 'text' return 'text'
      when 'boolean' return 'boolean'
      when 'date' return 'date'
      when 'datetime' return 'timestamp with time zone'
      when 'time' return 'time'
      when 'binary' return 'bytea'
      when 'json' return 'jsonb'
      when 'uuid' return 'uuid'
    }

    raise QueryError('PostgreSQL has no column type for ${column.kind}')
  }

  /**
   * @param Column column
   * @returns string
   */
  key_definition(column) {
    return 'bigint generated by default as identity primary key'
  }

  /**
   * @returns string
   */
  exact_collation() {
    return 'collate "C"'
  }

  /**
   * A string as a literal. One holding a backslash is written as an
   * escape string with the backslash doubled, which means the same
   * whatever `standard_conforming_strings` is set to.
   *
   * @param string text
   * @returns string
   */
  string_literal(text: string) {
    var quoted = text.replace("'", "''")

    if text.contains('\\') {
      return "E'" + quoted.replace('\\', '\\\\') + "'"
    }

    return "'" + quoted + "'"
  }

  /**
   * The change, as one `alter table` with an action for each part of
   * the definition. The default is dropped first and set again last,
   * so a default of the old type never has to survive the cast.
   *
   * @param Connection connection
   * @param string table
   * @param Column column
   * @returns list[string]
   */
  change_column(connection, table: string, column) {
    if column.is_generated {
      raise QueryError(
        'an id() column cannot be changed; ${column.name} is one',
      )
    }

    var name = self.quote(column.name)
    var type = self.type_name(column)
    var collated = column.is_exact ? '${type} ${self.exact_collation()}' : type

    var actions = [
      'alter column ${name} drop default',
      'alter column ${name} type ${collated} using ${name}::${type}',
      'alter column ${name} ${column.is_nullable ? "drop" : "set"} not null',
    ]

    if column.has_default or column.is_current {
      actions.append(
        'alter column ${name} set default ${self.default_sql(column)}',
      )
    }

    var target = self.table_name(table)
    var statements = ['alter table ${target} ${", ".join(actions)}']

    if column.foreign != nil {
      statements.append(
        'alter table ${target} add ' +
            self.foreign_key_sql(table, column.foreign),
      )
    }

    return statements
  }

  /**
   * @param Connection connection
   * @param string table
   * @returns list[string]
   * @throws QueryError if the table has no primary key.
   */
  drop_primary(connection, table: string) {
    var target = self.table_name(table)
    var name = connection.fetch_value(
      "select conname from pg_constraint where conrelid = ?::regclass and contype = 'p'",
      [target],
      nil,
    )

    if name == nil {
      raise QueryError('${table} has no primary key to drop', {
        driver: self.driver.name(),
      })
    }

    return ['alter table ${target} drop constraint ${self.quote(name)}']
  }

  /**
   * Holds a session advisory lock keyed by `name` while `body` runs,
   * waiting for another session holding it to let go.
   *
   * @param Connection connection
   * @param string name
   * @param function body
   * @returns any What `body` returned.
   */
  migration_lock(connection, name: string, body: function) {
    connection.fetch_value('select pg_advisory_lock(hashtext(?))', [name], nil)

    var result

    catch {
      result = body()
    } as error {
      connection.fetch_value('select pg_advisory_unlock(hashtext(?))', [
        name,
      ], nil)
      raise error
    }

    connection.fetch_value('select pg_advisory_unlock(hashtext(?))', [
      name,
    ], nil)

    return result
  }
}
