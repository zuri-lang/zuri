/**
 * @module results
 *
 * Reads the server's description of a result it has just produced.
 *
 * These are kept separate from the connection so that the statement can
 * use them too. If the statement got them through the connection, which
 * already imports the statement, the imports would be circular.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import .types { OIDS }

/**
 * The number of rows a command tag reports.
 *
 * The tag is the command's name followed by its counts. `INSERT 0 3`
 * carries an unused OID before the row count and everything else
 * carries the count alone, so the last field is the one to read. A tag
 * with no count at all, as `CREATE TABLE` has, means no rows.
 *
 * @param string tag
 * @returns number
 */
def affected_rows(tag) {
  if !is_string(tag) or tag.is_empty() {
    return 0
  }

  var parts = tag.split(' ')
  var last = parts[parts.length() - 1]

  return last.is_number() ? last.to_number() : 0
}

# Built on first use rather than at load, so a program that never reads
# a result never pays for it.
var _NAMES = {}

/**
 * The name of the type that an OID stands for, or the OID as text if
 * this adapter has no name for it, as with a type added by an
 * extension.
 *
 * @param number oid
 * @returns string
 */
def type_name_of(oid: number) {
  if _NAMES.is_empty() {
    for name, value in OIDS {
      _NAMES.set(value, name.lower())
    }
  }

  var name = _NAMES.get(oid, nil)

  return name != nil ? name : '${oid}'
}

/**
 * Reduces the server's column descriptors to the two fields the shared
 * contract asks for.
 *
 * @param list columns
 * @returns list[dict]
 */
def describe_columns(columns: list) {
  return columns.map(@(column) {
    return { name: column.name, type: type_name_of(column.oid) }
  })
}
