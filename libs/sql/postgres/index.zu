/**
 * @module postgres
 *
 * The PostgreSQL adapter.
 *
 * Use it through `sql`, so that your program stays portable:
 *
 * ```zuri,ignore
 * import sql
 *
 * var db = sql.open('postgres://alice:secret@localhost/app')
 * ```
 *
 * The module itself is for the parts of PostgreSQL that have no
 * equivalent in other engines: LISTEN and NOTIFY, the server's own
 * settings, and the type registry, which lets a program tell the
 * adapter about a type that its database defines.
 *
 * ### Protocol support
 *
 * The adapter uses version 3 of the wire protocol, over TCP, optionally
 * with TLS, or over a Unix domain socket. A `host` that starts with a
 * slash is a socket directory, as in libpq, and the socket inside it is
 * named after the port. TLS isn't offered or needed on a socket,
 * because there's nothing in between, so `sslmode` is ignored.
 *
 * Statements go through the extended query protocol, which compiles
 * them on the server and binds values instead of substituting them.
 * Values are sent in the server's own binary format wherever the
 * adapter has a codec for the type, and as text otherwise, so even a
 * type the adapter has never heard of arrives in a readable form.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import @.driver { PostgresDriver, DEFAULT_PORT, MAX_PARAMETERS, SSL_MODES }
import @.connection { PostgresConnection }
import @.statement { PostgresStatement }
import @.cursor { PostgresCursor }
import @.notify { Listener }
import @.protocol { Protocol }
import @.types { TypeRegistry, DEFAULT_REGISTRY, OIDS }
import @.errors { class_for, raise_for }
import @.results { affected_rows, describe_columns, type_name_of }

/**
 * The driver instance `sql` registers for this engine.
 */
var DRIVER = PostgresDriver()

/**
 * Opens a PostgreSQL connection directly, without going through `sql`.
 *
 * Anything meant to stay portable should use `sql.open()` instead.
 *
 * @param string|dict dsn A connection string or options.
 * @returns PostgresConnection
 */
def connect(dsn) {
  return DRIVER.connect(DRIVER.parse_dsn(dsn))
}
