/**
 * @module driver
 *
 * Opening PostgreSQL connections: reading a connection string,
 * establishing the socket, upgrading it to TLS when asked, and
 * authenticating.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import net
import net.tcp
import net.unix
import os

import ..driver {
  Driver, default_capabilities, READ_COMMITTED, REPEATABLE_READ,
  SERIALIZABLE, READ_UNCOMMITTED,
}
import ..errors { ConnectionError, NotSupportedError }
import ..params { NUMBERED }
import .connection { PostgresConnection }
import .messages { Writer, SSL_REQUEST }
import .protocol { Protocol }
import .types { DEFAULT_REGISTRY }

/**
 * The port a PostgreSQL server listens on unless told otherwise.
 */
var DEFAULT_PORT = 5432

/**
 * How long to wait for the socket and for each read, in milliseconds.
 */
var DEFAULT_TIMEOUT = 30000

/**
 * Most parameters one statement can bind. The protocol counts them in
 * a signed 16 bit field, so this is a hard limit rather than a
 * configured one.
 */
var MAX_PARAMETERS = 65535

/**
 * What `sslmode` can be.
 *
 * `disable` never uses TLS. `prefer` uses it when the server offers
 * it and carries on without when it does not. `require` insists, and
 * fails when the server refuses.
 */
var SSL_MODES = ['disable', 'prefer', 'require']

/**
 * Opens PostgreSQL connections.
 */
class PostgresDriver < Driver {
  name() {
    return 'postgres'
  }

  schemes() {
    return ['postgres', 'postgresql']
  }

  /**
   * What PostgreSQL can do.
   *
   * `last_insert_id` is false, which is the one difference most
   * visible from above: an insert that wants its id back gets a
   * `RETURNING` clause instead, which `Connection.insert()` adds.
   *
   * @returns dict
   */
  capabilities() {
    var caps = default_capabilities()

    caps.set('placeholder_style', NUMBERED)
    caps.set('named_parameters', false)
    caps.set('last_insert_id', false)
    caps.set('returning', true)
    caps.set('isolation_levels', [
      READ_UNCOMMITTED, READ_COMMITTED, REPEATABLE_READ, SERIALIZABLE,
    ])
    caps.set('server_side_cursors', true)
    caps.set('arrays', true)
    caps.set('json', true)
    caps.set('decimals', true)
    caps.set('booleans', true)
    caps.set('upsert', true)
    caps.set('schemas', true)
    caps.set('max_parameters', MAX_PARAMETERS)
    caps.set('default_port', DEFAULT_PORT)

    return caps
  }

  /**
   * Reads a connection string, in either of the two forms PostgreSQL's
   * own tools accept.
   *
   * A URI:
   *
   * ```
   * postgres://alice:secret@db.example.com:5432/app?sslmode=require
   * postgresql://localhost/app
   * ```
   *
   * Or keywords:
   *
   * ```
   * host=localhost port=5432 dbname=app user=alice password=secret
   * ```
   *
   * Anything absent is filled in the way `libpq` fills it: the user
   * defaults to `postgres`, the database to the user's name, the host
   * to `localhost` and the port to 5432.
   *
   * @param string|dict dsn
   * @returns dict
   * @throws ConnectionError if the string cannot be read.
   */
  parse_dsn(dsn) {
    if is_dict(dsn) {
      return self._defaults(dsn.clone())
    }

    if !is_string(dsn) {
      raise ConnectionError(
        'a postgres connection string is a string or a dictionary, ' +
        'not ${typeof(dsn)}',
        { driver: 'postgres' }
      )
    }

    var text = dsn.trim()

    if text.is_empty() {
      raise ConnectionError(
        'a postgres connection string cannot be empty',
        { driver: 'postgres' }
      )
    }

    var options = text.contains('://') ?
      self._parse_uri(text) :
      self._parse_keywords(text)

    return self._defaults(options)
  }

  /**
   * Opens the connection and authenticates.
   *
   * @param dict options From `parse_dsn()`.
   * @returns PostgresConnection
   */
  connect(options: dict) {
    var socket = self._socket_path(options)

    # TLS over a unix socket is neither offered nor wanted: nothing is
    # in between to protect it from, and the server refuses the request
    # outright. `sslmode` is ignored there, which is what libpq does.
    var stream = socket != nil ?
      self._open_unix(socket, options) :
      self._open_socket(options)

    var secured = socket != nil ? stream : self._maybe_upgrade(stream, options)

    var protocol = Protocol(secured, options.get('registry', DEFAULT_REGISTRY))

    catch {
      protocol.startup({
        user: options.user,
        database: options.database,
        password: options.get('password', nil),
        parameters: options.get('parameters', {}),
      })
    } as error {
      protocol.terminate()
      raise error
    }

    return PostgresConnection(self, protocol, options)
  }

  # The socket to connect over, or nil to go by TCP.
  #
  # A host beginning with a slash is a directory, which is how libpq
  # spells this, and the socket inside it is named after the port. A
  # path that already names the socket itself is taken as given, since
  # that is what a program that found the file rather than the
  # directory would have.
  _socket_path(options) {
    var host = options.get('host', '')

    if !is_string(host) or !host.starts_with('/') {
      return nil
    }

    var name = '.s.PGSQL.${options.port}'

    return host.ends_with(name) ? host : os.join_paths(host, name)
  }

  _open_unix(path, options) {
    if !unix.is_supported() {
      raise NotSupportedError(
        'this platform has no unix domain sockets; connect over TCP ' +
        'by giving a host name or address instead of ${path}',
        { driver: 'postgres' }
      )
    }

    var stream = unix.UnixStream()

    catch {
      stream.connect(path)
      stream.set_read_timeout(options.timeout)
      stream.set_write_timeout(options.timeout)
    } as error {
      raise ConnectionError(
        'could not connect to ${path}: ${error.message}',
        { driver: 'postgres' }
      )
    }

    return stream
  }

  _open_socket(options) {
    var address = '${options.host}:${options.port}'
    var stream = tcp.TcpStream()

    catch {
      stream.connect(tcp.resolve(address)[0], options.timeout)
      stream.set_read_timeout(options.timeout)
      stream.set_write_timeout(options.timeout)

      # Statements are small and latency matters more than packing
      # them, so the delay Nagle's algorithm would add is not wanted.
      stream.set_nodelay(true)
    } as error {
      raise ConnectionError(
        'could not connect to ${address}: ${error.message}',
        { driver: 'postgres' }
      )
    }

    return stream
  }

  # Asks the server whether it will speak TLS, and upgrades if so.
  #
  # The request is startup-shaped and answered with a single byte: `S`
  # to continue in TLS, `N` to carry on in the clear.
  _maybe_upgrade(stream, options) {
    if options.sslmode == 'disable' {
      return stream
    }

    var request = Writer()
    request.int32(SSL_REQUEST)

    catch {
      stream.write_all(request.frame(nil))
    } as error {
      raise ConnectionError(
        'could not ask the server for TLS: ${error.message}',
        { driver: 'postgres' }
      )
    }

    var answer = stream.read_exact(1)

    if answer == nil or answer.length() == 0 {
      raise ConnectionError(
        'the server closed the connection when asked for TLS',
        { driver: 'postgres' }
      )
    }

    if answer[0].chr() != 'S' {
      if options.sslmode == 'require' {
        stream.close()

        raise ConnectionError(
          'the server will not use TLS and sslmode is require',
          { driver: 'postgres' }
        )
      }

      return stream
    }

    var config = net.tls.TlsConfig()

    if options.get('ssl_root_cert', nil) != nil {
      config.add_ca_pem(options.ssl_root_cert)
    }

    # `prefer` asks for encryption and does not claim to have checked
    # who is on the other end; `require` is the mode that verifies.
    if options.sslmode == 'prefer' {
      config.set_insecure(true)
    }

    catch {
      return net.tls.TlsStream.connect(stream, config, options.host)
    } as error {
      raise ConnectionError(
        'the TLS handshake with ${options.host} failed: ${error.message}',
        { driver: 'postgres' }
      )
    }
  }

  _parse_uri(text) {
    var rest = text[text.index_of('://') + 3, text.length()]
    var options = {}

    var query = rest.index_of('?')

    if query != -1 {
      for pair in rest[query + 1, rest.length()].split('&') {
        if pair.is_empty() {
          continue
        }

        var mark = pair.index_of('=')

        if mark == -1 {
          options.set(_decode(pair), '')
          continue
        }

        options.set(_decode(pair[0, mark]), _decode(pair[mark + 1, pair.length()]))
      }

      rest = rest[0, query]
    }

    var slash = rest.index_of('/')

    if slash != -1 {
      var database = rest[slash + 1, rest.length()]

      if !database.is_empty() {
        options.set('dbname', _decode(database))
      }

      rest = rest[0, slash]
    }

    var at = rest.last_index_of('@')

    if at != -1 {
      var credentials = rest[0, at]
      rest = rest[at + 1, rest.length()]

      var colon = credentials.index_of(':')

      if colon == -1 {
        options.set('user', _decode(credentials))
      } else {
        options.set('user', _decode(credentials[0, colon]))
        options.set('password', _decode(credentials[colon + 1, credentials.length()]))
      }
    }

    if !rest.is_empty() {
      # An IPv6 address is bracketed, so the port is whatever follows
      # the closing bracket rather than the last colon.
      var host = rest
      var port = nil

      if rest.starts_with('[') {
        var close = rest.index_of(']')

        if close == -1 {
          raise ConnectionError(
            'this connection string has an unclosed IPv6 address',
            { driver: 'postgres' }
          )
        }

        host = rest[1, close]
        var tail = rest[close + 1, rest.length()]

        if tail.starts_with(':') {
          port = tail[1, tail.length()]
        }
      } else {
        var colon = rest.index_of(':')

        if colon != -1 {
          host = rest[0, colon]
          port = rest[colon + 1, rest.length()]
        }
      }

      if !host.is_empty() {
        options.set('host', _decode(host))
      }

      if port != nil and !port.is_empty() {
        options.set('port', port)
      }
    }

    return options
  }

  _parse_keywords(text) {
    var options = {}

    for piece in text.split(' ') {
      if piece.is_empty() {
        continue
      }

      var mark = piece.index_of('=')

      if mark == -1 {
        raise ConnectionError(
          '${piece} is not a key=value pair',
          { driver: 'postgres' }
        )
      }

      options.set(piece[0, mark], piece[mark + 1, piece.length()])
    }

    return options
  }

  _defaults(options) {
    var filled = {}

    # Both spellings of each keyword reach the same option, so a
    # connection string copied from libpq and a dictionary written by
    # hand agree.
    filled.set('host', options.get('host', 'localhost'))
    filled.set('user', options.get('user', 'postgres'))
    filled.set('password', options.get('password', nil))

    var database = options.get('database', options.get('dbname', nil))
    filled.set('database', database == nil ? filled.user : database)

    var port = options.get('port', DEFAULT_PORT)

    if is_string(port) {
      if !port.is_number() {
        raise ConnectionError(
          '${port} is not a port number', { driver: 'postgres' }
        )
      }

      port = port.to_number()
    }

    filled.set('port', port)

    var timeout = options.get('timeout', options.get('connect_timeout', DEFAULT_TIMEOUT))
    filled.set('timeout', is_string(timeout) ? timeout.to_number() : timeout)

    var mode = options.get('sslmode', 'prefer')

    if !SSL_MODES.contains(mode) {
      raise ConnectionError(
        'sslmode is one of ${', '.join(SSL_MODES)}, not ${mode}',
        { driver: 'postgres' }
      )
    }

    filled.set('sslmode', mode)
    filled.set('ssl_root_cert', options.get('sslrootcert', options.get('ssl_root_cert', nil)))
    filled.set('registry', options.get('registry', DEFAULT_REGISTRY))

    var parameters = options.get('parameters', {}).clone()

    if !parameters.contains('application_name') {
      parameters.set('application_name', options.get('application_name', 'zuri'))
    }

    filled.set('parameters', parameters)

    return filled
  }
}

var _HEX = '0123456789abcdef'

# Undoes the percent-encoding a URI may carry, which a password with a
# `@` or a `/` in it needs.
def _decode(text) {
  if !text.contains('%') {
    return text
  }

  var out = []
  var index = 0

  while index < text.length() {
    var ch = text[index]

    if ch == '%' and index + 2 < text.length() {
      var high = _HEX.index_of(text[index + 1].lower())
      var low = _HEX.index_of(text[index + 2].lower())

      if high != -1 and low != -1 {
        out.append(high * 16 + low)
        index += 3

        continue
      }
    }

    out += ch.to_bytes().to_list()
    index++
  }

  return bytes(out).to_string()
}
