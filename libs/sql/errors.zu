/**
 * @module errors
 *
 * The errors that databases raise, all with the same base class and the
 * same shape, whatever engine they came from.
 *
 * This is the part of `sql` that pays off soonest. PostgreSQL reports a
 * unique constraint violation as SQLSTATE `23505`, and SQLite reports
 * it as extended result code `2067`. Neither number means anything to
 * the other engine, and code that checked for either one would stop
 * working as soon as the adapter changed. Every adapter translates its
 * engine's errors into the classes below, so a program can catch
 * `UniqueViolation` and keep catching it after moving to a different
 * database.
 *
 * The original error information is never discarded. `code` and
 * `sqlstate` hold whatever the engine reported, so anything specific to
 * the engine is still available.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

/**
 * The base class for every error that this module and its adapters
 * raise.
 *
 * Catch it to catch anything a database can raise. The subclasses below
 * distinguish the cases that a program usually handles differently, and
 * every one of them is a `SqlError`, so a broad catch never misses one.
 *
 * @printable
 */
class SqlError < Error {
  /**
   * The engine's own error code, in the engine's own form.
   *
   * For SQLite, it's a number, the extended result code, such as `2067`
   * for a unique constraint. For MySQL, it's also a number, MySQL's own
   * error number, such as `1062` for a duplicate key. For PostgreSQL,
   * it's a string, the SQLSTATE, such as `'23505'`. It's `nil` when the
   * error came from `sql` itself, not from an engine.
   *
   * @default nil
   */
  var code

  /**
   * The five character SQLSTATE, for engines that report one.
   *
   * PostgreSQL and MySQL always do. SQLite has no such concept and
   * leaves this `nil`, which is why matching on an error class is the
   * portable choice and matching on `sqlstate` is not.
   *
   * @default nil
   */
  var sqlstate

  /**
   * Name of the adapter that raised this, such as `'sqlite'`,
   * `'postgres'` or `'mysql'`.
   *
   * @default nil
   */
  var driver

  /**
   * The statement that failed, as it was sent to the engine.
   *
   * This is the translated statement, with the adapter's own
   * placeholders in it, not the `?` form that was written. It's the
   * text that the engine rejected, so it's the text to log.
   *
   * `nil` for errors raised outside the execution of a statement.
   *
   * @default nil
   */
  var query

  /**
   * Creates an error, optionally with the engine's own details.
   *
   * `details` is a dictionary. Any of `code`, `sqlstate`, `driver` and
   * `query` that it contains are copied onto the error, and anything
   * else is ignored. Adapters fill it in. Application code that raises
   * one of these errors itself can leave it out.
   *
   * @param string message
   * @param dict|nil details
   */
  @new(message, details) {
    self.message = message or self.message

    if details {
      self.code = details.get('code', nil)
      self.sqlstate = details.get('sqlstate', nil)
      self.driver = details.get('driver', nil)
      self.query = details.get('query', nil)
    }
  }

  to_string() {
    var where = self.driver ? ' [${self.driver}]' : ''
    var code = self.code != nil ? ' (${self.code})' : ''

    return '<${typeof(self)}${where}${code}: ${self.message}>'
  }

  @to_string() {
    return self.to_string()
  }
}

/**
 * The database couldn't be reached, or the connection was dropped.
 *
 * For example, a network failure, a refused connection, a server that
 * isn't running, or a database file that can't be opened. It's often
 * reasonable to retry, because the same query against the same data may
 * well succeed once the cause has cleared.
 *
 * @printable
 */
class ConnectionError < SqlError {}

/**
 * The server rejected the credentials.
 *
 * It's a `ConnectionError`, because the connection is what failed, but
 * it has its own class, because retrying never fixes a wrong password.
 *
 * @printable
 */
class AuthenticationError < ConnectionError {}

/**
 * The server sent something the adapter couldn't make sense of.
 *
 * It's a `ConnectionError` because that's what it means in practice.
 * The exchange has lost its place, so nothing else on this connection
 * can be trusted, and a pool holding the connection should discard it
 * instead of lending it out again.
 *
 * It means either a bug in the adapter, or something between the
 * adapter and the server that isn't the server.
 *
 * @printable
 */
class ProtocolError < ConnectionError {}

/**
 * An operation ran out of time.
 *
 * Raised for a connection that took too long to open, a statement that
 * exceeded its deadline, and for SQLite's busy timeout expiring while
 * another writer held the database.
 *
 * @printable
 */
class TimeoutError < ConnectionError {}

/**
 * The engine refused the statement.
 *
 * Bad syntax, an unknown table or column, a type the engine would not
 * accept, a wrong number of parameters. These are programming errors:
 * the same statement will fail the same way every time.
 *
 * @printable
 */
class QueryError < SqlError {}

/**
 * A constraint rejected the data.
 *
 * Catch this to handle any constraint violation without caring which
 * one it was. The subclasses are there for when the difference matters,
 * for example when a duplicate key means "already exists" and a foreign
 * key violation means "the referenced row is gone".
 *
 * @printable
 */
class IntegrityError < SqlError {}

/**
 * A unique index or primary key already holds this value.
 *
 * @printable
 */
class UniqueViolation < IntegrityError {}

/**
 * A foreign key has no matching row, or a referenced row is still in
 * use by another table.
 *
 * @printable
 */
class ForeignKeyViolation < IntegrityError {}

/**
 * A column declared NOT NULL was given nothing.
 *
 * @printable
 */
class NotNullViolation < IntegrityError {}

/**
 * A CHECK constraint rejected the row.
 *
 * @printable
 */
class CheckViolation < IntegrityError {}

/**
 * A transaction could not be carried out as asked.
 *
 * Raised for a commit that failed, a rollback with nothing to roll
 * back, and for nesting mistakes such as releasing a savepoint that
 * was never taken.
 *
 * @printable
 */
class TransactionError < SqlError {}

/**
 * Two transactions couldn't both be treated as though each ran alone.
 *
 * The engine gave up on one of them, instead of producing a result that
 * running them one after the other couldn't have produced. The right
 * response is to retry the whole transaction, which usually succeeds.
 *
 * @printable
 */
class SerializationError < TransactionError {}

/**
 * Two transactions were each waiting on the other, and the engine
 * broke the tie by aborting this one.
 *
 * As with `SerializationError`, the response is to retry the
 * transaction from the beginning.
 *
 * @printable
 */
class DeadlockError < TransactionError {}

/**
 * Something went wrong with a connection pool, as opposed to with a
 * database.
 *
 * @printable
 */
class PoolError < SqlError {}

/**
 * Every connection in the pool was in use when one was requested.
 *
 * Either the pool is too small for the load, or connections are being
 * held for longer than they should be. The usual cause is a connection
 * that was acquired and never released.
 *
 * @printable
 */
class PoolExhaustedError < PoolError {}

/**
 * The engine cannot do what was asked, and no approximation would be
 * honest.
 *
 * Raised where an adapter would otherwise have to guess: asking
 * PostgreSQL for a last insert id it does not report, asking SQLite
 * for an isolation level it has no analogue for, connecting to
 * PostgreSQL over a Unix domain socket. The message names both the
 * adapter and the feature.
 *
 * @printable
 */
class NotSupportedError < SqlError {}

/**
 * The connection, statement, cursor, transaction or pool was already
 * closed.
 *
 * Closing something twice is always allowed and never raises this.
 * Using something after closing it is what does.
 *
 * @printable
 */
class ClosedError < SqlError {}
