/**
 * @module query
 *
 * Reading and writing a model's rows by conditions, as records.
 *
 * `db.model(Post)` starts a query on a connection or a transaction.
 * Every method that narrows it returns a new query and leaves the one
 * it was called on as it was, so a query can be kept and built on in
 * more than one direction:
 *
 * ```zuri,ignore
 * var published = db.model(Post).where({ published: true })
 *
 * var recent = published.order('created_at desc').limit(10).all()
 * var count = published.count()
 * ```
 *
 * ### Conditions
 *
 * `where()` with a dictionary reads as the CRUD helpers' conditions
 * do: a value matches itself, `nil` matches null, a list matches any of
 * its values, and an empty list matches nothing. Anything else is a
 * fragment of SQL, with `?` for each value:
 *
 * ```zuri,ignore
 * db.model(Post).where('views > ? or featured = ?', [100, true])
 * ```
 *
 * Every condition must hold. A fragment is bracketed as it is added, so
 * an `or` inside one stays inside it.
 *
 * ### Associations
 *
 * `include()` loads associations along with the records, one query per
 * association rather than one per record, and a dotted name reaches
 * further: `include('comments.author')` loads every post's comments
 * and every comment's author, in three queries however many there are.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import date

import ..crud { Raw }
import .casts { cast }
import .definition { definition_of, HAS_MANY }
import .errors { ModelError, RecordNotFound }

# The most keys one `in (...)` binds when loading associations; past it
# the keys are loaded in batches.
var _BATCH = 500

/**
 * A query over one model's rows.
 *
 * @iterable
 * @printable
 */
class Query {
  var _db
  var _definition
  var _state

  # What iteration has read, between `@key` and `@value`.
  var _records

  /**
   * @param Connection|Transaction db
   * @param Definition definition
   * @param dict|nil state What the query holds so far.
   * @internal Made by `db.model()`.
   */
  @new(db, definition, state) {
    self._db = db
    self._definition = definition
    self._state = state or
        {
          wheres: [],
          orders: [],
          limit: nil,
          offset: nil,
          includes: [],
          driver: nil,
        }
  }

  /**
   * The definition of the model queried.
   *
   * @returns Definition
   */
  definition() {
    return self._definition
  }

  /**
   * Narrows the query to rows meeting conditions.
   *
   * @param dict|string filter Conditions as a dictionary of column to
   *    value, or a fragment of SQL.
   * @param list|nil values For a fragment, the values its `?` stand
   *    for.
   * @returns Query
   */
  where(filter, values) {
    if is_dict(filter) {
      return self._with('wheres', self._conditions(filter, false))
    }

    if !is_string(filter) {
      raise ModelError(
        'a condition is a dictionary or a string of SQL, not ${typeof(filter)}',
        nil,
      )
    }

    return self._with('wheres', [
      { sql: '(${filter})', values: values or [] },
    ])
  }

  /**
   * Narrows the query to rows not meeting conditions. A row whose
   * column is null is not equal to any value, so it is among the rows a
   * value excludes; `nil` excludes null itself.
   *
   * @param dict filter Column to value, as `where()` reads one.
   * @returns Query
   */
  where_not(filter: dict) {
    return self._with('wheres', self._conditions(filter, true))
  }

  /**
   * Orders the rows, after any order already given.
   *
   * @param string|list terms Each a column, optionally followed by
   *    ` asc` or ` desc`, or a `sql.Raw`.
   * @returns Query
   */
  order(terms) {
    var list = is_list(terms) ? terms : [terms]
    return self._with('orders', list.map(@(term) => self._order_term(term)))
  }

  /**
   * Returns at most `count` rows.
   *
   * @param number count
   * @returns Query
   */
  limit(count: number) {
    return self._set('limit', _whole(count, 'a limit'))
  }

  /**
   * Skips the first `count` rows.
   *
   * @param number count
   * @returns Query
   */
  offset(count: number) {
    return self._set('offset', _whole(count, 'an offset'))
  }

  /**
   * Applies a scope the model declared.
   *
   * @param string name
   * @param any argument Handed to the scope.
   * @returns Query
   * @throws ModelError if the model declares no such scope.
   */
  scope(name: string, argument) {
    var body = self._definition.scopes.get(name, nil)

    if body == nil {
      raise ModelError(
        '${self._definition.name} has no scope called ${name}',
        nil,
      )
    }

    var narrowed = body(self, argument)

    if !instance_of(narrowed, Query) {
      raise ModelError(
        'the scope ${name} of ${self._definition.name} has to return a query',
        nil,
      )
    }

    return narrowed
  }

  /**
   * Loads associations along with the records.
   *
   * @param string|list[string] names Association names, dotted to
   *    reach the associations of what they load.
   * @returns Query
   */
  include(names) {
    var list = is_list(names) ? names : [names]

    for name in list {
      self._definition.association(name.split('.')[0])
    }

    return self._with('includes', list)
  }

  /**
   * Every matching record.
   *
   * @returns list[Model]
   */
  all() {
    var built = self.to_sql()
    var records = self._db
        .fetch_all(built.sql, built.values)
        .map(@(row) => self._definition.build(row))

    return self._load(records, self._state.includes)
  }

  /**
   * The first matching record, or nil. Ordered by the primary key when
   * no order was given, so it is the same one every time.
   *
   * @returns Model|nil
   */
  first() {
    var query = self._state.orders.is_empty()
        ? self.order(self._definition.primary)
        : self
    var records = query.limit(1).all()

    return records.is_empty() ? nil : records[0]
  }

  /**
   * The record with primary key `key`.
   *
   * @param any key
   * @returns Model
   * @throws RecordNotFound if there is none.
   */
  find(key) {
    var filter = {}
    filter.set(self._definition.primary, key)

    var found = self.where(filter, nil).first()

    if found == nil {
      raise RecordNotFound(self._definition.name, key)
    }

    return found
  }

  /**
   * The first record meeting conditions, or nil.
   *
   * @param dict filter
   * @returns Model|nil
   */
  find_by(filter: dict) {
    return self.where(filter, nil).first()
  }

  /**
   * Whether any row matches.
   *
   * @returns bool
   */
  exists() {
    var built = self._statement('1', false)
    return !self._db.fetch_all(built.sql + ' limit 1', built.values).is_empty()
  }

  /**
   * How many rows match. Order, limit and offset do not change it.
   *
   * @returns number
   */
  count() {
    var built = self._statement('count(*)', false)
    return _plain(self._db.fetch_value(built.sql, built.values, 0))
  }

  /**
   * One column of every matching row, cast as the model casts it.
   *
   * @param string column
   * @returns list
   */
  pluck(column: string) {
    var built = self._statement(self._quote(column), true)
    var kind = self._definition.casts.get(column, nil)
    var values = self._db.fetch_column(built.sql, built.values, 0)

    return kind == nil ? values : values.map(@(value) => cast(kind, value))
  }

  /**
   * The total of a column over the matching rows, as the engine
   * reports it: a number, or a `sql.Decimal` for an exact column on
   * PostgreSQL and MySQL. Nil when no row matches.
   *
   * @param string column
   * @returns number|Decimal|nil
   */
  sum(column: string) {
    return self._aggregate('sum', column)
  }

  /**
   * The smallest value of a column over the matching rows, or nil.
   *
   * @param string column
   * @returns any
   */
  min(column: string) {
    return self._aggregate('min', column)
  }

  /**
   * The largest value of a column over the matching rows, or nil.
   *
   * @param string column
   * @returns any
   */
  max(column: string) {
    return self._aggregate('max', column)
  }

  /**
   * The mean of a column over the matching rows, as the engine reports
   * it, or nil.
   *
   * @param string column
   * @returns number|Decimal|nil
   */
  average(column: string) {
    return self._aggregate('avg', column)
  }

  /**
   * One page of the matching records, and where it sits among them.
   *
   * ```zuri,ignore
   * var page = db.model(Post).order('created_at desc').page(2, 20)
   *
   * for post in page.records {
   *   echo post.title
   * }
   *
   * echo 'page ${page.page} of ${page.pages}'
   * ```
   *
   * @param number number Which page, counting from 1.
   * @param number size How many records to a page.
   * @returns dict `{ records, total, page, size, pages }`, `total` the
   *    matching records in all and `pages` how many pages they fill,
   *    at least 1.
   */
  page(number: number, size: number) {
    _whole(number, 'a page')
    _whole(size, 'a page size')

    if number < 1 or size < 1 {
      raise ModelError('pages and their sizes count from 1', nil)
    }

    var total = self.count()
    var records = self.offset((number - 1) * size).limit(size).all()
    var pages = total == 0 ? 1 : (total / size).ceil()

    return { records, total, page: number, size, pages }
  }

  /**
   * The matching records read one at a time, for more than fit in
   * memory at once. Associations are not loaded this way.
   *
   * ```zuri,ignore
   * for post in db.model(Post).stream() {
   *   index(post)
   * }
   * ```
   *
   * @returns RecordCursor
   * @throws ModelError if the query includes associations.
   */
  stream() {
    if !self._state.includes.is_empty() {
      raise ModelError(
        'stream() reads one record at a time and cannot load associations; ' +
            'load them with load() on the records you need them for',
        nil,
      )
    }

    var built = self.to_sql()

    return RecordCursor(
      self._db.stream(built.sql, built.values, nil),
      self._definition,
    )
  }

  /**
   * Creates a record from `attributes` and saves it.
   *
   * @param dict attributes Assigned as `fill()` assigns them.
   * @returns Model
   * @throws RecordInvalid if it fails validation.
   */
  create(attributes: dict) {
    var record = self._definition.model()

    record.fill(attributes, nil)
    record.save(self._db)

    return record
  }

  /**
   * Updates every matching row in one statement, without building the
   * records: no validation runs and no hook is called. The model's
   * `updated` timestamp is set too, unless `values` sets it.
   *
   * @param dict values Column to value, a `sql.Raw` written as given.
   * @returns number How many rows changed.
   */
  update(values: dict) {
    var changes = values.clone()
    var stamp = self._definition.updated_column

    if stamp != nil and !changes.contains(stamp) {
      changes.set(stamp, _now())
    }

    if changes.is_empty() {
      raise ModelError('an update needs at least one column to set', nil)
    }

    var sets = []
    var bound = []

    for column, value in changes {
      if instance_of(value, Raw) {
        sets.append('${self._quote(column)} = ${value.sql}')
      } else {
        sets.append('${self._quote(column)} = ?')
        bound.append(value)
      }
    }

    var where = self._where()
    var sql = 'update ${self._table()} set ${", ".join(sets)}${where.sql}'

    return self._db.exec(sql, bound + where.values).rows_affected
  }

  /**
   * Deletes every matching row in one statement, without building the
   * records: no hook is called. With no conditions, that is every row.
   *
   * @returns number How many rows went.
   */
  delete() {
    var where = self._where()
    return self._db
        .exec('delete from ${self._table()}${where.sql}', where.values)
        .rows_affected
  }

  /**
   * Records built from a statement of one's own, for what conditions
   * cannot say: a join, a union, a window. The statement selects the
   * model's columns by their names.
   *
   * ```zuri,ignore
   * db.model(Post).from_sql('
   *   select posts.* from posts
   *   join authors on authors.id = posts.author_id
   *   where authors.name = ?
   * ', ['Ada'])
   * ```
   *
   * @param string sql
   * @param list|dict|nil params
   * @returns list[Model]
   */
  from_sql(sql: string, params) {
    var records = self._db
        .fetch_all(sql, params)
        .map(@(row) => self._definition.build(row))
    return self._load(records, self._state.includes)
  }

  /**
   * Loads associations onto records already in hand, one query per
   * association for all of them.
   *
   * @param list[Model] records Records of this model.
   * @param string|list[string] names
   * @returns list[Model] The same records.
   */
  load(records: list, names) {
    return self._load(records, is_list(names) ? names : [names])
  }

  /**
   * The statement `all()` runs, and the values it binds.
   *
   * @returns dict `{ sql, values }`
   */
  to_sql() {
    return self._statement('*', true)
  }

  to_string() {
    return '<Query ${self._definition.name} ${self.to_sql().sql}>'
  }

  @to_string() {
    return self.to_string()
  }

  @key(previous) {
    if previous == nil {
      self._records = self.all()
    }

    var next = previous == nil ? 0 : previous + 1

    return next < self._records.length() ? next : nil
  }

  @value(key) {
    return self._records[key]
  }

  # A copy with `name` extended by `items`.
  _with(name, items) {
    var state = self._state.clone()

    state.set(name, self._state[name] + items)

    return Query(self._db, self._definition, state)
  }

  # A copy with `name` replaced.
  _set(name, value) {
    var state = self._state.clone()

    state.set(name, value)

    return Query(self._db, self._definition, state)
  }

  _table() {
    return self._definition.sql_names(self._driver()).table
  }

  # The driver behind this query's connection, found once and carried
  # along by every query built from this one.
  _driver() {
    var driver = self._state.driver

    if driver == nil {
      var connection = hasprop(self._db, 'connection')
          ? self._db.connection
          : self._db

      driver = connection.driver()
      self._state.driver = driver
    }

    return driver
  }

  _quote(column) {
    var names = self._definition.sql_names(self._driver())
    var quoted = names.quoted.get(column, nil)

    if quoted == nil {
      quoted = names.driver.quote_identifier(column)
      names.quoted.set(column, quoted)
    }

    return quoted
  }

  # The conditions of a dictionary, each `{ sql, values }`.
  _conditions(filter, negated) {
    var clauses = []

    for column, value in filter {
      var name = self._quote(column)

      if value == nil {
        clauses.append({
          sql: '${name} is ${negated ? "not " : ""}null',
          values: [],
        })
      } else if instance_of(value, Raw) {
        var test = negated ? '<>' : '='
        clauses.append({ sql: '${name} ${test} ${value.sql}', values: [] })
      } else if is_list(value) {
        if value.is_empty() {
          clauses.append({ sql: negated ? '1 = 1' : '1 = 0', values: [] })
        } else {
          var marks = ', '.join(value.map(@(_) => '?'))
          var sql = negated
              ? '(${name} not in (${marks}) or ${name} is null)'
              : '${name} in (${marks})'

          clauses.append({ sql, values: value })
        }
      } else if negated {
        clauses.append({
          sql: '(${name} <> ? or ${name} is null)',
          values: [value],
        })
      } else {
        clauses.append({
          sql: '${name} = ?',
          values: [value],
        })
      }
    }

    return clauses
  }

  _where() {
    var wheres = self._state.wheres

    if wheres.is_empty() {
      return { sql: '', values: [] }
    }

    var values = []

    for clause in wheres {
      values.extend(clause.values)
    }

    return {
      sql: ' where ' + ' and '.join(wheres.map(@(clause) => clause.sql)),
      values,
    }
  }

  # A select of `projection`, with or without order, limit and offset.
  _statement(projection, ordered) {
    var where = self._where()
    var sql = 'select ${projection} from ${self._table()}${where.sql}'

    if ordered {
      var orders = self._state.orders

      if !orders.is_empty() {
        sql += ' order by ' + ', '.join(orders)
      }

      if self._state.limit != nil {
        sql += ' limit ${self._state.limit}'
      }

      if self._state.offset != nil {
        if self._state.limit == nil {
          # Every engine takes an offset only after a limit; this one
          # stands for no limit at all.
          sql += ' limit 9223372036854775807'
        }

        sql += ' offset ${self._state.offset}'
      }
    }

    return { sql, values: where.values }
  }

  _aggregate(function, column) {
    var built = self._statement('${function}(${self._quote(column)})', false)
    return self._db.fetch_value(built.sql, built.values, nil)
  }

  _order_term(term) {
    if instance_of(term, Raw) {
      return term.sql
    }

    var text = term.trim()
    var lower = text.lower()

    for direction in [' desc', ' asc'] {
      if lower.ends_with(direction) {
        var column = text[0, text.length() - direction.length()].trim()
        return '${self._quote(column)}${direction}'
      }
    }

    return self._quote(text)
  }

  # Loads `paths` onto `records`.
  _load(records, paths) {
    if records.is_empty() or paths.is_empty() {
      return records
    }

    var groups = {}
    var order = []

    for path in paths {
      var parts = path.split('.')
      var name = parts[0]

      if !groups.contains(name) {
        groups.set(name, [])
        order.append(name)
      }

      if parts.length() > 1 {
        groups[name].append('.'.join(parts[1,]))
      }
    }

    for name in order {
      self._load_one(records, self._definition.association(name), groups[name])
    }

    return records
  }

  _load_one(records, association, rest) {
    var target = definition_of(association.model)
    var query = Query(self._db, target, nil)

    if !rest.is_empty() {
      query = query.include(rest)
    }

    using association.kind {
      when 'belongs_to' {
        var owner_key = association.key == nil
            ? target.primary
            : association.key
        var keys = _keys(records, association.foreign_key)
        var found = _index(_batched(query, owner_key, keys), owner_key)

        for record in records {
          var key = getprop(record, association.foreign_key)
          setprop(
            record,
            association.name,
            key == nil ? nil : found.get(key, nil),
          )
        }
      }
      when 'has_one', 'has_many' {
        var keys = _keys(records, association.key)
        var children = _batched(
          query.order(target.primary),
          association.foreign_key,
          keys,
        )
        var grouped = {}

        for child in children {
          var key = getprop(child, association.foreign_key)

          if !grouped.contains(key) {
            grouped.set(key, [])
          }

          grouped[key].append(child)
        }

        for record in records {
          var mine = grouped.get(getprop(record, association.key), [])
          var value = association.kind == HAS_MANY
              ? mine
              : mine.is_empty()
              ? nil
              : mine[0]

          setprop(record, association.name, value)
        }
      }
      when 'belongs_to_many' {
        var keys = _keys(records, association.key)
        var links = []

        for chunk in _chunks(keys) {
          var marks = ', '.join(chunk.map(@(_) => '?'))

          links.extend(
            self._db.fetch_all(
              'select ${self._quote(association.foreign_key)} as owner, ' +
                  '${self._quote(association.other_key)} as other from ' +
                  '${self._driver().ddl().table_name(association.through)} where ' +
                  '${self._quote(association.foreign_key)} in (${marks})',
              chunk,
            ),
          )
        }

        var others = []

        for link in links {
          if !others.contains(link.other) {
            others.append(link.other)
          }
        }

        var found = _index(
          _batched(query.order(target.primary), target.primary, others),
          target.primary,
        )
        var joined = {}

        for link in links {
          if !joined.contains(link.owner) {
            joined.set(link.owner, [])
          }

          var other = found.get(link.other, nil)

          if other != nil {
            joined[link.owner].append(other)
          }
        }

        for record in records {
          var mine = joined.get(getprop(record, association.key), [])

          mine.sort(
            @(a, b) => _compare(
              getprop(a, target.primary),
              getprop(b, target.primary),
            ),
          )

          setprop(record, association.name, mine)
        }
      }
    }
  }
}

/**
 * Records read one at a time from a cursor.
 *
 * @iterable
 * @printable
 */
class RecordCursor {
  var _cursor
  var _definition
  var _pending

  /**
   * @param Cursor cursor
   * @param Definition definition
   */
  @new(cursor, definition) {
    self._cursor = cursor
    self._definition = definition
  }

  /**
   * The next record, or nil once there are none.
   *
   * @returns Model|nil
   */
  next() {
    var row = self._cursor.next()
    return row == nil ? nil : self._definition.build(row)
  }

  /**
   * Stops reading, releasing the cursor. Reading to the end does the
   * same.
   */
  close() {
    self._cursor.close()
  }

  @key(previous) {
    var record = self.next()

    if record == nil {
      return nil
    }

    self._pending = record

    return previous == nil ? 0 : previous + 1
  }

  @value(key) {
    var record = self._pending
    self._pending = nil

    return record
  }

  to_string() {
    return '<RecordCursor ${self._definition.name}>'
  }

  @to_string() {
    return self.to_string()
  }
}

# The current time, as a timestamp column takes it.
def _now() {
  return date.from_time(time())
}

# The distinct values of `field` across `records`, leaving out nil.
def _keys(records, field) {
  var keys = []

  for record in records {
    var key = getprop(record, field)

    if key != nil and !keys.contains(key) {
      keys.append(key)
    }
  }

  return keys
}

# `keys` in batches small enough to bind at once.
def _chunks(keys) {
  var chunks = []
  var at = 0

  while at < keys.length() {
    var end = (at + _BATCH).min(keys.length())
    chunks.append(keys[at, end])
    at = end
  }

  return chunks
}

# The records of `query` whose `column` is one of `keys`.
def _batched(query, column, keys) {
  var found = []

  for chunk in _chunks(keys) {
    var filter = {}
    filter.set(column, chunk)
    found.extend(query.where(filter, nil).all())
  }

  return found
}

# `records` by the value of `field`.
def _index(records, field) {
  var indexed = {}

  for record in records {
    indexed.set(getprop(record, field), record)
  }

  return indexed
}

# Orders two keys, numbers by value and anything else as text.
def _compare(a, b) {
  if is_number(a) and is_number(b) {
    return a - b
  }

  return a.to_string().compare(b.to_string())
}

# An aggregate as a plain number where it is one.
def _plain(value) {
  if value == nil or is_number(value) {
    return value
  }

  return value.to_string().to_number()
}

# A whole number of rows, checked.
def _whole(value, what) {
  if !is_number(value) or value != value.floor() or value < 0 {
    raise ModelError('${what} is a whole number of rows, not ${value}', nil)
  }

  return value
}
