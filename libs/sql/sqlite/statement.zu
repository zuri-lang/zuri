/**
 * @module statement
 *
 * A SQLite statement compiled once and run many times.
 *
 * Compiling a statement is the expensive half of running one, and a
 * statement run in a loop pays that cost once here rather than on
 * every pass. The saving is real enough to be worth the extra object:
 * an insert of ten thousand rows through a prepared statement does one
 * compile instead of ten thousand.
 *
 * A statement holds one native handle, so it can only be doing one
 * thing at a time. Opening a cursor over it takes that handle until
 * the cursor closes, and running it again in the meantime raises
 * rather than silently resetting the cursor underneath.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _sqlite

import ..driver { DriverStatement }
import ..errors { ClosedError, QueryError }
import ..types { flatten }
import .cursor { SqliteCursor }
import .errors { reraise }
import .types { conversions_for, decoders_for, decode_row }

/**
 * Describes the columns a compiled statement returns.
 *
 * Along with the columns come the conversions their declared types
 * call for, the columns that need one, how many parameters the
 * statement binds, and how many times SQLite had compiled it again by
 * the time it was described. A caller keeps the description and reads
 * it again only once that last number has moved.
 *
 * @param ptr statement
 * @returns dict `{ columns, conversions, decoders, parameters,
 *    reprepares }`
 */
def describe(statement) {
  var names = _sqlite.column_names(statement)
  var declared = _sqlite.column_decltypes(statement)

  var columns = []

  for index, name in names {
    # Lower cased for the same reason the schema adapter does it:
    # SQLite reports a declared type exactly as it was written, so
    # `TEXT` and `text` are both possible and neither matches what
    # another engine would say. Case carries no meaning in a SQL type
    # name.
    var type = index < declared.length() ? declared[index] : nil

    columns.append({ name, type: type == nil ? nil : type.lower() })
  }

  var conversions = conversions_for(declared)

  return {
    columns,
    conversions,
    decoders: decoders_for(conversions),
    parameters: _sqlite.bind_parameter_count(statement),
    reprepares: _sqlite.reprepare_count(statement),
  }
}

/**
 * Binds `values` to a reset statement, in order.
 *
 * @param ptr statement
 * @param list values
 * @param string query For error messages.
 * @param number expected How many parameters the statement binds, as
 *    `describe()` reported it.
 * @throws QueryError if the count does not match what the statement
 *    expects.
 */
def bind_all(statement, values: list, query: string, expected: number) {
  if values.length() != expected {
    raise QueryError(
      'this statement binds ${expected} parameter' +
          '${expected == 1 ? "" : "s"} and ${values.length()} ' +
          '${values.length() == 1 ? "was" : "were"} given',
      { driver: 'sqlite', query },
    )
  }

  catch {
    iter var index = 0; index < expected; index++ {
      _sqlite.bind(statement, index + 1, flatten(values[index]))
    }
  } as error {
    reraise(error, query)
  }
}

/**
 * A prepared SQLite statement.
 *
 * @printable
 */
class SqliteStatement < DriverStatement {
  var _connection
  var _statement
  var _query
  var _columns = []
  var _decoders = []
  var _parameters = 0
  var _reprepares = 0
  var _closed = false
  var _lent = false

  /**
   * @param SqliteConnection connection The connection that owns this.
   * @param ptr statement The compiled native statement.
   * @param string query The statement text, as sent to the engine.
   */
  @new(connection, statement, query) {
    self._connection = connection
    self._statement = statement
    self._query = query
    self._describe()
  }

  columns() {
    return self._columns
  }

  parameter_count() {
    return self._parameters
  }

  /**
   * Runs the statement for its effect.
   *
   * @param list values
   * @returns dict `{ rows_affected, last_insert_id }`
   */
  execute(values: list) {
    self._ready()
    _sqlite.reset(self._statement)
    _sqlite.clear_bindings(self._statement)
    bind_all(self._statement, values, self._query, self._parameters)

    catch {
      while _sqlite.step(self._statement) == 'row' {
        # A statement run for its effect may still return rows, as an
        # INSERT with a RETURNING clause does. They are stepped past
        # here rather than collected; a caller that wants them runs
        # the statement through select() instead.
      }
    } as error {
      _sqlite.reset(self._statement)
      reraise(error, self._query)
    }

    var affected = self._connection.changes()
    var inserted = self._connection.last_insert_id()

    _sqlite.reset(self._statement)

    return { rows_affected: affected, last_insert_id: inserted }
  }

  /**
   * Runs the statement and reads its whole result.
   *
   * @param list values
   * @returns dict `{ columns, rows }`
   */
  select(values: list) {
    self._ready()
    _sqlite.reset(self._statement)
    _sqlite.clear_bindings(self._statement)
    bind_all(self._statement, values, self._query, self._parameters)

    var rows = []

    catch {
      while _sqlite.step(self._statement) == 'row' {
        rows.append(_sqlite.row(self._statement))
      }
    } as error {
      _sqlite.reset(self._statement)
      reraise(error, self._query)
    }

    # The tables may have changed since this was prepared, in which
    # case the steps above compiled it again; what it is now is what
    # the rows are.
    self._redescribe()
    _sqlite.reset(self._statement)

    var decoders = self._decoders

    if !decoders.is_empty() {
      for row in rows {
        decode_row(row, decoders)
      }
    }

    return { columns: self._columns, rows }
  }

  /**
   * Runs the statement and hands back a cursor over its result.
   *
   * The cursor holds this statement until it closes.
   *
   * @param list values
   * @param dict options Unused here; SQLite streams natively.
   * @returns SqliteCursor
   */
  open_cursor(values: list, options: dict) {
    self._ready()
    _sqlite.reset(self._statement)
    _sqlite.clear_bindings(self._statement)
    bind_all(self._statement, values, self._query, self._parameters)

    # The first step is taken here rather than by the cursor. It is the
    # step that compiles the statement again when its tables changed
    # since it was prepared, and the cursor reports its columns before
    # it hands out a row, so they have to be described after it.
    var outcome

    catch {
      outcome = _sqlite.step(self._statement)
    } as error {
      _sqlite.reset(self._statement)
      reraise(error, self._query)
    }

    self._redescribe()
    self._lent = true

    return SqliteCursor(
      self._connection,
      self._statement,
      self._columns,
      self._decoders,
      self._query,
      false,
      { row: outcome == 'row' ? _sqlite.row(self._statement) : nil },
    )
  }

  /**
   * Releases the statement. Safe to call more than once.
   */
  close() {
    if self._closed {
      return
    }

    self._closed = true
    self._lent = false
    _sqlite.finalize(self._statement)
  }

  /**
   * Whether this statement has been closed.
   *
   * @returns bool
   */
  is_closed() {
    return self._closed
  }

  # Reads the columns the statement has now.
  _describe() {
    var described = describe(self._statement)

    self._columns = described.columns
    self._decoders = described.decoders
    self._parameters = described.parameters
    self._reprepares = described.reprepares
  }

  # Reads them again if SQLite compiled the statement again since they
  # were last read.
  _redescribe() {
    if _sqlite.reprepare_count(self._statement) != self._reprepares {
      self._describe()
    }
  }

  # Raises unless the statement is in a state to be run.
  _ready() {
    if self._closed {
      raise ClosedError('this prepared statement was closed', {
        driver: 'sqlite',
        query: self._query,
      })
    }

    if self._connection.is_closed() {
      raise ClosedError(
        'the connection this prepared statement belongs to was closed',
        { driver: 'sqlite', query: self._query },
      )
    }

    if self._lent and _sqlite.stmt_busy(self._statement) {
      raise QueryError(
        'a cursor is still reading this prepared statement; close it ' +
            'before running the statement again',
        { driver: 'sqlite', query: self._query },
      )
    }

    self._lent = false
  }

  to_string() {
    return '<SqliteStatement ${self._query}${self._closed ? " (closed)" : ""}>'
  }

  @to_string() {
    return self.to_string()
  }
}
