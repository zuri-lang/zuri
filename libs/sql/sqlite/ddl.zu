/**
 * @module ddl
 *
 * Schema changes for SQLite.
 *
 * Creating a table, adding an index and renaming a column are plain
 * statements. Most other changes to a table that exists are not:
 * SQLite's `ALTER TABLE` cannot change a column, add or drop a key, or
 * drop a column that a key or an index uses. For those the table is
 * built again, the way SQLite's own documentation lays out: a new table
 * with the changed definition, the rows copied across, the old table
 * dropped and the new one renamed into its place, then its indexes and
 * triggers put back and the sequence behind an `id()` carried over, so
 * no id is ever handed out twice.
 *
 * The new definition is the old one with only the changed parts
 * rewritten, read from the table's own `create table` text, so
 * whatever else the table declared, checks and collations included,
 * comes through as it was.
 *
 * ### Foreign keys
 *
 * Dropping a table that other tables refer to deletes from it first,
 * and with foreign keys enforced that delete runs their `on delete`
 * actions: building a table again would take every row referring to it
 * along with it. So a rebuild only ever runs with enforcement switched
 * off, which SQLite allows only outside a transaction. `schema_change()`
 * does exactly that around every change it runs, `sql.migrate` runs
 * each migration through it, and the foreign keys are checked before
 * the change commits. A rebuild asked for inside a transaction while
 * foreign keys are enforced raises `NotSupportedError` rather than
 * risk the rows.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import ..blueprint { index_name }
import ..crud { Raw }
import ..ddl { DdlAdapter }
import ..driver { SERIALIZABLE }
import ..errors {
  ForeignKeyViolation,
  NotNullViolation,
  NotSupportedError,
  QueryError,
}

/**
 * The most significant digits a `decimal()` holds exactly here. SQLite
 * keeps a decimal as a double, which carries fifteen.
 */
var MAX_DECIMAL_PRECISION = 15

# A rebuild's new table, before it takes the old one's name.
var _BUILDING = '_zuri_rebuild_'

# The words that open a table constraint rather than a column.
var _CONSTRAINT_WORDS = ['constraint', 'primary', 'unique', 'check', 'foreign']

/**
 * Turns blueprints into SQLite's statements.
 */
class SqliteDdl < DdlAdapter {

  /**
   * @param Column column
   * @returns string
   */
  type_name(column) {
    using column.kind {
      when 'integer' return 'integer'
      when 'big_integer' return 'bigint'
      when 'small_integer' return 'smallint'
      when 'float' return 'real'
      when 'decimal' {
        return 'decimal(${column.precision}, ${column.scale})'
      }
      when 'string' return 'varchar(${column.length})'
      when 'text' return 'text'
      when 'boolean' return 'boolean'
      when 'date' return 'date'
      when 'datetime' return 'datetime'
      when 'time' return 'time'
      when 'binary' return 'blob'
      when 'json' return 'json'
      when 'uuid' return 'char(36)'
    }

    raise QueryError('SQLite has no column type for ${column.kind}')
  }

  /**
   * `integer primary key` makes the column the table's rowid, and
   * `autoincrement` keeps a deleted row's id from being reused.
   *
   * @param Column column
   * @returns string
   */
  key_definition(column) {
    return 'integer primary key autoincrement'
  }

  /**
   * @param bool value
   * @returns string
   */
  boolean_literal(value: bool) {
    return value ? '1' : '0'
  }

  /**
   * The moment of the insert, written in the same form the adapter
   * writes a `date.Date`, so rows the database stamped and rows a
   * program stamped sort and compare as the times they are.
   *
   * @param Column column
   * @returns string
   */
  current_default(column) {
    return "(strftime('%Y-%m-%dT%H:%M:%S', 'now') || " +
        "substr(strftime('%f', 'now'), 3) || '000+00:00')"
  }

  /**
   * @param Column column
   * @throws NotSupportedError for a decimal past fifteen digits.
   */
  check_column(column) {
    if column.kind == 'decimal' and column.precision > MAX_DECIMAL_PRECISION {
      raise NotSupportedError(
        'SQLite holds a decimal as a double, which keeps ${MAX_DECIMAL_PRECISION} ' +
            'significant digits exactly, and ${column.name} asks for ${column.precision}',
        { driver: self.driver.name() },
      )
    }
  }

  /**
   * Carries out one change, as a plain statement where SQLite has one
   * and by building the table again where it does not.
   *
   * @param Connection connection
   * @param Blueprint blueprint
   * @param dict operation
   */
  alter(connection, blueprint, operation) {
    var table = blueprint.table

    using operation.kind {
      when 'column' {
        var column = operation.column

        self.check_column(column)

        if column.is_change {
          self._rebuild(connection, table, @(definition) {
            definition.replace_column(
              column.name,
              self.column_definition(column),
            )

            if column.foreign != nil {
              definition.add_constraint(
                self.foreign_key_sql(table, column.foreign),
              )
            }
          })
        } else if self._adds_in_place(column) {
          self.run(connection, [
            'alter table ${self.table_name(table)} add column ${self.column_definition(column)}',
          ])
        } else {
          catch {
            self._rebuild(connection, table, @(definition) {
              if column.is_generated or column.is_primary {
                definition.refuse_second_primary(table)
              }

              definition.add_column(column.name, self.column_definition(column))

              if column.is_primary and !column.is_generated {
                definition.add_constraint(
                  'primary key (${self.quote(column.name)})',
                )
              }

              if column.foreign != nil {
                definition.add_constraint(
                  self.foreign_key_sql(table, column.foreign),
                )
              }
            })
          } as error {
            # The copy left the new column empty on every row, and a
            # required column refuses that. Said in terms of the change
            # rather than of the table the rebuild was copying into.
            if instance_of(error, NotNullViolation) and !column.is_generated {
              raise NotNullViolation(
                '${column.name} is required and has no default, so it cannot be ' +
                    'added to ${table} while ${table} has rows',
                { driver: self.driver.name() },
              )
            }

            raise error
          }
        }

        var wanted = { unique: column.is_unique, index: column.is_indexed }

        for kind, asked in wanted {
          if asked {
            var name = self._own_name(table, kind, column)
            self.run(connection, [
              self.index_sql(table, kind, name, [column.name], false),
            ])
          }
        }
      }
      when 'primary' {
        self._rebuild(connection, table, @(definition) {
          definition.refuse_second_primary(table)
          definition.add_constraint(
            'primary key (${self._list(operation.columns)})',
          )
        })
      }
      when 'foreign' {
        self._rebuild(connection, table, @(definition) {
          definition.add_constraint(self.foreign_key_sql(table, operation.key))
        })
      }
      when 'drop_column' {
        self._rebuild(connection, table, @(definition) {
          definition.drop_column(operation.name, table)
        })
      }
      when 'drop_foreign' {
        self._rebuild(connection, table, @(definition) {
          definition.drop_foreign(operation.name, operation.columns, table)
        })
      }
      when 'drop_primary' {
        self._rebuild(connection, table, @(definition) {
          definition.drop_primary(table)
        })
      }
      default {
        parent.alter(connection, blueprint, operation)
      }
    }
  }

  /**
   * Drops `table`, refusing while another table refers to it.
   *
   * SQLite would otherwise delete the table's rows first, and with
   * foreign keys enforced, run every `on delete` that refers to them.
   *
   * @param Connection connection
   * @param string table
   * @param dict options `{ if_exists }`.
   */
  drop_table(connection, table: string, options: dict) {
    var place = _place(table)

    if connection.schema.tables(place.schema).contains(place.name) {
      for other in connection.schema.tables(place.schema) {
        if other == place.name {
          continue
        }

        for key in connection.schema.foreign_keys(other, place.schema) {
          if key.references_table == place.name {
            raise QueryError(
              '${table} cannot be dropped while ${other} refers to it through a ' +
                  'foreign key; drop that key or ${other} first',
              { driver: self.driver.name() },
            )
          }
        }
      }
    }

    parent.drop_table(connection, table, options)
  }

  /**
   * Runs `body` with foreign key enforcement switched off, inside a
   * transaction that takes the write lock at once when `transactional`
   * is true, and checks every foreign key before it commits.
   *
   * Enforcement is put back as it was however `body` ends. When it was
   * off to begin with, nothing is switched and nothing is checked.
   *
   * @param Connection connection Not already in a transaction.
   * @param function body
   * @param bool transactional
   * @returns any What `body` returned.
   * @throws ForeignKeyViolation if the change left a row referring to
   *    one that is not there; the change is rolled back.
   */
  schema_change(connection, body: function, transactional: bool) {
    var enforced = connection.fetch_value('pragma foreign_keys', nil, 0) == 1

    if enforced {
      self.run(connection, ['pragma foreign_keys = off'])
    }

    var result

    catch {
      if transactional {
        result = connection.transaction(@(transaction) {
          var value = body(transaction)

          if enforced {
            self._check_foreign_keys(connection)
          }

          return value
        }, SERIALIZABLE)
      } else {
        result = body(connection)

        if enforced {
          self._check_foreign_keys(connection)
        }
      }
    } as error {
      if enforced {
        self.run(connection, ['pragma foreign_keys = on'])
      }

      raise error
    }

    if enforced {
      self.run(connection, ['pragma foreign_keys = on'])
    }

    return result
  }

  # Whether ALTER TABLE ADD COLUMN can add `column` as it is. It cannot
  # add a key, a reference that has to be named to be dropped later, a
  # required column with nothing to fill the rows with, or a default
  # that is not a constant.
  _adds_in_place(column) {
    if column.is_primary or column.is_generated or column.foreign != nil {
      return false
    }

    if column.is_current {
      return false
    }

    if column.has_default {
      return !instance_of(column.initial, Raw)
    }

    return column.is_nullable
  }

  _own_name(table, kind, column) {
    return index_name(table, [column.name], kind)
  }

  # Builds `table` again with `edit` applied to its definition.
  _rebuild(connection, table, edit) {
    var place = _place(table)

    if connection.fetch_value('pragma foreign_keys', nil, 0) == 1 {
      raise NotSupportedError(
        'SQLite builds ${table} again to make this change, which it can only ' +
            'do with foreign keys switched off, and inside this transaction they ' +
            'are on; make the change outside a transaction, or in a migration, ' +
            'which both switch them off around it',
        { driver: self.driver.name() },
      )
    }

    var master = self._master(place)
    var original = connection.fetch_value(
      "select sql from ${master} where type = 'table' and name = ?",
      [place.name],
      nil,
    )

    if original == nil {
      raise QueryError('there is no table called ${table}', {
        driver: self.driver.name(),
      })
    }

    var definition = TableDefinition.parse(original)
    var before = definition.column_names()

    edit(definition)

    var after = definition.column_names()
    var shared = after
        .filter(@(name) => before.contains(name))
        .map(@(name) => self.quote(name))

    # Indexes on a column that is going are dropped with it; the rest,
    # and every trigger, are put back once the table is.
    var going = before.filter(@(name) => !after.contains(name))
    var kept = []

    for index in connection.schema.indexes(table, place.schema) {
      var touches = going.filter(@(name) => index.columns.contains(name))

      if touches.is_empty() {
        kept.append(index.name)
      }
    }

    var extras = connection
        .fetch_all(
          "select type, name, sql from ${master} where tbl_name = ? and type in " +
              "('index', 'trigger') and sql is not null order by type, name",
          [place.name],
        )
        .filter(@(row) => row.type == 'trigger' or kept.contains(row.name))

    var sequence = self._sequence(connection, place)
    var building = _BUILDING + place.name
    var building_table = place.schema == nil
        ? building
        : '${place.schema}.${building}'
    var legacy = connection.fetch_value('pragma legacy_alter_table', nil, 0)
    var columns = ', '.join(shared)

    var statements = [
      definition.render(self.table_name(building_table)),
      'insert into ${self.table_name(building_table)} (${columns}) ' +
          'select ${columns} from ${self.table_name(table)}',
      'drop table ${self.table_name(table)}',

      # A rename normally rewrites every view and trigger that names
      # the table being renamed, and checks the ones that name the
      # table it replaces, which has just gone. Neither is wanted here:
      # the new table takes a name they already use.
      'pragma legacy_alter_table = on',
      'alter table ${self.table_name(building_table)} rename to ${self.quote(place.name)}',
      'pragma legacy_alter_table = ${legacy}',
    ]

    self.run(connection, statements)

    if sequence != nil {
      connection.exec(
        'update ${self._sequence_table(place)} set seq = ? where name = ?',
        [sequence, place.name],
      )
    }

    self.run(connection, extras.map(@(row) => row.sql))
  }

  # The value of the sequence behind an autoincrement key, or nil.
  _sequence(connection, place) {
    var exists = connection.fetch_value(
      "select count(*) from ${self._master(place)} " +
          "where type = 'table' and name = 'sqlite_sequence'",
      nil,
      0,
    )

    if exists == 0 {
      return nil
    }

    return connection.fetch_value(
      'select seq from ${self._sequence_table(place)} where name = ?',
      [place.name],
      nil,
    )
  }

  _sequence_table(place) {
    return self._qualified(place, 'sqlite_sequence')
  }

  # The catalogue of the database `place` is in.
  _master(place) {
    return self._qualified(place, 'sqlite_master')
  }

  # One of SQLite's own tables, in the database `place` is in.
  _qualified(place, name) {
    return place.schema == nil ? name : '${self.quote(place.schema)}.${name}'
  }

  # Raises when a row refers to one that is not there.
  _check_foreign_keys(connection) {
    var broken = connection.fetch_all('pragma foreign_key_check', nil)

    if broken.is_empty() {
      return
    }

    var first = broken[0]
    var more = broken.length() - 1

    raise ForeignKeyViolation(
      'a row of ${first["table"]} refers to a row of ${first["parent"]} that is not ' +
          'there' +
          (more > 0 ? ', and ${more} more like it' : ''),
      { driver: self.driver.name() },
    )
  }
}

/**
 * A table's `create table` text, taken apart into its columns and
 * constraints so a rebuild can rewrite just what changes.
 *
 * Each item keeps the text it was written with. Only an item a change
 * touches is replaced, which is what carries everything the blueprint
 * knows nothing about through a rebuild unchanged.
 */
class TableDefinition {
  /**
   * The column definitions and table constraints, in order. Each is
   * `{ text, column }`, `column` being the column's name, or nil for a
   * constraint.
   * @type list[dict]
   */
  var items = []

  /**
   * What followed the closing parenthesis, such as `without rowid`.
   * @type string
   */
  var tail = ''

  /**
   * Reads a `create table` statement as `sqlite_master` holds it.
   *
   * @param string sql
   * @returns TableDefinition
   * @throws QueryError if it is not one.
   */
  static parse(sql: string) {
    var tokens = _tokens(sql)
    var open = -1

    for index, token in tokens {
      if token.kind == 'open' {
        open = index
        break
      }
    }

    if open == -1 {
      raise QueryError('cannot read the definition of a table from: ${sql}')
    }

    var depth = 0
    var close = -1
    var starts = [tokens[open].end]

    iter var i = open; i < tokens.length(); i++ {
      var token = tokens[i]

      if token.kind == 'open' {
        depth++
      } else if token.kind == 'close' {
        depth--

        if depth == 0 {
          close = i
          break
        }
      } else if token.kind == 'comma' and depth == 1 {
        starts.append(token.end)
      }
    }

    if close == -1 {
      raise QueryError('cannot read the definition of a table from: ${sql}')
    }

    var definition = TableDefinition()
    var ends = []

    for index, start in starts {
      if index + 1 < starts.length() {
        # Up to the comma, which sits just before the next start.
        ends.append(starts[index + 1] - 1)
      } else {
        ends.append(tokens[close].start)
      }
    }

    for index, start in starts {
      var text = sql[start, ends[index]].trim()

      if !text.is_empty() {
        definition.items.append({ text, column: _column_of(text) })
      }
    }

    definition.tail = sql[tokens[close].end,].trim()

    return definition
  }

  /**
   * The names of the columns, in order.
   *
   * @returns list[string]
   */
  column_names() {
    return self.items
        .filter(@(item) => item.column != nil)
        .map(@(item) => item.column)
  }

  /**
   * Replaces the definition of column `name`.
   *
   * @param string name
   * @param string text
   * @throws QueryError if there is no such column.
   */
  replace_column(name: string, text: string) {
    var item = self._column(name)

    if item == nil {
      raise QueryError('there is no column called ${name} to change')
    }

    item.text = text
  }

  /**
   * Adds a column after the last one, ahead of the constraints.
   *
   * @param string name
   * @param string text
   * @throws QueryError if the column is there already.
   */
  add_column(name: string, text: string) {
    if self._column(name) != nil {
      raise QueryError('the table already has a column called ${name}')
    }

    var at = 0

    for index, item in self.items {
      if item.column != nil {
        at = index + 1
      }
    }

    self.items.insert({ text, column: name }, at)
  }

  /**
   * Adds a table constraint.
   *
   * @param string text
   */
  add_constraint(text: string) {
    self.items.append({ text, column: nil })
  }

  /**
   * Drops column `name`, and every key, unique and check constraint
   * that names it.
   *
   * @param string name
   * @param string table For the error message.
   * @throws QueryError if there is no such column, or it is the last.
   */
  drop_column(name: string, table: string) {
    if self._column(name) == nil {
      raise QueryError('${table} has no column called ${name} to drop')
    }

    if self.column_names().length() == 1 {
      raise QueryError(
        '${name} is the only column of ${table}, and a table needs one',
      )
    }

    self.items = self.items.filter(@(item) {
      if item.column != nil {
        return item.column != name
      }

      return !_constraint_names(item.text).contains(name)
    })
  }

  /**
   * Drops the foreign key called `name`, or the one on `columns`,
   * whether it is a table constraint or written on its column.
   *
   * @param string name
   * @param list[string]|nil columns
   * @param string table For the error message.
   * @throws QueryError if there is no such key.
   */
  drop_foreign(name: string, columns, table: string) {
    for index, item in self.items {
      if item.column != nil or !_is_foreign(item.text) {
        continue
      }

      var named = _constraint_name(item.text)
      var keyed = columns != nil and _key_columns(item.text) == columns

      if named == name or keyed {
        self.items.remove_at(index)
        return
      }
    }

    if columns != nil and columns.length() == 1 {
      var item = self._column(columns[0])

      if item != nil {
        var stripped = _strip_clause(item.text, 'references')

        if stripped != item.text {
          item.text = stripped
          return
        }
      }
    }

    raise QueryError('${table} has no foreign key called ${name} to drop')
  }

  /**
   * Drops the primary key, a table constraint or written on its
   * column. The columns stay.
   *
   * @param string table For the error message.
   * @throws QueryError if there is none.
   */
  drop_primary(table: string) {
    for index, item in self.items {
      if item.column == nil and _is_primary(item.text) {
        self.items.remove_at(index)
        return
      }
    }

    for item in self.items {
      if item.column != nil {
        var stripped = _strip_clause(item.text, 'primary')

        if stripped != item.text {
          item.text = stripped
          return
        }
      }
    }

    raise QueryError('${table} has no primary key to drop')
  }

  /**
   * Raises if the table has a primary key, which a new one would be a
   * second of.
   *
   * @param string table For the error message.
   * @throws QueryError if it has one.
   */
  refuse_second_primary(table: string) {
    for item in self.items {
      var words = _words_of(item.text)

      if item.column == nil and _is_primary(item.text) {
        raise QueryError('${table} already has a primary key')
      }

      if item.column != nil and _follows(words, 'primary', 'key') {
        raise QueryError(
          '${table} already has a primary key, on ${item.column}',
        )
      }
    }
  }

  /**
   * The `create table` statement for the definition, under `name`.
   *
   * @param string name Already quoted.
   * @returns string
   */
  render(name: string) {
    var body = ',\n  '.join(self.items.map(@(item) => item.text))
    var tail = self.tail.is_empty() ? '' : ' ' + self.tail

    return 'create table ${name} (\n  ${body}\n)${tail}'
  }

  _column(name) {
    for item in self.items {
      if item.column == name {
        return item
      }
    }

    return nil
  }
}

# A table name as its database and its own name.
def _place(table) {
  var parts = table.split('.')

  if parts.length() > 1 {
    return { schema: parts[0], name: '.'.join(parts[1,]) }
  }

  return { schema: nil, name: table }
}

# The tokens of a piece of SQLite's SQL that matter for taking a
# definition apart: words, quoted names and strings, parentheses and
# commas, each with where it starts and ends. Comments are dropped.
def _tokens(sql) {
  var tokens = []
  var i = 0
  var n = sql.length()

  while i < n {
    var ch = sql[i]

    if ch == '-' and i + 1 < n and sql[i + 1] == '-' {
      var end = sql.index_of('\n', i)
      i = end == -1 ? n : end
      continue
    }

    if ch == '/' and i + 1 < n and sql[i + 1] == '*' {
      var end = sql.index_of('*/', i + 2)
      i = end == -1 ? n : end + 2
      continue
    }

    if ch == "'" or ch == '"' or ch == '`' or ch == '[' {
      var closer = ch == '[' ? ']' : ch
      var j = i + 1

      while j < n {
        if sql[j] == closer {
          if closer != ']' and j + 1 < n and sql[j + 1] == closer {
            j += 2
            continue
          }

          break
        }

        j++
      }

      var end = j < n ? j + 1 : n
      var kind = ch == "'" ? 'string' : 'name'

      tokens.append({ kind, text: sql[i, end], start: i, end })
      i = end
      continue
    }

    if ch == '(' or ch == ')' or ch == ',' {
      var kind = ch == '(' ? 'open' : ch == ')' ? 'close' : 'comma'

      tokens.append({ kind, text: ch, start: i, end: i + 1 })
      i++
      continue
    }

    if _is_word(ch) {
      var j = i

      while j < n and _is_word(sql[j]) {
        j++
      }

      tokens.append({ kind: 'word', text: sql[i, j], start: i, end: j })
      i = j
      continue
    }

    i++
  }

  return tokens
}

def _is_word(ch) {
  return 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$'
      .contains(ch)
}

# A quoted name without its quotes.
def _unquote(text) {
  var first = text[0]

  if first == '"' or first == '`' {
    return text[1, text.length() - 1].replace(first + first, first)
  }

  if first == '[' {
    return text[1, text.length() - 1]
  }

  return text
}

# The column an item defines, or nil for a table constraint.
def _column_of(text) {
  var tokens = _tokens(text)

  if tokens.is_empty() {
    return nil
  }

  var first = tokens[0]

  if first.kind == 'word' and _CONSTRAINT_WORDS.contains(first.text.lower()) {
    return nil
  }

  if first.kind == 'word' or first.kind == 'name' {
    return _unquote(first.text)
  }

  return nil
}

# The lower cased words of an item, outside strings.
def _words_of(text) {
  return _tokens(text)
      .filter(@(token) => token.kind == 'word')
      .map(@(token) => token.text.lower())
}

# Whether `second` comes straight after `first` among `words`.
def _follows(words, first, second) {
  for index, word in words {
    if word == first and
        index + 1 < words.length() and
        words[index + 1] == second {
      return true
    }
  }

  return false
}

# The name a constraint was given with `constraint name`, or nil.
def _constraint_name(text) {
  var tokens = _tokens(text)

  if tokens.length() > 1 and
      tokens[0].kind == 'word' and
      tokens[0].text.lower() == 'constraint' {
    return _unquote(tokens[1].text)
  }

  return nil
}

# The tokens of a constraint after any `constraint name` in front.
def _body_tokens(text) {
  var tokens = _tokens(text)

  if _constraint_name(text) != nil {
    return tokens[2,]
  }

  return tokens
}

def _is_foreign(text) {
  var tokens = _body_tokens(text)
  return !tokens.is_empty() and
      tokens[0].kind == 'word' and
      tokens[0].text.lower() == 'foreign'
}

def _is_primary(text) {
  var tokens = _body_tokens(text)
  return !tokens.is_empty() and
      tokens[0].kind == 'word' and
      tokens[0].text.lower() == 'primary'
}

# The columns in the first parentheses of a key or unique constraint.
def _key_columns(text) {
  var tokens = _body_tokens(text)
  var names = []
  var inside = false

  for token in tokens {
    if token.kind == 'open' {
      if inside {
        break
      }

      inside = true
      continue
    }

    if token.kind == 'close' and inside {
      break
    }

    if inside and (token.kind == 'word' or token.kind == 'name') {
      names.append(_unquote(token.text))
    }
  }

  return names
}

# Every column a constraint names: the columns of a key or unique
# constraint, every word of a check.
def _constraint_names(text) {
  var tokens = _body_tokens(text)

  if tokens.is_empty() {
    return []
  }

  if tokens[0].kind == 'word' and tokens[0].text.lower() == 'check' {
    return tokens
        .filter(@(token) => token.kind == 'word' or token.kind == 'name')
        .map(@(token) => _unquote(token.text))
  }

  return _key_columns(text)
}

# A column definition without its `references` clause or its `primary
# key` clause, whichever `clause` names, along with any `constraint
# name` in front of it. The text comes back unchanged when it has none.
def _strip_clause(text, clause) {
  var tokens = _tokens(text)
  var at = -1

  for index, token in tokens {
    if token.kind == 'word' and token.text.lower() == clause {
      at = index
      break
    }
  }

  if at == -1 {
    return text
  }

  var start = tokens[at].start

  if at >= 2 and
      tokens[at - 2].kind == 'word' and
      tokens[at - 2].text.lower() == 'constraint' {
    start = tokens[at - 2].start
  }

  var end = clause == 'references'
      ? _references_end(tokens, at)
      : _primary_end(tokens, at)
  var stop = end < tokens.length() ? tokens[end].start : text.length()

  return (text[0, start].trim() + ' ' + text[stop,].trim()).trim()
}

# Where a `references` clause starting at `at` ends.
def _references_end(tokens, at) {
  var i = at + 2

  if i < tokens.length() and tokens[i].kind == 'open' {
    while i < tokens.length() and tokens[i].kind != 'close' {
      i++
    }

    i++
  }

  while i < tokens.length() {
    var word = tokens[i].kind == 'word' ? tokens[i].text.lower() : ''

    if word == 'on' {
      # on delete|update cascade|restrict|set null|set default|no action
      var action = i + 2 < tokens.length() ? tokens[i + 2].text.lower() : ''
      i += action == 'set' or action == 'no' ? 4 : 3
    } else if word == 'match' {
      i += 2
    } else if word == 'not' and
        i + 1 < tokens.length() and
        tokens[i + 1].text.lower() == 'deferrable' {
      i += 2
    } else if word == 'deferrable' {
      i++
    } else if word == 'initially' {
      i += 2
    } else {
      break
    }
  }

  return i
}

# Where a `primary key` clause starting at `at` ends.
def _primary_end(tokens, at) {
  var i = at + 2

  while i < tokens.length() {
    var word = tokens[i].kind == 'word' ? tokens[i].text.lower() : ''

    if word == 'asc' or word == 'desc' or word == 'autoincrement' {
      i++
    } else if word == 'on' {
      # on conflict rollback|abort|fail|ignore|replace
      i += 3
    } else {
      break
    }
  }

  return i
}
