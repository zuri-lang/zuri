/**
 * @module blueprint
 *
 * A table's shape, described once for every engine.
 *
 * A `Blueprint` is what `db.schema.create_table()` and
 * `db.schema.alter_table()` hand their body: a description of columns,
 * keys and indexes in Zuri, which the active adapter turns into the
 * statements its own engine understands. The same blueprint creates the
 * same table on SQLite, PostgreSQL, MySQL and MariaDB, which is what
 * lets one migration serve every database a program runs against.
 *
 * ```zuri,ignore
 * db.schema.create_table('posts', @(table: Blueprint) {
 *   table.id()
 *   table.references('author_id', 'authors').on_delete('cascade')
 *   table.string('title', 200)
 *   table.text('body').nullable()
 *   table.boolean('published').default_value(false)
 *   table.timestamps()
 *   table.index('published')
 * })
 * ```
 *
 * ### Column types
 *
 * Each type is the same kind of value on every engine, stored the way
 * that engine stores it best.
 *
 * | Method | SQLite | PostgreSQL | MySQL and MariaDB |
 * | - | - | - | - |
 * | `id()` | `integer primary key autoincrement` | `bigint generated by default as identity` | `bigint auto_increment` |
 * | `integer()` | `integer` | `integer` | `int` |
 * | `big_integer()` | `bigint` | `bigint` | `bigint` |
 * | `small_integer()` | `smallint` | `smallint` | `smallint` |
 * | `float()` | `real` | `double precision` | `double` |
 * | `decimal(p, s)` | `decimal(p, s)` | `numeric(p, s)` | `decimal(p, s)` |
 * | `string(n)` | `varchar(n)` | `varchar(n)` | `varchar(n)` |
 * | `text()` | `text` | `text` | `longtext` |
 * | `boolean()` | `boolean` | `boolean` | `tinyint(1)` |
 * | `date()` | `date` | `date` | `date` |
 * | `datetime()` | `datetime` | `timestamp with time zone` | `datetime(6)` |
 * | `time()` | `time` | `time` | `time(6)` |
 * | `binary()` | `blob` | `bytea` | `longblob` |
 * | `json()` | `json` | `jsonb` | `json` |
 * | `uuid()` | `char(36)` | `uuid` | `char(36)` |
 *
 * An `id()` is never handed out twice, even after the row holding the
 * highest one is deleted. A `decimal()` on SQLite holds at most 15
 * significant digits, the most a double keeps exactly, so a larger
 * precision raises `NotSupportedError` there rather than storing
 * digits that would quietly change.
 *
 * ### Columns are required unless they say otherwise
 *
 * Every column is `NOT NULL` until `nullable()` says it may hold
 * nothing. A missing value is then an error the database reports,
 * rather than a null nobody meant to store.
 *
 * ### Names
 *
 * Indexes, unique indexes and foreign keys are named for their table
 * and columns: `posts_author_id_index`, `posts_slug_unique`,
 * `posts_author_id_foreign`. Because the name is known, dropping one
 * takes its columns as readily as its name. A name past 63 characters,
 * the longest PostgreSQL keeps, is shortened and given a hash of the
 * whole so it stays unique.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import hash

import .errors { QueryError }

/** Deletes the rows that refer to a deleted row. */
var CASCADE = 'cascade'

/** Refuses to delete a row while others refer to it. */
var RESTRICT = 'restrict'

/** Sets the referring column to null. */
var SET_NULL = 'set null'

/** Sets the referring column to its default. */
var SET_DEFAULT = 'set default'

/**
 * Does nothing at the moment of the change, and refuses it at the end
 * of the statement if a reference is left dangling. What a foreign key
 * does when it names no action.
 */
var NO_ACTION = 'no action'

/** Every action `on_delete()` and `on_update()` accept. */
var ACTIONS = [CASCADE, RESTRICT, SET_NULL, SET_DEFAULT, NO_ACTION]

/** The longest name every engine keeps whole. */
var MAX_NAME = 63

/**
 * The name an index or key on `columns` of `table` takes.
 *
 * `suffix` is `index`, `unique`, `foreign` or `primary`. The table's
 * own name is used without any schema in front of it, and a name past
 * `MAX_NAME` characters is cut short and finished with eight
 * characters of a hash of the whole, so two long names that share a
 * beginning still differ.
 *
 * ```zuri,ignore
 * index_name('posts', ['author_id', 'created_at'], 'index')
 * # posts_author_id_created_at_index
 * ```
 *
 * @param string table
 * @param list[string] columns
 * @param string suffix
 * @returns string
 */
def index_name(table: string, columns: list, suffix: string) {
  var bare = table.split('.')
  var name = '_'.join([bare[bare.length() - 1]] + columns + [suffix]).lower()

  if name.length() <= MAX_NAME {
    return name
  }

  return name[0, MAX_NAME - 9] + '_' + hash.fnv1a_64(name)[0, 8]
}

/**
 * A foreign key: the columns of one table that refer to rows of
 * another.
 *
 * Made by `Blueprint.foreign()`, or by `Column.references()` for a key
 * of one column. The actions say what happens to a referring row when
 * the row it refers to is deleted or has its key changed. With none
 * given, the engine refuses the change while references remain.
 *
 * @printable
 */
class ForeignKey {
  /**
   * The referring columns.
   * @type list[string]
   */
  var columns

  /**
   * The table referred to.
   * @type string
   */
  var table

  /**
   * The columns referred to, in the same order as `columns`.
   * @type list[string]
   */
  var references

  /**
   * What deleting a referred row does, one of `ACTIONS`, or nil for
   * the engine's default, `NO_ACTION`.
   * @default nil
   */
  var on_delete_action

  /**
   * What changing a referred key does, one of `ACTIONS`, or nil.
   * @default nil
   */
  var on_update_action

  /**
   * The constraint's name, or nil to take the one `index_name()`
   * gives.
   * @default nil
   */
  var name

  /**
   * @param list[string] columns
   * @param string table
   * @param list[string] references
   */
  @new(columns, table, references) {
    self.columns = columns
    self.table = table
    self.references = references
  }

  /**
   * Says what deleting a referred row does to the rows referring to
   * it.
   *
   * @param string action One of `ACTIONS`: `'cascade'`, `'restrict'`,
   *    `'set null'`, `'set default'` or `'no action'`.
   * @returns ForeignKey This key, for chaining.
   * @throws QueryError for any other action.
   */
  on_delete(action: string) {
    self.on_delete_action = _action(action)
    return self
  }

  /**
   * Says what changing a referred key does to the rows referring to
   * it.
   *
   * @param string action One of `ACTIONS`.
   * @returns ForeignKey This key, for chaining.
   * @throws QueryError for any other action.
   */
  on_update(action: string) {
    self.on_update_action = _action(action)
    return self
  }

  /**
   * Names the constraint, in place of the name `index_name()` gives.
   *
   * @param string name
   * @returns ForeignKey This key, for chaining.
   */
  named(name: string) {
    self.name = _identifier(name, 'a foreign key name')
    return self
  }

  /**
   * The constraint's name on `table`.
   *
   * @param string table The referring table.
   * @returns string
   */
  name_on(table: string) {
    return self.name == nil
        ? index_name(table, self.columns, 'foreign')
        : self.name
  }

  to_string() {
    return '<ForeignKey (${", ".join(self.columns)}) -> ' +
        '${self.table} (${", ".join(self.references)})>'
  }

  @to_string() {
    return self.to_string()
  }
}

/**
 * One column, as a blueprint describes it.
 *
 * Every column method on `Blueprint` returns one of these, and every
 * method here returns the column again, so a column is described in
 * one chain:
 *
 * ```zuri,ignore
 * table.string('email', 254).exact().unique()
 * ```
 *
 * @printable
 */
class Column {
  /**
   * The column's name.
   * @type string
   */
  var name

  /**
   * Which of the blueprint's types this is, as the method that made it
   * is named: `'integer'`, `'string'`, `'datetime'` and so on.
   * @type string
   */
  var kind

  /**
   * The length of a `string()`.
   * @default nil
   */
  var length

  /**
   * The total digits of a `decimal()`.
   * @default nil
   */
  var precision

  /**
   * The digits after the point of a `decimal()`.
   * @default nil
   */
  var scale

  /**
   * Whether the column may hold null.
   * @default false
   */
  var is_nullable = false

  /**
   * Whether a default was given, which a default of nil needs saying
   * apart from no default at all.
   * @default false
   */
  var has_default = false

  /**
   * The value a row starts with when an insert leaves the column out:
   * a value, or a `sql.Raw` fragment. Meaningful when `has_default`
   * is true.
   * @default nil
   */
  var initial

  /**
   * Whether the column defaults to the time a row is inserted.
   * @default false
   */
  var is_current = false

  /**
   * Whether the column has a unique index of its own.
   * @default false
   */
  var is_unique = false

  /**
   * Whether the column has an index of its own.
   * @default false
   */
  var is_indexed = false

  /**
   * Whether the column is the table's primary key.
   * @default false
   */
  var is_primary = false

  /**
   * Whether the column is compared byte for byte.
   * @default false
   */
  var is_exact = false

  /**
   * Whether the engine numbers the column itself, as `id()` does.
   * @default false
   */
  var is_generated = false

  /**
   * The foreign key the column carries, or nil.
   * @default nil
   */
  var foreign

  /**
   * Whether this redefines a column the table already has, rather than
   * adding one.
   * @default false
   */
  var is_change = false

  /**
   * @param string name
   * @param string kind
   */
  @new(name, kind) {
    self.name = _identifier(name, 'a column name')
    self.kind = kind
  }

  /**
   * Lets the column hold null. Without this, every column is required.
   *
   * @returns Column
   */
  nullable() {
    self.is_nullable = true
    return self
  }

  /**
   * Gives the column a default, used when an insert leaves it out.
   *
   * The value is written into the table definition as a literal of the
   * column's type: a string, a number, a bool, nil, a `sql.Decimal`, or
   * for a `json()` column a list or dictionary. A `sql.Raw` is written
   * as given, for a default that is an expression rather than a value;
   * it is SQL, and the engine reads it as such.
   *
   * ```zuri,ignore
   * table.integer('views').default_value(0)
   * table.json('settings').default_value({})
   * ```
   *
   * @param any value
   * @returns Column
   */
  default_value(value) {
    self.has_default = true
    self.initial = value
    return self
  }

  /**
   * Defaults a `datetime()` column to the moment a row is inserted.
   *
   * @returns Column
   * @throws QueryError on a column that is not a `datetime()`.
   */
  use_current() {
    if self.kind != 'datetime' {
      raise QueryError(
        'use_current() is for a datetime column, and ${self.name} is a ${self.kind}',
      )
    }

    self.is_current = true
    return self
  }

  /**
   * Gives the column a unique index of its own, named by
   * `index_name()`.
   *
   * @returns Column
   */
  unique() {
    self.is_unique = true
    return self
  }

  /**
   * Gives the column an index of its own, named by `index_name()`.
   *
   * @returns Column
   */
  index() {
    self.is_indexed = true
    return self
  }

  /**
   * Makes the column the table's primary key. A key of several columns
   * is `Blueprint.primary()`.
   *
   * @returns Column
   */
  primary() {
    self.is_primary = true
    return self
  }

  /**
   * Compares the column byte for byte, so case and accents always
   * count: `'Ada'` and `'ada'` are two values, and so are `'é'` and
   * `'e'`.
   *
   * SQLite compares this way already. PostgreSQL is given the `"C"`
   * collation and MySQL and MariaDB `utf8mb4_bin`, whose default
   * collations treat case, and on MySQL accents, as the same. Use it
   * for a column that holds a key, where two values differing only in
   * case must not collide or match each other.
   *
   * @returns Column
   * @throws QueryError on a column that does not hold text.
   */
  exact() {
    if !['string', 'text', 'uuid'].contains(self.kind) {
      raise QueryError(
        'exact() is for a column holding text, and ${self.name} is a ${self.kind}',
      )
    }

    self.is_exact = true
    return self
  }

  /**
   * Makes the column refer to a row of another table.
   *
   * The column's values have to be the referred column's values, or
   * null on a nullable column. `on_delete()` and `on_update()` on this
   * column then say what happens when the referred row changes.
   *
   * ```zuri,ignore
   * table.uuid('owner_id').references('users', 'id')
   * ```
   *
   * @param string table
   * @param string|nil column The referred column, `id` when nil.
   * @returns Column
   */
  references(table: string, column) {
    var referred = column == nil ? 'id' : column

    self.foreign = ForeignKey(
      [self.name],
      _identifier(table, 'a table name'),
      [_identifier(referred, 'a column name')],
    )

    return self
  }

  /**
   * What deleting the referred row does, on a column that
   * `references()` another table.
   *
   * @param string action One of `ACTIONS`.
   * @returns Column
   * @throws QueryError if the column refers to nothing, or for an
   *    unknown action.
   */
  on_delete(action: string) {
    self._referring('on_delete').on_delete(action)
    return self
  }

  /**
   * What changing the referred key does, on a column that
   * `references()` another table.
   *
   * @param string action One of `ACTIONS`.
   * @returns Column
   * @throws QueryError if the column refers to nothing, or for an
   *    unknown action.
   */
  on_update(action: string) {
    self._referring('on_update').on_update(action)
    return self
  }

  /**
   * Turns this into a change to a column the table already has, inside
   * `alter_table()`.
   *
   * The column takes the type, nullability, default and comparison
   * declared here, whatever it had before, so declare it in full:
   * leaving out `nullable()` makes it required. Its indexes stay as
   * they are, and `unique()` or `index()` here adds one.
   *
   * ```zuri,ignore
   * db.schema.alter_table('posts', @(table: Blueprint) {
   *   table.string('title', 300).change()
   * })
   * ```
   *
   * @returns Column
   */
  change() {
    self.is_change = true
    return self
  }

  _referring(what) {
    if self.foreign == nil {
      raise QueryError(
        '${what}() is for a column that references() another table, ' +
            'and ${self.name} refers to none',
      )
    }

    return self.foreign
  }

  to_string() {
    return '<Column ${self.name} ${self.kind}${self.is_nullable ? " nullable" : ""}>'
  }

  @to_string() {
    return self.to_string()
  }
}

/**
 * The description of one table, or of the changes to one.
 *
 * `db.schema.create_table()` and `db.schema.alter_table()` make one and
 * pass it to their body, then hand it to the adapter, which carries out
 * what it describes in the order it was described. A program does not
 * build one itself.
 *
 * @printable
 */
class Blueprint {
  /**
   * The table's name.
   * @type string
   */
  var table

  /**
   * Whether this creates the table rather than altering it.
   * @type bool
   */
  var creating

  /**
   * Everything described, in order. Each is a dictionary whose `kind`
   * says what it is: `column` (with `column`), `primary`, `unique` and
   * `index` (with `columns` and `name`), `foreign` (with `key`),
   * `rename_column` (with `from` and `to`), `drop_column` (with
   * `name`), `drop_index`, `drop_unique` and `drop_foreign` (with
   * `name`) and `drop_primary`.
   *
   * @type list[dict]
   */
  var operations = []

  /**
   * @param string table
   * @param bool creating
   */
  @new(table, creating) {
    self.table = _identifier(table, 'a table name')
    self.creating = creating
  }

  /**
   * The columns described, added and changed, in order.
   *
   * @returns list[Column]
   */
  columns() {
    return self.operations
        .filter(@(operation) => operation.kind == 'column')
        .map(@(operation) => operation.column)
  }

  /**
   * An auto-numbered primary key, a big integer the engine assigns on
   * insert and never assigns twice.
   *
   * @param string|nil name `id` when nil.
   * @returns Column
   */
  id(name) {
    var column = self._column(name == nil ? 'id' : name, 'id')

    column.is_primary = true
    column.is_generated = true

    return column
  }

  /**
   * A 32 bit integer.
   *
   * @param string name
   * @returns Column
   */
  integer(name: string) {
    return self._column(name, 'integer')
  }

  /**
   * A 64 bit integer. Values past 2^53 read back as a `bigint`.
   *
   * @param string name
   * @returns Column
   */
  big_integer(name: string) {
    return self._column(name, 'big_integer')
  }

  /**
   * A 16 bit integer.
   *
   * @param string name
   * @returns Column
   */
  small_integer(name: string) {
    return self._column(name, 'small_integer')
  }

  /**
   * A double precision float.
   *
   * @param string name
   * @returns Column
   */
  float(name: string) {
    return self._column(name, 'float')
  }

  /**
   * An exact decimal of `precision` digits, `scale` of them after the
   * point. Reads back as a `sql.Decimal`.
   *
   * @param string name
   * @param number precision From 1 to 65; at most 15 on SQLite.
   * @param number|nil scale From 0 to `precision`, 0 when nil.
   * @returns Column
   * @throws QueryError if either is out of range.
   */
  decimal(name: string, precision: number, scale) {
    var digits = scale == nil ? 0 : scale

    _whole(precision, 1, 65, 'a decimal precision')
    _whole(digits, 0, precision, 'a decimal scale')

    var column = self._column(name, 'decimal')

    column.precision = precision
    column.scale = digits

    return column
  }

  /**
   * Text of at most `length` characters.
   *
   * @param string name
   * @param number|nil length From 1 to 16383, 255 when nil.
   * @returns Column
   * @throws QueryError if `length` is out of range.
   */
  string(name: string, length) {
    var size = length == nil ? 255 : length

    _whole(size, 1, 16383, 'a string length')

    var column = self._column(name, 'string')
    column.length = size

    return column
  }

  /**
   * Text of any length.
   *
   * @param string name
   * @returns Column
   */
  text(name: string) {
    return self._column(name, 'text')
  }

  /**
   * A boolean. MySQL and MariaDB store it as `0` and `1`, and read it
   * back that way unless a model casts it.
   *
   * @param string name
   * @returns Column
   */
  boolean(name: string) {
    return self._column(name, 'boolean')
  }

  /**
   * A calendar date.
   *
   * @param string name
   * @returns Column
   */
  date(name: string) {
    return self._column(name, 'date')
  }

  /**
   * A moment, to the microsecond. Reads back as a `date.Date`.
   *
   * @param string name
   * @returns Column
   */
  datetime(name: string) {
    return self._column(name, 'datetime')
  }

  /**
   * A time of day, or on MySQL and MariaDB a signed span, as a
   * `sql.Time`.
   *
   * @param string name
   * @returns Column
   */
  time(name: string) {
    return self._column(name, 'time')
  }

  /**
   * Bytes of any length.
   *
   * @param string name
   * @returns Column
   */
  binary(name: string) {
    return self._column(name, 'binary')
  }

  /**
   * A JSON document. A list or dictionary written to it reads back as
   * one, except on MariaDB, whose JSON is text.
   *
   * @param string name
   * @returns Column
   */
  json(name: string) {
    return self._column(name, 'json')
  }

  /**
   * A UUID, held as its 36 character text.
   *
   * @param string name
   * @returns Column
   */
  uuid(name: string) {
    return self._column(name, 'uuid')
  }

  /**
   * A column referring to another table's `id()`: a big integer
   * carrying a foreign key.
   *
   * ```zuri,ignore
   * table.references('author_id', 'authors').on_delete('cascade')
   * ```
   *
   * @param string name
   * @param string table The table referred to.
   * @param string|nil column The column referred to, `id` when nil.
   * @returns Column
   */
  references(name: string, table: string, column) {
    return self.big_integer(name).references(table, column)
  }

  /**
   * `created_at` and `updated_at`, both `datetime()` columns defaulting
   * to the moment a row is inserted. A model with `timestamps()` keeps
   * them up to date.
   *
   * @returns list[Column] The two columns.
   */
  timestamps() {
    return [
      self.datetime('created_at').use_current(),
      self.datetime('updated_at').use_current(),
    ]
  }

  /**
   * A primary key spanning `columns`.
   *
   * @param string|list[string] columns
   */
  primary(columns) {
    self.operations.append({ kind: 'primary', columns: _names(columns) })
  }

  /**
   * A unique index on `columns`.
   *
   * @param string|list[string] columns
   * @param string|nil name `index_name()`'s when nil.
   */
  unique(columns, name) {
    self._index('unique', columns, name)
  }

  /**
   * An index on `columns`.
   *
   * @param string|list[string] columns
   * @param string|nil name `index_name()`'s when nil.
   */
  index(columns, name) {
    self._index('index', columns, name)
  }

  /**
   * A foreign key from `columns` to `references` of `table`.
   *
   * ```zuri,ignore
   * table.foreign(['order_id', 'line'], 'order_lines', ['order_id', 'line'])
   *   .on_delete('cascade')
   * ```
   *
   * @param string|list[string] columns
   * @param string table
   * @param string|list[string]|nil references `id` when nil.
   * @returns ForeignKey
   * @throws QueryError if the two lists differ in length.
   */
  foreign(columns, table: string, references) {
    var own = _names(columns)
    var referred = _names(references == nil ? 'id' : references)

    if own.length() != referred.length() {
      raise QueryError(
        'a foreign key from ${own.length()} column${own.length() == 1 ? "" : "s"} ' +
            'has to refer to as many, not ${referred.length()}',
      )
    }

    var key = ForeignKey(own, _identifier(table, 'a table name'), referred)

    self.operations.append({ kind: 'foreign', key })

    return key
  }

  /**
   * Renames a column, keeping its data, indexes and keys.
   *
   * @param string from
   * @param string to
   */
  rename_column(from: string, to: string) {
    self._altering('rename_column')
    self.operations.append({
      kind: 'rename_column',
      from: _identifier(from, 'a column name'),
      to: _identifier(to, 'a column name'),
    })
  }

  /**
   * Drops a column, or each of a list of them.
   *
   * The indexes, unique indexes and keys the column is part of go with
   * it, on every engine.
   *
   * @param string|list[string] names
   */
  drop_column(names) {
    self._altering('drop_column')

    for name in _names(names) {
      self.operations.append({ kind: 'drop_column', name })
    }
  }

  /**
   * Drops an index, by its name or by the columns it was made on.
   *
   * @param string|list[string] name The name; a list is the columns,
   *    and names the index `index_name()` gives them.
   */
  drop_index(name) {
    self._drop('drop_index', name, 'index')
  }

  /**
   * Drops a unique index, by its name or by its columns.
   *
   * @param string|list[string] name
   */
  drop_unique(name) {
    self._drop('drop_unique', name, 'unique')
  }

  /**
   * Drops a foreign key, by its name or by its columns.
   *
   * @param string|list[string] name
   */
  drop_foreign(name) {
    self._drop('drop_foreign', name, 'foreign')
  }

  /**
   * Drops the primary key. The columns stay.
   */
  drop_primary() {
    self._altering('drop_primary')
    self.operations.append({ kind: 'drop_primary' })
  }

  _column(name, kind) {
    var column = Column(name, kind)

    self.operations.append({ kind: 'column', column })

    return column
  }

  _index(kind, columns, name) {
    var own = _names(columns)
    var chosen = name == nil
        ? index_name(self.table, own, kind)
        : _identifier(name, 'an index name')

    self.operations.append({ kind, columns: own, name: chosen })
  }

  _drop(kind, name, suffix) {
    self._altering(kind)

    var columns = is_list(name) ? _names(name) : nil
    var resolved = columns != nil
        ? index_name(self.table, columns, suffix)
        : _identifier(name, 'an index name')

    self.operations.append({ kind, name: resolved, columns })
  }

  _altering(what) {
    if self.creating {
      raise QueryError(
        '${what}() changes a table that exists, and ${self.table} is being created',
      )
    }
  }

  to_string() {
    return '<Blueprint ${self.creating ? "creating" : "altering"} ${self.table}>'
  }

  @to_string() {
    return self.to_string()
  }
}

# A name, checked for being one.
def _identifier(name, what) {
  if !is_string(name) or name.trim().is_empty() {
    raise QueryError('${what} has to be a non-empty string')
  }

  return name
}

# One name or a list of them, as a list of checked names.
def _names(value) {
  var names = is_list(value) ? value : [value]

  if names.is_empty() {
    raise QueryError('at least one column has to be named')
  }

  return names.map(@(name) => _identifier(name, 'a column name'))
}

# A whole number within bounds, or a QueryError naming what it was for.
def _whole(value, low, high, what) {
  if !is_number(value) or
      value != value.floor() or
      value < low or
      value > high {
    raise QueryError(
      '${what} is a whole number from ${low} to ${high}, not ${value}',
    )
  }
}

# An action for a foreign key, in its canonical spelling.
def _action(action) {
  var spelled = ' '.join(action.lower().trim().split('/\\s+/'))

  if !ACTIONS.contains(spelled) {
    raise QueryError(
      'a foreign key action is one of ${", ".join(ACTIONS)}, not ${action}',
    )
  }

  return spelled
}
