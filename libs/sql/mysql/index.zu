/**
 * @module mysql
 *
 * The MySQL and MariaDB adapter.
 *
 * Use it through `sql`, so that your program stays portable:
 *
 * ```zuri,ignore
 * import sql
 *
 * var db = sql.open('mysql://alice:secret@localhost/app')
 * ```
 *
 * The module itself is for the parts of MySQL that have no equivalent
 * in other engines: the server's own settings, the connection ID, and
 * which of the two servers answered.
 *
 * ### Protocol support
 *
 * The adapter uses the client/server protocol over TCP, optionally with
 * TLS and optionally compressed with zlib or zstd, or over a Unix
 * domain socket. To use a socket, give its path in the `socket` option,
 * or give a `host` that starts with a slash. TLS isn't offered or
 * needed on a socket, because there's nothing in between, and the
 * connection counts as private, which decides whether an authentication
 * plugin can send the password itself.
 *
 * A statement without values is sent as text, which takes one round
 * trip. A statement with values is prepared, so that the values are
 * sent in the server's binary encoding instead of being written into
 * the SQL. Prepared statements are kept and reused, so a query run in a
 * loop is only compiled once.
 *
 * ### Authentication
 *
 * The supported plugins are `mysql_native_password`,
 * `caching_sha2_password` (both the fast cached exchange and the slower
 * one behind it), `sha256_password`, `mysql_clear_password` and
 * MariaDB's `client_ed25519`. On a connection that isn't private, the
 * two plugins that need the password itself encrypt it with the
 * server's public key instead of sending it as it is, and
 * `mysql_clear_password` is refused.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import @.driver {
  MariaDbDriver,
  MySqlDriver,
  DRIVER,
  MARIADB_DRIVER,
  DEFAULT_PORT,
  MAX_PARAMETERS,
  SSL_MODES,
}
import @.connection { MySqlConnection }
import @.statement { MySqlStatement }
import @.cursor { MySqlCursor }
import @.protocol { CAPABILITIES, COMMANDS, Protocol }
import @.packets { PacketStream }
import @.types { FLAGS, TYPES, type_name_of }
import @.errors { class_for, raise_for }
import @.auth { CACHING_SHA2, CLEAR, ED25519, NATIVE, SHA256 }

/**
 * Opens a MySQL connection directly, without going through `sql`.
 *
 * Anything meant to stay portable should use `sql.open()` instead.
 *
 * @param string|dict dsn A connection string or options.
 * @returns MySqlConnection
 */
def connect(dsn) {
  return DRIVER.connect(DRIVER.parse_dsn(dsn))
}
