/**
 * @module transaction
 *
 * Transactions, and the nesting that savepoints make possible.
 *
 * The shape worth using is the closure form, because it cannot be got
 * wrong:
 *
 * ```zuri,ignore
 * db.transaction(@(tx) {
 *   tx.exec('update accounts set balance = balance - ? where id = ?', [100, 1])
 *   tx.exec('update accounts set balance = balance + ? where id = ?', [100, 2])
 * })
 * ```
 *
 * It commits when the closure returns and rolls back when the closure
 * raises, and there is no path through it that leaves a transaction
 * open. The manual form exists for the cases the closure form cannot
 * express, such as a transaction whose lifetime is a request rather
 * than a block.
 *
 * ### Nesting
 *
 * No engine here supports a transaction inside a transaction, but both
 * support savepoints, which is the same thing under a different name.
 * A `transaction()` inside another takes a savepoint, so a helper that
 * opens one works the same whether it was called on its own or from
 * inside a larger piece of work. Only the outermost actually commits.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import .errors { TransactionError }

/**
 * An open transaction.
 *
 * It carries the same query, exec and CRUD methods a connection does,
 * so code inside a transaction reads the same as code outside one.
 * Every statement it runs goes to the connection the transaction is
 * on.
 *
 * @printable
 */
class Transaction {
  /**
   * The connection this transaction is running on.
   * @type Connection
   */
  var connection

  /**
   * Whether this transaction is a savepoint inside another rather than
   * a transaction of its own.
   *
   * @type bool
   */
  var nested = false

  var _finished = false

  /**
   * @param Connection connection
   * @param bool nested
   */
  @new(connection, nested) {
    self.connection = connection
    self.nested = nested ? true : false
  }

  /**
   * Whether this transaction has already committed or rolled back.
   *
   * @returns bool
   */
  is_finished() {
    return self._finished
  }

  /**
   * Runs a query on this transaction's connection.
   *
   * @param string sql
   * @param list|dict|nil params
   * @returns ResultSet
   */
  query(sql: string, params) {
    self._active()
    return self.connection.query(sql, params)
  }

  /**
   * Runs a statement for its effect.
   *
   * @param string sql
   * @param list|dict|nil params
   * @returns ExecResult
   */
  exec(sql: string, params) {
    self._active()
    return self.connection.exec(sql, params)
  }

  /**
   * The first row of a query, or nil.
   *
   * @param string sql
   * @param list|dict|nil params
   * @returns dict|nil
   */
  fetch_one(sql: string, params) {
    self._active()
    return self.connection.fetch_one(sql, params)
  }

  /**
   * Every row of a query.
   *
   * @param string sql
   * @param list|dict|nil params
   * @returns list[dict]
   */
  fetch_all(sql: string, params) {
    self._active()
    return self.connection.fetch_all(sql, params)
  }

  /**
   * The first column of the first row.
   *
   * @param string sql
   * @param list|dict|nil params
   * @param any fallback
   * @returns any
   */
  fetch_value(sql: string, params, fallback) {
    self._active()
    return self.connection.fetch_value(sql, params, fallback)
  }

  /**
   * One column's values, as a list.
   *
   * @param string sql
   * @param list|dict|nil params
   * @param string|number|nil column Which column, the first by
   *    default.
   * @returns list
   */
  fetch_column(sql: string, params, column) {
    self._active()
    return self.connection.fetch_column(sql, params, column)
  }

  /**
   * Runs a query and returns a cursor over its result rather than
   * reading all of it. The cursor belongs to the transaction's
   * connection, so it has to be read to the end or closed before the
   * transaction commits.
   *
   * @param string sql
   * @param list|dict|nil params
   * @param dict|nil options `{ batch }` on engines that fetch in
   *    batches.
   * @returns Cursor
   */
  stream(sql: string, params, options) {
    self._active()
    return self.connection.stream(sql, params, options)
  }

  /**
   * Compiles a statement for repeated use inside this transaction.
   *
   * @param string sql
   * @returns Statement
   */
  prepare(sql: string) {
    self._active()
    return self.connection.prepare(sql)
  }

  /**
   * Runs one or more statements for their effect, as a script: a
   * schema file, a migration, or a batch of settings. It binds no
   * parameters and returns no rows.
   *
   * On PostgreSQL and SQLite the whole script commits or rolls back
   * with the transaction. MySQL commits a statement that changes a
   * table's definition as it runs it, whatever transaction it is in,
   * so a script of those is only as atomic as MySQL makes it.
   *
   * @param string sql
   */
  exec_script(sql: string) {
    self._active()
    self.connection.exec_script(sql)
  }

  /**
   * Inserts a row and returns its id.
   *
   * @param string table
   * @param dict values
   * @param dict|nil options
   * @returns any
   */
  insert(table: string, values: dict, options) {
    self._active()
    return self.connection.insert(table, values, options)
  }

  /**
   * Inserts several rows in one statement.
   *
   * @param string table
   * @param list rows Dictionaries of column to value.
   * @returns number How many rows were inserted.
   */
  insert_many(table: string, rows: list) {
    self._active()
    return self.connection.insert_many(table, rows)
  }

  /**
   * Updates the rows matching `where`.
   *
   * @param string table
   * @param dict values
   * @param dict|nil where
   * @returns number
   */
  update(table: string, values: dict, where) {
    self._active()
    return self.connection.update(table, values, where)
  }

  /**
   * Deletes the rows matching `where`.
   *
   * @param string table
   * @param dict|nil where
   * @returns number
   */
  delete(table: string, where) {
    self._active()
    return self.connection.delete(table, where)
  }

  /**
   * Selects the rows matching `where`.
   *
   * @param string table
   * @param dict|nil where
   * @param dict|nil options `columns`, `order`, `limit` and `offset`.
   * @returns ResultSet
   */
  find(table: string, where, options) {
    self._active()
    return self.connection.find(table, where, options)
  }

  /**
   * The first row matching `where`, or nil.
   *
   * @param string table
   * @param dict|nil where
   * @param dict|nil options
   * @returns dict|nil
   */
  find_one(table: string, where, options) {
    self._active()
    return self.connection.find_one(table, where, options)
  }

  /**
   * How many rows match `where`.
   *
   * @param string table
   * @param dict|nil where
   * @returns number
   */
  count(table: string, where) {
    self._active()
    return self.connection.count(table, where)
  }

  /**
   * Commits this transaction, or releases its savepoint when it is
   * nested.
   *
   * @throws TransactionError if it has already finished.
   */
  commit() {
    self._active()
    self._finished = true
    self.connection.driver_connection().commit()
  }

  /**
   * Rolls this transaction back, or undoes its savepoint when it is
   * nested.
   *
   * @throws TransactionError if it has already finished.
   */
  rollback() {
    self._active()
    self._finished = true
    self.connection.driver_connection().rollback()
  }

  _active() {
    if self._finished {
      raise TransactionError(
        'this transaction has already ' +
        '${self.nested ? "left its savepoint" : "finished"}'
      )
    }
  }

  to_string() {
    var kind = self.nested ? 'savepoint' : 'transaction'
    return '<Transaction ${kind}${self._finished ? " (finished)" : ""}>'
  }

  @to_string() {
    return self.to_string()
  }
}
