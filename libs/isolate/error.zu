/**
 * @module error
 *
 * Defines `IsolateError` and its subclasses. They're in a module of
 * their own, with no imports, so that both `index` and `channel` can
 * depend on them without importing each other. The `isolate` module
 * re-exports them.
 */

/**
 * Raised when an isolate's function raises an error that it doesn't
 * catch, when a `Channel` operation fails, or when a value can't be
 * passed to another isolate.
 */
class IsolateError < Error {
  @new(message) {
    self.message = message or self.message
    self.type = 'IsolateError'
  }
}

/**
 * Raised when `Isolate.join()`, `Channel.send()` or `Channel.recv()` is
 * given a `timeout` that passes before the operation completes.
 */
class IsolateTimeoutError < IsolateError {
  @new(message) {
    self.message = message or self.message
    self.type = 'IsolateTimeoutError'
  }
}

/**
 * Raised by `Isolate.join()`, `Channel.send()`, `Channel.recv()`,
 * `isolate.wait_any()`, `isolate.wait_all()` or `isolate.select()` when
 * the *calling* isolate, the one that's waiting in that call, is
 * cancelled with `cancel()`. It isn't raised because of whatever the
 * call was waiting for.
 */
class IsolateCancelledError < IsolateError {
  @new(message) {
    self.message = message or self.message
    self.type = 'IsolateCancelledError'
  }
}
