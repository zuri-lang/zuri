/**
 * @module uint32
 *
 * `UInt32Array`: a packed array of unsigned 32-bit integers, 4 bytes per
 * element.
 *
 * `UINT32_MAX` and `UINT32_MIN` bound what an element
 * may be; a value outside them raises rather than wrapping.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import ._base { Array }


/**
 * Maximum value that "should" exist in a list passed to
 * UInt32Array.
 * @type number
 */
var UINT32_MAX = 4294967295


/**
 * class UInt32Array represents an array of twos-complement 32-bit
 * unsigned integers in the platform byte order.
 *
 * @printable
 * @valueable
 * @serializable
 */
class UInt32Array < Array {

  var _data
  var _item_size = 4
  var _data_type = 'L'

  _validate_value(value) {
    if !is_int(value)
      raise TypeError('integer expected')
    if value < 0 or value > UINT32_MAX
      raise ValueError('value out of uint32 range')
  }

  /**
   * Returns a new array containing the elements in the original
   * array in reverse order.
   *
   * @returns UInt32Array
   */
  reverse() {
    return UInt32Array(self.to_list().reverse())
  }

  /**
   * Returns a new UInt32Array containing all items from the
   * current array. The new array is a shallow copy of the
   * original array.
   *
   * @returns UInt32Array
   */
  clone() {
    return UInt32Array(self.to_list())
  }

  /**
   * Returns a new UInt32Array over `[start, end)` of this array
   * (both default to the whole array; negative bounds count from
   * the end).
   *
   * @param ?number start
   * @param ?number end
   * @returns UInt32Array
   */
  slice(start, end) {
    return UInt32Array(self._sliced_list(start, end))
  }
}
