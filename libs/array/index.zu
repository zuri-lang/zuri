/**
 * @module array
 *
 * Typed arrays with fixed-width elements: two's complement integers,
 * from `Int8Array` and `UInt8Array` up to `Int64Array` and
 * `UInt64Array`, and IEEE 754 floating-point numbers, in `FloatArray`
 * and `DoubleArray`. Each one stores its elements packed together, in
 * the platform's byte order. They work alongside `bytes`, and let you
 * work with binary data at a higher level, while still giving you
 * direct access to the underlying bytes with `to_bytes()`.
 *
 * All ten classes have the same interface: indexing, `append()`,
 * `insert()`, `remove_at()`, `set()`, `pop()`, `slice()`, `fill()`,
 * `equals()`, iteration with `for x in arr`, and conversion with
 * `to_list()` and `to_bytes()`. [[array.Int16Array]] has the full
 * documentation, and every other class in this module follows it.
 *
 * `Int64Array` and `UInt64Array` accept and return `bigint` values, as
 * well as plain integers, for anything too large for a `number` to hold
 * exactly. See `is_bigint()`.
 *
 * ### Example
 *
 * ```zuri
 * import array
 *
 * var a = array.Int32Array([1, 2, 3])
 * a.append(4)
 * for x in a {
 *   echo x
 * }
 * echo a.slice(1, 3).to_list()   # [2, 3]
 * ```
 *
 * @copyright 2022, Richard Ore and The Zuri Contributors
 */

import @.int8 { * }
import @.uint8 { * }
import @.int16 { * }
import @.uint16 { * }
import @.int32 { * }
import @.uint32 { * }
import @.int64 { * }
import @.uint64 { * }
import @.float { * }
import @.double { * }
