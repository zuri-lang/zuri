/**
 * @module int16
 *
 * `Int16Array`, a packed array of 16-bit signed integers in two's
 * complement, with 2 bytes per element.
 *
 * `INT16_MAX` and `INT16_MIN` are the limits for an element. A value
 * outside them raises an error, instead of wrapping around.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import ._base { Array }

/**
 * Maximum value that "should" exist in a list passed to
 * Int16Array.
 * @type number
 */
var INT16_MAX = 32767

/**
 * Minimum value that "should" exist in a list passed to
 * Int16Array.
 * @type number
 */
var INT16_MIN = -INT16_MAX - 1

/**
 * class Int16Array represents an array of twos-complement 16-bit
 * signed integers in the platform byte order.
 *
 * @printable
 * @valueable
 * @serializable
 */
class Int16Array < Array {

  var _data
  var _item_size = 2
  var _data_type = 's'

  _validate_value(value) {
    if !is_int(value) {
      raise TypeError('integer expected')
    }
    if value < INT16_MIN or value > INT16_MAX {
      raise ValueError('value out of int16 range')
    }
  }

  /**
   * Returns a new array containing the elements in the original
   * array in reverse order.
   *
   * @returns Int16Array
   */
  reverse() {
    return Int16Array(self.to_list().reverse())
  }

  /**
   * Returns a new Int16Array containing all items from the
   * current array. The new array is a shallow copy of the
   * original array.
   *
   * @returns Int16Array
   */
  clone() {
    return Int16Array(self.to_list())
  }

  /**
   * Returns a new `Int16Array` with the elements from `start` up to,
   * but not including, `end`. Both default to the whole array, and
   * negative values count from the end.
   *
   * @param ?number start
   * @param ?number end
   * @returns Int16Array
   */
  slice(start, end) {
    return Int16Array(self._sliced_list(start, end))
  }
}
