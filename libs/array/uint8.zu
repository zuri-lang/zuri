/**
 * @module uint8
 *
 * `UInt8Array`: a packed array of unsigned 8-bit integers, 1 byte per
 * element.
 *
 * `UINT8_MAX` and `UINT8_MIN` bound what an element
 * may be; a value outside them raises rather than wrapping.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import ._base { Array }


/**
 * Maximum value that "should" exist in a list passed to
 * UInt8Array.
 * @type number
 */
var UINT8_MAX = 255


/**
 * class UInt8Array represents an array of twos-complement 8-bit
 * unsigned integers.
 *
 * @printable
 * @valueable
 * @serializable
 */
class UInt8Array < Array {

  var _data
  var _item_size = 1
  var _data_type = 'C'

  _validate_value(value) {
    if !is_int(value)
      raise TypeError('integer expected')
    if value < 0 or value > UINT8_MAX
      raise ValueError('value out of uint8 range')
  }

  /**
   * Returns a new array containing the elements in the original
   * array in reverse order.
   *
   * @returns UInt8Array
   */
  reverse() {
    return UInt8Array(self.to_list().reverse())
  }

  /**
   * Returns a new UInt8Array containing all items from the
   * current array. The new array is a shallow copy of the
   * original array.
   *
   * @returns UInt8Array
   */
  clone() {
    return UInt8Array(self.to_list())
  }

  /**
   * Returns a new UInt8Array over `[start, end)` of this array
   * (both default to the whole array; negative bounds count from
   * the end).
   *
   * @param ?number start
   * @param ?number end
   * @returns UInt8Array
   */
  slice(start, end) {
    return UInt8Array(self._sliced_list(start, end))
  }
}
