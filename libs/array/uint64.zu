import ._base { Array }


/**
 * Maximum value that "should" exist in a list passed to
 * UInt64Array.
 * @type bigint
 */
var UINT64_MAX = 18446744073709551615n

# Plain-number-typed counterpart, used only when validating a plain
# number value -- see Int64Array's own _INT64_MAX_NUM for why this
# needs to exist separately (no number/bigint comparison operator).
var _UINT64_MAX_NUM = UINT64_MAX.to_number()


/**
 * class UInt64Array represents an array of twos-complement 64-bit
 * unsigned integers in the platform byte order.
 *
 * Values at or beyond 2^53 need Zuri's `bigint` type to be
 * represented exactly (a regular `number` is an IEEE-754 double,
 * and loses precision past that point) — `append()`/`set()` accept
 * either a plain integer or a bigint (`is_bigint()`) for that
 * reason.
 *
 * @printable
 * @valueable
 * @serializable
 */
class UInt64Array < Array {

  var _data
  var _item_size = 8
  var _data_type = 'Q'

  _validate_value(value) {
    if is_bigint(value) {
      if value < 0n or value > UINT64_MAX
        raise ValueError('value out of uint64 range')
      return
    }
    if !is_int(value)
      raise TypeError('integer expected')
    if value < 0 or value > _UINT64_MAX_NUM
      raise ValueError('value out of uint64 range')
  }

  /**
   * Returns a new array containing the elements in the original
   * array in reverse order.
   *
   * @returns UInt64Array
   */
  reverse() {
    return UInt64Array(self.to_list().reverse())
  }

  /**
   * Returns a new UInt64Array containing all items from the
   * current array. The new array is a shallow copy of the
   * original array.
   *
   * @returns UInt64Array
   */
  clone() {
    return UInt64Array(self.to_list())
  }

  /**
   * Returns a new UInt64Array over `[start, end)` of this array
   * (both default to the whole array; negative bounds count from
   * the end).
   *
   * @param ?number start
   * @param ?number end
   * @returns UInt64Array
   */
  slice(start, end) {
    return UInt64Array(self._sliced_list(start, end))
  }
}
