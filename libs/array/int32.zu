/**
 * @module int32
 *
 * `Int32Array`: a packed array of twos-complement 32-bit signed integers, 4 bytes per
 * element.
 *
 * `INT32_MAX` and `INT32_MIN` bound what an element
 * may be; a value outside them raises rather than wrapping.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import ._base { Array }


/**
 * Maximum value that "should" exist in a list passed to
 * Int32Array.
 * @type number
 */
var INT32_MAX = 2147483647

/**
 * Minimum value that "should" exist in a list passed to
 * Int32Array.
 * @type number
 */
var INT32_MIN = -INT32_MAX - 1


/**
 * class Int32Array represents an array of twos-complement 32-bit
 * signed integers in the platform byte order.
 *
 * @printable
 * @valueable
 * @serializable
 */
class Int32Array < Array {

  var _data
  var _item_size = 4
  var _data_type = 'l'

  _validate_value(value) {
    if !is_int(value)
      raise TypeError('integer expected')
    if value < INT32_MIN or value > INT32_MAX
      raise ValueError('value out of int32 range')
  }

  /**
   * Returns a new array containing the elements in the original
   * array in reverse order.
   *
   * @returns Int32Array
   */
  reverse() {
    return Int32Array(self.to_list().reverse())
  }

  /**
   * Returns a new Int32Array containing all items from the
   * current array. The new array is a shallow copy of the
   * original array.
   *
   * @returns Int32Array
   */
  clone() {
    return Int32Array(self.to_list())
  }

  /**
   * Returns a new Int32Array over `[start, end)` of this array
   * (both default to the whole array; negative bounds count from
   * the end).
   *
   * @param ?number start
   * @param ?number end
   * @returns Int32Array
   */
  slice(start, end) {
    return Int32Array(self._sliced_list(start, end))
  }
}
