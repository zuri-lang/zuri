import ._base { Array }


/**
 * Maximum value that "should" exist in a list passed to
 * DoubleArray.
 * @type number
 */
var DOUBLE_MAX = 1.79769313486231570815E+308

/**
 * Minimum value that "should" exist in a list passed to
 * DoubleArray.
 * @type number
 */
var DOUBLE_MIN = -DOUBLE_MAX


/**
 * class DoubleArray represents an array of 64-bit IEEE-754
 * floating-point numbers (doubles) in the platform byte order.
 *
 * @printable
 * @valueable
 * @serializable
 */
class DoubleArray < Array {

  var _data
  var _item_size = 8
  var _data_type = 'd'

  _validate_value(value) {
    if !is_number(value)
      raise TypeError('number expected')
    if value < DOUBLE_MIN or value > DOUBLE_MAX
      raise ValueError('value out of double range')
  }

  /**
   * Returns a new array containing the elements in the original
   * array in reverse order.
   *
   * @returns DoubleArray
   */
  reverse() {
    return DoubleArray(self.to_list().reverse())
  }

  /**
   * Returns a new DoubleArray containing all items from the
   * current array. The new array is a shallow copy of the
   * original array.
   *
   * @returns DoubleArray
   */
  clone() {
    return DoubleArray(self.to_list())
  }

  /**
   * Returns a new DoubleArray over `[start, end)` of this array
   * (both default to the whole array; negative bounds count from
   * the end).
   *
   * @param ?number start
   * @param ?number end
   * @returns DoubleArray
   */
  slice(start, end) {
    return DoubleArray(self._sliced_list(start, end))
  }
}
