/**
 * @module uint16
 *
 * `UInt16Array`: a packed array of unsigned 16-bit integers, 2 bytes per
 * element.
 *
 * `UINT16_MAX` and `UINT16_MIN` bound what an element
 * may be; a value outside them raises rather than wrapping.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import ._base { Array }


/**
 * Maximum value that "should" exist in a list passed to
 * UInt16Array.
 * @type number
 */
var UINT16_MAX = 65535


/**
 * class UInt16Array represents an array of twos-complement 16-bit
 * unsigned integers in the platform byte order.
 *
 * @printable
 * @valueable
 * @serializable
 */
class UInt16Array < Array {

  var _data
  var _item_size = 2
  var _data_type = 'S'

  _validate_value(value) {
    if !is_int(value)
      raise TypeError('integer expected')
    if value < 0 or value > UINT16_MAX
      raise ValueError('value out of uint16 range')
  }

  /**
   * Returns a new array containing the elements in the original
   * array in reverse order.
   *
   * @returns UInt16Array
   */
  reverse() {
    return UInt16Array(self.to_list().reverse())
  }

  /**
   * Returns a new UInt16Array containing all items from the
   * current array. The new array is a shallow copy of the
   * original array.
   *
   * @returns UInt16Array
   */
  clone() {
    return UInt16Array(self.to_list())
  }

  /**
   * Returns a new UInt16Array over `[start, end)` of this array
   * (both default to the whole array; negative bounds count from
   * the end).
   *
   * @param ?number start
   * @param ?number end
   * @returns UInt16Array
   */
  slice(start, end) {
    return UInt16Array(self._sliced_list(start, end))
  }
}
