import ._base { Array }


/**
 * Maximum value that "should" exist in a list passed to
 * Int64Array. Written with the explicit `n` bigint suffix since
 * the bare literal `9223372036854775807` parses as a lossy
 * `number` (a known, pre-existing limitation of plain integer
 * literals at exactly `i64::MAX` — see
 * `tests/big-integer-literal-overflow.zu`), 193 away from the true
 * value.
 * @type bigint
 */
var INT64_MAX = 9223372036854775807n

/**
 * Minimum value that "should" exist in a list passed to
 * Int64Array.
 * @type bigint
 */
var INT64_MIN = -9223372036854775808n

# Plain-`number`-typed counterparts of INT64_MAX/INT64_MIN, used only
# when validating a plain-number value: Zuri has no comparison
# operator between a `number` and a `bigint` at all (confirmed: even
# `3 < 5n` raises "operator '<' not defined for number and bigint"),
# so a value's bounds check has to compare against a same-typed pair.
# Derived via .to_number() rather than a second hand-typed literal, so
# there's exactly one place either constant's true value comes from.
var _INT64_MAX_NUM = INT64_MAX.to_number()
var _INT64_MIN_NUM = INT64_MIN.to_number()


/**
 * class Int64Array represents an array of twos-complement 64-bit
 * signed integers in the platform byte order.
 *
 * Values at or beyond ±2^53 need Zuri's `bigint` type to be
 * represented exactly (a regular `number` is an IEEE-754 double,
 * and loses precision past that point) — `append()`/`set()` accept
 * either a plain integer or a bigint (`is_bigint()`) for that
 * reason.
 *
 * @printable
 * @valueable
 * @serializable
 */
class Int64Array < Array {

  var _data
  var _item_size = 8
  var _data_type = 'q'

  _validate_value(value) {
    if is_bigint(value) {
      if value < INT64_MIN or value > INT64_MAX
        raise ValueError('value out of int64 range')
      return
    }
    if !is_int(value)
      raise TypeError('integer expected')
    if value < _INT64_MIN_NUM or value > _INT64_MAX_NUM
      raise ValueError('value out of int64 range')
  }

  /**
   * Returns a new array containing the elements in the original
   * array in reverse order.
   *
   * @returns Int64Array
   */
  reverse() {
    return Int64Array(self.to_list().reverse())
  }

  /**
   * Returns a new Int64Array containing all items from the
   * current array. The new array is a shallow copy of the
   * original array.
   *
   * @returns Int64Array
   */
  clone() {
    return Int64Array(self.to_list())
  }

  /**
   * Returns a new Int64Array over `[start, end)` of this array
   * (both default to the whole array; negative bounds count from
   * the end).
   *
   * @param ?number start
   * @param ?number end
   * @returns Int64Array
   */
  slice(start, end) {
    return Int64Array(self._sliced_list(start, end))
  }
}
