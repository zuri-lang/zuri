/**
 * @module float
 *
 * `FloatArray`: a packed array of single-precision IEEE 754 floats, 4 bytes per
 * element.
 *
 * `FLOAT_MAX` and `FLOAT_MIN` are the largest and
 * smallest finite values the type can hold.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import ._base { Array }


/**
 * Maximum value that "should" exist in a list passed to
 * FloatArray.
 * @type number
 */
var FLOAT_MAX = 3.402823466E+38

/**
 * Minimum value that "should" exist in a list passed to
 * FloatArray.
 * @type number
 */
var FLOAT_MIN = -FLOAT_MAX


/**
 * class FloatArray represents an array of 32-bit IEEE-754
 * floating-point numbers in the platform byte order.
 *
 * @printable
 * @valueable
 * @serializable
 */
class FloatArray < Array {

  var _data
  var _item_size = 4
  var _data_type = 'f'

  _validate_value(value) {
    if !is_number(value)
      raise TypeError('number expected')
    if value < FLOAT_MIN or value > FLOAT_MAX
      raise ValueError('value out of float range')
  }

  /**
   * Returns a new array containing the elements in the original
   * array in reverse order.
   *
   * @returns FloatArray
   */
  reverse() {
    return FloatArray(self.to_list().reverse())
  }

  /**
   * Returns a new FloatArray containing all items from the
   * current array. The new array is a shallow copy of the
   * original array.
   *
   * @returns FloatArray
   */
  clone() {
    return FloatArray(self.to_list())
  }

  /**
   * Returns a new FloatArray over `[start, end)` of this array
   * (both default to the whole array; negative bounds count from
   * the end).
   *
   * @param ?number start
   * @param ?number end
   * @returns FloatArray
   */
  slice(start, end) {
    return FloatArray(self._sliced_list(start, end))
  }
}
