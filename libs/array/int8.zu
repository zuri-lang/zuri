/**
 * @module int8
 *
 * `Int8Array`: a packed array of twos-complement 8-bit signed integers, 1 byte per
 * element.
 *
 * `INT8_MAX` and `INT8_MIN` bound what an element
 * may be; a value outside them raises rather than wrapping.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import ._base { Array }


/**
 * Maximum value that "should" exist in a list passed to
 * Int8Array.
 * @type number
 */
var INT8_MAX = 127

/**
 * Minimum value that "should" exist in a list passed to
 * Int8Array.
 * @type number
 */
var INT8_MIN = -INT8_MAX - 1


/**
 * class Int8Array represents an array of twos-complement 8-bit
 * signed integers.
 *
 * @printable
 * @valueable
 * @serializable
 */
class Int8Array < Array {

  var _data
  var _item_size = 1
  var _data_type = 'c'

  _validate_value(value) {
    if !is_int(value)
      raise TypeError('integer expected')
    if value < INT8_MIN or value > INT8_MAX
      raise ValueError('value out of int8 range')
  }

  /**
   * Returns a new array containing the elements in the original
   * array in reverse order.
   *
   * @returns Int8Array
   */
  reverse() {
    return Int8Array(self.to_list().reverse())
  }

  /**
   * Returns a new Int8Array containing all items from the
   * current array. The new array is a shallow copy of the
   * original array.
   *
   * @returns Int8Array
   */
  clone() {
    return Int8Array(self.to_list())
  }

  /**
   * Returns a new Int8Array over `[start, end)` of this array
   * (both default to the whole array; negative bounds count from
   * the end).
   *
   * @param ?number start
   * @param ?number end
   * @returns Int8Array
   */
  slice(start, end) {
    return Int8Array(self._sliced_list(start, end))
  }
}
