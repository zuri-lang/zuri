/**
 * @module enum
 *
 * This module provides Zuri's implementation of enumerations as described
 * in the language documentation: a set of unique values bound to symbolic
 * names via an alias.
 *
 * ### Creating an enumeration
 *
 * Initialize from a list of symbolic names; each is automatically
 * assigned an ordinal value starting from zero:
 *
 * ```zuri
 * import enum
 *
 * var Gender = enum(['Male', 'Female'])
 * echo Gender.Male     # 0
 * echo Gender.Female   # 1
 * ```
 *
 * Initialize from a dictionary to bind specific values (numbers or
 * strings) instead of automatic ordinals:
 *
 * ```zuri
 * var Color = enum({
 *   Red: 'r',
 *   Green: 'g',
 *   Blue: 'b',
 * })
 * echo enum.to_string(Color)   # <Enum Red=r Green=g Blue=b>
 * ```
 *
 * By default, duplicate values in a dictionary-initialized enumeration
 * raise an error. Pass `true` as the second argument to allow them:
 *
 * ```zuri
 * var Speed = enum({
 *   Slow: 1,
 *   Sluggish: 1,
 *   Fast: 2,
 * }, true)
 * ```
 *
 * @copyright 2026, Richard Ore and The Zuri Contributors
 */

/**
 * Creates a new enumeration from either a list of symbolic names or a
 * dictionary of symbolic-name to value pairs.
 *
 * When `source` is a list, every item must be a string; each is bound,
 * in order, to an automatically assigned ordinal value starting at zero.
 *
 * When `source` is a dictionary, its keys must be strings and its values
 * must be numbers or strings. Duplicate values are rejected unless
 * `allow_duplicates` is `true`.
 *
 * Enumeration keys are always unique; since the source is itself a
 * dictionary or list, a duplicated symbolic name is never possible to
 * express in the first place.
 *
 * @param {list[string]|dict} source
 * @param ?bool allow_duplicates: Default value is `false`.
 * @returns dict
 * @raises TypeError: If `source` is not a list or dictionary, or its
 *   entries are of the wrong type.
 * @raises Error: If a duplicate value is found and `allow_duplicates`
 *   is not `true`.
 */
def enum(source, allow_duplicates) {
  if allow_duplicates == nil {
    allow_duplicates = false
  } else if !is_bool(allow_duplicates) {
    raise TypeError('allow_duplicates must be a boolean, ${typeof(allow_duplicates)} given')
  }

  var result = {}

  if is_list(source) {
    var i = 0
    for item in source {
      if !is_string(item) {
        raise TypeError('enum() list items must be strings, ${typeof(item)} given')
      }
      if result.contains(item) {
        raise Error('duplicate enumeration key "${item}"')
      }
      result[item] = i
      i++
    }
  } else if is_dict(source) {
    var seen_values = []

    for key, value in source {
      if !is_string(key) {
        raise TypeError('enum() dictionary keys must be strings, ${typeof(key)} given')
      }
      if !is_number(value) and !is_string(value) {
        raise TypeError(
          'enum() dictionary values must be a number or a string, ${typeof(value)} given'
        )
      }

      if !allow_duplicates {
        if seen_values.contains(value) {
          raise Error('duplicate enumeration value "${value}" at "${key}"')
        }
        seen_values.append(value)
      }

      result[key] = value
    }
  } else {
    raise TypeError('enum() expects a list or dictionary, ${typeof(source)} given')
  }

  return result
}

# Verifies that `e` is a valid enumeration object (i.e. a dict produced by
# `enum()`) and raises a TypeError if not.
def _check(e) {
  if !is_dict(e) {
    raise TypeError('expected an enumeration object, ${typeof(e)} given')
  }
}

/**
 * Returns the symbolic keys of an enumeration, in the order they were
 * declared.
 *
 * @note Equivalent to calling `.keys()` directly on the enum object,
 *   since an enumeration is itself a dictionary.
 * @param dict e
 * @returns list[string]
 */
def keys(e) {
  _check(e)
  return e.keys()
}

/**
 * Returns the possible values of an enumeration, in the order their
 * corresponding keys were declared.
 *
 * @note Equivalent to calling `.values()` directly on the enum object.
 * @param dict e
 * @returns list[number|string]
 */
def values(e) {
  _check(e)
  return e.values()
}

/**
 * Returns the enumeration as a key/value dictionary.
 *
 * @param dict e
 * @returns dict
 */
def to_dict(e) {
  _check(e)
  return e.clone()
}

/**
 * Returns the enumeration as a value/key dictionary.
 *
 * Since dictionaries cannot contain duplicate keys, if multiple
 * enumeration keys share the same value, only the LAST declared key for
 * that value is represented in the result; matching the documented
 * behavior.
 *
 * @param dict e
 * @returns dict
 */
def to_value_dict(e) {
  _check(e)

  var result = {}
  for key, value in e {
    result[value] = key
  }
  return result
}

/**
 * Returns `true` if the enumeration contains the given symbolic key, or
 * `false` otherwise.
 *
 * @note Equivalent to calling `.contains(key)` directly on the enum
 *   object.
 * @param dict e
 * @param string key
 * @returns bool
 */
def has(e, key) {
  _check(e)
  if !is_string(key) {
    return false
  }
  return e.contains(key)
}

/**
 * Returns `value` unchanged if it is a valid value for the enumeration,
 * or raises an `Error` if it is not.
 *
 * @param dict e
 * @param any value
 * @returns any
 * @raises Error: If `value` is not one of the enumeration's values.
 */
def ensure(e, value) {
  _check(e)

  for key, v in e {
    if v == value {
      return value
    }
  }

  raise Error('unknown key/value in specified enumeration')
}

/**
 * Returns a string representation of the enumeration.
 *
 * @param dict e
 * @returns string
 */
def to_string(e) {
  _check(e)

  var parts = []
  for key, value in e {
    parts.append('${key}=${value}')
  }

  return '<Enum ' + ' '.join(parts) + '>'
}
