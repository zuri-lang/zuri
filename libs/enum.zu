/**
 * @module enum
 *
 * Enumerations: a set of unique values, each bound to a symbolic name.
 *
 * ### Creating an enumeration
 *
 * From a list of names, each name gets a number, starting from zero:
 *
 * ```zuri
 * import enum
 *
 * var Gender = enum(['Male', 'Female'])
 * echo Gender.Male     # 0
 * echo Gender.Female   # 1
 * ```
 *
 * From a dictionary, each name gets the value you give it, which can be
 * a number or a string:
 *
 * ```zuri
 * var Color = enum({
 *   Red: 'r',
 *   Green: 'g',
 *   Blue: 'b',
 * })
 * echo enum.to_string(Color)   # <Enum Red=r Green=g Blue=b>
 * ```
 *
 * By default, duplicate values in a dictionary raise an error. Pass
 * `true` as the second argument to allow them:
 *
 * ```zuri
 * var Speed = enum({
 *   Slow: 1,
 *   Sluggish: 1,
 *   Fast: 2,
 * }, true)
 * ```
 *
 * @copyright 2026, Richard Ore and The Zuri Contributors
 */

/**
 * Creates an enumeration from either a list of names or a dictionary
 * that maps names to values.
 *
 * When `source` is a list, every item must be a string, and each one is
 * given a number, in order, starting from zero.
 *
 * When `source` is a dictionary, its keys must be strings, and its
 * values must be numbers or strings. Duplicate values are rejected,
 * unless `allow_duplicates` is `true`.
 *
 * Names in an enumeration are always unique, because the source is a
 * dictionary or a list, so a duplicate name can't be written in the
 * first place.
 *
 * @param {list[string]|dict} source
 * @param ?bool allow_duplicates: defaults to `false`.
 * @returns dict
 * @raises TypeError: If `source` isn't a list or a dictionary, or its
 *    entries are of the wrong type.
 * @raises Error: If a duplicate value is found and `allow_duplicates`
 *    isn't `true`.
 */
def enum(source, allow_duplicates) {
  if allow_duplicates == nil {
    allow_duplicates = false
  } else if !is_bool(allow_duplicates) {
    raise TypeError(
      'allow_duplicates must be a boolean, ${typeof(allow_duplicates)} given',
    )
  }

  var result = {}

  if is_list(source) {
    var i = 0
    for item in source {
      if !is_string(item) {
        raise TypeError(
          'enum() list items must be strings, ${typeof(item)} given',
        )
      }
      if result.contains(item) {
        raise Error('duplicate enumeration key "${item}"')
      }
      result[item] = i
      i++
    }
  } else if is_dict(source) {
    var seen_values = []

    for key, value in source {
      if !is_string(key) {
        raise TypeError(
          'enum() dictionary keys must be strings, ${typeof(key)} given',
        )
      }
      if !is_number(value) and !is_string(value) {
        raise TypeError(
          'enum() dictionary values must be a number or a string, ${typeof(value)} given',
        )
      }

      if !allow_duplicates {
        if seen_values.contains(value) {
          raise Error('duplicate enumeration value "${value}" at "${key}"')
        }
        seen_values.append(value)
      }

      result[key] = value
    }
  } else {
    raise TypeError(
      'enum() expects a list or dictionary, ${typeof(source)} given',
    )
  }

  return result
}

# Verifies that `e` is a valid enumeration object (i.e. a dict produced by
# `enum()`) and raises a TypeError if not.
def _check(e) {
  if !is_dict(e) {
    raise TypeError('expected an enumeration object, ${typeof(e)} given')
  }
}

/**
 * Returns the symbolic keys of an enumeration, in the order they
 * were declared.
 *
 * @note Equivalent to calling `.keys()` directly on the enum
 *    object, since an enumeration is itself a dictionary.
 * @param dict e
 * @returns list[string]
 */
def keys(e) {
  _check(e)
  return e.keys()
}

/**
 * Returns the possible values of an enumeration, in the order
 * their corresponding keys were declared.
 *
 * @note Equivalent to calling `.values()` directly on the enum
 *    object.
 * @param dict e
 * @returns list[number|string]
 */
def values(e) {
  _check(e)
  return e.values()
}

/**
 * Returns the enumeration as a key/value dictionary.
 *
 * @param dict e
 * @returns dict
 */
def to_dict(e) {
  _check(e)
  return e.clone()
}

/**
 * Returns the enumeration as a dictionary that maps values to names.
 *
 * A dictionary can't have duplicate keys, so if several names have the
 * same value, only the last name declared for that value is included in
 * the result.
 *
 * @param dict e
 * @returns dict
 */
def to_value_dict(e) {
  _check(e)

  var result = {}
  for key, value in e {
    result[value] = key
  }
  return result
}

/**
 * Returns `true` if the enumeration contains the given symbolic
 * key, or `false` otherwise.
 *
 * @note Equivalent to calling `.contains(key)` directly on the
 *    enum object.
 * @param dict e
 * @param string key
 * @returns bool
 */
def has(e, key) {
  _check(e)
  if !is_string(key) {
    return false
  }
  return e.contains(key)
}

/**
 * Returns `value` unchanged if it is a valid value for the
 * enumeration, or raises an `Error` if it is not.
 *
 * @param dict e
 * @param any value
 * @returns any
 * @raises Error: If `value` is not one of the enumeration's
 *    values.
 */
def ensure(e, value) {
  _check(e)

  for key, v in e {
    if v == value {
      return value
    }
  }

  raise Error('unknown key/value in specified enumeration')
}

/**
 * Returns a string representation of the enumeration.
 *
 * @param dict e
 * @returns string
 */
def to_string(e) {
  _check(e)

  var parts = []
  for key, value in e {
    parts.append('${key}=${value}')
  }

  return '<Enum ' + ' '.join(parts) + '>'
}
