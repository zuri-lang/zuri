/**
 * @module bzip2
 *
 * The Bzip2 submodule for the compress module.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _compress

/**
 * Compress data using the default options for Bzip2.
 *
 * @param {bytes|string} data
 * @param ?number level: Compression level (1..=9) — Default 9.
 * @returns bytes
 */
def compress(data, level) {
  return _compress.bzip2_compress(data, level)
}

/**
 * Decompress Bzip2-compressed data.
 *
 * @note This only decodes the first bzip2 stream in `data`. Some
 *    tools (`pbzip2`, Wikipedia data dumps, ...) concatenate several
 *    independent bzip2 streams back to back ("multistreams"); use
 *    `Bzip2Decoder` in a loop with `reset()` to decode all of them.
 * @param {bytes|string} data
 * @returns bytes
 */
def decompress(data) {
  return _compress.bzip2_decompress(data)
}


/**
 * A streaming Bzip2 encoder.
 *
 * Example:
 *
 * ```zuri-repl
 * %> import compress.bzip2
 * %> var encoder = bzip2.Bzip2Encoder()
 * %> encoder.write('hello world')
 * 11
 * %> encoder.finish()
 * (42 5a 68 39 31 41 59 26 53 59 ...)
 * ```
 */
class Bzip2Encoder {
  var _ptr

  /**
   * Creates a new streaming Bzip2 encoder.
   *
   * @param ?number level: Compression level (1..=9) — Default 9.
   * @param ?number work_factor: Controls when the compressor falls
   *    back from its standard sorting algorithm to a slower but
   *    more robust one on highly repetitive input. 0..=250 — 0
   *    (the default) means "use bzip2's own default of 30".
   */
  @new(level, work_factor) {
    self._ptr = _compress.bzip2_new_encoder(level, work_factor)
  }

  /**
   * Flushes remaining data, writes the stream footer, and returns
   * the inner byte stream.
   *
   * @note Once finish is called, the encoder can no longer be
   *    reused.
   * @returns bytes
   */
  finish() {
    return _compress.bzip2_encoder_finish(self._ptr)
  }

  /**
   * Same as `finish()` for file API compartibility.
   *
   * @note Once finish is called, the encoder can no longer be
   *    reused.
   * @returns bytes
   */
  close() {
    return self.finish()
  }

  /**
   * Finishes the current stream and installs a fresh one for
   * the next frame.
   *
   * Returns the previous byte stream containing the completed
   * frame.
   *
   * @returns bytes
   */
  reset() {
    return _compress.bzip2_encoder_reset(self._ptr)
  }

  /**
   * Writes data into this encoder's byte stream, returning how
   * many bytes were written.
   *
   * @param {bytes|string} data
   * @returns number
   */
  write(data) {
    return _compress.bzip2_encoder_write(self._ptr, data)
  }

  /**
   * Flushes this output stream and returns the compressed data
   * produced so far, without terminating the bzip2 stream.
   *
   * @returns bytes
   */
  flush() {
    return _compress.bzip2_encoder_flush(self._ptr)
  }

  /**
   * Returns the number of compressed bytes currently waiting in
   * the encoder's output buffer.
   *
   * @returns number
   */
  available() {
    return _compress.bzip2_encoder_available(self._ptr)
  }

  /**
   * Returns whether `finish()` has completed the stream.
   *
   * @returns bool
   */
  finished() {
    return _compress.bzip2_encoder_finished(self._ptr)
  }

  /**
   * Number of uncompressed bytes consumed by the encoder.
   *
   * @returns number
   */
  total_in() {
    return _compress.bzip2_encoder_total_in(self._ptr)
  }

  /**
   * Number of compressed bytes generated by the encoder.
   *
   * @returns number
   */
  total_out() {
    return _compress.bzip2_encoder_total_out(self._ptr)
  }
}


/**
 * Streaming bzip2 decompressor implementation.
 *
 * Wraps a byte stream of compressed data and yields decompressed
 * bytes.
 *
 * Example:
 *
 * ```zuri-repl
 * %> import compress.bzip2
 * %> var data = bzip2.compress('hello world')
 * %> var decoder = bzip2.Bzip2Decoder(data)
 * %> decoder.read_as_string()
 * hello world
 * ```
 *
 * @note only decodes a single bzip2 stream — see `decompress()`'s
 *    note about "multistreams".
 */
class Bzip2Decoder {

  /**
   * Creates a Bzip2 decoder
   *
   * @param bytes source
   */
  @new(source) {
    self._ptr = _compress.bzip2_new_decoder(source)
  }

  /**
   * Installs a new data source, discarding whatever remained of
   * the previous one.
   *
   * @param bytes new_source
   */
  reset(new_source) {
    _compress.bzip2_decoder_reset(self._ptr, new_source)
  }

  /**
   * Closes the decoder by resetting it into an empty stream.
   */
  close() {
    self.reset(bytes(0))
  }

  /**
   * Reads some bytes up to the amount of bytes specified by
   * length from the current source. Returns an empty byte stream
   * when there is no more data to read.
   *
   * @param number length
   * @returns bytes
   */
  read(length) {
    return _compress.bzip2_decoder_read(self._ptr, length)
  }

  /**
   * Reads the exact number of bytes from the buffer. This method
   * will raise an error if it encounters an unexpected EOF (`end
   * of file`) or there are insufficient data to read to complete
   * the required number of bytes.
   *
   * @param number length
   * @returns bytes
   */
  read_exact(length) {
    return _compress.bzip2_decoder_read_exact(self._ptr, length)
  }

  /**
   * Reads all remaining bytes until EOF is encountered in the
   * source.
   *
   * @returns bytes
   */
  read_all() {
    return _compress.bzip2_decoder_read_all(self._ptr)
  }

  /**
   * Reads all remaining bytes until EOF is encountered in the
   * source and returns the data read as a string instead of a
   * byte stream.
   *
   * @returns string
   */
  read_as_string() {
    return _compress.bzip2_decoder_read_as_string(self._ptr)
  }

  /**
   * Returns the number of compressed bytes still unread in the
   * decoder's source.
   *
   * @returns number
   */
  available() {
    return _compress.bzip2_decoder_available(self._ptr)
  }

  /**
   * Returns whether the decoder has reached the end of the
   * stream.
   *
   * @returns bool
   */
  finished() {
    return _compress.bzip2_decoder_finished(self._ptr)
  }

  /**
   * Number of compressed bytes consumed by the decoder.
   *
   * @returns number
   */
  total_in() {
    return _compress.bzip2_decoder_total_in(self._ptr)
  }

  /**
   * Number of uncompressed bytes generated by the decoder.
   *
   * @returns number
   */
  total_out() {
    return _compress.bzip2_decoder_total_out(self._ptr)
  }
}


/**
 * The BzFile class implements a Bzip2 based I/O system that
 * allows you to treat Bzip2 streams (bytes) as if they were a
 * file.
 *
 * The class implements the essentials of a file except those
 * that ties it to the operating system filesystem such as
 * symbolic links, chmod and set time.
 *
 * See the tutorial on [working with
 * files](/tutorial/working-with-files) for more information.
 */
class BzFile {
  var _is_encoder
  var _inner

  /**
   * Returns a new BzFile object bounded to a physical file at
   * the given path and opened in the given mode. See [[file]]
   * for a description of the supported file modes.
   *
   * @param string path
   * @param ?string mode
   * @returns BzFile
   */
  @new(path: string, mode: ?string, _inner) {
    if mode == nil {
      mode = 'r'
    }

    self._is_encoder = !mode.contains('r')
    self._file = file(path, mode)
    self._file.open()

    if _inner {
      self._inner = _inner
    } else if self._is_encoder {
      self._inner = Bzip2Encoder()
    } else {
      # gets(), not read(): read() auto-closes self._file once it hits
      # EOF, and later operations here (seek(), close(), stats(), ...)
      # still need it open.
      self._inner = Bzip2Decoder(self._file.gets())
    }
  }

  /**
   * Returns `true` if the underlying file bounded to BzFile
   * actually exists or `false` otherwise.
   *
   * @returns bool
   */
  exists() {
    return self._file.exists()
  }

  /**
   * Closes the stream to an opened BzFile. You'll rarely ever
   * need to call this method yourself in most use cases.
   */
  close() {
    if self._is_encoder {
      # finish(), not close(): close() on the inner encoder is just
      # finish() again for file-API-compatibility, and the stream is
      # already finished at this point — calling it a second time
      # raises (Invalid stream state).
      self._file.write(self._inner.finish())
    } else {
      self._inner.close()
    }

    self._file.close()
  }

  /**
   * Flushes the remaning data into the BzFile underlying file
   * and returns the byte stream returned.
   *
   * @returns bytes
   */
  flush() {
    if self._is_encoder {
      self._file.write(self._inner.flush())
    }

    return self._file.flush()
  }

  /**
   * Opens the stream to a BzFile for the operation originally
   * specified on the BzFile object during creation.
   *
   * You may need to call this method after a call to `read()` if
   * the length isn't specified or `write()` if you wish to read
   * or write again as the BzFile will already be closed.
   *
   * @returns bool
   */
  open() {
    return self._file.open()
  }

  /**
   * Reads the content of an opened BzFile up to the specified
   * length and returns it as string or bytes if the BzFile was
   * opened in the binary mode. If the length is not specified,
   * the BzFile will be read to the end.
   *
   * This method requires that the BzFile be opened in the read
   * mode (default mode) or a mode that supports reading. If you
   * aren't reading the full length of the BzFile, you'll need to
   * call the close() method to free the BzFile for further
   * reading, otherwise, the close() method will be automatically
   * called for you.
   *
   * @param number length: Default = -1
   * @returns bytes
   * @throws Error
   */
  read(length: ?number) {
    var result = self.gets(length)
    self._inner.close()
    return result
  }

  /**
   * Same as `read()`, but doesn't close the BzFile automatically.
   *
   * @param ?number length: Default = -1, meaning read to the end.
   * @returns bytes
   * @throws Error
   */
  gets(length: ?number) {
    # Checking is_open(), not finished(): finished() just means the
    # decoder has naturally run out of decompressed bytes to give
    # (a normal, expected EOF), not that this BzFile was closed.
    if self._is_encoder or !self._file.is_open() {
      raise Error('Invalid stream state')
    }

    if length != nil {
      return self._inner.read(length)
    } else {
      return self._inner.read_all()
    }
  }

  /**
   * Writes a string or bytes to an opened BzFile at the current
   * insertion point. When the BzFile is opened with the a mode
   * enabled, write will always start from the end of the BzFile.
   *
   * If the seek() method has been previously called, write will
   * begin from the seeked position, otherwise it will start at
   * the beginning of the BzFile.
   *
   * @param bytes|string
   * @returns number
   */
  write(data: bytes|string) {
    if !self._is_encoder or self._inner.finished() {
      raise Error('Invalid stream state')
    }

    return self._inner.write(data)
  }

  /**
   * Same as `write()`, but doesn't open or close the BzFile
   * automatically.
   *
   * @param bytes|string
   * @returns number
   */
  puts(data: bytes|string) {
    if !self._is_encoder or self._inner.finished() {
      raise Error('Invalid stream state')
    }

    return self._inner.write(data)
  }

  /**
   * Returns the integer file descriptor number that is used by
   * the underlying implementation to request I/O operations from
   * the operating system. This can be very useful for low-level
   * interfaces that uses or act as BzFile descriptors.
   *
   * @returns number
   */
  number() {
    return self._file.number()
  }

  /**
   * Returns `true` if the underlying file of BzFile is a TTY
   * device or `false` otherwise.
   *
   * @returns bool
   */
  is_tty() {
    return self._file.is_tty()
  }

  /**
   * Returns `true` if the BzFile is open for reading or writing
   * and `false` otherwise.
   *
   * @returns bool
   */
  is_open() {
    return self._file.is_open()
      and !self._inner.finished()
  }

  /**
   * Returns `true` if the BzFile is closed for reading or
   * writing and `false` otherwise.
   */
  is_closed() {
    return self._file.is_closed()
      or self._inner.finished()
  }

  /**
   * See [[file.symlink]]
   *
   * @returns bool
   */
  symlink(path: string) {
    return self._file.symlink(path)
  }

  /**
   * Returns the statistics or details of the BzFile.
   *
   * See the working with files documentation for more
   * information about the `stats()` method.
   *
   * @returns dict
   */
  stats() {
    return self._file.stats()
  }

  /**
   * Deletes the underlying file pointed to by BzFile
   *
   * Any further attempt to perform most operations on the BzFile
   * after calling `delete()` will raise an error.
   *
   * @returns bool
   */
  delete() {
    self._inner.finish()
    return self._file.delete()
  }

  /**
   * Renames the underlying file pointed to by BzFile to the new
   * name and returns `true` if it succeeds or `false` otherwise.
   *
   * @returns bool
   */
  rename(new_name) {
    return self._file.rename(new_name)
  }

  /**
   * Returns a new BzFile reading (or writing) the same underlying
   * path independently of this one, with its own decoder/encoder
   * state and its own position.
   *
   * @returns [[compress.bzip2.BzFile]]
   */
  copy() {
    return BzFile(self._file.path(), self._file.mode())
  }

  /**
   * Returns the physical path of the file pointed to by BzFile.
   *
   * @returns string
   */
  path() {
    return self._file.path()
  }

  /**
   * Returns the absolute path of the physical file pointed to by
   * BzFile.
   *
   * @returns string
   */
  abs_path() {
    return self._file.abs_path()
  }

  /**
   * Truncates the entire BzFile if length is not given or
   * truncates the BzFile such that only length number of bytes
   * is left in it.
   *
   * @returns bool
   */
  truncate(length: ?int) {
    return self._file.truncate(length)
  }

  /**
   * Updates the permission for the file bounded by BzFile.
   *
   * @returns bool
   */
  chmod(number: int) {
    return self._file.chmod(number)
  }

  /**
   * Sets the last access time and last modified time of the
   * BzFile.
   *
   * @return bool
   */
  set_times(atime: int, mtime: int) {
    return self._file.set_times(atime, mtime)
  }

  /**
   * Sets the position of a BzFile reader in the *decompressed*
   * byte stream (not the raw, still-compressed bytes on disk,
   * which have no useful correspondence to a decompressed offset).
   * The `seek_type` argument must be one of [[io.SEEK_SET]],
   * [[io.SEEK_CUR]] or [[io.SEEK_END]].
   *
   * Seeking forward simply discards decompressed bytes until the
   * target position, since a streaming decoder has no way to skip
   * ahead without producing them. Seeking backward (or SEEK_END,
   * which has to fully decode the stream once to learn its length)
   * re-opens the underlying file and restarts decompression from
   * the beginning, discarding up to the target position — an
   * inherently expensive operation for a compressed stream, same
   * as with any other streaming (de)compressor.
   *
   * Not supported on a BzFile opened for writing.
   *
   * @returns bool
   */
  seek(position: int, seek_type: int) {
    if self._is_encoder {
      raise Error('cannot seek a BzFile opened for writing')
    }
    if !is_number(position) {
      raise TypeError('position must be a number')
    }
    if seek_type == nil {
      seek_type = 0
    }

    var target
    using seek_type {
      when 0 target = position
      when 1 target = self._inner.total_out() + position
      when 2 {
        self._inner.read_all()
        target = self._inner.total_out() + position
      }
      default raise ValueError('invalid seek type')
    }

    if target < 0 {
      raise ValueError('cannot seek before the start of the stream')
    }

    if target < self._inner.total_out() {
      self._file.close()
      self._file.open()
      self._inner.reset(self._file.gets())
    }

    var remaining = target - self._inner.total_out()
    if remaining > 0 {
      self._inner.read(remaining)
    }

    return true
  }

  /**
   * Returns the current position of the reader in the
   * *decompressed* byte stream (bytes already consumed via
   * `read()`/`gets()`/`seek()`), or of the writer in the
   * *uncompressed* input already fed to `write()`/`puts()` for a
   * BzFile opened for writing.
   *
   * @return number
   */
  tell() {
    if self._is_encoder {
      return self._inner.total_in()
    }
    return self._inner.total_out()
  }

  /**
   * Returns the mode in which the current BzFile was opened.
   *
   * @return string
   */
  mode() {
    return self._file.mode()
  }

  /**
   * Returns the name of the file pointed to by BzFile.
   *
   * @returns string
   */
  name() {
    return self._file.name()
  }
}
