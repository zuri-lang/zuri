/**
 * @module brotli
 *
 * The Brotli submodule for the compress module.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _compress

/**
 * Compress data using Brotli.
 *
 * @param {bytes|string} data
 * @param ?number quality: Compression quality (0..=11, higher is
 *    slower but smaller) — Default 11.
 * @param ?number window: Base-2 logarithm of the sliding window
 *    size (10..=24) — Default 22.
 * @returns bytes
 */
def compress(data, quality, window) {
  return _compress.brotli_compress(data, quality, window)
}

/**
 * Decompress Brotli-compressed data.
 *
 * @param {bytes|string} data
 * @returns bytes
 */
def decompress(data) {
  return _compress.brotli_decompress(data)
}


/**
 * A streaming Brotli encoder.
 *
 * @note Unlike the other streaming encoders in this module (Gzip,
 *    Bzip2, Zstd, Lz4), this one does not compress incrementally as
 *    `write()` is called — it buffers everything you give it and
 *    does the real work once, in `finish()`. `available()` therefore
 *    always reads `0` before `finish()` is called: there's nothing
 *    waiting yet. This follows from the underlying encoder only
 *    exposing a "compress this all at once into a sink" interface,
 *    not a lower-level incremental one.
 *
 * Example:
 *
 * ```zuri-repl
 * %> import compress.brotli
 * %> var encoder = brotli.BrotliEncoder()
 * %> encoder.write('hello world')
 * 11
 * %> encoder.finish()
 * (1b 0a 00 f8 25 04 92 68 65 6c ...)
 * ```
 */
class BrotliEncoder {
  var _ptr

  /**
   * Creates a new streaming Brotli encoder.
   *
   * @param ?number quality: Compression quality (0..=11) —
   *    Default 11.
   * @param ?number window: Base-2 logarithm of the sliding window
   *    size (10..=24) — Default 22.
   */
  @new(quality, window) {
    self._ptr = _compress.brotli_new_encoder(quality, window)
  }

  /**
   * Compresses everything written so far and returns the
   * resulting byte stream.
   *
   * @note Once finish is called, the encoder can no longer be
   *    reused.
   * @returns bytes
   */
  finish() {
    return _compress.brotli_encoder_finish(self._ptr)
  }

  /**
   * Same as `finish()` for file API compartibility.
   *
   * @note Once finish is called, the encoder can no longer be
   *    reused.
   * @returns bytes
   */
  close() {
    return self.finish()
  }

  /**
   * Finishes the current stream and installs a fresh one for
   * the next frame.
   *
   * Returns the previous byte stream containing the completed
   * frame.
   *
   * @returns bytes
   */
  reset() {
    return _compress.brotli_encoder_reset(self._ptr)
  }

  /**
   * Buffers data to be compressed once `finish()` or `reset()` is
   * called, returning how many bytes were accepted.
   *
   * @param {bytes|string} data
   * @returns number
   */
  write(data) {
    return _compress.brotli_encoder_write(self._ptr, data)
  }

  /**
   * Returns the number of compressed bytes currently waiting in
   * the encoder's output buffer. Always `0` before `finish()` —
   * see the class-level note on why this encoder isn't
   * incremental.
   *
   * @returns number
   */
  available() {
    return _compress.brotli_encoder_available(self._ptr)
  }

  /**
   * Returns whether `finish()` has completed the stream.
   *
   * @returns bool
   */
  finished() {
    return _compress.brotli_encoder_finished(self._ptr)
  }

  /**
   * Number of uncompressed bytes consumed by the encoder so far
   * (only updated once `finish()`/`reset()` actually compresses
   * them — see the class-level note).
   *
   * @returns number
   */
  total_in() {
    return _compress.brotli_encoder_total_in(self._ptr)
  }

  /**
   * Number of compressed bytes generated by the encoder so far.
   *
   * @returns number
   */
  total_out() {
    return _compress.brotli_encoder_total_out(self._ptr)
  }
}


/**
 * Streaming Brotli decompressor implementation.
 *
 * Wraps a byte stream of compressed data and yields decompressed
 * bytes.
 *
 * Example:
 *
 * ```zuri-repl
 * %> import compress.brotli
 * %> var data = brotli.compress('hello world')
 * %> var decoder = brotli.BrotliDecoder(data)
 * %> decoder.read_as_string()
 * hello world
 * ```
 */
class BrotliDecoder {

  /**
   * Creates a Brotli decoder
   *
   * @param bytes source
   */
  @new(source) {
    self._ptr = _compress.brotli_new_decoder(source)
  }

  /**
   * Installs a new data source, discarding whatever remained of
   * the previous one.
   *
   * @param bytes new_source
   */
  reset(new_source) {
    _compress.brotli_decoder_reset(self._ptr, new_source)
  }

  /**
   * Closes the decoder by resetting it into an empty stream.
   */
  close() {
    self.reset(bytes(0))
  }

  /**
   * Reads some bytes up to the amount of bytes specified by
   * length from the current source. Returns an empty byte stream
   * when there is no more data to read.
   *
   * @param number length
   * @returns bytes
   */
  read(length) {
    return _compress.brotli_decoder_read(self._ptr, length)
  }

  /**
   * Reads the exact number of bytes from the buffer. This method
   * will raise an error if it encounters an unexpected EOF (`end
   * of file`) or there are insufficient data to read to complete
   * the required number of bytes.
   *
   * @param number length
   * @returns bytes
   */
  read_exact(length) {
    return _compress.brotli_decoder_read_exact(self._ptr, length)
  }

  /**
   * Reads all remaining bytes until EOF is encountered in the
   * source.
   *
   * @returns bytes
   */
  read_all() {
    return _compress.brotli_decoder_read_all(self._ptr)
  }

  /**
   * Reads all remaining bytes until EOF is encountered in the
   * source and returns the data read as a string instead of a
   * byte stream.
   *
   * @returns string
   */
  read_as_string() {
    return _compress.brotli_decoder_read_as_string(self._ptr)
  }

  /**
   * Returns the number of compressed bytes currently waiting in
   * the decoder's output buffer. Always `0` — this decoder
   * decodes on demand rather than buffering ahead.
   *
   * @returns number
   */
  available() {
    return _compress.brotli_decoder_available(self._ptr)
  }

  /**
   * Returns whether the decoder has reached the end of the
   * stream.
   *
   * @returns bool
   */
  finished() {
    return _compress.brotli_decoder_finished(self._ptr)
  }

  /**
   * Number of compressed bytes in the decoder's source.
   *
   * @returns number
   */
  total_in() {
    return _compress.brotli_decoder_total_in(self._ptr)
  }

  /**
   * Number of uncompressed bytes generated by the decoder so far.
   *
   * @returns number
   */
  total_out() {
    return _compress.brotli_decoder_total_out(self._ptr)
  }
}
