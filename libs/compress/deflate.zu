/**
 * @module deflate
 *
 * This is the Deflate submodule for the compress module.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import _compress

/**
 * Compress data using the default options for Deflate.
 *
 * @param {bytes|string} data
 * @returns bytes
 */
def compress(data) {
  return _compress.deflate_compress(data)
}

/**
 * Decompress a deflated data using default options.
 *
 * @param {bytes|string} data
 * @returns bytes
 */
def decompress(data) {
 return _compress.deflate_decompress(data)
}


import .gzip { GzipDecoder, GzipEncoder }


/**
 * A streaming Deflate encoder.
 *
 * Example:
 *
 * ```zuri-repl
 * %> import compress.deflate
 * %> var encoder = deflate.DeflateEncoder()
 * %> encoder.write('hello world')
 * 11
 * %> encoder.finish()
 * (cb 48 cd c9 c9 57 28 cf 2f ca 49 01 00)
 * ```
 */
class DeflateEncoder < GzipEncoder {

  /**
   * Creates a new streaming Deflate encoder at the given level
   * (0..=9).
   *
   * @param ?number level - Default 1
   */
  @new(level) {
    self._ptr = _compress.gzip_new_encoder(false, level)
  }
}


/**
 * Streaming deflate decompressor implemention. This decoder
 * reads standard deflate blocks and frames produced at any
 * deflate compression level.
 *
 * Wraps a byte stream of compressed data and yields decompressed
 * bytes.
 *
 * Example:
 *
 * ```zuri-repl
 * %> import compress.deflate
 * %> var data = deflate.compress('hello world')
 * %> data
 * (cb 48 cd c9 c9 57 28 cf 2f ca 49 01 00)
 * %> 
 * %> var decoder = deflate.DeflateDecoder(data)
 * %> decoder.read_as_string()
 * hello world
 * ```
 *
 * This decoder is level-independent and supports standard
 * deflate frames produced by all deflate compression levels.
 */
class DeflateDecoder < GzipDecoder {

  /**
   * Creates a Gzip decoder
   *
   * @param bytes source
   */
  @new(source) {
    self._ptr = _compress.gzip_new_decoder(false, source)
  }
}
