/**
 * @module gzip
 *
 * The is the GZip submodule for the compress module.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import _compress

/**
 * Compress data using the default options for GZip.
 *
 * @param {bytes|string} data
 * @returns bytes
 */
def compress(data) {
  return _compress.gzip_compress(data)
}

/**
 * Decompress a GZipped data using default options.
 *
 * @param {bytes|string} data
 * @returns bytes
 */
def decompress(data) {
  return _compress.gzip_decompress(data)
}


/**
 * A streaming GZip encoder.
 *
 * Example:
 *
 * ```zuri-repl
 * %> import compress.gzip
 * %> var encoder = gzip.GzipEncoder()
 * %> encoder.write('hello world')
 * 11
 * %> encoder.finish()
 * (02 2c 23 35 27 27 5f a1 3c bf 28 27 05 00)
 * ```
 */
class GzipEncoder {
  var _ptr

  /**
   * Creates a new streaming GZip encoder at the given level
   * (0..=9).
   *
   * @param ?number level - Default 1
   */
  @new(level) {
    self._ptr = _compress.gzip_new_encoder(true, level, 31)
  }

  /**
   * Flushes remaining data, writes the content checksum, and
   * returns the inner byte stream.
   *
   * @note Once finish is called, the encoder can no longer be
   *    reused.
   * @returns bytes
   */
  finish() {
    return _compress.gzip_encoder_finish(self._ptr)
  }

  /**
   * Same as `finish()` for file API compartibility.
   *
   * @note Once finish is called, the encoder can no longer be
   *    reused.
   * @returns bytes
   */
  close() {
    return self.finish()
  }

  /**
   * Finishes the current frame and installs byte stream for the
   * next one.
   *
   * Returns the previous byte stream containing the completed
   * frame. All internal buffers (hash tables, workspace, block
   * scratch) stay allocated and are reused for the next frame.
   *
   * @returns bytes
   */
  reset() {
    return _compress.gzip_encoder_reset(self._ptr)
  }

  /**
   * Writes data into this encoder's byte stream, returning how
   * many bytes were written.
   *
   * @param {bytes|string} data
   * @returns number
   */
  write(data) {
    return _compress.gzip_encoder_write(self._ptr, data)
  }

  /**
   * Flushes this output stream and returns the remaining
   * compressed data in the stream, ensuring that all
   * intermediately buffered contents reach their destination.
   *
   * @returns bytes
   */
  flush() {
    return _compress.gzip_encoder_flush(self._ptr)
  }

  /**
   * Returns the number of compressed bytes currently waiting in
   * the encoder's output buffer.
   *
   * @returns number
   */
  available() {
    return _compress.gzip_encoder_available(self._ptr)
  }

  /**
   * Returns whether `finish()` has completed the stream.
   *
   * @returns bool
   */
  finished() {
    return _compress.gzip_encoder_finished(self._ptr)
  }

  /**
   * Number of uncompressed bytes consumed by the encoder.
   *
   * @returns number
   */
  total_in() {
    return _compress.gzip_encoder_total_in(self._ptr)
  }

  /**
   * Number of compressed bytes generated by the encoder.
   *
   * @returns number
   */
  total_out() {
    return _compress.gzip_encoder_total_out(self._ptr)
  }
}


/**
 * Streaming gzip decompressor implemention. This decoder reads
 * standard gzip blocks and frames produced at any gzip
 * compression level.
 *
 * Wraps a byte stream of compressed data and yields decompressed
 * bytes.
 *
 * Example:
 *
 * ```zuri-repl
 * %> import compress.gzip
 * %> var data = gzip.compress('hello world')
 * %> data
 * (02 2c 23 35 27 27 5f a1 3c bf 28 27 05 00)
 * %> 
 * %> var decoder = gzip.GzipDecoder(data)
 * %> decoder.read_as_string()
 * hello world
 * ```
 *
 * This decoder is level-independent and supports standard gzip
 * frames produced by all gzip compression levels.
 */
class GzipDecoder {

  /**
   * Creates a Gzip decoder
   *
   * @param bytes source
   */
  @new(source) {
    self._ptr = _compress.gzip_new_decoder(true, source, 31)
  }

  /**
   * Installs a new data source for the next frame, keeping all
   * internal buffers allocated.
   *
   * @param bytes new_source
   */
  reset(new_source) {
    _compress.gzip_decoder_reset(self._ptr, new_source)
  }

  /**
   * Closes the decoder by resetting it into an empty stream.
   */
  close() {
    self.reset(bytes(0))
  }

  /**
   * Reads some bytes up to the amount of bytes specified by
   * length from the current source. Returns an empty byte stream
   * when there is no more data to read.
   *
   * This function does not block or wait waiting for data, but
   * reads as much data as is available to read when it runs.
   *
   * @param number length
   * @returns bytes
   */
  read(length) {
    return _compress.gzip_decoder_read(self._ptr, length)
  }

  /**
   * Reads the exact number of bytes from the buffer. This method
   * will raise an error if it encounters an unexpected EOF (`end
   * of file`) or there are insufficient data to read to complete
   * the required number of bytes.
   *
   * @param number length
   * @returns bytes
   */
  read_exact(length) {
    return _compress.gzip_decoder_read_exact(self._ptr, length)
  }

  /**
   * Reads all remaining bytes until EOF is encountered in the
   * source.
   *
   * @returns bytes
   */
  read_all() {
    return _compress.gzip_decoder_read_all(self._ptr)
  }

  /**
   * Reads all remaining bytes until EOF is encountered in the
   * source and returns the data read as a string instead of a
   * byte stream.
   *
   * @returns string
   */
  read_as_string() {
    return _compress.gzip_decoder_read_as_string(self._ptr)
  }

  /**
   * Returns the number of compressed bytes currently waiting in
   * the decoder's output buffer.
   *
   * @returns number
   */
  available() {
    return _compress.gzip_decoder_available(self._ptr)
  }

  /**
   * Returns whether `finish()` has completed the stream.
   *
   * @returns bool
   */
  finished() {
    return _compress.gzip_decoder_finished(self._ptr)
  }

  /**
   * Number of compressed bytes consumed by the decoder.
   *
   * @returns number
   */
  total_in() {
    return _compress.gzip_decoder_total_in(self._ptr)
  }

  /**
   * Number of uncompressed bytes generated by the decoder.
   *
   * @returns number
   */
  total_out() {
    return _compress.gzip_decoder_total_out(self._ptr)
  }
}


/**
 * The GzFile class implements a GZip based I/O system that
 * allows you use treat Gzip streams (bytes) as if they were a
 * file.
 *
 * The class implements the essentials of a file except those
 * that ties it to the operating system filesystem such as
 * symbolic links, chmod and set time.
 *
 * See the tutorial on [working with
 * files](/tutorial/working-with-files) for more information.
 */
class GzFile {
  var _is_encoder
  var _inner

  /**
   * Returns a new GzFile object bounded to a physical file at
   * the given path and opened in the given mode. See [[file]]
   * for a description of the supported file modes.
   *
   * @param string path
   * @param ?string mode
   * @returns GzFile
   */
  @new(path: string, mode: ?string, _inner) {
    if mode == nil {
      mode = 'r'
    }

    self._is_encoder = !mode.contains('r')
    self._file = file(path, mode)

    if _inner {
      self._inner = _inner
    } else if self._is_encoder {
      self._inner = GzipEncoder()
    } else {
      self._inner = GzipDecoder(self._file.read())
    }
  }

  /**
   * Returns `true` if the underlying file bounded to GzFile
   * actually exists or `false` otherwise.
   *
   * @returns bool
   */
  exists() {
    return self._file.exists()
  }

  /**
   * Closes the stream to an opened GzFile. You'll rarely ever
   * need to call this method yourself in most use cases.
   */
  close() {
    if self._is_encoder {
      self._file.write(self._inner.finish())
    }

    self._inner.close()
    self._file.close()
  }

  /**
   * Flushes the remaning data into the GzFile underlying file
   * and returns the byte stream returned.
   *
   * @returns bytes
   */
  flush() {
    if self._is_encoder {
      self._file.write(self._inner.flush())
    }

    return self._file.flush()
  }

  /**
   * Opens the stream to a GzFile for the operation originally
   * specified on the GzFile object during creation.
   *
   * You may need to call this method after a call to `read()` if
   * the length isn't specified or `write()` if you wish to read
   * or write again as the GzFile will already be closed.
   *
   * @returns bool
   */
  open() {
    return self._file.open()
  }

  /**
   * Reads the content of an opened GzFile up to the specified
   * length and returns it as string or bytes if the GzFile was
   * opened in the binary mode. If the length is not specified,
   * the GzFile will be read to the end.
   *
   * This method requires that the GzFile be opened in the read
   * mode (default mode) or a mode that supports reading. If you
   * aren't reading the full length of the GzFile, you'll need to
   * call the close() method to free the GzFile for further
   * reading, otherwise, the close() method will be automatically
   * called for you.
   *
   * @param number length: Default = -1
   * @returns bytes
   * @throws Error
   */
  read(length: ?number) {
    if self._is_encoder or self._inner.finished() {
      raise Error('Invalid stream state')
    }

    if length != nil {
      return self._inner.read(length)
    } else {
      return self._inner.read_all()
    }
  }

  /**
   * Same as `read()`, but doesn't open or close the GzFile
   * automatically.
   *
   * @param number length: Default = -1
   * @returns bytes
   * @throws Error
   */
  gets(length: number) {
    if self._is_encoder or self._inner.finished() {
      raise Error('Invalid stream state')
    }

    return self._inner.read(length)
  }

  /**
   * Writes a string or bytes to an opened GzFile at the current
   * insertion point. When the GzFile is opened with the a mode
   * enabled, write will always start from the end of the GzFile.
   *
   * If the seek() method has been previously called, write will
   * begin from the seeked position, otherwise it will start at
   * the beginning of the GzFile.
   *
   * @param bytes|string
   * @returns number
   */
  write(data: bytes|string) {
    if !self._is_encoder or self._inner.finished() {
      raise Error('Invalid stream state')
    }

    return self._inner.write(data)
  }

  /**
   * Same as `write()`, but doesn't open or close the GzFile
   * automatically.
   *
   * @param bytes|string
   * @returns number
   */
  puts(data: bytes|string) {
    if !self._is_encoder or self._inner.finished() {
      raise Error('Invalid stream state')
    }

    return self._inner.write(data)
  }

  /**
   * Returns the integer file descriptor number that is used by
   * the underlying implementation to request I/O operations from
   * the operating system. This can be very useful for low-level
   * interfaces that uses or act as GzFile descriptors.
   *
   * @returns number
   */
  number() {
    return self._file.number()
  }

  /**
   * Returns `true` if the underlying file of GzFile is a TTY
   * device or `false` otherwise.
   *
   * @returns bool
   */
  is_tty() {
    return self._file.is_tty()
  }

  /**
   * Returns `true` if the GzFile is open for reading or writing
   * and `false` otherwise.
   *
   * @returns bool
   */
  is_open() {
    return self._file.is_open() 
      and !self._inner.finished()
  }

  /**
   * Returns `true` if the GzFile is closed for reading or
   * writing and `false` otherwise.
   */
  is_closed() {
    return self._file.is_closed() 
      or self._inner.finished()
  }

  /**
   * See [[file.symlink]]
   *
   * @returns bool
   */
  symlink(path: string) {
    return self._file.symlink(path)
  }

  /**
   * Returns the statistics or details of the GzFile.
   *
   * See the working with files documentation for more
   * information about the `stats()` method.
   *
   * @returns dict
   */
  stats() {
    return self._file.stats()
  }

  /**
   * Deletes the underlying file pointed to by GzFile
   *
   * Any further attempt to perform most operations on the GzFile
   * after calling `delete()` will raise an error.
   *
   * @returns bool
   */
  delete() {
    self._inner.finish()
    return self._file.delete()
  }

  /**
   * Renames the underlying file pointed to by GzFile to the new
   * name and returns `true` if it succeeds or `false` otherwise.
   *
   * @returns bool
   */
  rename(new_name) {
    return self._file.rename(new_name)
  }

  /**
   * Returns a new GzFile with the source cloned and opened with
   * the same mode as the current GzFile.
   *
   * @returns [[io.GzFile]]
   */
  copy() {
    return GzFile(self._file.path(), self._file.mode(), self._inner)
  }

  /**
   * Returns the physical path of the file pointed to by GzFile.
   *
   * @returns string
   */
  path() {
    return self._file.path()
  }

  /**
   * Returns the absolute path of the physical file pointed to by
   * GzFile.
   *
   * @returns string
   */
  abs_path() {
    return self._file.abs_path()
  }

  /**
   * Truncates the entire GzFile if length is not given or
   * truncates the GzFile such that only length number of bytes
   * is left in it.
   *
   * @returns bool
   */
  truncate(length: ?int) {
    return self._file.truncate(length)
  }
  
  /**
   * Updates the permission for the file bounded by GzFile.
   *
   * @returns bool
   */
  chmod(number: int) {
    return self._file.chmod(number)
  }

  /**
   * Sets the last access time and last modified time of the
   * GzFile.
   *
   * @return bool
   */
  set_times(atime: int, mtime: int) {
    return self._file.set_times(atime, mtime)
  }

  /**
   * Sets the position of a GzFile reader or writer in a GzFile.
   *
   * The position must be within the range of the GzFile size.
   * The `seek_type` argument must be on of [[io.SEEK_SET]],
   * [[io.SEEK_CUR]] or [[io.SEEK_END]].
   *
   * @returns bool
   */
  seek(position: int, seek_type: int) {
    return self._file.seek(position, seek_type)
  }

  /**
   * Returns the current position of the reader/writer in the
   * GzFile.
   *
   * @return number
   */
  tell() {
    return self._file.tell()
  }

  /**
   * Returns the mode in which the current GzFile was opened.
   *
   * @return string
   */
  mode() {
    return self._file.mode()
  }

  /**
   * Returns the name of the file pointed to by GzFile.
   *
   * @returns string
   */
  name() {
    return self._file.name()
  }
}
