/**
 * @module gzip
 * 
 * The is the GZip submodule for the compress module.
 * 
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import _compress

/**
 * Compress data using the default options for GZip.
 * 
 * @param {bytes|string} data
 * @returns bytes
 */
def compress(data) {
  return _compress.gzip_compress(data)
}

/**
 * Decompress a GZipped data using default options.
 * 
 * @param {bytes|string} data
 * @returns bytes
 */
def decompress(data) {
  return _compress.gzip_decompress(data)
}


/**
 * A streaming GZip encoder. 
 * 
 * Example:
 * 
 * ```zuri-repl
 * %> import compress.gzip
 * %> var encoder = gzip.GzipEncoder()
 * %> encoder.write('hello world')
 * 11
 * %> encoder.finish()
 * (02 2c 23 35 27 27 5f a1 3c bf 28 27 05 00)
 * ```
 */
class GzipEncoder {
  var _ptr

  /**
   * Creates a new streaming GZip encoder at the given level (0..=9).
   * 
   * @param ?number level - Default 1
   */
  @new(level) {
    self._ptr = _compress.gzip_new_encoder(false, level)
  }

  /**
   * Flushes remaining data, writes the content checksum, and returns 
   * the inner byte stream.
   * 
   * @note Once finish is called, the encoder can no longer be reused.
   * @returns bytes
   */
  finish() {
    return _compress.gzip_encoder_finish(self._ptr)
  }

  /**
   * Same as `finish()` for file API compartibility.
   * 
   * @note Once finish is called, the encoder can no longer be reused.
   * @returns bytes
   */
  close() {
    return self.finish()
  }

  /**
   * Finishes the current frame and installs byte stream for the next one.
   * 
   * Returns the previous byte stream containing the completed frame. 
   * All internal buffers (hash tables, workspace, block scratch) stay 
   * allocated and are reused for the next frame.
   * 
   * @returns bytes
   */
  reset() {
    return _compress.gzip_encoder_reset(self._ptr)
  }

  /**
   * Writes data into this encoder's byte stream, returning how many 
   * bytes were written.
   * 
   * @param {bytes|string} data
   * @returns number
   */
  write(data) {
    return _compress.gzip_encoder_write(self._ptr, data)
  }

  /**
   * Flushes this output stream and returns the remaining compressed data in 
   * the stream, ensuring that all intermediately buffered contents reach 
   * their destination.
   * 
   * @returns bytes
   */
  flush() {
    return _compress.gzip_encoder_flush(self._ptr)
  }

  /**
   * Returns the number of compressed bytes currently waiting in the 
   * encoder's output buffer.
   * 
   * @returns number
   */
  available() {
    return _compress.gzip_encoder_available(self._ptr)
  }

  /**
   * Returns whether `finish()` has completed the stream.
   * 
   * @returns bool
   */
  finished() {
    return _compress.gzip_encoder_finished(self._ptr)
  }

  /**
   * Number of uncompressed bytes consumed by the encoder.
   * 
   * @returns number
   */
  total_in() {
    return _compress.gzip_encoder_total_in(self._ptr)
  }

  /**
   * Number of compressed bytes generated by the encoder.
   * 
   * @returns number
   */
  total_out() {
    return _compress.gzip_encoder_total_out(self._ptr)
  }
}


/**
 * Streaming gzip decompressor implemention. This decoder reads standard gzip 
 * blocks and frames produced at any gzip compression level.
 * 
 * Wraps a byte stream of compressed data and yields decompressed bytes. 
 * 
 * Example:
 * 
 * ```zuri-repl
 * %> import compress.gzip
 * %> var data = gzip.compress('hello world')
 * %> data
 * (02 2c 23 35 27 27 5f a1 3c bf 28 27 05 00)
 * %> 
 * %> var decoder = gzip.GzipDecoder(data)
 * %> decoder.read_as_string()
 * hello world
 * ```
 * 
 * This decoder is level-independent and supports standard gzip frames produced 
 * by all gzip compression levels.
 */
class GzipDecoder {

  /**
   * Creates a Gzip decoder
   * 
   * @param bytes source
   */
  @new(source) {
    self._ptr = _compress.gzip_new_decoder(false, source)
  }

  /**
   * Installs a new data source for the next frame, keeping all internal 
   * buffers allocated.
   * 
   * @param bytes new_source
   */
  reset(new_source) {
    _compress.gzip_decoder_reset(self._ptr, new_source)
  }

  /**
   * Closes the decoder by resetting it into an empty stream.
   */
  close() {
    self.reset(bytes(0))
  }

  /**
   * Reads some bytes up to the amount of bytes specified by length from 
   * the current source. Returns an empty byte stream when there is no 
   * more data to read.
   * 
   * This function does not block or wait waiting for data, but reads as 
   * much data as is available to read when it runs.
   * 
   * @param number length
   * @returns bytes
   */
  read(length) {
    return _compress.gzip_decoder_read(self._ptr, length)
  }

  /**
   * Reads the exact number of bytes from the buffer. This method will 
   * raise an error if it encounters an unexpected EOF (`end of file`) or 
   * there are insufficient data to read to complete the required number 
   * of bytes.
   * 
   * @param number length
   * @returns bytes
   */
  read_exact(length) {
    return _compress.gzip_decoder_read_exact(self._ptr, length)
  }

  /**
   * Reads all remaining bytes until EOF is encountered in the source.
   * 
   * @returns bytes
   */
  read_all() {
    return _compress.gzip_decoder_read_all(self._ptr)
  }

  /**
   * Reads all remaining bytes until EOF is encountered in the source and 
   * returns the data read as a string instead of a byte stream.
   * 
   * @returns string
   */
  read_as_string() {
    return _compress.gzip_decoder_read_as_string(self._ptr)
  }

  /**
   * Returns the number of compressed bytes currently waiting in the 
   * decoder's output buffer.
   * 
   * @returns number
   */
  available() {
    return _compress.gzip_encoder_available(self._ptr)
  }

  /**
   * Returns whether `finish()` has completed the stream.
   * 
   * @returns bool
   */
  finished() {
    return _compress.gzip_encoder_finished(self._ptr)
  }

  /**
   * Number of compressed bytes consumed by the decoder.
   * 
   * @returns number
   */
  total_in() {
    return _compress.gzip_encoder_total_in(self._ptr)
  }

  /**
   * Number of uncompressed bytes generated by the decoder.
   * 
   * @returns number
   */
  total_out() {
    return _compress.gzip_encoder_total_out(self._ptr)
  }
}
