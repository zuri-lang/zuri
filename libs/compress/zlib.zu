/**
 * @module zlib
 *
 * Zlib compression and decompression.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import _compress

# compression levels

/**
 * No compression level.
 * @type number
 */
var NO_COMPRESSION = 0

/**
 * Best speed compression.
 * @type number
 */
var BEST_SPEED = 1

/**
 * Best compression level.
 * @type number
 */
var BEST_COMPRESSION = 9

/**
 * Default compression level.
 * @type number
 */
var DEFAULT_COMPRESSION = -1

# compression strategy: see compress() for details

/**
 * Filtered compression strategy.
 * @type number
 */
var FILTERED = 1

/**
 * huffman only compression strategy
 */
var HUFFMAN_ONLY = 2

/**
 * Rle compression strategy.
 * @type number
 */
var RLE = 3

/**
 * Fixed compression strategy.
 * @type number
 */
var FIXED = 4

/**
 * Default compression strategy.
 * @type number
 */
var DEFAULT_STRATEGY = 0

# others

/**
 * Default memory level
 * @type number
 */
var DEFAULT_MEMORY_LEVEL = 8

/**
 * Maximum windows bit.
 * @type number
 */
var MAX_WBITS = 15

/**
 * Compresses `data`.
 *
 * - `level` must be `DEFAULT_COMPRESSION`, or a number from 0 to 9. 1
 *   gives the fastest compression, 9 gives the best compression, and 0
 *   gives no compression at all, copying the input a block at a time.
 *   `DEFAULT_COMPRESSION` asks for a balance between speed and
 *   compression, which is currently the same as level 6.
 *
 * - `wbits` is the base-two logarithm of the window size, which is the
 *   size of the history buffer. It should be from 8 to 15. Larger
 *   values give better compression, but use more memory. The default is
 *   15.
 *
 *   A `wbits` of 8, a window of 256 bytes, isn't supported, so a
 *   request for 8 gives 9, a window of 512 bytes.
 *
 *   `wbits` can also be from -8 to -15 for raw Deflate data. In that
 *   case, `-wbits` sets the window size, and the result has no zlib
 *   header or trailer, and no check value.
 *
 *   `wbits` can also be greater than 15, for gzip encoding. Add 16 to
 *   `wbits` to write a simple gzip header and trailer around the
 *   compressed data, instead of a zlib wrapper. The gzip header has no
 *   file name, extra data, comment or header CRC, the modification time
 *   is zero, and the operating system is set to the right value if the
 *   runtime can determine it.
 *
 *   For raw Deflate or gzip encoding, a request for a 256-byte window
 *   is rejected as invalid, because only the zlib header can tell the
 *   decompressor the window size.
 *
 * - `strategy` tunes the compression algorithm. Use `DEFAULT_STRATEGY`
 *   for normal data, `FILTERED` for data produced by a filter or
 *   predictor, `HUFFMAN_ONLY` to use only Huffman encoding, without
 *   string matching, or `RLE` to limit match distances to one, which is
 *   run-length encoding. Filtered data consists mostly of small values
 *   with a fairly random distribution, and `FILTERED` tunes the
 *   algorithm to compress it better, by using more Huffman coding and
 *   less string matching. It's somewhere between `DEFAULT_STRATEGY` and
 *   `HUFFMAN_ONLY`. `RLE` is almost as fast as `HUFFMAN_ONLY`, but
 *   compresses PNG image data better. The strategy only affects the
 *   compression ratio, not whether the output is correct, even if it
 *   isn't set appropriately. `FIXED` prevents the use of dynamic
 *   Huffman codes, which allows a simpler decoder for special
 *   applications.
 *
 * - `memory_level` sets how much memory is used for the internal
 *   compression state. A `memory_level` of 1 uses the least memory, but
 *   is slow and compresses less well, and 9 uses the most memory, for
 *   the best speed. The default is 8.
 *
 * @param {bytes|string} data
 * @param ?int level: defaults to `DEFAULT_COMPRESSION`.
 * @param ?int strategy: defaults to `DEFAULT_STRATEGY`.
 * @param ?int wbits: defaults to `MAX_WBITS`.
 * @param ?int memory_level: defaults to `DEFAULT_MEMORY_LEVEL`.
 * @returns bytes
 */
def compress(data, level, strategy, wbits, memory_level) {
  return _compress.compress(data, level, strategy, wbits, memory_level)
}

/**
 * Decompress decompresses as much data as possible, and stops
 * when the input buffer becomes empty or the output buffer
 * becomes full.
 *
 * - In this implementation, decompress() always flushes as much
 * output as possible to the output buffer, and always uses the
 * faster approach on the first call.
 *
 * - The `wbits` parameter is the base two logarithm of the
 * maximum window size (the size of the history buffer). It
 * should be in the range 8..15 for this version of the library.
 * The default value is 15. `wbits` must be greater than or equal
 * to the `wbits` value provided to compress() while compressing,
 * or it must be equal to 15 if compress() is used with the
 * default values. If a compressed stream with a larger window
 * size is given as input, decompress() will return with the
 * error code data error instead of trying to allocate a larger
 * window.
 *
 * `wbits` can also be zero to request that decompress use the
 * window size in the zlib header of the compressed stream.
 *
 * `wbits` can also be -8..-15 for raw decompress. In this case,
 * `-wbits` determines the window size. decompress() will then
 * process raw compress data, not looking for a zlib or gzip
 * header, not generating a check value, and not looking for any
 * check values for comparison at the end of the stream. This is
 * for use with other formats that use the compress compressed
 * data format such as zip. Those formats provide their own check
 * values. If a custom format is developed using the raw compress
 * format for compressed data, it is recommended that a check
 * value such as an Adler-32 or a CRC-32 be applied to the
 * uncompressed data as is done in the zlib, gzip, and zip
 * formats. For most applications, the zlib format should be used
 * as is. Note that comments on the use in compress() applies to
 * the magnitude of `wbits`.
 *
 * `wbits` can also be greater than 15 for optional gzip
 * decoding. Add 32 to `wbits` to enable zlib and gzip decoding
 * with automatic header detection, or add 16 to decode only the
 * gzip format (the zlib format will return a data error).
 * decompress() will not automatically decode concatenated gzip
 * streams.
 *
 * - decompress() can decompress either zlib-wrapped or
 * gzip-wrapped compress data. If the compression uses
 * gzip-wrapper, the correct `wbits` may need to be set.
 *
 * @param {bytes|string} data
 * @param ?int wbits: Default value is `MAX_WBITS`.
 * @returns bytes
 */
def decompress(data, wbits) {
  return _compress.decompress(data, wbits)
}

import .gzip { GzipDecoder, GzipEncoder }

/**
 * A streaming Deflate encoder.
 *
 * Example:
 *
 * ```zuri-repl
 * %> import compress.zlib
 * %> var encoder = zlib.ZlibEncoder()
 * %> encoder.write('hello world')
 * 11
 * %> encoder.finish()
 * (78 01 cb 48 cd c9 c9 57 28 cf 2f ca 49 01 00 1a 0b 04 5d)
 * ```
 */
class ZlibEncoder < GzipEncoder {

  /**
   * Creates a streaming Deflate encoder at the given level, from 0 to
   * 9.
   *
   * @param ?number level: defaults to 1.
   */
  @new(level) {
    self._ptr = _compress.gzip_new_encoder(true, level)
  }
}

/**
 * Streaming zlib decompressor implemention. This decoder reads
 * standard zlib blocks and frames produced at any zlib
 * compression level.
 *
 * Wraps a byte stream of compressed data and yields decompressed
 * bytes.
 *
 * Example:
 *
 * ```zuri-repl
 * %> import compress.zlib
 * %> var data = zlib.compress('hello world')
 * %> data
 * (78 9c cb 48 cd c9 c9 57 28 cf 2f ca 49 01 00 1a 0b 04 5d)
 * %>
 * %> var decoder = zlib.ZlibDecoder(data)
 * %> decoder.read_as_string()
 * hello world
 * ```
 *
 * This decoder is level-independent and supports standard zlib
 * frames produced by all zlib compression levels.
 */
class ZlibDecoder < GzipDecoder {

  /**
   * Creates a Zlib decoder
   *
   * @param bytes source
   */
  @new(source) {
    self._ptr = _compress.gzip_new_decoder(true, source)
  }
}
