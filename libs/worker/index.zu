/**
 * @module worker
 *
 * Parallel workers backed by a pool of operating-system threads
 * (see `configure()`). Workers run concurrently and may execute on
 * different CPU cores at the same time.
 *
 * Each worker thread has its own independent copy of the program's
 * global state. No memory is shared between workers, or between a
 * worker and the code that spawned it. Arguments passed to
 * `spawn()`, a worker's return value, and `Channel` messages are
 * deep-copied; mutating a value on one side never affects the other
 * side's copy. Shared structure within one copied value (two
 * arguments pointing at the same list, a self-referential list, ...)
 * is preserved.
 *
 * ## Values that can cross
 *
 * `spawn()`'s target and arguments, a worker's return value, and
 * `Channel` messages may be any of: `nil`, `bool`, `number`,
 * `bigint`, `string`, `bytes`, `range`, `list`, `dict`, a class
 * instance, a class (including its static fields, superclass, and
 * methods), a bound method, a function, or a native pointer (`Ptr`;
 * see "Native resources" below). A function may be a closure that
 * captures local variables, an anonymous lambda, a recursive lambda,
 * or a function or class declared directly in the entry script rather
 * than an imported module.
 *
 * A captured local variable, a class's static fields, and any other
 * global a function depends on are copied at the point they cross.
 * Two workers spawned from the same closure each get an
 * independent copy of what it captured.
 *
 * The following raise `WorkerError` if found anywhere in a value
 * crossing a worker boundary, including nested inside a list,
 * dict, instance field, captured variable, or static field:
 *
 * - a file handle (`file(...)`)
 * - a module or module binding
 *
 * ## Native resources
 *
 * A `Ptr` value (a database connection, a socket, a compression
 * stream, ...) is MOVED rather than copied: after it crosses, the
 * original reference is invalidated, and using it raises an error.
 * Only one side holds the resource at a time.
 *
 * A moved resource inside a return value or `Channel` message is
 * consumed by whichever `join()`, `try_join()`, or `recv()` call
 * reads it first. The rest of that value remains readable on
 * subsequent calls, but reading the same resource a second time
 * raises `WorkerError`.
 *
 * A `Channel` or `Worker` handle itself is the one error: it is
 * shared, not moved, since both are already safe to use concurrently
 * from multiple workers by design.
 *
 * ## Failure isolation
 *
 * A bug inside one worker cannot bring down another worker, the
 * pool, or the process: even an internal, unexpected failure (not an
 * ordinary raised error, which `join()` already reports as
 * `WorkerError`) is caught and reported the same way. The worker
 * thread involved is discarded and replaced automatically; the pool
 * keeps running at full size.
 *
 * A worker that's never `join()`ed or `try_join()`ed still has its
 * failure reported: if it fails and its `Worker` handle is dropped
 * without either ever being called, a warning is printed rather than
 * losing the failure silently. If it was started with `spawn_named()`,
 * the warning includes its name.
 *
 * ## Cancellation
 *
 * `Worker.cancel()` interrupts a worker that's currently blocked
 * in `Channel.send()`/`recv()`, `Worker.join()`, `wait_any()`,
 * `wait_all()`, or `select()`; that call raises
 * `WorkerCancelledError` within roughly 50ms. Outside one of those
 * calls, cancellation is cooperative: plain running code isn't
 * interrupted, and must check `worker.is_cancelled()` itself.
 *
 * ## Example
 *
 * ```zuri-repl
 * %> import worker
 * %> def add(a, b) { return a + b }
 * %> var task = worker.spawn(add, 2, 3)
 * %> task.join()
 * 5
 * ```
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _worker
import @.error { WorkerError, WorkerTimeoutError, WorkerCancelledError }
import @.channel { Channel, channel, select }
import @.broadcast { Broadcast, broadcast }

/**
 * A handle to a worker, returned by `spawn()`.
 */
class Worker {
  var _ptr

  @new(ptr) {
    self._ptr = ptr
  }

  /**
   * Blocks until the worker finishes and returns its result. May
   * be called more than once; later calls return immediately with
   * the same result.
   *
   * @param number timeout: seconds to wait before giving up. Waits
   *   indefinitely if omitted.
   * @returns any
   * @raises WorkerError if the worker's function raised an
   *   uncaught error
   * @raises WorkerTimeoutError if `timeout` elapses first
   * @raises WorkerCancelledError if the CALLING worker (not this
   *   one) is cancelled while blocked here
   */
  join(timeout: ?number) {
    var r = _worker.join(self._ptr, timeout)
    if r[0] == 'pending' {
      raise WorkerTimeoutError('join() timed out after ${timeout} seconds')
    }
    if r[0] == 'cancelled' {
      raise WorkerCancelledError('join() was interrupted: the calling worker was cancelled')
    }
    if r[0] == 'error' {
      raise WorkerError(r[1])
    }
    return r[1]
  }

  /**
   * Requests that the worker stop. Has no effect on a worker
   * that has already finished.
   *
   * If the worker is currently blocked in `Channel.send()`/
   * `recv()`, `Worker.join()`, `wait_any()`, `wait_all()`, or
   * `select()`, that call is interrupted within roughly 50ms and
   * raises `WorkerCancelledError`.
   *
   * Otherwise; plain, non-blocking code; cancellation is
   * cooperative: it does not interrupt code that's already running.
   * The worker's own function must check `worker.is_cancelled()`
   * and return on its own.
   */
  cancel() {
    _worker.cancel(self._ptr)
  }

  /**
   * @returns bool: `true` if `cancel()` has been called on this
   *   worker.
   */
  is_cancelled() {
    return _worker.is_cancelled(self._ptr)
  }

  /**
   * @returns ?string: the name given via `spawn_named()`, or `nil` if
   *   this worker was started with plain `spawn()`.
   */
  name() {
    return _worker.name(self._ptr)
  }

  /**
   * Returns the worker's result, or `nil` if it has not finished
   * yet. Does not block.
   *
   * @note a worker that returns `nil` is indistinguishable from
   *   one still running. Use `is_done()` to tell them apart.
   * @returns any
   * @raises WorkerError if the worker's function raised an
   *   uncaught error
   */
  try_join() {
    var r = _worker.try_join(self._ptr)
    if r[0] == 'pending' {
      return nil
    }
    if r[0] == 'error' {
      raise WorkerError(r[1])
    }
    return r[1]
  }

  /**
   * @returns bool: `true` if the worker has finished.
   */
  is_done() {
    return _worker.is_done(self._ptr)
  }

  /**
   * Unlike `try_join()`, never marks a failure as "observed"; safe
   * to poll purely to check progress without silencing the warning a
   * failure that's never actually `join()`ed/`try_join()`ed would
   * otherwise get (see the module docs' "Failure isolation" section).
   *
   * @returns string: `'pending'` while still running, `'done'` once
   *   finished successfully, or `'error'` once finished with an
   *   uncaught error.
   */
  status() {
    return _worker.status(self._ptr)
  }

  /**
   * This worker's underlying native handle, needed by `wait_any()`
   * to operate on a plain list of `Worker`s from outside the
   * class. Not meant for direct use.
   */
  handle() {
    return self._ptr
  }
}

/**
 * Starts `fn` running on the worker pool and returns a handle to
 * it. See the module documentation for which values may cross into
 * `fn` and `args`.
 *
 * Example:
 *
 * ```zuri-repl
 * %> def square(n) { return n * n }
 * %> var t = worker.spawn(square, 9)
 * %> t.join()
 * 81
 * ```
 *
 * @param function fn: a closure, bound method, or class method.
 * @param ...any args
 * @returns Worker
 * @raises TypeError if `fn` is not callable
 * @raises WorkerError if `fn` is a native function or class,
 *   `fn`/`args` cannot cross a worker boundary, or the pool has
 *   been `shutdown()`
 */
def _do_spawn(fn, args, name) {
  var r = _worker.spawn(fn, args, name)
  if r[0] == 'error' {
    raise WorkerError(r[1])
  }
  return Worker(r[1])
}

def spawn(fn: function, ...args) {
  return _do_spawn(fn, args, nil)
}

/**
 * Same as `spawn()`, but gives the worker a `name`; purely a
 * debugging label, read back via `Worker.name()` and included in
 * the "unobserved failure" warning (see the module docs' "Failure
 * isolation" section) if this one fails and is never `join()`ed or
 * `try_join()`ed.
 *
 * @param string name
 * @param function fn: a closure, bound method, or class method.
 * @param ...any args
 * @returns Worker
 * @raises TypeError if `fn` is not callable
 * @raises WorkerError if `fn` is a native function or class,
 *   `fn`/`args` cannot cross a worker boundary, or the pool has
 *   been `shutdown()`
 */
def spawn_named(name: string, fn: function, ...args) {
  return _do_spawn(fn, args, name)
}

/**
 * A structured-concurrency handle passed to a `scope()` body. Spawns
 * workers the same way the module-level `spawn()` does, except
 * every one of them is tracked by the scope that created it: `scope()`
 * does not return until all of them have finished.
 */
class Scope {
  var _children

  @new() {
    self._children = []
  }

  /**
   * Same as the module-level `spawn()`, except the returned
   * `Worker` is tracked by this scope.
   *
   * @param function fn: a closure, bound method, or class method.
   * @param ...any args
   * @returns Worker
   * @raises TypeError if `fn` is not callable
   * @raises WorkerError if `fn` is a native function or class,
   *   `fn`/`args` cannot cross a worker boundary, or the pool has
   *   been `shutdown()`
   */
  spawn(fn: function, ...args) {
    var t = _do_spawn(fn, args, nil)
    self._children.append(t)
    return t
  }

  /**
   * Same as `spawn()`, but gives the worker a `name` (see the
   * module-level `spawn_named()`).
   *
   * @param string name
   * @param function fn: a closure, bound method, or class method.
   * @param ...any args
   * @returns Worker
   * @raises TypeError if `fn` is not callable
   * @raises WorkerError if `fn` is a native function or class,
   *   `fn`/`args` cannot cross a worker boundary, or the pool has
   *   been `shutdown()`
   */
  spawn_named(name: string, fn: function, ...args) {
    var t = _do_spawn(fn, args, name)
    self._children.append(t)
    return t
  }

  /**
   * @returns [Worker]: every worker spawned through this scope
   *   so far, in spawn order.
   */
  children() {
    return self._children
  }
}

/**
 * Runs `body(s)`, where `s` is a fresh `Scope`, and does not return
 * until every worker spawned directly through `s.spawn()` has
 * finished. A worker started this way can never outlive its scope,
 * and its failure can never be silently dropped the way an
 * unmonitored `spawn()` result could be.
 *
 * If `body` raises, or any worker spawned through `s` fails, every
 * other still-running one in the scope is `cancel()`ed (cooperative, 
 * see `Worker.cancel()`), and `scope()` still waits for all of them
 * to actually finish before re-raising. `body`'s own error takes
 * priority if both it and a child failed; otherwise the first child
 * failure, in the order it was spawned, is raised.
 *
 * @param function body: called with one argument, the `Scope`.
 * @returns any: whatever `body` returned, if nothing failed.
 * @raises WorkerError if `body` raised nothing but a child did
 */
def scope(body: function) {
  var s = Scope()
  var body_error = nil
  var result = nil
  catch {
    result = body(s)
  } as e {
    body_error = e
  }

  # cancel every child regardless of outcome; a no-op on ones that
  # already finished, and lets still-running ones wind down sooner
  # once `body` (or a sibling) has already failed.
  for c in s.children() {
    c.cancel()
  }

  # A child that was blocked in a cancellation-aware call (`recv()`,
  # `join()`, ...) when the sweep above cancelled it fails with a
  # message that starts with the *original* raised class's name --
  # `join()` here only ever wraps it fresh as `WorkerError`, so
  # that's the one place the distinction survives the trip back from
  # the child's own isolate. Skipping it keeps `first_failure` pointed
  # at whatever ACTUALLY caused the cancellation sweep, rather than a
  # downstream side effect of it.
  var first_failure = nil
  for c in s.children() {
    catch {
      c.join()
    } as e {
      if first_failure == nil and !e.message.starts_with('WorkerCancelledError:') {
        first_failure = e
      }
    }
  }

  if body_error != nil {
    raise body_error
  }
  if first_failure != nil {
    raise first_failure
  }
  return result
}

/**
 * Sets the worker pool's worker-thread count. Has no effect if the
 * pool has already started; its size is fixed once the first
 * worker runs.
 *
 * @param int threads
 * @returns bool: `true` if applied, `false` if the pool had already
 *   started.
 * @raises ValueError if `threads` is less than 1
 */
def configure(threads: int) {
  if threads < 1 {
    raise ValueError('configure() expects threads to be at least 1, got ${threads}')
  }
  return _worker.configure(threads)
}

/**
 * The worker pool's worker-thread count. Starts the pool, with
 * whatever size `configure()` set or the machine's CPU count
 * otherwise, if it has not started yet.
 *
 * @returns int
 */
def pool_size() {
  return _worker.pool_size()
}

/**
 * @returns int: the number of logical CPUs this machine reports.
 */
def cpu_count() {
  return _worker.cpu_count()
}

/**
 * Stops the pool from accepting any further `spawn()` calls, then
 * blocks until every worker already spawned; queued or already
 * running; has finished. Nothing in flight is abandoned.
 *
 * Permanent: once called, every `spawn()` for the rest of the process
 * raises `WorkerError`, even if this call itself later times out.
 *
 * @param number timeout: seconds to wait before giving up. Waits
 *   indefinitely if omitted.
 * @raises WorkerTimeoutError if `timeout` elapses with workers
 *   still in flight
 */
def shutdown(timeout: ?number) {
  if !_worker.shutdown(timeout) {
    raise WorkerTimeoutError('shutdown() timed out after ${timeout} seconds')
  }
}

/**
 * @returns int: workers a worker is actively running right now.
 *   Does not include ones still `queued_count()`.
 */
def active_count() {
  return _worker.active_count()
}

/**
 * @returns int: workers spawned but not yet picked up by a worker.
 */
def queued_count() {
  return _worker.queued_count()
}

/**
 * @returns bool: `true` if `shutdown()` has been called.
 */
def is_shutdown() {
  return _worker.is_shutdown()
}

/**
 * Blocks until at least one of `workers` finishes, and returns
 * that one. Useful for reacting to whichever of several tasks
 * completes first, rather than joining them one at a time in a fixed
 * order.
 *
 * @param [Worker] workers: must not be empty.
 * @param number timeout: seconds to wait before giving up. Waits
 *   indefinitely if omitted.
 * @returns Worker: whichever one finished first.
 * @raises ValueError if `workers` is empty
 * @raises WorkerTimeoutError if `timeout` elapses before any of
 *   them finish
 * @raises WorkerCancelledError if the CALLING worker is
 *   cancelled while blocked here
 */
def wait_any(workers: list, timeout: ?number) {
  if workers.length() == 0 {
    raise ValueError('wait_any() expects at least one worker')
  }
  var ptrs = []
  for c in workers {
    ptrs.append(c.handle())
  }
  var r = _worker.wait_any(ptrs, timeout)
  if r[0] == 'timeout' {
    raise WorkerTimeoutError('wait_any() timed out after ${timeout} seconds')
  }
  if r[0] == 'cancelled' {
    raise WorkerCancelledError('wait_any() was interrupted: the calling worker was cancelled')
  }
  return workers[r[1]]
}

/**
 * Blocks until every one of `workers` has finished, then returns
 * their results in the same order as `workers`.
 *
 * @param [Worker] workers: may be empty (returns `[]`).
 * @param number timeout: seconds to wait for all of them combined, not
 *   per worker. Waits indefinitely if omitted.
 * @returns list
 * @raises WorkerError from the first one (in `workers` order)
 *   whose function raised, once every one of them has finished
 * @raises WorkerTimeoutError if `timeout` elapses before all of
 *   them finish
 * @raises WorkerCancelledError if the CALLING worker is
 *   cancelled while blocked here
 */
def wait_all(workers: list, timeout: ?number) {
  if workers.length() == 0 {
    return []
  }
  var ptrs = []
  for c in workers {
    ptrs.append(c.handle())
  }
  var status = _worker.wait_all(ptrs, timeout)
  if status == 'timeout' {
    raise WorkerTimeoutError('wait_all() timed out after ${timeout} seconds')
  }
  if status == 'cancelled' {
    raise WorkerCancelledError('wait_all() was interrupted: the calling worker was cancelled')
  }
  var results = []
  for c in workers {
    results.append(c.join())
  }
  return results
}

/**
 * Runs `fn` once per item in `items`, in parallel across the
 * worker pool, and returns the results in the same order as
 * `items`. Equivalent to spawning a worker per item and passing the
 * handles to `wait_all()`.
 *
 * @param function fn: a closure, bound method, or class method.
 * @param list items
 * @param number timeout: seconds to wait for the whole batch combined.
 *   Waits indefinitely if omitted.
 * @returns list
 * @raises WorkerError from the first item (in `items` order) whose
 *   call raised, once every call has finished
 * @raises WorkerTimeoutError if `timeout` elapses before every
 *   call finishes
 * @raises WorkerCancelledError if the CALLING worker is
 *   cancelled while blocked here
 */
def map(fn: function, items: list, timeout: ?number) {
  if items.length() == 0 {
    return []
  }
  var r = _worker.map(fn, items, timeout)
  if r[0] == 'timeout' {
    raise WorkerTimeoutError('map() timed out after ${timeout} seconds')
  }
  if r[0] == 'cancelled' {
    raise WorkerCancelledError('map() was interrupted: the calling worker was cancelled')
  }
  if r[0] == 'error' {
    raise WorkerError(r[1])
  }
  return r[1]
}

/**
 * Checks whether the currently running worker has been asked to
 * stop via its handle's `cancel()`. Meant to be polled periodically
 * by long-running or looping worker code so it can return early.
 *
 * Calling this outside a worker (from the main script, or from
 * another thread) always returns `false`.
 *
 * @returns bool
 */
def is_cancelled() {
  return _worker.current_is_cancelled()
}
