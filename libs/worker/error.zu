/**
 * @module error
 *
 * `WorkerError`, kept in its own leaf module (no imports of its
 * own) so both `index` and `channel` can depend on it without a
 * circular import between them. Re-exported by `worker`.
 */

/**
 * Raised when a worker's function raises an uncaught error, a
 * `Channel` operation fails, or a value cannot cross a worker
 * boundary.
 */
class WorkerError < Error {
  @new(message) {
    self.message = message or self.message
    self.type = 'WorkerError'
  }
}

/**
 * Raised when `Worker.join()`, `Channel.send()`, or `Channel.recv()`
 * is given a `timeout` and it elapses before the operation completes.
 */
class WorkerTimeoutError < WorkerError {
  @new(message) {
    self.message = message or self.message
    self.type = 'WorkerTimeoutError'
  }
}

/**
 * Raised from `Worker.join()`, `Channel.send()`, `Channel.recv()`,
 * `worker.wait_any()`, `worker.wait_all()`, or `worker.select()`
 * when the CALLING worker; the one blocked in that call, not
 * whatever it was waiting on; is `cancel()`ed while still waiting.
 */
class WorkerCancelledError < WorkerError {
  @new(message) {
    self.message = message or self.message
    self.type = 'WorkerCancelledError'
  }
}
