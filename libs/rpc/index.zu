/**
 * @module rpc
 *
 * JSON-RPC 2.0, for calling methods in another program and answering
 * its calls, over HTTP, WebSockets, sockets, pipes or any stream of
 * bytes.
 *
 * JSON-RPC is a small, stateless protocol for calling methods in
 * another program. It only defines the messages. Which methods exist is
 * up to the programs using it, and the messages travel over whatever
 * connects them. A message is a small JSON object. A request names a
 * method and has its parameters and an `id`, the response has the same
 * `id` and either a result or an error, and a notification is a request
 * that nobody answers. Either side can send any of these, so the
 * protocol has no fixed client and server.
 *
 * The module is built in layers, and each one can be used by itself:
 *
 * - {Request}, {Notification}, {Response} and {RpcError} are the
 *   messages, and `encode()`, `decode()` and `read()` convert them to
 *   and from JSON, checking every rule of the specification.
 * - A {Service} holds the handler for each method that a program
 *   serves, and uses them to answer every message it's given.
 * - Over HTTP, `http_handler()` serves a service from a route of an
 *   `http` server, and {HttpClient} calls one.
 * - {HeaderFraming}, {LineFraming} and {MessageFraming} tell messages
 *   apart in a stream: with a `Content-Length` header in front of each
 *   one, one message per line, or one message per read from a transport
 *   that already keeps them apart.
 * - A transport carries the bytes of a connection: {StdioTransport}
 *   over the program's own standard streams, {SocketTransport} over a
 *   socket, {ProcessTransport} to a child process, {WebSocketTransport}
 *   over a WebSocket, and the two ends of a `pipe()` between isolates.
 * - An {Endpoint} is a service on a connection. It answers what
 *   arrives, and calls the other side with requests and notifications
 *   of its own.
 * - `serve()` gives every connection to a listening socket an endpoint
 *   of its own, across a pool of isolates.
 *
 * ```zuri
 * import rpc
 * import isolate
 *
 * var ends = rpc.pipe()
 *
 * isolate.spawn(@(transport) {
 *   import rpc
 *
 *   rpc.endpoint(transport)
 *     .on_request('greet', @(params) => 'Hello, ${params.name}!')
 *     .serve()
 * }, ends[1])
 *
 * var client = rpc.endpoint(ends[0])
 *
 * echo client.request('greet', { name: 'Zuri' })  # Hello, Zuri!
 * client.close()
 * ```
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import @.error { * }
import @.message { * }
import @.framing { * }
import @.transport { * }
import @.service { * }
import @.endpoint { * }
import @.http { * }
import @.server { * }

/**
 * A new {Endpoint} over `transport`, which frames its messages with a
 * {HeaderFraming}.
 *
 * @param any transport: a transport. See {rpc.transport}.
 * @returns Endpoint
 */
def endpoint(transport) {
  return Endpoint(transport)
}

/**
 * A transport over the program's own standard input and output.
 *
 * @returns StdioTransport
 */
def stdio() {
  return StdioTransport()
}

/**
 * A transport over a connected socket from `net`.
 *
 * @param any socket: A connected `TcpStream`, `UnixStream` or
 *    `TlsStream`.
 * @returns SocketTransport
 */
def socket(socket) {
  return SocketTransport(socket)
}

/**
 * A transport to a child process, over its standard input and
 * output.
 *
 * @param os.Process child: A child spawned with `stdin` and `stdout`
 *    both `'pipe'`.
 * @returns ProcessTransport
 */
def process(child) {
  return ProcessTransport(child)
}

/**
 * A transport over a WebSocket from `http.websocket`.
 *
 * @param http.websocket.WebSocket socket: An open WebSocket, from
 *    `websocket.accept()` or `websocket.connect()`.
 * @returns WebSocketTransport
 */
def websocket(socket) {
  return WebSocketTransport(socket)
}
