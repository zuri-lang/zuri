/**
 * # Dictionaries
 *
 * A dictionary maps keys to values, and keeps its keys in the order
 * they were added. Lookups by key are fast, because a dictionary is a
 * hash table.
 *
 * ## Creating a dictionary
 *
 * Write the entries between braces, with a colon between each key and
 * its value:
 *
 * ```zuri-repl
 * %> {'name': 'Zuri', 'version': 0.5}
 * {name: Zuri, version: 0.5}
 * %> {}
 * {}
 * ```
 *
 * A key written as a plain word is a string, so the quotes can be left
 * out:
 *
 * ```zuri-repl
 * %> {country: 'Nigeria', dial_code: 234, in_africa: true}
 * {country: Nigeria, dial_code: 234, in_africa: true}
 * ```
 *
 * Keys are usually strings, but numbers and booleans can be keys too:
 *
 * ```zuri-repl
 * %> {0: 'number', false: 'boolean', 'key': 'string'}
 * {0: number, false: boolean, key: string}
 * ```
 *
 * When a key has the same name as the variable that holds its value,
 * you only need to write the name once:
 *
 * ```zuri-repl
 * %> var name = 'Kagawa'
 * %> {name}
 * {name: Kagawa}
 * ```
 *
 * ## Reading values
 *
 * Read a value with brackets, or with a dot when the key is a string
 * that's a valid name:
 *
 * ```zuri-repl
 * %> var a = {name: 'Zuri', version: 0.5}
 * %> a['name']
 * 'Zuri'
 * %> a.name
 * 'Zuri'
 * ```
 *
 * ## Looping over a dictionary
 *
 * A `for` loop with two variables gets each key and its value:
 *
 * ```zuri-repl
 * %> var person = {name: 'Caesar', nation: 'Rome'}
 * %> for key, value in person {
 * ..   echo '${key} = ${value}'
 * .. }
 * name = Caesar
 * nation = Rome
 * ```
 *
 * With one variable, the loop gets only the values:
 *
 * ```zuri-repl
 * %> for value in person {
 * ..   echo value
 * .. }
 * Caesar
 * Rome
 * ```
 *
 * To loop over the keys, use `keys()`:
 *
 * ```zuri-repl
 * %> for key in person.keys() {
 * ..   echo key
 * .. }
 * name
 * nation
 * ```
 */

class dict {

  /**
   * Returns the length of the dictionary. The length of a Zuri
   * dictionary is equal to the number of keys it contains. i.e.
   * `dict.length() == dict.keys().length()`.
   *
   * For example:
   *
   * ```zuri-repl
   * %> {name: 'Zuri', version: 1}.length()
   * 2
   * ```
   *
   * @return number
   */
  length() {}

  /**
   * Adds a new key-value pair to the dictionary with the given
   * key and value.<br>
   *
   * For example:
   *
   * ```zuri-repl
   * %> var dict = {}
   * %> dict.add('name', 'Zuri')
   * %> dict
   * {name: Zuri}
   * ```
   *
   * @param {string} key
   * @param {any} value
   */
  add(key: string, value: any) {}

  /**
   * Sets the value of the given key to the given value in the
   * dictionary. If there is no existing entry for the key in the
   * dictionary, a new entry will be added.<br>
   *
   * For example:
   *
   * ```zuri-repl
   * %> dict.set('name', 'New Zuri')
   * %> dict
   * {name: New Zuri}
   * %> dict.set('version', 1)
   * %> dict
   * {name: New Zuri, version: 1}
   * ```
   *
   * > **_@note_:** `dict.set(x, y)` is equivalent to the
   * > following Zuri code.
   * > ```zuri-repl
   * > %> if dict.contains(x) {
   * > ..   dict[x] = 1
   * > .. } else {
   * > ..   dict.add(x, 1)
   * > .. }
   * > ```
   *
   * @param {string} key
   * @param {any} value
   */
  set(key: string, value: any) {}

  /**
   * Clears the content of the dictionary.<br>
   *
   * For example:
   *
   * ```zuri-repl
   * %> var a = {name: 'Zuri'}
   * %> a
   * {name: Zuri}
   * %> a.clear()
   * %> a
   * {}
   * ```
   */
  clear() {}

  /**
   * Returns a new dictionary which is a deep copy of the
   * original dictionary.<br>
   *
   * For example:
   *
   * ```zuri-repl
   * %> var new_dict = dict.clone()
   * %> new_dict
   * {name: New Zuri, version: 1}
   * ```
   *
   * @return {dict}
   */
  clone() {}

  /**
   * Returns a new dictionary that contains every key-value pair
   * in the original dictionary except for keys whose associated
   * value is `nil`.
   *
   * For example:
   *
   * ```zuri-repl
   * %> var dict2 = {name: 'James', age: 20, address: nil, country: nil}
   * %> dict2.compact()
   * {name: James, age: 20}
   * ```
   *
   * @return {dict}
   */
  compact() {}

  /**
   * Returns `true` if the dictionary has the key _key_, and `false`
   * otherwise.
   *
   * For example:
   *
   * ```zuri-repl
   * %> var dict = {name: 'Zuri'}
   * %> dict.contains('name')
   * true
   * %> dict.contains('street')
   * false
   * ```
   *
   * @param {string} key
   * @return boolean
   */
  contains(key: string) {}

  /**
   * Adds every entry of _dict_ to this dictionary.
   *
   * For example:
   *
   * ```zuri-repl
   * %> var dict = {name: 'Zuri'}
   * %> dict.extend({version: 1})
   * %> dict
   * {name: Zuri, version: 1}
   * ```
   *
   * @param {dict} dict
   */
  extend(dict: dict) {}

  /**
   * Returns the value of the given _key_ in the dictionary. If
   * the given key is not defined in the dictionary and the
   * _default_ value is given, the default value will be
   * returned. Otherwise, `nil` is returned.
   *
   * For example:
   *
   * ```zuri-repl
   * %> dict.get('version')   # value exists
   * 1
   * %> dict.get('age')   # value does not exist
   * %> dict.get('age', 6)   # value does not exist, but default is given
   * 6
   * %> dict.get('version', 1.1)   # value exists and default is given
   * 1
   * ```
   *
   * @param {string} key
   * @param {any|nil} default_value
   * @return {any|nil}
   */
  get(key: string, default_value: any) {}

  /**
   * Returns a list containing the keys in the dictionary.<br>
   *
   * For example:
   *
   * ```zuri-repl
   * %> dict.keys()
   * [name, version]
   * ```
   *
   * @return {list}
   */
  keys() {}

  /**
   * Returns a list containing the value of all keys in the
   * dictionary.<br>
   *
   * For example:
   *
   * ```zuri-repl
   * %> dict.values()
   * [Zuri, 1]
   * ```
   *
   * @return {list}
   */
  values() {}

  /**
   * Removes a given key and it's corresponding value from the
   * dictionary and returns the value of the key.
   *
   * For example:
   *
   * ```zuri-repl
   * %> dict = {username: 'james', email: 'a@b.c', active: true}
   * %> dict.remove('active')
   * true
   * %> dict
   * {username: james, email: a@b.c}
   * ```
   *
   * @param {string} key
   * @return {any|nil}
   */
  remove(key) {}

  /**
   * Returns `true` if the dictionary is empty, otherwise returns
   * `false`.<br>
   *
   * For example:
   *
   * ```zuri-repl
   * %> dict.is_empty()
   * false
   * %> {}.is_empty()
   * true
   * ```
   *
   * @return {boolean}
   */
  is_empty() {}

  /**
   * Returns the key whose value is equal to _x_ in the
   * dictionary or `nil` if no key has the value _x_.<br>
   *
   * For example:
   *
   * ```zuri-repl
   * %> dict.find_key('james')
   * 'username'
   * %> dict.find_key('camel')
   * ```
   *
   * @param {any} value
   * @return {string|nil}
   */
  find_key(value: any) {}

  /**
   * Returns a list that contains a list of key and a list of
   * values from the dictionary. <br>
   *
   * For example:
   *
   * ```zuri-repl
   * %> var dict = {username: 'james', email: 'a@b.c'}
   * %> dict.to_list()
   * [[username, email], [james, a@b.c]]
   * ```
   *
   * @return {list}
   */
  to_list() {}

  /**
   * Calls `callback` for each entry in the dictionary, with the value
   * and the key as arguments.
   *
   * @param {function} callback The function to call for each entry.
   * @throws {Error} If the callback isn't a function.
   * @returns {void}
   *
   * Example:
   *
   * ```zuri
   * var scores = { a: 1, b: 2, c: 3 }
   * scores.each(@(value, key) {
   *   echo '${key}: ${value}'
   * })
   *
   * # Output:
   * # a: 1
   * # b: 2
   * # c: 3
   * ```
   */
  each(callback: function) {}

  /**
   * Creates a new dictionary that contains only the entries for which
   * `callback` returns true. The callback is called with the value and
   * the key as arguments.
   *
   * @param {function} callback The function that tests each entry. It
   *    returns true to keep the entry, or false to leave it out.
   * @throws {Error} If the callback isn't a function.
   * @returns {dict}
   *
   * Example:
   *
   * ```zuri
   * var scores = { a: 1, b: 2, c: 3 }
   * var high = scores.filter(@(value, key) {
   *   return value > 1
   * })
   * echo high
   *
   * # Output: {b: 2, c: 3}
   * ```
   */
  filter(callback: function) {}

  /**
   * Returns true if `callback` returns true for at least one entry in
   * the dictionary, and false otherwise. The callback is called with
   * the value and the key as arguments.
   *
   * @param {function} callback The function that tests each entry.
   * @throws {Error} If the callback isn't a function.
   * @returns {boolean}
   *
   * Example:
   *
   * ```zuri
   * var scores = { a: 1, b: 2, c: 3 }
   * var any_above_two = scores.some(@(value, key) {
   *   return value > 2
   * })
   * echo any_above_two
   *
   * # Output: true
   * ```
   */
  some(callback: function) {}

  /**
   * Returns true if `callback` returns true for every entry in the
   * dictionary, and false otherwise. The callback is called with the
   * value and the key as arguments.
   *
   * @param {function} callback The function that tests each entry.
   * @throws {Error} If the callback isn't a function.
   * @returns {boolean}
   *
   * Example:
   *
   * ```zuri
   * var scores = { a: 1, b: 2, c: 3 }
   * var all_positive = scores.every(@(value, key) {
   *   return value > 0
   * })
   * echo all_positive
   *
   * # Output: true
   * ```
   */
  every(callback: function) {}

  /**
   * Reduces the dictionary to a single value, by combining the entries
   * one at a time with `callback`. The callback is called with the
   * accumulated value, the value, the key and the dictionary itself,
   * and returns the new accumulated value. The method returns the final
   * accumulated value.
   *
   * @param {function} callback The function to call for each entry.
   *    It returns the updated accumulated value.
   * @param {any} initial The value passed as the accumulated value to
   *    the first call of `callback`.
   * @throws {Error} If the callback isn't a function.
   * @returns {any}
   *
   * Example:
   *
   * ```zuri
   * var scores = { a: 1, b: 2, c: 3 }
   * var sum = scores.reduce(@(total, value, key) {
   *   return total + value
   * }, 0)
   * echo sum
   *
   * # Output: 6
   * ```
   */
  reduce(callback: function, initial: any) {}

  /**
   * Returns the string representation of the dictionary.
   *
   * ```zuri-repl
   * %> {a: 1, b: 2}.to_string()
   * '{a: 1, b: 2}'
   * ```
   *
   * @returns {string}
   */
  to_string() {}

  @value(n) {}
  @key(n) {}
}
