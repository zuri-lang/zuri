/**
 * @module headers
 *
 * `Headers`, a case-insensitive multimap that preserves order. HTTP
 * header names are compared without regard to case, and some headers
 * can legitimately appear more than once.
 *
 * The validation functions check what a header name and value can
 * contain, which prevents a header value containing a newline from
 * splitting one response into two.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

#!-- part of the http module

import .errors { ProtocolError }

import _http

# Field names whose canonical spelling is not what simple
# capitalize-each-dash-part would produce. Everything else canonicalizes
# fine by that rule, so only the exceptions are listed.
var _CANONICAL_NAMES = {
  'etag': 'ETag',
  'te': 'TE',
  'dnt': 'DNT',
  'www-authenticate': 'WWW-Authenticate',
  'content-md5': 'Content-MD5',
  'x-xss-protection': 'X-XSS-Protection',
  'sec-websocket-key': 'Sec-WebSocket-Key',
  'sec-websocket-accept': 'Sec-WebSocket-Accept',
  'sec-websocket-version': 'Sec-WebSocket-Version',
  'sec-websocket-protocol': 'Sec-WebSocket-Protocol',
  'sec-websocket-extensions': 'Sec-WebSocket-Extensions',
  'x-ua-compatible': 'X-UA-Compatible',
}

# Fields that may legally appear more than once but whose values must
# never be folded together with commas, because a comma is legal inside
# a single value. `Set-Cookie` is the classic case (RFC 6265 §3);
# folding two of them produces one cookie nobody asked for.
var _NEVER_FOLDED = ['set-cookie', 'www-authenticate', 'proxy-authenticate']

# Fields defined as a single value, where a second occurrence is not
# "another value" but a request-smuggling vector: two different
# `Content-Length` values let a proxy and an origin disagree about
# where the body ends. RFC 9110 §5.3 says reject.
var _SINGLETON = [
  'content-length',
  'host',
  'content-type',
  'authorization',
  'proxy-authorization',
  'from',
  'location',
  'max-forwards',
  'referer',
  'user-agent',
  'if-modified-since',
  'if-unmodified-since',
  'age',
  'expires',
  'date',
  'retry-after',
  'last-modified',
  'server',
]

/**
 * Whether `name` is a syntactically valid HTTP field name, i.e. a
 * non-empty RFC 9110 token.
 *
 * @param string name
 * @returns bool
 */
def is_valid_name(name) {
  return is_string(name) and _http.is_valid_field_name(name)
}

/**
 * Whether `value` is a valid HTTP field value.
 *
 * The important rule is that a value can't contain CR, LF or NUL.
 * Allowing any of them would make response splitting possible: a value
 * containing `\r\n` ends the field early, and lets whoever provided it
 * inject extra headers, or even a whole second response, into the
 * stream.
 *
 * Leading and trailing whitespace isn't part of the value, so it's
 * removed before the check instead of being rejected.
 *
 * @param string value
 * @returns bool
 */
def is_valid_value(value) {
  return is_string(value) and _http.is_valid_field_value(value)
}

/**
 * The conventional capitalization of a field name. For example,
 * `'content-type'` becomes `'Content-Type'` and `'etag'` becomes
 * `'ETag'`.
 *
 * Field names are case-insensitive in HTTP, so this only affects how a
 * name looks. However, it's the capitalization that other HTTP
 * implementations use, and some badly written clients do compare names
 * case-sensitively.
 *
 * @param string name
 * @returns string
 */
def canonical_name(name: string) {
  var lower = name.lower()

  var special = _CANONICAL_NAMES.get(lower, nil)
  if special {
    return special
  }

  var parts = lower.split('-')
  iter var i = 0; i < parts.length(); i++ {
    if parts[i] {
      parts[i] = parts[i][0].upper() + parts[i][1,]
    }
  }

  return '-'.join(parts)
}

/**
 * An ordered collection of HTTP header fields, with case-insensitive
 * names and support for repeated fields.
 *
 * Field names are matched regardless of case, so
 * `headers.get('content-type')` and `headers.get('Content-Type')` look
 * up the same field, and a field is written out with the capitalization
 * it was first added with. Insertion order is preserved.
 *
 * A field can legitimately appear more than once. `set()` replaces
 * every occurrence, `add()` adds another one, `get()` returns the first
 * and `get_all()` returns all of them:
 *
 * ```zuri
 * var h = http.Headers()
 * h.set('Accept', 'text/html')
 * h.add('Accept', 'application/json')
 *
 * h.get('accept')      # 'text/html'
 * h.get_all('accept')  # ['text/html', 'application/json']
 * ```
 *
 * Every name and value is validated when it's added. A name that isn't
 * a valid token, or a value containing CR, LF or NUL, raises an error
 * instead of being silently cleaned up, because a value that can inject
 * a newline causes a response splitting bug wherever it ends up.
 *
 * @printable
 * @serializable
 */
class Headers {

  # lowercased name -> [original name, [values...]]
  var _fields = {}

  # Running total of `name: value\r\n` sizes, so a server can enforce
  # a header-block limit without walking the whole collection.
  var _size = 0

  /**
   * Builds a `Headers` collection, optionally seeded from a dictionary
   * of `name -> value` (or `name -> [value, ...]`) pairs.
   *
   * @param ?dict fields
   */
  @new(fields, _raw_size: ?number) {
    if _raw_size != nil {
      self._fields = fields
      self._size = _raw_size
      return
    }

    self._fields = {}
    self._size = 0

    if fields != nil {
      if !is_dict(fields) {
        raise TypeError('fields must be a dictionary')
      }
      self.extend(fields)
    }
  }

  /**
   * The first value recorded for `name`, or `fallback` (default `nil`)
   * when the field is absent.
   *
   * @param string name
   * @param ?any fallback
   * @returns any
   */
  get(name: string, fallback) {
    var entry = self._fields.get(name.lower(), nil)
    if entry == nil {
      return fallback
    }
    return entry[1][0]
  }

  /**
   * Every value recorded for `name`, in the order they were added, or
   * an empty list when the field is absent.
   *
   * @param string name
   * @returns list
   */
  get_all(name: string) {
    var entry = self._fields.get(name.lower(), nil)
    if entry == nil {
      return []
    }
    return entry[1].clone()
  }

  /**
   * All the values of `name` joined with `', '`, which RFC 9110 §5.3
   * defines as equivalent to repeating the field, or `fallback` if the
   * field isn't present.
   *
   * Never use this for `Set-Cookie`. Commas are allowed inside a cookie
   * value, so joining the values corrupts them. Use `get_all()`
   * instead.
   *
   * @param string name
   * @param ?any fallback
   * @returns any
   */
  get_joined(name: string, fallback) {
    var entry = self._fields.get(name.lower(), nil)
    if entry == nil {
      return fallback
    }
    return ', '.join(entry[1])
  }

  /**
   * Replaces every value of `name` with `value`. The name keeps
   * whatever spelling it is given here.
   *
   * @param string name
   * @param {string|number|bool} value
   * @returns Headers: this same instance, for chaining
   * @throws ProtocolError if the name is not a token or the value
   *    contains CR, LF, or NUL
   */
  set(name: string, value) {
    var text = self._coerce(name, value)

    if !is_valid_name(name) {
      raise ProtocolError('invalid header field name: ${name}')
    }

    var key = name.lower()
    var entry = self._fields.get(key, nil)
    if entry != nil {
      for val in entry[1] {
        self._size -= entry[0].length() + val.length() + 4
      }
      self._fields.remove(key)
    }

    self._fields[key] = [
      name,
      [text],
    ]
    self._size += name.length() + text.length() + 4

    return self
  }

  /**
   * Records another value for `name`, keeping any already there.
   *
   * @param string name
   * @param {string|number|bool} value
   * @returns Headers: this same instance, for chaining
   * @throws ProtocolError if the name is not a token or the value
   *    contains CR, LF, or NUL
   */
  add(name: string, value) {
    var text = self._coerce(name, value)

    if !is_valid_name(name) {
      raise ProtocolError('invalid header field name: ${name}')
    }

    var key = name.lower()
    var entry = self._fields.get(key, nil)

    if entry == nil {
      self._fields[key] = [
        name,
        [text],
      ]
    } else {
      entry[1].append(text)
    }

    self._size += name.length() + text.length() + 4

    return self
  }

  /**
   * Sets `name` to `value` only if the field isn't already present.
   * This module uses it for defaults that a caller can override, such
   * as `Date`, `Server` and `User-Agent`.
   *
   * @param string name
   * @param {string|number|bool} value
   * @returns Headers: this same instance, for chaining
   */
  set_default(name: string, value) {
    if !self.contains(name) {
      self.set(name, value)
    }
    return self
  }

  /**
   * Removes every value of `name`. Removing a field that isn't present
   * does nothing.
   *
   * @param string name
   * @returns Headers: this same instance, for chaining
   */
  remove(name: string) {
    var key = name.lower()
    var entry = self._fields.get(key, nil)

    if entry != nil {
      for value in entry[1] {
        self._size -= entry[0].length() + value.length() + 4
      }
      self._fields.remove(key)
    }

    return self
  }

  /**
   * Whether `name` is present at all.
   *
   * @param string name
   * @returns bool
   */
  contains(name: string) {
    return self._fields.contains(name.lower())
  }

  /**
   * Whether `name` is present and one of its comma-separated tokens
   * equals `token`, compared case-insensitively.
   *
   * This is the correct way to check the list-valued fields that
   * control the protocol, such as `Connection: keep-alive, Upgrade` or
   * `Transfer-Encoding: gzip, chunked`. A simple substring check would
   * also match `keep-alive-ish`, and a simple equality check would miss
   * the second token completely.
   *
   * @param string name
   * @param string token
   * @returns bool
   */
  contains_token(name: string, token: string) {
    var entry = self._fields.get(name.lower(), nil)
    if entry == nil {
      return false
    }

    var wanted = token.lower()

    for value in entry[1] {
      for part in value.split(',') {
        if part.trim().lower() == wanted {
          return true
        }
      }
    }

    return false
  }

  /**
   * Every comma-separated token across every occurrence of `name`,
   * lowercased and trimmed, in order. Empty elements are dropped, as
   * RFC 9110 §5.6.1 permits.
   *
   * @param string name
   * @returns list
   */
  tokens(name: string) {
    var result = []

    for value in self.get_all(name) {
      for part in value.split(',') {
        var token = part.trim().lower()
        if token {
          result.append(token)
        }
      }
    }

    return result
  }

  /**
   * Copies every field from `other` into this collection, replacing
   * fields of the same name. `other` may be another `Headers` or a
   * plain dictionary whose values are strings or lists of strings.
   *
   * @param {Headers|dict} other
   * @returns Headers: this same instance, for chaining
   */
  extend(other) {
    if instance_of(other, Headers) {
      other.each(@(name, value) {
        self.add(name, value)
      })
      return self
    }

    if !is_dict(other) {
      raise TypeError('expected Headers or dictionary, got ${typeof(other)}')
    }

    for name, value in other {
      if is_list(value) {
        self.remove(name)
        for item in value {
          self.add(name, item)
        }
      } else {
        self.set(name, value)
      }
    }

    return self
  }

  /**
   * Calls `callback(name, value)` once for each occurrence of a field,
   * in insertion order, so a field that appears three times causes
   * three calls. That's what writing the header block back out needs.
   *
   * @param function(2) callback
   */
  each(callback) {
    for _, entry in self._fields {
      for value in entry[1] {
        callback(entry[0], value)
      }
    }
  }

  /**
   * The field names present, in insertion order and in the spelling
   * they were added under.
   *
   * @returns list
   */
  names() {
    var result = []
    for _, entry in self._fields {
      result.append(entry[0])
    }
    return result
  }

  /**
   * The number of distinct field names present. A field repeated
   * three times counts once.
   *
   * @returns number
   */
  length() {
    return self._fields.length()
  }

  /**
   * Whether there are no fields at all.
   *
   * @returns bool
   */
  is_empty() {
    return self._fields.is_empty()
  }

  /**
   * The number of bytes this block would occupy once serialized,
   * counting the `': '` and `CRLF` around every value. Servers use
   * this to enforce a header-size limit as fields arrive.
   *
   * @returns number
   */
  size() {
    return self._size
  }

  /**
   * Drops every field. Cheaper than building a new instance when a
   * connection is being reused for the next message.
   *
   * @returns Headers: this same instance, for chaining
   */
  clear() {
    self._fields.clear()
    self._size = 0
    return self
  }

  /**
   * An independent copy. Mutating the copy never affects the
   * original.
   *
   * @returns Headers
   */
  clone() {
    var copy = Headers()

    self.each(@(name, value) {
      copy.add(name, value)
    })

    return copy
  }

  /**
   * Changes every field name to its conventional capitalization, such
   * as `content-type` to `Content-Type`. This only affects how the
   * names look, since they're case-insensitive either way.
   *
   * @returns Headers: this same instance, for chaining
   */
  canonicalize() {
    for key, entry in self._fields {
      entry[0] = canonical_name(key)
    }
    return self
  }

  /**
   * Removes the hop-by-hop fields listed in RFC 9110 §7.6.1, which
   * apply only to a single connection and must not be forwarded to the
   * next one. This includes any field named in the message's own
   * `Connection` field, which is how an endpoint declares an extra
   * hop-by-hop field.
   *
   * If a reverse proxy forgets to do this, a client's
   * `Transfer-Encoding` can reach an upstream server that frames the
   * message differently, which is the classic setup for request
   * smuggling.
   *
   * @returns Headers: this same instance, for chaining
   */
  strip_hop_by_hop() {
    var doomed = [
      'connection',
      'keep-alive',
      'proxy-connection',
      'proxy-authenticate',
      'proxy-authorization',
      'te',
      'trailer',
      'transfer-encoding',
      'upgrade',
    ]

    for token in self.tokens('connection') {
      if !doomed.contains(token) {
        doomed.append(token)
      }
    }

    for name in doomed {
      self.remove(name)
    }

    return self
  }

  /**
   * Serializes the block in wire format: `Name: value\r\n` per
   * occurrence, with no terminating blank line (the caller decides
   * where the block ends, since a trailer section ends differently to
   * a head).
   *
   * @returns string
   */
  to_wire() {
    var parts = []

    for _, entry in self._fields {
      var name = entry[0]
      for value in entry[1] {
        parts.append('${name}: ${value}\r\n')
      }
    }

    return ''.join(parts)
  }

  /**
   * Writes the headers in wire format directly to `target`, avoiding
   * intermediate array and string allocations.
   *
   * @param target: an object with a `write(string|bytes)` method
   */
  write_to(target) {
    for _, entry in self._fields {
      var name = entry[0]
      for value in entry[1] {
        target.write('${name}: ${value}\r\n')
      }
    }
  }

  /**
   * Appends a response head built around these fields to `buffer`: the
   * status line, the fields, one `Set-Cookie` per cookie and the blank
   * line that ends it.
   *
   * @param bytes buffer
   * @param string version
   * @param number status
   * @param string reason
   * @param list cookies: the value of each `Set-Cookie` field
   */
  append_head_to(buffer, version, status, reason, cookies) {
    _http.append_head(buffer, version, status, reason, self._fields, cookies)
  }

  /**
   * The block as a plain dictionary of `name -> value`, folding
   * repeated fields into a list. Handy for logging and for handing
   * headers to code that has no reason to know about this class.
   *
   * @returns dict
   */
  to_dict() {
    var result = {}

    for _, entry in self._fields {
      result[entry[0]] = entry[1].length() == 1 ? entry[1][0] : entry[1].clone()
    }

    return result
  }

  # Normalises a value to a string and validates it. Numbers and
  # booleans are accepted because a great many header values are
  # naturally one of those (`Content-Length`, `Age`, `Max-Forwards`)
  # and forcing every caller to stringify them buys nothing.
  _coerce(name, value) {
    if value == nil {
      raise TypeError('header ${name} cannot be nil')
    }

    var text = is_string(value) ? value : value.to_string()
    text = text.trim(' \t')

    if !is_valid_value(text) {
      raise ProtocolError(
        'header ${name} contains a line break or NUL, which would split the response',
      )
    }

    return text
  }

  to_string() {
    return '<Headers ${self._fields.length()} fields>'
  }

  @to_string() {
    return self.to_string()
  }

  @to_json() {
    return self.to_dict()
  }
}

/**
 * Parses a raw header block, meaning everything between a start line
 * and the blank line that ends the head, into a `Headers`.
 *
 * Obsolete line folding, where a continuation line starts with a space,
 * is rejected instead of being unfolded. RFC 9112 §5.2 deprecated it,
 * and since intermediaries handle it in different ways, rejecting it is
 * the safer choice.
 *
 * @param string block: the header lines, without the trailing blank
 *    line
 * @param ?bool strict: when `true` (the default), a field that's
 *    defined to appear at most once raises an error if it appears more
 *    than once, instead of being combined
 * @returns Headers
 * @throws ProtocolError on an invalid field, a folded line, or a
 *    repeated field that should only appear once
 */
/**
 * Parses a single header line and records it into `target`.
 *
 * @param Headers target
 * @param string line
 * @param ?bool strict
 * @throws ProtocolError on malformed headers, folding, or singleton conflicts
 */
def parse_line(target: Headers, line: string, strict: ?bool) {
  if line.is_empty() {
    return
  }

  if strict == nil {
    strict = true
  }

  # An obs-fold continuation. Unfolding it would mean guessing what
  # the sender meant, and intermediaries guess differently.
  if line[0] == ' ' or line[0] == '\t' {
    raise ProtocolError('obsolete header line folding is not accepted')
  }

  var colon = line.index_of(':')
  if colon < 1 {
    raise ProtocolError('malformed header line: ${line}')
  }

  var name = line[0, colon]

  # RFC 9112 §5.1 is explicit: no whitespace is allowed between the
  # field name and the colon, and a server MUST reject it. This is
  # the "Content-Length : 5" smuggling trick.
  if name != name.trim() {
    raise ProtocolError('whitespace between header name and colon: ${name}')
  }

  if !is_valid_name(name) {
    raise ProtocolError('invalid header field name: ${name}')
  }

  var value = line[colon + 1,].trim(' \t')

  if strict and _SINGLETON.contains(name.lower()) and target.contains(name) {
    # Two different Content-Lengths (or Hosts) is not a message with
    # a repeated field; it is two parties being invited to disagree
    # about where this message ends.
    if target.get(name, nil) != value {
      raise ProtocolError('conflicting duplicate ${name} header')
    }
    return
  }

  target.add(name, value)
}

/**
 * Parses a complete HTTP header section into a `Headers` instance.
 *
 * @param string block
 * @param ?bool strict: whether to enforce singleton header checks
 * @returns Headers
 * @throws ProtocolError
 */
def parse(block: string, strict: ?bool) {
  if strict == nil {
    strict = true
  }

  var headers = Headers()
  if !block or block.trim().is_empty() {
    return headers
  }

  for line in block.split('\r\n') {
    if !line.is_empty() {
      parse_line(headers, line, strict)
    }
  }

  return headers
}

/**
 * Whether a field with this name must be written out as separate
 * fields, instead of being combined into one comma-separated value.
 *
 * @param string name
 * @returns bool
 */
def is_never_folded(name: string) {
  return _NEVER_FOLDED.contains(name.lower())
}

/**
 * Constructs a `Headers` instance directly from pre-parsed header fields
 * and pre-calculated wire size, avoiding repeated validation and lowercasing.
 *
 * @param dict fields: lowercased name -> [original name, [values...]]
 * @param number size
 * @returns Headers
 */
def from_raw(fields: dict, size: number) {
  return Headers(fields, size)
}
