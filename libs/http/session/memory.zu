#!-- part of the http module

/**
 * @module http.session.memory
 *
 * The session store that keeps everything in the isolate's own heap.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import .store { SessionStore }

/**
 * Keeps sessions in a dictionary, for as long as the isolate that
 * created the store is running.
 *
 * This store is the right choice for tests, where a session only has to
 * last for a few requests, and for a development server running in a
 * single process. It's the wrong choice for anything that serves real
 * traffic:
 *
 * - Nothing survives a restart. Every active session ends when the
 *   process does, including during a deployment.
 * - Nothing is shared. `http.serve()` runs each worker in its own
 *   isolate with its own heap, so a browser whose next request goes to
 *   a different worker arrives with a session that the worker has never
 *   seen.
 *
 * `FileStore` has neither problem and needs no more setup than this
 * store does, which is why it's the default instead of this one.
 *
 * @printable
 */
class MemoryStore < SessionStore {

  # Storage key to `[payload, expires_at]`.
  var _entries = {}

  /**
   * @param ?dict options: `gc_probability` (default `0.01`)
   */
  @new(options: ?dict) {
    var settings = options == nil ? {} : options

    self._entries = {}
    self.gc_probability = settings.get('gc_probability', 0.01)
  }

  /**
   * How many sessions are held, expired ones that have not yet been
   * swept included.
   *
   * @returns number
   */
  length() {
    return self._entries.length()
  }

  /**
   * Drops every session at once.
   */
  clear() {
    self._entries.clear()
  }

  read(key: string) {
    var entry = self._entries.get(key, nil)

    if entry == nil {
      return nil
    }

    if entry[1] <= time() {
      self._entries.remove(key)

      return nil
    }

    return entry[0]
  }

  write(key: string, payload: string, expires_at: number) {
    self._entries[key] = [payload, expires_at]

    self.maybe_gc()
  }

  touch(key: string, expires_at: number) {
    var entry = self._entries.get(key, nil)

    if entry == nil {
      return false
    }

    entry[1] = expires_at

    return true
  }

  destroy(key: string) {
    self._entries.remove(key)
  }

  gc(now: number) {
    var expired = []

    for key, entry in self._entries {
      if entry[1] <= now {
        expired.append(key)
      }
    }

    for key in expired {
      self._entries.remove(key)
    }

    return expired.length()
  }

  to_string() {
    return '<MemoryStore ${self._entries.length()} sessions>'
  }

  @to_string() {
    return self.to_string()
  }
}
