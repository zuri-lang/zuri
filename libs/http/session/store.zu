#!-- part of the http module

/**
 * @module http.session.store
 *
 * The interface that session stores implement, and the error they all
 * raise.
 *
 * A store is the only part of the session system that touches durable
 * state. It never sees a session ID, only the key derived from one, and
 * it never sees the session's contents, only the string the session
 * layer serialized them into. That separation lets you replace the
 * store without the rest of the stack knowing about it. It also means
 * that a leaked store, whether it's a directory listing, a database
 * dump or a backup, doesn't give away anything that can be used as a
 * cookie.
 *
 * To implement a store, you write `read()`, `write()`, `destroy()` and
 * `gc()`. You can also override `touch()`, which has a working default
 * built on the first two.
 *
 * ```zuri,ignore
 * class RedisStore < session.SessionStore {
 *   @new(client) {
 *     self._client = client
 *   }
 *
 *   read(key) {
 *     return self._client.get('session:' + key)
 *   }
 *
 *   write(key, payload, expires_at) {
 *     var ttl = (expires_at - time()).ceil()
 *
 *     self._client.set_with_ttl('session:' + key, payload, ttl)
 *   }
 *
 *   destroy(key) {
 *     self._client.remove('session:' + key)
 *   }
 *
 *   gc(now) {
 *     # Redis expires keys itself.
 *     return 0
 *   }
 * }
 * ```
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import ..errors { HttpError }

import hash

/**
 * Raised when a session cannot be read, written or configured: a
 * storage directory that cannot be created or is open to other users
 * on the machine, a payload larger than the configured ceiling, an
 * unknown option, or a store method an implementation forgot.
 *
 * It is an `HttpError`, so a server already catching those catches
 * this as well.
 *
 * @printable
 */
class SessionError < HttpError {
  to_string() {
    return '<SessionError: ${self.message}>'
  }

  @to_string() {
    return self.to_string()
  }
}

/**
 * The key that a store files a session under, which is the SHA-256
 * digest of the session ID as 64 lowercase hexadecimal characters.
 *
 * Storing the digest instead of the ID means that the contents of a
 * store can't be turned back into cookies. Someone who reads the
 * directory, the table or a backup of either can learn what's in the
 * sessions, but can't resume one, because the browser has to present
 * the original ID, and the digest can't be reversed to get it.
 *
 * It also fixes the form of a key. 64 hexadecimal characters always
 * make a safe file name and a fixed-width primary key, whatever a
 * client put in its cookie.
 *
 * @param string id
 * @returns string
 */
def storage_key(id: string) {
  return hash.sha256(id)
}

/**
 * The interface that every session store implements.
 *
 * The methods here raise a `SessionError`, so a store that's missing
 * one fails at the missing method, not somewhere further on.
 *
 * All timestamps are in seconds since the epoch, as returned by
 * `time()`.
 */
class SessionStore {

  /**
   * The chance, between `0` and `1`, that a write also sweeps
   * expired sessions.
   *
   * Nothing schedules a sweep, so one has to ride along with ordinary
   * traffic. At the default of `0.01` a store is swept roughly once
   * per hundred writes, which keeps a busy server tidy without making
   * any single request pay often. Set it to `0` where a cron job or a
   * timer calls `gc()` instead.
   *
   * @type number
   */
  var gc_probability = 0.01

  /**
   * The payload stored under `key`, or `nil` if there's none or it has
   * expired.
   *
   * A store that finds an expired entry removes it, instead of leaving
   * it for the next sweep.
   *
   * @param string key
   * @returns ?string
   */
  read(key: string) {
    raise SessionError('a session store has to implement read()')
  }

  /**
   * Stores `payload` under `key`, replacing whatever was there, and
   * records when it stops being valid.
   *
   * @param string key
   * @param string payload
   * @param number expires_at
   */
  write(key: string, payload: string, expires_at: number) {
    raise SessionError('a session store has to implement write()')
  }

  /**
   * Changes the expiry time of an existing entry without rewriting its
   * contents. A rolling idle timeout needs this for a request that only
   * read the session.
   *
   * The default implementation reads the payload and writes it back. A
   * store whose backend can change the expiry on its own, with a
   * single-column `UPDATE` or a `TTL` command for example, overrides
   * this to do that.
   *
   * @param string key
   * @param number expires_at
   * @returns bool: whether there was an entry to update
   */
  touch(key: string, expires_at: number) {
    var payload = self.read(key)

    if payload == nil {
      return false
    }

    self.write(key, payload, expires_at)

    return true
  }

  /**
   * Removes the entry stored under `key`. Removing one that is not
   * there is not an error.
   *
   * @param string key
   */
  destroy(key: string) {
    raise SessionError('a session store has to implement destroy()')
  }

  /**
   * Removes every entry that expired on or before `now`.
   *
   * @param number now
   * @returns number: how many entries were removed
   */
  gc(now: number) {
    raise SessionError('a session store has to implement gc()')
  }

  /**
   * Runs `gc()` with probability `gc_probability`, and otherwise does
   * nothing. A store calls this from its own `write()`.
   *
   * A sweep that fails raises out of the write that triggered it: a
   * store that cannot sweep is a store that will not be able to write
   * for much longer either, and swallowing that hides a full disk or
   * a dead connection until the next outage.
   *
   * @returns bool: whether a sweep ran
   */
  maybe_gc() {
    if self.gc_probability <= 0 {
      return false
    }

    if rand(0, 1) >= self.gc_probability {
      return false
    }

    self.gc(time())

    return true
  }

  /**
   * Releases whatever the store holds open. The default does nothing,
   * which is right for a store that holds nothing.
   */
  close() {}
}
