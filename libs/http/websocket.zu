/**
 * @module websocket
 *
 * WebSockets (RFC 6455), for both clients and servers.
 *
 * `accept()` upgrades an incoming request, `connect()` opens an
 * outgoing connection, and `WebSocket` is the resulting two-way
 * channel. `Message` is a single complete message, reassembled from
 * however many frames it was sent in, and the `CLOSE_*` constants are
 * the status codes a close frame can have.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

#!-- part of the http module

import .errors { ConnectionError, HttpError, ProtocolError }
import .headers { Headers }
import .request { HttpRequest }
import .status
import .stream
import .util
import .loop { Timer }

import base64
import crypto
import hash
import url

# RFC 6455 §1.3: this constant is appended to the client's key before
# hashing. It exists so that a server which merely echoes bytes back
# cannot be mistaken for one that speaks WebSocket.
var _GUID = '258EAFA5-E914-47DA-95CA-C5AB0DC85B11'

/** Continuation frame. @type int */
var OPCODE_CONTINUATION = 0
/** Text frame. @type int */
var OPCODE_TEXT = 1
/** Binary frame. @type int */
var OPCODE_BINARY = 2
/** Close frame. @type int */
var OPCODE_CLOSE = 8
/** Ping frame. @type int */
var OPCODE_PING = 9
/** Pong frame. @type int */
var OPCODE_PONG = 10

/** Normal closure. @type int */
var CLOSE_NORMAL = 1000
/** The endpoint is going away. @type int */
var CLOSE_GOING_AWAY = 1001
/** A protocol error was detected. @type int */
var CLOSE_PROTOCOL_ERROR = 1002
/** A message of a kind this endpoint cannot accept. @type int */
var CLOSE_UNSUPPORTED = 1003
/** The close frame had no code. Reported by `on_close()`. @type int */
var CLOSE_NO_STATUS = 1005
/** The connection closed without a close frame. Reported by `on_close()`. @type int */
var CLOSE_ABNORMAL = 1006
/** A text message that was not valid UTF-8. @type int */
var CLOSE_INVALID_PAYLOAD = 1007
/** A message that violates a policy. @type int */
var CLOSE_POLICY_VIOLATION = 1008
/** A message too large to process. @type int */
var CLOSE_TOO_LARGE = 1009
/** An unexpected condition on the server. @type int */
var CLOSE_INTERNAL_ERROR = 1011

/**
 * One complete WebSocket message, with any fragmentation already
 * reassembled.
 *
 * @printable
 */
class Message {

  /**
   * The opcode of the message: `OPCODE_TEXT`, `OPCODE_BINARY`,
   * `OPCODE_CLOSE`, `OPCODE_PING` or `OPCODE_PONG`.
   * @type int
   */
  var opcode

  /**
   * The payload.
   * @type bytes
   */
  var data

  @new(opcode, data) {
    self.opcode = opcode
    self.data = data
  }

  /**
   * Whether this is a text message.
   *
   * @returns bool
   */
  is_text() {
    return self.opcode == OPCODE_TEXT
  }

  /**
   * Whether this is a binary message.
   *
   * @returns bool
   */
  is_binary() {
    return self.opcode == OPCODE_BINARY
  }

  /**
   * Whether this is a close frame, meaning the peer has begun the
   * closing handshake.
   *
   * @returns bool
   */
  is_close() {
    return self.opcode == OPCODE_CLOSE
  }

  /**
   * The payload decoded as UTF-8 text.
   *
   * @returns string
   */
  text() {
    return self.data.to_string()
  }

  /**
   * The close code carried by a close frame, or `nil` when the frame
   * carried no code (which RFC 6455 §7.1.5 says to read as `1005`,
   * "no status received").
   *
   * @returns ?number
   */
  close_code() {
    if self.opcode != OPCODE_CLOSE or self.data.length() < 2 {
      return nil
    }

    return self.data[0] * 256 + self.data[1]
  }

  /**
   * The human-readable reason carried by a close frame.
   *
   * @returns string
   */
  close_reason() {
    if self.opcode != OPCODE_CLOSE or self.data.length() <= 2 {
      return ''
    }

    var rest = self.data[2,]
    var text = rest.to_string()
    rest.dispose()

    return text
  }

  to_string() {
    return '<Message opcode=${self.opcode} ${self.data.length()} bytes>'
  }

  @to_string() {
    return self.to_string()
  }
}

/**
 * An open WebSocket connection (RFC 6455).
 *
 * Created by `accept()` on the server side or `connect()` on the
 * client side, never directly.
 *
 * On a server run by `listen()` or `http.serve()`, the server's
 * connection loop drives the socket once the handler that accepted it
 * returns. Messages arrive through `on_message()`, and `send()` queues
 * a message that the loop sends when the peer can take it. The server
 * goes on answering other requests while the socket is open:
 *
 * ```zuri
 * server.get('/ws', @(request, response) {
 *   var socket = websocket.accept(request, response)
 *
 *   socket.on_message(@(message) {
 *     socket.send('you said: ' + message.text())
 *   })
 * })
 * ```
 *
 * A handler can instead read the socket itself, by calling `receive()`
 * before it returns. The socket then leaves the loop and reads and
 * writes as it goes, as a client's socket does. That keeps the isolate
 * busy until the handler returns, so nothing else on it is served in
 * the meantime.
 *
 * Ping frames are answered automatically, and a close frame from the
 * peer is answered, so the closing handshake completes without the
 * application having to know the rules.
 *
 * @printable
 */
class WebSocket {

  /**
   * Whether this endpoint is the client, and so must mask every frame
   * it sends. RFC 6455 §5.3 requires it, and a server is required to
   * fail a connection whose client does not.
   * @type bool
   */
  var is_client = false

  /**
   * The subprotocol negotiated during the handshake, or `nil`.
   * @type ?string
   */
  var protocol

  /**
   * The largest message this endpoint will assemble, in bytes.
   * @type number
   */
  var max_message_size = 8388608

  /**
   * How much output can wait for a peer that isn't reading, in bytes,
   * before the server drops the connection. Only a socket that the
   * server's loop drives has a queue.
   * @type number
   */
  var max_queued = 4194304

  /**
   * How often the server pings an idle peer, in seconds, or `nil` for
   * never. A peer that sends nothing at all, not even a pong, for twice
   * this long is taken to be gone, and the connection is closed. Set by
   * the `ping_interval` option of `accept()`.
   * @type ?number
   */
  var ping_interval

  var _conn
  var _open = true
  var _close_sent = false

  # 'direct' for a socket that reads and writes for itself, 'loop' for
  # one a server's connection loop holds, and 'blocking' for one a
  # handler took back from the loop by calling receive().
  var _mode = 'direct'

  var _link
  var _on_message
  var _on_close
  var _timers
  var _told_closed = false

  # The code and reason the closing handshake carried, for on_close().
  var _close_code
  var _close_reason = ''

  # A message still arriving in fragments.
  var _opcode
  var _parts

  @new(connection, is_client, protocol) {
    self._conn = connection
    self.is_client = is_client
    self.protocol = protocol
    self._open = true
    self._close_sent = false
    self._mode = connection.is_deferred() ? 'loop' : 'direct'
    self._timers = []
  }

  /**
   * Whether the connection is still open.
   *
   * @returns bool
   */
  is_open() {
    return self._open
  }

  /**
   * The underlying transport, for anything this class doesn't expose,
   * such as a read timeout, the peer's address or its certificate.
   *
   * @returns Connection
   */
  connection() {
    return self._conn
  }

  /**
   * Sends a text message.
   *
   * On a socket the server's loop drives, a message sent after the
   * socket has closed is dropped, as a browser drops one, because
   * `on_close()` is how the application finds out. Anywhere else it
   * raises a `ConnectionError`.
   *
   * @param string text
   */
  send(text: string) {
    self._write(OPCODE_TEXT, text.to_bytes())
  }

  /**
   * Sends a binary message.
   *
   * @param bytes data
   */
  send_binary(data) {
    self._write(OPCODE_BINARY, data)
  }

  /**
   * Sends a ping. A conforming peer answers with a pong carrying the
   * same payload, which is how an idle connection is kept alive
   * through a NAT or a proxy that would otherwise time it out.
   *
   * @param ?bytes data: at most 125 bytes
   */
  ping(data) {
    self._write(OPCODE_PING, data == nil ? bytes(0) : data)
  }

  /**
   * Sends a pong. Only needed to answer a ping this class did not
   * answer for you, or as an unsolicited heartbeat.
   *
   * @param ?bytes data
   */
  pong(data) {
    self._write(OPCODE_PONG, data == nil ? bytes(0) : data)
  }

  /**
   * Starts the closing handshake and closes the transport. On a socket
   * the server's loop drives, the transport closes once the close frame
   * has been sent.
   *
   * @param ?number code: a close code. Defaults to `CLOSE_NORMAL`.
   * @param ?string reason: at most 123 bytes once encoded
   */
  close(code: ?number, reason: ?string) {
    if !self._open {
      return
    }

    var value = code == nil ? CLOSE_NORMAL : code

    catch {
      if !self._close_sent {
        self._close_sent = true

        var payload = bytes(0)

        payload.append((value // 256) % 256)
        payload.append(value % 256)

        if reason != nil {
          var encoded = reason.to_bytes()
          payload.extend(encoded.length() > 123 ? encoded[0, 123] : encoded)
          encoded.dispose()
        }

        self._write(OPCODE_CLOSE, payload)
        payload.dispose()
      }
    }

    self._open = false
    self._close_code = value
    self._close_reason = reason == nil ? '' : reason

    if self._mode == 'loop' {
      if self._link != nil {
        self._link.close()
      }

      return
    }

    catch {
      self._conn.close()
    }
  }

  /**
   * Calls `listener` with each message the peer sends, as a `Message`,
   * once the server's loop drives this socket. Pings, pongs and the
   * close frame are handled for you and never reach it.
   *
   * A listener that raises an error is reported to the server's
   * `on_error()` listeners, and the socket is closed with
   * `CLOSE_INTERNAL_ERROR`.
   *
   * @param function(1) listener
   * @returns WebSocket: this same instance, for chaining
   */
  on_message(listener) {
    self._on_message = listener
    return self
  }

  /**
   * Calls `listener` once, when the connection has closed, with the
   * close code and the reason. The code is the one the closing
   * handshake carried, whichever side started it, `CLOSE_NO_STATUS`
   * when the peer's close frame had none, and `CLOSE_ABNORMAL` when the
   * connection ended without one.
   *
   * @param function(2) listener
   * @returns WebSocket: this same instance, for chaining
   */
  on_close(listener) {
    self._on_close = listener
    return self
  }

  /**
   * Calls `action` every `seconds` seconds, on the thread that serves
   * this socket, for as long as it's open.
   *
   * Only a socket that the server's loop drives runs its timers. An
   * action that raises an error is handled the way a failed
   * `on_message()` listener is.
   *
   * @param number seconds
   * @param function(0) action
   * @returns Timer: which `cancel()` stops
   * @throws HttpError on a client's socket, which no loop drives
   */
  every(seconds: number, action) {
    if self.is_client {
      raise HttpError('every() needs a socket that a server accepted')
    }

    var timer = Timer(seconds, @() {
      self._run(action, nil)
    })

    self._timers.append(timer)

    if self._link != nil {
      self._link.schedule(timer)
    }

    return timer
  }

  /**
   * Reads the next message, reassembling fragments and answering
   * pings along the way.
   *
   * Returns `nil` when the connection closes without a close frame.
   * A close frame is returned as a message, and answered first, so
   * the caller can see the code and reason the peer sent.
   *
   * On a server, calling this from the handler that accepted the
   * socket takes it out of the server's loop, and the isolate is busy
   * until the handler returns.
   *
   * @returns ?Message
   * @throws ProtocolError if the peer violates the framing rules
   * @throws HttpError once the server's loop drives the socket, which
   *    then delivers messages through `on_message()` instead
   */
  receive() {
    if self._mode == 'loop' {
      if self._link != nil {
        raise HttpError(
          'receive() cannot be used on a socket the server drives. ' +
              'Use on_message() instead.',
        )
      }

      self._take_back()
    } else if self._mode == 'direct' {
      self._mode = 'blocking'
    }

    if !self._open {
      return nil
    }

    while true {
      var frame

      catch {
        frame = self._read_frame()
      } as error

      if error {
        self._open = false

        if instance_of(error, ConnectionError) {
          return nil
        }

        raise error
      }

      if frame == nil {
        self._open = false
        return nil
      }

      var message = self._absorb(frame)

      if message != nil {
        if message.is_close() {
          catch {
            self._conn.close()
          }
        }

        return message
      }
    }
  }

  /**
   * Whether there's anything for the server's loop to drive, which
   * there isn't once a handler has taken the socket for itself.
   *
   * @internal Called by the connection loop.
   * @returns bool
   */
  can_drive() {
    if self._mode == 'blocking' {
      return false
    }

    return self._mode == 'loop' or self._open
  }

  /**
   * Hands the socket to the server's loop.
   *
   * @internal Called by the connection loop.
   * @param Link link
   */
  attach(link) {
    self._mode = 'loop'
    self._link = link

    if !self._open {
      link.close()
      return
    }

    if self.ping_interval != nil {
      self._timers.append(
        Timer(self.ping_interval, @() {
          self._run(@() {
            self.ping(nil)
          }, nil)
        }),
      )
    }

    for timer in self._timers {
      link.schedule(timer)
    }

    # Frames that arrived with the handshake have no event of their own
    # to announce them.
    if self._conn.buffered() > 0 or self._conn.peer_finished() {
      self.on_readable()
    }
  }

  /**
   * Acts on every whole frame that has arrived.
   *
   * @internal Called by the connection loop.
   */
  on_readable() {
    while self._open {
      var frame
      var message

      catch {
        frame = _take_frame(self._conn, self.is_client, self.max_message_size)

        if frame != nil {
          message = self._absorb(frame)
        }
      } as error

      if error {
        self._fail(error, CLOSE_PROTOCOL_ERROR)
        return
      }

      if frame == nil {
        break
      }

      if message == nil {
        continue
      }

      if message.is_close() {
        self._link.close()
        return
      }

      if self._on_message != nil {
        self._run(self._on_message, message)
      }
    }

    if self._open and self._conn.peer_finished() {
      self._open = false
      self._link.close()
    }
  }

  /**
   * Says goodbye to the peer, for a server that's shutting down.
   *
   * @internal Called by the connection loop.
   */
  going_away() {
    self.close(CLOSE_GOING_AWAY, nil)
  }

  /**
   * How long the connection can go without hearing from the peer.
   *
   * @internal Called by the connection loop.
   * @returns ?number: seconds, or `nil` for no limit
   */
  idle_timeout() {
    return self.ping_interval == nil ? nil : self.ping_interval * 2
  }

  /**
   * Tells the `on_close()` listener that the connection has gone.
   *
   * @internal Called by the connection loop.
   */
  on_closed() {
    self._open = false

    for timer in self._timers {
      timer.cancel()
    }

    if self._told_closed {
      return
    }

    self._told_closed = true

    if self._on_close != nil {
      var code = self._close_code == nil ? CLOSE_ABNORMAL : self._close_code

      catch {
        self._on_close(code, self._close_reason)
      } as error {
        self._link.report(error)
      }
    }
  }

  # Runs an application callback, closing the socket if it fails.
  _run(callback, argument) {
    if !self._open {
      return
    }

    catch {
      if argument == nil {
        callback()
      } else {
        callback(argument)
      }
    } as error {
      self._fail(error, CLOSE_INTERNAL_ERROR)
    }
  }

  _fail(error, code) {
    self._link.report(error)

    if self._open {
      self.close(code, nil)
    } else {
      self._link.close()
    }
  }

  # Takes the socket back from the loop, for a handler that reads it
  # at its own pace.
  _take_back() {
    self._mode = 'blocking'
    self._conn.block_output()

    # A WebSocket connection is idle for long stretches by design, so
    # the server's request read timeout would close it out from under
    # the application.
    self._conn.set_read_timeout(0)
  }

  # Reads one frame, waiting for as long as it takes. Returns
  # [opcode, final, payload], or nil at a clean end of stream.
  _read_frame() {
    while true {
      var frame = _take_frame(self._conn, self.is_client, self.max_message_size)

      if frame != nil {
        return frame
      }

      if self._conn.fill() == 0 {
        if self._conn.buffered() == 0 {
          return nil
        }

        raise ProtocolError('the connection closed in the middle of a frame')
      }
    }
  }

  # Acts on one frame. Returns a message once one is whole, a close
  # message when the peer starts the closing handshake, and nil
  # otherwise.
  _absorb(frame) {
    var frame_opcode = frame[0]
    var final = frame[1]
    var data = frame[2]

    # A control frame may arrive in the middle of a fragmented message
    # and is handled on its own, without disturbing the message being
    # assembled (RFC 6455 §5.4).
    if frame_opcode >= 8 {
      if !final {
        raise ProtocolError('a control frame may not be fragmented')
      }

      if frame_opcode == OPCODE_PING {
        if self._open {
          self.pong(data)
        }

        return nil
      }

      if frame_opcode == OPCODE_PONG {
        return nil
      }

      if frame_opcode == OPCODE_CLOSE {
        var message = Message(OPCODE_CLOSE, data)
        var code = message.close_code()

        if self._close_code == nil {
          self._close_code = code == nil ? CLOSE_NO_STATUS : code
          self._close_reason = message.close_reason()
        }

        # The handshake is only complete once both sides have sent a
        # close frame, so this endpoint answers before closing.
        if !self._close_sent {
          self._close_sent = true
          catch {
            self._write(OPCODE_CLOSE, data)
          }
        }

        self._open = false

        return message
      }

      raise ProtocolError('unknown control frame opcode ${frame_opcode}')
    }

    if self._opcode == nil {
      if frame_opcode == OPCODE_CONTINUATION {
        raise ProtocolError('a continuation frame with nothing to continue')
      }

      self._opcode = frame_opcode
      self._parts = bytes(0)
    } else if frame_opcode != OPCODE_CONTINUATION {
      raise ProtocolError(
        'a new message began before the previous one finished',
      )
    }

    self._parts.extend(data)
    data.dispose()

    if self._parts.length() > self.max_message_size {
      self.close(CLOSE_TOO_LARGE, 'message too large')
      raise ProtocolError('message exceeds ${self.max_message_size} bytes')
    }

    if !final {
      return nil
    }

    var message = Message(self._opcode, self._parts)

    self._opcode = nil
    self._parts = nil

    return message
  }

  _write(opcode, payload) {
    if !self._open and opcode != OPCODE_CLOSE {
      # The loop tells the application through on_close(), so a message
      # sent after that is dropped, as a browser drops one.
      if self._mode == 'loop' {
        return
      }

      raise ConnectionError('the WebSocket is closed')
    }

    var length = payload.length()

    if opcode >= 8 and length > 125 {
      raise ProtocolError('a control frame may not carry more than 125 bytes')
    }

    var frame = bytes(0)
    frame.append(128 | opcode)

    var mask_bit = self.is_client ? 128 : 0

    if length < 126 {
      frame.append(mask_bit | length)
    } else if length < 65536 {
      frame.append(mask_bit | 126)
      frame.append((length // 256) % 256)
      frame.append(length % 256)
    } else {
      frame.append(mask_bit | 127)

      var remaining = length
      var octets = []

      iter var i = 0; i < 8; i++ {
        octets.insert(remaining % 256, 0)
        remaining = remaining // 256
      }

      for octet in octets {
        frame.append(octet)
      }
    }

    if self.is_client {
      # The mask has to be unpredictable: it is what stops a hostile
      # page from steering a proxy into caching a forged response
      # (RFC 6455 §10.3).
      var key = crypto.random_bytes(4)
      frame.extend(key)

      var masked = payload.clone()
      _unmask(masked, key)
      frame.extend(masked)

      masked.dispose()
      key.dispose()
    } else {
      frame.extend(payload)
    }

    if self._mode == 'loop' {
      self._queue(frame)
    } else {
      self._conn.write(frame)
      self._conn.flush()
    }

    frame.dispose()
  }

  # Queues a frame for the loop to send.
  _queue(frame) {
    if self._link == nil {
      self._conn.write(frame)
      return
    }

    # A peer this far behind has stopped reading, and holding more for
    # it only spends memory.
    if self._conn.queued() + frame.length() > self.max_queued {
      self._open = false
      self._link.abort()
      return
    }

    self._conn.write(frame)
    self._link.wake()
  }

  to_string() {
    return '<WebSocket ${self._open ? "open" : "closed"}>'
  }

  @to_string() {
    return self.to_string()
  }
}

# Takes one frame out of what `connection` has already buffered.
# Returns [opcode, final, payload], or nil while the frame is still
# arriving. The rules that only need the first two bytes are checked as
# soon as those are in, so a frame that breaks them is refused before
# its payload is waited for.
def _take_frame(connection, is_client, limit) {
  var available = connection.buffered()

  if available < 2 {
    return nil
  }

  var first = connection.byte_at(0)
  var second = connection.byte_at(1)
  var final = first & 128 != 0
  var opcode = first & 15
  var masked = second & 128 != 0
  var length = second & 127
  var header = 2

  # No extension was negotiated, so a reserved bit that is set means
  # the peer is speaking something this endpoint did not agree to.
  if first & 112 != 0 {
    raise ProtocolError(
      'a reserved frame bit is set without a negotiated extension',
    )
  }

  if opcode >= 8 and length > 125 {
    raise ProtocolError('a control frame may not carry more than 125 bytes')
  }

  # A server must reject an unmasked frame from a client, and a client
  # must reject a masked frame from a server.
  if is_client == masked {
    raise ProtocolError(
      masked
          ? 'a server may not mask a frame'
          : 'a client must mask every frame',
    )
  }

  if length == 126 {
    if available < 4 {
      return nil
    }

    length = connection.byte_at(2) * 256 + connection.byte_at(3)
    header = 4
  } else if length == 127 {
    if available < 10 {
      return nil
    }

    # The top bit must be zero (RFC 6455 §5.2). The other 63 bits are
    # the length, and anything past 2^53 is beyond what a number can
    # represent exactly anyway.
    if connection.byte_at(2) & 128 != 0 {
      raise ProtocolError('a frame length with its high bit set')
    }

    length = 0

    iter var i = 2; i < 10; i++ {
      length = length * 256 + connection.byte_at(i)
    }

    header = 10
  }

  if length > limit {
    raise ProtocolError('frame of ${length} bytes exceeds the message limit')
  }

  if available < header + (masked ? 4 : 0) + length {
    return nil
  }

  connection.advance(header)

  var key = masked ? connection.read_exactly(4) : nil
  var payload = length > 0 ? connection.read_exactly(length) : bytes(0)

  if key != nil {
    _unmask(payload, key)
    key.dispose()
  }

  return [opcode, final, payload]
}

# Masking is its own inverse, so one routine covers both directions.
def _unmask(payload, key) {
  iter var i = 0; i < payload.length(); i++ {
    payload[i] = payload[i] ^ key[i % 4]
  }
}

/**
 * The value a server must return in `Sec-WebSocket-Accept` for a
 * given client key.
 *
 * @param string key: the client's `Sec-WebSocket-Key`
 * @returns string
 */
def accept_key(key: string) {
  return base64.encode(hash.sha1(key + _GUID, true))
}

/**
 * Whether `request` is a well-formed WebSocket handshake.
 *
 * @param HttpRequest request
 * @returns bool
 */
def is_handshake(request) {
  return request.method == 'GET' and
      request.headers.contains_token('connection', 'upgrade') and
      request.headers.contains_token('upgrade', 'websocket') and
      request.headers.get('sec-websocket-version', '') == '13' and
      request.headers.contains('sec-websocket-key')
}

/**
 * Completes a WebSocket handshake and takes over the connection.
 *
 * Call this from an ordinary route handler. The `101` response is part
 * of the handshake, so the server doesn't write a response of its own
 * on that connection, or anything else apart from the socket's
 * frames.
 *
 * On a server run by `listen()` or `http.serve()`, the server's loop
 * drives the socket once the handler returns. See `WebSocket`.
 *
 * ```zuri
 * server.get('/ws', @(request, response) {
 *   var socket = websocket.accept(request, response)
 *
 *   socket.on_message(@(message) {
 *     socket.send(message.text())
 *   })
 * })
 * ```
 *
 * @param HttpRequest request
 * @param HttpResponse response
 * @param ?dict options: `protocols` (the subprotocols this server
 *    supports, starting with the most preferred), `max_message_size`,
 *    `max_queued`, and `ping_interval` (seconds between pings to an
 *    idle peer)
 * @returns WebSocket
 * @throws HttpError if the request isn't a WebSocket handshake, or
 *    arrived on a connection that can't be taken over
 */
def accept(request, response, options: ?dict) {
  var settings = options == nil ? {} : options

  if request.version != '1.1' {
    # RFC 8441 defines a WebSocket over HTTP/2, through extended
    # CONNECT, which is a different handshake entirely.
    raise HttpError('a WebSocket handshake needs an HTTP/1.1 connection')
  }

  if !is_handshake(request) {
    raise HttpError('this request is not a WebSocket handshake')
  }

  var connection = request.context.get('connection', nil)
  if connection == nil {
    raise HttpError('this request has no connection to take over')
  }

  var key = request.headers.get('sec-websocket-key', '')
  var chosen = nil

  var offered = settings.get('protocols', nil)
  if offered != nil {
    for candidate in request.headers.tokens('sec-websocket-protocol') {
      for supported in offered {
        if supported.lower() == candidate {
          chosen = supported
          break
        }
      }
      if chosen != nil {
        break
      }
    }
  }

  var head = 'HTTP/1.1 101 Switching Protocols\r\n' +
      'Upgrade: websocket\r\n' +
      'Connection: Upgrade\r\n' +
      'Sec-WebSocket-Accept: ${accept_key(key)}\r\n'

  if chosen != nil {
    head += 'Sec-WebSocket-Protocol: ${chosen}\r\n'
  }

  # On a connection a readiness loop holds, this only queues the head,
  # which the loop sends once the handler returns.
  connection.write(head + '\r\n')

  if !connection.is_deferred() {
    connection.flush()

    # A WebSocket connection is idle for long stretches by design, so
    # the server's request read timeout would close it out from under
    # the application.
    connection.set_read_timeout(0)
  }

  response.status = status.SWITCHING_PROTOCOLS
  response.commit()

  var socket = WebSocket(connection, false, chosen)

  socket.max_message_size = settings.get(
    'max_message_size',
    socket.max_message_size,
  )
  socket.max_queued = settings.get('max_queued', socket.max_queued)
  socket.ping_interval = settings.get('ping_interval', nil)

  # What the server finds here tells it the connection is no longer
  # its to answer requests on.
  request.context['driver'] = socket

  return socket
}

/**
 * Opens a WebSocket connection to `target`.
 *
 * @param string target: a `ws://` or `wss://` URL
 * @param ?dict options: `headers` (extra request headers),
 *    `protocols` (subprotocols to offer), `tls_config`,
 *    `connect_timeout`, `max_message_size`
 * @returns WebSocket
 * @throws HttpError if the server does not complete the handshake
 */
def connect(target: string, options: ?dict) {
  var settings = options == nil ? {} : options

  var parsed = url.parse(target)
  var scheme = parsed.scheme == nil ? '' : parsed.scheme.lower()

  if scheme != 'ws' and scheme != 'wss' {
    raise HttpError('a WebSocket URL must be ws: or wss:, got ${scheme}:')
  }

  var secure = scheme == 'wss'
  var port = parsed.port
  if port == nil or port == 0 {
    port = secure ? 443 : 80
  }

  var connection = stream.connect(parsed.host, port, {
    secure,
    tls_config: settings.get('tls_config', nil),
    server_name: parsed.host,
    connect_timeout: settings.get('connect_timeout', 30000),
    read_timeout: settings.get('read_timeout', 0),
    write_timeout: settings.get('write_timeout', 30000),
  })

  var key = base64.encode(crypto.random_bytes(16))
  var path = parsed.path or '/'

  if parsed.query {
    path += '?${parsed.query}'
  }

  var authority = (port == (secure ? 443 : 80))
      ? parsed.host
      : '${parsed.host}:${port}'

  var head = 'GET ${path} HTTP/1.1\r\n' +
      'Host: ${authority}\r\n' +
      'Upgrade: websocket\r\n' +
      'Connection: Upgrade\r\n' +
      'Sec-WebSocket-Key: ${key}\r\n' +
      'Sec-WebSocket-Version: 13\r\n'

  var protocols = settings.get('protocols', nil)
  if protocols != nil and protocols.length() > 0 {
    head += 'Sec-WebSocket-Protocol: ${", ".join(protocols)}\r\n'
  }

  var extra = settings.get('headers', nil)
  if extra != nil {
    var fields = Headers()
    fields.extend(extra)
    head += fields.to_wire()
  }

  connection.write(head + '\r\n')
  connection.flush()

  var status_line = connection.read_line(8192)

  if status_line == nil or !status_line.starts_with('HTTP/1.1 101') {
    connection.close()
    raise HttpError(
      'the server refused the WebSocket upgrade: ${status_line or "no response"}',
    )
  }

  var fields = Headers()

  while true {
    var line = connection.read_line(8192)

    if line == nil {
      connection.close()
      raise HttpError('the handshake response ended early')
    }

    if line.is_empty() {
      break
    }

    var colon = line.index_of(':')
    if colon > 0 {
      fields.add(line[0, colon], line[colon + 1,].trim())
    }
  }

  # Without this check any server that returns 101 could be steered
  # into a WebSocket by a browser that was pointed at it.
  var expected = accept_key(key)
  if !util.secure_equals(fields.get('sec-websocket-accept', ''), expected) {
    connection.close()
    raise HttpError('the server returned the wrong Sec-WebSocket-Accept')
  }

  var socket = WebSocket(
    connection,
    true,
    fields.get('sec-websocket-protocol', nil),
  )

  var limit = settings.get('max_message_size', nil)
  if limit != nil {
    socket.max_message_size = limit
  }

  return socket
}
