#!-- part of the http module

import _http
import ..errors { ProtocolError }

/**
 * @module http.h2.huffman
 *
 * The static Huffman code HPACK uses to compress header field names
 * and values, from RFC 7541 Appendix B.
 */

/**
 * The number of the symbol HPACK uses to pad the final byte of a
 * Huffman-encoded string, and which must never appear as a decoded
 * value.
 *
 * @type int
 */
var EOS = 256

/**
 * The number of bytes that `data` would take up once Huffman-encoded.
 *
 * The encoder uses this to decide whether encoding is worthwhile at
 * all. HPACK allows a string to be sent as it is, and for a string made
 * mostly of high-entropy bytes, the encoded form is the longer one.
 *
 * @param bytes data
 * @returns number
 */
def encoded_length(data) {
  return _http.huffman_encoded_len(data)
}

/**
 * Huffman-encodes `data`, padding the final byte with the leading
 * bits of the EOS code (which are all ones) as RFC 7541 §5.2
 * requires.
 *
 * @param bytes data
 * @returns bytes
 */
def encode(data) {
  return _http.huffman_encode(data)
}

/**
 * Decodes a Huffman-encoded string.
 *
 * The padding at the end must be made of the leading bits of EOS and be
 * no longer than seven bits. Anything else is a connection error, as
 * RFC 7541 §5.2 requires, because that's what an attempt to smuggle in
 * a second header looks like.
 *
 * @param bytes data
 * @param ?number start
 * @param ?number end
 * @returns bytes
 * @throws ProtocolError if the padding is invalid or the string
 *    contains an encoded EOS
 */
def decode(data, start, end) {
  start = start != nil ? start : 0
  end = end != nil ? end : data.length()

  var res = _http.huffman_decode(data, start, end)
  if is_bytes(res) {
    return res
  }

  if res == 1 {
    raise ProtocolError('invalid Huffman code in a header block')
  }

  if res == 2 {
    raise ProtocolError('EOS appears in a Huffman-encoded header')
  }

  raise ProtocolError('invalid Huffman padding in a header block')
}
