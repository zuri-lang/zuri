/**
 * @module http.h2
 *
 * HTTP/2 (RFC 9113) and the header compression it uses (RFC 7541).
 *
 * `HttpServer` uses HTTP/2 automatically, over TLS when ALPN negotiates
 * `h2`, and over plain TCP when a client starts with the HTTP/2
 * connection preface. `HttpClient` uses it when a server negotiates
 * `h2` for an HTTPS connection.
 *
 * The individual parts are available for code that needs them directly,
 * such as a gateway, a test harness or another protocol that uses
 * HPACK.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import @.huffman
import @.hpack
import @.frames
import @.connection { Http2Connection, Http2Stream, Http2Writer }
