/**
 * @module worker
 *
 * The multi-process side of `HttpServer`: a pool of isolates, each
 * accepting and serving connections from the same listening socket.
 *
 * Each worker runs a `ConnectionLoop` over the connections it holds, so
 * a slow client occupies a descriptor and not a thread. This is what
 * `HttpServer` uses when it is configured with more than one worker.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

#!-- part of the http module

import .errors { HttpError }
import .loop { ConnectionLoop }
import .server { HttpServer }

import isolate
import net

# How long a worker waits for one of its own connections to become
# ready before looking for newly accepted ones. Short enough that a
# connection handed over while the worker is busy is picked up
# promptly; long enough that a worker holding idle connections costs
# nothing measurable.
var _POLL_INTERVAL = 10

# How many connections one worker will hold at once. The point of
# polling is that this can be far larger than one; the ceiling is here
# so a single greedy worker cannot take every connection the acceptor
# has and leave its peers idle.
var _MAX_PER_WORKER = 256

# Pool threads asked for on top of the workers themselves, so a server
# is not the only thing that can ever run in its own process.
var _POOL_HEADROOM = 2

/**
 * The loop each worker isolate runs: build a server of its own from
 * `setup`, then serve whatever connections the acceptor hands it.
 *
 * This lives in a module because it names imported ones of its own
 * (`HttpServer`, `net`). A module value cannot be handed to an
 * isolate, but a function belonging to a module is resolved there by
 * name, with its imports resolved again on that side.
 *
 * @param Channel connections: accepted sockets arrive here, and it
 *    closes once nothing more will be accepted
 * @param Channel halt: closed when the server is stopped, at which
 *    point every connection is closed
 * @param function(1) setup: called once with this worker's server
 * @param dict options
 */
def worker_main(connections, halt, setup, options) {
  var instance = HttpServer(
    options.get('port', 8000),
    options.get('host', '127.0.0.1'),
  )

  for name, value in options {
    if hasprop(instance, name) {
      setprop(instance, name, value)
    }
  }

  var cert_chain = options.get('cert_chain', nil)
  var private_key = options.get('private_key', nil)

  if cert_chain != nil {
    instance.use_tls(
      cert_chain,
      private_key or cert_chain,
      options.get('tls', nil),
    )
  }

  instance.stop_with(halt)
  setup(instance)

  var loop = ConnectionLoop(
    instance,
    options.get('max_connections_per_worker', _MAX_PER_WORKER),
  )

  while !halt.is_closed() {
    var taken = _admit_waiting(loop, connections)

    # Nothing being watched and nothing waiting: block until the
    # acceptor has something, so an idle server costs nothing at all
    # rather than spinning on a timeout. A stopped server closes
    # `connections`, which ends the wait.
    if loop.is_empty() {
      if taken == 0 {
        var client = connections.recv()

        if client == nil {
          break
        }

        loop.take(client)
      }

      continue
    }

    loop.turn(_POLL_INTERVAL)
  }

  loop.finish()
  _close_waiting(connections)
}

# Closes every socket still waiting in `connections`, which no worker
# will serve now.
def _close_waiting(connections) {
  var left = connections.try_recv()

  while left != nil {
    catch {
      left.close()
    }

    left = connections.try_recv()
  }
}

# How many connections one worker will take from the channel in a
# single pass. Bounding this ensures connections distribute fairly
# across all worker isolates instead of the first waking worker
# draining the entire channel.
var _MAX_ADMIT_PER_PASS = 1

# Takes on waiting connections for this worker, bounded per pass to
# keep distribution fair across worker isolates. Returns how many it took.
def _admit_waiting(loop, connections) {
  var taken = 0

  while taken < _MAX_ADMIT_PER_PASS and loop.has_room() {
    var client = connections.try_recv()

    if client == nil {
      break
    }

    loop.take(client)
    taken++
  }

  return taken
}

/**
 * Binds a listening socket and serves it across a pool of worker
 * isolates.
 *
 * The calling isolate does nothing but accept, which is cheap; every
 * accepted socket is moved across a channel to whichever worker takes
 * it next. Because isolates share no memory, each worker builds its
 * own routes by calling `setup`.
 *
 * @note Each worker holds an isolate pool thread for as long as the
 *    server runs. `serve()` sizes the pool for that when it is the
 *    first thing in the process to use an isolate; when it is not -
 *    because something already spawned one, fixing the pool's size -
 *    it raises rather than deadlocking behind workers that never
 *    finish. Call `isolate.configure()` yourself, first thing, if the
 *    process needs isolates for anything besides serving.
 *
 * `backlog` is how many accepted-but-unclaimed connections may queue
 * before the acceptor blocks. Bounding it is deliberate: an unbounded
 * queue under load means accepting connections faster than they can
 * be served and answering all of them late, rather than letting the
 * kernel's own listen backlog apply back-pressure.
 *
 * `on_ready` is called once in this isolate with the bound address
 * and a function that stops the server, which is what a signal
 * handler needs in order to shut down cleanly:
 *
 * ```zuri
 * http.serve(app.setup, {
 *   port: 3000,
 *   on_ready: @(address, stop) {
 *     echo 'listening on ${address}'
 *     os.on_signal('INT', @() {
 *       stop()
 *       return true
 *     })
 *   },
 * })
 * ```
 *
 * Stopping the server, with that function or with `close()` on the
 * server a worker was given, stops accepting connections. Every
 * worker then closes the connections it holds, after giving what they
 * have queued a chance to go out, and `serve()` returns. Reaching
 * `max_connections` stops accepting too, but serves the connections
 * already accepted until each of them closes, and `serve()` returns
 * after the last.
 *
 * @param function(1) setup
 * @param ?dict options: `port`, `host`, `workers`, `backlog`,
 *    `on_ready`, `max_connections` (stop after serving that many),
 *    `cert_chain`, `private_key`, plus any `HttpServer` field to
 *    apply to every worker
 * @throws HttpError if the socket cannot be bound
 */
def serve(setup, options: ?dict) {
  if !is_function(setup) and !is_callable(setup) {
    raise TypeError('setup must be a function')
  }

  var settings = options == nil ? {} : options.clone()

  var host = settings.get('host', '127.0.0.1')
  var port = settings.get('port', 8000)
  var workers = settings.get('workers', isolate.cpu_count())
  var backlog = settings.get('backlog', workers * 4)

  if workers < 1 {
    workers = 1
  }

  settings['host'] = host
  settings['port'] = port

  var listener = net.TcpStream()

  catch {
    listener.bind('${host}:${port}')
  } as error

  if error {
    raise HttpError('could not bind ${host}:${port}: ${error.message}')
  }

  # Held back rather than passed along: it belongs to this isolate,
  # closing over the listener it stops and the flag the accept loop
  # reads, neither of which means anything to a worker.
  var on_ready = settings.get('on_ready', nil)
  var max_connections = settings.get('max_connections', nil)

  settings.remove('on_ready')
  settings.remove('max_connections')

  # Each worker occupies an isolate pool thread for the whole life of
  # the server: `worker_main` blocks on the channel and never returns.
  # The pool is a fixed number of threads, so a server sized to the
  # machine's cores claims every one of them, and anything else the
  # application later spawns is queued behind tasks that never finish.
  # That is a deadlock, and it is a silent one.
  #
  # `configure()` is a no-op once the pool exists, so this only takes
  # effect when `serve()` is the first thing to touch it - the usual
  # case for a server process. When it is not, the check below turns
  # what would have been a hang into something that says so.
  catch {
    isolate.configure(workers + _POOL_HEADROOM)
  }

  var available = isolate.pool_size()

  if available < workers {
    raise HttpError(
      'cannot run ${workers} workers: the isolate pool has only ${available} ' +
          'thread(s). Call isolate.configure(${workers + _POOL_HEADROOM}) before ' +
          'anything else uses an isolate, or ask for fewer workers.',
    )
  }

  var connections = isolate.channel(backlog)
  var halt = isolate.channel()
  var pool = []

  iter var i = 0; i < workers; i++ {
    pool.append(isolate.spawn(worker_main, connections, halt, setup, settings))
  }

  var running = [true]
  var acceptor = net.Acceptor(listener)

  if on_ready != nil {
    on_ready(listener.local_address(), @() {
      running[0] = false
      halt.close()
      catch {
        listener.close()
      }
    })
  }

  var served = 0

  catch {
    # A worker's `close()` closes `halt` from that worker's isolate,
    # which this sees within one accept interval.
    while running[0] and !halt.is_closed() {
      var client = acceptor.next()

      # Nothing arrived within the interval. Round again, which is
      # what gives `stop()` and a trapped signal their turn.
      if client == nil {
        continue
      }

      connections.send(client)

      served++
      if max_connections != nil and served >= max_connections {
        running[0] = false
      }
    }
  } as accept_error

  connections.close()

  for task in pool {
    catch {
      task.join()
    }
  }

  _close_waiting(connections)

  catch {
    listener.close()
  }

  # A listener closed by `stop()` makes the accept that follows fail;
  # that is the shutdown path working, not an error to report.
  if accept_error != nil and running[0] and !halt.is_closed() {
    raise accept_error
  }
}
