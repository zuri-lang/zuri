/**
 * @module worker
 *
 * The multi-isolate side of `HttpServer`: a pool of isolates, each one
 * accepting and serving connections from the same listening socket.
 *
 * Each worker runs a `ConnectionLoop` over the connections it holds, so
 * a slow client, an open WebSocket or an event stream doesn't hold up
 * its other connections. What a worker publishes reaches the others
 * through a relay isolate. `HttpServer` uses this when it's
 * configured with more than one worker.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

#!-- part of the http module

import ._relay { relay_main }
import .errors { HttpError }
import .loop { ConnectionLoop }
import .server { HttpServer }

import isolate
import net
import os

# How long a worker waits for one of its own connections to become
# ready before looking for newly accepted ones. Short enough that a
# connection handed over while the worker is busy is picked up
# promptly; long enough that a worker holding idle connections costs
# nothing measurable.
var _POLL_INTERVAL = 10

# How many connections one worker will hold at once. The point of
# polling is that this can be far larger than one; the ceiling is here
# so a single greedy worker cannot take every connection the acceptor
# has and leave its peers idle.
var _MAX_PER_WORKER = 256

# Pool threads asked for on top of the workers themselves, so a server
# is not the only thing that can ever run in its own process.
var _POOL_HEADROOM = 2

/**
 * The loop that each worker isolate runs. It builds its own server
 * using `setup`, and then serves whatever connections the acceptor
 * passes to it.
 *
 * This is in a module because it uses imported modules of its own
 * (`HttpServer` and `net`). A module can't be passed to an isolate, but
 * a function in a module is looked up by name inside the isolate, and
 * its imports are resolved again there.
 *
 * @param Channel connections: accepted sockets arrive here, and the
 *    channel closes once no more connections will be accepted
 * @param Channel halt: closed when the server is stopped, at which
 *    point every connection is closed
 * @param function(1) setup: called once with this worker's server
 * @param dict options
 * @param Channel relay: where this worker's `publish()` sends
 * @param Channel inbox: what the relay passes on to this worker
 * @param Channel ready: told once `setup` has run
 */
def worker_main(connections, halt, setup, options, relay, inbox, ready) {
  var instance = HttpServer(
    options.get('port', 8000),
    options.get('host', '127.0.0.1'),
  )

  for name, value in options {
    if hasprop(instance, name) {
      setprop(instance, name, value)
    }
  }

  var cert_chain = options.get('cert_chain', nil)
  var private_key = options.get('private_key', nil)

  if cert_chain != nil {
    instance.use_tls(
      cert_chain,
      private_key or cert_chain,
      options.get('tls', nil),
    )
  }

  instance.stop_with(halt)
  instance.relay_through(relay, inbox)
  setup(instance)

  var loop = ConnectionLoop(
    instance,
    options.get('max_connections_per_worker', _MAX_PER_WORKER),
  )

  ready.send(true)

  while !halt.is_closed() {
    var taken = _admit_waiting(loop, connections)

    # Nothing being watched and nothing waiting: block until the
    # acceptor has something, so an idle server costs nothing at all
    # rather than spinning on a timeout. Published messages are still
    # delivered meanwhile. A stopped server closes `connections`,
    # which ends the wait.
    if loop.is_empty() {
      if taken == 0 {
        var client = _await_connection(instance, connections, inbox)

        if client == nil {
          break
        }

        loop.take(client)
      }

      continue
    }

    loop.turn(_POLL_INTERVAL)
  }

  loop.finish()
  _close_waiting(connections)
}

# Waits for the next accepted socket, delivering whatever is published
# in the meantime. Returns nil once no more sockets are coming.
def _await_connection(server, connections, inbox) {
  # A server with no subscribers has nothing to deliver, and `recv()`
  # wakes a single worker for each socket, where `select()` wakes every
  # idle one. What collects in its inbox meanwhile is cleared once it
  # has connections again.
  var listening = server.has_subscribers()

  while true {
    if !listening {
      return connections.recv()
    }

    # The connections channel comes first, so it wins when both have
    # something.
    var picked = isolate.select([connections, inbox])

    if picked[0] == connections {
      return picked[1]
    }

    if picked[1] == nil {
      listening = false
    } else {
      server.deliver(picked[1])
    }
  }
}

# How often `serve()` checks on its workers while they start up, in
# seconds.
var _START_INTERVAL = 0.01

# Waits until every worker in `pool` has run `setup`. A worker whose
# `setup` raised an error has finished with it, and `try_join()` raises
# it here, with the worker's own stack trace.
def _await_workers(pool, ready) {
  var started = 0

  while started < pool.length() {
    if ready.try_recv() != nil {
      started++
      continue
    }

    for task in pool {
      if task.is_done() {
        task.try_join()
      }
    }

    os.sleep(_START_INTERVAL)
  }
}

# Closes every socket still waiting in `connections`, which no worker
# will serve now.
def _close_waiting(connections) {
  var left = connections.try_recv()

  while left != nil {
    catch {
      left.close()
    }

    left = connections.try_recv()
  }
}

# How many connections one worker will take from the channel in a
# single pass. Bounding this ensures connections distribute fairly
# across all worker isolates instead of the first waking worker
# draining the entire channel.
var _MAX_ADMIT_PER_PASS = 1

# Takes on waiting connections for this worker, bounded per pass to
# keep distribution fair across worker isolates. Returns how many it took.
def _admit_waiting(loop, connections) {
  var taken = 0

  while taken < _MAX_ADMIT_PER_PASS and loop.has_room() {
    var client = connections.try_recv()

    if client == nil {
      break
    }

    loop.take(client)
    taken++
  }

  return taken
}

/**
 * Binds a listening socket and serves it using a pool of worker
 * isolates.
 *
 * The calling isolate only accepts connections, which is cheap. Each
 * accepted socket is moved over a channel to whichever worker takes it
 * next. Isolates don't share memory, so each worker sets up its own
 * routes by calling `setup`.
 *
 * @note Each worker uses a thread from the isolate pool for as long as
 *    the server runs, and so does one more isolate, which passes what
 *    `HttpServer.publish()` sends on to every worker. If `serve()` is
 *    the first thing in the process to use an isolate, it sizes the
 *    pool accordingly. Otherwise, the pool's size is already fixed,
 *    because something else has already spawned an isolate, so
 *    `serve()` raises an error instead of deadlocking behind workers
 *    that never finish. If the process needs isolates for anything
 *    other than serving, call `isolate.configure()` yourself, at the
 *    very start.
 *
 * `backlog` is the number of accepted connections that can wait to be
 * claimed before the acceptor blocks. The limit is intentional. With an
 * unlimited queue, a server under load would accept connections faster
 * than it could serve them and then answer all of them late, instead of
 * letting the kernel's own listen backlog apply backpressure.
 *
 * The socket is bound first, so a port that's already in use fails at
 * once. Connections aren't accepted until every worker has run `setup`,
 * and any that arrive before then wait in the listen backlog. If
 * `setup` raises an error in a worker, `serve()` stops the other
 * workers and raises it.
 *
 * `on_ready` is called once on this isolate, after every worker has run
 * `setup`, with the bound address and a function that stops the
 * server. A signal handler can call that function to shut down
 * cleanly:
 *
 * ```zuri
 * http.serve(app.setup, {
 *   port: 3000,
 *   on_ready: @(address, stop) {
 *     echo 'listening on ${address}'
 *     os.on_signal('INT', @() {
 *       stop()
 *       return true
 *     })
 *   },
 * })
 * ```
 *
 * Stopping the server, either with that function or by calling
 * `close()` on the server a worker was given, stops it from accepting
 * connections. Each worker then closes its connections, after giving
 * any queued data a chance to be sent, and `serve()` returns. Reaching
 * `max_connections` also stops the server from accepting connections,
 * but the connections already accepted are served until each one
 * closes, and `serve()` returns after the last one.
 *
 * @param function(1) setup
 * @param ?dict options: `port`, `host`, `workers`, `backlog`,
 *    `on_ready`, `max_connections` (stop after serving that many),
 *    `cert_chain`, `private_key`, and any `HttpServer` field to apply
 *    to every worker
 * @throws HttpError if the socket can't be bound
 * @throws IsolateError if `setup` raises an error in a worker, with the
 *    worker's own stack trace
 */
def serve(setup, options: ?dict) {
  if !is_function(setup) and !is_callable(setup) {
    raise TypeError('setup must be a function')
  }

  var settings = options == nil ? {} : options.clone()

  var host = settings.get('host', '127.0.0.1')
  var port = settings.get('port', 8000)
  var workers = settings.get('workers', isolate.cpu_count())
  var backlog = settings.get('backlog', workers * 4)

  if workers < 1 {
    workers = 1
  }

  settings['host'] = host
  settings['port'] = port

  var listener = net.TcpStream()

  catch {
    listener.bind('${host}:${port}')
  } as error

  if error {
    raise HttpError('could not bind ${host}:${port}: ${error.message}')
  }

  # Held back rather than passed along: it belongs to this isolate,
  # closing over the listener it stops and the flag the accept loop
  # reads, neither of which means anything to a worker.
  var on_ready = settings.get('on_ready', nil)
  var max_connections = settings.get('max_connections', nil)

  settings.remove('on_ready')
  settings.remove('max_connections')

  # Each worker occupies an isolate pool thread for the whole life of
  # the server: `worker_main` blocks on the channel and never returns.
  # So does the relay that passes published messages between them.
  # The pool is a fixed number of threads, so a server sized to the
  # machine's cores claims every one of them, and anything else the
  # application later spawns is queued behind tasks that never finish.
  # That is a deadlock, and it is a silent one.
  #
  # `configure()` is a no-op once the pool exists, so this only takes
  # effect when `serve()` is the first thing to touch it - the usual
  # case for a server process. When it is not, the check below turns
  # what would have been a hang into something that says so.
  var threads = workers + 1

  catch {
    isolate.configure(threads + _POOL_HEADROOM)
  }

  var available = isolate.pool_size()

  if available < threads {
    raise HttpError(
      'cannot run ${workers} workers: with the relay between them they need ' +
          '${threads} isolate pool threads, and the pool has only ${available}. ' +
          'Call isolate.configure(${threads + _POOL_HEADROOM}) before anything ' +
          'else uses an isolate, or ask for fewer workers.',
    )
  }

  var connections = isolate.channel(backlog)
  var halt = isolate.channel()
  var relay = isolate.channel()
  var ready = isolate.channel()
  var inboxes = []
  var pool = []

  iter var i = 0; i < workers; i++ {
    inboxes.append(isolate.channel())
  }

  iter var i = 0; i < workers; i++ {
    pool.append(
      isolate.spawn(
        worker_main,
        connections,
        halt,
        setup,
        settings,
        relay,
        inboxes[i],
        ready,
      ),
    )
  }

  # Started after the workers, so it never stands in their way while
  # they start up.
  var relaying = isolate.spawn(relay_main, relay, inboxes)

  # Nothing is accepted, and `on_ready` isn't called, until every worker
  # has run `setup`. Connections that arrive in the meantime wait in the
  # listen backlog, and are then shared out among all the workers.
  catch {
    _await_workers(pool, ready)
  } as failure

  if failure {
    halt.close()
    connections.close()

    for task in pool {
      catch {
        task.join()
      }
    }

    relay.close()

    catch {
      relaying.join()
    }

    catch {
      listener.close()
    }

    raise failure
  }

  var running = [true]
  var acceptor = net.Acceptor(listener)

  if on_ready != nil {
    on_ready(listener.local_address(), @() {
      running[0] = false
      halt.close()
      catch {
        listener.close()
      }
    })
  }

  var served = 0

  catch {
    # A worker's `close()` closes `halt` from that worker's isolate,
    # which this sees within one accept interval.
    while running[0] and !halt.is_closed() {
      var client = acceptor.next()

      # Nothing arrived within the interval. Round again, which is
      # what gives `stop()` and a trapped signal their turn.
      if client == nil {
        continue
      }

      connections.send(client)

      served++
      if max_connections != nil and served >= max_connections {
        running[0] = false
      }
    }
  } as accept_error

  connections.close()

  for task in pool {
    catch {
      task.join()
    }
  }

  _close_waiting(connections)

  # Every worker has finished, so nothing more will be published.
  relay.close()

  catch {
    relaying.join()
  }

  catch {
    listener.close()
  }

  # A listener closed by `stop()` makes the accept that follows fail;
  # that is the shutdown path working, not an error to report.
  if accept_error != nil and running[0] and !halt.is_closed() {
    raise accept_error
  }
}
