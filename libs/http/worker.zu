/**
 * @module worker
 *
 * The multi-process side of `HttpServer`: a pool of isolates, each
 * accepting and serving connections from the same listening socket.
 *
 * Each worker polls the connections it holds rather than blocking on
 * one, so a slow client occupies a descriptor and not a thread. This is
 * what `HttpServer` uses when it is configured with more than one
 * worker.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

#!-- part of the http module

import .errors { HttpError }
import .server { HttpServer }

import isolate
import net

# How long a worker waits for one of its own connections to become
# ready before looking for newly accepted ones. Short enough that a
# connection handed over while the worker is busy is picked up
# promptly; long enough that a worker holding idle connections costs
# nothing measurable.
var _POLL_INTERVAL = 10

# How many connections one worker will hold at once. The point of
# polling is that this can be far larger than one; the ceiling is here
# so a single greedy worker cannot take every connection the acceptor
# has and leave its peers idle.
var _MAX_PER_WORKER = 256

# Pool threads asked for on top of the workers themselves, so a server
# is not the only thing that can ever run in its own process.
var _POOL_HEADROOM = 2

/**
 * The loop each worker isolate runs: build a server of its own from
 * `setup`, then serve whatever connections the acceptor hands it.
 *
 * This lives in a module rather than in a closure because that is
 * what can cross an isolate boundary - a spawned isolate resolves a
 * function by module binding, and a closure that captured an imported
 * module namespace cannot be transferred at all.
 *
 * @param Channel connections: accepted sockets arrive here
 * @param function(1) setup: called once with this worker's server
 * @param dict options
 */
def worker_main(connections, setup, options) {
  var instance = HttpServer(
    options.get('port', 8000),
    options.get('host', '127.0.0.1')
  )

  for name, value in options {
    if hasprop(instance, name) {
      setprop(instance, name, value)
    }
  }

  var cert_chain = options.get('cert_chain', nil)
  var private_key = options.get('private_key', nil)

  if cert_chain != nil {
    instance.use_tls(cert_chain, private_key or cert_chain, options.get('tls', nil))
  }

  setup(instance)

  var state = {
    instance,
    poller: net.Poller(),
    live: {},
    next_token: 1,
    limit: options.get('max_connections_per_worker', _MAX_PER_WORKER),
  }

  while true {
    var taken = _admit_waiting(state, connections)

    # Nothing being watched and nothing waiting: block until the
    # acceptor has something, so an idle server costs nothing at all
    # rather than spinning on a timeout.
    if state.live.is_empty() {
      if taken == 0 {
        var client = connections.recv()

        if client == nil {
          break
        }

        _admit(state, client)
      }

      continue
    }

    if connections.is_closed() and taken == 0 {
      # The acceptor has gone; finish what is still open, then stop.
      if _drain(state) {
        break
      }
    }

    # A request can already be sitting in a connection's own read
    # buffer where poll() cannot see it: the protocol probe at
    # admission reads the first bytes to tell HTTP/2 from HTTP/1.1, and
    # a pipelined request arrives alongside the one before it. Waiting
    # for readability on those would stall until the peer happened to
    # send something else.
    var buffered = _service_buffered(state)

    for event in state.poller.wait(buffered ? 0 : _POLL_INTERVAL) {
      var token = event[0]

      # A socket that can no longer supply a descriptor - closed, or
      # moved elsewhere - is reported rather than polled. Either way
      # there is nothing left to serve on it.
      if event[1] & net.ERROR != 0 {
        _close(state, token)
        continue
      }

      _service(state, token)
    }

    _reap_idle(state)
  }

  # Whatever is still open when the loop ends is still owed a close.
  for token in state.live.keys() {
    _close(state, token)
  }
}

# Takes on as many waiting connections as this worker has room for,
# without ever blocking. Returns how many it took.
def _admit_waiting(state, connections) {
  var taken = 0

  while state.live.length() < state.limit {
    var client = connections.try_recv()

    if client == nil {
      break
    }

    _admit(state, client)
    taken++
  }

  return taken
}

# Brings one accepted socket under this worker's poller, or serves it
# to completion right here when it turns out not to be HTTP/1.1.
def _admit(state, client) {
  var connection = state.instance.accept_connection(client)

  if connection == nil {
    return
  }

  # An HTTP/2 connection is already multiplexed internally, so it is
  # served to completion in place rather than interleaved with the
  # HTTP/1.1 connections around it.
  if state.instance.is_http2_connection(connection) {
    catch {
      state.instance.serve_http2(connection)
    } as error

    if error {
      state.instance.report_error(error, connection)
    }

    state.instance.finish_connection(connection)

    return
  }

  var token = state.next_token
  state.next_token = token + 1

  state.live[token] = [connection, 0, time()]
  state.poller.add(connection.transport(), token, net.READABLE)
}

# Serves every connection that already has bytes in hand, and reports
# whether any did - in which case the poll that follows should not
# sleep, since there may be more work waiting behind it.
def _service_buffered(state) {
  var pending = []

  for token, entry in state.live {
    if entry[0].buffered() > 0 {
      pending.append(token)
    }
  }

  for token in pending {
    _service(state, token)
  }

  return pending.length() > 0
}

# Answers whatever this connection has to ask, and keeps answering for
# as long as the next request is already in hand: a pipelined request
# sits in our own buffer, where the poller cannot see it, so waiting
# for readability again would stall it until the peer sent something
# else.
def _service(state, token) {
  var entry = state.live.get(token, nil)

  if entry == nil {
    return
  }

  var connection = entry[0]

  while true {
    var keep = false

    catch {
      keep = state.instance.serve_next(connection, entry[1])
    } as error

    if error {
      state.instance.report_error(error, connection)
      keep = false
    }

    if !keep {
      _close(state, token)
      return
    }

    entry[1] = entry[1] + 1
    entry[2] = time()

    if connection.buffered() == 0 {
      return
    }
  }
}

# Closes an idle connection rather than letting it hold a slot for the
# rest of the server's life. The poller reports nothing for a peer that
# has simply gone quiet, so this is the only thing that notices.
def _reap_idle(state) {
  var deadline = state.instance.keep_alive_timeout / 1000
  var now = time()
  var expired = []

  for token, entry in state.live {
    if now - entry[2] > deadline {
      expired.append(token)
    }
  }

  for token in expired {
    _close(state, token)
  }
}

def _close(state, token) {
  var entry = state.live.get(token, nil)

  if entry == nil {
    return
  }

  state.poller.remove(token)
  state.live.remove(token)
  state.instance.finish_connection(entry[0])
}

# Serves out whatever is still open once the acceptor has stopped,
# returning true when there is nothing left to wait for.
def _drain(state) {
  return state.live.is_empty()
}

/**
 * Binds a listening socket and serves it across a pool of worker
 * isolates.
 *
 * The calling isolate does nothing but accept, which is cheap; every
 * accepted socket is moved across a channel to whichever worker takes
 * it next. Because isolates share no memory, each worker builds its
 * own routes by calling `setup` - which is why `setup` has to be a
 * module-level function rather than a closure.
 *
 * @note Each worker holds an isolate pool thread for as long as the
 *    server runs. `serve()` sizes the pool for that when it is the
 *    first thing in the process to use an isolate; when it is not -
 *    because something already spawned one, fixing the pool's size -
 *    it raises rather than deadlocking behind workers that never
 *    finish. Call `isolate.configure()` yourself, first thing, if the
 *    process needs isolates for anything besides serving.
 *
 * `backlog` is how many accepted-but-unclaimed connections may queue
 * before the acceptor blocks. Bounding it is deliberate: an unbounded
 * queue under load means accepting connections faster than they can
 * be served and answering all of them late, rather than letting the
 * kernel's own listen backlog apply back-pressure.
 *
 * `on_ready` is called once in this isolate with the bound address
 * and a function that stops the server, which is what a signal
 * handler needs in order to shut down cleanly:
 *
 * ```zuri
 * http.serve(app.setup, {
 *   port: 3000,
 *   on_ready: @(address, stop) {
 *     echo 'listening on ${address}'
 *     os.on_signal('INT', @() {
 *       stop()
 *       return true
 *     })
 *   },
 * })
 * ```
 *
 * @param function(1) setup
 * @param ?dict options: `port`, `host`, `workers`, `backlog`,
 *    `on_ready`, `max_connections` (stop after serving that many),
 *    `cert_chain`, `private_key`, plus any `HttpServer` field to
 *    apply to every worker
 * @throws HttpError if the socket cannot be bound
 */
def serve(setup, options: ?dict) {
  if !is_function(setup) and !is_callable(setup) {
    raise TypeError('setup must be a function defined in a module')
  }

  var settings = options == nil ? {} : options.clone()

  var host = settings.get('host', '127.0.0.1')
  var port = settings.get('port', 8000)
  var workers = settings.get('workers', isolate.cpu_count())
  var backlog = settings.get('backlog', workers * 4)

  if workers < 1 {
    workers = 1
  }

  settings['host'] = host
  settings['port'] = port

  var listener = net.TcpStream()

  catch {
    listener.bind('${host}:${port}')
  } as error

  if error {
    raise HttpError('could not bind ${host}:${port}: ${error.message}')
  }

  # Held back rather than passed along: it is a callback for this
  # isolate, and a closure that captured an imported module cannot
  # cross the boundary at all.
  var on_ready = settings.get('on_ready', nil)
  var max_connections = settings.get('max_connections', nil)

  settings.remove('on_ready')
  settings.remove('max_connections')

  # Each worker occupies an isolate pool thread for the whole life of
  # the server: `worker_main` blocks on the channel and never returns.
  # The pool is a fixed number of threads, so a server sized to the
  # machine's cores claims every one of them, and anything else the
  # application later spawns is queued behind tasks that never finish.
  # That is a deadlock, and it is a silent one.
  #
  # `configure()` is a no-op once the pool exists, so this only takes
  # effect when `serve()` is the first thing to touch it - the usual
  # case for a server process. When it is not, the check below turns
  # what would have been a hang into something that says so.
  catch {
    isolate.configure(workers + _POOL_HEADROOM)
  }

  var available = isolate.pool_size()

  if available < workers {
    raise HttpError(
      'cannot run ${workers} workers: the isolate pool has only ${available} ' +
      'thread(s). Call isolate.configure(${workers + _POOL_HEADROOM}) before ' +
      'anything else uses an isolate, or ask for fewer workers.'
    )
  }

  var connections = isolate.channel(backlog)
  var pool = []

  iter var i = 0; i < workers; i++ {
    pool.append(isolate.spawn(worker_main, connections, setup, settings))
  }

  var running = [true]

  if on_ready != nil {
    # Closing the listener is what breaks the blocking accept below;
    # there is no other way to interrupt it.
    on_ready(listener.local_address(), @() {
      running[0] = false
      catch {
        listener.close()
      }
    })
  }

  var served = 0

  catch {
    while running[0] {
      var client = listener.accept()
      connections.send(client)

      served++
      if max_connections != nil and served >= max_connections {
        running[0] = false
      }
    }
  } as accept_error

  connections.close()

  for task in pool {
    catch {
      task.join()
    }
  }

  catch {
    listener.close()
  }

  # A listener closed by `stop()` makes the pending accept fail; that
  # is the shutdown path working, not an error to report.
  if accept_error != nil and running[0] {
    raise accept_error
  }
}
