/**
 * @module stream
 *
 * The transport underneath everything else: a byte stream with buffering,
 * timeouts and optional TLS.
 *
 * `Connection` is what both the client and the server read and write
 * through, so the protocol layers above never have to know whether they
 * are talking over TCP or over TLS.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

#!-- part of the http module

import .errors { ConnectionError, ProtocolError, TimeoutError, TooLargeError }

import _http
import net
import net.tls

# The default amount asked of the transport per underlying read. Large
# enough that a whole small response usually arrives in one call, small
# enough that a connection sitting idle in a pool isn't holding on to
# much.
var _READ_CHUNK = 65536

# Once this many bytes at the front of the read buffer have been
# consumed, the buffer is compacted. Doing it on every read would copy
# constantly; never doing it would grow the buffer without bound on a
# long-lived keep-alive connection.
var _COMPACT_THRESHOLD = 32768

# Writes are gathered here and handed to the transport in one call.
# Every small `write()` reaching the socket on its own would be a
# syscall per header line, and on TLS a record per header line.
var _WRITE_HIGH_WATER = 65536

# How much of a file is moved per read while a socket has room for it.
var _FEED_CHUNK = 262144

# The messages the platform produces when a read or write hits its
# configured timeout. Errors cross the native boundary as plain
# strings, so this is the only way to tell "nothing arrived in time"
# from "the connection broke".
var _TIMEOUT_MARKERS = [
  'timed out',
  'temporarily unavailable',
  'would block',
  'operation timed out',
]

/**
 * Whether a transport error message describes a timeout (or a
 * would-block, which a socket with a receive timeout reports as the
 * same condition) rather than a genuine failure.
 *
 * @param string message
 * @returns bool
 */
def is_timeout_error(message) {
  if !is_string(message) {
    return false
  }

  var lower = message.lower()
  for marker in _TIMEOUT_MARKERS {
    if lower.contains(marker) {
      return true
    }
  }

  return false
}

/**
 * Part of a file, handed over a piece at a time so a response can go
 * out as the socket makes room for it instead of all at once.
 */
class FileFeed {

  var _handle
  var _remaining = 0

  /**
   * @param string path
   * @param number offset
   * @param number length
   */
  @new(path, offset, length) {
    self._handle = file(path, 'rb')

    # A file has to actually be open before it can be seeked; reads
    # open it lazily, but a seek before the first read does not.
    self._handle.open()

    if offset > 0 {
      self._handle.seek(offset, 0)
    }

    self._remaining = length
  }

  /**
   * The next piece, of at most `limit` bytes.
   *
   * @param number limit
   * @returns ?bytes: `nil` once there is nothing more
   */
  next(limit) {
    if self._remaining <= 0 {
      return nil
    }

    var want = limit < self._remaining ? limit : self._remaining
    var chunk = self._handle.read(want)

    if chunk == nil or chunk.length() == 0 {
      self._remaining = 0
      return nil
    }

    self._remaining -= chunk.length()

    return chunk
  }

  /**
   * Whether the last piece has been handed over.
   *
   * @returns bool
   */
  is_done() {
    return self._remaining <= 0
  }

  /**
   * Releases the file.
   */
  close() {
    self._handle.close()
  }
}

/**
 * A body already in memory, with the same shape as `FileFeed`.
 */
class BytesFeed {

  var _data
  var _at = 0

  /**
   * @param bytes data
   */
  @new(data) {
    self._data = data
    self._at = 0
  }

  /**
   * The next piece, of at most `limit` bytes.
   *
   * @param number limit
   * @returns ?bytes: `nil` once there is nothing more
   */
  next(limit) {
    var total = self._data.length()

    if self._at >= total {
      return nil
    }

    var end = self._at + limit < total ? self._at + limit : total
    var piece = self._data[self._at, end]

    self._at = end

    return piece
  }

  /**
   * Whether the last piece has been handed over.
   *
   * @returns bool
   */
  is_done() {
    return self._at >= self._data.length()
  }

  /**
   * Here for parity with `FileFeed`. There is nothing to release.
   */
  close() {
  }
}

/**
 * A buffered, message-oriented view of a connected socket.
 *
 * HTTP/1.1 is parsed a line at a time and then a body at a time, and
 * HTTP/2 a frame at a time; both want to read a few bytes without
 * paying for a syscall each time, and to write a head made of many
 * small pieces as one write. `Connection` sits between the protocol
 * code and either a plain `net.TcpStream` or a `net.tls.TlsStream`
 * and provides exactly that, plus the peer information the transports
 * stop reporting once TLS has consumed the underlying socket.
 *
 * Instances are created by `connect()` and `accept()` below, or by
 * `from_transport()` when the socket already exists.
 *
 * @printable
 */
class Connection {

  /**
   * The remote peer's address, captured before any TLS wrap consumed
   * the underlying socket.
   * @type ?SocketAddr
   */
  var peer_address

  /**
   * This side's address.
   * @type ?SocketAddr
   */
  var local_address

  /**
   * Whether the connection is TLS-protected.
   * @type bool
   */
  var secure = false

  /**
   * The ALPN protocol negotiated during the TLS handshake (`'h2'`,
   * `'http/1.1'`), or `nil` on a plaintext connection or when no
   * protocol was agreed.
   * @type ?string
   */
  var alpn

  var _transport
  var _buf
  var _pos = 0
  var _peer_text
  var _out
  var _out_at = 0
  var _deferred = false
  var _feed
  var _closed = false
  var _eof = false

  # Every byte ever pulled off the transport. A caller that needs to
  # know whether a peer said anything at all - a client deciding
  # whether a failed request could safely be sent again - can compare
  # this before and after.
  var _total_read = 0

  /**
   * Wraps an already-connected transport.
   *
   * @param {TcpStream|TlsStream} transport
   * @param ?SocketAddr peer: the peer address, which a `TlsStream`
   *    can no longer report on its own
   * @param ?SocketAddr local
   */
  @new(transport, peer, local, read_timeout: ?number) {
    self._transport = transport
    self._buf = bytes(0)
    self._out = bytes(0)
    self._out_at = 0
    self._deferred = false
    self._pos = 0
    self._closed = false
    self._eof = false
    self._total_read = 0
    self._read_timeout = read_timeout

    self.peer_address = peer
    self.local_address = local
    self.secure = instance_of(transport, tls.TlsStream)
    self.alpn = self.secure ? transport.alpn_protocol() : nil
  }

  /**
   * The peer's address as text, worked out once rather than for every
   * request on the connection.
   *
   * @returns ?string
   */
  peer_text() {
    if self._peer_text == nil and self.peer_address != nil {
      self._peer_text = self.peer_address.to_string()
    }

    return self._peer_text
  }

  /**
   * The underlying `TcpStream` or `TlsStream`. Needed by the
   * protocol upgrade paths (WebSocket, HTTP/2) that take a connection
   * over wholesale.
   *
   * @returns {TcpStream|TlsStream}
   */
  transport() {
    return self._transport
  }

  /**
   * The peer's certificate on a TLS connection, or `nil` on a
   * plaintext one or when the peer presented none.
   *
   * @returns ?PeerCertificate
   */
  peer_certificate() {
    if !self.secure {
      return nil
    }
    return self._transport.peer_certificate()
  }

  /**
   * How many bytes are already buffered and available without
   * touching the socket.
   *
   * @returns number
   */
  buffered() {
    return self._buf.length() - self._pos
  }

  /**
   * How many bytes have been read off the transport over this
   * connection's whole life.
   *
   * @returns number
   */
  bytes_read() {
    return self._total_read
  }

  /**
   * Whether the peer has closed its side and the buffer is drained.
   *
   * @returns bool
   */
  is_eof() {
    return self._eof and self.buffered() == 0
  }

  /**
   * Whether `close()` has been called on this connection.
   *
   * @returns bool
   */
  is_closed() {
    return self._closed
  }

  # Drops what has already been consumed before the buffer grows, so a
  # connection serving thousands of keep-alive requests doesn't
  # accumulate every byte it ever read.
  _compact() {
    if self._pos == self._buf.length() {
      self._buf.dispose()
      self._pos = 0
    } else if self._pos >= _COMPACT_THRESHOLD {
      var rest = self._buf[self._pos,]
      self._buf.dispose()
      self._buf = rest
      self._pos = 0
    }
  }

  # Adds one chunk from the transport to the read buffer. Returns the
  # number of bytes added; 0 means the peer closed its write half.
  _take_chunk(chunk) {
    if chunk.length() == 0 {
      self._eof = true
      return 0
    }

    self._buf.extend(chunk)
    var count = chunk.length()
    chunk.dispose()

    self._total_read += count

    return count
  }

  # Pulls one chunk from the transport into the read buffer. Returns
  # the number of bytes added; 0 means the peer closed its write half.
  _fill() {
    if self._eof {
      return 0
    }

    self._compact()

    return self._take_chunk(self._read_transport_chunk())
  }

  /**
   * Pulls in what has arrived, without waiting for more. This is what
   * a readiness loop calls instead of any of the reads below, none of
   * which it can afford, since each of them waits.
   *
   * A connection that fails counts as one that closed: there is
   * nothing more to read either way, and what was already read can
   * still be answered.
   *
   * @returns ?number: the bytes added, `0` when the peer has closed
   *    its write half, or `nil` when nothing has arrived
   */
  fill_ready() {
    if self._eof {
      return 0
    }

    self._compact()

    var chunk = self._read_ready_chunk()

    if chunk == nil {
      return nil
    }

    return self._take_chunk(chunk)
  }

  _read_ready_chunk() {
    catch {
      return self._transport.try_read(_READ_CHUNK)
    } as error {
      return bytes(0)
    }
  }

  /**
   * Whether the peer has closed its write half, whatever is still
   * buffered.
   *
   * @returns bool
   */
  peer_finished() {
    return self._eof
  }

  /**
   * The unread byte at `offset`, without consuming anything.
   *
   * @param number offset
   * @returns number
   */
  byte_at(offset) {
    return self._buf[self._pos + offset]
  }

  /**
   * Where `value` next appears among the unread bytes, counted from
   * the first of them, without consuming anything.
   *
   * @param number value
   * @param number offset: where to start looking
   * @returns number: `-1` when it is not there
   */
  find_byte(value, offset) {
    var at = self._buf.index_of(value, self._pos + offset)
    return at < 0 ? -1 : at - self._pos
  }

  /**
   * The unread bytes between two offsets as a string, without
   * consuming anything.
   *
   * @param number from
   * @param number to
   * @returns string
   */
  text_between(from, to) {
    var part = self._buf[self._pos + from, self._pos + to]
    var text = part.to_string()
    part.dispose()

    return text
  }

  /**
   * Reads one CRLF-terminated line and returns it as a string with
   * the terminator removed.
   *
   * A bare LF is accepted as a line terminator as well. RFC 9112
   * §2.2 permits a recipient to do so, and enough real clients send
   * one that refusing would break them; a bare CR, on the other hand,
   * is left in the data where it belongs.
   *
   * @param ?number limit: the longest line to tolerate, in bytes;
   *    defaults to 8192
   * @returns ?string: the line, or `nil` at a clean EOF before any
   *    bytes of a line arrived
   * @throws TooLargeError if the line exceeds `limit`
   * @throws ProtocolError if EOF arrives mid-line
   * @throws TimeoutError, ConnectionError
   */
  read_line(limit) {
    if limit == nil {
      limit = 8192
    }

    # Counted from the first unread byte rather than from an absolute
    # buffer offset, because _fill() compacts the buffer and moves
    # every absolute position out from under us.
    var scanned = 0

    while true {
      var lf = self._buf.index_of(10, self._pos + scanned)

      if lf > -1 {
        var end = lf
        if end > self._pos and self._buf[end - 1] == 13 {
          end--
        }

        var line = self._buf[self._pos, end]
        var text = line.to_string()
        line.dispose()

        self._pos = lf + 1
        return text
      }

      scanned = self.buffered()

      if scanned > limit {
        raise TooLargeError('line exceeds the ${limit} byte limit')
      }

      if self._fill() == 0 {
        if self.buffered() == 0 {
          return nil
        }
        raise ProtocolError('connection closed in the middle of a line')
      }
    }
  }

  /**
   * Advances the buffer read position by `count` bytes, dropping what was
   * consumed.
   *
   * @param number count
   */
  advance(count: number) {
    self._pos += count
  }

  /**
   * Parses a request head out of what is already buffered, without
   * reading anything. The head stays in the buffer until `advance()`
   * is given its size.
   *
   * @param number max_line
   * @param number max_header_size
   * @param number max_header_count
   * @returns ?list: `nil` while the head is incomplete, otherwise what
   *    `read_request_head()` returns
   */
  try_request_head(max_line, max_header_size, max_header_count) {
    if self._buf.length() <= self._pos {
      return nil
    }

    return _http.parse_request_head(
      self._buf,
      self._pos,
      max_line,
      max_header_size,
      max_header_count,
    )
  }

  /**
   * Reads and parses an HTTP/1.x request head using native Rust parsing.
   *
   * @param number max_line
   * @param number max_header_size
   * @param number max_header_count
   * @param ?number header_timeout
   * @returns ?list: `nil` on clean EOF, error list `['error', msg]`,
   *    or `[method, target, version, fields, size, consumed, authority, cookie]`
   */
  read_request_head(
    max_line, max_header_size, max_header_count, header_timeout,
  ) {
    self._compact()

    var deadline
    var started = false

    while true {
      if self._buf.length() > self._pos {
        var parsed = _http.parse_request_head(
          self._buf,
          self._pos,
          max_line,
          max_header_size,
          max_header_count,
        )

        if parsed != nil {
          return parsed
        }
      }

      if !started and self.buffered() > 0 {
        started = true
        if header_timeout != nil {
          deadline = time() + header_timeout
        }
      }

      if deadline != nil and time() > deadline {
        return ['error', 'the request head took too long to arrive']
      }

      var n = self._fill()
      if n == 0 {
        if self.buffered() == 0 {
          return nil
        }
        return ['error', 'connection closed inside the header section']
      }
    }
  }

  /**
   * Reads exactly `length` bytes.
   *
   * @param number length
   * @returns bytes
   * @throws ProtocolError if EOF arrives first
   * @throws TimeoutError, ConnectionError
   */
  read_exactly(length: number) {
    if length <= 0 {
      return bytes(0)
    }

    while self.buffered() < length {
      if self._fill() == 0 {
        raise ProtocolError(
          'connection closed after ${self.buffered()} of ${length} expected bytes',
        )
      }
    }

    var result = self._buf[self._pos, self._pos + length]
    self._pos += length

    return result
  }

  /**
   * Reads whatever is available, up to `length` bytes, blocking only
   * until the first byte arrives.
   *
   * @param number length
   * @returns bytes: empty at EOF
   * @throws TimeoutError, ConnectionError
   */
  read_some(length: number) {
    if self.buffered() == 0 {
      if self._fill() == 0 {
        return bytes(0)
      }
    }

    var available = self.buffered()
    var take = length < available ? length : available

    var result = self._buf[self._pos, self._pos + take]
    self._pos += take

    return result
  }

  /**
   * Reads until the peer closes its write half.
   *
   * This is the framing of last resort - a response with neither
   * `Content-Length` nor chunked encoding is delimited by the close
   * itself (RFC 9112 §6.3). `limit` bounds how much will be
   * accumulated so a peer that never closes cannot exhaust memory.
   *
   * @param ?number limit: the most to accept, in bytes; `nil` for no
   *    limit
   * @returns bytes
   * @throws TooLargeError if `limit` is exceeded
   */
  read_to_eof(limit) {
    while true {
      if limit != nil and self.buffered() > limit {
        raise TooLargeError('body exceeds the ${limit} byte limit')
      }

      if self._fill() == 0 {
        break
      }
    }

    var result = self._buf[self._pos,]
    self._pos = self._buf.length()

    return result
  }

  /**
   * Discards exactly `length` bytes without materialising them.
   * Used to drain the body of a request whose response has already
   * been decided, so the connection stays usable.
   *
   * @param number length
   * @throws ProtocolError if EOF arrives first
   */
  discard(length: number) {
    var remaining = length

    while remaining > 0 {
      if self.buffered() == 0 and self._fill() == 0 {
        raise ProtocolError('connection closed while discarding ${length} bytes')
      }

      var available = self.buffered()
      var take = remaining < available ? remaining : available
      self._pos += take
      remaining -= take
    }
  }

  /**
   * Pushes bytes back to the front of the read buffer so the next
   * read sees them again. Used by protocol detection, which has to
   * look at the first bytes of a connection before deciding which
   * parser gets them.
   *
   * @param bytes data
   */
  unread(data) {
    if data.length() == 0 {
      return
    }

    var rest = self._buf[self._pos,]
    var replacement = data.clone()
    replacement.extend(rest)

    self._buf.dispose()
    rest.dispose()

    self._buf = replacement
    self._pos = 0
  }

  /**
   * Hands this connection over to a readiness loop. Its socket goes
   * into non-blocking mode, so nothing on it can stall the loop. From
   * here on `write()` only queues and `flush()` does nothing: the loop
   * sends what is queued with `flush_ready()`, after whatever produced
   * it has finished, which is also what turns a batch of responses
   * into one write.
   */
  defer_output() {
    self._deferred = true
    self._transport.set_non_blocking(true)
  }

  /**
   * Takes the connection back from a readiness loop for anything that
   * has to read and write as it goes, such as a streamed body or an
   * upgraded connection. Its socket goes back to blocking mode, and
   * what is already queued goes out first.
   *
   * @returns bool: whether output was deferred, so a caller can hand
   *    it back with `defer_output()` when it is done
   * @throws TimeoutError, ConnectionError
   */
  block_output() {
    var was_deferred = self._deferred

    if was_deferred {
      self._deferred = false
      self._transport.set_non_blocking(false)
      self.flush()
    }

    return was_deferred
  }

  /**
   * Whether output is deferred to a readiness loop.
   *
   * @returns bool
   */
  is_deferred() {
    return self._deferred
  }

  /**
   * Queues part of a file for sending behind what is already queued,
   * to be read only as the socket makes room for it.
   *
   * @param string path
   * @param number offset
   * @param number length
   */
  queue_file(path, offset, length) {
    self._feed = FileFeed(path, offset, length)
  }

  /**
   * Whether enough is queued that a producer should stop until the
   * socket has taken it.
   *
   * @returns bool
   */
  output_is_heavy() {
    return self._feed != nil
      or self._out.length() - self._out_at >= _WRITE_HIGH_WATER
  }

  /**
   * Sends as much of what is queued as the socket takes right now,
   * without waiting.
   *
   * @returns bool: whether anything is still waiting for room
   * @throws ConnectionError
   */
  flush_ready() {
    while true {
      var queued = self._out.length()

      if self._out_at < queued {
        self._out_at += self._send_ready()

        if self._out_at < queued {
          return true
        }

        self._out.dispose()
        self._out_at = 0
      }

      if self._feed == nil {
        break
      }

      var piece = self._feed.next(_FEED_CHUNK)

      if piece == nil {
        self._feed.close()
        self._feed = nil
        break
      }

      self._out.extend(piece)
      piece.dispose()
    }

    return self.secure and !self._flush_session()
  }

  _send_ready() {
    catch {
      return self._transport.try_write(self._out, self._out_at)
    } as error {
      raise ConnectionError(error.message)
    }
  }

  _flush_session() {
    catch {
      return self._transport.try_flush()
    } as error {
      raise ConnectionError(error.message)
    }
  }

  /**
   * Forgets everything queued. For a peer that has stopped reading,
   * where what is left has nowhere to go.
   */
  drop_output() {
    self._out.dispose()
    self._out_at = 0

    if self._feed != nil {
      self._feed.close()
      self._feed = nil
    }
  }

  /**
   * Takes a server-side TLS handshake started by `accept_pending()` as
   * far as it can go without waiting, and notes what it negotiated
   * once it finishes.
   *
   * @returns number: `0` once finished, otherwise `net.READABLE` or
   *    `net.WRITABLE`, what to wait for before calling this again
   * @throws ConnectionError if the handshake fails
   */
  advance_handshake() {
    var step = self._step_handshake()

    if step == 0 {
      self.alpn = self._transport.alpn_protocol()
    }

    return step
  }

  _step_handshake() {
    catch {
      return self._transport.advance_handshake()
    } as error {
      raise ConnectionError('TLS handshake failed: ${error.message}')
    }
  }

  /**
   * Queues `data` for sending. Nothing reaches the socket until the
   * buffer fills or `flush()` is called.
   *
   * @param {bytes|string} data
   */
  write(data: string|bytes) {
    self._out.extend(data)

    if self._out.length() >= _WRITE_HIGH_WATER {
      self.flush()
    }
  }

  /**
   * Queues a whole response head, the same way `write()` queues
   * anything else.
   *
   * @param string version
   * @param number status
   * @param string reason
   * @param Headers headers
   * @param list cookies: the value of each `Set-Cookie` field
   */
  write_head(version, status, reason, headers, cookies) {
    headers.append_head_to(self._out, version, status, reason, cookies)

    if self._out.length() >= _WRITE_HIGH_WATER {
      self.flush()
    }
  }

  /**
   * Sends everything queued and blocks until the transport has taken
   * all of it.
   *
   * @throws TimeoutError, ConnectionError
   */
  _read_transport_chunk() {
    catch {
      return self._transport.read(_READ_CHUNK)
    } as error {
      if is_timeout_error(error.message) {
        raise TimeoutError('read timed out')
      }
      raise ConnectionError(error.message)
    }
  }

  _flush_transport_output() {
    catch {
      self._transport.write_all(
        self._out_at > 0 ? self._out[self._out_at,] : self._out,
      )
      if self.secure {
        self._transport.flush()
      }
    } as error {
      self._out.dispose()
      self._out_at = 0

      if is_timeout_error(error.message) {
        raise TimeoutError('write timed out')
      }
      raise ConnectionError(error.message)
    }
  }

  flush() {
    if self._deferred or self._out.length() == 0 {
      return
    }

    self._flush_transport_output()
    self._out.dispose()
    self._out_at = 0
  }

  /**
   * Sets how long a read may block before raising `TimeoutError`.
   * Only effective on a plaintext connection; a `TlsStream` no longer
   * owns a socket whose timeout can be changed, so a TLS connection's
   * timeouts have to be set on the `TcpStream` before it is wrapped
   * (which `connect()` and `accept()` below both do).
   *
   * @param number milliseconds: `0` or negative to block indefinitely
   */
  set_read_timeout(milliseconds) {
    if self._read_timeout == milliseconds {
      return
    }

    self._read_timeout = milliseconds

    if !self.secure {
      self._transport.set_read_timeout(milliseconds)
    }
  }

  /**
   * Sets how long a write may block before raising `TimeoutError`.
   * Carries the same TLS caveat as `set_read_timeout()`.
   *
   * @param number milliseconds
   */
  set_write_timeout(milliseconds) {
    if !self.secure {
      self._transport.set_write_timeout(milliseconds)
    }
  }

  /**
   * Turns off Nagle's algorithm, so a response head goes out
   * immediately rather than waiting for more data to coalesce with.
   * Every HTTP server wants this; a request is answered by a burst
   * that is then followed by silence, which is the exact case Nagle
   * handles badly.
   *
   * @param bool enabled
   */
  set_nodelay(enabled) {
    if !self.secure {
      catch {
        self._transport.set_nodelay(enabled)
      }
    }
  }

  /**
   * Flushes anything still queued and closes the transport. Safe to
   * call more than once. A failure while flushing is swallowed - the
   * connection is going away regardless, and the caller has usually
   * already handled whatever went wrong.
   *
   * With output deferred to a readiness loop nothing here waits: what
   * the socket does not take now is dropped.
   */
  close() {
    if self._closed {
      return
    }
    self._closed = true

    catch {
      if self._deferred {
        self.flush_ready()
      } else {
        self.flush()
      }
    }

    catch {
      if self._deferred and self.secure {
        self._transport.close_now()
      } else {
        self._transport.close()
      }
    }

    self.drop_output()
    self._buf.dispose()
    self._buf = bytes(0)
    self._out = bytes(0)
    self._pos = 0
  }

  to_string() {
    var scheme = self.secure ? 'https' : 'http'
    var peer = self.peer_address ? self.peer_address.to_string() : 'unknown'
    return '<Connection ${scheme} ${peer}>'
  }

  @to_string() {
    return self.to_string()
  }
}

/**
 * Opens a connection to `host` on `port`, optionally wrapping it in
 * TLS.
 *
 * Timeouts are applied to the raw socket before any TLS handshake
 * runs, which is both the only place they can be applied and what
 * keeps a stalled handshake from hanging forever.
 *
 * @param string host
 * @param int port
 * @param ?dict options: `secure` (bool), `tls_config` (a
 *    `net.tls.TlsConfig`), `server_name` (the SNI/verification name,
 *    defaulting to `host`), `connect_timeout`, `read_timeout` and
 *    `write_timeout` (all milliseconds)
 * @returns Connection
 * @throws ConnectionError, TimeoutError
 */
def connect(host: string, port: int, options: ?dict) {
  if options == nil {
    options = {}
  }

  var secure = options.get('secure', false)
  var connect_timeout = options.get('connect_timeout', 30000)
  var read_timeout = options.get('read_timeout', 30000)
  var write_timeout = options.get('write_timeout', 30000)

  # A connect timeout can only be applied to a concrete address, so
  # resolve the name here rather than letting connect() do it. A name
  # commonly maps to several addresses - an IPv6 one first, on most
  # systems - and only trying the first would strand anyone whose
  # network carries no IPv6 route.
  var candidates
  catch {
    candidates = net.resolve('${host}:${port}')
  } as resolve_error

  if resolve_error {
    raise ConnectionError('could not resolve ${host}: ${resolve_error.message}')
  }

  var tcp, last_error

  for candidate in candidates {
    tcp = net.TcpStream()

    catch {
      tcp.connect(candidate, connect_timeout)
      last_error = nil
    } as error

    if error {
      last_error = error
      catch {
        tcp.close()
      }
      tcp = nil
    } else {
      break
    }
  }

  if tcp == nil {
    var detail = last_error ? last_error.message : 'no address available'
    if last_error and is_timeout_error(last_error.message) {
      raise TimeoutError('connecting to ${host}:${port} timed out')
    }
    raise ConnectionError('could not connect to ${host}:${port}: ${detail}')
  }

  var peer, local
  catch {
    peer = tcp.peer_address()
    local = tcp.local_address()
  }

  catch {
    tcp.set_nodelay(true)
  }
  tcp.set_read_timeout(read_timeout)
  tcp.set_write_timeout(write_timeout)

  if !secure {
    return Connection(tcp, peer, local)
  }

  var config = options.get('tls_config', nil)
  if config == nil {
    config = tls.TlsConfig()
  }

  var server_name = options.get('server_name', nil) or host

  var stream
  catch {
    stream = tls.TlsStream.connect(tcp, config, server_name)
  } as tls_error

  if tls_error {
    catch {
      tcp.close()
    }
    raise ConnectionError('TLS handshake with ${host} failed: ${tls_error.message}')
  }

  return Connection(stream, peer, local)
}

/**
 * Opens a connection to `host:port` through an HTTP proxy's `CONNECT`
 * tunnel, running a TLS handshake with `host` inside it when `secure`
 * is set.
 *
 * The proxy sees only where the tunnel goes. Everything sent through it
 * after the handshake is between this end and `host`, encrypted, and
 * the certificate checked is `host`'s own.
 *
 * @param dict proxy: `host` and `port` of an HTTP proxy, and
 *    `authorization`, the `Proxy-Authorization` value to send, or
 *    `nil`.
 * @param string host
 * @param int port
 * @param ?dict options: as `connect()` takes them.
 * @returns Connection
 * @throws ConnectionError when the proxy cannot be reached or refuses
 *    the tunnel, or the handshake through it fails
 */
def tunnel(proxy: dict, host: string, port: int, options: ?dict) {
  if options == nil {
    options = {}
  }

  var plain = options.clone()

  plain.set('secure', false)

  var carrier = connect(proxy.host, proxy.port, plain)
  var target = '${host}:${port}'
  var head = 'CONNECT ${target} HTTP/1.1\r\nHost: ${target}\r\n'

  if proxy.get('authorization', nil) != nil {
    head += 'Proxy-Authorization: ${proxy.authorization}\r\n'
  }

  catch {
    carrier.write(head + '\r\n')
    carrier.flush()

    var status = carrier.read_line(8192)

    if status == nil {
      raise ConnectionError('the proxy at ${proxy.host}:${proxy.port} closed the connection')
    }

    var parts = status.split(' ')
    var code = parts.length() > 1 ? parts[1].to_number() : 0

    # The headers of the answer, which say nothing a tunnel needs.
    while true {
      var line = carrier.read_line(8192)

      if line == nil or line.is_empty() {
        break
      }
    }

    if code < 200 or code > 299 {
      raise ConnectionError(
        'the proxy at ${proxy.host}:${proxy.port} refused to open a tunnel to ${target}: '
          + status,
      )
    }

    if carrier.buffered() > 0 {
      raise ConnectionError('the proxy at ${proxy.host}:${proxy.port} spoke before ${host} did')
    }
  } as error {
    carrier.close()

    if instance_of(error, ConnectionError) {
      raise error
    }

    raise ConnectionError('the tunnel through ${proxy.host}:${proxy.port} failed: ${error.message}')
  }

  if !options.get('secure', false) {
    return carrier
  }

  var config = options.get('tls_config', nil)

  if config == nil {
    config = tls.TlsConfig()
  }

  var server_name = options.get('server_name', nil) or host
  var secured

  catch {
    secured = tls.TlsStream.connect(carrier.transport(), config, server_name)
  } as tls_error

  if tls_error {
    carrier.close()
    raise ConnectionError(
      'TLS handshake with ${host} through the proxy failed: ${tls_error.message}',
    )
  }

  return Connection(secured, carrier.peer_address, carrier.local_address)
}

def _get_peer(client) {
  catch {
    return client.peer_address()
  }
  return nil
}

def _get_local(client) {
  catch {
    return client.local_address()
  }
  return nil
}

def _set_nodelay_safe(client) {
  catch {
    client.set_nodelay(true)
  }
}

def _tls_begin_safe(client, config) {
  catch {
    return tls.TlsStream.begin_accept(client, config)
  } as error {
    catch {
      client.close()
    }
    raise ConnectionError('TLS handshake failed: ${error.message}')
  }
}

def _tls_accept_safe(client, config) {
  catch {
    return tls.TlsStream.accept(client, config)
  } as error {
    catch {
      client.close()
    }
    raise ConnectionError('TLS handshake failed: ${error.message}')
  }
}

/**
 * Turns a freshly accepted `TcpStream` into a `Connection`, running a
 * server-side TLS handshake first when `tls_config` is given.
 *
 * @param TcpStream client: the stream `TcpStream.accept()` returned
 * @param ?dict options: `tls_config` (a `net.tls.TlsConfig`; when
 *    present the connection is wrapped in TLS), `read_timeout` and
 *    `write_timeout` (milliseconds)
 * @returns Connection
 * @throws ConnectionError if the TLS handshake fails
 */
def accept(client, options: ?dict) {
  var settings = options == nil ? {} : options

  var peer = _get_peer(client)
  var local = _get_local(client)

  _set_nodelay_safe(client)

  var read_timeout = settings.get('read_timeout', 30000)
  var write_timeout = settings.get('write_timeout', 30000)
  client.set_read_timeout(read_timeout)
  client.set_write_timeout(write_timeout)

  var config = settings.get('tls_config', nil)
  if config == nil {
    return Connection(client, peer, local, read_timeout)
  }

  var stream = _tls_accept_safe(client, config)
  return Connection(stream, peer, local, read_timeout)
}

/**
 * Turns a freshly accepted `TcpStream` into a `Connection` the way
 * `accept()` does, except that a TLS handshake is only started. Nothing
 * here waits on the peer: `Connection.advance_handshake()` takes the
 * handshake forward as the socket becomes ready.
 *
 * @param TcpStream client: the stream `TcpStream.accept()` returned
 * @param ?dict options: as `accept()` takes them
 * @returns Connection
 * @throws ConnectionError if the handshake cannot be started
 */
def accept_pending(client, options: ?dict) {
  var settings = options == nil ? {} : options

  var peer = _get_peer(client)
  var local = _get_local(client)

  _set_nodelay_safe(client)

  var read_timeout = settings.get('read_timeout', 30000)
  var write_timeout = settings.get('write_timeout', 30000)
  client.set_read_timeout(read_timeout)
  client.set_write_timeout(write_timeout)

  var config = settings.get('tls_config', nil)
  if config == nil {
    return Connection(client, peer, local, read_timeout)
  }

  return Connection(_tls_begin_safe(client, config), peer, local, read_timeout)
}
