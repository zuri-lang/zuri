/**
 * @module loop
 *
 * A single thread serving many connections at once.
 *
 * A thread that's dedicated to one connection can't look at another
 * until that connection releases it, and clients aren't always quick. A
 * client can sit on an idle keep-alive connection, send half a request
 * and stop, or stop reading the response it asked for. `ConnectionLoop`
 * keeps every connection on a poller instead, and only does the work
 * for each one that can be done without waiting.
 *
 * Reading uses buffering. Each time a connection is readable, whatever
 * has arrived is buffered, and the request pipeline only runs once a
 * complete request is in the buffer, so the pipeline's own reads never
 * touch the socket. Writing uses queueing. Everything a connection
 * produces waits in its output queue until the pipeline has finished,
 * and is sent as the socket has room, which also combines a batch of
 * responses into a single write.
 *
 * Timeouts are handled here as well, as a deadline for each connection,
 * because the socket's own timeouts only apply to a call that's
 * waiting.
 *
 * A connection that stops carrying requests and responses, such as a
 * WebSocket or a server-sent event stream, stays on the loop. A driver
 * takes the place of the HTTP parser for it: the loop tells the driver
 * when something has arrived, and the driver queues output and asks
 * for it to be sent through a `Link`. Output a driver queues from
 * outside its own connection's events, for a message that one socket
 * passes on to others, say, is sent at the end of the loop's turn. A
 * driver can also have `Timer`s, which run on this same thread.
 *
 * Two things can still keep the thread busy, and both are under the
 * application's control: a handler runs until it finishes, and a body
 * given to `HttpResponse.stream()` is written as the handler produces
 * it, limited by `write_timeout`.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

#!-- part of the http module

import net
import os

# How often deadlines are checked, in seconds. A timeout can run over
# by this much.
var _REAP_INTERVAL = 0.1

# How long to leave the listener alone after an accept fails, in
# seconds. The usual cause is running out of descriptors, and a socket
# with a connection waiting stays readable, so without this the loop
# would spin on the failure.
var _ACCEPT_BACKOFF = 0.1

# How long each round waits while the last connections drain, in
# milliseconds.
var _FINISH_INTERVAL = 10

# How long to wait for the last connections to drain, in seconds, when
# the server has no `write_timeout`.
var _FINISH_LIMIT = 1

# How many times one turn goes back over connections woken while it
# was serving woken ones. A driver that wakes another, which wakes the
# first, would otherwise keep a turn going for good. Anything still
# woken waits for the next turn, which starts without waiting.
var _WAKE_ROUNDS = 8

# How many cancelled timers a connection can hold on to before they're
# cleared out.
var _TIMER_SLACK = 16

/**
 * An action that a connection loop runs every `interval` seconds, on
 * the thread that serves the connection it belongs to.
 *
 * `WebSocket.every()` and `EventStream.every()` return one. It stops
 * by itself when its connection closes, and `cancel()` stops it
 * sooner.
 */
class Timer {

  /**
   * The number of seconds between runs.
   * @type number
   */
  var interval

  /**
   * When it runs next, as a `time()` value. The loop sets this.
   * @type number
   */
  var due = 0

  var _action
  var _cancelled = false

  /**
   * @param number interval: seconds, more than `0`
   * @param function(0) action
   * @throws ValueError if `interval` is not more than `0`
   */
  @new(interval: number, action) {
    if interval <= 0 {
      raise ValueError('a timer interval must be more than 0 seconds')
    }

    self.interval = interval
    self._action = action
    self._cancelled = false
  }

  /**
   * Stops the timer. It's safe to call this more than once.
   */
  cancel() {
    self._cancelled = true
  }

  /**
   * Whether the timer has been stopped.
   *
   * @returns bool
   */
  is_cancelled() {
    return self._cancelled
  }

  /**
   * Runs the action once.
   *
   * @internal Called by the loop.
   */
  fire() {
    self._action()
  }
}

/**
 * How a driver reaches the loop that holds its connection. The loop
 * gives one to the driver's `attach()`.
 *
 * A driver is any object with these methods:
 *
 * - `can_drive()`: whether there's anything for the loop to drive.
 * - `attach(link)`: the loop holds the connection from now on.
 * - `on_readable()`: something has arrived, and is buffered on the
 *   connection. It's also called once the peer has finished sending.
 * - `on_closed()`: the connection has gone, for whatever reason.
 * - `going_away()`: the server is shutting down.
 * - `idle_timeout()`: how many seconds the connection can go without
 *   receiving anything, or `nil` for no limit.
 */
class Link {

  var _loop
  var _held

  @new(loop, held) {
    self._loop = loop
    self._held = held
  }

  /**
   * The connection this link belongs to.
   *
   * @returns Connection
   */
  connection() {
    return self._held.connection
  }

  /**
   * Tells the loop there's output queued. It's sent at the end of the
   * loop's turn.
   */
  wake() {
    self._loop.wake(self._held)
  }

  /**
   * Starts running `timer`. It runs until it's cancelled or the
   * connection closes.
   *
   * @param Timer timer
   */
  schedule(timer) {
    self._loop.schedule(self._held, timer)
  }

  /**
   * Closes the connection once what's queued has been sent.
   */
  close() {
    self._held.closing = true
    self.wake()
  }

  /**
   * Closes the connection without sending what's queued, for a peer
   * that has stopped reading.
   */
  abort() {
    self._held.aborting = true
    self.wake()
  }

  /**
   * Gives the connection back to the HTTP parser once what's queued
   * has been sent, so that it can serve the next request.
   */
  release() {
    self._held.releasing = true
    self.wake()
  }

  /**
   * Hands `error` to the server's `on_error()` listeners.
   *
   * @param Error error
   */
  report(error) {
    self._loop.report(self._held, error)
  }
}

# Everything the loop remembers about one connection.
class _Held {

  var connection
  var token

  # How many requests this connection has been answered.
  var served = 0

  # When to give up on it, in seconds, or nil to never give up.
  var deadline

  var handshaking = false

  # Whether the protocol has been decided yet.
  var sniffed = false

  # The session, on a connection that turned out to speak HTTP/2.
  var session
  var session_started = false

  # A request whose body is still arriving.
  var request

  # When the first byte of the head still arriving came in.
  var head_started

  # Whether the poller is waiting for room to write rather than for
  # something to read.
  var writing = false

  # Whether work stopped only because output had to go out first.
  var paused = false

  # Whether to close once the output has gone.
  var closing = false

  # What drives the connection in place of the HTTP parser, and how it
  # reaches the loop.
  var driver
  var link

  # The timers belonging to this connection, or nil until it has one.
  var timers

  # When the peer last sent anything, for a driver's idle timeout,
  # which output of its own mustn't push out.
  var heard = 0

  # Whether it's waiting to be served at the end of the turn.
  var woken = false

  # Whether to close without sending what's queued.
  var aborting = false

  # Whether to go back to the HTTP parser once the output has gone.
  var releasing = false

  # Whether the connection belongs to a server that lent it to this
  # loop, which only drives it and leaves closing it to that server.
  var borrowed = false

  @new(connection, token) {
    self.connection = connection
    self.token = token
  }
}

/**
 * The connections one thread serves, and the poller that says which of
 * them can be served right now.
 *
 * `HttpServer.listen()` runs one of these over its listener, and every
 * worker of `http.serve()` runs one over the sockets handed to it.
 */
class ConnectionLoop {

  var _server
  var _poller
  var _live = {}
  var _next_token = 1
  var _limit
  var _acceptor
  var _accepting = false
  var _accept_after = 0
  var _next_reap = 0
  var _read_wait
  var _idle_wait
  var _write_wait
  var _header_wait

  # Every timer, as a binary heap ordered by when each one is due.
  var _timers = []

  # The connections to serve at the end of the turn.
  var _woken = []

  var _handed_back = false

  # Whether to deliver what was published once a turn, which only a
  # server with subscribers needs.
  var _delivering = false

  /**
   * @param HttpServer server: what answers the requests
   * @param number limit: the most connections to hold at once
   */
  @new(server, limit: number) {
    self._server = server
    self._poller = net.Poller()
    self._live = {}
    self._timers = []
    self._woken = []
    self._limit = limit
    self._read_wait = _seconds(server.read_timeout)
    self._idle_wait = _seconds(server.keep_alive_timeout)
    self._write_wait = _seconds(server.write_timeout)
    self._header_wait = server.header_timeout
    self._delivering = server.has_subscribers()
  }

  /**
   * Accepts from `acceptor` whenever its listener has a connection
   * waiting and this loop has room for it.
   *
   * @param Acceptor acceptor
   */
  watch(acceptor) {
    self._acceptor = acceptor
    self._poller.add(acceptor.listener(), 0, net.READABLE)
    self._accepting = true
  }

  /**
   * Takes on a connection that has already been accepted. Which
   * protocol it speaks is decided later, once it has said something.
   *
   * @param TcpStream client
   */
  take(client) {
    var connection = self._server.begin_connection(client)

    if connection == nil {
      return
    }

    var held = _Held(connection, self._next_token)

    self._next_token++
    self._live[held.token] = held

    connection.defer_output()
    held.deadline = _after(time(), self._read_wait)

    self._poller.add(connection.transport(), held.token, net.READABLE)

    if connection.secure {
      held.handshaking = true
      self._step_safe(held, net.READABLE, time())
    } else {
      self._server.announce_connection(connection)
    }
  }

  /**
   * Takes on a connection that a server serving one connection at a
   * time has set up, and hands it straight to `driver`.
   *
   * The connection is only lent to this loop, which never closes it:
   * once the driver has finished, the loop lets it go, and the server
   * that lent it decides what happens next. `was_handed_back()` says
   * whether the driver gave it back for more requests.
   *
   * @param Connection connection
   * @param any driver: see `Link`
   */
  adopt(connection, driver) {
    var held = _Held(connection, self._next_token)

    self._next_token++
    self._live[held.token] = held

    held.sniffed = true
    held.borrowed = true

    connection.defer_output()

    self._poller.add(connection.transport(), held.token, net.READABLE)

    var now = time()

    self._install(held, driver)
    self._settle_safe(held, now)
    self._set_deadline(held, now)
  }

  /**
   * Whether the driver of a connection lent with `adopt()` gave it back
   * for more requests. When it didn't, the connection is to be closed.
   *
   * @returns bool
   */
  was_handed_back() {
    return self._handed_back
  }

  /**
   * How many connections are held.
   *
   * @returns number
   */
  length() {
    return self._live.length()
  }

  /**
   * Whether no connections are held.
   *
   * @returns bool
   */
  is_empty() {
    return self._live.is_empty()
  }

  /**
   * Whether another connection may be taken on.
   *
   * @returns bool
   */
  has_room() {
    return self._live.length() < self._limit
  }

  /**
   * Waits up to `timeout` for something to do and does it.
   *
   * @param number timeout: milliseconds
   */
  turn(timeout) {
    var wait = timeout

    if self._woken.length() > 0 or self._timers.length() > 0 {
      wait = self._wait_for(timeout)
    }

    # A poller with nothing on it answers at once, which would turn a
    # listener paused after a failed accept into a spin.
    if self._poller.is_empty() {
      os.sleep(wait / 1000)
    }

    var events = self._poller.wait(wait)
    var now = time()
    var live = self._live

    for event in events {
      var token = event[0]

      if token == 0 {
        self._accept_waiting(now)
      } else {
        var held = live.get(token, nil)

        if held != nil {
          self._step_safe(held, event[1], now)
        }
      }
    }

    if self._timers.length() > 0 {
      self._run_timers(now)
    }

    if self._delivering {
      self._server.deliver_published()
    }

    if self._woken.length() > 0 {
      self._serve_woken(now)
    }

    if now >= self._next_reap {
      self._next_reap = now + _REAP_INTERVAL
      self._reap(now)
      self._resume_accepting(now)

      # A listener can subscribe at any time. A server without one still
      # has to clear out what other workers publish, and does it here,
      # once per reap.
      self._delivering = self._server.has_subscribers()

      if !self._delivering {
        self._server.deliver_published()
      }
    }
  }

  /**
   * Stops accepting and closes every connection, giving output already
   * queued a bounded chance to reach its peer.
   */
  finish() {
    self._stop_accepting()
    self._acceptor = nil

    var now = time()
    var limit = now +
        (self._write_wait == nil ? _FINISH_LIMIT : self._write_wait)

    for held in self._live.values() {
      if held.driver != nil {
        catch {
          held.driver.going_away()
        } as error {
          self.report(held, error)
        }
      }

      held.closing = true
      self._settle_safe(held, now)
    }

    while !self._live.is_empty() and time() < limit {
      self.turn(_FINISH_INTERVAL)
    }

    for held in self._live.values() {
      held.connection.drop_output()
      self._close(held)
    }
  }

  /**
   * Serves `held` at the end of this turn, sending what it has queued.
   *
   * @internal Called through `Link.wake()`.
   * @param any held
   */
  wake(held) {
    if !held.woken {
      held.woken = true
      self._woken.append(held)
    }
  }

  /**
   * Starts running `timer` for `held`'s connection.
   *
   * @internal Called through `Link.schedule()`.
   * @param any held
   * @param Timer timer
   */
  schedule(held, timer) {
    if timer.is_cancelled() or self._live.get(held.token, nil) == nil {
      return
    }

    if held.timers == nil {
      held.timers = []
    } else if held.timers.length() >= _TIMER_SLACK {
      var running = []

      for kept in held.timers {
        if !kept.is_cancelled() {
          running.append(kept)
        }
      }

      held.timers = running
    }

    held.timers.append(timer)
    timer.due = time() + timer.interval
    self._push_timer(timer)
  }

  /**
   * Hands `error` to the server's `on_error()` listeners, along with
   * the connection it happened on.
   *
   * @internal Called through `Link.report()`.
   * @param any held
   * @param Error error
   */
  report(held, error) {
    self._server.report_error(error, held.connection)
  }

  # How long this turn may wait for an event, in milliseconds: no
  # longer than `timeout`, and no later than the next timer.
  _wait_for(timeout) {
    if self._woken.length() > 0 {
      return 0
    }

    if self._timers.length() == 0 {
      return timeout
    }

    var until = (self._timers[0].due - time()) * 1000

    if until <= 0 {
      return 0
    }

    # Rounded up, so a wait never ends just short of the timer.
    var wait = until // 1 + 1

    return wait < timeout ? wait : timeout
  }

  _accept_safe() {
    catch {
      return self._acceptor.take()
    } as error {
      return error
    }
  }

  _accept_waiting(now) {
    while self.has_room() {
      var client = self._accept_safe()

      if client == nil {
        return
      }

      if instance_of(client, Error) {
        # A listener closed under it is what a stopped server looks
        # like from here, and is not an error worth reporting.
        if self._server.is_listening() {
          self._server.report_error(client, nil)
        }

        self._stop_accepting()
        self._accept_after = now + _ACCEPT_BACKOFF

        return
      }

      self.take(client)
    }

    self._stop_accepting()
  }

  _stop_accepting() {
    if self._accepting {
      self._accepting = false
      self._poller.remove(0)
    }
  }

  _resume_accepting(now) {
    if self._acceptor != nil and
        !self._accepting and
        now >= self._accept_after and
        self.has_room() and
        self._server.is_listening() {
      self._accepting = true
      self._poller.add(self._acceptor.listener(), 0, net.READABLE)
    }
  }

  _step_safe(held, flags, now) {
    catch {
      self._step(held, flags, now)
    } as error {
      self._fail(held, error)
    }
  }

  _settle_safe(held, now) {
    catch {
      self._settle(held, now)
    } as error {
      self._fail(held, error)
    }
  }

  _fail(held, error) {
    self._server.report_error(error, held.handshaking ? nil : held.connection)
    held.connection.drop_output()
    self._close(held)
  }

  # Does what one event allows, and whatever that makes possible.
  _step(held, flags, now) {
    if flags & net.ERROR != 0 {
      held.connection.drop_output()
      self._close(held)
      return
    }

    if held.handshaking {
      self._handshake(held, now)
      return
    }

    if !held.writing {
      if held.connection.fill_ready() == nil {
        return
      }

      self._advance(held, now)
    }

    # Only a connection with a driver can be waiting to close, to drop
    # its output or to go back to the HTTP parser.
    if held.driver != nil {
      self._carry_on(held, now)
      return
    }

    if !self._settle(held, now) {
      return
    }

    while held.paused {
      self._advance(held, now)

      if !self._settle(held, now) {
        return
      }
    }

    self._set_deadline(held, now)
  }

  # Sends what is queued, and keeps going for as long as that makes
  # more work possible.
  _carry_on(held, now) {
    if held.aborting {
      held.connection.drop_output()
      self._close(held)
      return
    }

    if !self._settle(held, now) {
      return
    }

    if held.releasing {
      self._release(held)

      if held.borrowed {
        return
      }
    }

    while held.paused {
      self._advance(held, now)

      if !self._settle(held, now) {
        return
      }
    }

    self._set_deadline(held, now)
  }

  _handshake(held, now) {
    var step = held.connection.advance_handshake()

    if step != 0 {
      self._poller.modify(held.token, step)
      return
    }

    held.handshaking = false
    self._poller.modify(held.token, net.READABLE)
    self._server.announce_connection(held.connection)
    held.deadline = _after(now, self._read_wait)
  }

  # Sends what the socket takes, and closes a connection that is done.
  # Returns whether the connection can take on more work now.
  _settle(held, now) {
    if held.connection.flush_ready() {
      if !held.writing {
        held.writing = true
        self._poller.modify(held.token, net.WRITABLE)
      }

      held.deadline = _after(now, self._write_wait)

      return false
    }

    if held.writing {
      held.writing = false
      self._poller.modify(held.token, net.READABLE)
    }

    if held.closing {
      self._close(held)
      return false
    }

    return true
  }

  # Serves whatever the buffer holds a whole message of.
  _advance(held, now) {
    held.paused = false

    if held.driver != nil {
      held.heard = now
      held.driver.on_readable()
      return
    }

    if !held.sniffed {
      var http2 = self._server.sniff_http2(held.connection)

      if http2 == nil {
        return
      }

      held.sniffed = true

      if http2 {
        held.session = self._server.open_http2(held.connection)
        held.session.drive(self._link_for(held))
      }
    }

    if held.session == nil {
      self._advance_http1(held, now)
    } else {
      self._advance_http2(held)
    }
  }

  _advance_http1(held, now) {
    var connection = held.connection
    var server = self._server

    while true {
      var request = held.request

      if request == nil {
        var head = connection.try_request_head(
          server.max_line_size,
          server.max_header_size,
          server.max_header_count,
        )

        if head == nil {
          if connection.peer_finished() {
            # Nothing more is coming. A head left unfinished is still
            # the pipeline's to answer, and with the peer gone its
            # reads cannot wait.
            if connection.buffered() > 0 {
              server.serve_next(connection, held.served)
            }

            held.closing = true
          } else if held.head_started == nil and connection.buffered() > 0 {
            held.head_started = now
          }

          return
        }

        held.head_started = nil
        request = server.request_from_head(connection, head)

        if request == nil {
          held.closing = true
          return
        }
      }

      # With the peer gone the rest of the body is never coming, and
      # the pipeline is what says so.
      if !server.body_arrived(connection, request) and
          !connection.peer_finished() {
        held.request = request
        return
      }

      held.request = nil

      if !server.answer(connection, request, held.served) {
        # A handler that took the connection over, for a WebSocket or
        # an event stream, left behind what drives it now.
        var driver = request.context.get('driver', nil)

        if driver == nil {
          held.closing = true
        } else {
          self._install(held, driver)
        }

        return
      }

      held.served++

      if connection.buffered() == 0 {
        return
      }

      if connection.output_is_heavy() {
        held.paused = true
        return
      }
    }
  }

  _advance_http2(held) {
    var connection = held.connection
    var session = held.session

    if !held.session_started {
      if connection.buffered() < self._server.http2_preface_size() {
        if connection.peer_finished() {
          held.closing = true
        }

        return
      }

      held.session_started = true
      session.start_server(nil)
    }

    if !session.on_readable(self._server) or connection.peer_finished() {
      held.closing = true
      return
    }

    held.paused = session.can_resume()
  }

  _link_for(held) {
    if held.link == nil {
      held.link = Link(self, held)
    }

    return held.link
  }

  # Hands the connection to `driver`, or closes it when there is
  # nothing left to drive.
  _install(held, driver) {
    held.request = nil
    held.head_started = nil

    if !driver.can_drive() {
      held.closing = true
      return
    }

    held.driver = driver
    held.heard = time()

    catch {
      driver.attach(self._link_for(held))
    } as error {
      self.report(held, error)
      held.closing = true
    }
  }

  # Takes the connection back from a driver that has finished with it,
  # so the next request on it can be answered.
  _release(held) {
    held.releasing = false
    held.driver = nil
    held.served++
    self._stop_timers(held)

    if held.borrowed {
      self._handed_back = true
      self._forget(held)
      return
    }

    held.paused = held.connection.buffered() > 0
  }

  # Serves the connections woken during this turn.
  _serve_woken(now) {
    var rounds = 0

    while self._woken.length() > 0 and rounds < _WAKE_ROUNDS {
      var woken = self._woken

      self._woken = []
      rounds++

      for held in woken {
        held.woken = false

        if self._live.get(held.token, nil) != nil {
          self._resume_safe(held, now)
        }
      }
    }
  }

  _resume_safe(held, now) {
    catch {
      self._resume(held, now)
    } as error {
      self._fail(held, error)
    }
  }

  _resume(held, now) {
    if held.session != nil {
      held.session.resume()
      held.paused = held.session.can_resume()
    }

    # A connection already waiting for room is left to the writable
    # event. Sending again here would push its deadline out without
    # anything having moved.
    if held.writing and !held.aborting {
      return
    }

    self._carry_on(held, now)
  }

  # Sets how long this connection may now go without progress, from
  # what it is waiting for.
  _set_deadline(held, now) {
    if held.session != nil or held.request != nil {
      held.deadline = _after(now, self._read_wait)
      return
    }

    if held.driver != nil {
      held.deadline = _after(held.heard, held.driver.idle_timeout())
      return
    }

    var wait = held.served > 0 ? self._idle_wait : self._read_wait

    held.deadline = _after(now, wait)

    # Each read of a head gets the usual wait, and the head as a whole
    # gets `header_timeout`. Without that second limit, a client
    # sending a byte every few seconds would hold a connection open
    # indefinitely while never exceeding either. That is what
    # slowloris is.
    if held.head_started != nil and self._header_wait != nil {
      var limit = held.head_started + self._header_wait

      if held.deadline == nil or limit < held.deadline {
        held.deadline = limit
      }
    }
  }

  # The poller reports nothing for a peer that has simply gone quiet,
  # so this is the only thing that notices.
  _reap(now) {
    var expired = []

    for _, held in self._live {
      if held.deadline != nil and now > held.deadline {
        expired.append(held)
      }
    }

    for held in expired {
      held.connection.drop_output()
      self._close(held)
    }
  }

  _run_timers(now) {
    var heap = self._timers

    while heap.length() > 0 and heap[0].due <= now {
      var timer = self._pop_timer()

      if timer.is_cancelled() {
        continue
      }

      catch {
        timer.fire()
      } as error {
        self._server.report_error(error, nil)
      }

      if !timer.is_cancelled() {
        timer.due += timer.interval

        # A turn that ran late skips the runs it missed.
        if timer.due <= now {
          timer.due = now + timer.interval
        }

        self._push_timer(timer)
      }
    }
  }

  _push_timer(timer) {
    var heap = self._timers

    heap.append(timer)

    var at = heap.length() - 1

    while at > 0 {
      var above = (at - 1) // 2

      if heap[above].due <= timer.due {
        break
      }

      heap[at] = heap[above]
      at = above
    }

    heap[at] = timer
  }

  _pop_timer() {
    var heap = self._timers
    var first = heap[0]
    var last = heap.pop()
    var size = heap.length()

    if size == 0 {
      return first
    }

    var at = 0

    while true {
      var child = at * 2 + 1

      if child >= size {
        break
      }

      if child + 1 < size and heap[child + 1].due < heap[child].due {
        child++
      }

      if last.due <= heap[child].due {
        break
      }

      heap[at] = heap[child]
      at = child
    }

    heap[at] = last

    return first
  }

  _stop_timers(held) {
    if held.timers != nil {
      for timer in held.timers {
        timer.cancel()
      }

      held.timers = nil
    }
  }

  # Takes a connection off the loop without closing it.
  _forget(held) {
    self._poller.remove(held.token)
    self._live.remove(held.token)
  }

  _close(held) {
    if self._live.get(held.token, nil) == nil {
      return
    }

    self._forget(held)
    self._stop_timers(held)

    var driver = held.driver

    if driver != nil {
      held.driver = nil

      catch {
        driver.on_closed()
      } as error {
        self.report(held, error)
      }
    }

    if held.session != nil {
      catch {
        held.session.drop_feeds()
      } as error {
        self.report(held, error)
      }
    }

    # The server that lent the connection closes it itself.
    if held.borrowed {
      return
    }

    # A handshake that never finished was never announced, so there is
    # nobody to tell it has gone.
    if held.handshaking {
      held.connection.close()
    } else {
      self._server.finish_connection(held.connection)
    }
  }
}

def _seconds(milliseconds) {
  return milliseconds == nil or milliseconds <= 0 ? nil : milliseconds / 1000
}

def _after(now, wait) {
  return wait == nil ? nil : now + wait
}
