/**
 * @module os.env
 *
 * Reads, writes and lists the current process's environment variables.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import _os

/**
 * Returns the given environment variable if it exists or
 * `default_value` (`nil` if not given) otherwise.
 *
 * Example,
 *
 * ```zuri-repl
 * %> import os
 * %> os.get_env('ENV1')
 * '20'
 * ```
 *
 * @param string name
 * @param ?any default_value
 * @returns ?string
 */
def get_env(name: string, default_value: ?any) {
  var value = _os.getenv(name)
  return value != nil ? value : default_value
}

/**
 * Sets the named environment variable to the given value.
 *
 * Example,
 *
 * ```zuri-repl
 * %> os.set_env('ENV1', 'New value')
 * true
 * %> os.get_env('ENV1')
 * 'New value'
 * ```
 *
 * If you are in the REPL and have tried the last example in
 * `get_env()`, you may notice that the value of `ENV1` doesn't
 * change. This is because unless you specify, `set_env()` will
 * not overwrite existing environment variables. For that, you
 * will need to specify `true` as the third parameter to
 * `set_env()`.
 *
 * For example,
 *
 * ```zuri-repl
 * %> os.set_env('ENV1', 'New value again', true)
 * true
 * %> os.get_env('ENV1')
 * 'New value again'
 * ```
 *
 * @note Environment variables set will not persist after
 *    application exists.
 * @param string name
 * @param string value
 * @param ?bool overwrite: Default value is `false`.
 * @returns bool
 */
def set_env(name: string, value: string, overwrite: ?bool) {
  if overwrite == nil {
    overwrite = false
  }
  return _os.setenv(name, value, overwrite)
}

/**
 * Removes the named environment variable, if it's set.
 *
 * Example,
 *
 * ```zuri-repl
 * %> os.set_env('ENV1', '20')
 * true
 * %> os.unset_env('ENV1')
 * true
 * %> os.get_env('ENV1')
 * nil
 * %> os.unset_env('ENV1')
 * false
 * ```
 *
 * @note Just like `set_env()`, this change does not persist past
 *    the lifetime of the current process.
 * @param string name
 * @returns bool: `true` if the variable existed and was removed,
 *    `false` if it wasn't set to begin with.
 */
def unset_env(name: string) {
  return _os.unsetenv(name)
}

/**
 * Returns every environment variable that this process can see, as a
 * dictionary of names and values.
 *
 * For example:
 *
 * ```zuri-repl
 * %> os.environ()
 * {HOME: /home/username, SHELL: /bin/bash, ...}
 * ```
 *
 * @note The dictionary is a snapshot taken when you call this. Later
 *    calls to `set_env()` and `unset_env()` don't change a dictionary
 *    you already have.
 * @returns dict
 */
def environ() {
  return _os.environ()
}

/**
 * Expands `$NAME` and `${NAME}` references in `text`, and `%NAME%`
 * references on Windows as well, using the current process's
 * environment, as a shell does before it runs a command.
 *
 * A reference to a variable that isn't set expands to an empty string,
 * as it does in most shells, instead of being left as it is or raising
 * an error.
 *
 * `text` should come from somewhere other than a Zuri string literal,
 * such as a configuration file, a template on disk or a command-line
 * argument, because a `${NAME}` written directly in Zuri source is
 * interpolated by Zuri's own string syntax before `expand_vars()` sees
 * it.
 *
 * For example:
 *
 * ```zuri-repl
 * %> os.set_env('NAME', 'zuri')
 * true
 * %> os.expand_vars('hello, $NAME!')
 * 'hello, zuri!'
 * %> os.expand_vars(file('greeting.template').read())
 * 'hello, zuri!'
 * ```
 *
 * @param string text
 * @returns string
 */
def expand_vars(text: string) {
  var result = text.replace_with(
    '~\$\{([A-Za-z_][A-Za-z0-9_]*)\}~',
    @(match, name) {
      return get_env(name, '')
    },
  )

  result = result.replace_with('~\$([A-Za-z_][A-Za-z0-9_]*)~', @(match, name) {
    return get_env(name, '')
  })

  if _os.platform == 'windows' {
    result = result.replace_with(
      '~%([A-Za-z_][A-Za-z0-9_]*)%~',
      @(match, name) {
        return get_env(name, '')
      },
    )
  }

  return result
}
