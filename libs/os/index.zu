/**
 * @module os
 *
 * Zuri's interface to the operating system: environment variables, the
 * filesystem, other processes and the machine itself. Operations on a
 * single file, such as reading, writing, deleting or copying it, or
 * inspecting its size, permissions or timestamps, are methods of the
 * `file` class instead. See `file.stats()`, `file.delete()` and
 * `file.copy()`. Everything else is here.
 *
 * ## Environment variables
 *
 * ```zuri
 * import os
 *
 * var port = os.get_env('PORT', '8080')
 * os.set_env('APP_ENV', 'production')
 *
 * for name in os.environ() {
 *   echo '${name} = ${os.environ()[name]}'
 * }
 * ```
 *
 * ## Paths
 *
 * Paths are resolved and compared as strings, without touching the
 * filesystem, so they work the same way whether or not anything exists
 * at the path yet.
 *
 * ```zuri
 * var config = os.join_paths(os.home_dir(), '.config', 'zuri')
 * var absolute = os.abs_path('../lib/main.zu')
 * var rel = os.relative_path('/srv/app', '/srv/app/logs/out.log')
 * # rel == 'logs/out.log'
 * ```
 *
 * ## The filesystem
 *
 * ```zuri
 * os.create_dir('build')
 *
 * for entry in os.read_dir('.', false) {
 *   if os.is_dir(entry) continue
 *   echo entry
 * }
 *
 * var git = os.which('git')  # full path, or nil if not on PATH
 * var sources = os.glob('*.zu')
 * ```
 *
 * ## Running other programs
 *
 * `exec()` is for the simple case: it runs a command, waits until it
 * finishes, and returns its exit code and output.
 *
 * ```zuri
 * var result = os.exec('git', 'rev-parse', 'HEAD')
 * if result.exit_code == 0 {
 *   echo 'HEAD is at ${result.output.trim()}'
 * }
 * ```
 *
 * `spawn()` is for everything that `exec()` doesn't cover: a command
 * that runs for a long time, one that needs input written to it, or one
 * whose output has to be read as it arrives, instead of all at once at
 * the end.
 *
 * ```zuri
 * var proc = os.spawn('grep', ['error'], { stdin: 'pipe' })
 * proc.write_stdin('startup ok\nerror: disk full\n')
 * proc.close_stdin()
 * echo proc.read_stdout().to_string()  # 'error: disk full\n'
 * proc.wait()
 * ```
 *
 * `on_signal()` catches `SIGINT`, `SIGTERM` and other signals, so that
 * a long-running script can shut down cleanly instead of being stopped
 * in the middle of its work. When the callback returns nothing, the
 * signal then does what it would have done anyway, so this example
 * cleans up and then exits:
 *
 * ```zuri
 * os.on_signal('INT', @() {
 *   echo 'shutting down...'
 *   flush_caches()
 * })
 * ```
 *
 * Return a truthy value instead to ignore the signal and keep running.
 *
 * Windows has no signals. There, a callback runs for console events
 * such as Ctrl+C, and never for anything `kill()` sends.
 *
 * ## Watching for changes
 *
 * A `Watcher` is told about changes to files and directories as the
 * operating system reports them, and about the exit of child processes
 * that it follows:
 *
 * ```zuri
 * var watcher = os.Watcher().add('templates')
 *
 * for event in watcher {
 *   echo '${event.kind} ${event.path}'  # e.g. 'modify /srv/app/templates/home.html'
 * }
 * ```
 *
 * ## The machine
 *
 * ```zuri
 * echo 'running on ${os.num_cpus()} cores'
 * echo '${os.free_memory() / 1_000_000} MB free of ${os.total_memory() / 1_000_000} MB'
 * ```
 *
 * ## Temporary files
 *
 * `create_temp_file()` and `create_temp_dir()` reserve a uniquely named
 * path under `temp_dir()` atomically, so two processes creating
 * temporary files at the same time can never get the same name:
 *
 * ```zuri
 * var path = os.create_temp_file('upload-', '.tmp')
 * file(path, 'w').write(incoming_data)
 * # ... use it, then clean up when done
 * file(path).delete()
 * ```
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import @.env { * }
import @.path { * }
import @.fs { * }
import @.process { * }
import @.system { * }
import @.tempfile { * }
import @.watch { * }
