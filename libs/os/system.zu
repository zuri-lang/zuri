/**
 * @module os.system
 *
 * Information about the current process, the Zuri runtime, and the
 * machine it's running on.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import _os

/**
 * The current Zuri version.
 * @type string
 */
var version: string = _os.version

/**
 * The platform that this runtime was built for, as a target triple,
 * such as `x86_64-unknown-linux-gnu`, `aarch64-apple-darwin` or
 * `x86_64-pc-windows-msvc`. Release archives are named with it, so it's
 * how you find a runtime for the current machine.
 *
 * ```zuri-repl
 * %> os.target
 * 'x86_64-unknown-linux-gnu'
 * ```
 *
 * @type string
 */
var target: string = _os.target

/**
 * The current Zuri VM version.
 * @type string
 */
var vm_version: string = _os.vm_version

/**
 * The operating system the runtime was built for: `'linux'`,
 * `'macos'`, `'windows'`, `'freebsd'`, `'openbsd'`, `'netbsd'` and so
 * on, the name Rust's standard library gives it.
 * @type string
 *
 * Example,
 *
 * ```zuri-repl
 * %> import os
 * %> os.platform
 * 'macos'
 * ```
 */
var platform: string = _os.platform

/**
 * The command line, as the running script sees it.
 *
 * The first entry is the path of the Zuri executable, and the second is
 * the script being run. Everything after those two is meant for the
 * script itself, so a program reads its own arguments from `args[2,]`,
 * and gets the same list whether it was started with `zuri run` or as a
 * command.
 *
 * ```zuri-repl
 * %> import os
 * %> os.args
 * ['/usr/local/bin/zuri', '/home/ada/greet.zu', '--name', 'Ada']
 * ```
 *
 * The `args` module reads this for you, and reading it directly is only
 * worthwhile in the simplest programs.
 *
 * @type list
 */
var args: list = _os.args

/**
 * The standard path separator for the current operating system.
 * @type string
 */
var path_separator: string = _os.path_separator

/**
 * The full path to the running Zuri executable.
 * @type string
 */
var exe_path: string = _os.exe_path

/**
 * Causes the current thread to sleep for the specified number of
 * seconds.
 *
 * @param number duration
 */
def sleep(duration: number) {
  _os.sleep(duration)
}

/**
 * Returns information about the operating system and the machine, as a
 * dictionary with these keys:
 *
 * - `sysname`: the name of the operating system
 * - `nodename`: the name of the machine
 * - `version`: the operating system version
 * - `release`: the operating system release
 * - `machine`: the hardware or processor type
 *
 * For example:
 *
 * ```zuri-repl
 * %> os.info()
 * {sysname: Darwin, nodename: MacBook-Pro.local, version: Darwin Kernel Version
 * 21.1.0: Wed Oct 13 17:33:24 PDT 2021; root:xnu-8019.41.5~1/RELEASE_ARM64_T8101,
 * release: 21.1.0, machine: arm64}
 * ```
 *
 * @returns dict
 */
def info() {
  return _os.info()
}

/**
 * The number of logical CPUs available to this process. Useful for
 * sizing a worker pool: `isolate.cpu_count()` is the exact same
 * underlying value, exposed here too so code that only needs this
 * one fact doesn't have to import the whole `isolate` module for
 * it.
 *
 * @returns int
 */
def num_cpus() {
  return _os.cpu_count()
}

/**
 * The current machine's hostname.
 *
 * @returns string
 * @raises Error if the hostname couldn't be determined.
 */
def hostname() {
  return _os.hostname()
}

/**
 * The total physical memory installed on this machine, in bytes.
 *
 * @returns number
 * @raises Error if this isn't supported on the current platform.
 */
def total_memory() {
  return _os.total_memory()
}

/**
 * An estimate, in bytes, of how much physical memory is available for
 * new allocations right now. It's the free memory plus caches and
 * buffers that can easily be reclaimed, which is the figure that tools
 * like `free` report as "available", not the smaller and less useful
 * "free" figure.
 *
 * @returns number
 * @raises Error if this isn't supported on the current platform.
 */
def free_memory() {
  return _os.free_memory()
}

/**
 * How long the machine has been running since it last booted, in
 * seconds.
 *
 * @returns number
 * @raises Error if this isn't supported on the current platform.
 */
def uptime() {
  return _os.uptime()
}
