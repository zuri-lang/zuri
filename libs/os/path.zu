/**
 * @module os.path
 *
 * Path string manipulation: joining, resolving, and comparing
 * paths. Nothing in this file touches the filesystem except where
 * explicitly documented (`real_path()`, and `abs_path()`'s optional
 * `strict` mode): everything else here is pure string handling, so
 * it works the same whether or not the path in question actually
 * exists.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import _os

# Private alias so every function below can just say `_sep` instead
# of `_os.path_separator`; not exported (leading underscore), so it
# can't collide with `system.zu`'s own public `path_separator`.
var _sep = _os.path_separator

# Windows accepts either slash as a separator, so a path can arrive
# with a mix of both and every one of them has to be recognised. Unix
# has only the one: a backslash there is an ordinary character in a
# filename and must never be treated as a separator.
var _alt_sep = _os.platform == 'windows' ? '/' : nil

/**
 * Concatenates the given paths together into a format that is
 * valid on the current operating system.
 *
 * Example,
 *
 * ```zuri-repl
 * %> os.join_paths('/home/user', 'path/to/myfile.ext')
 * '/home/user/path/to/myfile.ext'
 * ```
 *
 * @param string... paths
 * @returns string
 */
def join_paths(...paths) {
  var parts = []

  for arg in paths {
    if !is_string(arg) {
      raise TypeError('string expected, ${typeof(arg)} given')
    }

    var part = arg

    # Each of these hands back a new string whether or not it changed
    # anything, and joining two paths that are already tidy is by far
    # the common case, so each one is asked for only when it has work
    # to do.
    if part.starts_with(' ') or part.ends_with(' ') {
      part = part.trim()
    }

    if _alt_sep != nil {
      part = part.replace(_alt_sep, _sep, false)
    }

    if part {
      parts.append(part)
    }
  }

  var last = parts.length() - 1

  iter var i = 0; i < parts.length(); i++ {
    # An inner separator belongs to exactly one of the two parts it
    # sits between: trailing ones go, leading ones go, and whatever
    # the first and last parts carry on their outer edges stays.
    if i > 0 and parts[i].starts_with(_sep) {
      parts[i] = parts[i].ltrim(_sep)
    }

    if i < last and parts[i].ends_with(_sep) {
      parts[i] = parts[i].rtrim(_sep)
    }
  }

  return _sep.join(parts)
}

/**
 * Returns the original path to a relative path.
 *
 * @note if the path is a file, see `abs_path()`.
 * @param string path
 * @returns string
 */
def real_path(path: string) {
  return _os.realpath(path)
}

/**
 * Returns the absolute form of `path`: relative paths are resolved
 * against the current working directory, and "." / ".." segments
 * are collapsed: purely as string manipulation, with no filesystem
 * access at all by default. Unlike `real_path()`, this works even
 * when `path` (or any part of it) doesn't exist on disk, and it
 * never resolves symbolic links; use `real_path()` when you need the
 * true canonical path of something that already exists.
 *
 * On Windows, a path that starts at a root without naming a drive,
 * such as `\\srv\\app` or `/srv/app`, is on the working directory's
 * drive, and a UNC path such as `\\\\server\\share\\app` keeps
 * `\\\\server\\share` as its root, which `..` never climbs out of.
 *
 * @param string path
 * @param ?bool strict: Default `false`. When `true`, the resolved
 *    path is checked against the filesystem and an `Error` is raised
 *    if nothing exists there.
 * @returns string
 */
def abs_path(path: string, strict: ?bool) {
  if strict == nil {
    strict = false
  }

  var root = ''
  var raw

  if _os.platform == 'windows' {
    var anchored = _windows_root(path)

    if anchored == nil {
      var base = _windows_root(cwd())

      root = base.root
      raw = base.rest + '\\' + path
    } else if anchored.root == '' {
      # Rooted but with no drive, so on the working directory's drive.
      root = _windows_root(cwd()).root
      raw = anchored.rest
    } else {
      root = anchored.root
      raw = anchored.rest
    }
  } else if path.starts_with('/') {
    raw = path
  } else {
    raw = cwd() + '/' + path
  }

  # Only worth rebuilding the string when there is actually something
  # to rewrite; a separator that is already '/' is the common case.
  if raw.index_of('\\') > -1 {
    raw = raw.replace('\\', '/')
  }

  # An already-clean absolute path has no empty, '.' or '..' segment to
  # collapse, so splitting it and joining it back produces exactly what
  # came in. Skipping that round trip is what keeps this off the list of
  # things that make a per-request path check expensive.
  if root == '' and !raw.ends_with('/')
    and raw.index_of('//') == -1 and raw.index_of('/.') == -1 {
    if strict and !_os.exists(raw) {
      raise Error('path "${raw}" does not exist')
    }

    return raw
  }

  var resolved = []
  for seg in raw.split('/') {
    if seg == '' or seg == '.' {
      continue
    } else if seg == '..' {
      if !resolved.is_empty() {
        resolved.pop()
      }
    } else {
      resolved.append(seg)
    }
  }

  var result = root + _sep + _sep.join(resolved)

  if strict and !_os.exists(result) {
    raise Error('path "${result}" does not exist')
  }

  return result
}

# Splits a Windows path into the part that anchors it and the rest:
# a drive (`C:`), a UNC share (`\\\\server\\share`), or an empty root
# for a path that starts at the root of the current drive. A relative
# path has no anchor and gives `nil`.
def _windows_root(path: string) {
  var slashed = path.replace('/', '\\', false)

  if slashed.starts_with('\\\\') {
    var parts = slashed[2,].split('\\')

    if parts.length() >= 2 {
      var root = '\\\\' + parts[0] + '\\' + parts[1]

      return { root, rest: slashed[root.length(),] }
    }

    return { root: slashed, rest: '' }
  }

  if slashed.match('~^[a-zA-Z]:~') {
    return { root: slashed[,2], rest: slashed[2,] }
  }

  if slashed.starts_with('\\') {
    return { root: '', rest: slashed }
  }

  return nil
}

/**
 * Returns the parent directory of the pathname pointed to by
 * `path`. Any trailing `/` characters are not counted as part of
 * the directory name. If `path` is an empty string, or contains
 * no `/` characters, dir_name() returns the string ".",
 * signifying the current directory.
 *
 * On Windows, a drive (`C:`) or UNC share (`\\\\server\\share`) at the
 * start of `path` stays whole: the parent of `C:\\` is `C:\\` itself,
 * the parent of `C:\\work` is `C:\\`, and the parent of `C:work` is
 * `C:`. The root's parent is the root, just as `/` is its own parent
 * elsewhere, so a loop that walks up until the parent stops changing
 * ends there.
 *
 * @param string path
 * @returns string
 */
def dir_name(path: string) {
  return _os.dirname(path)
}

/**
 * The base_name() function returns the last component from the
 * pathname pointed to by `path`, deleting any trailing `/`
 * characters. If path consists entirely of `/` characters, the
 * string '/' is returned. If path is an empty string, the string
 * '.' is returned.
 *
 * @param string path
 * @returns string
 */
def base_name(path: string) {
  return _os.basename(path)
}

/**
 * Returns the relative path from `base` to `target`: the shortest
 * `.`/`..`-based path such that, starting inside `base`, following
 * it lands on `target`. Both arguments are first resolved with
 * `abs_path()`, so neither has to already be absolute or exist on
 * disk.
 *
 * Example,
 *
 * ```zuri-repl
 * %> os.relative_path('/home/user/project', '/home/user/project/src/main.zu')
 * 'src/main.zu'
 * %> os.relative_path('/home/user/project/src', '/home/user/other/lib.zu')
 * '../../other/lib.zu'
 * %> os.relative_path('/home/user/project', '/home/user/project')
 * '.'
 * ```
 *
 * @param string base
 * @param string target
 * @returns string
 */
def relative_path(base: string, target: string) {
  var base_segments = abs_path(base).split(_sep).filter(@(s) { return s != '' })
  var target_segments = abs_path(target).split(_sep).filter(@(s) { return s != '' })

  var common = 0
  while common < base_segments.length() and
        common < target_segments.length() and
        base_segments[common] == target_segments[common] {
    common++
  }

  var base_len = base_segments.length()
  var target_len = target_segments.length()

  var parts = []
  for i in common..base_len {
    parts.append('..')
  }
  for i in common..target_len {
    parts.append(target_segments[i])
  }

  return parts.is_empty() ? '.' : _sep.join(parts)
}

/**
 * Expands a leading `~` in `path` into the current user's home
 * directory, the same way a shell would before running a command.
 * A bare `~` and a `~/...`-prefixed path are both expanded; a path
 * that doesn't start with `~` is returned unchanged.
 *
 * @note expanding another user's home directory (`~other_user/...`)
 *    isn't supported; a path in that form is returned unchanged,
 *    the same fallback Python's `os.path.expanduser` uses when it
 *    can't resolve one either.
 * @param string path
 * @returns string
 */
def expand_user(path: string) {
  if path != '~' and !path.starts_with('~/') and !path.starts_with('~\\') {
    return path
  }

  var home = home_dir()
  if home == nil {
    return path
  }

  if path == '~' {
    return home
  }

  return join_paths(home, path[2,])
}

/**
 * Returns `true` if the resolved form of `candidate` is `base`
 * itself or lies somewhere underneath it, and `false` otherwise.
 * This includes when `candidate` escapes `base` via `..` segments.
 * Both paths are resolved with `abs_path()` first, so relative
 * paths and mixed separators are handled the same way `abs_path()`
 * itself handles them.
 *
 * Example,
 *
 * ```zuri-repl
 * %> os.path_contains('/home/user/project', '/home/user/project/src/main.zu')
 * true
 * %> os.path_contains('/home/user/project', '/home/user/project/../../etc/passwd')
 * false
 * ```
 *
 * @param string base
 * @param string candidate
 * @returns bool
 */
def path_contains(base: string, candidate: string) {
  var resolved_base = abs_path(base)
  var resolved_candidate = abs_path(candidate)

  return resolved_candidate == resolved_base or
    resolved_candidate.starts_with(resolved_base + _sep)
}

/**
 * The current machine user's home directory. If the home directory
 * cannot be detected, it returns `nil`.
 *
 * @returns ?string
 */
def home_dir() {
  return _os.homedir()
}

/**
 * The current working directory.
 *
 * @returns string
 */
def cwd() {
  return _os.cwd()
}

/**
 * Navigates the working directory into the specified path.
 *
 * @param string path
 * @returns bool
 */
def change_dir(path: string) {
  return _os.chdir(path)
}
