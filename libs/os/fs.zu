/**
 * @module os.fs
 *
 * Operations on directories and other filesystem entries: creating,
 * listing and removing directories, permissions and ownership, symbolic
 * links, searching `PATH` for an executable, and glob pattern matching.
 * Operations on a single file, such as reading, writing, deleting or
 * copying it, or getting its size or modification time, are methods of
 * the `file` class instead. See `file.stats()`, `file.delete()`,
 * `file.copy()` and the related methods.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import _os
import stat
import .env { get_env }
import .path { join_paths }

# File types (dirent d_type values; see `read_dir()`'s returned
# entries and `_os.readdir()`'s own d_type interpretation).

/**
 * Unknown file type
 * @type number
 */
var DT_UNKNOWN: number = _os.DT_UNKNOWN

/**
 * Block device file type
 * @type number
 */
var DT_BLK: number = _os.DT_BLK

/**
 * Character device file type
 * @type number
 */
var DT_CHR: number = _os.DT_CHR

/**
 * Directory file type
 * @type number
 */
var DT_DIR: number = _os.DT_DIR

/**
 * Named pipe file type
 * @type number
 */
var DT_FIFO: number = _os.DT_FIFO

/**
 * Symbolic link file type
 * @type number
 */
var DT_LNK: number = _os.DT_LNK

/**
 * Regular file type
 * @type number
 */
var DT_REG: number = _os.DT_REG

/**
 * Local-domain socket file type
 * @type number
 */
var DT_SOCK: number = _os.DT_SOCK

/**
 * Whiteout file type (only meaningful on UNIX and some
 * unofficial Linux versions).
 * @type number
 * @note value is `-1` on systems where it is not supported.
 */
var DT_WHT: number = _os.DT_WHT

/**
 * Creates the given directory with the specified permission and
 * optionally add new files into it if any is given.
 *
 * @note if the directory already exists, it returns `false`
 *    otherwise, it returns `true`.
 * @note permission should be given as octal number.
 * @param string path
 * @param ?int permission: Default value is `0c777`
 * @param ?bool recursive: Default value is `true`.
 * @returns boolean
 */
def create_dir(path: string, permission: ?int, recursive: ?bool) {
  if _os.platform == 'windows' {
    path = path.replace('@\/@', '\\')
  }

  if permission == nil {
    permission = 0c777
  }

  if recursive == nil {
    recursive = true
  }

  return _os.createdir(path, permission, recursive)
}

/**
 * Lists the directory, and returns the names it contains, sorted by
 * name, starting with `.` and `..`.
 *
 * For example:
 *
 * ```zuri-repl
 * %> os.read_dir('./tests')
 * [., .., buggy.zu, myprogram.zu, single_thread.zu, test.zu]
 * ```
 *
 * When `recursive` is `true`, subdirectories are listed too, and their
 * contents are returned as paths relative to `path`, not just names. A
 * directory's contents come straight after the directory itself, and
 * entries are sorted by name at every level:
 *
 * ```zuri-repl
 * %> os.read_dir('./tests', true)
 * [., .., buggy.zu, data, data/input.csv, test.zu]
 * ```
 *
 * A symbolic link to a directory is listed, but not followed, whether
 * or not it points somewhere inside `path`.
 *
 * @note `.` means the current directory, and can be passed to
 *    `os.read_dir()`.
 * @note `..` means the parent directory, and can be passed to
 *    `os.read_dir()`.
 *
 * @param string path
 * @param ?bool recursive: defaults to `false`.
 * @returns list[string]
 */
def read_dir(path: string, recursive: ?bool) {
  if recursive == nil {
    recursive = false
  }

  return _os.readdir(path, recursive)
}

/**
 * Changes the permission set on a directory to the given mode.
 * It is advisable to set the mode with an octal number (e.g.
 * 0c777) as this is consistent with operating system values.
 *
 * @param string path
 * @param int mode
 * @returns boolean
 */
def chmod(path: string, mode: int) {
  return _os.chmod(path, mode)
}

/**
 * Returns `true` if the path is a directory or `false`
 * otherwise.
 *
 * @param string path
 * @returns bool
 */
def is_dir(path: string) {
  return _os.isdir(path)
}

/**
 * Deletes a non-empty directory. If recursive is `true`,
 * non-empty directories will have their contents deleted first.
 *
 * @param string path
 * @param ?bool recursive: Default value is `false`.
 * @returns bool
 */
def remove_dir(path: string, recursive: ?bool) {
  if recursive == nil {
    recursive = false
  }
  return _os.removedir(path, recursive)
}

/**
 * Returns `true` if `path` exists and is a directory, `false`
 * otherwise (including when `path` exists but is a regular file
 * or some other non-directory entry).
 *
 * @param string path
 * @returns bool
 */
def dir_exists(path: string) {
  return _os.isdir(path)
}

/**
 * Renames the file or directory `old_name` to `new_name`.
 *
 * If `old_name` and `new_name` are existing hard links to the same
 * file, this does nothing, and reports success.
 *
 * If `old_name` is a directory, `new_name` must either not exist or be
 * an empty directory.
 *
 * If `old_name` is a symbolic link, the link itself is renamed. If
 * `new_name` is a symbolic link, the link is overwritten.
 *
 * @param string old_name
 * @param string new_name
 * @returns bool
 * @raises Error
 */
def rename(old_name: string, new_name: string) {
  return _os.rename(old_name, new_name)
}

/**
 * Changes the user and group that own `path` to `uid` and `gid`.
 *
 * @note This only works on Unix. Windows has no direct equivalent of
 *    this kind of ownership, so it raises an error there.
 * @param string path
 * @param int uid
 * @param int gid
 * @returns bool
 * @raises Error
 */
def chown(path: string, uid: int, gid: int) {
  return _os.chown(path, uid, gid)
}

/**
 * Gets or sets the process's file creation mask, which is the set of
 * permission bits removed from every file and directory that this
 * process creates from now on.
 *
 * Without an argument, or with `nil`, it returns the current mask
 * without changing it. With a mask, it sets the mask and returns the
 * previous one.
 *
 * @note This only works on Unix. Windows has no umask, so it raises an
 *    error there.
 * @param ?int mask
 * @returns int
 * @raises Error
 */
def umask(mask: ?int) {
  return _os.umask(mask)
}

/**
 * Returns `true` if `path` exists and is a symbolic link, `false`
 * otherwise (including when `path` doesn't exist at all).
 *
 * @param string path
 * @returns bool
 */
def is_symlink(path: string) {
  return _os.is_symlink(path)
}

/**
 * Returns the target `path` points to, if `path` is a symbolic
 * link. Unlike `os.real_path()`, this reads exactly one link level
 * and doesn't recursively resolve further: if the target is
 * itself a symlink, its own target is what gets returned, not the
 * final destination.
 *
 * @param string path
 * @returns string
 * @raises Error if `path` doesn't exist or isn't a symbolic link.
 */
def readlink(path: string) {
  return _os.readlink(path)
}

# Default executable extensions to check on Windows when `PATHEXT`
# isn't set in the environment, matching cmd.exe's own built-in
# default.
var _default_pathext = '.COM;.EXE;.BAT;.CMD'

def _is_executable(candidate) {
  if !file(candidate).exists() {
    return false
  }

  if _os.platform == 'windows' {
    var pathext = get_env('PATHEXT', _default_pathext).upper().split(';')
    var upper = candidate.upper()
    for ext in pathext {
      if upper.ends_with(ext) {
        return true
      }
    }
    return false
  }

  var mode = file(candidate).stats()['mode']
  return mode & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH) != 0
}

/**
 * Searches every directory in the `PATH` environment variable, in
 * order, for an executable file named `name`, the same way a shell
 * decides what running a bare command name actually runs. Returns
 * the full path to the first match, or `nil` if none of them have
 * a matching executable.
 *
 * Example,
 *
 * ```zuri-repl
 * %> os.which('git')
 * '/usr/bin/git'
 * %> os.which('does-not-exist')
 * nil
 * ```
 *
 * @param string name
 * @returns ?string
 */
def which(name: string) {
  var path_list_sep = _os.platform == 'windows' ? ';' : ':'
  var directories = get_env('PATH', '').split(path_list_sep)

  # A command is named without its extension on Windows: `sh` on the
  # PATH is `sh.exe` on disk, and the shell finds it by trying each
  # PATHEXT suffix in turn. The bare name is tried first, so a name
  # given with its extension already attached still resolves.
  var suffixes = ['']
  if _os.platform == 'windows' {
    suffixes.extend(get_env('PATHEXT', _default_pathext).split(';'))
  }

  for dir in directories {
    if dir == '' {
      continue
    }

    for suffix in suffixes {
      var candidate = join_paths(dir, name + suffix.trim())
      if _is_executable(candidate) {
        return candidate
      }
    }
  }

  return nil
}

# What a single `*` or `?` is allowed to match: anything that is not a
# path separator. Windows has two of them, and `read_dir()` spells its
# entries with the platform's own, so a class that knows only about `/`
# lets a single star run straight through a nested path there.
var _glob_not_separator = _os.platform == 'windows' ? '[^/\\\\]' : '[^/]'

def _glob_to_regex(pattern) {
  var out = '~^'
  var length = pattern.length()
  var i = 0

  while i < length {
    var ch = pattern[i]

    if ch == '*' {
      if i + 1 < length and pattern[i + 1] == '*' {
        out += '.*'
        i++
      } else {
        out += _glob_not_separator + '*'
      }
    } else if ch == '?' {
      out += _glob_not_separator
    } else if '.+()[]{}^$|\\'.contains(ch) {
      out += '\\' + ch
    } else {
      out += ch
    }

    i++
  }

  out += '$~'
  return out
}

/**
 * Returns every entry under `base_path` (the current working
 * directory if not given) whose path matches the glob `pattern`.
 *
 * `pattern` supports `*` (anything except a path separator), `?`
 * (exactly one character, except a path separator), and a doubled
 * star (anything, including path separators, for matching across
 * nested directories).
 *
 * Example,
 *
 * ```zuri-repl
 * %> os.glob('*.zu')
 * ['helper.zu', 'main.zu']
 * %> os.glob('lib?.zu')
 * ['libc.zu', 'libz.zu']
 * ```
 *
 * Matches are returned in the order `read_dir()` walks the tree,
 * which means sorted by name within each directory, with a
 * directory's own matches following it.
 *
 * @param string pattern
 * @param ?string base_path: Default is the current working
 *    directory.
 * @returns list[string]
 */
def glob(pattern: string, base_path: ?string) {
  if base_path == nil {
    base_path = '.'
  }

  var regex = _glob_to_regex(pattern)
  var matches = []

  for entry in read_dir(base_path, true) {
    if entry == '.' or entry == '..' {
      continue
    }
    if entry.match(regex) {
      matches.append(entry)
    }
  }

  return matches
}
