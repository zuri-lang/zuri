/**
 * @module os.tempfile
 *
 * Finds the platform's directory for temporary files, and creates
 * uniquely named temporary files and directories in it, without a race
 * between checking for a name and creating it. `create_temp_file()` and
 * `create_temp_dir()` reserve the path atomically, with the same
 * guarantee as the Unix `mkstemp()` family, so two callers running at
 * the same time can never get the same path.
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import _os

/**
 * The platform's directory for temporary files (e.g. `/tmp` on
 * Unix, whatever `%TEMP%` points to on Windows).
 *
 * @returns string
 */
def temp_dir() {
  return _os.tempdir()
}

/**
 * Atomically creates a new, empty file with a unique name in
 * `temp_dir()`, and returns its path. The file is created, and then
 * closed, only to reserve the name, without a race between checking
 * whether the name is taken and creating the file. This function only
 * returns the path, so open it with `file()` to read or write it.
 *
 * @note You're responsible for deleting the file, with
 *    `file(path).delete()`, once you don't need it. Temporary files
 *    aren't cleaned up automatically.
 * @param ?string prefix: defaults to `''`.
 * @param ?string suffix: defaults to `''`.
 * @returns string
 * @raises Error if a unique name couldn't be found, or the file
 *    couldn't be created.
 */
def create_temp_file(prefix: ?string, suffix: ?string) {
  if prefix == nil {
    prefix = ''
  }
  if suffix == nil {
    suffix = ''
  }
  return _os.create_temp_file(prefix, suffix)
}

/**
 * Atomically creates a new, empty directory with a unique name in
 * `temp_dir()`, and returns its path.
 *
 * @note You're responsible for removing the directory, with
 *    `os.remove_dir(path, true)`, once you don't need it. Temporary
 *    directories aren't cleaned up automatically.
 * @param ?string prefix: defaults to `''`.
 * @returns string
 * @raises Error if a unique name couldn't be found, or the directory
 *    couldn't be created.
 */
def create_temp_dir(prefix: ?string) {
  if prefix == nil {
    prefix = ''
  }
  return _os.create_temp_dir(prefix)
}
