/**
 * @module markdown.node
 *
 * The tree that `markdown.parse()` builds.
 *
 * Every node is a `Node`, and its `type` says what kind of node it is.
 * A node only has the fields that its type uses, and the rest are
 * `nil`. For example, a heading has a `level`, a link has a
 * `destination` and a `title`, and a paragraph has neither.
 *
 * ```zuri
 * import markdown
 *
 * var doc = markdown.parse('# Title\n\nSome *emphasis*.')
 *
 * doc.walk(@(node) {
 *   if node.type == 'heading' {
 *     echo '${node.level}: ${node.text_content()}'
 *   }
 * })
 * ```
 *
 * ---
 *
 * ### Block types
 *
 * | Type | Fields |
 * | --- | --- |
 * | `document` | `metadata` |
 * | `paragraph` | |
 * | `heading` | `level`, `attributes` |
 * | `thematic_break` | |
 * | `block_quote` | |
 * | `alert` | `kind` |
 * | `list` | `ordered`, `start`, `delimiter`, `bullet`, `tight` |
 * | `item` | `checked` |
 * | `code_block` | `literal`, `info`, `attributes` |
 * | `html_block` | `literal` |
 * | `table` | |
 * | `table_head`, `table_body`, `table_row` | |
 * | `table_cell` | `align` |
 * | `footnote_definition` | `label` |
 * | `definition_list` | |
 * | `term` | |
 * | `definition` | `tight` |
 * | `div` | `attributes` |
 * | `line_block`, `line` | |
 * | `math_block` | `literal` |
 * | `toc` | |
 *
 * ### Inline types
 *
 * | Type | Fields |
 * | --- | --- |
 * | `text` | `literal` |
 * | `softbreak`, `linebreak` | |
 * | `code` | `literal`, `attributes` |
 * | `emphasis`, `strong` | |
 * | `strikethrough`, `mark` | |
 * | `superscript`, `subscript` | |
 * | `link`, `image` | `destination`, `title`, `attributes` |
 * | `html_inline` | `literal` |
 * | `footnote_reference` | `label`. An inline note also has its text as children. |
 * | `span` | `attributes` |
 * | `math` | `literal`, `display` |
 * | `abbreviation` | `title` |
 * | `emoji` | `literal`, `label` |
 *
 * `line` and `end_line` are the first and last source lines of a block,
 * counting from 1. They're `nil` for inline nodes.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

var _BLOCKS = {
  document: true,
  paragraph: true,
  heading: true,
  thematic_break: true,
  block_quote: true,
  alert: true,
  list: true,
  item: true,
  code_block: true,
  html_block: true,
  table: true,
  table_head: true,
  table_body: true,
  table_row: true,
  table_cell: true,
  footnote_definition: true,
  definition_list: true,
  term: true,
  definition: true,
  div: true,
  line_block: true,
  line: true,
  math_block: true,
  toc: true,
}

/**
 * A node in a parsed Markdown document.
 *
 * Treat `children` as read-only. To change the tree, use
 * `append_child()` and the other methods of this class, which keep each
 * child's `parent_node` up to date.
 *
 * @printable
 */
class Node {

  /**
   * The kind of node, such as `'paragraph'`, `'link'` or `'text'`. The
   * module documentation lists every type and the fields it uses.
   *
   * @type string
   */
  var type = ''

  /**
   * The node that this one belongs to, or `nil` for a document or a
   * detached node.
   *
   * @type ?Node
   */
  var parent_node

  /**
   * The node's children, in document order.
   *
   * @type list
   */
  var children = []

  /**
   * The text of a `text`, `code`, `code_block`, `html_block`,
   * `html_inline`, `math`, `math_block` or `emoji` node.
   *
   * @type ?string
   */
  var literal

  /**
   * A heading's level, from 1 to 6.
   *
   * @type ?number
   */
  var level

  /**
   * The info string of a fenced code block, which is the text after the
   * opening fence, with escapes and entities resolved. It's `nil` for
   * an indented code block.
   *
   * @type ?string
   */
  var info

  /**
   * Where a link points or an image comes from, percent-encoded.
   *
   * @type ?string
   */
  var destination

  /**
   * The title of a link or image, or the expansion of an abbreviation.
   * It's empty if the source didn't give one.
   *
   * @type ?string
   */
  var title

  /**
   * Whether a list is numbered.
   *
   * @type ?bool
   */
  var ordered

  /**
   * The number an ordered list starts at.
   *
   * @type ?number
   */
  var start

  /**
   * The character after each number in an ordered list: `'.'` or `')'`.
   *
   * @type ?string
   */
  var delimiter

  /**
   * The character that each item of a bullet list starts with: `'-'`,
   * `'*'` or `'+'`.
   *
   * @type ?string
   */
  var bullet

  /**
   * Whether a list or a definition is tight. A tight one has no blank
   * lines between its parts, and its paragraphs are rendered without
   * `<p>` tags.
   *
   * @type ?bool
   */
  var tight

  /**
   * Whether a task list item is checked. It's `nil` for an item that
   * isn't a task.
   *
   * @type ?bool
   */
  var checked

  /**
   * A table cell's alignment: `'left'`, `'center'`, `'right'`, or
   * `nil` for none.
   *
   * @type ?string
   */
  var align

  /**
   * The label of a footnote, as written between `[^` and `]`, or the
   * shortcode of an emoji without its colons.
   *
   * @type ?string
   */
  var label

  /**
   * The kind of alert: `'note'`, `'tip'`, `'important'`, `'warning'` or
   * `'caution'`.
   *
   * @type ?string
   */
  var kind

  /**
   * Whether a `math` node was written with `$$`, in which case it's
   * shown on a line of its own instead of in the text.
   *
   * @type ?bool
   */
  var display

  /**
   * The HTML attributes of the node's element, from a
   * `{#id .class key=value}` block or a generated heading id. `class`
   * holds all the classes, separated by spaces.
   *
   * @type dict
   */
  var attributes = {}

  /**
   * The decoded front matter at the start of a document, or `nil` if it
   * has none.
   *
   * @type ?dict
   */
  var metadata

  /**
   * The source line that a block starts on, counting from 1.
   *
   * @type ?number
   */
  var line

  /**
   * The source line that a block ends on, counting from 1.
   *
   * @type ?number
   */
  var end_line

  /**
   * @param string type
   * @constructor
   */
  @new(type: string) {
    self.type = type
    self.children = []
    self.attributes = {}
  }

  /**
   * Whether the node is a block, such as a paragraph or a list.
   *
   * @returns bool
   */
  is_block() {
    return _BLOCKS.contains(self.type)
  }

  /**
   * Whether the node is inline, meaning part of a block's text, such as
   * emphasis or a link.
   *
   * @returns bool
   */
  is_inline() {
    return !_BLOCKS.contains(self.type)
  }

  /**
   * Returns the first child, or `nil` if there are no children.
   *
   * @returns ?Node
   */
  first_child() {
    return self.children.is_empty() ? nil : self.children[0]
  }

  /**
   * Returns the last child, or `nil` if there are no children.
   *
   * @returns ?Node
   */
  last_child() {
    return self.children.is_empty() ? nil : self.children.last()
  }

  /**
   * Returns the index of this node among its parent's children, or `-1`
   * if it has no parent.
   *
   * @returns number
   */
  index_in_parent() {
    if self.parent_node == nil {
      return -1
    }

    var siblings = self.parent_node.children

    iter var i = 0; i < siblings.length(); i++ {
      if siblings[i] == self {
        return i
      }
    }

    return -1
  }

  /**
   * Returns the next node in the same parent, or `nil` if this is the
   * last one.
   *
   * @returns ?Node
   */
  next_sibling() {
    var index = self.index_in_parent()

    if index < 0 or index + 1 >= self.parent_node.children.length() {
      return nil
    }

    return self.parent_node.children[index + 1]
  }

  /**
   * Returns the previous node in the same parent, or `nil` if this is
   * the first one.
   *
   * @returns ?Node
   */
  previous_sibling() {
    var index = self.index_in_parent()

    if index <= 0 {
      return nil
    }

    return self.parent_node.children[index - 1]
  }

  /**
   * Adds _node_ as the last child, removing it from its current parent
   * first. Returns _node_.
   *
   * @param Node node
   * @returns Node
   */
  append_child(node: Node) {
    node.detach()
    node.parent_node = self
    self.children.append(node)

    return node
  }

  /**
   * Adds _node_ as the first child, removing it from its current parent
   * first. Returns _node_.
   *
   * @param Node node
   * @returns Node
   */
  prepend_child(node: Node) {
    node.detach()
    node.parent_node = self
    self.children.insert(node, 0)

    return node
  }

  /**
   * Inserts _node_ as a child immediately before _reference_, or as the
   * last child if _reference_ is `nil`. Returns _node_.
   *
   * @param Node node
   * @param ?Node reference: a child of this node.
   * @returns Node
   * @throws ValueError If _reference_ isn't a child of this node.
   */
  insert_before(node: Node, reference: ?Node) {
    if reference == nil {
      return self.append_child(node)
    }

    if reference.parent_node != self {
      raise ValueError('the reference node is not a child of this node')
    }

    node.detach()
    node.parent_node = self
    self.children.insert(node, reference.index_in_parent())

    return node
  }

  /**
   * Inserts _node_ as a child immediately after _reference_. Returns
   * _node_.
   *
   * @param Node node
   * @param Node reference: a child of this node.
   * @returns Node
   * @throws ValueError If _reference_ isn't a child of this node.
   */
  insert_after(node: Node, reference: Node) {
    if reference.parent_node != self {
      raise ValueError('the reference node is not a child of this node')
    }

    node.detach()
    node.parent_node = self
    self.children.insert(node, reference.index_in_parent() + 1)

    return node
  }

  /**
   * Puts _node_ in this node's place in the tree, and detaches this
   * node. Returns _node_.
   *
   * @param Node node
   * @returns Node
   */
  replace_with(node: Node) {
    if self.parent_node == nil {
      return node
    }

    var owner = self.parent_node

    node.detach()
    var index = self.index_in_parent()

    owner.children[index] = node
    node.parent_node = owner
    self.parent_node = nil

    return node
  }

  /**
   * Removes this node from its parent, and returns it.
   *
   * @returns Node
   */
  detach() {
    if self.parent_node != nil {
      var index = self.index_in_parent()

      if index >= 0 {
        self.parent_node.children.remove_at(index)
      }

      self.parent_node = nil
    }

    return self
  }

  /**
   * Calls _callback_ for each node below this one, in document order.
   * If the callback returns `false`, the children of that node are
   * skipped.
   *
   * Don't add or remove nodes inside the callback. Find them with
   * `find_all()` first, and then change the tree.
   *
   * @param function callback
   */
  walk(callback: function) {
    for child in self.children {
      if callback(child) == false {
        continue
      }

      child.walk(callback)
    }
  }

  /**
   * Returns every node below this one, in document order.
   *
   * @returns list[Node]
   */
  descendants() {
    var out = []

    _collect(self, out, nil)

    return out
  }

  /**
   * Returns every node of the given _type_ below this one, in document
   * order.
   *
   * @param string type
   * @returns list[Node]
   */
  find_all(type: string) {
    var out = []

    _collect(self, out, type)

    return out
  }

  /**
   * Returns the first node of the given _type_ below this one, or `nil`
   * if there isn't one.
   *
   * @param string type
   * @returns ?Node
   */
  find(type: string) {
    for child in self.children {
      if child.type == type {
        return child
      }

      var found = child.find(type)

      if found != nil {
        return found
      }
    }

    return nil
  }

  /**
   * Returns the text of this node and its descendants, with all markup
   * removed. Line breaks become spaces, and an image is replaced by its
   * description.
   *
   * ```zuri
   * import markdown
   *
   * var doc = markdown.parse('# A *very* `fine` title')
   * echo doc.first_child().text_content()
   * # A very fine title
   * ```
   *
   * @returns string
   */
  text_content() {
    var parts = []

    _gather_text(self, parts)

    return ''.join(parts)
  }

  /**
   * Returns a copy of this node and all its descendants. The copy has
   * no parent.
   *
   * @returns Node
   */
  clone() {
    var copy = Node(self.type)

    copy.literal = self.literal
    copy.level = self.level
    copy.info = self.info
    copy.destination = self.destination
    copy.title = self.title
    copy.ordered = self.ordered
    copy.start = self.start
    copy.delimiter = self.delimiter
    copy.bullet = self.bullet
    copy.tight = self.tight
    copy.checked = self.checked
    copy.align = self.align
    copy.label = self.label
    copy.kind = self.kind
    copy.display = self.display
    copy.attributes = self.attributes.clone()
    copy.metadata = self.metadata
    copy.line = self.line
    copy.end_line = self.end_line

    for child in self.children {
      var inner = child.clone()

      inner.parent_node = copy
      copy.children.append(inner)
    }

    return copy
  }

  /**
   * Returns this node and its descendants as indented text, with one
   * node on each line. It's useful for seeing the tree while you write
   * a transform.
   *
   * ```zuri
   * import markdown
   *
   * echo markdown.parse('Hello *there*').dump()
   * # document
   * #   paragraph
   * #     text 'Hello '
   * #     emphasis
   * #       text 'there'
   * ```
   *
   * @returns string
   */
  dump() {
    var lines = []

    _dump(self, 0, lines)

    return '\n'.join(lines)
  }

  /**
   * Returns the node's type and its main field, such as `heading 2`.
   *
   * @returns string
   */
  to_string() {
    return _describe(self)
  }

  @to_string() {
    return '<markdown.Node ${_describe(self)}>'
  }
}

def _collect(node: Node, out: list, type: ?string) {
  for child in node.children {
    if type == nil or child.type == type {
      out.append(child)
    }

    _collect(child, out, type)
  }
}

def _gather_text(node: Node, parts: list) {
  for child in node.children {
    using child.type {
      when 'text', 'code', 'math', 'emoji' {
        parts.append(child.literal)
      }
      when 'softbreak', 'linebreak' {
        parts.append(' ')
      }
      when 'html_inline', 'html_block', 'footnote_reference' {}
      default {
        _gather_text(child, parts)
      }
    }
  }
}

def _describe(node: Node) {
  using node.type {
    when 'heading' {
      return 'heading ${node.level}'
    }
    when 'text', 'code', 'html_inline', 'math', 'emoji' {
      return '${node.type} ${_quote(node.literal)}'
    }
    when 'link', 'image' {
      return '${node.type} ${_quote(node.destination)}'
    }
    when 'list' {
      return node.ordered
          ? 'list ordered start=${node.start} tight=${node.tight}'
          : 'list bullet tight=${node.tight}'
    }
    when 'code_block' {
      return node.info == nil or node.info.is_empty()
          ? 'code_block'
          : 'code_block ${_quote(node.info)}'
    }
    when 'footnote_reference', 'footnote_definition' {
      return '${node.type} ${_quote(node.label)}'
    }
    when 'table_cell' {
      return node.align == nil ? 'table_cell' : 'table_cell ${node.align}'
    }
    when 'item' {
      return node.checked == nil ? 'item' : 'item checked=${node.checked}'
    }
    when 'alert' {
      return 'alert ${node.kind}'
    }
  }

  return node.type
}

def _quote(text) {
  if text == nil {
    return "''"
  }

  return "'" +
      text
          .replace('\\', '\\\\', false)
          .replace('\n', '\\n', false)
          .replace("'", "\\'", false) +
      "'"
}

def _dump(node: Node, depth: number, lines: list) {
  lines.append('  ' * depth + _describe(node))

  for child in node.children {
    _dump(child, depth + 1, lines)
  }
}
