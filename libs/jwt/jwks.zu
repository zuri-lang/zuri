/**
 * @module jwt.jwks
 *
 * `Jwks` and `verify_with_jwks()`, which find a token's signing key in
 * a JSON Web Key Set (RFC 7517) by its `kid` header, instead of using
 * one fixed secret or key.
 */

import .core { verify, header }
import .codec { * }
import .errors { AlgorithmError }

import crypto

/**
 * Parses a JSON Web Key Set document and finds individual keys by their
 * `kid`. The document is a dictionary shaped like `{ keys: [...] }`, as
 * `json.decode()` returns it for a fetched JWKS document.
 *
 * ### Example
 *
 * ```zuri
 * import jwt
 * import json
 *
 * var jwks = jwt.Jwks(json.decode(fetch_jwks_document()))
 * var payload = jwt.verify_with_jwks(token, jwks, { issuer: 'auth.example.com' })
 * ```
 */
class Jwks {

  var _keys = {}

  /**
   * @param dict jwks A decoded JWKS document: `{ keys: [...] }`.
   *    Keys without a `kid` field are ignored, since there is no
   *    way to resolve them by kid.
   * @constructor
   */
  @new(jwks: dict) {
    var keys = jwks.get('keys', [])
    for key in keys {
      var kid = key.get('kid', nil)
      if kid != nil {
        self._keys[kid] = key
      }
    }
  }

  /**
   * Returns the raw JWK dictionary for the given `kid`.
   *
   * @param string kid
   * @return dict
   * @throws AlgorithmError When no key with this `kid` is present.
   */
  find(kid: string) {
    if !self._keys.contains(kid) {
      raise AlgorithmError('no key found in JWKS for kid "${kid}"')
    }
    return self._keys[kid]
  }

  /**
   * Resolves the given `kid` and converts it to a PEM public key
   * via `crypto.jwk.to_pem()`.
   *
   * @param string kid
   * @return string PEM-encoded public key.
   * @throws AlgorithmError
   * @throws CryptoError
   */
  to_pem(kid: string) {
    return _jwk_to_pem(self.find(kid))
  }
}

# Base64url-decodes a JWK's own text fields into the raw bytes
# crypto.jwk.to_pem() expects, dispatching by kty the same way
# crypto.jwk.to_pem() itself does.
def _jwk_to_pem(jwk) {
  var kty = jwk.get('kty', nil)

  if kty == 'RSA' {
    return crypto.jwk.to_pem({
      kty: 'RSA',
      n: _b64_decode_bytes(jwk['n']),
      e: _b64_decode_bytes(jwk['e']),
    })
  }

  if kty == 'EC' {
    return crypto.jwk.to_pem({
      kty: 'EC',
      crv: jwk['crv'],
      x: _b64_decode_bytes(jwk['x']),
      y: _b64_decode_bytes(jwk['y']),
    })
  }

  if kty == 'OKP' {
    return crypto.jwk.to_pem({
      kty: 'OKP',
      crv: jwk['crv'],
      x: _b64_decode_bytes(jwk['x']),
    })
  }

  raise AlgorithmError('unsupported JWK kty "${kty}"')
}

/**
 * Verifies a token using a signing key from a JWKS document, instead of
 * a single fixed secret.
 *
 * It reads the token's `kid` header parameter, finds the matching key
 * in `jwks`, converts it to PEM, and verifies the token with it,
 * exactly as `verify()` would if that PEM were passed directly.
 *
 * @param string token
 * @param Jwks jwks
 * @param ?dict options See `verify()` for the full list. You should
 *    still set `algorithms` explicitly here, as with any other
 *    `verify()` call, because finding a key by `kid` says nothing about
 *    which algorithms it's safe to trust that key with.
 * @return dict|Token
 * @throws AlgorithmError if the token has no `kid`, or no key in `jwks`
 *    matches it.
 * @throws MalformedTokenError
 * @throws SignatureError
 * @throws TokenExpiredError
 * @throws ClaimError
 * @throws CryptoError
 */
def verify_with_jwks(token, jwks: Jwks, options) {
  var tok_header = header(token)
  var kid = tok_header.get('kid', nil)

  if kid == nil {
    raise AlgorithmError(
      'token has no kid header parameter; cannot resolve a JWKS key',
    )
  }

  var pem = jwks.to_pem(kid)
  return verify(token, pem, options)
}
