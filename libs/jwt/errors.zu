/**
 * @module jwt.errors
 *
 * The errors that the `jwt` module raises. They all inherit from
 * `JwtError`, so if you only want to catch any problem with a token,
 * you only need to catch that one class.
 */

/**
 * Base error class for all errors raised by the jwt module.
 * Catching this class will intercept any jwt-specific error.
 */
class JwtError < Error {
  /**
   * @param string message
   * @constructor
   */
  @new(message) {
    parent(message)
    self.type = 'JwtError'
  }
}

/**
 * Raised when a token cannot be decoded because its structure is
 * not valid. This includes tokens that are not three
 * dot-separated segments or that contain malformed base64url or
 * JSON.
 */
class MalformedTokenError < JwtError {
  @new(message) {
    parent(message)
    self.type = 'MalformedTokenError'
  }
}

/**
 * Raised when a token's signature does not match its header and
 * payload. This indicates the token has been tampered with or
 * was signed with a different key.
 */
class SignatureError < JwtError {
  @new(message) {
    parent(message)
    self.type = 'SignatureError'
  }
}

/**
 * Raised when a token's time claims fail validation:
 *
 * - `exp` (expiration time): the token has expired.
 * - `nbf` (not before): the token isn't valid yet.
 * - `iat` (issued at): the token was issued in the future.
 */
class TokenExpiredError < JwtError {
  @new(message) {
    parent(message)
    self.type = 'TokenExpiredError'
  }
}

/**
 * Raised when a required claim is absent from the token payload,
 * or when a registered claim (iss, aud, sub) does not match the
 * expected value.
 */
class ClaimError < JwtError {
  @new(message) {
    parent(message)
    self.type = 'ClaimError'
  }
}

/**
 * Raised when an algorithm specified in a token header is not
 * supported by this module, when the caller attempts to use the
 * none algorithm without explicitly enabling it, or when a JWKS
 * document has no key matching a token's `kid`.
 */
class AlgorithmError < JwtError {
  @new(message) {
    parent(message)
    self.type = 'AlgorithmError'
  }
}
