/**
 * @module toml
 *
 * Reads TOML for its values, or edits it in place without disturbing
 * the rest of the file.
 *
 * TOML is the format that configuration files tend to use when both
 * people and programs have to edit them. This module handles both
 * cases. `parse()` and `dump()` treat a document as data, as `json` and
 * `yaml` do. `edit()` treats it as a file that someone wrote, and keeps
 * every comment, blank line and choice of quotes through a change.
 *
 * The implementation follows TOML v1.0.0 in full.
 *
 * ```zuri
 * import toml
 *
 * var config = toml.parse('[server]\nhost = "localhost"\nport = 8080\n')
 *
 * echo config['server']['port']
 * ```
 *
 * ```console
 * 8080
 * ```
 *
 * ### How values are decoded
 *
 * | TOML | Zuri |
 * | --- | --- |
 * | string | `string` |
 * | integer | `number`, or `bigint` beyond 2^53 |
 * | float | `number` |
 * | boolean | `bool` |
 * | offset date-time | `DateTime` |
 * | local date-time | `LocalDateTime` |
 * | local date | `LocalDate` |
 * | local time | `LocalTime` |
 * | array | `list` |
 * | table | `dict` |
 *
 * Zuri's `number` is an IEEE 754 double, which is only exact up to
 * 2^53. TOML requires the full signed 64-bit range, so an integer too
 * large for a double is decoded as a `bigint`, instead of being
 * silently rounded. An integer outside the 64-bit range is a parse
 * error, as TOML requires.
 *
 * ### Integers and floats
 *
 * `1` and `1.0` are the same double, and nothing can tell them apart
 * afterwards. So when encoding, the module has to guess, and it writes
 * an integer whenever a number has no fractional part. Wrap a number in
 * `Float` to make it a float:
 *
 * ```zuri
 * import toml
 *
 * echo toml.dump({ a: 1.0, b: toml.Float(1.0) })
 * ```
 *
 * ```console
 * a = 1
 * b = 1.0
 *
 * ```
 *
 * This is the only case where a value changes type between `parse()`
 * and `dump()`. `edit()` isn't affected, because it never rewrites a
 * value that you didn't ask it to change.
 *
 * ### Editing a file in place
 *
 * `edit()` returns a `Document`, which knows the text it came from.
 * Rendering a document that nobody has changed reproduces the input
 * exactly, and an edit only changes the line it applies to:
 *
 * ```zuri
 * import toml
 *
 * var doc = toml.edit('# what we ship\n[package]\nname = "app"\nversion = "0.9.0"  # bump me\n')
 *
 * doc.set('package.version', '1.0.0')
 * doc.table('dependencies').set('http', '^2.0')
 *
 * echo doc.to_string()
 * ```
 *
 * ```console
 * # what we ship
 * [package]
 * name = "app"
 * version = "1.0.0"  # bump me
 *
 * [dependencies]
 * http = "^2.0"
 *
 * ```
 *
 * The comment, the header and the comment at the end of the changed
 * line all stayed where they were.
 *
 * @copyright 2026, Richard Ore and The Zuri Contributors
 */

import @.errors { TomlError, ParseError, EncodeError, EditError }
import @.values { DateTime, LocalDateTime, LocalDate, LocalTime, Float }
import @.document {
  Document,
  Table,
  ArrayOfTables,
  Entry,
  Value,
  Array,
  InlineTable,
}

import .parser
import .encoder

/**
 * Parses TOML text and returns it as a plain Zuri dictionary.
 *
 * A TOML document is always a table, so the result is always a
 * dictionary, empty when the text held nothing but comments.
 *
 * ```zuri
 * import toml
 *
 * var config = toml.parse('title = "example"\n[owner]\nname = "Ada"\n')
 *
 * echo config['title']
 * echo config['owner']['name']
 * ```
 *
 * ```console
 * example
 * Ada
 * ```
 *
 * @param string text The TOML text.
 * @returns dict
 * @throws ParseError On any syntax or structural error, carrying the
 *    line and column it stopped at.
 */
def parse(text: string) {
  return parser.parse(text).to_value()
}

/**
 * Reads the TOML file at `path` and returns it as a plain Zuri
 * dictionary.
 *
 * ```zuri,ignore
 * import toml
 *
 * var config = toml.load_file('zuri.toml')
 *
 * echo config['package']['name']
 * ```
 *
 * @param string path Filesystem path to the TOML file.
 * @returns dict
 * @throws ParseError On any syntax or structural error.
 * @throws Error On any file error.
 */
def load_file(path: string) {
  return parse(file(path).read())
}

/**
 * Returns `value` as TOML text.
 *
 * The result always ends with a line break. Keys are written in the
 * order the dictionary holds them, unless `sort_keys` is set.
 *
 * ```zuri
 * import toml
 *
 * echo toml.dump({
 *   title: 'example',
 *   owner: { name: 'Ada', active: true },
 *   ports: [8000, 8001],
 * })
 * ```
 *
 * ```console
 * title = "example"
 * ports = [8000, 8001]
 *
 * [owner]
 * name = "Ada"
 * active = true
 *
 * ```
 *
 * @param dict value The value to write. A TOML document is a table, so
 *    this must be a dictionary.
 * @param ?dict options `sort_keys` (default `false`) writes keys in
 *    sorted order, instead of the order they were added.
 *    `inline_threshold` (default `0`, which turns it off) writes a
 *    table with no nested tables inline, if its inline form is no
 *    longer than this many characters. `multiline_strings` (default
 *    `true`) writes a string containing a line break in triple quotes,
 *    instead of escaping the line break. `array_width` (default `80`)
 *    is the length beyond which an array is split, with one item per
 *    line.
 * @returns string
 * @throws EncodeError If `value` isn't a dictionary, contains a `nil`
 *    or a value that can't be written as TOML, has a key that isn't a
 *    string, or contains itself.
 */
def dump(value, options: ?dict) {
  return encoder.encode(value, options).to_string()
}

/**
 * Writes `value` to the file at `path` as TOML, creating or
 * overwriting it.
 *
 * ```zuri,ignore
 * import toml
 *
 * toml.dump_file('config.toml', {
 *   server: { host: '0.0.0.0', port: 8080 },
 * })
 * ```
 *
 * @param string path Filesystem path to write to.
 * @param dict value The value to write.
 * @param ?dict options The same options `dump()` takes.
 * @throws EncodeError If the value cannot be written.
 * @throws Error On any file error.
 */
def dump_file(path: string, value, options: ?dict) {
  var handle = file(path, 'w')

  handle.write(dump(value, options))
  handle.close()
}

/**
 * Parses TOML text into a `Document`, which remembers how it was
 * written.
 *
 * This is the one to reach for when the file already exists and
 * belongs to somebody. A `Document` renders back byte for byte until
 * it is changed, and a change touches only what it names.
 *
 * ```zuri
 * import toml
 *
 * var doc = toml.edit('[a]\nx = 1   # keep me\ny = 2\n')
 *
 * doc.set('a.x', 99)
 * doc.remove('a.y')
 *
 * echo doc.to_string()
 * ```
 *
 * ```console
 * [a]
 * x = 99   # keep me
 *
 * ```
 *
 * @param string text The TOML text.
 * @returns Document
 * @throws ParseError On any syntax or structural error.
 */
def edit(text: string) {
  return parser.parse(text)
}

/**
 * Reads the TOML file at `path` into a `Document`.
 *
 * `Document.save()` writes it back.
 *
 * ```zuri,ignore
 * import toml
 *
 * var doc = toml.edit_file('zuri.toml')
 *
 * doc.set('package.version', '2.0.0')
 * doc.save('zuri.toml')
 * ```
 *
 * @param string path Filesystem path to the TOML file.
 * @returns Document
 * @throws ParseError On any syntax or structural error.
 * @throws Error On any file error.
 */
def edit_file(path: string) {
  return edit(file(path).read())
}

/**
 * Builds a `Document` from a plain Zuri value.
 *
 * `dump()` is this followed by `to_string()`. Reach for this one when
 * the document is going to be edited before it is written, or when a
 * generated file should be handed to the same code that handles a
 * parsed one.
 *
 * ```zuri
 * import toml
 *
 * var doc = toml.document({ package: { name: 'app' } })
 *
 * doc.set('package.version', '0.1.0')
 *
 * echo doc.to_string()
 * ```
 *
 * ```console
 * [package]
 * name = "app"
 * version = "0.1.0"
 *
 * ```
 *
 * @param dict value The value to write.
 * @param ?dict options The same options `dump()` takes.
 * @returns Document
 * @throws EncodeError If the value cannot be written.
 */
def document(value, options: ?dict) {
  return encoder.encode(value, options)
}
