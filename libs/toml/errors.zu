/**
 * @module errors
 *
 * Every error that the `toml` module raises, with one base class.
 *
 * `TomlError` is the base class. Its three subclasses separate the
 * cases that a caller handles differently: text that isn't valid TOML,
 * a Zuri value that can't be written as TOML, and an edit that
 * conflicts with the document it was applied to.
 *
 * Each one carries details that a message alone can't. A `ParseError`
 * has the line and column where parsing stopped, an `EncodeError` has
 * the type it couldn't write, and an `EditError` has the key path it
 * couldn't follow.
 *
 * @copyright 2026, Richard Ore and The Zuri Contributors
 */

/**
 * Base class for every error this module raises.
 *
 * Catch this to catch anything `toml` can do.
 *
 * @printable
 */
class TomlError < Error {

  /**
   * @param string message Human-readable description of the fault.
   */
  @new(message) {
    parent(message)
    self.type = 'TomlError'
  }

  to_string() {
    return '<${self.type}: ${self.message}>'
  }

  @to_string() {
    return self.to_string()
  }
}

/**
 * Text that isn't valid TOML.
 *
 * `line` and `column` both count from 1, and point to the character
 * where the parser gave up, which is where the fix belongs. Both are
 * `-1` when the problem is with the document as a whole, not with one
 * position in it.
 *
 * ```zuri
 * import toml
 *
 * catch {
 *   toml.parse('key = ')
 * } as error {
 *   echo '${error.line}:${error.column} ${error.message}'
 * }
 * ```
 *
 * ```console
 * 1:7 expected a value after '='
 * ```
 *
 * @printable
 */
class ParseError < TomlError {
  var line = -1
  var column = -1

  /**
   * @param string message Human-readable description of the fault.
   * @param ?number line 1-based line, or `-1` when not applicable.
   * @param ?number column 1-based column, or `-1` when not applicable.
   */
  @new(message, line, column) {
    parent(message)

    self.type = 'ParseError'

    if line != nil {
      self.line = line
    }

    if column != nil {
      self.column = column
    }
  }

  to_string() {
    if self.line < 0 {
      return '<ParseError: ${self.message}>'
    }

    return '<ParseError: ${self.message} at ${self.line}:${self.column}>'
  }
}

/**
 * A Zuri value that can't be written as TOML.
 *
 * TOML has no null, so a `nil` anywhere in a value raises this, instead
 * of being written as something that reads back differently. The same
 * applies to a function, a class, a structure that contains itself, and
 * a dictionary key that isn't a string.
 *
 * `path` is the dotted key path of the value that caused the error, so
 * a problem deep inside a structure can be found without searching.
 *
 * @printable
 */
class EncodeError < TomlError {
  var path = ''

  /**
   * @param string message Human-readable description of the fault.
   * @param ?string path Dotted key path to the offending value.
   */
  @new(message, path) {
    parent(message)

    self.type = 'EncodeError'

    if path != nil {
      self.path = path
    }
  }

  to_string() {
    if self.path == '' {
      return '<EncodeError: ${self.message}>'
    }

    return "<EncodeError: ${self.message} at '${self.path}'>"
  }
}

/**
 * An edit that the document can't accept.
 *
 * It's raised when a key path goes through something that isn't a
 * table, such as `set('a.b', 1)` on a document where `a` is a string,
 * and when a path is malformed or empty.
 *
 * `path` is the whole dotted path as it was given, so the message names
 * what the caller asked for, not just the part that failed.
 *
 * @printable
 */
class EditError < TomlError {
  var path = ''

  /**
   * @param string message Human-readable description of the fault.
   * @param ?string path The dotted key path the edit was applied to.
   */
  @new(message, path) {
    parent(message)

    self.type = 'EditError'

    if path != nil {
      self.path = path
    }
  }

  to_string() {
    if self.path == '' {
      return '<EditError: ${self.message}>'
    }

    return "<EditError: ${self.message} at '${self.path}'>"
  }
}
