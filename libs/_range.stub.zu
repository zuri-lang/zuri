/**
 * # Ranges
 *
 * A range is a sequence of numbers that you can loop over. It's written
 * `start..end`, and includes `start` but stops before `end`.
 *
 * For example:
 *
 * ```zuri-repl
 * %> 0..10
 * <range 0..10, step=1>
 * %> 10..5
 * <range 10..5, step=1>
 * ```
 *
 * A range can count up or down: when `start` is greater than `end`, it
 * counts down. The ends can be variables or any other expressions:
 *
 * ```zuri-repl
 * %> var a = 20
 * %> 5..a
 * <range 5..20, step=1>
 * %> a..10
 * <range 20..10, step=1>
 * ```
 *
 * > To call a method on a range, put the range in parentheses,
 * > as in `(0..10).step(2)`. Without them, the method call is
 * > applied to the end value, not to the range.
 */

class range {

  /**
   * Returns the lower limit of the range.
   *
   * For example:
   *
   * ```zuri-repl
   * %> (10..100).lower()
   * 10
   * ```
   *
   * @returns {number}
   */
  lower() {}

  /**
   * Returns the upper limit of the range.
   *
   * For example:
   *
   * ```zuri-repl
   * %> (20..30).upper()
   * 30
   * ```
   *
   * @returns {number}
   */
  upper() {}

  /**
   * Returns the distance between the two limits of the range.
   *
   * For example:
   *
   * ```zuri-repl
   * %> (21..93).range()
   * 72
   * ```
   *
   * The result is the same whichever direction the range goes in, so
   * swapping the limits gives the same result:
   *
   * ```zuri-repl
   * %> (93..21).range()
   * 72
   * ```
   *
   * @returns {number}
   */
  range() {}

  /**
   * Returns `true` if _value_ is between the two limits of the range,
   * including the limits themselves, and `false` otherwise.
   *
   * For example:
   *
   * ```zuri-repl
   * %> (93..21).within(103)
   * false
   * %> (93..21).within(57)
   * true
   * ```
   *
   * @param {number} value
   * @returns {boolean}
   */
  within(value: number) {}

  /**
   * Sets the step size of the range.
   *
   * For example:
   *
   * ```zuri-repl
   * %> var a = (10..100).step(20)
   * %> a
   * <range 10..100, step=20>
   * %> for i in a {
   * ..   echo i
   * .. }
   * 10
   * 30
   * 50
   * 70
   * 90
   * ```
   *
   * @param {int} size The step size of the range.
   * @returns {range}
   */
  step(size: int) {}

  /**
   * Returns the step size of the range.
   *
   * @returns {number}
   */
  get_step() {}

  /**
   * Calls `callback` for each number in the range, with the number and
   * its index.
   *
   * @param {function} callback A function that takes two arguments, the
   *    number and its index.
   * @throws {Error} if the callback isn't a function.
   * @return void
   *
   * Example:
   *
   * ```zuri
   * var r = 0..5 # 0, 1, 2, 3, 4
   * r.loop(@(num, index) {
   *   echo 'Number at index ${index}: ${num}'
   * })
   *
   * # Output:
   * # Number at index 0: 0
   * # Number at index 1: 1
   * # Number at index 2: 2
   * # Number at index 3: 3
   * # Number at index 4: 4
   * ```
   */
  loop(callback: function) {}

  /**
   * Returns the range as a list of its individual numbers,
   * stepping from the lower limit to the upper limit
   * (exclusive), or in reverse when the range descends.
   *
   * ```zuri-repl
   * %> (1..5).to_list()
   * [1, 2, 3, 4]
   * %> (5..1).to_list()
   * [5, 4, 3, 2]
   * ```
   *
   * @returns {list}
   */
  to_list() {}

  /**
   * Returns the string representation of the range.
   *
   * ```zuri-repl
   * %> (1..5).to_string()
   * '1..5'
   * ```
   *
   * @returns {string}
   */
  to_string() {}

  @value(n) {}
  @key(n) {}
}
