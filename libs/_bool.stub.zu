/**
 * # Booleans
 *
 * A `bool` is one of the two truth values, `true` and `false`. Booleans
 * are objects with methods, like every other value in Zuri, but they
 * only have a few.
 *
 * ```zuri-repl
 * %> true.to_string()
 * 'true'
 * ```
 */

class bool {

  /**
   * Returns the string representation of the boolean.
   *
   * ```zuri-repl
   * %> true.to_string()
   * 'true'
   * %> false.to_string()
   * 'false'
   * ```
   *
   * @returns {string}
   */
  to_string() {}
}
