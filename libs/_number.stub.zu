/**
 * # Numbers
 *
 * Every number in Zuri, whole or fractional, has the same type,
 * `number`, which is an IEEE 754 double-precision float. There are no
 * separate `int` and `float` types, so `5` and `5.0` are exactly the
 * same value.
 *
 * Numbers are objects with methods, like every other value in Zuri, so
 * you can write `n.abs()` or `2.factorial()` directly, instead of
 * calling a separate `abs(n)` function.
 *
 * For example:
 *
 * ```zuri-repl
 * %> (-5).abs()
 * 5
 * %> 16.sqrt()
 * 4
 * %> 5.factorial()
 * 120
 * ```
 *
 * > `-5.abs()` is `-5`, not `5`. The minus sign isn't part of
 * > the literal. It applies to whatever follows it, so the
 * > method runs first and the sign is applied to its result.
 * > Write `(-5).abs()` when the method should see the negative
 * > value. This is the normal precedence of unary minus, and it
 * > applies to any expression, not only to literals.
 *
 * ## Precision
 *
 * Because every number is an IEEE 754 double, integers are only exact
 * up to 2^53. Arithmetic beyond that rounds, as it does in every
 * language with double-precision numbers. When you need exact integers
 * of any size, use a `bigint`. An integer literal that's too large for
 * a signed 64-bit integer becomes a `bigint` automatically.
 */

class number {

  /**
   * Returns the string representation of the number.
   *
   * ```zuri-repl
   * %> 5.to_string()
   * '5'
   * ```
   *
   * @returns {string}
   */
  to_string() {}

  /**
   * Converts the number to a boolean, by the same rule `if` uses.
   * Zero (either sign) and `NaN` are `false`, and every other
   * number, negative ones included, is `true`.
   *
   * ```zuri-repl
   * %> 5.to_bool()
   * true
   * %> 0.to_bool()
   * false
   * %> (-5).to_bool()
   * true
   * %> (0 / 0).to_bool()
   * false
   * ```
   *
   * @returns {boolean}
   */
  to_bool() {}

  /**
   * Converts the number to a `bigint`. This is the counterpart of
   * `bigint.to_number()`.
   *
   * ```zuri-repl
   * %> 12345.to_bigint()
   * 12345n
   * %> 2.to_bigint() ** 100.to_bigint()
   * 1267650600228229401496703205376n
   * ```
   *
   * @note Only an exact integer can be converted to a `bigint`, so a
   *    fractional number, `Infinity` and `NaN` all raise an error,
   *    instead of being rounded or clamped. A number above `2^53` is
   *    already imprecise as a double, so converting it gives the exact
   *    integer that the double holds, not the decimal literal it was
   *    written as.
   * @returns {bigint}
   * @raises {RangeError} if the number isn't an exact integer.
   */
  to_bigint() {}

  /**
   * Returns the absolute value of the number.
   *
   * ```zuri-repl
   * %> (-5).abs()
   * 5
   * %> 5.abs()
   * 5
   * ```
   *
   * @returns {number}
   */
  abs() {}

  /**
   * Returns the Unicode character whose code point is equal to
   * the number.
   *
   * ```zuri-repl
   * %> 65.chr()
   * 'A'
   * ```
   *
   * @returns {string}
   */
  chr() {}

  /**
   * Converts the number to a string of binary digits. The number is
   * truncated to an integer first.
   *
   * ```zuri-repl
   * %> 10.bin()
   * '1010'
   * ```
   *
   * @note A negative number always returns `'0'`. There's no signed or
   *    two's complement form.
   * @returns {string}
   */
  bin() {}

  /**
   * Converts the number to a string of hexadecimal digits. The number
   * is truncated to an integer first.
   *
   * ```zuri-repl
   * %> 255.hex()
   * 'ff'
   * ```
   *
   * @note A negative number always returns `'0'`. There's no signed or
   *    two's complement form.
   * @returns {string}
   */
  hex() {}

  /**
   * Converts the number to a string of octal digits. The number is
   * truncated to an integer first.
   *
   * ```zuri-repl
   * %> 8.oct()
   * '10'
   * ```
   *
   * @note A negative number always returns `'0'`. There's no signed or
   *    two's complement form.
   * @returns {string}
   */
  oct() {}

  /**
   * Truncates the number to its integer part, discarding anything after
   * the decimal point. Unlike `floor()`, this rounds toward zero, not
   * toward negative infinity, so the result for a negative number is
   * different from `floor()`.
   *
   * ```zuri-repl
   * %> 3.9.int()
   * 3
   * %> (-3.9).int()
   * -3
   * ```
   *
   * @returns {number}
   */
  int() {}

  /**
   * Returns the larger of the number and _other_.
   *
   * A `NaN` never wins: when one of the two is `NaN`, the other is
   * returned, and only two `NaN`s give `NaN`. `-0` counts as smaller
   * than `0`, so `(-0.0).max(0)` is `0` whichever side the zeros are on.
   *
   * ```zuri-repl
   * %> 5.max(9)
   * 9
   * %> 9.max(5)
   * 9
   * %> (0 / 0).max(3)
   * 3
   * %> (-0.0).max(0)
   * 0
   * ```
   *
   * @param {number} other The number to compare against.
   * @returns {number}
   */
  max(other: number) {}

  /**
   * Returns the smaller of the number and _other_.
   *
   * A `NaN` never wins: when one of the two is `NaN`, the other is
   * returned, and only two `NaN`s give `NaN`. `-0` counts as smaller
   * than `0`, so `0.min(-0.0)` is `-0` whichever side the zeros are on.
   *
   * ```zuri-repl
   * %> 5.min(9)
   * 5
   * %> 9.min(5)
   * 5
   * %> (0 / 0).min(3)
   * 3
   * %> 0.min(-0.0)
   * -0
   * ```
   *
   * @param {number} other The number to compare against.
   * @returns {number}
   */
  min(other: number) {}

  /**
   * Returns the factorial of the number, which is the product of every
   * positive integer up to and including it. `0.factorial()` is `1`, as
   * in the standard mathematical definition.
   *
   * ```zuri-repl
   * %> 5.factorial()
   * 120
   * %> 0.factorial()
   * 1
   * ```
   *
   * @throws {Error} if the number is negative or isn't a whole number.
   * @returns {number}
   */
  factorial() {}

  /**
   * Returns the sine of the number, taken to be in radians.
   *
   * @returns {number}
   */
  sin() {}

  /**
   * Returns the cosine of the number, taken to be in radians.
   *
   * @returns {number}
   */
  cos() {}

  /**
   * Returns the tangent of the number, taken to be in radians.
   *
   * @returns {number}
   */
  tan() {}

  /**
   * Returns the hyperbolic sine of the number.
   *
   * @returns {number}
   */
  sinh() {}

  /**
   * Returns the hyperbolic cosine of the number.
   *
   * @returns {number}
   */
  cosh() {}

  /**
   * Returns the hyperbolic tangent of the number.
   *
   * @returns {number}
   */
  tanh() {}

  /**
   * Returns the arcsine (inverse sine) of the number, in radians.
   *
   * @note It's only defined for a number from `-1` to `1`. Outside that
   *    range, this returns `NaN` instead of raising an error.
   * @returns {number}
   */
  asin() {}

  /**
   * Returns the arccosine (inverse cosine) of the number, in radians.
   *
   * @note It's only defined for a number from `-1` to `1`. Outside that
   *    range, this returns `NaN` instead of raising an error.
   * @returns {number}
   */
  acos() {}

  /**
   * Returns the arctangent (inverse tangent) of the number, in
   * radians.
   *
   * @returns {number}
   */
  atan() {}

  /**
   * Returns the four-quadrant arctangent of the number and _x_,
   * in radians. The receiver is treated as the y-coordinate and
   * _x_ as the x-coordinate, matching the conventional `atan2(y,
   * x)` signature: `y.atan2(x)`.
   *
   * ```zuri-repl
   * %> 1.0.atan2(1.0)
   * 0.7853981633974483
   * ```
   *
   * @param {number} x The x-coordinate.
   * @returns {number}
   */
  atan2(x: number) {}

  /**
   * Returns the inverse hyperbolic sine of the number.
   *
   * @returns {number}
   */
  asinh() {}

  /**
   * Returns the inverse hyperbolic cosine of the number.
   *
   * @note It's only defined for a number greater than or equal to `1`.
   *    Below that, this returns `NaN` instead of raising an error.
   * @returns {number}
   */
  acosh() {}

  /**
   * Returns the inverse hyperbolic tangent of the number.
   *
   * @note It's only defined for a number greater than `-1` and less
   *    than `1`. Outside that range, this returns `NaN` instead of
   *    raising an error.
   * @returns {number}
   */
  atanh() {}

  /**
   * Returns _e_ (Euler's number) raised to the power of the
   * number.
   *
   * @returns {number}
   */
  exp() {}

  /**
   * Returns _e_ raised to the power of the number, minus `1`. For a
   * number close to zero, this is more accurate than calculating
   * `n.exp() - 1`.
   *
   * @returns {number}
   */
  expm1() {}

  /**
   * Returns the natural logarithm (base _e_) of the number.
   *
   * ```zuri-repl
   * %> 1.0.log()
   * 0
   * ```
   *
   * @returns {number}
   */
  log() {}

  /**
   * Returns the base-2 logarithm of the number.
   *
   * ```zuri-repl
   * %> 8.0.log2()
   * 3
   * ```
   *
   * @returns {number}
   */
  log2() {}

  /**
   * Returns the base-10 logarithm of the number.
   *
   * ```zuri-repl
   * %> 100.0.log10()
   * 2
   * ```
   *
   * @returns {number}
   */
  log10() {}

  /**
   * Returns the natural logarithm of `1` plus the number. For a
   * number close to zero, this is more numerically accurate than
   * computing `(1 + n).log()` directly.
   *
   * @returns {number}
   */
  log1p() {}

  /**
   * Returns the cube root of the number.
   *
   * ```zuri-repl
   * %> 27.0.cbrt()
   * 3
   * ```
   *
   * @returns {number}
   */
  cbrt() {}

  /**
   * Returns the square root of the number.
   *
   * ```zuri-repl
   * %> 16.sqrt()
   * 4
   * ```
   *
   * @note For a negative number, this returns `NaN` instead of raising
   *    an error. There's no conversion to complex numbers. If the
   *    difference matters, check `is_nan()` on the result, or check the
   *    sign of the number first.
   * @returns {number}
   */
  sqrt() {}

  /**
   * Returns the sign of the number: `1` if it is positive, `-1`
   * if it is negative, and `0` (with its own original sign
   * preserved) if it is zero.
   *
   * ```zuri-repl
   * %> 7.sign()
   * 1
   * %> (-7).sign()
   * -1
   * %> 0.sign()
   * 0
   * ```
   *
   * @returns {number}
   */
  sign() {}

  /**
   * Returns the smallest whole number greater than or equal to
   * the number.
   *
   * ```zuri-repl
   * %> 3.14159.ceil()
   * 4
   * ```
   *
   * @returns {number}
   */
  ceil() {}

  /**
   * Rounds the number to the nearest whole number. A value
   * exactly halfway between two whole numbers rounds away from
   * zero.
   *
   * ```zuri-repl
   * %> 3.14159.round()
   * 3
   * %> 3.6.round()
   * 4
   * ```
   *
   * @returns {number}
   */
  round() {}

  /**
   * Returns the largest whole number less than or equal to the
   * number.
   *
   * ```zuri-repl
   * %> 3.14159.floor()
   * 3
   * ```
   *
   * @returns {number}
   */
  floor() {}

  /**
   * Returns `true` if the number is NaN (not a number), such as the
   * result of `0/0`, and `false` otherwise.
   *
   * @returns {boolean}
   */
  is_nan() {}

  /**
   * Returns `true` if the number is positive or negative
   * infinity, `false` otherwise.
   *
   * @returns {boolean}
   */
  is_inf() {}

  /**
   * Returns `true` if the number is neither infinite nor NaN,
   * `false` otherwise.
   *
   * @returns {boolean}
   */
  is_finite() {}

  /**
   * Truncates the number toward zero, discarding anything after the
   * decimal point. For a value that fits in a 64-bit integer, this
   * gives the same result as `int()`. Unlike `int()`, `trunc()` works
   * entirely in floating point, without converting to an integer, so it
   * doesn't overflow for a number too large for a 64-bit integer.
   *
   * ```zuri-repl
   * %> (-3.9).trunc()
   * -3
   * ```
   *
   * @returns {number}
   */
  trunc() {}

  /**
   * Returns the digits after the decimal point as a whole number, not
   * as a fraction. This isn't the same as `(n - n.int())`:
   * `1.92.fraction()` is `92`, not `0.92`.
   *
   * ```zuri-repl
   * %> 1.92.fraction()
   * 92
   * %> 1.5.fraction()
   * 5
   * %> 5.fraction()
   * 0
   * ```
   *
   * @returns {number}
   */
  fraction() {}

  /**
   * Returns the number rounded to _n_ decimal places, with a half
   * rounding away from zero the same way `round()` does.
   *
   * A number already shorter than _n_ places is returned unchanged, and
   * so are `NaN` and the infinities. Beyond 17 places an `f64` has no
   * digits left to round, so a larger _n_ behaves as 17.
   *
   * ```zuri-repl
   * %> 1.554576852757686786786.fixed(9)
   * 1.554576853
   * %> 1.554576852757686786786.fixed(8)
   * 1.55457685
   * %> 1.554576852757686786786.fixed(1)
   * 1.6
   * %> 1.554576852757686786786.fixed(0)
   * 2
   * %> (-2.5).fixed(0)
   * -3
   * ```
   */
  fixed(n) {}
}
