/**
 * # Bigints
 *
 * A `bigint` is an integer of any size. A `number` is an IEEE 754
 * double, so it's only exact up to `2^53`, but a bigint grows to
 * whatever size the value needs and stays exact.
 *
 * To write one, add `n` to the end of an integer literal:
 *
 * ```zuri-repl
 * %> 2n ** 100n
 * 1267650600228229401496703205376n
 * %> 100n / 7n
 * 14n
 * ```
 *
 * An integer literal too large for a signed 64-bit integer becomes a
 * bigint automatically, even without the `n`, so a value that couldn't
 * have been stored as a `number` is never silently rounded:
 *
 * ```zuri-repl
 * %> 99999999999999999999999999
 * 99999999999999999999999999n
 * ```
 *
 * ## Mixing bigints and numbers
 *
 * The arithmetic operators don't mix the two types. `2n * 3` raises a
 * `TypeError` instead of converting one of the values, because
 * converting would mean guessing whether you wanted exactness or speed.
 * Convert explicitly, with `number.to_bigint()` in one direction and
 * `bigint.to_number()` in the other:
 *
 * ```zuri-repl
 * %> 2n * 3.to_bigint()
 * 6n
 * %> 6n.to_number() * 3
 * 18
 * ```
 *
 * ## Division
 *
 * There are no fractional bigints, so `/` truncates toward zero and
 * `//` rounds down, which is what the two operators mean for integers:
 *
 * ```zuri-repl
 * %> -7n / 2n
 * -3n
 * %> -7n // 2n
 * -4n
 * ```
 *
 * Dividing by zero with `/`, `//` or `%` raises a `RangeError`, instead
 * of producing an infinity as a `number` does.
 *
 * ## Type checks
 *
 * `is_number()` and `is_int()` both return `false` for a bigint, even
 * though it holds an integer. Use `is_bigint()` instead.
 *
 * `bigint` can also be used as a parameter type, and it follows the
 * same rule as the operators: a parameter typed `bigint` rejects a
 * plain number, and a parameter typed `number` rejects a bigint.
 *
 * ```zuri
 * def scale(n: bigint, factor: number) {
 *   return n * factor.to_bigint()
 * }
 *
 * scale(2n, 50)   # 100n
 * scale(2, 50)    # TypeError: parameter 'n' must be a bigint
 * ```
 *
 * If a function really does accept either, annotate the parameter as
 * `bigint|number` and convert inside the function.
 */

class bigint {

  /**
   * Returns the decimal digits of the bigint, with a leading `-` if
   * it's negative and without the trailing `n`. Pass `radix` to use
   * another base, with lowercase letters for digits above nine.
   *
   * ```zuri-repl
   * %> 255n.to_string()
   * '255'
   * %> 255n.to_string(16)
   * 'ff'
   * %> (-255n).to_string(16)
   * '-ff'
   * ```
   *
   * @note The `n` that `echo` and string interpolation show is part of
   *    how a bigint is displayed, not part of the conversion.
   *    `to_string()` never includes it.
   * @param {number} radix - the base to use, from 2 to 36. Defaults to
   *    10.
   * @returns {string}
   * @raises {RangeError} if `radix` is outside 2 to 36.
   */
  to_string(radix) {}

  /**
   * Converts the bigint to a `number`.
   *
   * ```zuri-repl
   * %> 6n.to_number()
   * 6
   * ```
   *
   * @note This loses precision for anything above `2^53`, because the
   *    result is the nearest double. A value beyond the range of a
   *    double becomes `inf` or `-inf`, instead of wrapping around or
   *    becoming zero. Check `bits()` first if that matters.
   * @returns {number}
   */
  to_number() {}

  /**
   * Converts the bigint to a boolean, by the same rule `if` uses.
   * `0n` is `false`, and every other bigint, negative ones
   * included, is `true`.
   *
   * ```zuri-repl
   * %> 5n.to_bool()
   * true
   * %> 0n.to_bool()
   * false
   * %> (-5n).to_bool()
   * true
   * ```
   *
   * @returns {boolean}
   */
  to_bool() {}

  /**
   * Returns the bigint as bytes in two's complement, which includes the
   * sign, so the bytes convert back to the same value. The result is
   * the shortest byte string that can hold the value, and it's never
   * empty: zero is a single `0x00` byte.
   *
   * ```zuri-repl
   * %> 258n.to_bytes()
   * (01 02)
   * %> 258n.to_bytes('little')
   * (02 01)
   * %> (-1n).to_bytes()
   * (ff)
   * ```
   *
   * @param {string} order - `'big'` or `'little'`. Defaults to `'big'`.
   * @returns {bytes}
   * @raises {RangeError} if `order` is neither `'big'` nor `'little'`.
   */
  to_bytes(order) {}

  /**
   * Returns the binary digits of the bigint. This is the same as
   * `to_string(2)`.
   *
   * ```zuri-repl
   * %> 255n.bin()
   * '11111111'
   * ```
   *
   * @note This uses sign and magnitude, so a negative bigint is
   *    returned with a leading `-`, not in two's complement. Use
   *    `to_bytes()` for two's complement.
   * @returns {string}
   */
  bin() {}

  /**
   * Returns the base-16 digits in lowercase, equivalent to
   * `to_string(16)`.
   *
   * ```zuri-repl
   * %> 255n.hex()
   * 'ff'
   * ```
   *
   * @returns {string}
   */
  hex() {}

  /**
   * Returns the base-8 digits, equivalent to `to_string(8)`.
   *
   * ```zuri-repl
   * %> 255n.oct()
   * '377'
   * ```
   *
   * @returns {string}
   */
  oct() {}

  /**
   * Returns the absolute value.
   *
   * ```zuri-repl
   * %> (-5n).abs()
   * 5n
   * ```
   *
   * @returns {bigint}
   */
  abs() {}

  /**
   * Returns the sign as a plain `number`: `1` when positive,
   * `-1` when negative and `0` for zero.
   *
   * ```zuri-repl
   * %> (-9n).sign()
   * -1
   * %> 0n.sign()
   * 0
   * ```
   *
   * @returns {number}
   */
  sign() {}

  /**
   * Returns the larger of the two bigints.
   *
   * ```zuri-repl
   * %> 3n.max(7n)
   * 7n
   * ```
   *
   * @param {bigint} other
   * @returns {bigint}
   * @raises {TypeError} if `other` is not a bigint.
   */
  max(other) {}

  /**
   * Returns the smaller of the two bigints.
   *
   * ```zuri-repl
   * %> 3n.min(7n)
   * 3n
   * ```
   *
   * @param {bigint} other
   * @returns {bigint}
   * @raises {TypeError} if `other` is not a bigint.
   */
  min(other) {}

  /**
   * Raises the bigint to the power `exponent`. This is the method form
   * of `**`.
   *
   * ```zuri-repl
   * %> 2n.pow(100)
   * 1267650600228229401496703205376n
   * ```
   *
   * @param {number|bigint} exponent - an integer from 0 to 2^32 - 1. A
   *    negative exponent has no integer result, so it's rejected
   *    instead of being truncated to zero.
   * @returns {bigint}
   * @raises {RangeError} if `exponent` is negative, fractional or too
   *    large.
   */
  pow(exponent) {}

  /**
   * Returns the integer square root, truncated toward zero, so
   * `145n.sqrt()` is `12n`, not `12.04...`.
   *
   * ```zuri-repl
   * %> 144n.sqrt()
   * 12n
   * %> 145n.sqrt()
   * 12n
   * ```
   *
   * @returns {bigint}
   * @raises {RangeError} if the bigint is negative.
   */
  sqrt() {}

  /**
   * Returns the integer cube root, truncated towards zero.
   * Negatives are fine here, unlike `sqrt()`.
   *
   * ```zuri-repl
   * %> (-27n).cbrt()
   * -3n
   * ```
   *
   * @returns {bigint}
   */
  cbrt() {}

  /**
   * Returns the integer `n`th root, truncated toward zero.
   *
   * ```zuri-repl
   * %> 1000000n.nth_root(3)
   * 100n
   * ```
   *
   * @param {number|bigint} n - an integer from 1 to 2^32 - 1.
   * @returns {bigint}
   * @raises {RangeError} if `n` is zero, negative, fractional or too
   *    large, or if `n` is even and the bigint is negative.
   */
  nth_root(n) {}

  /**
   * Returns the greatest common divisor of the two bigints. The
   * result is always non-negative regardless of either sign, and
   * `0n.gcd(0n)` is `0n`.
   *
   * ```zuri-repl
   * %> 48n.gcd(18n)
   * 6n
   * ```
   *
   * @param {bigint} other
   * @returns {bigint}
   * @raises {TypeError} if `other` is not a bigint.
   */
  gcd(other) {}

  /**
   * Returns the least common multiple of the two bigints. The
   * result is always non-negative, and is `0n` when either side
   * is zero.
   *
   * ```zuri-repl
   * %> 48n.lcm(18n)
   * 144n
   * ```
   *
   * @param {bigint} other
   * @returns {bigint}
   * @raises {TypeError} if `other` is not a bigint.
   */
  lcm(other) {}

  /**
   * Returns `(self ** exponent) % modulus` without computing the full
   * power, so it works with the very large exponents that cryptography
   * uses.
   *
   * ```zuri-repl
   * %> 4n.modpow(13n, 497n)
   * 445n
   * ```
   *
   * @note The remainder is floored, not truncated, so the result has
   *    the sign of `modulus`, not of the receiver. A negative
   *    `exponent` is only allowed if the receiver has an inverse modulo
   *    `modulus`.
   * @param {bigint} exponent
   * @param {bigint} modulus - must not be zero.
   * @returns {bigint}
   * @raises {TypeError} if either argument isn't a bigint.
   * @raises {RangeError} if `modulus` is zero, or if `exponent` is
   *    negative and there's no modular inverse.
   */
  modpow(exponent, modulus) {}

  /**
   * Returns the modular multiplicative inverse, which is the `x` for
   * which `self * x == 1 (mod modulus)`.
   *
   * ```zuri-repl
   * %> 3n.modinv(11n)
   * 4n
   * %> 4n.modinv(8n)
   * nil
   * ```
   *
   * @note If the receiver and `modulus` aren't coprime, this returns
   *    `nil` instead of raising an error, because having no inverse is
   *    an ordinary result, not a mistake by the caller. The result has
   *    the sign of `modulus`.
   * @param {bigint} modulus - must not be zero.
   * @returns {bigint|nil}
   * @raises {TypeError} if `modulus` isn't a bigint.
   * @raises {RangeError} if `modulus` is zero.
   */
  modinv(modulus) {}

  /**
   * Returns how many bits the magnitude occupies, ignoring the
   * sign. Zero occupies none.
   *
   * ```zuri-repl
   * %> 255n.bits()
   * 8
   * %> 0n.bits()
   * 0
   * ```
   *
   * @returns {number}
   */
  bits() {}

  /**
   * Returns whether the bit at `index` is set, counting from the least
   * significant bit, which is at index 0.
   *
   * ```zuri-repl
   * %> 5n.bit(0)
   * true
   * %> 5n.bit(1)
   * false
   * ```
   *
   * @note The bigint is read as two's complement, so a negative bigint
   *    reports `true` for every index above its magnitude, instead of
   *    running out of bits.
   * @param {number} index - a non-negative integer.
   * @returns {boolean}
   * @raises {RangeError} if `index` is negative or fractional.
   */
  bit(index) {}

  /**
   * Returns a new bigint with the bit at `index` set or cleared. The
   * original bigint isn't changed.
   *
   * ```zuri-repl
   * %> 5n.set_bit(1, true)
   * 7n
   * ```
   *
   * @param {number} index - a non-negative integer.
   * @param {boolean} value
   * @returns {bigint}
   * @raises {RangeError} if `index` is negative or fractional.
   */
  set_bit(index, value) {}

  /**
   * Returns the count of least-significant zero bits, which is
   * the largest power of two dividing the bigint.
   *
   * ```zuri-repl
   * %> 40n.trailing_zeros()
   * 3
   * %> 0n.trailing_zeros()
   * nil
   * ```
   *
   * @note Returns `nil` for zero, which has no largest such power
   *    and would otherwise have to report an arbitrary number.
   * @returns {number|nil}
   */
  trailing_zeros() {}

  /**
   * Returns whether the bigint is zero.
   *
   * ```zuri-repl
   * %> 0n.is_zero()
   * true
   * ```
   *
   * @returns {boolean}
   */
  is_zero() {}

  /**
   * Returns whether the bigint is even. Zero is even.
   *
   * ```zuri-repl
   * %> 4n.is_even()
   * true
   * ```
   *
   * @returns {boolean}
   */
  is_even() {}

  /**
   * Returns whether the bigint is odd.
   *
   * ```zuri-repl
   * %> 5n.is_odd()
   * true
   * ```
   *
   * @returns {boolean}
   */
  is_odd() {}
}
