/**
 * @module base64
 *
 * Encodes binary data as text, and decodes it again, using the base64
 * encoding defined in [RFC
 * 4648](https://datatracker.ietf.org/doc/html/rfc4648).
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

/**
 * Encodes a byte array into a base64 string
 *
 * @param bytes data
 * @returns string
 */
def encode(data: bytes) {}

/**
 * Decodes a base64 string into it's corresponding bytes.
 *
 * @param string data
 * @returns bytes
 */
def decode(data: string) {}
