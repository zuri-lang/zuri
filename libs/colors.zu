/**
 * @module colors
 *
 * This module provides functionalities for color conversion and
 * manipulation.
 *
 * This module also provides functionalities that enable
 * cross-platform colored terminal outputs that will allow you
 * create beautiful console apps that are user friendly.
 *
 * RGB conversion to other colors that return a floating point or
 * a list of floating points do so to allow users get absolute
 * precision since its really easy for callers to do a
 * `num.round()` on the components of the resulting list.
 *
 * ### Example
 *
 * The example below uses this module to create a success message
 * that will print correctly on almost all terminals (Only
 * Windows 10 version 1901+ supported. All linux and OSX
 * terminals are supported). Try it out!
 *
 * ```zuri
 * import colors
 * colors.text('Successful!', colors.text_color.green)
 * ```
 *
 * The `text()` function can be nested. For example,
 *
 * ```zuri
 * colors.text(colors.text('Successful!', colors.style.bold), colors.text_color.green)
 * ```
 *
 * The module also features multiple functions for color
 * conversion. For example,
 *
 * ```zuri-repl
 * %> import colors
 * %> colors.rgb_to_cmyk(103, 13, 69)
 * [0, 87.37864077669903, 33.009708737864095, 59.6078431372549]
 * ```
 *
 * The terminal colors also have simple wrappers that allow
 * supplied colors to `text()` from various color formats. For
 * example, we can specify the color from the HTML hexadecimal
 * color.
 *
 * ```zuri
 * import colors
 * colors.text('Colored text!', colors.hex('#fc0'))
 * ```
 *
 * @copyright 2022, Richard Ore and The Zuri Contributors
 */

/**
 * ANSI font styles available for console applications.
 *
 * @type dictionary
 */
var style = {
  reset: 0,
  bold: 1,
  disable: 2,
  italic: 3,
  underline: 4,
  blink: 5,
  reverse: 7,
  invisible: 8,
  strike_through: 9,
}

/**
 * Standard ANSI text colors available for console applications.
 *
 * @type dictionary
 */
var text_color = {
  black: 30,
  red: 31,
  green: 32,
  orange: 33,
  blue: 34,
  magenta: 35,
  cyan: 36,
  light_grey: 37,
  dark_grey: 90,
  light_red: 91,
  light_green: 92,
  yellow: 93,
  light_blue: 94,
  pink: 95,
  light_cyan: 96,
  white: 97,
}

/**
 * Standard ANSI background colors available for console
 * applications.
 *
 * @type dictionary
 */
var background = {
  black: 40,
  red: 41,
  green: 42,
  orange: 43,
  blue: 44,
  magenta: 45,
  cyan: 46,
  light_grey: 47,
  dark_grey: 100,
  light_red: 101,
  light_green: 102,
  yellow: 103,
  light_blue: 104,
  pink: 105,
  light_cyan: 106,
  white: 107,
}

def _get_sequence(v, bg) {
  # `v == 0` (ANSI reset) is a real, present value, not an absent
  # one, so this checks for `nil` explicitly rather than truthiness;
  # `0 or bg` would treat a reset code the same as "nothing given".
  if v == nil and bg == nil return nil

  var v_str = v != nil ? v.to_string().lpad(2, '0') : ''
  var bg_str = bg != nil ? ';' + bg.to_string().lpad(2, '0') : ''

  return '\x1b[${v_str}${bg_str}m'
}

/**
 * Returns a terminal printable text with the given color (or
 * style) and background if given.
 *
 * @note The color argument can be replace with a style.
 * @param string value
 * @param ?int color
 * @param ?int bg
 * @returns string
 */
def text(value, color, bg) {
  # _get_sequence() returns real nil, not '', when neither color nor bg
  # is given: string-concatenating that directly would stringify to
  # the literal text "nil" glued onto value, not an empty prefix.
  var prefix = _get_sequence(color, bg)
  return (prefix != nil ? prefix : '') + value + _get_sequence(0)
}

/**
 * Converts RGB color to ASI-256 color number.
 *
 * @param int r
 * @param int g
 * @param int b
 * @returns number
 */
def rgb_to_ansi256(r: int, g: int, b: int) {

  # From https://github.com/Qix-/color-convert/blob/3f0e0d4e92e235796ccb17f6e85c72094a651f49/conversions.js
  if r == g and g == b {
    if r < 8 return 16
    if r > 248 return 231
    return (((r - 8) / 247) * 24).round() + 232
  }

  return 16 + (36 * (r / 255 * 5).round()) +
      (6 * (g / 255 * 5).round()) +
      (b / 255 * 5).round()
}

/**
 * Converts ANSI-256 color number to ANSI-16 color number.
 *
 * @param int code
 * @returns number
 */
def ansi256_to_ansi(code: int) {

  if code < 8 return 30 + code
  if code < 16 return 90 + (code - 8)

  var r, g, b

  if code >= 232 {
    r = (((code - 232) * 10) + 8) / 255
    g = r
    b = r
  } else {
    code -= 16

    var rem = code % 36

    r = (code / 36).floor() / 5
    g = (rem / 6).floor() / 5
    b = (rem % 6) / 5
  }

  var value = r.max(g).max(b) * 2
  if value == 0 return 30

  var result = 30 + (r.round() | (g.round() << 1) | (b.round() << 2))
  if value == 2 result += 60

  return result
}

/**
 * The four lengths a hexadecimal color can be written in: `rgb`,
 * `rgba`, `rrggbb` and `rrggbbaa`.
 */
const _VALID_HEX_LENGTHS = [3, 4, 6, 8]


/**
 * Whether _text_ is 3, 4, 6 or 8 hexadecimal digits, the four lengths
 * a color can be written in.
 *
 * A character loop rather than a regular expression, because
 * compiling a pattern costs far more than the comparison itself and
 * [[colors.hex_to_rgb]] sits under every color a drawing API parses.
 */
def _is_hex_digits(text) {
  var length = text.length()

  if !_VALID_HEX_LENGTHS.contains(length) {
    return false
  }

  iter var i = 0; i < length; i++ {
    var code = text[i].ord()

    # 0-9, then a-f, then A-F.
    if (code < 48 or code > 57) and
       (code < 97 or code > 102) and
       (code < 65 or code > 70) {
      return false
    }
  }

  return true
}


/**
 * Returns `true` if _color_ is a hexadecimal color that
 * [[colors.hex_to_rgb]] would accept, and `false` otherwise.
 *
 * A leading `#` is optional and the digits may be in either case.
 * This raises nothing, so it is the way to test a color before
 * converting it rather than converting inside a `catch`.
 *
 * ```zuri-repl
 * %> import colors
 * %> colors.is_hex('#4f46e5')
 * true
 * %> colors.is_hex('rebeccapurple')
 * false
 * ```
 *
 * @param any color
 * @returns bool
 */
def is_hex(color) {
  if !is_string(color) {
    return false
  }

  if color.length() > 0 and color[0] == '#' {
    return _is_hex_digits(color[1,])
  }

  return _is_hex_digits(color)
}


/**
 * Converts the hexadecimal string _h_ to its RGBA component.
 *
 * Accepts an optional leading `#`, is case-insensitive, and
 * accepts the 3/4/6/8-digit forms (`#f0c`, `#f0c8`, `#ff00cc`,
 * `#ff00ccbb`). Following the CSS Color 4 convention, alpha is the
 * *last* component when present (`RRGGBBAA`/`RGBA`, not
 * `AARRGGBB`/`ARGB`): an omitted alpha means fully opaque (`1`).
 *
 * @param string h
 * @returns list `[r, g, b, a]`
 * @throws ValueError When _h_ is not a valid hexadecimal color.
 */
def hex_to_rgb(h: string) {
  var s = h
  if s.length() > 0 and s[0] == '#' s = s[1,]

  if !_is_hex_digits(s) {
    raise ValueError('invalid hexadecimal color: ${h}')
  }

  var v = s

  # if we have four characters or less, duplicate every digit.
  if v.length() <= 4 {
    var tmp = ''
    for x in v {
      tmp += '${x}${x}'
    }
    v = tmp
  }

  # RRGGBB with no alpha given: fully opaque.
  if v.length() == 6 v += 'ff'

  var number = v.to_number(16)

  var a = (number & 0xFF) / 255,
      b = (number & 0xFF00) >> 8,
      g = (number & 0xFF0000) >> 16,
      r = (number & 0xFF000000) >> 24

  return [r, g, b, a]
}

/**
 * Converts the given hexadecimal color to its ANSI-256 number.
 *
 * @param string color
 * @returns number
 */
def hex_to_ansi256(color: string) {

  var v = hex_to_rgb(color)
  return rgb_to_ansi256(v[0], v[1], v[2])
}

/**
 * Converts the given hexadecimal color to its ANSI-16 number.
 *
 * @note For use with `text()`, this should be preferred over
 *    `hex_to_ansi256`
 * @param string color
 * @returns number
 */
def hex_to_ansi(color: string) {

  return ansi256_to_ansi(hex_to_ansi256(color))
}

/**
 * Converts the given hexadecimal color to its terminal
 * compatible color.
 *
 * @note For use with `text()`, this should be preferred over
 *    `hex_to_ansi256` and `hex_to_ansi`
 * @note _color_ can include the '#' character. E.g. `#ff0`.
 * @param string color
 * @returns number
 */
def hex(color: string) {

  if color[0] == '#' color = color[1,]
  return hex_to_ansi(color)
}

/**
 * Converts the given RGB color to its terminal compatible color.
 *
 * @param number r
 * @param number g
 * @param number b
 * @returns number
 */
def rgb(r: int, g: int, b: int) {
  return ansi256_to_ansi(rgb_to_ansi256(r, g, b))
}

/**
 * Converts the given HSL color to its terminal compatible color.
 *
 * @param number h
 * @param number s
 * @param number l
 * @returns number
 */
def hsl(h: number, s: number, l: number) {

  var rgb = hsl_to_rgb(h, s, l)

  return ansi256_to_ansi(rgb_to_ansi256(rgb[0], rgb[1], rgb[2]))
}

/**
 * Converts the given HSV color to its terminal compatible color.
 *
 * @param number h
 * @param number s
 * @param number v
 * @returns number
 */
def hsv(h: number, s: number, v: number) {

  var rgb = hsv_to_rgb(h, s, v)

  return ansi256_to_ansi(rgb_to_ansi256(rgb[0], rgb[1], rgb[2]))
}

/**
 * Converts the given HWB color to its terminal compatible color.
 *
 * @param number h
 * @param number w
 * @param number b
 * @returns number
 */
def hwb(h: number, w: number, b: number) {

  var rgb = hwb_to_rgb(h, w, b)

  return ansi256_to_ansi(rgb_to_ansi256(rgb[0], rgb[1], rgb[2]))
}

/**
 * Converts the given CMYK color to its terminal compatible
 * color.
 *
 * @param number c
 * @param number m
 * @param number y
 * @param number k
 * @returns number
 */
def cmyk(c: number, m: number, y: number, k: number) {

  var rgb = cmyk_to_rgb(c, m, y, k)

  return ansi256_to_ansi(rgb_to_ansi256(rgb[0], rgb[1], rgb[2]))
}

/**
 * Converts the given XYZ color to its terminal compatible color.
 *
 * @param number x
 * @param number y
 * @param number z
 * @returns number
 */
def xyz(x: number, y: number, z: number) {

  var rgb = xyz_to_rgb(x, y, z)

  return ansi256_to_ansi(rgb_to_ansi256(rgb[0], rgb[1], rgb[2]))
}

/**
 * Converts a RGB components into its corresponding hexadecimal
 * color.
 *
 * Following the CSS Color 4 convention, alpha (when given) is
 * appended as the *last* component (`RRGGBBAA`), and every
 * channel is zero-padded to two digits.
 *
 * @param int r
 * @param int g
 * @param int b
 * @param ?int a
 * @returns string
 */
def rgb_to_hex(r: int, g: int, b: int, a: ?int) {

  var r_str = r.hex().lpad(2, '0')
  var g_str = g.hex().lpad(2, '0')
  var b_str = b.hex().lpad(2, '0')
  var a_str = a != nil ? a.hex().lpad(2, '0') : ''

  return '${r_str}${g_str}${b_str}${a_str}'
}

/**
 * Converts a RGB color into its corresponding HSL components.
 *
 * @param int r
 * @param int g
 * @param int b
 * @returns list[float]
 */
def rgb_to_hsl(r: int, g: int, b: int) {

  r /= 255
  g /= 255
  b /= 255

  var _min = r.min(g).min(b)
  var _max = r.max(g).max(b)
  var delta = _max - _min, h, s

  if delta == 0 h = 0
  else if r == _max h = (g - b) / delta
  else if g == _max h = 2 + (b - r) / delta
  else if b == _max h = 4 + (r - g) / delta

  h = (h * 60).min(360)
  if h < 0 h += 360

  var l = (_min + _max) / 2

  if delta == 0 s = 0
  else if l <= 0.5 s = delta / (_max + _min)
  else s = delta / (2 - _max - _min)

  return [h, s * 100, l * 100]
}

/**
 * Converts a RGB color into its corresponding HSV components.
 *
 * @param int r
 * @param int g
 * @param int b
 * @returns list[float]
 */
def rgb_to_hsv(r: int, g: int, b: int) {

  r /= 255
  g /= 255
  b /= 255

  var _max = r.max(g).max(b), _min = r.min(g).min(b)
  var delta = _max - _min, h, s

  if delta == 0 h = 0
  else if _max == r h = ((g - b) / delta) % 6
  else if _max == g h = 2 + (b - r) / delta
  else if _max == b h = 4 + (r - g) / delta

  h = (h * 60).min(360)
  if h < 0 h += 360

  if _max == 0 s = 0
  else s = delta / _max

  return [h, s * 100, _max * 100]
}

/**
 * Converts a RGB color into its corresponding HWB components.
 *
 * @param int r
 * @param int g
 * @param int b
 * @returns list[float]
 */
def rgb_to_hwb(r: int, g: int, b: int) {

  var h = rgb_to_hsl(r, g, b)[0]
  var w = 1 / 255 * r.min(g.min(b))
  b = 1 - 1 / 255 * r.max(g.max(b))
  return [h, w * 100, b * 100]
}

/**
 * Converts a RGB color into its corresponding CMYK components.
 *
 * @param int r
 * @param int g
 * @param int b
 * @returns list[float]
 */
def rgb_to_cmyk(r: int, g: int, b: int) {

  r /= 255
  g /= 255
  b /= 255

  var k = (1 - r).min(1 - g).min(1 - b), c, m, y

  # k == 1 means pure black (no red, green, or blue content at all), so
  # the c/m/y formulas below would all divide by zero. Pure black has no
  # color content to speak of, so 0% is the correct C/M/Y reading.
  if k == 1 {
    c = 0
    m = 0
    y = 0
  } else {
    c = (1 - r - k) / (1 - k)
    m = (1 - g - k) / (1 - k)
    y = (1 - b - k) / (1 - k)
  }

  return [c * 100, m * 100, y * 100, k * 100]
}

/**
 * Converts a RGB color into its corresponding XYZ color space
 * components.
 *
 * @param int r
 * @param int g
 * @param int b
 * @returns list[float]
 */
def rgb_to_xyz(r: int, g: int, b: int) {

  r /= 255
  g /= 255
  b /= 255

  r = r > 0.04045 ? (((r + 0.055) / 1.055) ** 2.4) : (r / 12.92)
  g = g > 0.04045 ? (((g + 0.055) / 1.055) ** 2.4) : (g / 12.92)
  b = b > 0.04045 ? (((b + 0.055) / 1.055) ** 2.4) : (b / 12.92)

  var x = (r * 0.4124564) + (g * 0.3575761) + (b * 0.1804375),
      y = (r * 0.2126729) + (g * 0.7151522) + (b * 0.072175),
      z = (r * 0.0193339) + (g * 0.119192) + (b * 0.9503041)

  return [x * 100, y * 100, z * 100]
}

/**
 * Converts a RGB color into its corresponding LAB color
 * components.
 *
 * @param int r
 * @param int g
 * @param int b
 * @returns list[float]
 */
def rgb_to_lab(r: int, g: int, b: int) {

  var xyz = rgb_to_xyz(r, g, b)

  var x = xyz[0], y = xyz[1], z = xyz[2]

  x /= 95.047
  y /= 100
  z /= 108.883

  x = x > 0.008856 ? (x ** (1 / 3)) : (7.787 * x) + (16 / 116)
  y = y > 0.008856 ? (y ** (1 / 3)) : (7.787 * y) + (16 / 116)
  z = z > 0.008856 ? (z ** (1 / 3)) : (7.787 * z) + (16 / 116)

  var l = (116 * y) - 16,
      a = 500 * (x - y)
  b = 200 * (y - z)

  return [l, a, b]
}

/**
 * Converts a HSL color into its corresponding RGB color
 * components.
 *
 * @param number h
 * @param number s
 * @param number l
 * @returns list[float]
 */
def hsl_to_rgb(h: number, s: number, l: number) {

  # Hue is circular, so it wraps rather than being rejected; s/l
  # (each 0-100) aren't, so those still raise on an out-of-range value.
  if s < 0 or s > 100 or l < 0 or l > 100
    raise ValueError('invalid color components')

  h = h % 360
  if h < 0 h += 360

  # Based on https://github.com/Qix-/color-convert/blob/3f0e0d4e92e235796ccb17f6e85c72094a651f49/conversions.js#L244

  h /= 360
  s /= 100
  l /= 100

  var t2, t3, val

  if s == 0 {
    val = (l * 255).round()
    return [val, val, val]
  }

  if l < 0.5 {
    t2 = l * (1 + s)
  } else {
    t2 = l + s - l * s
  }

  var t1 = 2 * l - t2,
      rgb = [0, 0, 0]

  iter var i = 0; i < 3; i++ {
    t3 = h + 1 / 3 * -(i - 1)

    if t3 < 0 {
      t3++
    }
    if t3 > 1 {
      t3--
    }

    if 6 * t3 < 1 {
      val = t1 + (t2 - t1) * 6 * t3
    } else if 2 * t3 < 1 {
      val = t2
    } else if 3 * t3 < 2 {
      val = t1 + (t2 - t1) * (2 / 3 - t3) * 6
    } else {
      val = t1
    }

    rgb[i] = (val * 255).min(255).round()
  }

  return rgb
}

/**
 * Converts a HSL color into its corresponding HSV color
 * components.
 *
 * @param number h
 * @param number s
 * @param number l
 * @returns list[float]
 */
def hsl_to_hsv(h: number, s: number, l: number) {

  s /= 100
  l /= 100
  var v = (l + s * l.min(1 - l))
  var s2 = v == 0 ? 0 : 2 * (1 - l / v)
  return [h, s2 * 100, v * 100]
}

/**
 * Converts a HSV color into its corresponding RGB color
 * components.
 *
 * @param number h
 * @param number s
 * @param number v
 * @returns list[float]
 */
def hsv_to_rgb(h: number, s: number, v: number) {

  h = h % 360
  if h < 0 h += 360

  h /= 60
  s /= 100
  v /= 100
  
  var hi = h.floor() % 6,
      f = h - h.floor(),
      x = (255 * v * (1 - s)).round(),
      y = (255 * v * (1 - (s *f))).round(),
      z = (255 * v * (1 - (s * (1 - f)))).round()
  
  v = (v * 255).round()

  using hi {
    when 0 return [v, z, x]
    when 1 return [y, v, x]
    when 2 return [x, v, z]
    when 3 return [x, y, v]
    when 4 return [z, x, v]
    when 5 return [v, z, y]
  }
}

/**
 * Converts a HSV color into its corresponding HSL color
 * components.
 *
 * @param number h
 * @param number s
 * @param number v
 * @returns list[float]
 */
def hsv_to_hsl(h: number, s: number, v: number) {

  s /= 100
  v /= 100
  
  var vmax = v.max(0.01),
      l = (2 - s) * v,
      lmax = (2 - s) * vmax,
      sl = s * vmax

  # The divisor can be exactly 0 (e.g. s=0, v=1, where lmax works out to
  # 2), which would divide sl's already-zero numerator into NaN rather
  # than 0.
  var divisor = lmax <= 1 ? lmax : 2 - lmax
  sl = divisor == 0 ? 0 : sl / divisor
  l /= 2

  return [h, sl * 100, l * 100]
}

/**
 * Converts a HWB color into its corresponding RGB color
 * components.
 *
 * @param number h
 * @param number w
 * @param number b
 * @returns list[float]
 */
def hwb_to_rgb(h: number, w: number, b: number) {

  h /= 360
  w /= 100
  b /= 100

  var ratio = w + b

  # ratio can't be greater than 1
  if ratio > 1 {
    w /= ratio
    h /= ratio
  }

  var i = (6 * h).floor(),
      v = 1 - b
  var f = 6 * h - i

  if i & 0x01 != 0 f = 1 - f

  # Linear interpolation
  var n = w + f * (v - w), r, g, b2

  using i {
    when 1 { r = n; g = v; b2 = w }
    when 2 { r = w; g = v; b2 = n }
    when 3 { r = w; g = n; b2 = v }
    when 4 { r = n; g = w; b2 = v }
    when 5 { r = v; g = w; b2 = n }
    default { r = v; g = n; b2 = w }
  }

  return [(r * 255).round(), (g * 255).round(), (b2 * 255).round()]
}

/**
 * Converts a CMYK color into its corresponding RGB color
 * components.
 *
 * @param number c
 * @param number m
 * @param number y
 * @param number k
 * @returns list[float]
 */
def cmyk_to_rgb(c: number, m: number, y: number, k: number) {

  c /= 100
  m /= 100
  y /= 100
  k /= 100

  var r = 1 - 1.min(c * (1 - k) + k)
  var g = 1 - 1.min(m * (1 - k) + k)
  var b = 1 - 1.min(y * (1 - k) + k)

  return [(r * 255).round(), (g * 255).round(), (b * 255).round()]
}

/**
 * Converts a XYZ color into its corresponding RGB color
 * components.
 *
 * @param number x
 * @param number y
 * @param number z
 * @returns list[float]
 */
def xyz_to_rgb(x: number, y: number, z: number) {

  x /= 100
  y /= 100
  z /= 100

  var r, g, b

  r = (x * 3.2404542) + (y * -1.5371385) + (z * -0.4985314)
  g = (x * -0.969266) + (y * 1.8760108) + (z * 0.041556)
  b = (x * 0.0556434) + (y * -0.2040259) + (z * 1.0572252)

  # Assume sRGB
  r = r > 0.0031308 ?
      ((1.055 * (r ** (1.0 / 2.4))) - 0.055) :
      r * 12.92

  g = g > 0.0031308 ?
      ((1.055 * (g ** (1.0 / 2.4))) - 0.055) :
      g * 12.92

  b = b > 0.0031308 ?
      ((1.055 * (b ** (1.0 / 2.4))) - 0.055) :
      b * 12.92

  r = 0.max(r).min(1)
  g = 0.max(g).min(1)
  b = 0.max(b).min(1)

  return [(r * 255).round(), (g * 255).round(), (b * 255).round()]
}

/**
 * Converts a LAB color into its corresponding RGB color
 * components. The inverse of `rgb_to_lab`.
 *
 * @param number l
 * @param number a
 * @param number b
 * @returns list[float]
 */
def lab_to_rgb(l: number, a: number, b: number) {

  var y = (l + 16) / 116
  var x = a / 500 + y
  var z = y - b / 200

  x = x ** 3 > 0.008856 ? x ** 3 : (x - 16 / 116) / 7.787
  y = y ** 3 > 0.008856 ? y ** 3 : (y - 16 / 116) / 7.787
  z = z ** 3 > 0.008856 ? z ** 3 : (z - 16 / 116) / 7.787

  x *= 95.047
  y *= 100
  z *= 108.883

  return xyz_to_rgb(x, y, z)
}


# ---------------------------------------------------------------------------
# Color manipulation
# ---------------------------------------------------------------------------
#
# These all take and return hex color strings, carrying alpha through
# when the input has any transparency (omitted from the returned hex
# string entirely for a fully-opaque input, so a caller round-tripping
# an ordinary 6-digit color never picks up an unwanted `ff` alpha
# suffix).

def _alpha_byte(a) {
  return a < 1 ? (a * 255).round() : nil
}

/**
 * Returns _hex_ lightened by _amount_ percentage points in HSL
 * space (clamped to 0-100).
 *
 * @param string hex
 * @param number amount
 * @returns string
 */
def lighten(hex: string, amount: number) {

  var rgb = hex_to_rgb(hex)
  var hsl = rgb_to_hsl(rgb[0], rgb[1], rgb[2])
  var out = hsl_to_rgb(hsl[0], hsl[1], (hsl[2] + amount).max(0).min(100))

  return rgb_to_hex(out[0].round(), out[1].round(), out[2].round(), _alpha_byte(rgb[3]))
}

/**
 * Returns _hex_ darkened by _amount_ percentage points in HSL
 * space (clamped to 0-100). The inverse of `lighten`.
 *
 * @param string hex
 * @param number amount
 * @returns string
 */
def darken(hex: string, amount: number) {
  return lighten(hex, -amount)
}

/**
 * Returns _hex_ with its saturation increased by _amount_
 * percentage points in HSL space (clamped to 0-100).
 *
 * @param string hex
 * @param number amount
 * @returns string
 */
def saturate(hex: string, amount: number) {

  var rgb = hex_to_rgb(hex)
  var hsl = rgb_to_hsl(rgb[0], rgb[1], rgb[2])
  var out = hsl_to_rgb(hsl[0], (hsl[1] + amount).max(0).min(100), hsl[2])

  return rgb_to_hex(out[0].round(), out[1].round(), out[2].round(), _alpha_byte(rgb[3]))
}

/**
 * Returns _hex_ with its saturation decreased by _amount_
 * percentage points in HSL space (clamped to 0-100). The inverse
 * of `saturate`.
 *
 * @param string hex
 * @param number amount
 * @returns string
 */
def desaturate(hex: string, amount: number) {
  return saturate(hex, -amount)
}

/**
 * Returns _hex_ fully desaturated (HSL saturation set to 0), the
 * same hue and lightness otherwise preserved. This is an HSL
 * desaturation, not a perceptual-luminance-weighted grayscale.
 *
 * @param string hex
 * @returns string
 */
def grayscale(hex) {
  return desaturate(hex, 100)
}

/**
 * Returns _hex_ with each RGB channel inverted (`255 - channel`).
 * Alpha, if present, is left unchanged.
 *
 * @param string hex
 * @returns string
 */
def invert(hex: string) {

  var rgb = hex_to_rgb(hex)
  return rgb_to_hex(255 - rgb[0], 255 - rgb[1], 255 - rgb[2], _alpha_byte(rgb[3]))
}

/**
 * Linearly interpolates between two colors, including their
 * alpha channels.
 *
 * @param string hex_a
 * @param string hex_b
 * @param ?number weight How far from _hex_a_ (0) to _hex_b_ (1).
 *    Default: 0.5 (the midpoint).
 * @returns string
 */
def mix(hex_a: string, hex_b: string, weight: ?number) {
  if weight == nil {
    weight = 0.5
  }

  var c1 = hex_to_rgb(hex_a)
  var c2 = hex_to_rgb(hex_b)

  var r = (c1[0] + (c2[0] - c1[0]) * weight).round()
  var g = (c1[1] + (c2[1] - c1[1]) * weight).round()
  var b = (c1[2] + (c2[2] - c1[2]) * weight).round()
  var a = c1[3] + (c2[3] - c1[3]) * weight

  return rgb_to_hex(r, g, b, _alpha_byte(a))
}


# ---------------------------------------------------------------------------
# Accessibility
# ---------------------------------------------------------------------------

# WCAG 2.x relative luminance (https://www.w3.org/TR/WCAG21/#dfn-relative-luminance).
# Deliberately uses the exact constants and 0.03928 linearization
# threshold the spec itself defines, rather than reusing rgb_to_xyz's
# more precise CIE Y-row constants; the two are extremely close but
# not identical, and a function claiming WCAG compliance should match
# the spec's own formula exactly.
/**
 * Returns the relative luminance of an RGB color, from 0 (black) to
 * 1 (white), as defined by WCAG 2.x.
 *
 * This is perceived brightness in linear light, not the `l` of HSL:
 * pure green is far brighter to the eye than pure blue even though
 * HSL gives both a lightness of 0.5. It is what `contrast_ratio()` is
 * built on, and what to compare against a threshold when deciding
 * whether light or dark text belongs on a background.
 *
 * ```zuri-repl
 * %> import colors
 * %> colors.relative_luminance(255, 255, 255)
 * 1
 * %> colors.relative_luminance(0, 255, 0)
 * 0.7152
 * ```
 *
 * @param int r
 * @param int g
 * @param int b
 * @returns number
 */
def relative_luminance(r, g, b) {
  r /= 255
  g /= 255
  b /= 255

  r = r <= 0.03928 ? r / 12.92 : ((r + 0.055) / 1.055) ** 2.4
  g = g <= 0.03928 ? g / 12.92 : ((g + 0.055) / 1.055) ** 2.4
  b = b <= 0.03928 ? b / 12.92 : ((b + 0.055) / 1.055) ** 2.4

  return (0.2126 * r) + (0.7152 * g) + (0.0722 * b)
}

/**
 * Returns the WCAG 2.x contrast ratio between two colors, from 1
 * (no contrast) to 21 (black on white).
 *
 * A ratio of at least 4.5 meets WCAG AA for normal text (3 for
 * large text); 7 meets AAA (4.5 for large text).
 *
 * @param string hex_a
 * @param string hex_b
 * @returns number
 */
def contrast_ratio(hex_a: string, hex_b: string) {

  var c1 = hex_to_rgb(hex_a)
  var c2 = hex_to_rgb(hex_b)

  var l1 = relative_luminance(c1[0], c1[1], c1[2])
  var l2 = relative_luminance(c2[0], c2[1], c2[2])

  var lighter = l1.max(l2)
  var darker = l1.min(l2)

  return (lighter + 0.05) / (darker + 0.05)
}


/**
 * The CSS Color Level 4 named colors, mapped to their hexadecimal
 * values.
 *
 * Values carry no leading `#`, matching every other function in this
 * module that produces a hexadecimal color. Both the American and
 * British spellings of the greys are present, as are `rebeccapurple`
 * and `transparent`, which is the only entry with an alpha component
 * and therefore the only 8-digit one.
 *
 * Keys are lower case with no separators; use [[colors.named]] rather
 * than indexing this directly if the name might arrive in mixed case
 * or spaced out.
 *
 * @type dict
 */
var NAMED = {
  transparent: '00000000',
  aliceblue: 'f0f8ff', antiquewhite: 'faebd7', aqua: '00ffff',
  aquamarine: '7fffd4', azure: 'f0ffff', beige: 'f5f5dc',
  bisque: 'ffe4c4', black: '000000', blanchedalmond: 'ffebcd',
  blue: '0000ff', blueviolet: '8a2be2', brown: 'a52a2a',
  burlywood: 'deb887', cadetblue: '5f9ea0', chartreuse: '7fff00',
  chocolate: 'd2691e', coral: 'ff7f50', cornflowerblue: '6495ed',
  cornsilk: 'fff8dc', crimson: 'dc143c', cyan: '00ffff',
  darkblue: '00008b', darkcyan: '008b8b', darkgoldenrod: 'b8860b',
  darkgray: 'a9a9a9', darkgrey: 'a9a9a9', darkgreen: '006400',
  darkkhaki: 'bdb76b', darkmagenta: '8b008b', darkolivegreen: '556b2f',
  darkorange: 'ff8c00', darkorchid: '9932cc', darkred: '8b0000',
  darksalmon: 'e9967a', darkseagreen: '8fbc8f', darkslateblue: '483d8b',
  darkslategray: '2f4f4f', darkslategrey: '2f4f4f', darkturquoise: '00ced1',
  darkviolet: '9400d3', deeppink: 'ff1493', deepskyblue: '00bfff',
  dimgray: '696969', dimgrey: '696969', dodgerblue: '1e90ff',
  firebrick: 'b22222', floralwhite: 'fffaf0', forestgreen: '228b22',
  fuchsia: 'ff00ff', gainsboro: 'dcdcdc', ghostwhite: 'f8f8ff',
  gold: 'ffd700', goldenrod: 'daa520', gray: '808080',
  grey: '808080', green: '008000', greenyellow: 'adff2f',
  honeydew: 'f0fff0', hotpink: 'ff69b4', indianred: 'cd5c5c',
  indigo: '4b0082', ivory: 'fffff0', khaki: 'f0e68c',
  lavender: 'e6e6fa', lavenderblush: 'fff0f5', lawngreen: '7cfc00',
  lemonchiffon: 'fffacd', lightblue: 'add8e6', lightcoral: 'f08080',
  lightcyan: 'e0ffff', lightgoldenrodyellow: 'fafad2', lightgray: 'd3d3d3',
  lightgrey: 'd3d3d3', lightgreen: '90ee90', lightpink: 'ffb6c1',
  lightsalmon: 'ffa07a', lightseagreen: '20b2aa', lightskyblue: '87cefa',
  lightslategray: '778899', lightslategrey: '778899', lightsteelblue: 'b0c4de',
  lightyellow: 'ffffe0', lime: '00ff00', limegreen: '32cd32',
  linen: 'faf0e6', magenta: 'ff00ff', maroon: '800000',
  mediumaquamarine: '66cdaa', mediumblue: '0000cd', mediumorchid: 'ba55d3',
  mediumpurple: '9370db', mediumseagreen: '3cb371', mediumslateblue: '7b68ee',
  mediumspringgreen: '00fa9a', mediumturquoise: '48d1cc', mediumvioletred: 'c71585',
  midnightblue: '191970', mintcream: 'f5fffa', mistyrose: 'ffe4e1',
  moccasin: 'ffe4b5', navajowhite: 'ffdead', navy: '000080',
  oldlace: 'fdf5e6', olive: '808000', olivedrab: '6b8e23',
  orange: 'ffa500', orangered: 'ff4500', orchid: 'da70d6',
  palegoldenrod: 'eee8aa', palegreen: '98fb98', paleturquoise: 'afeeee',
  palevioletred: 'db7093', papayawhip: 'ffefd5', peachpuff: 'ffdab9',
  peru: 'cd853f', pink: 'ffc0cb', plum: 'dda0dd',
  powderblue: 'b0e0e6', purple: '800080', rebeccapurple: '663399',
  red: 'ff0000', rosybrown: 'bc8f8f', royalblue: '4169e1',
  saddlebrown: '8b4513', salmon: 'fa8072', sandybrown: 'f4a460',
  seagreen: '2e8b57', seashell: 'fff5ee', sienna: 'a0522d',
  silver: 'c0c0c0', skyblue: '87ceeb', slateblue: '6a5acd',
  slategray: '708090', slategrey: '708090', snow: 'fffafa',
  springgreen: '00ff7f', steelblue: '4682b4', tan: 'd2b48c',
  teal: '008080', thistle: 'd8bfd8', tomato: 'ff6347',
  turquoise: '40e0d0', violet: 'ee82ee', wheat: 'f5deb3',
  white: 'ffffff', whitesmoke: 'f5f5f5', yellow: 'ffff00',
  yellowgreen: '9acd32',
}


/**
 * Returns the hexadecimal value of a CSS named color.
 *
 * Matching ignores case, whitespace, hyphens and underscores, so
 * `'Tomato'`, `'tomato'` and `' TOMATO '` all resolve, as do both
 * `'darkseagreen'` and `'Dark Sea Green'`.
 *
 * The result carries no leading `#`, the same as [[colors.rgb_to_hex]]
 * and [[colors.lighten]], so it can be handed straight to any function
 * here that takes a hexadecimal color. Every name returns 6 digits
 * except `transparent`, which returns the 8-digit `'00000000'`.
 *
 * ```zuri-repl
 * %> import colors
 * %> colors.named('rebeccapurple')
 * '663399'
 * %> colors.named('Dark Sea Green')
 * '8fbc8f'
 * ```
 *
 * @note Spaces inside the name are ignored, so both the CSS spelling
 *    and the spaced-out reading of a name resolve to the same color.
 *
 * @param string name
 * @returns string
 * @throws ValueError When _name_ is not a CSS color name.
 */
def named(name: string) {
  var key = name.trim().lower().replace('/[ _-]/', '')
  var found = NAMED.get(key)

  if found == nil {
    raise ValueError("'${name}' is not a CSS color name")
  }

  return found
}


/**
 * Returns `true` if _name_ is a CSS color name that [[colors.named]]
 * would resolve, and `false` otherwise.
 *
 * @param string name
 * @returns bool
 */
def is_named(name) {
  if !is_string(name) {
    return false
  }

  return NAMED.contains(name.trim().lower().replace('/[ _-]/', ''))
}
