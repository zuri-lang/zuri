/**
 * # Functions
 *
 * A function is a value like any other, and it has methods of its own.
 * They work the same way for a named function declared with `def`, an
 * anonymous function, a bound method and a built-in native function.
 *
 * ```zuri-repl
 * %> def add(a, b) { return a + b }
 * %> add.name()
 * 'add'
 * %> add.call(2, 3)
 * 5
 * ```
 */

class function {

  /**
   * The function's declared name. An anonymous function is named
   * `@anon` followed by a number, in the order the compiler found it. A
   * bound method reports the method's own name, not its class's name.
   *
   * ```zuri-repl
   * %> def named(a, b, ...c) {}
   * %> named.name()
   * 'named'
   * %> print.name()
   * 'print'
   * ```
   *
   * @returns string
   */
  name() {}

  /**
   * How many parameters the function declares, counting a variadic
   * one as a single parameter.
   *
   * ```zuri-repl
   * %> def named(a, b, ...c) {}
   * %> named.arity()
   * 3
   * ```
   *
   * A method read off an instance counts the instance as its first
   * parameter, so a method declaring two parameters reports `3`. A
   * foreign function from `ffi` has no receiver and reports its C
   * parameter list.
   *
   * @returns number
   */
  arity() {}

  /**
   * Whether the last parameter is variadic (`...name`).
   *
   * ```zuri-repl
   * %> def named(a, b, ...c) {}
   * %> named.is_variadic()
   * true
   * ```
   *
   * @returns bool
   */
  is_variadic() {}

  /**
   * Calls the function with the given arguments, and returns its
   * result. This is the same as calling it directly. It can make the
   * code clearer when the function is stored in a variable.
   *
   * ```zuri-repl
   * %> def add(a, b) { return a + b }
   * %> add.call(2, 3)
   * 5
   * ```
   *
   * @param ...any args: the arguments to call it with
   * @returns {any} Whatever the function returns.
   * @throws anything the called function raises.
   */
  call(...args) {}

  /**
   * Calls the function with the arguments in a list, and returns its
   * result. `call()` takes the arguments separately, and this method
   * takes them in a list.
   *
   * ```zuri-repl
   * %> def add(a, b) { return a + b }
   * %> add.apply([2, 3])
   * 5
   * %> def collect(first, ...rest) { return [first, rest] }
   * %> collect.apply([1, 2, 3])
   * [1, [2, 3]]
   * ```
   *
   * If the list is shorter than the number of parameters, the remaining
   * parameters are `nil`, just as when you call the function directly
   * with too few arguments. If it's longer, the extra arguments go into
   * a variadic parameter, or are discarded if there isn't one.
   *
   * @param list args: the arguments to call it with, in order
   * @returns {any} Whatever the function returns.
   * @throws TypeError if `args` isn't a list, and anything the called
   *    function raises.
   */
  apply(args: list) {}

  /**
   * The function rendered for display, as `<function NAME(ARITY)>`,
   * with a trailing `...` on the arity when the function is
   * variadic.
   *
   * ```zuri-repl
   * %> def named(a, b, ...c) {}
   * %> named.to_string()
   * '<function named(3...)>'
   * ```
   *
   * @returns string
   */
  to_string() {}
}
