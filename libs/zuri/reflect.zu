/**
 * @module reflect
 *
 * Introspection at run time: information about a live function, class
 * or module, and access to an instance's or module's properties and
 * methods by name, without knowing the name when the code is compiled.
 * It can also run the garbage collector on demand.
 *
 * It only shows what's available at run time. It doesn't know the line
 * a function or class was declared on, or its doc block, because those
 * are in the source, not in the running object. To get them, parse the
 * source with `zuri.parse()`, and read a `Function` or `Class` node's
 * `line` and `col`, and any `DocBlock` node just before it.
 *
 * ```zuri
 * import zuri
 *
 * def add(a, b) {
 *   return a + b
 * }
 *
 * echo zuri.reflect.function_info(add).arity
 * # 2
 * ```
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _zuri_reflect

/**
 * This value's runtime type tag: `'nil'`, `'bool'`, `'number'`,
 * `'string'`, `'bytes'`, `'bigint'`, `'list'`, `'dict'`,
 * `'function'`, `'class'`, `'instance'`, `'module'`, `'range'`,
 * `'file'`, or a pointer's own registered resource tag (see
 * `pointer_type`). A closure, a native function, and a bound
 * method are all reported as `'function'`, since from Zuri's own
 * point of view they're interchangeably callable.
 *
 * @param any value
 * @returns string
 */
def kind(value) {
  return _zuri_reflect.kind(value)
}

/**
 * The resource tag that a pointer value was registered with, such as
 * the internal type name of a native socket handle, or `nil` if `value`
 * isn't a pointer. Pointers wrap a native resource that Zuri code can't
 * inspect, and this tells you what kind of resource it is without
 * revealing its contents.
 *
 * @param any value
 * @returns ?string
 */
def pointer_type(value) {
  return _zuri_reflect.pointer_type(value)
}

/**
 * Metadata for a function-like value: `{ name, arity, variadic,
 * is_method, owning_class_name, source_path }`.
 * `owning_class_name` is the class it was declared a method of,
 * or `nil` for an ordinary function/closure. `source_path` is
 * `nil` for a native (built-in) function, which has no Zuri
 * source file behind it.
 *
 * @param callable f: A closure, a native function, or a bound
 *    method
 * @returns dict
 * @throws Error if `f` isn't callable as a function (a class,
 *    though itself callable to construct an instance, is a
 *    `class_info` subject instead)
 */
def function_info(f) {
  return _zuri_reflect.function_info(f)
}

/**
 * Information about a class:
 * `{ name, superclass_name, methods, fields, statics }`.
 * `superclass_name` is `nil` for a class without a superclass.
 * `methods` is a dictionary that maps each method name to an entry
 * shaped like `function_info()`'s, including inherited methods, with an
 * override replacing the inherited entry of the same name, just as
 * method dispatch does. `fields` and `statics` are lists of names, in
 * declaration order. `fields` includes inherited fields, and `statics`
 * only includes the class's own, because static members aren't
 * inherited in Zuri.
 *
 * @param class c
 * @returns dict
 * @throws Error if `c` isn't a class
 */
def class_info(c) {
  return _zuri_reflect.class_info(c)
}

/**
 * The class that `value` is an instance of, or `nil` if `value` isn't
 * an instance.
 *
 * This is the class itself, not its name. `typeof()` gives the class
 * name, and two classes declared with the same name in different
 * modules have the same name. Only the class itself tells them apart,
 * and only the class can be called, compared with `==`, used as a
 * dictionary key or passed to `class_info()`.
 *
 * ```zuri
 * import zuri
 *
 * class Point {}
 *
 * var p = Point()
 *
 * echo zuri.reflect.class_of(p) == Point  # true
 * echo zuri.reflect.class_of(42)          # nil
 * ```
 *
 * An instance of a subclass reports the subclass, which is the class it
 * was created from, never one of its parents.
 *
 * @param any value
 * @returns class|nil
 */
def class_of(value) {
  return _zuri_reflect.class_of(value)
}

/**
 * Information about a module: `{ name, path, loaded, members }`.
 * `members` is a dictionary that maps every top-level name the module
 * declares to that binding's `kind` (see `kind()` above), such as
 * `{ add: 'function', VERSION: 'string' }`. It accepts either a module
 * value or a binding created by `import PATH`, because both refer to
 * the same module.
 *
 * @param module m
 * @returns dict
 * @throws Error if `m` isn't a module
 */
def module_info(m) {
  return _zuri_reflect.module_info(m)
}

/**
 * Calls `function_info()`, `class_info()` or `module_info()`, depending
 * on `kind(value)`.
 *
 * @param any value
 * @returns dict
 * @throws Error if `value` can't be reflected on, such as a number, a
 *    list or an instance. Only callables, classes and modules can be.
 */
def info(value) {
  return _zuri_reflect.info(value)
}

/**
 * Does `object` (an instance or a module) have a property/member
 * named `name`?
 *
 * @param instance|module object
 * @param string name
 * @returns bool
 */
def has_prop(object, name) {
  return _zuri_reflect.has_prop(object, name)
}

/**
 * The current value of `object`'s (an instance or a module)
 * property/member named `name`, or `nil` if it has none by that
 * name.
 *
 * @param instance|module object
 * @param string name
 * @returns any
 * @throws TypeError if `object` is neither an instance nor a
 *    module
 */
def get_prop(object, name) {
  if !is_instance(object) and typeof(object) != 'module' {
    raise TypeError('instance or module expected in argument 1 (object)')
  }

  return _zuri_reflect.get_prop(object, name)
}

/**
 * Every property or member name that `object`, an instance or a module,
 * has, as a list of strings, or an empty list if it has none. Instance
 * fields are in declaration order, and module members aren't in any
 * particular order.
 *
 * @param instance|module object
 * @returns list[string]
 * @throws TypeError if `object` is neither an instance nor a module
 */
def get_props(object) {
  if !is_instance(object) and typeof(object) != 'module' {
    raise TypeError('instance or module expected in argument 1 (object)')
  }

  return _zuri_reflect.get_props(object)
}

/**
 * Sets `object`'s existing property `name` to `value`.
 *
 * @note Instances have a fixed set of fields, set when their class is
 *    declared. Unlike a dictionary, an instance can never gain or lose
 *    a property at run time. This only updates a field that the
 *    instance's class already declares, and can't create a new one.
 *
 * @param instance object
 * @param string name
 * @returns bool: `true` if the property was updated, or `false` if
 *    `name` isn't a field that `object`'s class declares. In that case,
 *    nothing is changed, and no field is created.
 * @throws TypeError if `object` isn't an instance
 */
def set_prop(object, name, value) {
  if !is_instance(object) {
    raise TypeError('instance expected in argument 1 (object)')
  }

  return setprop(object, name, value)
}

/**
 * Sets `object`'s existing property `name` back to `nil`.
 *
 * @note As with `set_prop()`, this can't remove the field itself, only
 *    clear its value. See the note on `set_prop()`.
 *
 * @param instance object
 * @param string name
 * @returns bool: `true` if the property was reset, or `false` if `name`
 *    isn't a field that `object`'s class declares
 * @throws TypeError if `object` isn't an instance
 */
def del_prop(object, name) {
  if !is_instance(object) {
    raise TypeError('instance expected in argument 1 (object)')
  }

  return delprop(object, name)
}

/**
 * Does the class behind `object` (an instance, or a class used
 * directly) declare or inherit a method named `name`?
 *
 * @param instance|class object
 * @param string name
 * @returns bool
 */
def has_method(object, name) {
  return _zuri_reflect.has_method(object, name)
}

/**
 * Whether the class of `object` implements the decorator named `name`.
 * A decorator is a method whose name starts with `@`, such as
 * `@to_string`, `@new` or `@value`, and `name` here doesn't include the
 * `@`.
 *
 * @param instance|class object
 * @param string name: the decorator's name, without the leading `@`
 * @returns bool
 */
def has_decorator(object, name) {
  return _zuri_reflect.has_method(object, '@${name}')
}

/**
 * The unbound function for the method `name` on the class of `object`,
 * or `nil` if the class doesn't declare that method. Calling the result
 * directly does NOT provide a receiver. See `bind_method()` for a
 * version that does.
 *
 * @param instance|class object
 * @param string name
 * @returns ?function
 */
def get_method(object, name) {
  return _zuri_reflect.get_method(object, name)
}

/**
 * The method `name` on `object`'s class, bound to `object` as the
 * receiver. Unlike the unbound function that `get_method()` returns,
 * the result can be called directly, without passing a receiver.
 *
 * @param instance object
 * @param string name
 * @returns ?function
 */
def bind_method(object, name) {
  return _zuri_reflect.bind_method(object, name)
}

/**
 * The decorator function named `name` (excluding the leading
 * `@`) on the class behind `object`, bound to `object` as its
 * receiver and ready to call directly.
 *
 * @param instance object
 * @param string name: The decorator's name, without the leading
 *    `@`
 * @returns function
 * @throws NotImplementedError if the class behind `object`
 *    implements no such decorator
 */
def get_decorator(object, name) {
  if has_decorator(object, name) {
    return bind_method(object, '@${name}')
  }

  raise NotImplementedError(
    "class ${typeof(object)} does not implement decorator '${name}'",
  )
}

/**
 * Runs a full garbage collection now, instead of waiting for the heap
 * to reach its threshold.
 *
 * Every object that nothing refers to is freed before this returns, and
 * anything that releases a resource when it's collected releases it,
 * such as an owned `ffi` pointer, whose destructor runs. The freed
 * memory is also returned to the system before this returns.
 *
 * A program never needs to call this to work correctly, because the
 * collector runs by itself as the program allocates memory. It's for
 * when the timing matters, such as releasing native resources at a
 * known point, or a test that checks what collection does. A full
 * collection visits every live object, so calling it in a loop is slow.
 *
 * ```zuri
 * import zuri
 *
 * var scratch = [1, 2, 3]
 * scratch = nil
 * zuri.reflect.gc()
 * ```
 *
 * @returns nil
 */
def gc() {
  _zuri_reflect.gc()
}
