/**
 * @module compile
 *
 * The {Instr} type that `zuri.compile()` returns, which is a generic
 * representation of one VM instruction. It's tagged with `op`, such as
 * `'LoadConst'`, `'Add'` or `'Jmp'`, and has a `fields` dictionary with
 * that opcode's operands. As with {zuri.ast.Node}, there's a single
 * `Instr` class, not one class per opcode. The instruction set has
 * around sixty opcodes, and a class for each one would mean sixty
 * almost identical classes to keep in step with the compiler.
 *
 * ```zuri
 * import zuri
 *
 * for instr in zuri.compile('var x = 1 + 2') {
 *   echo '${instr.op} ${instr.fields}'
 * }
 * ```
 *
 * ## Resolved operands
 *
 * `compile()` returns a flat list of instructions, matching the VM's
 * own `Instr` type. But several opcodes, such as `LoadConst`,
 * `GetGlobal`, `GetField` and `Invoke`, only have an index into the
 * compiler's constant pool, which isn't otherwise available. So that
 * callers don't have to fetch a separate constants table and match it
 * up, each of those fields also has the value it refers to added to the
 * instruction, next to the index. For example, a `LoadConst`
 * instruction's `fields` has both `const_idx`, the index, and `value`,
 * what the index refers to. A resolved field is never named after a
 * reserved word, such as `const` or `class`, because then it couldn't
 * be read with dot syntax. `class` becomes `class_reg`, because it's a
 * register index anyway, not a class, and a few others are renamed in
 * the same way.
 *
 * The resolved value of a `Closure` instruction is a nested function
 * prototype, `{ name, arity, variadic, instructions }`, whose
 * `instructions` are wrapped in exactly the same way, so the bodies of
 * functions and methods in a script are available too, not just the
 * code around them.
 *
 * Every instruction has the source `line` it was compiled from, but
 * never a column. The compiler only tracks lines, at the level of
 * statements, unlike the positions of a {zuri.token.Token} or a
 * {zuri.ast.Node}, which have real column information from the lexer
 * and parser.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _zuri_compile
import ._tree
import .diagnostic { Diagnostic }

/**
 * One VM instruction.
 *
 * @printable
 */
class Instr {

  /**
   * Creates an {Instr} directly from field values that are already
   * wrapped. Ordinary Zuri code should use `zuri.compile()` instead,
   * because this constructor doesn't wrap anything itself.
   *
   * @param string op: the name of the opcode, such as `'LoadConst'` or
   *    `'Add'`
   * @param ?number line: the source line this instruction was compiled
   *    from, or `nil` if the compiler didn't record one
   * @param dict fields: this opcode's own operands, already wrapped
   */
  @new(op, line, fields) {
    self.op = op
    self.line = line
    self.fields = fields
  }

  /**
   * This instruction as `op@line`, such as `'LoadConst@3'`, or just
   * `op` if it has no line. It's only a one-line summary. Use `dump()`
   * to see what's inside an instruction.
   * @returns string
   */
  to_string() {
    return _header(self)
  }

  @to_string() {
    return self.to_string()
  }

  /**
   * A readable, indented, multi-line dump of this instruction
   * and everything inside it, recursively (including a `Closure`
   * instruction's own nested function body). Same idea as
   * {zuri.ast.Node.dump}: the actual way to find out what an
   * opcode's `fields` looks like is to run something and read
   * the dump, not to guess a key name from the opcode's name
   * alone.
   *
   * ```zuri
   * import zuri
   *
   * var instrs = zuri.compile('var x = 1')
   * echo instrs[0].dump()
   * ```
   * prints
   * ```
   * LoadConst@0
   *   dst: 0
   *   const_idx: 1
   *   value: 1
   * ```
   *
   * @returns string
   */
  dump() {
    return "\n".join(_dump_lines(self, 0))
  }
}

# --- dump() support ---

def _indent(level) {
  var s = ''
  iter var i = 0; i < level; i++ {
    s = s + '  '
  }
  return s
}

def _dump_scalar(value) {
  if value == nil {
    return 'nil'
  }
  if is_string(value) {
    return "'" + value + "'"
  }
  return '${value}'
}

def _header(instr) {
  if instr.line == nil {
    return instr.op
  }
  return '${instr.op}@${instr.line}'
}

def _dump_dict_lines(dict, indent) {
  var lines = []
  for key in dict.keys() {
    var value = dict[key]
    if instance_of(value, Instr) or is_list(value) or is_dict(value) {
      lines.append(_indent(indent) + key + ':')
      lines.extend(_dump_lines(value, indent + 1))
    } else {
      lines.append(_indent(indent) + key + ': ' + _dump_scalar(value))
    }
  }
  return lines
}

def _dump_lines(value, indent) {
  if instance_of(value, Instr) {
    var lines = [_indent(indent) + _header(value)]
    lines.extend(_dump_dict_lines(value.fields, indent + 1))
    return lines
  }

  if is_dict(value) {
    return _dump_dict_lines(value, indent)
  }

  if is_list(value) {
    if value.is_empty() {
      return [_indent(indent) + '[]']
    }
    var lines = []
    for item in value {
      lines.extend(_dump_lines(item, indent))
    }
    return lines
  }

  return [_indent(indent) + _dump_scalar(value)]
}

def _describe(value) {
  if instance_of(value, Instr) {
    return value.op
  }
  return nil
}

/**
 * Visits every instruction that can be reached from `instrs`, which is
 * usually the result of `zuri.compile()` or a single {Instr} taken from
 * it, including those inside the nested function body of a `Closure`
 * instruction, in the order they appear, and calls `visitor` for each
 * one.
 *
 * `visitor` is either a plain function, called with every instruction
 * as `visitor(instr)`, or a dictionary that maps opcode names to
 * functions, so that only matching instructions are visited, as
 * `visitor[instr.op](instr)`. Use the dictionary form when you only
 * care about one or two opcodes.
 *
 * The whole tree is always visited, because `visitor` can't choose to
 * skip a nested function body.
 *
 * ```zuri
 * import zuri
 *
 * var instrs = zuri.compile(source)
 *
 * # Every global name this script writes to, anywhere, including inside
 * # nested function bodies.
 * var written = []
 * zuri.walk_instrs(instrs, {
 *   SetGlobal: @(instr) { written.append(instr.fields.name) },
 * })
 * ```
 *
 * @param Instr|list[Instr] instrs
 * @param function|dict visitor
 */
def walk_instrs(instrs, visitor) {
  _tree.walk(instrs, _describe, visitor, is_dict(visitor))
}

/**
 * Every instruction reachable from `instrs` whose `op` is `op`,
 * in the order they appear. Shorthand for the common "just give
 * me a flat list of these" case `walk_instrs()` itself is built
 * on.
 *
 * ```zuri
 * import zuri
 *
 * var instrs = zuri.compile(source)
 * for jmp in zuri.find_instrs(instrs, 'Jmp') {
 *   echo jmp.fields.offset
 * }
 * ```
 *
 * @param Instr|list[Instr] instrs
 * @param string op
 * @returns list[Instr]
 */
def find_instrs(instrs, op) {
  return _tree.find(instrs, _describe, op)
}

/**
 * Compiles `source` as a standalone script, and returns its
 * instructions as a flat list of {Instr} objects. See this module's
 * documentation for what each instruction contains.
 *
 * If there's a lexer, parser or compiler error, this raises an error,
 * instead of returning partial bytecode.
 *
 * @param string source: the Zuri source to compile
 * @returns list[Instr]
 * @throws Error if `source` doesn't compile
 */
def compile(source) {
  return _zuri_compile.compile(source, Instr)
}

/**
 * Reads the file at `path`, and compiles its contents. This is the same
 * as `compile(file(path).read())`, for the common case of compiling a
 * file instead of a string of source.
 *
 * @param string path: the path of the Zuri source file to compile
 * @returns list[Instr]
 * @throws Error if `path` can't be opened or read, or doesn't compile
 */
def compile_file(path) {
  return compile(file(path).read())
}

/**
 * Imports the module at `path` and returns it, as an `import` statement
 * naming that file would.
 *
 * `import` takes its path as written in the source, so it can't import
 * a file whose name is only known when the program runs. This function
 * can, so it's useful for a directory of plugins, a set of migrations
 * or a file named on the command line.
 *
 * ```zuri,ignore
 * import zuri
 *
 * var plugin = zuri.import_file('plugins/greeter.zu')
 *
 * echo plugin.greet('Ada')
 * ```
 *
 * A relative `path` is taken from the working directory, as for every
 * file function, not from the file that calls this. The file is found
 * in the same way as `import` finds one: `path` itself if it has an
 * extension, and otherwise `path.zu`, and then `path/index.zu`.
 *
 * The module is the same one `import` would give you, from the same
 * cache. Its top-level code runs the first time it's imported, by this
 * function or by an `import`, and never again. Importing the same file
 * twice returns the same module, and an `import` statement elsewhere
 * that names the same file sees it too. Under `zuri run --watch`, a
 * file imported this way is watched like any other module.
 *
 * Read what the module exports with ordinary member access, or use
 * `zuri.reflect.module_info()` to find out what's there first.
 *
 * @param string path: the file to import
 * @returns module
 * @throws ModuleNotFoundError if no file is found at `path`
 * @throws Error if the file doesn't parse or compile, or raises an
 *    error while its top-level code runs. That error is raised
 *    unchanged.
 */
def import_file(path: string) {
  return _zuri_compile.import_file(path)
}

/**
 * Every problem compiling `source` would report, as a list of
 * {zuri.Diagnostic} in the order they occur, without running
 * anything and without raising. An empty list means `source`
 * compiles.
 *
 * Source that does not parse reports its syntax errors, exactly as
 * `parse_partial()` finds them. Source that parses goes on to the
 * compiler, which reports a name declared twice in one scope,
 * `self` or `parent` outside a method, `parent` in a class with no
 * superclass, `break` or `continue` outside a loop, an assignment to
 * a constant, a private member reached through anything other than
 * `self` or `parent`, a class extension declaring a field or an
 * instance method, and a function too large for its registers.
 *
 * ```zuri
 * import zuri
 *
 * for problem in zuri.check('if true {\n  break\n}') {
 *   echo problem  # 2:3: 'break' used outside of a loop
 * }
 *
 * echo zuri.check('var x = 1').length()  # 0
 * ```
 *
 * @param string source: The Zuri source to check
 * @returns list[Diagnostic]
 */
def check(source: string) {
  return _zuri_compile.check(source).map(@(raw) => Diagnostic(raw.message, raw))
}

/**
 * Reads the file at `path`, and checks it. This is the same as
 * `check(file(path).read())`.
 *
 * @param string path: the path of the Zuri source file to check
 * @returns list[Diagnostic]
 * @throws Error if `path` can't be opened or read
 */
def check_file(path: string) {
  return check(file(path).read())
}
