/**
 * @module diagnostic
 *
 * The {Diagnostic} type, which is one problem found in a piece of Zuri
 * source by reading it, without running it, as `zuri.parse_partial()`
 * and `zuri.check()` report them.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

/**
 * One problem in a piece of Zuri source: what's wrong, and exactly
 * where.
 *
 * The position has the same six parts as a {zuri.ast.Node}. `start` and
 * `end` are character offsets, of the first character the problem is
 * about and of the character just after it, so `source[d.start, d.end]`
 * is the text the problem is about. `line` and `col` are where that
 * text starts, and `end_line` and `end_col` are where it ends, all
 * counting from 1.
 *
 * A syntax error covers the token it's about. When the source ends
 * where more was expected, that's an empty span at the very end. A
 * compiler error covers the token it's about, or its whole line, when
 * it applies to the line instead of to one token.
 *
 * @printable
 */
class Diagnostic {

  /**
   * Returns a new {Diagnostic}. Ordinary code gets these from
   * `zuri.parse_partial()` and `zuri.check()`, instead of creating
   * them.
   *
   * @param string message: what's wrong, without a position
   * @param dict position:
   *    `{ start, end, line, col, end_line, end_col }`
   */
  @new(message: string, position: dict) {
    self.message = message
    self.start = position.start
    self.end = position.end
    self.line = position.line
    self.col = position.col
    self.end_line = position.end_line
    self.end_col = position.end_col
  }

  /**
   * This diagnostic as `line:col: message`, e.g.
   * `'2:3: 'break' used outside of a loop'`.
   *
   * @returns string
   */
  to_string() {
    return '${self.line}:${self.col}: ${self.message}'
  }

  @to_string() {
    return self.to_string()
  }
}
