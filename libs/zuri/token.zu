/**
 * @module token
 *
 * The {Token} type that `zuri.tokenize()` returns, with one entry for
 * each token the lexer found in a source file, in source order, with
 * nothing filtered out. Comments, doc blocks and line breaks are all
 * ordinary tokens here, exactly as the lexer produces them. The
 * parser's grammar skips those, but `tokenize()` reports everything the
 * lexer saw.
 *
 * ```zuri
 * import zuri
 *
 * for t in zuri.tokenize('var x = 1 + 2') {
 *   echo '${t.kind} ${t.line}:${t.column} ${t.text}'
 * }
 * ```
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _zuri_lex

/**
 * One token from a Zuri source file.
 *
 * Every token has:
 *
 * - `kind` (string): the kind of token, such as `'Identifier'`,
 *   `'Plus'`, `'Comment'` or `'Eof'`, which is the exact name of the
 *   variant in the lexer's token kind enum.
 * - `line` and `column` (number): the position where the token starts,
 *   counting from 1. `column` counts characters, not bytes.
 * - `start` and `end` (number): the character offsets of the token's
 *   exact text in the source string.
 * - `text` (string): the token's exact source text,
 *   `source[start, end]`, including any delimiters, such as a string
 *   literal's quotes, or a doc block's opening and closing markers.
 * - `value` (any): the token's own value, if it has one. For a literal,
 *   an identifier, a comment or a doc block, that's its string content,
 *   and for a number, it's a number or a bigint. It's `nil` for every
 *   fixed symbol or keyword, and for `Newline` and `Eof`. A token of
 *   kind `Error` has `{ message, line, offset }`, which describes what
 *   went wrong.
 *
 * @printable
 */
class Token {

  /**
   * Returns a new instance of a {Token}. Ordinary Zuri code
   * never needs to call this directly, since `zuri.tokenize()`
   * builds these for you.
   *
   * @param dict data: `{ kind, line, column, start, end, text,
   *    value }`, the token's fields
   */
  @new(data) {
    self.kind = data.kind
    self.line = data.line
    self.column = data.column
    self.start = data.start
    self.end = data.end
    self.text = data.text
    self.value = data.value
  }

  /**
   * Is this token a comment or a doc block? Neither ever reaches
   * the parser's own grammar, but both are real entries in
   * `zuri.tokenize()`'s output.
   *
   * @returns bool
   */
  is_trivia() {
    return self.kind == 'Comment' or self.kind == 'DocBlock'
  }

  /**
   * This token as `kind@line:column`, e.g. `'Identifier@1:5'`.
   * @returns string
   */
  to_string() {
    return '${self.kind}@${self.line}:${self.column}'
  }

  @to_string() {
    return self.to_string()
  }
}

/**
 * Lexes all of `source`, and returns every token in it, in source
 * order, as a list of {Token} objects.
 *
 * Nothing is filtered out: `Comment`, `DocBlock` and `Newline` tokens
 * are all included, and the list always ends with one `Eof` token.
 *
 * A problem in `source` at the lexer level, such as an unterminated
 * string, an unbalanced doc block or an unexpected character, doesn't
 * raise an error. Instead, it appears as an ordinary token whose `kind`
 * is `'Error'`, so this function works with any input, including
 * malformed source.
 *
 * @param string source: the Zuri source to lex
 * @returns list[Token]
 */
def tokenize(source) {
  return _zuri_lex.tokenize(source, Token)
}

/**
 * Reads the file at `path`, and lexes its contents. This is the same as
 * `tokenize(file(path).read())`, for the common case of lexing a file
 * instead of a string of source.
 *
 * @param string path: the path of the Zuri source file to lex
 * @returns list[Token]
 * @throws Error if `path` can't be opened or read
 */
def tokenize_file(path) {
  return tokenize(file(path).read())
}
