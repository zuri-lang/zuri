/**
 * @module _tree
 *
 * For internal use only: the recursive walk that both `walk_nodes()` in
 * `zuri.ast` and `walk_instrs()` in `zuri.compile` are built on. `Node`
 * and `Instr` are intentionally separate classes, because their callers
 * care which one they have, but the tree underneath has the same shape
 * either way: a wrapped value tagged with a string (`kind` or `op`),
 * with a `fields` dictionary whose values are more wrapped values,
 * plain lists, plain dictionaries or scalars. The walk is written once
 * here, instead of twice, because two copies of a recursive walk in two
 * files would sooner or later drift apart, with a bug fixed in only one
 * of them.
 *
 * It isn't part of the public interface of `zuri`. `ast.zu` and
 * `compile.zu` import this file without `@`, so nothing here becomes
 * one of their exports, and `index.zu` never imports it at all.
 */

/**
 * Visits `value` and everything inside it. `describe(value)` decides
 * what counts as a node: it returns the node's dispatch key, `kind` for
 * a `Node` or `op` for an `Instr`, if `value` is a node, or `nil` if
 * it's just a plain list, dictionary or scalar to look inside without
 * visiting. See `walk_nodes()` and `walk_instrs()` for what `describe`
 * looks like.
 *
 * `visitor` is either a plain function, called for every node as
 * `visitor(node)`, or a dictionary that maps dispatch keys to
 * functions, so that only matching nodes are visited, as
 * `visitor[describe(node)](node)`. `is_dict_visitor` says which. The
 * whole tree is always visited, because a visitor can't choose to skip
 * a node's children.
 */
def walk(value, describe, visitor, is_dict_visitor) {
  var key = describe(value)

  if key != nil {
    if is_dict_visitor {
      var handler = visitor.get(key, nil)
      if handler != nil {
        handler(value)
      }
    } else {
      visitor(value)
    }

    for field_key in value.fields.keys() {
      walk(value.fields[field_key], describe, visitor, is_dict_visitor)
    }
    return
  }

  if is_list(value) {
    for item in value {
      walk(item, describe, visitor, is_dict_visitor)
    }
    return
  }

  if is_dict(value) {
    for dict_key in value.keys() {
      walk(value[dict_key], describe, visitor, is_dict_visitor)
    }
  }
}

/**
 * Every node reachable from `value` whose `describe(node)`
 * equals `key`, in the order they appear. Built on `walk()`.
 */
def find(value, describe, key) {
  var matches = []
  walk(value, describe, @(node) {
    if describe(node) == key {
      matches.append(node)
    }
  }, false)
  return matches
}
