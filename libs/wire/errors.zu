/**
 * @module wire.errors
 *
 * The errors that Wire raises, and the location information they carry.
 *
 * Each error knows which template it came from and, if the problem can
 * be traced to a particular tag, the line and column where that tag
 * starts. An error that only says that something is wrong isn't much
 * help once a layout is a few files deep, so the location is part of
 * the error, and whoever catches it doesn't have to work it out again.
 *
 * @copyright 2026, Richard Ore and The Zuri Contributors
 */

/**
 * The base class of every error that Wire raises.
 *
 * Catching it catches all of them, which is what a web handler should
 * do if it wants to turn any template failure into a 500 page.
 *
 * ```zuri
 * import wire
 *
 * catch {
 *   echo wire.render('dashboard')
 * } as e {
 *   if instance_of(e, wire.WireError) {
 *     echo 'template problem in ${e.path}: ${e.reason}'
 *   }
 * }
 * ```
 */
class WireError < Error {

  /**
   * The template the problem was found in: a file path for a template
   * read from disk, or whatever was passed as the source name for one
   * rendered from a string, which defaults to `<source>`.
   */
  var path = '<source>'

  /**
   * The line the offending tag started on, counting from 1, or `0`
   * when the problem cannot be tied to one place in the source.
   */
  var line = 0

  /**
   * The column the offending tag started at, counting from 1, or `0`.
   */
  var column = 0

  /**
   * The problem on its own, without the location that `message` glues
   * onto the end of it.
   */
  var reason = ''

  /**
   * @param string reason: what went wrong, without any location. The
   *    location is added for you.
   * @param ?string path: the template the problem is in. Defaults to
   *    `<source>`.
   * @param ?number line: the line, counting from 1. Leave it out or
   *    pass `0` if there's no meaningful line.
   * @param ?number column: the column, counting from 1
   * @constructor
   */
  @new(reason: string, path: ?string, line: ?number, column: ?number) {
    self.path = '<source>'
    if path != nil {
      self.path = path
    }

    self.line = 0
    if line != nil {
      self.line = line
    }

    self.column = 0
    if column != nil {
      self.column = column
    }

    self.reason = reason

    parent(_describe(reason, self.path, self.line, self.column))
  }

  /**
   * Where the problem is, as `path[line,column]`, or just the path when
   * no line was recorded.
   *
   * @returns string
   */
  location() {
    if self.line == 0 {
      return self.path
    }

    return '${self.path}[${self.line},${self.column}]'
  }
}

/**
 * Raised when a template file can't be found, or when its path resolves
 * to somewhere outside the root directory.
 *
 * A path that climbs out of the root with `..` is reported as not
 * found, not as a permission problem, so that a template can't be used
 * to find out which files exist on the system.
 */
class TemplateNotFoundError < WireError {

  /**
   * @param string reason
   * @param ?string path
   * @param ?number line
   * @param ?number column
   * @constructor
   */
  @new(reason: string, path: ?string, line: ?number, column: ?number) {
    parent(reason, path, line, column)
  }
}

/**
 * Raised while a template is compiled, for anything that Wire can tell
 * is wrong without rendering it: an unknown directive, an expression
 * that doesn't parse, an `x-elif` without an `x-if` in front of it, or
 * a region defined twice.
 *
 * A template is compiled once, not every time it's rendered, so these
 * errors appear the first time a template is used, not on every request
 * after that.
 */
class TemplateSyntaxError < WireError {

  /**
   * @param string reason
   * @param ?string path
   * @param ?number line
   * @param ?number column
   * @constructor
   */
  @new(reason: string, path: ?string, line: ?number, column: ?number) {
    parent(reason, path, line, column)
  }
}

/**
 * Raised while a template is rendered, for anything that depends on the
 * values it was given: looping over something that can't be iterated, a
 * filter that rejects its input, or includes that never stop including
 * each other.
 *
 * A variable that simply wasn't supplied doesn't cause one of these.
 * Missing variables render as nothing and count as false in a test, so
 * that optional sections are easy to write.
 */
class RenderError < WireError {

  /**
   * @param string reason
   * @param ?string path
   * @param ?number line
   * @param ?number column
   * @constructor
   */
  @new(reason: string, path: ?string, line: ?number, column: ?number) {
    parent(reason, path, line, column)
  }
}

/**
 * Glues a reason and a location into the message the error carries.
 *
 * @param string reason
 * @param string path
 * @param number line
 * @param number column
 * @returns string
 */
def _describe(reason: string, path: string, line: number, column: number) {
  if line == 0 {
    return '${reason} in ${path}'
  }

  return '${reason} at ${path}[${line},${column}]'
}
