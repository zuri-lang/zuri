/**
 * @module tcp
 *
 * TCP sockets, for both connecting to a server and listening for
 * connections.
 *
 * Use this module to work with TCP directly, for example to implement a
 * standard or custom network protocol.
 *
 * This example is a very small HTTP client:
 *
 * ```zuri
 * import net
 *
 * var stream = net.TcpStream()
 * stream.connect('example.com:80')
 * stream.write_all('GET / HTTP/1.0\r\nHost: example.com\r\n\r\n')
 *
 * echo stream.read_as_string()
 * stream.close()
 * ```
 *
 * A listening socket works in a similar way. This example accepts
 * connections on port 8080, and replies to each client with its own
 * address:
 *
 * ```zuri
 * import net
 *
 * var server = net.TcpStream()
 * server.bind('0.0.0.0:8080')
 * echo 'listening on ${server.local_address()}'
 *
 * while true {
 *   var client = server.accept()
 *   client.write_all('hello, ${client.peer_address()}\n')
 *   client.close()
 * }
 * ```
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _net_tcp
import .addr { SocketAddr }

/**
 * Accepts either a plain `'ip:port'` string or a `SocketAddr`
 * (as `local_address()`/`peer_address()` hand back) anywhere an
 * address is expected, so the natural "connect to what another
 * socket is listening on" round-trip doesn't force a manual
 * `.to_string()`.
 */
def _addr_string(address) {
  return instance_of(address, SocketAddr) ? address.to_string() : address
}

/**
 * Resolves `address`, a `host:port` string whose host can be a name or
 * an IP address, into every socket address it refers to, in the order
 * the resolver returned them.
 *
 * A host name often maps to several addresses, at least an IPv6 and an
 * IPv4 address, which is why this returns a list. `connect()` does its
 * own resolution when it's given a name, so this is mainly useful when
 * you need the actual address first: to connect with a timeout, which
 * requires an IP address, to prefer one address family, or just to find
 * out what a name points to.
 *
 * ```zuri
 * import net
 *
 * echo net.resolve('example.com:443')
 * # [93.184.215.14:443]
 * ```
 *
 * @param {string|SocketAddr} address: the `host:port` to resolve
 * @returns list: one or more `SocketAddr`
 * @throws Error if the name can't be resolved, or resolves to nothing
 */
def resolve(address) {
  var resolved = _net_tcp.tcp_resolve(_addr_string(address))

  return resolved.map(@(entry) {
    return SocketAddr.parse(entry)
  })
}

/**
 * Used with `TcpStream.shutdown()` to select which half (or both
 * halves) of a full-duplex TCP connection to shut down. Shutting
 * down a stream only affects the local socket as it is a local
 * operation and does not send anything resembling a FIN/EOF
 * marker to the peer beyond what the underlying platform's
 * `shutdown(2)` implementation does.
 */
class Shutdown {

  /**
   * Shut down both the read and write halves of the connection.
   * This is the default used by `TcpStream.shutdown()` when no
   * argument is given.
   *
   * @type number
   */
  static var BOTH = 0

  /**
   * Shut down the read half of the connection. Any further reads
   * will return zero bytes (EOF), and any data currently in the
   * socket's receive buffer is discarded. The write half is left
   * untouched.
   *
   * @type number
   */
  static var READ = 1

  /**
   * Shut down the write half of the connection. Any further
   * writes will fail. The read half is left untouched.
   *
   * @type number
   */
  static var WRITE = 2
}

/**
 * A TCP socket, in either its connected-stream or
 * listening-server role.
 *
 * @note On Unix systems, writes to the underlying socket in
 *    `SOCK_STREAM` mode are made with `MSG_NOSIGNAL` flag. This
 *    suppresses the emission of the `SIGPIPE` signal when
 *    writing to disconnected socket.
 *
 * @note It's a good practice to call `close()` explicitly once
 *    you are done with an instance instead of relying on Zuri to
 *    release the socket for you.
 *
 * @printable
 */
class TcpStream {

  /**
   * Returns a new instance of a {TcpStream}.
   */
  @new(_ptr) {
    self._ptr = _ptr == nil ? _net_tcp.tcp_new() : _ptr
  }

  /**
   * Returns this stream's native socket handle. `_ptr` is private, like
   * every field whose name starts with `_`, so a module like `tls`,
   * which has to take a connected `TcpStream` and wrap it, without
   * belonging to this class or inheriting from it, has no other way to
   * reach it.
   *
   * @returns Ptr
   */
  native_ptr() {
    return self._ptr
  }

  /**
   * Opens a TCP connection to a remote host, which turns this object
   * into a connected stream.
   *
   * `address` is a host name or an IP address, with a port, such as
   * `'example.com:80'` or `'127.0.0.1:8080'`. A host name can resolve
   * to several addresses. They're tried in turn, and the first one that
   * succeeds is used, so this call can succeed even if some of the
   * addresses were unreachable.
   *
   * Pass `timeout` to limit how long the connection attempt can take.
   * When a timeout is given, `address` must be an IP address and port,
   * not a host name, because no DNS resolution is done, and so there's
   * no fallback to other addresses.
   *
   * @note A timeout of `0` is the same as no timeout.
   * @param {string|SocketAddr} address: the host and port to connect to
   * @param ?int timeout: the number of milliseconds to wait before
   *    giving up. Leave it out for no time limit.
   * @throws Error if resolution fails, if every resolved address
   *    refuses the connection, or, when `timeout` is given, if
   *    `address` isn't an IP address and port or the timeout passes
   *    first.
   */
  connect(address, timeout) {
    _net_tcp.tcp_connect(self._ptr, _addr_string(address), timeout)
  }

  /**
   * Binds this object to `address` and starts listening for incoming
   * connections, which turns it into a server.
   *
   * `address` is a host name or an IP address, with a port, such as
   * `'0.0.0.0:8080'` or `'[::]:8080'`. Port `0` asks the operating
   * system to choose a free port, which you can then find with
   * `local_address()`. If `address` resolves to several addresses, each
   * one is tried in turn until one can be bound.
   *
   * @param {string|SocketAddr} address: the host and port to bind to
   *    and listen on
   * @throws Error if resolution fails, or no resolved address can be
   *    bound, for example because it's already in use
   */
  bind(address) {
    _net_tcp.tcp_bind(self._ptr, _addr_string(address))
  }

  /**
   * Accepts a new incoming connection. This only works after `bind()`
   * has been called.
   *
   * It waits until a connection arrives, and returns a connected
   * `TcpStream` for the new client. To find out who connected, call
   * `peer_address()` on it.
   *
   * In non-blocking mode, set with `set_non_blocking()`, it never
   * waits, and returns `nil` when no connection is waiting. That's an
   * answer, not a failure, so no error is raised.
   *
   * The accepted stream can have its own blocking mode, which is the
   * platform's default, not necessarily the listener's. If it matters,
   * set it explicitly with `set_non_blocking()` on the returned stream.
   *
   * @returns ?TcpStream a stream connected to the new client, or `nil`
   *    in non-blocking mode when nobody is waiting
   * @throws Error on an I/O error, or if this object hasn't been bound
   */
  accept() {
    var client = _net_tcp.tcp_accept(self._ptr)

    if client == nil {
      return nil
    }

    return TcpStream(client)
  }

  /**
   * Returns the socket address of the remote peer this stream is
   * connected to.
   *
   * @returns SocketAddr the peer's address
   * @throws Error if this instance is not a connected stream
   */
  peer_address() {
    return SocketAddr.parse(_net_tcp.tcp_peer_address(self._ptr))
  }

  /**
   * Returns the local socket address of this instance, i.e. the
   * address it connected from if it is a stream, or the address
   * it is listening on if it is a listener.
   *
   * This is particularly useful for discovering the actual port
   * chosen by the OS after binding to port `0`.
   *
   * @returns SocketAddr the local address
   * @throws Error if this instance is neither connected nor
   *    bound
   */
  local_address() {
    return SocketAddr.parse(_net_tcp.tcp_local_address(self._ptr))
  }

  /**
   * Shuts down the reading half, the writing half or both halves of
   * this connection. See `Shutdown` for what each value means. If `how`
   * is left out, it defaults to `Shutdown.BOTH`. This only works on a
   * connected stream. Calling it more than once can raise an error on
   * some platforms.
   *
   * @param ?int how: one of the `Shutdown` constants
   * @throws Error if the underlying `shutdown(2)` call fails, or if
   *    this object isn't a connected stream
   */
  shutdown(how) {
    _net_tcp.tcp_shutdown(self._ptr, how)
  }

  /**
   * Sets the timeout for future
   * `read()`/`read_exact()`/`read_all()`/ `read_as_string()`
   * calls.
   *
   * Pass a number of milliseconds greater than `0` to bound how
   * long a read may block before raising a timeout error, or
   * pass `0` (or any negative number) to remove the timeout
   * entirely and block indefinitely.
   *
   * @note A set timeout is an upper bound: a future read may
   *    still return before that bound is reached, and system
   *    timers mean the actual time elapsed before a timeout
   *    error can be slightly longer than what was requested.
   *
   * @param number timeout: Milliseconds, or a negative number to
   *    disable the timeout
   * @throws Error if the platform rejects the value
   */
  set_read_timeout(timeout) {
    _net_tcp.tcp_set_read_timeout(self._ptr, timeout)
  }

  /**
   * Returns the currently configured read timeout in
   * milliseconds, or `-1` if no timeout is set (i.e. reads block
   * indefinitely).
   *
   * @note Some platforms do not provide access to the current
   *    timeout.
   * @returns number milliseconds, or `-1` if unset
   */
  get_read_timeout() {
    return _net_tcp.tcp_get_read_timeout(self._ptr)
  }

  /**
   * Sets the timeout for future `write()`/`write_all()` calls.
   * Same rules as `set_read_timeout()`: a number of milliseconds
   * greater than `0` bounds how long a write may block, `0` (or
   * any negative number) disables the timeout.
   *
   * @param number timeout: Milliseconds, or a negative number to
   *    disable the timeout
   * @throws Error if the platform rejects the value
   */
  set_write_timeout(timeout) {
    _net_tcp.tcp_set_write_timeout(self._ptr, timeout)
  }

  /**
   * Returns the currently configured write timeout in
   * milliseconds, or `-1` if no timeout is set (i.e. writes
   * block indefinitely).
   *
   * @note Some platforms do not provide access to the current
   *    timeout.
   * @returns number milliseconds, or `-1` if unset
   */
  get_write_timeout() {
    return _net_tcp.tcp_get_write_timeout(self._ptr)
  }

  /**
   * Peeks at up to `length` bytes of incoming data without
   * consuming it such that a subsequent `read()`/`read_exact()`
   * call will still see the peeked bytes. Defaults to peeking a
   * single byte when `length` is omitted.
   *
   * Successful peeks can, and often do, return fewer bytes than
   * `length`.
   *
   * @param number length: The maximum number of bytes to peek
   * @returns bytes up to `length` bytes currently in the receive
   *    buffer (`nil` if none are available yet)
   * @throws Error on an underlying I/O error
   */
  peek(length) {
    return _net_tcp.tcp_peek(self._ptr, length)
  }

  /**
   * Enables or disables `TCP_NODELAY` (i.e. disables or enables
   * Nagle's algorithm). When nodelay is enabled, small writes
   * are sent immediately instead of being buffered in the hope
   * of coalescing them with subsequent writes, trading
   * throughput for lower latency.
   *
   * @param bool nodelay: `true` to disable Nagle's algorithm
   * @throws Error on an underlying I/O error
   */
  set_nodelay(nodelay) {
    _net_tcp.tcp_set_nodelay(self._ptr, nodelay)
  }

  /**
   * Returns whether `TCP_NODELAY` is currently enabled on this
   * stream.
   *
   * @returns bool
   */
  get_nodelay() {
    return _net_tcp.tcp_get_nodelay(self._ptr)
  }

  /**
   * Sets `IP_TTL` (the IPv4 time-to-live / IPv6 hop limit) for
   * packets sent on this socket. For a listener, this is the TTL
   * that will be used by sockets it accepts.
   *
   * @param number ttl: The time-to-live value, `0`-`255`
   * @throws Error on an underlying I/O error
   */
  set_ttl(ttl) {
    _net_tcp.tcp_set_ttl(self._ptr, ttl)
  }

  /**
   * Returns the currently configured `IP_TTL` value for this
   * socket.
   *
   * @returns number
   * @throws Error on an underlying I/O error
   */
  get_ttl() {
    return _net_tcp.tcp_get_ttl(self._ptr)
  }

  /**
   * Reads and clears the socket's `SO_ERROR` option, which is any error
   * that the operating system has recorded for this socket but hasn't
   * yet reported through a failed read, write or `accept()`.
   *
   * @returns ?string a description of the pending error, or `nil` if
   *    there isn't one
   * @throws Error on an I/O error while querying the socket
   */
  get_error() {
    return _net_tcp.tcp_get_error(self._ptr)
  }

  /**
   * Puts the socket into or out of non-blocking mode. In
   * non-blocking mode, `read()`/`write()`/`accept()` and friends
   * return immediately with an error instead of blocking when
   * the operation would otherwise wait on I/O.
   *
   * @param bool nonblocking: `true` to enable non-blocking mode
   * @throws Error on an underlying I/O error
   */
  set_non_blocking(nonblocking) {
    _net_tcp.tcp_set_non_blocking(self._ptr, nonblocking)
  }

  /**
   * Reads up to `length` bytes from the stream, and returns them in a
   * new buffer. It's quite normal for this to return fewer bytes than
   * `length`, even when more data will arrive later, so code that needs
   * an exact amount of data should call this in a loop, or use
   * `read_exact()` instead.
   *
   * An empty result means that the peer has closed its writing half,
   * which is the end of the stream.
   *
   * @param number length: the maximum number of bytes to read
   * @returns bytes up to `length` bytes read from the stream, which can
   *    be empty at the end of the stream
   * @throws Error on an I/O error, or if the read timeout passes first
   */
  read(length) {
    return _net_tcp.tcp_read(self._ptr, length)
  }

  /**
   * Reads whatever has already arrived, for a stream in non-blocking
   * mode (see `set_non_blocking()`) that's watched by a `Poller`. It's
   * the same as `read()`, except that "nothing yet" is a result, not an
   * error, because that's the usual outcome in that mode.
   *
   * @param number length: the maximum number of bytes to read
   * @returns ?bytes up to `length` bytes, empty at the end of the
   *    stream, or `nil` if nothing has arrived yet
   * @throws Error on an I/O error
   */
  try_read(length) {
    return _net_tcp.tcp_try_read(self._ptr, length)
  }

  /**
   * Reads exactly `length` bytes from the stream, waiting, subject to
   * the read timeout, until that many bytes have arrived.
   *
   * If the stream ends before `length` bytes have been read, this
   * raises an error, and any bytes already read are lost.
   *
   * @param number length: the exact number of bytes to read
   * @returns bytes exactly `length` bytes
   * @throws Error if the stream ends early, or on any other I/O error
   */
  read_exact(length) {
    return _net_tcp.tcp_read_exact(self._ptr, length)
  }

  /**
   * Reads from the stream until EOF, returning everything
   * received as a single byte stream. Since a stream is only
   * closed by the peer (or by calling `shutdown()`/`close()`),
   * this will block until the connection is closed. Therefore,
   * do not call this on a stream you expect to stay open, or set
   * a read timeout first.
   *
   * @returns bytes every byte read up to EOF
   * @throws Error on an underlying I/O error
   */
  read_all() {
    return _net_tcp.tcp_read_all(self._ptr)
  }

  /**
   * Reads from the stream until EOF, decoding everything
   * received as UTF-8 text. Like `read_all()`, this blocks until
   * the peer closes the connection. Fails if the received bytes
   * are not valid UTF-8, in which case the data already read is
   * discarded.
   *
   * @returns string every byte read up to EOF, decoded as UTF-8
   * @throws Error on an underlying I/O error, or if the data is
   *    not valid UTF-8
   */
  read_as_string() {
    return _net_tcp.tcp_read_as_string(self._ptr)
  }

  /**
   * Writes `data` to the stream, returning the number of bytes
   * actually written. A successful call may write fewer bytes
   * than `data` contains. Use `write_all()` if you need every
   * byte written before continuing.
   *
   * @param {bytes|string} data: The bytes (or UTF-8 text) to
   *    write
   * @returns number the number of bytes actually written
   * @throws Error on an underlying I/O error, or if the
   *    configured write timeout elapses first
   */
  write(data) {
    return _net_tcp.tcp_write(self._ptr, data)
  }

  /**
   * Writes as much of `data` as the socket accepts right now, for a
   * stream in non-blocking mode, and returns how much that was. It's
   * the same as `write()`, except that "no room" is a result, not an
   * error.
   *
   * @param {bytes|string} data: the bytes, or UTF-8 text, to write
   * @param ?number offset: where in `data` to start. Defaults to `0`.
   *    It lets a caller continue a partial write without copying the
   *    rest of the data.
   * @returns number the number of bytes accepted, or `0` if the socket
   *    has no room
   * @throws Error on an I/O error
   */
  try_write(data, offset: ?number) {
    return _net_tcp.tcp_try_write(self._ptr, data, offset == nil ? 0 : offset)
  }

  /**
   * Writes the entirety of `data` to the stream, blocking
   * (subject to the write timeout) and retrying internally until
   * every byte has been written.
   *
   * @param {bytes|string} data: The bytes (or UTF-8 text) to
   *    write
   * @throws Error on an underlying I/O error, or if the
   *    configured write timeout elapses first
   */
  write_all(data) {
    _net_tcp.tcp_write_all(self._ptr, data)
  }

  /**
   * Flushes any buffered output. TCP streams are unbuffered at
   * this layer, so this is a no-op and doesn't currently do
   * anything for `TcpStream`. This is a no-op provided purely so
   * this class satisfies the same interface as other writable
   * streams in the standard library.
   *
   * @throws Error on an underlying I/O error
   */
  flush() {
    _net_tcp.tcp_flush(self._ptr)
  }

  /**
   * Whether this instance currently wraps a connected stream
   * (i.e. `connect()` has succeeded and `close()` has not been
   * called since).
   *
   * @returns bool
   */
  is_connected() {
    return _net_tcp.tcp_is_connected(self._ptr)
  }

  /**
   * Whether this instance currently wraps a bound listener (i.e.
   * `bind()` has succeeded and `close()` has not been called
   * since).
   *
   * @returns bool
   */
  is_bound() {
    return _net_tcp.tcp_is_bound(self._ptr)
  }

  /**
   * Flushes, shuts down and releases the socket, whether it's a
   * connected stream or a listening socket. Call this yourself when
   * you've finished with the socket, instead of waiting for the garbage
   * collector to do it eventually. It's safe to call more than once,
   * and on an object that was never connected or bound.
   */
  close() {
    _net_tcp.tcp_close(self._ptr)
  }

  /**
   * A human readable representation of this socket, showing
   * whichever of the connected-stream or bound-listener
   * addresses apply.
   *
   * @returns string
   */
  to_string() {
    if self.is_connected() {
      return '<TcpStream ${self.local_address().to_string()} -> ${self.peer_address().to_string()}>'
    }
    if self.is_bound() {
      return '<TcpStream listening on ${self.local_address().to_string()}>'
    }
    return '<TcpStream unconnected>'
  }

  @to_string() {
    return self.to_string()
  }
}
