/**
 * @module udp
 *
 * This module provides a complete implementation of the User
 * Datagram Protocol as specified in IETF RFC 768. It provides an
 * interface for sending and receiving individual datagrams,
 * including support for broadcast and multicast delivery.
 *
 * Unlike TCP, UDP is connectionless: there is no handshake, no
 * guarantee of delivery or ordering, and no notion of a byte
 * stream - every send or receive operates on a single,
 * self-contained datagram.
 *
 * It is meant to be used to provide more controlled and specific
 * UDP-based operating system features and for implementing
 * various standard and custom network protocols and
 * specifications.
 *
 * The example below shows how to use this module for a simple
 * request/response exchange with a remote host.
 *
 * ```zuri
 * import net
 *
 * var socket = net.UdpSocket()
 * socket.connect('example.com:9000')
 * socket.send('ping')
 *
 * echo socket.receive(512)
 * socket.close()
 * ```
 *
 * A socket can also be bound to a local address to receive
 * datagrams from any sender, as shown below with a basic
 * listener on port 9000.
 *
 * ```zuri
 * import net
 *
 * var server = net.UdpSocket()
 * server.bind('0.0.0.0:9000')
 * echo 'listening on ${server.local_address()}'
 *
 * while true {
 *   echo 'received: ${server.receive_from(512)}'
 * }
 * ```
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _net_udp
import .addr { SocketAddr }

/**
 * Accepts either a plain `'ip:port'` string or a `SocketAddr`
 * (as `local_address()`/`peer_address()` hand back) anywhere an
 * address is expected, so the natural "connect to what another
 * socket is listening on" round-trip doesn't force a manual
 * `.to_string()`.
 */
def _addr_string(address) {
  return instance_of(address, SocketAddr) ? address.to_string() : address
}

/**
 * A UDP socket, usable for both sending and receiving datagrams,
 * either to/from a single fixed peer (after `connect()`) or
 * to/from arbitrary addresses (via
 * `send_to()`/`receive_from()`/`peek_from()`).
 *
 * Unlike a TCP stream, `connect()` and `bind()` are not mutually
 * exclusive here: a socket may be bound to a local address and
 * then separately connected to a default remote peer.
 *
 * @note `UdpSocket.connect()` only narrows which peer
 *    `send()`/`recv()` talk to and does not perform any
 *    handshake.
 *
 * @note It's a good practice to call `close()` explicitly once
 *    you are done with an instance instead of relying on Zuri to
 *    release the socket for you.
 *
 * @printable
 */
class UdpSocket {

  /**
   * Returns a new instance of a {UdpSocket}, backed by a fresh,
   * unbound and unconnected native socket. Use `bind()` to
   * receive datagrams on a local address, and/or `connect()` to
   * fix the peer used by `send()`/`receive()`.
   */
  @new() {
    self._ptr = _net_udp.udp_new()
  }

  /**
   * Connects this socket to a remote address. This does not
   * perform a handshake - UDP is connectionless - it simply
   * records `address` as the default peer for future
   * `send()`/`receive()`/`peek()` calls, and filters out
   * datagrams arriving from any other address. Calling this
   * again re-targets the socket at a new peer.
   *
   * `address` may be a hostname or an IP literal, combined with
   * a port, e.g. `'example.com:9000'` or `'127.0.0.1:9000'`. A
   * hostname may resolve to several addresses; they are tried in
   * turn and the first one that succeeds is used.
   *
   * @param {string|SocketAddr} address: The host:port to treat
   *    as the default peer
   * @throws Error if resolution fails or every resolved address
   *    is rejected
   */
  connect(address) {
    _net_udp.udp_connect(self._ptr, _addr_string(address))
  }

  /**
   * Binds this socket to `address`, allowing it to receive
   * datagrams sent to that address.
   *
   * `address` may be a hostname or an IP literal combined with a
   * port, e.g. `'0.0.0.0:9000'` or `'[::]:9000'`; port `0` asks
   * the OS to assign an available ephemeral port, which can then
   * be discovered via `local_address()`. If `address` resolves
   * to multiple addresses, binding is attempted against each in
   * turn until one succeeds.
   *
   * @param {string|SocketAddr} address: The host:port to bind
   *    and receive on
   * @throws Error if resolution fails or every resolved address
   *    fails to bind (e.g. because it is already in use)
   */
  bind(address) {
    _net_udp.udp_bind(self._ptr, _addr_string(address))
  }

  /**
   * Returns the address of the remote peer this socket was
   * connected to via `connect()`.
   *
   * @returns SocketAddr the peer's address
   * @throws Error if this socket has not been connected
   */
  peer_address() {
    return SocketAddr.parse(_net_udp.udp_peer_address(self._ptr))
  }

  /**
   * Returns the local socket address of this instance.
   * Particularly useful for discovering the actual port chosen
   * by the OS after binding to port `0`.
   *
   * @returns SocketAddr the local address
   * @throws Error if this socket has not been bound
   */
  local_address() {
    return SocketAddr.parse(_net_udp.udp_local_address(self._ptr))
  }

  /**
   * Sets the timeout for future `receive()`/`peek()` calls.
   *
   * Pass a number of milliseconds greater than `0` to bound how
   * long a read may block before raising a timeout error, or
   * pass `0` (or any negative number) to remove the timeout
   * entirely and block indefinitely.
   *
   * @note Some platforms do not provide access to the current
   *    timeout.
   * @param number timeout: Milliseconds, or a negative number to
   *    disable the timeout
   * @throws Error if the platform rejects the value
   */
  set_read_timeout(timeout) {
    _net_udp.udp_set_read_timeout(self._ptr, timeout)
  }

  /**
   * Returns the currently configured read timeout in
   * milliseconds, or `-1` if no timeout is set (i.e. reads block
   * indefinitely).
   *
   * @returns number milliseconds, or `-1` if unset
   */
  get_read_timeout() {
    return _net_udp.udp_get_read_timeout(self._ptr)
  }

  /**
   * Sets the timeout for future `send()` calls. Same rules as
   * `set_read_timeout()`: a number of milliseconds greater than
   * `0` bounds how long a send may block, `0` (or any negative
   * number) disables the timeout.
   *
   * @note A send only blocks in the first place when the OS's
   *    outgoing socket buffer is full, which is uncommon for
   *    datagram sockets.
   * @param number timeout: Milliseconds, or a negative number to
   *    disable the timeout
   * @throws Error if the platform rejects the value
   */
  set_write_timeout(timeout) {
    _net_udp.udp_set_write_timeout(self._ptr, timeout)
  }

  /**
   * Returns the currently configured write timeout in
   * milliseconds, or `-1` if no timeout is set (i.e. sends block
   * indefinitely).
   *
   * @returns number milliseconds, or `-1` if unset
   */
  get_write_timeout() {
    return _net_udp.udp_get_write_timeout(self._ptr)
  }

  /**
   * Peeks at the next incoming datagram from the connected peer
   * without removing it from the socket's receive queue - a
   * subsequent `receive()`/`peek()` call will still see it.
   * Defaults to peeking a single byte when `length` is omitted.
   *
   * Requires a connected socket, since (like `receive()`) it
   * only reads from the peer set via `connect()`. Use
   * `peek_from()` on a socket that is only bound.
   *
   * @param number length: The maximum number of bytes to peek
   * @returns bytes up to `length` bytes of the pending datagram
   * @throws Error on an underlying I/O error, or if this socket
   *    has not been connected
   */
  peek(length) {
    return _net_udp.udp_peek(self._ptr, length)
  }

  /**
   * Peeks at the next incoming datagram from any sender without
   * removing it from the socket's receive queue - a subsequent
   * `receive_from()`/`peek_from()` call will still see it.
   * Defaults to peeking a single byte when `length` is omitted.
   * Unlike `peek()`, this does not require a connected socket.
   *
   * @param number length: The maximum number of bytes to peek
   * @returns {data: bytes, address: SocketAddr} the pending
   *    datagram's bytes and the address it was sent from
   * @throws Error on an underlying I/O error
   */
  peek_from(length) {
    var result = _net_udp.udp_peek_from(self._ptr, length)
    var data = result.data
    var address = SocketAddr.parse(result.address)
    return { data, address }
  }

  /**
   * Sets `IP_TTL` (the IPv4 time-to-live / IPv6 hop limit) used
   * for regular, non-multicast datagrams sent on this socket.
   *
   * @param number ttl: The time-to-live value, `0`-`255`
   * @throws Error on an underlying I/O error
   */
  set_ttl(ttl) {
    _net_udp.udp_set_ttl(self._ptr, ttl)
  }

  /**
   * Returns the currently configured `IP_TTL` value for this
   * socket.
   *
   * @returns number
   * @throws Error on an underlying I/O error
   */
  get_ttl() {
    return _net_udp.udp_get_ttl(self._ptr)
  }

  /**
   * Retrieves and clears the value of the socket's `SO_ERROR`
   * option - i.e. any pending error the OS has recorded for this
   * socket without yet surfacing through a failed send or
   * receive.
   *
   * @returns ?string a description of the pending error, or
   *    `nil` if there is none
   * @throws Error on an underlying I/O error while querying the
   *    socket
   */
  get_error() {
    return _net_udp.udp_get_error(self._ptr)
  }

  /**
   * Puts the socket into or out of non-blocking mode. In
   * non-blocking mode, `receive()`/`receive_from()`/`send()` and
   * friends return immediately with an error instead of blocking
   * when the operation would otherwise wait on I/O.
   *
   * @param bool nonblocking: `true` to enable non-blocking mode
   * @throws Error on an underlying I/O error
   */
  set_non_blocking(nonblocking) {
    _net_udp.udp_set_non_blocking(self._ptr, nonblocking)
  }

  /**
   * Enables or disables `SO_BROADCAST`. This must be enabled
   * before `send_to()` can deliver a datagram to a broadcast
   * address, such as `255.255.255.255`.
   *
   * @param bool broadcast: `true` to allow sending to broadcast
   *    addresses
   * @throws Error on an underlying I/O error
   */
  set_broadcast(broadcast) {
    _net_udp.udp_set_broadcast(self._ptr, broadcast)
  }

  /**
   * Returns whether `SO_BROADCAST` is currently enabled on this
   * socket.
   *
   * @returns bool
   */
  get_broadcast() {
    return _net_udp.udp_get_broadcast(self._ptr)
  }

  /**
   * Enables or disables `IP_MULTICAST_LOOP` for IPv4 multicast.
   * When enabled (the default), multicast datagrams sent from
   * this socket are also looped back and delivered to this same
   * host if it has joined the destination group.
   *
   * @param bool loop: `true` to loop sent multicast datagrams
   *    back
   * @throws Error on an underlying I/O error
   */
  set_multicast_loop_v4(loop) {
    _net_udp.udp_set_multicast_loop_v4(self._ptr, loop)
  }

  /**
   * Returns whether `IP_MULTICAST_LOOP` is currently enabled for
   * IPv4 multicast on this socket.
   *
   * @returns bool
   */
  get_multicast_loop_v4() {
    return _net_udp.udp_get_multicast_loop_v4(self._ptr)
  }

  /**
   * Sets `IP_MULTICAST_TTL`, the time-to-live used specifically
   * for outgoing IPv4 multicast datagrams sent on this socket,
   * independent of the regular `IP_TTL` set via `set_ttl()`.
   * Defaults to `1`, restricting multicast datagrams to the
   * local network.
   *
   * @param number ttl: The multicast time-to-live value,
   *    `0`-`255`
   * @throws Error on an underlying I/O error
   */
  set_multicast_ttl_v4(ttl) {
    _net_udp.udp_set_multicast_ttl_v4(self._ptr, ttl)
  }

  /**
   * Returns the currently configured `IP_MULTICAST_TTL` value
   * for IPv4 multicast on this socket.
   *
   * @returns number
   * @throws Error on an underlying I/O error
   */
  get_multicast_ttl_v4() {
    return _net_udp.udp_get_multicast_ttl_v4(self._ptr)
  }

  /**
   * Enables or disables `IPV6_MULTICAST_LOOP` for IPv6
   * multicast. When enabled (the default), multicast datagrams
   * sent from this socket are also looped back and delivered to
   * this same host if it has joined the destination group.
   *
   * @param bool loop: `true` to loop sent multicast datagrams
   *    back
   * @throws Error on an underlying I/O error
   */
  set_multicast_loop_v6(loop) {
    _net_udp.udp_set_multicast_loop_v6(self._ptr, loop)
  }

  /**
   * Returns whether `IPV6_MULTICAST_LOOP` is currently enabled
   * for IPv6 multicast on this socket.
   *
   * @returns bool
   */
  get_multicast_loop_v6() {
    return _net_udp.udp_get_multicast_loop_v6(self._ptr)
  }

  /**
   * Receives a single datagram from the connected peer into a
   * newly allocated byte buffer of up to `length` bytes.
   * Requires a connected socket, since (like `peek()`) it only
   * reads from the peer set via `connect()`. Use
   * `receive_from()` on a socket that is only bound.
   *
   * @note A datagram read is all-or-nothing per message: if the
   *    incoming datagram is larger than `length`, the excess
   *    bytes are discarded rather than being returned on a
   *    subsequent call - this is unlike a TCP stream, where a
   *    short read just leaves the rest to be read later.
   *
   * An empty result means an empty (zero-length) datagram was
   * received, which is valid and distinct from there being
   * nothing to receive.
   *
   * @param number length: The maximum number of bytes to read
   * @returns bytes up to `length` bytes of the received datagram
   * @throws Error on an underlying I/O error, or if the
   *    configured read timeout elapses first
   */
  receive(length) {
    return _net_udp.udp_receive(self._ptr, length)
  }

  /**
   * Receives a single datagram from any sender into a newly
   * allocated byte buffer of `length` bytes. Does not require a
   * connected socket.
   *
   * @note As with `receive()`, if the incoming datagram is
   *    larger than `length`, the excess bytes are discarded.
   *
   * @param number length: The size of the buffer to read into
   * @returns bytes a `length`-byte buffer containing the
   *    received datagram
   * @throws Error on an underlying I/O error, or if the
   *    configured read timeout elapses first
   */
  receive_from(length) {
    return _net_udp.udp_receive_from(self._ptr, length)
  }

  /**
   * Sends `data` as a single datagram to the connected peer.
   * Requires a connected socket. Unlike a TCP stream's
   * `write()`, a successful call always sends the entirety of
   * `data` as one datagram - there is no concept of a partial
   * send here, though very large datagrams may be rejected
   * outright depending on the platform and network path.
   *
   * @param {bytes|string} data: The bytes (or UTF-8 text) to
   *    send
   * @returns number the number of bytes sent (equal to the size
   *    of `data` on success)
   * @throws Error on an underlying I/O error, or if the
   *    configured write timeout elapses first
   */
  send(data) {
    return _net_udp.udp_send(self._ptr, data)
  }

  /**
   * Sends `data` as a single datagram to `address`. Does not
   * require a connected socket, and does not change the peer set
   * by `connect()`, if any.
   *
   * @param {bytes|string} data: The bytes (or UTF-8 text) to
   *    send
   * @param {string|SocketAddr} address: The host:port to send
   *    the datagram to
   * @returns number the number of bytes sent (equal to the size
   *    of `data` on success)
   * @throws Error on an underlying I/O error, or if the
   *    configured write timeout elapses first
   */
  send_to(data, address) {
    return _net_udp.udp_send_to(self._ptr, data, _addr_string(address))
  }

  /**
   * Joins the IPv4 multicast group `multiaddr` on the network
   * interface identified by `interface`.
   *
   * @param string multiaddr: The multicast address to join, e.g.
   *    `'239.0.0.1'`
   * @param string interface: The local IPv4 address of the
   *    interface to join on, e.g. `'0.0.0.0'` for the default
   *    interface
   * @throws Error if `multiaddr`/`interface` cannot be parsed as
   *    IPv4 addresses, or on an underlying I/O error
   */
  join_multicast_v4(multiaddr, interface) {
    _net_udp.udp_join_multicast_v4(self._ptr, multiaddr, interface)
  }

  /**
   * Leaves the IPv4 multicast group `multiaddr` on the network
   * interface identified by `interface`. Both arguments must
   * match the values originally passed to `join_multicast_v4()`.
   *
   * @param string multiaddr: The multicast address to leave
   * @param string interface: The local IPv4 address of the
   *    interface to leave on
   * @throws Error if `multiaddr`/`interface` cannot be parsed as
   *    IPv4 addresses, or on an underlying I/O error
   */
  leave_multicast_v4(multiaddr, interface) {
    _net_udp.udp_leave_multicast_v4(self._ptr, multiaddr, interface)
  }

  /**
   * Joins the IPv6 multicast group `multiaddr` on the network
   * interface identified by `interface`.
   *
   * @param string multiaddr: The multicast address to join, e.g.
   *    `'ff02::1'`
   * @param number interface: The index of the local interface to
   *    join on, or `0` to let the OS choose the default
   *    interface
   * @throws Error if `multiaddr` cannot be parsed as an IPv6
   *    address, or on an underlying I/O error
   */
  join_multicast_v6(multiaddr, interface) {
    _net_udp.udp_join_multicast_v6(self._ptr, multiaddr, interface)
  }

  /**
   * Leaves the IPv6 multicast group `multiaddr` on the network
   * interface identified by `interface`. Both arguments must
   * match the values originally passed to `join_multicast_v6()`.
   *
   * @param string multiaddr: The multicast address to leave
   * @param number interface: The index of the local interface to
   *    leave on
   * @throws Error if `multiaddr` cannot be parsed as an IPv6
   *    address, or on an underlying I/O error
   */
  leave_multicast_v6(multiaddr, interface) {
    _net_udp.udp_leave_multicast_v6(self._ptr, multiaddr, interface)
  }

  /**
   * Releases the underlying socket. It is advised to call this
   * explicitly once you are done with the socket rather than
   * relying on the Zuri garbage collector to do it for you
   * eventually. Safe to call more than once, and safe to call on
   * an instance that was never bound or connected.
   */
  close() {
    _net_udp.udp_close(self._ptr)
  }

  /**
   * A human readable representation of this socket, showing
   * whichever of the bound-local or connected-peer addresses
   * apply.
   *
   * @returns string
   */
  to_string() {
    var local

    catch {
      local = self.local_address()
    } as e {
      return '<UdpSocket unbound>'
    }

    catch {
      return '<UdpSocket ${local.to_string()} -> ${self.peer_address().to_string()}>'
    } as e {
      return '<UdpSocket bound on ${local.to_string()}>'
    }
  }

  @to_string() {
    return self.to_string()
  }
}
