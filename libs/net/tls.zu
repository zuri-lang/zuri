/**
 * @module tls
 *
 * Transport Layer Security over a `TcpStream`, built on `rustls`.
 * `TlsStream.connect()` and `TlsStream.accept()` take a `TcpStream`
 * that's already connected, and run a handshake over it, turning it
 * into an encrypted stream with a verified certificate. That works
 * straight after `connect()`, as for HTTPS or IMAPS, or after a
 * plain-text exchange that ends with STARTTLS, as for SMTP or FTPS,
 * which the second example below shows.
 *
 * A simple HTTPS client:
 *
 * ```zuri
 * import net
 * import net.tls
 *
 * var tcp = net.TcpStream()
 * tcp.connect('example.com:443')
 *
 * var config = tls.TlsConfig()
 * var stream = tls.TlsStream.connect(tcp, config, 'example.com')
 *
 * stream.write_all('GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n')
 * echo stream.read_as_string()
 * stream.close()
 * ```
 *
 * A STARTTLS upgrade looks almost the same, except that the stream is
 * wrapped after a round of plain text, not straight after connecting:
 *
 * ```zuri
 * import net
 * import net.tls
 *
 * var tcp = net.TcpStream()
 * tcp.connect('mail.example.com:587')
 * echo tcp.read_as_string()          # server greeting
 * tcp.write_all('STARTTLS\r\n')
 * echo tcp.read_as_string()          # server's go-ahead
 *
 * var stream = tls.TlsStream.connect(tcp, tls.TlsConfig(), 'mail.example.com')
 * ```
 *
 * A minimal server, using `TcpStream`'s own `bind()` and `accept()` for
 * the plain-text side:
 *
 * ```zuri
 * import net
 * import net.tls
 *
 * var config = tls.TlsConfig()
 * config.set_cert_chain(cert_chain_pem, private_key_pem)
 *
 * var server = net.TcpStream()
 * server.bind('0.0.0.0:8443')
 *
 * while true {
 *   var client = server.accept()
 *   var tls_client = tls.TlsStream.accept(client, config)
 *   tls_client.write_all('hello over TLS\n')
 *   tls_client.close()
 * }
 * ```
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _net_tls

/**
 * The settings that a TLS handshake needs: which certificate
 * authorities to trust, an optional certificate and private key to
 * present (as a server, or as a client using mutual TLS), and which
 * protocol versions and ALPN protocols are acceptable.
 *
 * A single `TlsConfig` can be reused for many connections. Create it
 * once and pass it to every `connect()` or `accept()` call, instead of
 * creating a new one for each connection.
 */
class TlsConfig {

  /**
   * Returns a new `TlsConfig` with sensible defaults: the
   * bundled Mozilla root certificate list, no client/server
   * certificate, no ALPN protocols, and both TLS 1.2 and TLS 1.3
   * enabled.
   */
  @new() {
    self._ptr = _net_tls.tls_config_new()
  }

  /**
   * Returns this configuration's native handle, in the same way as
   * `TcpStream.native_ptr()`. `TlsStream.connect()` and
   * `TlsStream.accept()` need it, and like any field whose name starts
   * with `_`, `_ptr` can't be reached from outside this class
   * otherwise.
   *
   * @returns Ptr
   */
  native_ptr() {
    return self._ptr
  }

  /**
   * Chooses where trusted root certificate authorities come from
   * when verifying a peer's certificate chain.
   *
   * `'bundled'` (the default) uses a compiled-in copy of
   * Mozilla's root list, which is portable and doesn't depend on
   * anything being installed on the machine. `'native'` uses the
   * operating system's own trust store instead, which picks up
   * locally-installed or enterprise-managed CAs that the bundled
   * list doesn't know about.
   *
   * @param string mode: `'bundled'` or `'native'`
   * @throws Error if `mode` is neither, or (for `'native'`) if
   *    the OS trust store can't be read
   */
  set_root_store(mode) {
    _net_tls.tls_config_set_root_store(self._ptr, mode)
  }

  /**
   * Adds one or more PEM-encoded certificates to this config's
   * trusted roots, on top of whatever `set_root_store()` already
   * selected. Call this more than once to add several custom CAs
   * - useful for trusting a self-signed development certificate
   * or a private/internal CA alongside the normal public trust
   * store.
   *
   * @param string pem: One or more PEM-encoded CA certificates
   * @throws Error if none of the certificates in `pem` could be
   *    parsed
   */
  add_ca_pem(pem) {
    _net_tls.tls_config_add_ca_pem(self._ptr, pem)
  }

  /**
   * Sets the certificate chain and private key that this side of the
   * connection presents to the other side. It's required before this
   * configuration can be used with `TlsStream.accept()`, because a
   * server always needs a certificate. It's optional for
   * `TlsStream.connect()`, where it's only needed if the server
   * requires a client certificate (mutual TLS).
   *
   * @param string cert_chain_pem: the end-entity certificate, followed
   *    by any intermediate certificates, all PEM-encoded
   * @param string key_pem: the PEM-encoded private key that matches the
   *    end-entity certificate
   * @throws Error if either PEM can't be parsed, or the key doesn't
   *    match the certificate
   */
  set_cert_chain(cert_chain_pem, key_pem) {
    _net_tls.tls_config_set_cert_chain(self._ptr, cert_chain_pem, key_pem)
  }

  /**
   * For a server config: whether to require the connecting
   * client to present a trusted certificate (mutual TLS).
   * Verified against the same root store
   * `set_root_store()`/`add_ca_pem()` configured. Has no effect
   * on a config only ever used with `TlsStream.connect()`.
   *
   * @param bool required
   */
  require_client_cert(required) {
    _net_tls.tls_config_require_client_cert(self._ptr, required)
  }

  /**
   * Sets the ALPN (Application-Layer Protocol Negotiation) protocol
   * names that this side can use, in order of preference, such as
   * `['h2', 'http/1.1']`. Once the handshake is done,
   * `TlsStream.alpn_protocol()` returns the negotiated protocol, if
   * there is one.
   *
   * @param list protocols: protocol names, most preferred first
   */
  set_alpn(protocols) {
    _net_tls.tls_config_set_alpn(self._ptr, protocols)
  }

  /**
   * Restricts which TLS protocol versions are acceptable. Pass
   * `'1.2'` or `'1.3'` for either bound, or `nil` to leave that
   * bound open. Both versions are enabled by default.
   *
   * @param ?string min: The lowest acceptable version, or `nil`
   * @param ?string max: The highest acceptable version, or `nil`
   * @throws Error if `min` or `max` is neither `'1.2'`, `'1.3'`,
   *    nor `nil`
   */
  set_versions(min, max) {
    _net_tls.tls_config_set_versions(self._ptr, min, max)
  }

  /**
   * Turns off certificate verification completely when `insecure` is
   * `true`: there's no check of the chain of trust, the host name or
   * the expiry date. Handshake signatures are still verified
   * cryptographically, so this isn't a complete bypass, but the other
   * side isn't trusted.
   *
   * @note This is for local development, and for testing with
   *    self-signed certificates. Never turn it on for a connection that
   *    handles real traffic.
   * @param bool insecure
   */
  set_insecure(insecure) {
    _net_tls.tls_config_set_insecure(self._ptr, insecure)
  }
}

/**
 * The subset of a peer's certificate that's useful to inspect
 * from Zuri code, without needing a full ASN.1/X.509 library on
 * hand. Returned by `TlsStream.peer_certificate()`.
 *
 * @printable
 */
class PeerCertificate {

  @new(der, subject, issuer, sans, not_before, not_after) {
    self._der = der
    self._subject = subject
    self._issuer = issuer
    self._sans = sans
    self._not_before = not_before
    self._not_after = not_after
  }

  /**
   * The raw DER-encoded certificate, exactly as the peer
   * presented it.
   *
   * @returns bytes
   */
  der() {
    return self._der
  }

  /**
   * The certificate's subject, as an RFC 4514-style
   * distinguished name string, e.g. `'CN=example.com,O=Example
   * Inc,C=US'`.
   *
   * @returns string
   */
  subject() {
    return self._subject
  }

  /**
   * The certificate's issuer, in the same distinguished-name
   * format as `subject()`.
   *
   * @returns string
   */
  issuer() {
    return self._issuer
  }

  /**
   * The certificate's Subject Alternative Names, which are the DNS
   * names, IP addresses, email addresses and URIs that it's actually
   * valid for.
   *
   * @returns list a list of strings, which can be empty
   */
  sans() {
    return self._sans
  }

  /**
   * The start of the certificate's validity period, as seconds
   * since the Unix epoch (UTC).
   *
   * @returns number
   */
  not_before() {
    return self._not_before
  }

  /**
   * The end of the certificate's validity period, as seconds
   * since the Unix epoch (UTC).
   *
   * @returns number
   */
  not_after() {
    return self._not_after
  }

  to_string() {
    return '<PeerCertificate ${self._subject}>'
  }

  @to_string() {
    return self.to_string()
  }
}

/**
 * An established TLS connection, wrapping a `TcpStream` that's already
 * connected. It's always created by wrapping an existing stream, with
 * `connect()` on the client side or `accept()` on the server side, and
 * never directly.
 *
 * @note The wrapped `TcpStream` is used up. Once `connect()` or
 *    `accept()` returns, the original `TcpStream` object can't be used
 *    any more, just as after `TcpStream.close()`, and all further
 *    reading and writing goes through the returned `TlsStream`.
 *
 * @printable
 */
class TlsStream {

  @new(_ptr) {
    self._ptr = _ptr
  }

  /**
   * Hands out this stream's underlying native handle, the same way
   * `TcpStream.native_ptr()` does. `net.Poller` needs it in order to
   * watch the socket underneath the TLS session, and `_ptr` is not
   * otherwise reachable from outside this class.
   *
   * @returns Ptr
   */
  native_ptr() {
    return self._ptr
  }

  /**
   * Performs a client-side TLS handshake over `tcp_stream`, verifying
   * the peer's certificate against `config`'s trusted roots and against
   * `server_name`.
   *
   * `tcp_stream` must already be connected, either to the target host,
   * for a protocol that uses TLS from the start, such as HTTPS, or to a
   * server that it has already exchanged a plain-text greeting with,
   * for a protocol that uses STARTTLS.
   *
   * @param TcpStream tcp_stream: a connected stream, which this call
   *    uses up
   * @param TlsConfig config: the trust roots and options for the
   *    handshake
   * @param string server_name: the host name to verify the peer's
   *    certificate against, which is also sent in the SNI extension
   * @returns TlsStream
   * @throws Error if the handshake fails, or the peer's certificate
   *    isn't trusted or doesn't match `server_name`
   */
  static connect(tcp_stream, config, server_name) {
    return TlsStream(
      _net_tls.tls_wrap_client(
        tcp_stream.native_ptr(),
        config.native_ptr(),
        server_name,
      ),
    )
  }

  /**
   * Performs a server-side TLS handshake over `tcp_stream`, presenting
   * `config`'s certificate chain to the peer.
   *
   * `tcp_stream` must already be connected. It's usually the result of
   * `TcpStream.accept()`, either wrapped straight away, for a protocol
   * that uses TLS from the start, or after a plain-text greeting, for a
   * protocol that uses STARTTLS.
   *
   * @param TcpStream tcp_stream: an accepted stream, which this call
   *    uses up
   * @param TlsConfig config: must have a certificate chain, set with
   *    `TlsConfig.set_cert_chain()`
   * @returns TlsStream
   * @throws Error if the handshake fails, `config` has no certificate
   *    chain, or, with `require_client_cert()`, the client didn't
   *    present a trusted certificate
   */
  static accept(tcp_stream, config) {
    return TlsStream(
      _net_tls.tls_wrap_server(tcp_stream.native_ptr(), config.native_ptr()),
    )
  }

  /**
   * Starts a server-side TLS handshake over `tcp_stream` without
   * running it, for code that waits on a `Poller` instead of on the
   * socket. Put the stream into non-blocking mode with
   * `set_non_blocking()`, and then `advance_handshake()` moves the
   * handshake forward.
   *
   * @param TcpStream tcp_stream: an accepted stream, which this call
   *    uses up
   * @param TlsConfig config: must have a certificate chain, set with
   *    `TlsConfig.set_cert_chain()`
   * @returns TlsStream
   * @throws Error if `config` has no certificate chain
   */
  static begin_accept(tcp_stream, config) {
    return TlsStream(
      _net_tls.tls_begin_server(tcp_stream.native_ptr(), config.native_ptr()),
    )
  }

  /**
   * Sets the socket underneath into or out of non-blocking mode. The
   * `try_` methods and `advance_handshake()` are for a stream in
   * non-blocking mode. The others wait, and need it out of that mode.
   *
   * @param bool nonblocking
   * @throws Error if the stream is closed
   */
  set_non_blocking(nonblocking) {
    _net_tls.tls_set_non_blocking(self._ptr, nonblocking)
  }

  /**
   * Takes a handshake as far as it can go without waiting, on a stream
   * in non-blocking mode.
   *
   * @returns number `0` once the handshake has finished, otherwise
   *    `net.READABLE` or `net.WRITABLE`: what to wait for before
   *    calling this again
   * @throws Error if the handshake fails, or the peer closes the
   *    connection during it
   */
  advance_handshake() {
    return _net_tls.tls_advance_handshake(self._ptr)
  }

  /**
   * Reads up to `length` bytes of decrypted application data.
   * Same blocking/timeout/EOF semantics as `TcpStream.read()`.
   *
   * @param number length: The maximum number of bytes to read
   * @returns bytes up to `length` bytes (may be empty on EOF)
   * @throws Error on an underlying I/O or TLS record error
   */
  read(length) {
    return _net_tls.tls_read(self._ptr, length)
  }

  /**
   * Reads whatever decrypted data is available, on a stream in
   * non-blocking mode. Half of a record is not available: it stays in
   * the session until the rest arrives.
   *
   * @param number length: The maximum number of bytes to read
   * @returns ?bytes up to `length` bytes, empty at EOF, or `nil` when
   *    nothing is available yet
   * @throws Error on an underlying I/O or TLS record error
   */
  try_read(length) {
    return _net_tls.tls_try_read(self._ptr, length)
  }

  /**
   * Encrypts as much of `data` as the session takes right now and
   * sends what the socket takes, on a stream in non-blocking mode.
   * Data the session took may still be waiting for the socket:
   * `try_flush()` reports that and sends it.
   *
   * @param {bytes|string} data: The bytes (or UTF-8 text) to write
   * @param ?number offset: Where in `data` to start. Defaults to `0`.
   * @returns number the number of bytes taken
   * @throws Error on an underlying I/O or TLS error
   */
  try_write(data, offset: ?number) {
    return _net_tls.tls_try_write(self._ptr, data, offset == nil ? 0 : offset)
  }

  /**
   * Sends what the session holds encrypted, as far as the socket
   * takes it now, on a stream in non-blocking mode.
   *
   * @returns bool whether all of it went
   * @throws Error on an underlying I/O error
   */
  try_flush() {
    return _net_tls.tls_try_flush(self._ptr)
  }

  /**
   * Closes a stream in non-blocking mode. `close_notify` goes out only
   * if the socket has room for it, so a peer that has stopped reading
   * cannot hold the caller up.
   */
  close_now() {
    _net_tls.tls_close_now(self._ptr)
  }

  /**
   * Reads exactly `length` bytes, blocking until that many bytes
   * have arrived.
   *
   * @param number length: The exact number of bytes to read
   * @returns bytes exactly `length` bytes
   * @throws Error if EOF is reached early, or on any other I/O
   *    or TLS record error
   */
  read_exact(length) {
    return _net_tls.tls_read_exact(self._ptr, length)
  }

  /**
   * Reads until EOF (i.e. until the peer sends `close_notify`
   * and closes the connection), returning everything received.
   *
   * @returns bytes every byte read up to EOF
   * @throws Error on an underlying I/O or TLS record error
   */
  read_all() {
    return _net_tls.tls_read_all(self._ptr)
  }

  /**
   * Reads until EOF, decoding everything received as UTF-8 text.
   *
   * @returns string every byte read up to EOF, decoded as UTF-8
   * @throws Error on an underlying I/O error, a TLS record
   *    error, or if the data isn't valid UTF-8
   */
  read_as_string() {
    return _net_tls.tls_read_as_string(self._ptr)
  }

  /**
   * Encrypts and writes `data`, and returns the number of plain-text
   * bytes that were actually written. A successful call can write fewer
   * bytes than `data` contains. Use `write_all()` if every byte has to
   * be sent before you continue.
   *
   * @param {bytes|string} data: the bytes, or UTF-8 text, to write
   * @returns number the number of bytes actually written
   * @throws Error on an I/O or TLS record error
   */
  write(data) {
    return _net_tls.tls_write(self._ptr, data)
  }

  /**
   * Encrypts and writes the entirety of `data`, blocking and
   * retrying internally until every byte has been written.
   *
   * @param {bytes|string} data: The bytes (or UTF-8 text) to
   *    write
   * @throws Error on an underlying I/O or TLS record error
   */
  write_all(data) {
    _net_tls.tls_write_all(self._ptr, data)
  }

  /**
   * Flushes any buffered ciphertext out to the underlying
   * socket.
   *
   * @throws Error on an underlying I/O error
   */
  flush() {
    _net_tls.tls_flush(self._ptr)
  }

  /**
   * Sends a `close_notify` alert, telling the peer this side is
   * done writing. Unlike `close()`, the stream stays usable
   * afterwards for reading whatever the peer still has left to
   * send.
   *
   * @throws Error on an underlying I/O error
   */
  shutdown() {
    _net_tls.tls_shutdown(self._ptr)
  }

  /**
   * Sends `close_notify`, as a best effort, so a peer that has already
   * disconnected doesn't stop this from succeeding, and releases the
   * socket. It's safe to call this more than once.
   */
  close() {
    _net_tls.tls_close(self._ptr)
  }

  /**
   * The ALPN protocol negotiated during the handshake, or `nil`
   * if neither side offered one or none matched.
   *
   * @returns ?string
   */
  alpn_protocol() {
    return _net_tls.tls_alpn_protocol(self._ptr)
  }

  /**
   * The peer's end-entity certificate, or `nil` if the peer
   * didn't present one (only possible on the server side, when
   * `TlsConfig.require_client_cert()` wasn't set).
   *
   * @returns ?PeerCertificate
   */
  peer_certificate() {
    var der = _net_tls.tls_peer_certificate_der(self._ptr)
    if der == nil {
      return nil
    }
    return PeerCertificate(
      der,
      _net_tls.tls_peer_certificate_subject(self._ptr),
      _net_tls.tls_peer_certificate_issuer(self._ptr),
      _net_tls.tls_peer_certificate_sans(self._ptr),
      _net_tls.tls_peer_certificate_not_before(self._ptr),
      _net_tls.tls_peer_certificate_not_after(self._ptr),
    )
  }

  to_string() {
    return '<TlsStream>'
  }

  @to_string() {
    return self.to_string()
  }
}
