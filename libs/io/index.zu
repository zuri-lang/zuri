/**
 * @module io
 *
 * Streams, terminals, and the operating system's standard input, output
 * and error streams.
 *
 * File I/O isn't here. It's built into the language, through the
 * `file()` function.
 *
 * The standard streams are files too, and you can call almost every
 * file method on them. If a method isn't supported for a standard
 * stream, it raises an error that says so.
 *
 * ### Example
 *
 * This example asks for the user's name and prints it:
 *
 * ```zuri
 * import io
 *
 * var name = io.readline('What is your name?')
 * echo name
 * ```
 *
 * @copyright 2021, Richard Ore and Zuri contributors
 */

import _io

import @.tty { TTY }
import @.bytesio { BytesIO }

#------------------------------------------------------------------------------------------------
# Seek constants
#------------------------------------------------------------------------------------------------

/**
 * Set I/O position from the beginning.
 *
 * @type int
 */
var SEEK_SET = 0

/**
 * Set I/O position from the current position.
 *
 * @type int
 */
var SEEK_CUR = 1

/**
 * Set I/O position from the end.
 *
 * @type int
 */
var SEEK_END = 2

#------------------------------------------------------------------------------------------------
# Standard I/O streams
#------------------------------------------------------------------------------------------------

/**
 * The standard input stream of the process.
 *
 * It's opened in binary mode (`'rb'`), so `stdin.read()` and
 * `stdin.gets()` return `bytes`, never a string. Whatever is piped into
 * a program can be arbitrary data, and decoding it as text before the
 * program asks for text could only lose information.
 *
 * Call `.to_string()` on the result when the input really is text:
 *
 * ```zuri
 * import io
 *
 * var raw = io.stdin.read()          # bytes
 * var text = raw.to_string()         # decoded, replacing bad bytes
 * ```
 *
 * `to_string()` replaces bytes that can't be decoded with U+FFFD,
 * instead of raising an error. To reject malformed input instead, check
 * the bytes yourself before decoding them.
 *
 * @type file
 */
var stdin: file = _io.stdin

/**
 * Stdout is a file handle to the standard output file of the
 * system.
 *
 * Writes accept either a string or `bytes`, so unlike `stdin` there
 * is no text/binary distinction to make here.
 *
 * @type file
 */
var stdout: file = _io.stdout

/**
 * Stderr is a file handle to the standard error file of the
 * system.
 * @type file
 */
var stderr: file = _io.stderr

/**
 * Returns `true` if the current environment is the Zuri REPL,
 * `false` otherwise.
 * @type bool
 */
var is_repl: bool = _io.isrepl

#------------------------------------------------------------------------------------------------
# Output capture
#------------------------------------------------------------------------------------------------

/**
 * Begins capturing standard output.
 *
 * From this call until the matching `capture_end()`, everything Zuri
 * writes to standard output is collected into a buffer instead of
 * reaching the terminal. That covers `echo`, `print()`, and writes
 * through `io.stdout`. It does not cover `io.stderr`, output written
 * by a child process started with `os.spawn()`, or bytes a native
 * module writes straight to the descriptor.
 *
 * Captures nest. Each `capture_begin()` opens a new frame and the
 * innermost open frame receives everything, so an inner capture never
 * leaks into the one around it.
 *
 * Capture is per-thread: one opened inside an isolate collects only
 * that isolate's own output.
 *
 * A frame that is never closed is flushed to the terminal when the
 * program ends, so output is never silently lost. Prefer `capture()`
 * unless you need the output of a body that raises.
 *
 * ```zuri
 * import io
 *
 * io.capture_begin()
 * echo 'not printed yet'
 * var text = io.capture_end()
 *
 * echo 'captured: ' + text.trim('\n')
 * ```
 * ```
 * captured: not printed yet
 * ```
 */
def capture_begin() {
  _io.capture_begin()
}

/**
 * Ends the innermost capture, and returns everything it collected.
 *
 * The text is returned exactly as it was written, including the final
 * line break. Bytes that aren't valid UTF-8 are decoded as U+FFFD
 * instead of raising an error, so a whole capture is never lost because
 * of one stray byte.
 *
 * @returns string: the captured output, or `nil` if no capture was
 *    open.
 */
def capture_end() {
  return _io.capture_end()
}

/**
 * The number of capture frames currently open. `0` means output is
 * going to the terminal.
 *
 * @returns int
 */
def capture_depth() {
  return _io.capture_depth()
}

/**
 * Runs `body` with standard output captured, and returns everything
 * it printed.
 *
 * ```zuri
 * import io
 *
 * def greet(name) {
 *   echo 'Hello, ${name}!'
 * }
 *
 * var out = io.capture(@{ greet('Ada') })
 * echo out.length()
 * ```
 * ```
 * 12
 * ```
 *
 * @note when `body` raises, the capture is closed and the error is
 *    re-raised, but whatever was collected before it is discarded.
 *    Use `capture_begin()`/`capture_end()` around your own `catch`
 *    when you need both.
 * @param function body
 * @returns string
 */
def capture(body: function) {
  capture_begin()

  catch {
    body()
  } as error

  var output = capture_end()

  if error {
    raise error
  }

  return output
}

/**
 * Flushes the content of the given file handle
 */
def flush(file) {
  if !is_file(file) {
    raise TypeError('file expected in argument 1 (file)')
  }

  file.flush()
}

/**
 * Writes character c to the screen.
 *
 * @param char|number c
 */
def putc(c) {
  if is_number(c) {
    if c < 0 or c > 255 {
      raise ValueError('character code must be in within range 0..255')
    }

    c = c.chr()
  } else if !is_string(c) or c.length() != 1 {
    raise TypeError('a single character expected in argument 1 (c)')
  }

  stdout.puts(c)
}

/**
 * Reads characters from standard input.
 *
 * If `length` is given, it reads `length` bytes, and otherwise it reads
 * a single character.
 *
 * `length` counts bytes, not code points, so asking for fewer bytes
 * than a multi-byte character takes up gives you a replacement
 * character, not half of the character.
 *
 * @returns char|string
 */
def getc(length) {
  if length == nil {
    length = 1
  }

  if !is_number(length) or length < 0 {
    raise TypeError('non-negative number expected in argument 1 (length)')
  }

  # stdin is binary, so decode here: this is a character-level API.
  var input = stdin.read(length).to_string()

  # Clear the input buffer to prevent unwanted characters from being read in subsequent calls
  stdin.flush()

  return input
}

/**
 * Reads a single character from standard input without printing
 * to standard output.
 *
 * @returns char|string
 */
def getch() {
  return _io.getch()
}

/**
 * Reads an entire line from standard input. If a _message_ is
 * given, the message will be printed before it begins to wait
 * for a user input. If _secure_ is `true`, the user's input will
 * not be printing and _obscure_text_ will be printed instead.
 *
 * @note Newlines will not be added automatically for messages.
 * @param ?string message
 * @param ?bool secure
 * @param ?string obscure_text: Default value is `*`.
 * @returns string
 */
def readline(message, secure, obscure_text) {
  return _io.readline(message, secure, obscure_text)
}
