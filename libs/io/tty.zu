/**
 * @module tty
 *
 * `TTY`: control over a terminal attached to a file handle.
 *
 * Raw and cooked modes, echo, cursor visibility and terminal size all
 * live here. The underlying constants are read from the platform's own
 * `libc` at load time rather than hard-coded, because they differ
 * between operating systems.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

# io.TTY implementation

import _io
import _os

# The current platform's real termios bit/index values, read once from
# native code rather than a per-flag native call each; see the note
# above the flag constants below for why these have to come from native
# code at all instead of being written as literals here.
const _flag_table = _io.TTY.flags()

/**
 * class TTY is an interface to TTY terminals this class contains
 * definitions to control TTY terminals
 *
 * Termios flag words are a Unix concept, so `get_attr()` and
 * `set_attr()` raise on Windows and every flag constant below reads as
 * `0` there. What those two are usually wanted for is not Unix-only,
 * though: `set_raw()` and `exit_raw()` work on both, Windows reaching
 * its console mode directly instead of through the flags.
 *
 * `exit_raw()` and `flush()` never raise on any platform. Each reports
 * whether it had anything to do, so cleanup code can call them without
 * first establishing what state the terminal was in.
 */
class TTY {

  # TTY flags

  /**
   * TTY attribute for input flags.
   *
   * @type int
   * @static
   */
  static var TTY_IFLAG = _flag_table.TTY_IFLAG

  /**
   * TTY attribute for output flags.
   *
   * @type int
   * @static
   */
  static var TTY_OFLAG = _flag_table.TTY_OFLAG

  /**
   * TTY attribute for control flags.
   *
   * @type int
   * @static
   */
  static var TTY_CFLAG = _flag_table.TTY_CFLAG

  /**
   * TTY attribute for local flags.
   *
   * @type int
   * @static
   */
  static var TTY_LFLAG = _flag_table.TTY_LFLAG

  /**
   * TTY attribute for input speed.
   *
   * @type int
   * @static
   */
  static var TTY_ISPEED = _flag_table.TTY_ISPEED

  /**
   * TTY attribute for output speed.
   *
   * @type int
   * @static
   */
  static var TTY_OSPEED = _flag_table.TTY_OSPEED

  /**
   * TTY attribute for the special control-character table
   * (`VEOF`, `VERASE`, etc. below are indices into it).
   *
   * @type int
   * @static
   */
  static var TTY_CC = _flag_table.TTY_CC

  # ---------------------------------------------------------------------
  # Every constant below this point is a real termios bit or c_cc index,
  # and those genuinely differ across platform families: BSD/macOS and
  # Linux/glibc disagree with each other on most of the control-flag and
  # local-flag bits outright, and PowerPC-Linux differs from x86_64-Linux
  # on a few of its own. Zuri has no conditional compilation to pick the
  # right literal per platform the way Rust does, so these are read once
  # from the native `_io` module at class-load time instead of being
  # hand-typed here; the native side already knows, correctly, which
  # platform it was actually built for.
  # ---------------------------------------------------------------------

  # input flags for input processing

  /**
   * Ignore BREAK condition.
   *
   * @type int
   * @static
   */
  static var IGNBRK   = _flag_table.IGNBRK

  /**
   * Map BREAK to SIGINTR.
   *
   * @type int
   * @static
   */
  static var BRKINT   = _flag_table.BRKINT

  /**
   * Ignore (discard) parity errors.
   *
   * @type int
   * @static
   */
  static var IGNPAR   = _flag_table.IGNPAR

  /**
   * Mark parity and framing errors.
   *
   * @type int
   * @static
   */
  static var PARMRK   = _flag_table.PARMRK

  /**
   * Enable checking of parity errors.
   *
   * @type int
   * @static
   */
  static var INPCK    = _flag_table.INPCK

  /**
   * Strip 8th bit off chars.
   *
   * @type int
   * @static
   */
  static var ISTRIP   = _flag_table.ISTRIP

  /**
   * Map NL into CR.
   *
   * @type int
   * @static
   */
  static var INLCR    = _flag_table.INLCR

  /**
   * Ignore CR.
   *
   * @type int
   * @static
   */
  static var IGNCR    = _flag_table.IGNCR

  /**
   * Map CR to NL (ala CRMOD).
   *
   * @type int
   * @static
   */
  static var ICRNL    = _flag_table.ICRNL

  /**
   * Enable output flow control.
   *
   * @type int
   * @static
   */
  static var IXON     = _flag_table.IXON

  /**
   * Enable input flow control.
   *
   * @type int
   * @static
   */
  static var IXOFF    = _flag_table.IXOFF

  /**
   * Any char will restart after stop.
   *
   * @type int
   * @static
   */
  static var IXANY    = _flag_table.IXANY

  /**
   * Maintain state for UTF-8 VERASE. Only meaningful on Linux/Android/
   * macOS; reads as `0` (a no-op bit) on platforms without it, such
   * as the BSDs.
   *
   * @type int
   * @static
   */
  static var IUTF8    = _flag_table.IUTF8

  # output flags

  /**
   * Enable following output processing.
   *
   * @type int
   * @static
   */
  static var OPOST    = _flag_table.OPOST

  /**
   * Map NL to CR-NL (ala CRMOD).
   *
   * @type int
   * @static
   */
  static var ONLCR    = _flag_table.ONLCR

  # control flags

  /**
   * Character size mask .
   *
   * @type int
   * @static
   */
  static var CSIZE    = _flag_table.CSIZE

  /**
   * 5 bits (pseudo).
   *
   * @type int
   * @static
   */
  static var CS5      = _flag_table.CS5

  /**
   * 6 bits.
   *
   * @type int
   * @static
   */
  static var CS6      = _flag_table.CS6

  /**
   * 7 bits.
   *
   * @type int
   * @static
   */
  static var CS7      = _flag_table.CS7

  /**
   * 8 bits.
   *
   * @type int
   * @static
   */
  static var CS8      = _flag_table.CS8

  /**
   * Send 2 stop bits.
   *
   * @type int
   * @static
   */
  static var CSTOPB   = _flag_table.CSTOPB

  /**
   * Enable receiver.
   *
   * @type int
   * @static
   */
  static var CREAD    = _flag_table.CREAD

  /**
   * Parity enable.
   *
   * @type int
   * @static
   */
  static var PARENB   = _flag_table.PARENB

  /**
   * Odd parity, else even.
   *
   * @type int
   * @static
   */
  static var PARODD   = _flag_table.PARODD

  /**
   * Hang up on last close.
   *
   * @type int
   * @static
   */
  static var HUPCL    = _flag_table.HUPCL

  /**
   * Ignore modem status lines.
   *
   * @type int
   * @static
   */
  static var CLOCAL   = _flag_table.CLOCAL

  # "Local" flags - dumping ground for other state
  # Warning: some flags in this structure begin with
  # the letter "I" and look like they belong in the
  # input flag.

  /**
   * Visually erase chars.
   *
   * @type int
   * @static
   */
  static var ECHOE    = _flag_table.ECHOE

  /**
   * Echo NL after line kill
   * @static
   */
  static var ECHOK    = _flag_table.ECHOK

  /**
   * Enable echoing.
   *
   * @type int
   * @static
   */
  static var ECHO     = _flag_table.ECHO

  /**
   * Echo NL even if ECHO is off.
   *
   * @type int
   * @static
   */
  static var ECHONL   = _flag_table.ECHONL

  /**
   * Enable signals INTR, QUIT, [D]SUSP.
   *
   * @type int
   * @static
   */
  static var ISIG     = _flag_table.ISIG

  /**
   * Canonicalize input lines.
   *
   * @type int
   * @static
   */
  static var ICANON   = _flag_table.ICANON

  /**
   * Enable DISCARD and LNEXT.
   *
   * @type int
   * @static
   */
  static var IEXTEN   = _flag_table.IEXTEN

  /**
   * Stop background jobs from output.
   *
   * @type int
   * @static
   */
  static var TOSTOP   = _flag_table.TOSTOP

  /**
   * Don't flush after interrupt.
   *
   * @type int
   * @static
   */
  static var NOFLSH   = _flag_table.NOFLSH

  #-----------------------------------------------------------------------

  # Commands passed to set_attr() for setting the TTY attributes.

  /**
   * Make change immediate.
   *
   * @type int
   * @static
   */
  static var TCSANOW    = _flag_table.TCSANOW

  /**
   * Drain output, then change.
   *
   * @type int
   * @static
   */
  static var TCSADRAIN  = _flag_table.TCSADRAIN

  /**
   * Drain output, flush input.
   *
   * @type int
   * @static
   */
  static var TCSAFLUSH  = _flag_table.TCSAFLUSH

  # Special Control Characters: indices into the TTY_CC table (see
  # TTY_CC above) rather than bit flags. Only meaningful in ICANON mode
  # unless noted otherwise.

  /**
   * ICANON.
   *
   * @type int
   * @static
   */
  static var VEOF       = _flag_table.VEOF

  /**
   * ICANON.
   *
   * @type int
   * @static
   */
  static var VEOL       = _flag_table.VEOL

  /**
   * ICANON.
   *
   * @type int
   * @static
   */
  static var VERASE     = _flag_table.VERASE

  /**
   * ICANON.
   *
   * @type int
   * @static
   */
  static var VKILL      = _flag_table.VKILL

  /**
   * ISIG.
   *
   * @type int
   * @static
   */
  static var VINTR      = _flag_table.VINTR

  /**
   * ISIG.
   *
   * @type int
   * @static
   */
  static var VQUIT      = _flag_table.VQUIT

  /**
   * ISIG.
   *
   * @type int
   * @static
   */
  static var VSUSP      = _flag_table.VSUSP

  /**
   * IXON, IXOFF.
   *
   * @type int
   * @static
   */
  static var VSTART     = _flag_table.VSTART

  /**
   * IXON, IXOFF.
   *
   * @type int
   * @static
   */
  static var VSTOP      = _flag_table.VSTOP

  /**
   * !ICANON.
   *
   * @type int
   * @static
   */
  static var VMIN       = _flag_table.VMIN

  /**
   * !ICANON.
   *
   * @type int
   * @static
   */
  static var VTIME      = _flag_table.VTIME

  /**
   * @note _file_ must be one of stdout and stderr
   * @param file std
   * @constructor
   */
  @new(std) {
    if !is_file(std) {
      raise TypeError('TTY expects a standard file as argument, ${typeof(std)} given')
    }

    self.std = std
  }

  /**
   * Returns the attributes of the current tty session. The returned
   * value is a dict keyed by the TTY_ group constants.
   *
   * @note Unix only. Termios flag words have no console equivalent, so
   *    this raises on Windows. `set_raw()` and `exit_raw()` cover what
   *    attributes are usually reached for and work on both.
   * @returns dict
   * @raises Error on a platform without termios, or if the stream has
   *    no terminal behind it.
   */
  get_attr() {
    return _io.TTY.tcgetattr(self.std)
  }

  /**
   * sets the attributes of the current tty session
   *
   * > __NOTE__: - _option_ must be one ot the TCSA options above
   * > (see their description above) - _attrs_ must be a
   * > dictionary keyed by the TTY_ group constants above (TTY_IFLAG,
   * > TTY_OFLAG, TTY_CFLAG, TTY_LFLAG, TTY_ISPEED, TTY_OSPEED hold a
   * > single bit-flag number each; TTY_CC holds a list of control
   * > character values, indexed by the VEOF/VERASE/etc constants
   * > above) - one can safely omit any of the TTY_ groups listed
   * > above and Zuri will fill in the default values as it exists.
   * > - This flags will be merged and not overwritten
   *
   * @note Unix only, for the same reason `get_attr()` is: there is no
   *    console representation of a termios flag word to apply, and
   *    accepting one would mean reporting success for a change that
   *    never happened.
   * @param number option
   * @param dict attr
   * @returns bool
   * @raises Error on a platform without termios, or if the stream has
   *    no terminal behind it.
   */
  set_attr(option: int, attrs: dict) {
    return _io.TTY.tcsetattr(self.std, option, attrs)
  }

  /**
   * Sets the current tty to raw mode: input arrives a keystroke at a
   * time, nothing is echoed back, and Ctrl+C reaches the program as a
   * keystroke rather than being turned into a signal first.
   *
   * Works on Windows as well as Unix.
   *
   * @returns bool
   * @raises Error if the stream has no terminal behind it, which is
   *    what a redirected or captured stream is.
   */
  set_raw() {
    # A console's mode is set as one value rather than as the termios
    # flag words the rest of this class trades in, so Windows cannot be
    # driven through get/set_attr and has its own native instead.
    if _os.platform == 'windows' {
      return _io.TTY.set_raw(self.std)
    }

    var new_attr = _io.TTY.tcgetattr(self.std, false)

    new_attr[TTY.TTY_IFLAG] &= ~(TTY.IGNBRK | TTY.BRKINT | TTY.PARMRK | TTY.ISTRIP | TTY.INLCR | TTY.IGNCR | TTY.ICRNL | TTY.IXON)
    new_attr[TTY.TTY_OFLAG] &= ~TTY.OPOST
    new_attr[TTY.TTY_LFLAG] &= ~(TTY.ECHO | TTY.ECHONL | TTY.ICANON | TTY.ISIG | TTY.IEXTEN)
    new_attr[TTY.TTY_CFLAG] &= ~(TTY.CSIZE | TTY.PARENB)
    new_attr[TTY.TTY_CFLAG] |= TTY.CS8

    return self.set_attr(TTY.TCSAFLUSH, new_attr)
  }

  /**
   * Disables the raw mode flags on the current tty, putting it back
   * the way `set_raw()` found it.
   *
   * Never raises, so it is safe to call on a cleanup path without
   * knowing whether raw mode was ever entered. The return value says
   * whether anything was actually restored: `false` for a stream this
   * TTY never put into raw mode, and `false` on Windows, which has no
   * raw mode to leave.
   *
   * @returns bool
   */
  exit_raw() {
    return _io.TTY.exit_raw(self.std)
  }

  /**
   * Returns the size of the current TTY device as a dictionary
   * of cols and rows.
   *
   * - `cols`: the number of text columns that fit into the TTY
   *   device.
   * - `rows`: the number of text rows that fit into the TTY device.
   *
   * Works on Windows as well as Unix.
   *
   * @returns dict
   * @raises Error if the stream has no terminal behind it, which is
   *    what a redirected or captured stream is.
   */
  get_size() {
    var size = _io.TTY.getsize(self.std)

    return {
      cols: size.first(),
      rows: size.last(),
    }
  }

  /**
   * Discards whatever is still queued on this TTY's stream, both
   * input that has been typed but not yet read and output that has
   * been written but not yet sent.
   *
   * Note that this throws that data away rather than writing it out,
   * which is the opposite of what `file.flush()` does.
   *
   * Never raises. The return value says whether anything was
   * discarded: `false` for a stream with no terminal behind it, and
   * `false` on Windows, which keeps no such queue.
   *
   * @returns bool
   */
  flush() {
    return _io.TTY.flush(self.std)
  }
}
