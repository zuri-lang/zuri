/**
 * @module imap
 *
 * IMAP, for reading mail where it's stored, instead of taking it away.
 *
 * Both sides are here. `ImapClient` connects to a server, and
 * `ImapServer` is a server, which answers from a `MailStore`. Two
 * stores are included.
 *
 * ```zuri,ignore
 * import mail.imap { ImapClient }
 *
 * var inbox = ImapClient.connect('imaps://mail.example.com', {
 *   username: 'ann',
 *   password: secret,
 * })
 *
 * inbox.select('INBOX')
 *
 * echo inbox.search('UNSEEN', true).length()
 *
 * inbox.logout()
 * ```
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import .parser
import @.store { * }
import @.client { * }
import @.server { * }
