/**
 * @module smtp
 *
 * SMTP, the protocol that moves mail from where it was written to where
 * it's stored.
 *
 * Both sides are here. `SmtpClient` hands messages to a server, and
 * `SmtpServer` is a server, which decides what to accept through
 * handlers that you write.
 *
 * ```zuri,ignore
 * import mail.smtp { SmtpClient }
 *
 * var server = SmtpClient.connect('smtp://mail.example.com', {
 *   username: 'reports',
 *   password: secret,
 * })
 *
 * server.send(note, nil)
 * server.quit()
 * ```
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import @.client { * }
import @.server { * }
