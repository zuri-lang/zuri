/**
 * @module mail
 *
 * Email, from building messages to sending and receiving them.
 *
 * `mail` builds and reads messages, and implements the three protocols
 * that move them: SMTP to send mail, and IMAP and POP3 to read it. It
 * also includes the server side, with an SMTP server that accepts mail
 * and an IMAP server that serves it. It's all written in Zuri.
 *
 * ```zuri,ignore
 * import mail
 *
 * var note = mail.message()
 *   .set_from('reports@example.com')
 *   .add_to('ann@example.com')
 *   .set_subject('Quarterly report')
 *   .set_text('The numbers are in.')
 *
 * mail.send('smtp://mail.example.com', note, {
 *   username: 'reports',
 *   password: secret,
 * })
 * ```
 *
 * ### Contents
 *
 * | | |
 * | - | - |
 * | `message()` | starts a message, built up one call at a time |
 * | `parse()` | reads a message |
 * | `send()` | sends a message, opening and closing the connection |
 * | `Message` | a message, or one part of a message |
 * | `Address` | an address and the name written with it |
 * | `Headers` | the header block, in order and case-insensitive |
 * | `SmtpClient` | a connection to a server that sends mail |
 * | `ImapClient` | a connection to a server that stores mail |
 * | `Pop3Client` | the older way of collecting mail |
 * | `SmtpServer` | the receiving side of SMTP |
 * | `ImapServer` | the server side of IMAP |
 * | `MailStore` | where an `ImapServer` keeps mail |
 * | `MailError` | the base class of every error raised here |
 *
 * ### Reading mail
 *
 * ```zuri,ignore
 * import mail
 *
 * var inbox = mail.imap('imaps://mail.example.com', {
 *   username: 'ann',
 *   password: secret,
 * })
 *
 * inbox.select('INBOX')
 *
 * for id in inbox.search('UNSEEN') {
 *   echo inbox.fetch_message(id).subject()
 * }
 *
 * inbox.logout()
 * ```
 *
 * ### Running a server
 *
 * The servers work like `http.HttpServer`: they bind, listen, and pass
 * each connection to a worker. An `SmtpServer` decides what to accept
 * through handlers, and an `ImapServer` answers from a `MailStore`. Two
 * stores are included, one that keeps mail on disk in Maildir format
 * and one that keeps it in memory.
 *
 * ### Security
 *
 * Every client can connect over TLS from the start or switch to it with
 * `STARTTLS`, and refuses to send credentials over a connection that
 * does neither. `mail.dkim` signs outgoing mail and verifies incoming
 * mail.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import @.errors { * }
import @.encoding
import @.content { * }
import @.message { * }
import @.dkim
import @.sasl
import @.stream
import @.smtp { * }
import @.imap { * }
import @.pop3 { * }
import @.pool

# `Address` and `Headers` are named here; the rest of what those two
# modules hold stays behind `mail.address` and `mail.headers`, where a
# name like `parse` or `fold` means something without a prefix.
import @.address { Address, Group }
import @.address
import @.headers { Headers }
import @.headers

/**
 * Reads one address out of text.
 *
 * ```zuri
 * import mail
 *
 * echo mail.parse_address('Ann <ann@example.com>').address
 * ```
 *
 * ```console
 * ann@example.com
 * ```
 *
 * @param string text
 * @returns Address
 * @throws MessageError if the text holds no address, or several.
 */
def parse_address(text: string) {
  return address.parse(text)
}

/**
 * Reads every address out of text, with any groups flattened into
 * their members.
 *
 * @param string text
 * @returns list of `Address`
 */
def parse_address_list(text: string) {
  return address.parse_list(text)
}

/**
 * Reads every address out of text, keeping the groups as groups.
 *
 * @param string text
 * @returns list of `Address` and `Group`
 */
def parse_address_groups(text: string) {
  return address.parse_groups(text)
}

/**
 * Writes a list of addresses as a header value.
 *
 * @param list people: `Address` values, `Group` values, or text to be
 *    parsed first.
 * @returns string
 */
def format_addresses(people: list) {
  return address.format_list(people)
}

/**
 * Sends one message, opening the connection and then closing it again.
 *
 * This is all that a program that sends one message at a time needs. A
 * program that sends many should keep its own `SmtpClient` open while
 * it sends them all.
 *
 * ```zuri,ignore
 * import mail
 *
 * mail.send('smtp://mail.example.com', mail.message()
 *   .set_from('reports@example.com')
 *   .add_to('ann@example.com')
 *   .set_subject('Quarterly report')
 *   .set_text('The numbers are in.'),
 *   { username: 'reports', password: secret })
 * ```
 *
 * @param string url: `smtp://host` or `smtps://host`
 * @param Message note
 * @param ?dict options: any of the options that `SmtpClient.connect()`
 *    takes, and `from` and `to` to override the envelope
 * @returns Reply the server's response to the message.
 * @throws SmtpError if the server refuses any part of it.
 */
def send(url: string, note, options: ?dict) {
  var client = SmtpClient.connect(url, options)

  catch {
    var reply = client.send(note, options)

    client.quit()

    return reply
  } as error {
    client.close()

    raise error
  }
}

/**
 * Opens a connection to a server that sends mail.
 *
 * @param string url
 * @param ?dict options
 * @returns SmtpClient
 */
def smtp(url: string, options: ?dict) {
  return SmtpClient.connect(url, options)
}

/**
 * Opens a connection to a server that stores mail.
 *
 * @param string url
 * @param ?dict options
 * @returns ImapClient
 */
def imap(url: string, options: ?dict) {
  return ImapClient.connect(url, options)
}

/**
 * Opens a connection to a server that hands mail over.
 *
 * @param string url
 * @param ?dict options
 * @returns Pop3Client
 */
def pop3(url: string, options: ?dict) {
  return Pop3Client.connect(url, options)
}
