/**
 * @module callback
 *
 * Zuri functions that C can call.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _ffi

import .errors { FfiError }

/**
 * A Zuri function behind a C function pointer, created by
 * `ffi.callback()`.
 *
 * A callback lasts until `release()` is called. Nothing else frees it,
 * because nothing can know when the C library has finished with the
 * pointer. A callback that's never released is kept for the life of the
 * program, and so is the function behind it.
 *
 * A Zuri function passed directly to a function pointer parameter
 * doesn't need any of this, because it becomes a callback for the
 * duration of that one call. Create one explicitly when C keeps the
 * pointer after the call.
 *
 * @printable
 */
class Callback {
  var _handle

  @new() {
    raise FfiError(
      'callbacks come from ffi.callback(), never from the Callback constructor',
    )
  }

  /**
   * The C function pointer, typed with the callback's signature.
   *
   * @returns Pointer
   * @throws CallbackError when the callback has been released.
   */
  pointer() {
    return _ffi.callback_pointer(self._handle)
  }

  /**
   * The callback's type: a pointer to its function type.
   *
   * @returns Type
   */
  type() {
    return _ffi.callback_type(self._handle)
  }

  /**
   * Frees the callback's code and releases its function.
   *
   * C mustn't call the pointer again. Passing the callback to a foreign
   * function after this raises a `CallbackError`. A call that C still
   * makes through a pointer it kept is undefined, exactly like a call
   * through any other freed function pointer. Releasing a callback
   * twice does nothing.
   */
  release() {
    _ffi.callback_release(self._handle)
  }

  /**
   * Whether `release()` has been called.
   *
   * @returns bool
   */
  is_released() {
    return _ffi.callback_is_released(self._handle)
  }

  to_string() {
    var state = self.is_released() ? ' (released)' : ''
    return '<Callback ${self.type().name()}${state}>'
  }

  @to_string() {
    return self.to_string()
  }
}

_ffi.install({ Callback })
