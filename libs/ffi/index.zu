/**
 * @module ffi
 *
 * Calls C and Rust libraries, and lets them call back into Zuri.
 *
 * `ffi` loads a shared library, describes the functions in it, and
 * calls them with ordinary Zuri values. Every conversion between Zuri
 * and C is checked against the C type, so a value that doesn't fit
 * raises an error at the call, instead of becoming a corrupted argument
 * inside the library. The module reads C and Rust declarations as
 * they're written in headers and crates, links static libraries into
 * libraries that can be loaded, and turns Zuri functions into C
 * function pointers.
 *
 * ```zuri,ignore
 * import ffi
 *
 * var c = ffi.open(ffi.LIBC).declare('
 *   size_t strlen(const char *s);
 *   int abs(int n);
 * ')
 *
 * echo c.strlen('hello')
 * echo c.abs(-7)
 * ```
 *
 * ### Converting values
 *
 * A number can be passed as any C integer or floating-point type, and
 * integers are range-checked against their type. Integers too large for
 * a number to hold exactly, which means 64-bit and 128-bit ones, are
 * passed as bigints in both directions. A string passed to a `char *`
 * becomes a NUL-terminated copy for the duration of the call. Bytes are
 * passed as their own storage, without copying. A list or dictionary
 * passed to a pointer becomes a temporary array or struct, which is
 * written back afterwards unless the pointer is `const`. Structs and
 * unions passed by value are dictionaries. `nil` is a null pointer, and
 * a null pointer that comes back is `nil`.
 *
 * ### Memory
 *
 * `alloc()` and the related functions return memory that knows its own
 * size. Every access through a pointer into that memory is
 * bounds-checked, and refused once the memory has been freed. Memory
 * returned by C can be taken over with `Pointer.own()`, which frees it
 * with the right function when the pointer is garbage collected.
 *
 * ### Callbacks
 *
 * A Zuri function passed to a function pointer parameter works as a
 * callback for the duration of that call. `callback()` creates one that
 * lasts, for a library that keeps the pointer. A callback can be called
 * from any thread. When it's called from another thread, the call waits
 * until the isolate that created the callback runs it.
 *
 * @copyright 2026, Richard Ore and Zuri contributors
 */

import _ffi

import @.errors { * }
import @.types { Type, RecordType, StructType, UnionType, EnumType, Typed }
import @.pointer { Pointer }
import @.library { Library }
import @.callback { Callback }
import @.declare { Declarations }

/**
 * The C runtime library of this platform, as `open()` takes it:
 * `libc.so.6` on Linux, the system library on macOS, and the Universal
 * C Runtime, `ucrtbase.dll`, on Windows.
 *
 * @type string
 */
var LIBC: string = _ffi.libc_name()

/**
 * The C maths library, which on macOS and Windows is the same library
 * as `LIBC`.
 *
 * @type string
 */
var LIBM: string = _ffi.libm_name()

/**
 * `void`: the return type of a function that returns nothing.
 * @type Type
 */
var void: Type = _ffi.builtin_type('void')

/**
 * `bool`: C's `_Bool` and Rust's `bool`, one byte, converted to and
 * from a Zuri bool.
 * @type Type
 */
var bool: Type = _ffi.builtin_type('bool')

/**
 * `char`: signed on x86-64 and on Apple's Arm platforms, unsigned on
 * Arm Linux, as the platform's C compiler has it.
 * @type Type
 */
var char: Type = _ffi.builtin_type('char')

/**
 * `signed char`.
 * @type Type
 */
var schar: Type = _ffi.builtin_type('signed char')

/**
 * `unsigned char`.
 * @type Type
 */
var uchar: Type = _ffi.builtin_type('unsigned char')

/**
 * `short`, 16 bits.
 * @type Type
 */
var short: Type = _ffi.builtin_type('short')

/**
 * `unsigned short`, 16 bits.
 * @type Type
 */
var ushort: Type = _ffi.builtin_type('unsigned short')

/**
 * `int`, 32 bits.
 * @type Type
 */
var int: Type = _ffi.builtin_type('int')

/**
 * `unsigned int`, 32 bits.
 * @type Type
 */
var uint: Type = _ffi.builtin_type('unsigned int')

/**
 * `long`: 64 bits, except on Windows, where it is 32.
 * @type Type
 */
var long: Type = _ffi.builtin_type('long')

/**
 * `unsigned long`: 64 bits, except on Windows, where it is 32.
 * @type Type
 */
var ulong: Type = _ffi.builtin_type('unsigned long')

/**
 * `long long`, 64 bits.
 * @type Type
 */
var longlong: Type = _ffi.builtin_type('long long')

/**
 * `unsigned long long`, 64 bits.
 * @type Type
 */
var ulonglong: Type = _ffi.builtin_type('unsigned long long')

/**
 * `int8_t`.
 * @type Type
 */
var int8: Type = _ffi.builtin_type('int8_t')

/**
 * `uint8_t`.
 * @type Type
 */
var uint8: Type = _ffi.builtin_type('uint8_t')

/**
 * `int16_t`.
 * @type Type
 */
var int16: Type = _ffi.builtin_type('int16_t')

/**
 * `uint16_t`.
 * @type Type
 */
var uint16: Type = _ffi.builtin_type('uint16_t')

/**
 * `int32_t`.
 * @type Type
 */
var int32: Type = _ffi.builtin_type('int32_t')

/**
 * `uint32_t`.
 * @type Type
 */
var uint32: Type = _ffi.builtin_type('uint32_t')

/**
 * `int64_t`. Values beyond 2^53 in magnitude read back as bigints.
 * @type Type
 */
var int64: Type = _ffi.builtin_type('int64_t')

/**
 * `uint64_t`. Values above 2^53 read back as bigints.
 * @type Type
 */
var uint64: Type = _ffi.builtin_type('uint64_t')

/**
 * `__int128`, a 128-bit integer, and Rust's `i128`.
 * @type Type
 */
var int128: Type = _ffi.builtin_type('__int128')

/**
 * `unsigned __int128`, and Rust's `u128`.
 * @type Type
 */
var uint128: Type = _ffi.builtin_type('unsigned __int128')

/**
 * `size_t`, 64 bits.
 * @type Type
 */
var size_t: Type = _ffi.builtin_type('size_t')

/**
 * `ssize_t`, 64 bits.
 * @type Type
 */
var ssize_t: Type = _ffi.builtin_type('ssize_t')

/**
 * `ptrdiff_t`, 64 bits.
 * @type Type
 */
var ptrdiff_t: Type = _ffi.builtin_type('ptrdiff_t')

/**
 * `intptr_t`, 64 bits.
 * @type Type
 */
var intptr_t: Type = _ffi.builtin_type('intptr_t')

/**
 * `uintptr_t`, 64 bits.
 * @type Type
 */
var uintptr_t: Type = _ffi.builtin_type('uintptr_t')

/**
 * `wchar_t`: 16 bits and unsigned on Windows, 32 bits elsewhere.
 * @type Type
 */
var wchar_t: Type = _ffi.builtin_type('wchar_t')

/**
 * `char16_t`, a UTF-16 code unit.
 * @type Type
 */
var char16_t: Type = _ffi.builtin_type('char16_t')

/**
 * `char32_t`, a UTF-32 code unit.
 * @type Type
 */
var char32_t: Type = _ffi.builtin_type('char32_t')

/**
 * `float`, 32 bits.
 * @type Type
 */
var float: Type = _ffi.builtin_type('float')

/**
 * `double`, 64 bits.
 * @type Type
 */
var double: Type = _ffi.builtin_type('double')

/**
 * `long double`: 80-bit extended precision on x86-64 Linux and macOS,
 * 128-bit quad precision on Arm Linux, and the same as `double` on
 * Windows and Apple's Arm platforms. A Zuri number is a double, so a
 * wider value is rounded to the nearest double when read.
 * @type Type
 */
var longdouble: Type = _ffi.builtin_type('long double')

/**
 * `float _Complex`, as a list of two numbers, `[real, imaginary]`. It
 * can't be passed by value on Windows, whose C compiler has no
 * `_Complex` type, but it works in memory on every platform.
 * @type Type
 */
var complex_float: Type = _ffi.builtin_type('float _Complex')

/**
 * `double _Complex`, as `complex_float` with doubles.
 * @type Type
 */
var complex_double: Type = _ffi.builtin_type('double _Complex')

/**
 * `void *`, the untyped pointer.
 * @type Type
 */
var ptr: Type = _ffi.builtin_type('void *')

/**
 * `const char *` that converts to and from a string: a string passed in
 * becomes a NUL-terminated UTF-8 copy for the call, and a pointer coming
 * back is read up to its terminator into a string, or is `nil` when
 * null. Use `pointer(char)` to receive the pointer itself.
 * @type Type
 */
var string: Type = _ffi.builtin_type('string')

/**
 * `const wchar_t *` that converts to and from a string, as `string` does
 * in `wchar_t`'s encoding: UTF-16 on Windows and UTF-32 elsewhere.
 * @type Type
 */
var wstring: Type = _ffi.builtin_type('wstring')

/**
 * Rust's `i8`.
 * @type Type
 */
var i8: Type = _ffi.builtin_type('i8')

/**
 * Rust's `u8`.
 * @type Type
 */
var u8: Type = _ffi.builtin_type('u8')

/**
 * Rust's `i16`.
 * @type Type
 */
var i16: Type = _ffi.builtin_type('i16')

/**
 * Rust's `u16`.
 * @type Type
 */
var u16: Type = _ffi.builtin_type('u16')

/**
 * Rust's `i32`.
 * @type Type
 */
var i32: Type = _ffi.builtin_type('i32')

/**
 * Rust's `u32`.
 * @type Type
 */
var u32: Type = _ffi.builtin_type('u32')

/**
 * Rust's `i64`.
 * @type Type
 */
var i64: Type = _ffi.builtin_type('i64')

/**
 * Rust's `u64`.
 * @type Type
 */
var u64: Type = _ffi.builtin_type('u64')

/**
 * Rust's `i128`.
 * @type Type
 */
var i128: Type = _ffi.builtin_type('i128')

/**
 * Rust's `u128`.
 * @type Type
 */
var u128: Type = _ffi.builtin_type('u128')

/**
 * Rust's `isize`.
 * @type Type
 */
var isize: Type = _ffi.builtin_type('isize')

/**
 * Rust's `usize`.
 * @type Type
 */
var usize: Type = _ffi.builtin_type('usize')

/**
 * Rust's `f32`.
 * @type Type
 */
var f32: Type = _ffi.builtin_type('f32')

/**
 * Rust's `f64`.
 * @type Type
 */
var f64: Type = _ffi.builtin_type('f64')

/**
 * Rust's `char`: four bytes holding a Unicode scalar value, which is a
 * one-character string on the Zuri side.
 * @type Type
 */
var rust_char: Type = _ffi.builtin_type('rust char')

/**
 * Loads a shared library.
 *
 * `name` is a path, a file name, or a bare name that's completed using
 * the platform's naming convention. `sqlite3` is tried as
 * `libsqlite3.so` and then as the versioned file listed in the loader's
 * cache on Linux, as `libsqlite3.dylib` and `sqlite3.framework` on
 * macOS, and as `sqlite3.dll` on Windows. The directories in `paths`
 * are searched first, followed by the platform's own search order.
 *
 * Without a name, the result is the running process itself, whose
 * symbols include everything already loaded into it.
 *
 * ```zuri,ignore
 * var libc = ffi.open(ffi.LIBC)
 * var local = ffi.open('mylib', { paths: ['./build'] })
 * ```
 *
 * @param string|nil name
 * @param dict|nil options `paths`, a list of directories to search
 *    first, `lazy`, to resolve symbols when they're first used instead
 *    of when the library is loaded (defaults to `false`), and `global`,
 *    to make the library's symbols visible to libraries loaded after it
 *    (defaults to `false`). `lazy` and `global` have no effect on
 *    Windows.
 * @returns Library
 * @throws LoadError if the library can't be found or loaded.
 */
def open(name, options) {
  options = options or {}

  return _ffi.open(
    name,
    options.get('paths', []),
    options.get('lazy', false),
    options.get('global', false),
  )
}

/**
 * Where `name` would be loaded from, without loading it, or `nil` when
 * it cannot be found. Resolves names the same way `open()` does.
 *
 * @param string name
 * @param list|nil paths Directories searched first.
 * @returns string|nil
 */
def find(name: string, paths) {
  return _ffi.find(name, paths or [])
}

/**
 * An empty set of declarations to add C and Rust source to.
 *
 * @returns Declarations
 */
def declarations() {
  return _ffi.declarations()
}

/**
 * A set of declarations read from C source. This is the same as
 * `declarations().declare(source)`.
 *
 * @param string source
 * @returns Declarations
 * @throws DeclarationError if the source can't be read.
 */
def declare(source: string) {
  return _ffi.declarations().declare(source)
}

/**
 * A set of declarations read from Rust source. This is the same as
 * `declarations().declare_rust(source)`.
 *
 * @param string source
 * @returns Declarations
 * @throws DeclarationError if the source can't be read.
 */
def declare_rust(source: string) {
  return _ffi.declarations().declare_rust(source)
}

/**
 * A new struct type to add members to.
 *
 * @param string|nil name The name it prints as.
 * @returns StructType
 */
def struct(name) {
  return _ffi.record_type(name, false)
}

/**
 * A new union type to add members to.
 *
 * @param string|nil name The name it prints as.
 * @returns UnionType
 */
def union(name) {
  return _ffi.record_type(name, true)
}

/**
 * A new enum type to add constants to.
 *
 * @param string|nil name The name it's printed as.
 * @param Type|nil type The integer type that values are stored as.
 *    Defaults to `int`, as in C.
 * @returns EnumType
 */
def enum(name, type) {
  return _ffi.enum_type(name, type)
}

/**
 * A pointer type.
 *
 * @param Type type What it points to, or `void` for an untyped pointer.
 * @param dict|nil options `nonnull`, `true` to refuse `nil` as an
 *    argument, as a Rust reference does (defaults to `false`), and
 *    `text`, an encoding (`'utf-8'`, `'utf-16'`, `'utf-32'` or
 *    `'wide'`) that converts the pointer to and from a string in the
 *    same way as `ffi.string`.
 * @returns Type
 */
def pointer(type, options) {
  return _ffi.pointer_type(type, options)
}

/**
 * An array type.
 *
 * @param Type type The element type.
 * @param number|nil length Leave out for an array of unknown length.
 * @returns Type
 */
def array(type, length) {
  return _ffi.array_type(type, length)
}

/**
 * A function type, for callbacks and for calling function pointers.
 *
 * ```zuri,ignore
 * var compare = ffi.function_type(ffi.int, [ffi.ptr, ffi.ptr])
 * ```
 *
 * @param Type returns
 * @param list params The parameter types.
 * @param dict|nil options `variadic` (default `false`) and `abi`, as for
 *   `Library.function()`.
 * @returns Type
 */
def function_type(returns, params: list, options) {
  options = options or {}

  return _ffi.function_type(
    returns,
    params,
    options.get('variadic', false),
    options.get('abi', nil),
  )
}

/**
 * The `#[repr(C)]` struct, made of a pointer and a length, that a Rust
 * slice is passed as across the C ABI: `{ ptr, len }`, where `len` is a
 * `usize` that counts elements.
 *
 * @param Type type The element type.
 * @param bool|nil mutable Whether the pointer is `*mut`. Defaults to
 *    `*const`.
 * @returns StructType
 */
def slice(type, mutable) {
  return _ffi.slice_type(type, mutable == true)
}

/**
 * A type written as C writes it, using only built-in type names:
 * `'unsigned long'`, `'const char *'`, `'int[4]'`, `'void (*)(int)'`.
 * `Declarations.type()` resolves names declared there too.
 *
 * @param string spelling
 * @returns Type
 * @throws DeclarationError when it does not name a type.
 */
def type(spelling: string) {
  return _ffi.parse_type(spelling, nil)
}

/**
 * Zeroed memory for `count` values of `type`, typed as `type`.
 *
 * Freed when the last pointer into it is collected, or by
 * `Pointer.free()`.
 *
 * ```zuri,ignore
 * var numbers = ffi.alloc(ffi.int, 4)
 * numbers.set(2, 99)
 * ```
 *
 * @param Type type
 * @param number|nil count Defaults to 1.
 * @returns Pointer
 * @throws FfiError when the type has no size.
 */
def alloc(type, count) {
  return _ffi.alloc(type, count == nil ? 1 : count)
}

/**
 * `size` zeroed bytes, as an untyped pointer.
 *
 * @param number size
 * @param number|nil align A power of two. Defaults to 16, enough for any
 *   C type.
 * @returns Pointer
 */
def alloc_bytes(size, align) {
  return _ffi.alloc_bytes(size, align)
}

/**
 * `size` zeroed bytes from the C allocator, as an untyped pointer.
 *
 * Unlike `alloc()`, this memory is never freed when the pointer is
 * collected, because the usual reason to want it is to hand it to C
 * code that frees it with `free()`. Free it with `Pointer.free()`
 * otherwise.
 *
 * @param number size
 * @returns Pointer
 */
def malloc(size) {
  return _ffi.malloc(size)
}

/**
 * A NUL-terminated copy of `text` in memory that lasts, typed as its
 * code unit: `char`, `char16_t`, `wchar_t` or `char32_t`.
 *
 * Needed where a string must outlive a call: stored in a struct, or
 * kept by the library.
 *
 * @param string text
 * @param string|nil encoding `'utf-8'` (the default), `'utf-16'`,
 *   `'utf-32'` or `'wide'`.
 * @returns Pointer
 */
def alloc_string(text: string, encoding) {
  return _ffi.alloc_string(text, encoding)
}

/**
 * A pointer to a known address. Nothing about the address is checked.
 *
 * @param number|bigint address
 * @param Type|nil type What it points at.
 * @returns Pointer
 */
def at(address, type) {
  return _ffi.at(address, type)
}

/**
 * A Zuri function that calls the C function at `pointer` with the
 * signature of `type`.
 *
 * @param Pointer pointer
 * @param Type type A function type, or a pointer to one.
 * @param string|nil name The name the function reports.
 * @returns function
 * @throws PointerError when the pointer is null.
 */
def function(pointer, type, name) {
  return _ffi.function(pointer, type, name)
}

/**
 * The same foreign function, run on a helper thread while the calling
 * isolate keeps answering callbacks called from other threads.
 *
 * This is for a function that waits on threads of its own which call
 * back into Zuri. Called the ordinary way, such a function would wait
 * forever, because the isolate that has to run the callbacks is the one
 * waiting for it.
 *
 * @param function function A foreign function.
 * @returns function
 * @throws TypeError when `function` is not a foreign function.
 */
def threaded(function) {
  return _ffi.threaded(function)
}

/**
 * Whether `value` is a foreign function this module made.
 *
 * @param any value
 * @returns bool
 */
def is_foreign(value) {
  return _ffi.is_foreign(value)
}

/**
 * What a foreign function is: `{ name, pointer, type, threaded,
 * library }`, where `pointer` is its address as a `Pointer`, `type` its
 * function pointer type, and `library` the path of the library it came
 * from, or `nil`.
 *
 * @param function function A foreign function.
 * @returns dict
 */
def describe(function) {
  return _ffi.function_info(function)
}

/**
 * A C function pointer that calls `function`, and lasts until it's
 * released.
 *
 * ```zuri,ignore
 * var on_event = ffi.callback(@(code) {
 *   echo 'event ${code}'
 * }, ffi.function_type(ffi.void, [ffi.int]))
 *
 * lib.set_handler(on_event)
 * ```
 *
 * The callback lasts until `Callback.release()` is called. If the Zuri
 * function raises an error, C gets `error_value`, or zero, and the
 * error is raised again as soon as control returns to Zuri.
 *
 * @param function function
 * @param Type type A function type, or a pointer to one.
 * @param dict|nil options `error_value`, returned to C when `function`
 *    raises an error. Defaults to zero, or nothing for a `void`
 *    callback.
 * @returns Callback
 * @throws TypeError if `type` isn't a function type, or is variadic.
 * @throws CallbackError if 256 callbacks that return a 128-bit integer
 *    under the Microsoft x64 calling convention already exist.
 *    Releasing one makes room for another.
 */
def callback(function, type, options) {
  options = options or {}
  return _ffi.callback(function, type, options.get('error_value', nil))
}

/**
 * Runs every callback called from another thread that is waiting for
 * this isolate, returning how many ran.
 *
 * Such calls also run at the isolate's own safepoints, during foreign
 * calls and in threaded calls, so this is for a program that wants
 * them answered at a point of its choosing, or wants to wait for one.
 *
 * @param number|nil timeout Milliseconds to wait for a call when none
 *   is waiting. Returns at once when left out.
 * @returns number
 */
def serve(timeout) {
  return _ffi.serve(timeout)
}

/**
 * `errno` as the most recent foreign call on this isolate left it.
 *
 * `errno` is cleared before every foreign call and read immediately
 * after it, so this is always what that one call set, or 0.
 *
 * @returns number
 */
def errno() {
  return _ffi.errno()
}

/**
 * Sets `errno`, for the rare API that reads it.
 *
 * @param number value
 */
def set_errno(value) {
  _ffi.set_errno(value)
}

/**
 * On Windows, `GetLastError()` as the most recent foreign call on this
 * isolate left it, cleared before the call and read after it as `errno`
 * is. Always 0 on other platforms.
 *
 * @returns number
 */
def last_error() {
  return _ffi.last_error()
}

/**
 * Links static libraries into a shared library with the platform's
 * linker, and loads it.
 *
 * ```zuri,ignore
 * var lib = ffi.link('target/release/libgeometry.a')
 * ```
 *
 * Every object in the archives is linked in. The result is cached under
 * a name based on the contents of the archives and the options, so the
 * linker only runs once for the same input. An archive that contains
 * Rust code is detected, and linked against the system libraries that
 * Rust's standard library needs.
 *
 * The linker is the C compiler, `cc` or `$CC`, on Linux and macOS, and
 * MSVC's `link.exe` on Windows, which is found through the Visual
 * Studio installation. On Windows, a static library's functions aren't
 * exported by default, so every symbol with an unmangled name that the
 * archives define is exported.
 *
 * @param string|list archives One path, or a list of paths.
 * @param dict|nil options `libraries`, the names of libraries to link
 *    against, such as `['m']`, `search_paths`, the directories to find
 *    them in, `exports`, the exact symbols to export on Windows,
 *    `linker`, the program to run, `flags`, extra arguments for it,
 *    `cache`, the directory where results are kept (defaults to
 *    `default_link_cache()`), and `rust`, whether the archives contain
 *    Rust code (detected if it's left out).
 * @returns Library
 * @throws LinkError with the linker's output if linking fails.
 * @throws LoadError if the linked library can't be loaded.
 */
def link(archives, options) {
  if is_string(archives) {
    archives = [archives]
  }

  var path = _ffi.link(archives, options or {})
  return open(path)
}

/**
 * The directory `link()` keeps linked libraries in by default:
 * `$XDG_CACHE_HOME/zuri/ffi` (or `~/.cache/zuri/ffi`) on Linux,
 * `~/Library/Caches/zuri/ffi` on macOS, and `%LOCALAPPDATA%\zuri\ffi` on
 * Windows.
 *
 * @returns string
 */
def default_link_cache() {
  return _ffi.default_cache()
}

/**
 * The facts about this platform that determine how C types are laid
 * out:
 * `{ os, arch, pointer_size, long_size, wchar_size, char_signed, long_double, complex, layout }`.
 *
 * `long_double` is `'x87'`, `'binary128'` or `'double'`. `complex` says
 * whether complex numbers can be passed by value. `layout` is the set
 * of rules that records follow, which is `'msvc'` on Windows and
 * `'itanium'` everywhere else.
 *
 * @returns dict
 */
def platform() {
  return _ffi.platform()
}
