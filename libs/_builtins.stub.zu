/**
 * Returns the current time as a Unix timestamp, with microsecond
 * resolution.
 *
 * For example:
 *
 * ```zuri-repl
 * %> time()
 * 1686787200.123456
 * ```
 *
 * The result is a floating-point number. The integer part is the number
 * of seconds since the Unix epoch, and the fractional part holds the
 * microseconds.
 *
 * @note The Unix epoch is midnight UTC on January 1, 1970.
 * @returns {number}
 */
def time() {}

/**
 * Calculates the sum of all the elements passed as arguments.
 * Returns `0` when no argument is passed in.
 *
 * Example:
 *
 * ```zuri-repl
 * %> math.sum([1, 2, [3, 4, [5, 6]]])
 * 21
 * ```
 *
 * @param ...number values
 * @returns number
 */
def sum(...values) {}

/**
 * If x is a number, this function returns a new `bytes` object
 * with length x having all its bytes set to `0x0`.
 *
 * If x is a list, it returns a new `bytes` object whose contents
 * are the bytes specified in the list.
 *
 * ```zuri-repl
 * %> bytes(5)
 * (00 00 00 00 00)
 * %> bytes([65, 66, 67, 68, 69])
 * (41 42 43 44 45)
 * ```
 *
 * @note If x is a list, then the list must only contain valid
 *    bytes which can be any number between 0 and 255.
 * @param {number|list} x The number or list to convert to bytes.
 * @returns {bytes|any}
 */
def bytes(x: number|list) {}

/**
 * Returns an open file handle to the file specified in the path
 * in the specified mode. If the mode is not specified, the file
 * will be opened in the read only mode.
 *
 * Valid modes include:
 *
 * ```zuri-repl
 * %> file('sample.txt', 'r')
 * <file at sample.txt in mode r>
 * %> file('sample.txt', 'w')
 * <file at sample.txt in mode w>
 * %> file('sample.txt', 'a')
 * <file at sample.txt in mode a>
 * %> file('sample.txt', 'r+')
 * <file at sample.txt in mode r+>
 * %> file('sample.txt', 'w+')
 * <file at sample.txt in mode w+>
 * %> file('sample.txt', 'a+')
 * <file at sample.txt in mode a+>
 * %> file('sample.lock', 'x')
 * <file at sample.lock in mode x>
 * ```
 *
 * `x` and `x+` create the file and fail when anything already exists
 * at the path. The check and the creation are one step, so of two
 * programs creating the same path in `x` mode, exactly one succeeds.
 * That makes it the mode for lock files. The failure comes on the
 * first read, write or `open()`, since creating the handle touches
 * nothing.
 *
 * @param {string} path The path to the file to open.
 * @param {?string} mode The mode to open the file in.
 * @returns {file}
 */
def file(path: string, mode: ?string) {}

/**
 * Returns `true` if x is an instance of the given class y or
 * `false` otherwise.
 *
 * @param {any} x The value to check.
 * @param {class} y The class to check for.
 * @returns {boolean}
 */
def instance_of(x: any, y) {}

/**
 * Returns the type of the given value as a string.
 *
 * @param {any} x The value to check.
 * @returns {string}
 */
def typeof(x: any) {}

/**
 * Deletes the property name from the given instance of object.
 *
 * @param {instance} object The instance to delete the property
 *    from.
 * @param {string} name The name of the property to delete.
 * @returns {void}
 */
def delprop(object: instance, name: string) {}

/**
 * Returns the value of the property name from the given instance
 * of object. If the object has no such property, `nil` is
 * returned.
 *
 * @param {instance} object The instance to get the property
 *    from.
 * @param {string} name The name of the property to get.
 * @returns {any|nil}
 */
def getprop(object: instance, name: string) {}

/**
 * Returns true if the property name exists in the given instance
 * of object. If the object has no such property, `false` is
 * returned.
 *
 * @param {instance} object The instance to check for the
 *    property.
 * @param {string} name The name of the property to check.
 * @returns {boolean}
 */
def hasprop(object: instance, name: string) {}

/**
 * Sets the value of the object's property with the matching name
 * to the given value. If the property already exists, it
 * overwrites it and returns `true`, otherwise it returns
 * `false`.
 *
 * @param {instance} obj The object to set the property of.
 * @param {string} prop The property to set.
 * @param {any} value The value to set the property to.
 * @returns {boolean}
 */
def setprop(obj: instance, prop: string, value: any) {}

/**
 * Returns the unique identifier of value x within the system.
 * This value is also equivalent to the current address of object
 * x in memory.
 *
 * @param {any} x The value to get the identifier of.
 * @returns {number}
 */
def id(x: any) {}

/**
 * Writes its arguments to standard output.
 *
 * Unlike `echo`, which always adds a line break and only prints one
 * value, `print()` writes all its arguments one after another, with no
 * separator and no line break at the end. It also writes a `bytes`
 * value as raw bytes, instead of as its text representation, so a
 * script can stream binary output, such as the body of a PBM or PNG
 * image one row at a time.
 *
 * @note In the REPL, it also adds a line break at the end.
 * @param ...any values: the values to print
 * @return void
 */
def print(...values) {}

/**
 * If no argument is given, returns a random number between 0 and
 * 1. If x is given, returns a random number between 0 and x. If
 *    y is given, returns a random number between x and y.
 *
 * @param {?number} x The lower bound of the random number.
 * @param {?number} y The upper bound of the random number.
 * @returns {number}
 */
def rand(x: ?number, y: ?number) {}

/**
 * Returns `true` if `x` is a bigint, and `false` otherwise. A bigint is
 * a different type from `number`, created either with the `n` suffix on
 * a literal (`123n`) or by an integer literal too large for a signed
 * 64-bit integer. `is_number(x)` and `is_int(x)` both return `false`
 * for a bigint, even though it holds an integer, so check
 * `is_bigint(x)` separately when a value could be either.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_bigint(x: any) {}

/**
 * Returns `true` if x is a boolean or `false` otherwise.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_bool(x: any) {}

/**
 * Returns `true` if x is a callable or `false` otherwise.
 * Callables includes classes, functions, methods and closures.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_callable(x: any) {}

/**
 * Returns `true` if x is a class or `false` otherwise.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_class(x: any) {}

/**
 * Returns `true` if x is a dictionary or `false` otherwise.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_dict(x: any) {}

/**
 * Returns `true` if x is a function or `false` otherwise.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_function(x: any) {}

/**
 * Returns `true` if x is an instance of any class or `false`
 * otherwise.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_instance(x: any) {}

/**
 * Returns `true` if x is an integer or `false` otherwise.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_int(x: any) {}

/**
 * Returns `true` if x is a list or `false` otherwise.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_list(x: any) {}

/**
 * Returns `true` if x is a number or `false` otherwise.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_number(x: any) {}

/**
 * Returns `true` if x is an object or `false` otherwise.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_object(x: any) {}

/**
 * Returns `true` if x is a string or `false` otherwise.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_string(x: any) {}

/**
 * Returns `true` if x is bytes or `false` otherwise.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_bytes(x: any) {}

/**
 * Returns `true` if x is a file or `false` otherwise.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_file(x: any) {}

/**
 * Returns `true` if x is an iterable object or `false`
 * otherwise. Iterables includes lists, dictionaries, strings,
 * bytes, and instances of any class that defines both `@key()`
 * and `@value()` decorator functions.
 *
 * @param {any} x The value to check.
 * @returns {boolean}
 */
def is_iterable(x: any) {}

/**
 * The path of the file in which it's used. In the file that the program
 * was started from, it's the path the program was started with. In an
 * imported module, it's the module's full path.
 *
 * @type string
 */
var __file__ = ''

/**
 * The path of the file that the program was started from. It's the same
 * in every module and every isolate of a single run, so
 * `__root__ == __file__` is only true in that one file. That's how a
 * file can work both as a module that other files import and as a
 * program by itself:
 *
 * ```zuri
 * def main() {
 *   echo 'started directly'
 * }
 *
 * if __root__ == __file__ {
 *   main()
 * }
 * ```
 *
 * `__root__` and `__file__` are both set when a file runs. The REPL
 * doesn't run a file, so it defines neither.
 *
 * @type string
 */
var __root__ = ''

/**
 * The methods every value carries whatever its type: `nil`, every
 * built-in type, a function, a module, and an instance of any
 * class. A class that declares a method of the same name gives its
 * instances that method in this one's place.
 */
class value {

  /**
   * The value as a string. A string comes back as itself, `nil` as
   * `'nil'`, and a number, a list or a dictionary as it is written
   * in source. An instance comes back as `'<instance of Name>'` and
   * a module as `'<module name at path>'`.
   *
   * ```zuri-repl
   * %> (5).to_string()
   * '5'
   * %> nil.to_string()
   * 'nil'
   * %> [1, 'a'].to_string()
   * '[1, a]'
   * ```
   *
   * @returns string
   */
  to_string() {}
}
